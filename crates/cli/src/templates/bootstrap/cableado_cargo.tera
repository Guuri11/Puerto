# GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
[package]
name = "cableado"
version = "0.1.0"
edition = "2024"

[dependencies]
{% for entity in entities %}aplicacion_{{ entity.snake }} = { workspace = true }
dominio_{{ entity.snake }} = { workspace = true }
infra_{{ entity.snake }} = { workspace = true }
{% endfor %}{% if any_db %}sqlx = { workspace = true }
{% endif %}
