/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
{%- if has_db %}
    let database_url = std::env::var("DATABASE_URL")
        .map_err(|_| "DATABASE_URL is not set — set it in .env (.env.example has one)".to_string())?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — is the database up? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;
{% endif %}
{%- if local %}
    // Accounts in this database (ADR-0021 § 2): their sessions are what every `BearerAuth` asks.
    let users: Arc<dyn UserRepositoryTrait> = Arc::new(PgUserRepository::new(pool.clone()));
    let credentials: Arc<dyn AlmacenCredenciales> = Arc::new(CredencialesPostgres::new(pool.clone()));
    let hasher: Arc<dyn HasherContrasena> = Arc::new(puerto_auth::local::HasherArgon2::new());
    let sessions = Arc::new(SesionesPostgres::new(
        pool.clone(),
        puerto_sqlx::auth::ttl_sesion_from_env()?,
    ));
    let authenticator: Arc<dyn Autenticador> = sessions.clone();
    let auth_api = AuthApi {
        register_user: Arc::new(RegisterUserUseCaseImpl {
            users: Arc::clone(&users),
            credentials: Arc::clone(&credentials),
            hasher: Arc::clone(&hasher),
        }),
        login: Arc::new(LoginUseCaseImpl {
            users,
            credentials,
            hasher,
            sessions: sessions.clone(),
        }),
        logout: Arc::new(LogoutUseCaseImpl { sessions }),
    };
    let me_api = MeApi;
{% elif auth %}
    // The provider's tokens, and a `User` row for every caller (ADR-0021 § 3).
    let auth_config = puerto_auth::ConfigOidc::from_env().map_err(|e| e.to_string())?;
    let issuer = auth_config.emisor.clone();
    let provider = puerto_auth::AutenticadorOidc::descubrir(auth_config)
        .await
        .map_err(|e| format!("{e} — is the auth provider up? `make docker-compose/up`"))?;
    let authenticator: Arc<dyn Autenticador> = Arc::new(ProvisioningAuthenticator::new(
        Arc::new(provider),
        Arc::new({% if user_db %}PgUserRepository::new(pool.clone()){% else %}InMemoryUserRepository::new(){% endif %}),
        issuer,
    ));
    let me_api = MeApi;
{% endif %}
{%- for entity in entities %}
{%- if entity.use_cases %}
    let casos_{{ entity.snake }} = cableado::{{ entity.snake }}::construir({% if entity.db %}&pool{% endif %});
{%- endif %}
    let {{ entity.snake }}_api = {{ entity.pascal }}Api {% if entity.use_cases %}{ {% for uc in entity.use_cases %}{{ uc.action }}: casos_{{ entity.snake }}.{{ uc.action }}{% if not loop.last %}, {% endif %}{% endfor %} }{% else %}{}{% endif %};
{% endfor %}{%- if has_db %}
    let ready = puerto_web::health::sondear(move || {
        let pool = pool.clone();
        async move { puerto_sqlx::ping(&pool).await }
    });
{%- else %}
    let ready = puerto_web::health::siempre_disponible();
{%- endif %}

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::rutas(
        openapi_service({{ apis }}),
        &config,
        ready,
    )){% if auth %}
    // What every `BearerAuth` asks.
    .data(authenticator){% endif %})
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}
{%- if web %}

