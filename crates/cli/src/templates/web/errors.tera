/**
 * A request about {{ a_words }} that the API refused. `code` is the API's `ErrorResponse.name`:
 * `{{ snake }}.not_found`, `{{ snake }}.validation_error.<field>_empty`.
 */
export class {{ pascal }}Error extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "{{ pascal }}Error";
    this.code = code;
  }
}
