import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Schemas } from "../../../api/client";
{%- if fill_helpers %}
import { {{ fill_helpers | join(sep=", ") }} } from "../../../shared/forms";
{%- endif %}
import { fakeApi } from "../../../test-support/fake-api";
{%- for t in targets %}
import { {{ t.camel }}Collection, {{ t.pascal }}Mother } from "../../../test-support/{{ t.kebab }}";
{%- endfor %}
import { {{ camel }}Collection, {{ pascal }}Mother } from "../../../test-support/{{ kebab }}";
import { renderScreen } from "../../../test-support/render";
import { {{ pascal }}FormContainer } from "./{{ kebab }}-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}
{%- if targets %}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The collections the selects read, holding what `owner` references. */
function referencedBy(owner: Partial<Schemas["Dto{{ pascal }}"]>) {
{%- if referenced_inline %}
  return [{% for t in targets %}{{ t.camel }}Collection([{{ t.seeds | join(sep=", ") }}]){% if not loop.last %}, {% endif %}{% endfor %}];
{%- else %}
  return [
{%- for t in targets %}
{%- if t.seeds_inline %}
    {{ t.camel }}Collection([{{ t.seeds | join(sep=", ") }}]),
{%- else %}
    {{ t.camel }}Collection([
{%- for seed in t.seeds %}
      {{ seed }},
{%- endfor %}
    ]),
{%- endif %}
{%- endfor %}
  ];
{%- endif %}
}
{%- endif %}

/** Fills the empty form with `request`, the way a user would. */
async function fillIn(request: Schemas["PeticionCrear{{ pascal }}"]) {
  await screen.findByText("Save");
{%- for f in fields %}
{%- if f.input == "checkbox" %}
  if (request.{{ f.camel }}) fireEvent.click(screen.getByLabelText("{{ f.label }}"));
{%- elif f.input == "reference" %}
  await choose("{{ f.label }}", {{ f.request_to_form }});
{%- else %}
  type("{{ f.label }}", {{ f.request_to_form }});
{%- endif %}
{%- endfor %}
}

describe("{{ pascal }}FormContainer", () => {
  test("should create the {{ words }} from what was typed and show it", async () => {
    // Arrange
    const request = {{ pascal }}Mother.request();
    const stored = {{ camel }}Collection();
    const api = fakeApi([stored{% if targets %}, ...referencedBy(request){% endif %}]);
    const { history } = renderScreen(<{{ pascal }}FormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/{{ plural }}/"));
    const [created] = stored.items.values();
    expect(created).toMatchObject(request);
    expect(history.at(-1)).toBe(`/{{ plural }}/${created?.id}`);
  });

  test("should save the edited {{ words }} when an existing one is submitted", async () => {
    // Arrange
    const seeded = {{ pascal }}Mother.random();
    const stored = {{ camel }}Collection([seeded]);
    const api = fakeApi([stored{% if targets %}, ...referencedBy(seeded){% endif %}]);
    const { history } = renderScreen(<{{ pascal }}FormContainer id={seeded.id} />, { api });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/{{ plural }}/${seeded.id}`));
    expect(stored.items.get(seeded.id)).toEqual(seeded);
  });
  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const request = {{ pascal }}Mother.request();
    const code = "{{ snake }}.validacion.invalid";
    const failures = { "POST /{{ plural }}": code };
    const api = fakeApi([{{ camel }}Collection(){% if targets %}, ...referencedBy(request){% endif %}], failures);
    renderScreen(<{{ pascal }}FormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a {{ words }} with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const request = {{ pascal }}Mother.request();
    const failures = { "POST /{{ plural }}": "{{ snake }}.duplicado" };
    const api = fakeApi([{{ camel }}Collection(){% if targets %}, ...referencedBy(request){% endif %}], failures);
    renderScreen(<{{ pascal }}FormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "{{ duplicate_text }}",
    );
  });
{%- for t in targets %}

  test("should offer every {{ t.words }} in the selects that reference one", async () => {
    // Arrange
    const {{ t.ident }} = {{ t.pascal }}Mother.random();
    const api = fakeApi([{{ t.camel }}Collection([{{ t.ident }}])]);

    // Act
    renderScreen(<{{ pascal }}FormContainer />, { api });

    // Assert
    const options = await screen.findAllByRole("option", { name: {{ t.ident }}.{{ t.label }} });
    expect(options).toHaveLength({{ t.fields | length }});
  });
{%- endfor %}
{%- if field_problem %}

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const request = {{ pascal }}Mother.request();
    const failures = { "POST /{{ plural }}": "{{ field_problem.code }}" };
    const api = fakeApi([{{ camel }}Collection(){% if targets %}, ...referencedBy(request){% endif %}], failures);
    renderScreen(<{{ pascal }}FormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("{{ field_problem.text }}")).toBeTruthy();
    const input = screen.getByLabelText("{{ field_problem.label }}");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
{%- endif %}
});
