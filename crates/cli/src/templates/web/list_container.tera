import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE, unwrap } from "../../../api/http";
{% if access.create_roles -%}
import { useAuth } from "../../../auth/auth";
{% endif -%}
import { useDependencies } from "../../../dependencies";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { useAsync } from "../../../shared/use-async";
import { {{ pascal }}ListView } from "../views/{{ kebab }}-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function {{ pascal }}ListContainer() {
  const { api } = useDependencies();
{%- if access.create_roles %}
  const { can } = useAuth();
{%- endif %}
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const query = { limite: PAGE_SIZE, desplazamiento: offset };
{%- if list_load_inline %}
  const {{ plural_ident }} = useAsync(() => unwrap(api.GET("/{{ plural }}", { params: { query } })), [api, offset]);
{%- else %}
  const {{ plural_ident }} = useAsync(
    () => unwrap(api.GET("/{{ plural }}", { params: { query } })),
    [api, offset],
  );
{%- endif %}

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">{{ label_plural }}</h1>
{%- if access.create_roles %}
        {{ "{" }}{% for r in access.create_roles %}can("{{ r }}") && {% endfor %}(
          <Link href="/{{ plural }}/new" className="btn btn-primary">
            New {{ words }}
          </Link>
        )}
{%- else %}
        <Link href="/{{ plural }}/new" className="btn btn-primary">
          New {{ words }}
        </Link>
{%- endif %}
      </div>
      {{ "{" }}{{ plural_ident }}.status === "loading" && <span className="loading loading-spinner" />}
      {{ "{" }}{{ plural_ident }}.status === "error" && <ErrorAlert error={{ "{" }}{{ plural_ident }}.error} />}
      {{ "{" }}{{ plural_ident }}.status === "ok" &&
        ({{ plural_ident }}.data.total === 0 ? (
          <EmptyState message="No {{ words_plural }} yet." />
        ) : (
          <>
            <{{ pascal }}ListView {{ plural_ident }}={{ "{" }}{{ plural_ident }}.data.elementos} />
            <Pagination
              total={{ "{" }}{{ plural_ident }}.data.total}
              limit={{ "{" }}{{ plural_ident }}.data.limite}
              offset={{ "{" }}{{ plural_ident }}.data.desplazamiento}
              onOffsetChange={goTo}
            />
          </>
        ))}
    </section>
  );
}
