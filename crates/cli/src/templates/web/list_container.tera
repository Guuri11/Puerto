import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
{% if access.create_roles -%}
import { useAuth } from "../../../auth/auth";
{% endif -%}
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaLista{{ pascal }} } from "../vistas/lista-{{ kebab }}";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorLista{{ pascal }}() {
  const { api } = useDependencias();
{%- if access.create_roles %}
  const { puede } = useAuth();
{%- endif %}
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
{%- if list_load_inline %}
  const {{ plural_ident }} = useCarga(() => desenvolver(api.GET("/{{ plural }}", { params: { query: consulta } })), [api, desplazamiento]);
{%- else %}
  const {{ plural_ident }} = useCarga(
    () => desenvolver(api.GET("/{{ plural }}", { params: { query: consulta } })),
    [api, desplazamiento],
  );
{%- endif %}

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">{{ label_plural }}</h1>
{%- if access.create_roles %}
        {{ "{" }}{% for r in access.create_roles %}puede("{{ r }}") && {% endfor %}(
          <Link href="/{{ plural }}/nuevo" className="btn btn-primary">
            Crear {{ words }}
          </Link>
        )}
{%- else %}
        <Link href="/{{ plural }}/nuevo" className="btn btn-primary">
          Crear {{ words }}
        </Link>
{%- endif %}
      </div>
      {{ "{" }}{{ plural_ident }}.estado === "cargando" && <span className="loading loading-spinner" />}
      {{ "{" }}{{ plural_ident }}.estado === "error" && <AlertaError error={{ "{" }}{{ plural_ident }}.error} />}
      {{ "{" }}{{ plural_ident }}.estado === "listo" &&
        ({{ plural_ident }}.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay {{ words_plural }}." />
        ) : (
          <>
            <VistaLista{{ pascal }} {{ plural_ident }}={{ "{" }}{{ plural_ident }}.datos.elementos} />
            <Paginacion
              total={{ "{" }}{{ plural_ident }}.datos.total}
              limite={{ "{" }}{{ plural_ident }}.datos.limite}
              desplazamiento={{ "{" }}{{ plural_ident }}.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}
