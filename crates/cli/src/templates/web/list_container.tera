import { Link, useLocation, useSearch } from "wouter";
import { desenvolver{% if targets %}, LIMITE_PAGINA_MAXIMO{% endif %}, TAMANO_PAGINA } from "../../../api/http";
{% if access.create_roles -%}
import { useAuth } from "../../../auth/auth";
{% endif -%}
{% if targets -%}
import { etiquetasReferencia } from "../../../compartido/formularios";
{% endif -%}
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaLista{{ pascal }} } from "../vistas/lista-{{ kebab }}";
{%- if targets %}

/** La primera página de cada entidad referenciada: las etiquetas de sus enlaces. */
const PRIMERA_PAGINA = { params: { query: { limite: LIMITE_PAGINA_MAXIMO } } };
{%- endif %}

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
{%- if owner_camel %}
/** Con `propias`, solo las de quien usa la app (`GET /mis_{{ plural }}`, 27.18). */
export function ContenedorLista{{ pascal }}({ propias = false }: { propias?: boolean }) {
{%- else %}
export function ContenedorLista{{ pascal }}() {
{%- endif %}
  const { api } = useDependencias();
{%- if access.create_roles %}
  const { puede } = useAuth();
{%- endif %}
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
{%- if owner_camel %}
  const {{ plural_ident }} = useCarga(
    () =>
      desenvolver(
        propias
          ? api.GET("/mis_{{ plural }}", { params: { query: consulta } })
          : api.GET("/{{ plural }}", { params: { query: consulta } }),
      ),
    [api, desplazamiento, propias],
  );
{%- elif list_load_inline %}
  const {{ plural_ident }} = useCarga(() => desenvolver(api.GET("/{{ plural }}", { params: { query: consulta } })), [api, desplazamiento]);
{%- else %}
  const {{ plural_ident }} = useCarga(
    () => desenvolver(api.GET("/{{ plural }}", { params: { query: consulta } })),
    [api, desplazamiento],
  );
{%- endif %}
{%- for t in targets %}
{%- if t.load_inline %}
  const {{ t.plural_ident }} = useCarga(() => desenvolver(api.GET("/{{ t.plural }}", PRIMERA_PAGINA)), [api]);
{%- else %}
  const {{ t.plural_ident }} = useCarga(
    () => desenvolver(api.GET("/{{ t.plural }}", PRIMERA_PAGINA)),
    [api],
  );
{%- endif %}
{%- if t.labels_inline %}
  const etiquetas{{ t.pascal }} = etiquetasReferencia({{ t.plural_ident }}, "{{ t.label }}");
{%- else %}
  const etiquetas{{ t.pascal }} = etiquetasReferencia(
    {{ t.plural_ident }},
    "{{ t.label }}",
  );
{%- endif %}
{%- endfor %}

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
{%- if owner_camel %}
        <h1 className="text-2xl font-bold">{propias ? "Mis {{ words_plural }}" : "{{ label_plural }}"}</h1>
{%- else %}
        <h1 className="text-2xl font-bold">{{ label_plural }}</h1>
{%- endif %}
{%- if access.create_roles %}
        {{ "{" }}{% for r in access.create_roles %}puede("{{ r }}") && {% endfor %}(
          <Link href="/{{ plural }}/nuevo" className="btn btn-primary">
            Crear {{ words }}
          </Link>
        )}
{%- else %}
        <Link href="/{{ plural }}/nuevo" className="btn btn-primary">
          Crear {{ words }}
        </Link>
{%- endif %}
      </div>
      {{ "{" }}{{ plural_ident }}.estado === "cargando" && <span className="loading loading-spinner" />}
      {{ "{" }}{{ plural_ident }}.estado === "error" && <AlertaError error={{ "{" }}{{ plural_ident }}.error} />}
      {{ "{" }}{{ plural_ident }}.estado === "listo" &&
        ({{ plural_ident }}.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay {{ words_plural }}." />
        ) : (
          <>
{%- if list_view_inline %}
            <VistaLista{{ pascal }} {{ plural_ident }}={{ "{" }}{{ plural_ident }}.datos.elementos}{% for t in targets %} etiquetas{{ t.pascal }}={etiquetas{{ t.pascal }}}{% endfor %} />
{%- else %}
            <VistaLista{{ pascal }}
              {{ plural_ident }}={{ "{" }}{{ plural_ident }}.datos.elementos}
{%- for t in targets %}
              etiquetas{{ t.pascal }}={etiquetas{{ t.pascal }}}
{%- endfor %}
            />
{%- endif %}
            <Paginacion
              total={{ "{" }}{{ plural_ident }}.datos.total}
              limite={{ "{" }}{{ plural_ident }}.datos.limite}
              desplazamiento={{ "{" }}{{ plural_ident }}.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}
