import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Schemas } from "../../../api/client";
import { {% if targets %}MAX_PAGE_LIMIT, {% endif %}unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
{%- if targets %}
import { referenceOptions } from "../../../shared/forms";
{%- endif %}
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { toProblem } from "../messages";
import { {{ pascal }}FormView, to{{ pascal }}Form, to{{ pascal }}Request } from "../views/{{ kebab }}-form-view";

type {{ pascal }} = Schemas["Dto{{ pascal }}"];
{%- if targets %}

/** The first page of each referenced entity: what its selects offer. */
const OPTIONS = { params: { query: { limite: MAX_PAGE_LIMIT } } };
{%- endif %}

/** Creates {{ a_words }}, or edits the one with `id`. */
export function {{ pascal }}FormContainer({ id }: { id?: string }) {
  const { api } = useDependencies();
  const existing = useAsync(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : unwrap(api.GET("/{{ plural }}/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const title = id === undefined ? "New {{ words }}" : "Edit {{ words }}";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <{{ pascal }}Form existing={existing.data} />}
      <Link href={id === undefined ? "/{{ plural }}" : `/{{ plural }}/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function {{ pascal }}Form({ existing }: { existing: {{ pascal }} | null }) {
  const { api } = useDependencies();
{%- for t in targets %}
{%- if t.load_inline %}
  const {{ t.plural_ident }} = useAsync(() => unwrap(api.GET("/{{ t.plural }}", OPTIONS)), [api]);
{%- else %}
  const {{ t.plural_ident }} = useAsync(
    () => unwrap(api.GET("/{{ t.plural }}", OPTIONS)),
    [api],
  );
{%- endif %}
{%- endfor %}
  const [, navigate] = useLocation();
  const [values, setValues] = useState(to{{ pascal }}Form(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const body = to{{ pascal }}Request(values);
      const saved = await unwrap(
        existing === null
          ? api.POST("/{{ plural }}", { body })
          : api.PUT("/{{ plural }}/{id}", { params: { path: { id: existing.id } }, body }),
      );
      navigate(`/{{ plural }}/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
{%- for t in targets %}
        {{ "{" }}{{ t.plural_ident }}.status === "error" && <ErrorAlert error={{ "{" }}{{ t.plural_ident }}.error} />}
{%- endfor %}
        <{{ pascal }}FormView
          values={values}
{%- if targets %}
          options={{ "{{" }}
{%- for t in targets %}{% for c in t.fields %}
            {{ c }}: referenceOptions({{ t.plural_ident }}, ({{ t.ident }}) => {{ t.ident }}.{{ t.label }}),
{%- endfor %}{% endfor %}
          }}
{%- endif %}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}
