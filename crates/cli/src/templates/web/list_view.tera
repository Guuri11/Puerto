import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";
{%- if display_helpers %}
import { {{ display_helpers | join(sep=", ") }} } from "../../../compartido/formularios";
{%- endif %}

type {{ pascal }} = Esquemas["Dto{{ pascal }}"];

export function VistaLista{{ pascal }}({ {{ plural_ident }} }: { {{ plural_ident }}: {{ pascal }}[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
{%- for f in fields %}
            <th>{{ f.label }}</th>
{%- endfor %}
            <th />
          </tr>
        </thead>
        <tbody>
          {{ "{" }}{{ plural_ident }}.map(({{ ident }}) => (
            <tr key={{ "{" }}{{ ident }}.id}>
{%- for f in fields %}
              <td>{{ "{" }}{{ f.display }}}</td>
{%- endfor %}
              <td className="text-right">
                <Link href={`/{{ plural }}/${{ "{" }}{{ ident }}.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
