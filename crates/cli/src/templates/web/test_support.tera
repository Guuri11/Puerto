import type { Esquemas } from "../api/cliente";
import { coleccion } from "./api-falsa";

type {{ pascal }} = Esquemas["Dto{{ pascal }}"];
type Peticion{{ pascal }} = Esquemas["PeticionCrear{{ pascal }}"];

/** Datos válidos de {{ words_plural }}; en `cambios`, los campos de los que trata el test. */
export const Madre{{ pascal }} = {
  peticion(cambios: Partial<Peticion{{ pascal }}> = {}): Peticion{{ pascal }} {
    return {
{%- for f in create_fields %}
      {{ f.camel }}: {{ f.mother }},
{%- endfor %}
      ...cambios,
    };
  },

  aleatorio(cambios: Partial<{{ pascal }}> = {}): {{ pascal }} {
{%- set server_set = fields | filter(attribute="defaulted", value=true) | concat(with=fields | filter(attribute="generated", value=true)) %}
{%- if server_set %}
    return {
      id: crypto.randomUUID(),
      ...Madre{{ pascal }}.peticion(),
{%- for f in server_set %}
      {{ f.camel }}: {{ f.mother }},
{%- endfor %}
      ...cambios,
    };
{%- else %}
    return { id: crypto.randomUUID(), ...Madre{{ pascal }}.peticion(), ...cambios };
{%- endif %}
  },
};

/** El `/{{ plural }}` de la API falsa, con `semilla`. */
export function coleccion{{ pascal }}(semilla: {{ pascal }}[] = []) {
{%- set generated = fields | filter(attribute="generated", value=true) %}
{%- if generated %}
  // Lo que actualizar conserva: los campos que genera la API (27.17).
  return coleccion("/{{ plural }}", "{{ snake }}", semilla, {}, [{% for f in generated %}"{{ f.camel }}"{% if not loop.last %}, {% endif %}{% endfor %}]);
{%- else %}
  return coleccion("/{{ plural }}", "{{ snake }}", semilla);
{%- endif %}
}
