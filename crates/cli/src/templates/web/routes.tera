// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.

import { Route, Switch } from "wouter";
{% if entities -%}
import { contarTotal, PAGINA_DE_UNO } from "../api/http";
{% endif -%}
{% if guarded or auth -%}
import { RequiereAuth } from "../auth/auth";
{% endif -%}
import type { EntradaMenu } from "../compartido/ui/marco";
{% for e in entities -%}
import { ContenedorDetalle{{ e.pascal }} } from "../contextos/{{ e.kebab }}/contenedores/detalle-{{ e.kebab }}";
import { ContenedorFormulario{{ e.pascal }} } from "../contextos/{{ e.kebab }}/contenedores/formulario-{{ e.kebab }}";
import { ContenedorLista{{ e.pascal }} } from "../contextos/{{ e.kebab }}/contenedores/lista-{{ e.kebab }}";
{% endfor -%}
import { PaginaNoEncontrada } from "../paginas/no-encontrada";
import { PaginaPanel } from "../paginas/panel";
{% if auth -%}
import { PaginaPerfil } from "../paginas/perfil";
{% endif -%}
import { rutasPropias } from "../rutas";

/** Dónde va la app: en la raíz o, con portada, en `[proyecto] ruta_app` (`puerto nuevo --portada`). */
export const rutaApp = "{{ ruta_app }}";

export const entradasMenu: EntradaMenu[] = [
{%- for e in entities %}
  {
    etiqueta: "{{ e.label_plural }}",
    href: "/{{ e.plural }}",
{%- if e.total_inline %}
    total: ({ api }) => contarTotal(api.GET("/{{ e.plural }}", PAGINA_DE_UNO)),
{%- else %}
    total: ({ api }) =>
      contarTotal(api.GET("/{{ e.plural }}", PAGINA_DE_UNO)),
{%- endif %}
  },
{%- endfor %}
{%- if entities %}
{% endif %}];

export function RutasApp() {
  return (
    <Switch>
      <Route path="/">
{%- if panel_guarded %}
        <RequiereAuth>
          <PaginaPanel entradas={entradasMenu} />
        </RequiereAuth>
{%- else %}
        <PaginaPanel entradas={entradasMenu} />
{%- endif %}
      </Route>
{%- if auth %}
      <Route path="/perfil">
        <RequiereAuth>
          <PaginaPerfil />
        </RequiereAuth>
      </Route>
{%- endif %}
      {rutasPropias}
{%- for e in entities %}
      <Route path="/{{ e.plural }}">
{%- if e.list_guarded %}
        <RequiereAuth>
          <ContenedorLista{{ e.pascal }} />
        </RequiereAuth>
{%- else %}
        <ContenedorLista{{ e.pascal }} />
{%- endif %}
      </Route>
      <Route path="/{{ e.plural }}/nuevo">
{%- if e.new_guarded %}
        <RequiereAuth>
          <ContenedorFormulario{{ e.pascal }} />
        </RequiereAuth>
{%- else %}
        <ContenedorFormulario{{ e.pascal }} />
{%- endif %}
      </Route>
{%- if e.edit_guarded %}
      <Route path="/{{ e.plural }}/:id/editar">
        {(params) => (
          <RequiereAuth>
            <ContenedorFormulario{{ e.pascal }} id={params.id} />
          </RequiereAuth>
        )}
      </Route>
{%- elif e.edit_route_inline %}
      <Route path="/{{ e.plural }}/:id/editar">{(params) => <ContenedorFormulario{{ e.pascal }} id={params.id} />}</Route>
{%- else %}
      <Route path="/{{ e.plural }}/:id/editar">
        {(params) => <ContenedorFormulario{{ e.pascal }} id={params.id} />}
      </Route>
{%- endif %}
{%- if e.detail_guarded %}
      <Route path="/{{ e.plural }}/:id">
        {(params) => (
          <RequiereAuth>
            <ContenedorDetalle{{ e.pascal }} id={params.id} />
          </RequiereAuth>
        )}
      </Route>
{%- elif e.detail_route_inline %}
      <Route path="/{{ e.plural }}/:id">{(params) => <ContenedorDetalle{{ e.pascal }} id={params.id} />}</Route>
{%- else %}
      <Route path="/{{ e.plural }}/:id">
        {(params) => <ContenedorDetalle{{ e.pascal }} id={params.id} />}
      </Route>
{%- endif %}
{%- endfor %}
      <Route>
        <PaginaNoEncontrada />
      </Route>
    </Switch>
  );
}
