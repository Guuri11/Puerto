// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.

{% if auth -%}
import type { ReactNode } from "react";
{% endif -%}
import { Route, Switch{% if saved_notice %}, useSearch{% endif %} } from "wouter";
{% if entities -%}
import { contarTotal, PAGINA_DE_UNO } from "../api/http";
{% endif -%}
{% if guarded or auth -%}
import { RequiereAuth{% if auth %}, useAuth{% endif %} } from "../auth/auth";
{% endif -%}
{% if auth -%}
import { type EntradaMenu, Marco } from "../compartido/ui/marco";
{% else -%}
import type { EntradaMenu } from "../compartido/ui/marco";
{% endif -%}
{% for e in entities -%}
import { ContenedorDetalle{{ e.pascal }} } from "../contextos/{{ e.kebab }}/contenedores/detalle-{{ e.kebab }}";
import { ContenedorFormulario{{ e.pascal }} } from "../contextos/{{ e.kebab }}/contenedores/formulario-{{ e.kebab }}";
import { ContenedorLista{{ e.pascal }} } from "../contextos/{{ e.kebab }}/contenedores/lista-{{ e.kebab }}";
{% endfor -%}
import { PaginaNoEncontrada } from "../paginas/no-encontrada";
import { PaginaPanel } from "../paginas/panel";
{% if auth -%}
import { PaginaPerfil } from "../paginas/perfil";
{% endif -%}
import { rutasPropias } from "../rutas";

/** Dónde va la app: en la raíz o, con portada, en `[proyecto] ruta_app` (`puerto nuevo --portada`). */
export const rutaApp = "{{ ruta_app }}";

export const entradasMenu: EntradaMenu[] = [
{%- for e in entities %}
  {
    etiqueta: "{{ e.label_plural }}",
    href: "/{{ e.plural }}",
{%- if e.total_inline %}
    total: ({ api }) => contarTotal(api.GET("/{{ e.plural }}", PAGINA_DE_UNO)),
{%- else %}
    total: ({ api }) =>
      contarTotal(api.GET("/{{ e.plural }}", PAGINA_DE_UNO)),
{%- endif %}
  },
{%- endfor %}
{%- if entities %}
{% endif %}];
{%- if auth %}

/** Los roles que pide la lista de cada sección (`[[entidad]] roles`): sin ellos, daría un 403. */
const ROLES_LISTA: Record<string, string[]> = {
{%- for e in menu_roles %}
  "/{{ e.plural }}": [{% for r in e.list_roles %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}],
{%- endfor %}
{%- if menu_roles %}
{% endif %}};

/** Las secciones que puede abrir quien usa la app: el menú y el panel no le ofrecen un 403. */
export function useEntradasMenu(): EntradaMenu[] {
  const { puede } = useAuth();
  return entradasMenu.filter((entrada) => (ROLES_LISTA[entrada.href] ?? []).every(puede));
}

/** El marco de la app, con las secciones de {@link useEntradasMenu}. */
export function MarcoApp({ children }: { children: ReactNode }) {
  const entradas = useEntradasMenu();
  return <Marco menu={entradas}>{children}</Marco>;
}
{%- endif %}

export function RutasApp() {
{%- if auth %}
  const entradas = useEntradasMenu();
{%- endif %}
{%- if saved_notice %}
  // Lo que se crea sin poder verlo después vuelve aquí con `?guardado` (27.8 de Puerto).
  const guardado = new URLSearchParams(useSearch()).has("guardado");
{%- endif %}
  return (
    <Switch>
      <Route path="/">
{%- if saved_notice %}
        {guardado && (
          <div role="status" className="alert alert-success mb-6">
            Guardado
          </div>
        )}
{%- endif %}
{%- if panel_guarded %}
        <RequiereAuth>
          <PaginaPanel entradas={{ "{" }}{% if auth %}entradas{% else %}entradasMenu{% endif %}} />
        </RequiereAuth>
{%- else %}
        <PaginaPanel entradas={{ "{" }}{% if auth %}entradas{% else %}entradasMenu{% endif %}} />
{%- endif %}
      </Route>
{%- if auth %}
      <Route path="/perfil">
        <RequiereAuth>
          <PaginaPerfil />
        </RequiereAuth>
      </Route>
{%- endif %}
      {rutasPropias}
{%- for e in entities %}
      <Route path="/{{ e.plural }}">
{%- if e.list_guarded %}
        <RequiereAuth>
          <ContenedorLista{{ e.pascal }} />
        </RequiereAuth>
{%- else %}
        <ContenedorLista{{ e.pascal }} />
{%- endif %}
      </Route>
      <Route path="/{{ e.plural }}/nuevo">
{%- if e.new_guarded %}
        <RequiereAuth>
          <ContenedorFormulario{{ e.pascal }} />
        </RequiereAuth>
{%- else %}
        <ContenedorFormulario{{ e.pascal }} />
{%- endif %}
      </Route>
{%- if e.edit_guarded %}
      <Route path="/{{ e.plural }}/:id/editar">
        {(params) => (
          <RequiereAuth>
            <ContenedorFormulario{{ e.pascal }} id={params.id} />
          </RequiereAuth>
        )}
      </Route>
{%- elif e.edit_route_inline %}
      <Route path="/{{ e.plural }}/:id/editar">{(params) => <ContenedorFormulario{{ e.pascal }} id={params.id} />}</Route>
{%- else %}
      <Route path="/{{ e.plural }}/:id/editar">
        {(params) => <ContenedorFormulario{{ e.pascal }} id={params.id} />}
      </Route>
{%- endif %}
{%- if e.detail_guarded %}
      <Route path="/{{ e.plural }}/:id">
        {(params) => (
          <RequiereAuth>
            <ContenedorDetalle{{ e.pascal }} id={params.id} />
          </RequiereAuth>
        )}
      </Route>
{%- elif e.detail_route_inline %}
      <Route path="/{{ e.plural }}/:id">{(params) => <ContenedorDetalle{{ e.pascal }} id={params.id} />}</Route>
{%- else %}
      <Route path="/{{ e.plural }}/:id">
        {(params) => <ContenedorDetalle{{ e.pascal }} id={params.id} />}
      </Route>
{%- endif %}
{%- endfor %}
      <Route>
        <PaginaNoEncontrada />
      </Route>
    </Switch>
  );
}
