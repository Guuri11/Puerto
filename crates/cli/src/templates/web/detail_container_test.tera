import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
{% if access.delete_protected -%}
import { {{ pascal }}Error } from "../../../../domain/{{ kebab }}/errors";
{% endif -%}
{% if targets -%}
import type { {{ pascal }} } from "../../../../domain/{{ kebab }}/model";
{% endif -%}
{% if access.update_roles or access.delete_roles -%}
import { CurrentUserMother } from "../../../../test-support/auth";
{% endif -%}
{% for t in targets -%}
import { fake{{ t.pascal }}Repository, {{ t.pascal }}Mother } from "../../../../test-support/{{ t.kebab }}";
{% endfor -%}
import { fake{{ pascal }}Repository, {{ pascal }}Mother } from "../../../../test-support/{{ kebab }}";
import { renderScreen } from "../../../../test-support/render";
import { {{ pascal }}DetailContainer } from "./{{ kebab }}-detail-container";

{%- if targets %}

/** The repositories the reference links load from, holding what `seeded` references. */
function referencedBy(seeded: {{ pascal }}) {
  return {
{%- for t in targets %}
{%- if t.detail_seeds_inline %}
    {{ t.camel }}Repository: fake{{ t.pascal }}Repository([{{ t.detail_seeds | join(sep=", ") }}]),
{%- else %}
    {{ t.camel }}Repository: fake{{ t.pascal }}Repository([
{%- for seed in t.detail_seeds %}
      {{ seed }},
{%- endfor %}
    ]),
{%- endif %}
{%- endfor %}
  };
}
{%- endif %}

describe("{{ pascal }}DetailContainer", () => {
  test("should show the {{ words }} when it exists", async () => {
    // Arrange
    const seeded = {{ pascal }}Mother.random();
    const {{ camel }}Repository = fake{{ pascal }}Repository([seeded]);

    // Act
{%- if targets %}
    renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, {
      {{ camel }}Repository,
      ...referencedBy(seeded),
    });
{%- else %}
    renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, { {{ camel }}Repository });
{%- endif %}

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });
{%- for r in references %}

  test("should link the {{ r.label | lower }} to its page, named by its label", async () => {
    // Arrange
    const seeded = {{ pascal }}Mother.random();
    const {{ camel }}Repository = fake{{ pascal }}Repository([seeded]);
    const referenced = referencedBy(seeded);
{%- if r.target_inline %}
    const target = await referenced.{{ r.repository }}.get(seeded.{{ r.camel }}{% if not r.required %} ?? ""{% endif %});
{%- else %}
    const target = await referenced.{{ r.repository }}.get(
      seeded.{{ r.camel }}{% if not r.required %} ?? ""{% endif %},
    );
{%- endif %}

    // Act
    renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, {
      {{ camel }}Repository,
      ...referenced,
    });

    // Assert: by its href — two references to one target may share a label.
    const selector = `a[href="{{ r.ref_path }}/${seeded.{{ r.camel }}}"]`;
    expect(await screen.findByText(target.{{ r.target_label }}, { selector })).toBeTruthy();
  });
{%- endfor %}

  test("should show the not-found code when the {{ words }} does not exist", async () => {
    // Arrange
    const {{ camel }}Repository = fake{{ pascal }}Repository();

    // Act
    renderScreen(<{{ pascal }}DetailContainer id={crypto.randomUUID()} />, {
      {{ camel }}Repository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("{{ snake }}.no_encontrado");
  });

  test("should delete the {{ words }} only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = {{ pascal }}Mother.random();
    const fake = fake{{ pascal }}Repository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, {
      {{ camel }}Repository: { ...fake, remove },
{%- if targets %}
      ...referencedBy(seeded),
{%- endif %}
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/{{ plural }}"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
{%- for action in ["Edit", "Delete"] %}
{%- if action == "Edit" %}{% set guard = access.update_roles %}{% else %}{% set guard = access.delete_roles %}{% endif %}
{%- if guard %}

  test("should not offer {{ action }} to a user without its role", async () => {
    // Arrange
    const seeded = {{ pascal }}Mother.random();
    const {{ camel }}Repository = fake{{ pascal }}Repository([seeded]);
    const user = CurrentUserMother.random();

    // Act
{%- if targets %}
    const dependencies = { {{ camel }}Repository, ...referencedBy(seeded) };
    renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, dependencies, "/", { user });
{%- else %}
    renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, { {{ camel }}Repository }, "/", { user });
{%- endif %}

    // Assert
    expect(await screen.findByText("{{ fields[0].label }}", { selector: "dt" })).toBeTruthy();
    expect(screen.queryByText("{{ action }}", { selector: ".card-actions *" })).toBeNull();
  });
{%- endif %}
{%- endfor %}
{%- if access.delete_protected %}

  test("should show auth.prohibido when the API refuses the deletion", async () => {
    // Arrange
    const seeded = {{ pascal }}Mother.random();
    const {{ camel }}Repository = {
      ...fake{{ pascal }}Repository([seeded]),
      remove: () => Promise.reject(new {{ pascal }}Error("auth.prohibido")),
    };
{%- if targets %}
    renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, {
      {{ camel }}Repository,
      ...referencedBy(seeded),
    });
{%- else %}
    renderScreen(<{{ pascal }}DetailContainer id={seeded.id} />, { {{ camel }}Repository });
{%- endif %}
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
{%- endif %}
});
