import { Link } from "wouter";
import { rutaApp } from "../generado/rutas";
import { marca } from "../marca/marca";

/** Unos totales y unas barras de ejemplo: el aspecto de la app, no sus datos. */
const TOTALES = [
  { etiqueta: "Clientes", valor: "1.284" },
  { etiqueta: "Pedidos", valor: "342" },
  { etiqueta: "Ingresos", valor: "18.940 €" },
];
const BARRAS = ["h-2/5", "h-2/3", "h-1/2", "h-4/5", "h-3/5", "h-11/12", "h-3/4"];

/** La primera pantalla de la portada: qué es a un lado y, al otro, cómo se ve la app. */
export function SeccionCabecera() {
  return (
    <section className="bg-linear-to-b from-base-200 to-base-100 px-4 py-20">
      <div className="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
        <div className="space-y-6">
          <span className="badge badge-primary badge-soft">Nuevo en {marca.nombre}</span>
          <h1 className="text-balance text-5xl font-bold tracking-tight">{marca.eslogan}</h1>
          <p className="text-lg text-base-content/70">
            Cuenta aquí qué resuelve {marca.nombre} y para quién, en una o dos frases.
          </p>
          <div className="flex flex-wrap gap-3">
            <Link href={rutaApp} className="btn btn-primary btn-lg">
              Entrar
            </Link>
            <a href="#caracteristicas" className="btn btn-ghost btn-lg">
              Características
            </a>
          </div>
        </div>
        <div
          className="mockup-browser border border-base-300 bg-base-200 shadow-xl"
          aria-hidden="true"
        >
          <div className="mockup-browser-toolbar">
            <div className="input">{marca.nombre}</div>
          </div>
          <div className="space-y-4 bg-base-100 p-6">
            <div className="grid grid-cols-3 gap-3">
              {TOTALES.map(({ etiqueta, valor }) => (
                <div key={etiqueta} className="rounded-box bg-base-200 p-3">
                  <p className="text-xs text-base-content/70">{etiqueta}</p>
                  <p className="text-xl font-bold text-primary">{valor}</p>
                </div>
              ))}
            </div>
            <div className="flex h-32 items-end gap-2 rounded-box bg-base-200 p-3">
              {BARRAS.map((alto) => (
                <div key={alto} className={`flex-1 rounded-t bg-primary ${alto}`} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}
