/*
 * Los colores de la marca, sobre los temas claro y oscuro de daisyUI (se usa el del sistema). Lo que
 * no se cambia aquí sale del tema original. Genera otros en https://daisyui.com/theme-generator/ y
 * pega sus variables.
 */
@plugin "daisyui";

@plugin "daisyui/theme" {
  name: "light";
  default: true;
  --color-primary: oklch(27% 0.02 260);
  --color-primary-content: oklch(98% 0.005 260);
  --color-accent: oklch(58% 0.17 255);
  --color-accent-content: oklch(98% 0.01 255);
  --color-base-200: oklch(97% 0.004 260);
  --color-base-300: oklch(92% 0.006 260);
  --radius-box: 0.5rem;
  --radius-field: 0.375rem;
  --radius-selector: 0.25rem;
}

@plugin "daisyui/theme" {
  name: "dark";
  prefersdark: true;
  --color-primary: oklch(94% 0.01 260);
  --color-primary-content: oklch(22% 0.02 260);
  --color-accent: oklch(68% 0.15 255);
  --color-accent-content: oklch(18% 0.03 255);
  --color-base-100: oklch(20% 0.01 260);
  --color-base-200: oklch(17% 0.01 260);
  --color-base-300: oklch(26% 0.012 260);
  --radius-box: 0.5rem;
  --radius-field: 0.375rem;
  --radius-selector: 0.25rem;
}
