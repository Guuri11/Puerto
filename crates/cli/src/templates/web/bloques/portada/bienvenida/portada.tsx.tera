import { Link } from "wouter";
import { rutaApp } from "../generado/rutas";
import { marca } from "../marca/marca";

/**
 * La portada pública, en `/`: la marca y la entrada a la app. `puerto generar web-bloque` lista
 * otras (`portada/producto`: las secciones de una web de producto).
 */
export function PaginaPortada() {
  return (
    <main className="hero min-h-screen bg-base-200">
      <div className="hero-content flex-col gap-6 text-center">
        <img src={marca.logo} alt="" className="size-20" />
        <h1 className="text-5xl font-bold">{marca.nombre}</h1>
        <p className="max-w-md text-lg text-base-content/70">{marca.eslogan}</p>
        <Link href={rutaApp} className="btn btn-primary btn-lg">
          Entrar
        </Link>
      </div>
    </main>
  );
}
