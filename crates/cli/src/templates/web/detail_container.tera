import { useState } from "react";
import { Link, useLocation } from "wouter";
import { unwrap } from "../../../api/http";
{% if access.update_roles or access.delete_roles -%}
import { useAuth } from "../../../auth/auth";
{% endif -%}
import { useDependencies } from "../../../dependencies";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { {{ pascal }}DetailView } from "../views/{{ kebab }}-detail-view";

export function {{ pascal }}DetailContainer({ id }: { id: string }) {
  const { api } = useDependencies();
{%- if access.update_roles or access.delete_roles %}
  const { can } = useAuth();
{%- endif %}
{%- if detail_load_inline %}
  const {{ ident }} = useAsync(() => unwrap(api.GET("/{{ plural }}/{id}", { params: { path: { id } } })), [api, id]);
{%- else %}
  const {{ ident }} = useAsync(
    () => unwrap(api.GET("/{{ plural }}/{id}", { params: { path: { id } } })),
    [api, id],
  );
{%- endif %}
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await unwrap(api.DELETE("/{{ plural }}/{id}", { params: { path: { id } } }));
      navigate("/{{ plural }}");
    } catch (error) {
      setFailure(error);
    }
  };
{%- for t in targets %}
  const {{ t.camel }}Label = async (target: string) => {
    const params = { path: { id: target } };
    const found = await unwrap(api.GET("/{{ t.plural }}/{id}", { params }));
    return found.{{ t.label }};
  };
{%- endfor %}

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{{ label }}</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {{ "{" }}{{ ident }}.status === "loading" && <span className="loading loading-spinner" />}
      {{ "{" }}{{ ident }}.status === "error" && <ErrorAlert error={{ "{" }}{{ ident }}.error} />}
      {{ "{" }}{{ ident }}.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
{%- if detail_view_inline %}
            <{{ pascal }}DetailView {{ ident }}={{ "{" }}{{ ident }}.data}{% for t in targets %} {{ t.camel }}Label={{ "{" }}{{ t.camel }}Label}{% endfor %} />
{%- else %}
            <{{ pascal }}DetailView
              {{ ident }}={{ "{" }}{{ ident }}.data}
{%- for t in targets %}
              {{ t.camel }}Label={{ "{" }}{{ t.camel }}Label}
{%- endfor %}
            />
{%- endif %}
            <div className="card-actions justify-end">
{%- if access.update_roles %}
              {{ "{" }}{% for r in access.update_roles %}can("{{ r }}") && {% endfor %}(
                <Link href={`/{{ plural }}/${id}/edit`} className="btn">
                  Edit
                </Link>
              )}
{%- else %}
              <Link href={`/{{ plural }}/${id}/edit`} className="btn">
                Edit
              </Link>
{%- endif %}
{%- if access.delete_roles %}
              {{ "{" }}{% for r in access.delete_roles %}can("{{ r }}") && {% endfor %}(
                <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                  Delete
                </button>
              )}
{%- else %}
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
{%- endif %}
            </div>
          </div>
        </div>
      )}
      <Link href="/{{ plural }}" className="link">
        Back to {{ words_plural }}
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this {{ words }}?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}
