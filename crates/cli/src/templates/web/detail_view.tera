import type { Schemas } from "../../../api/client";
{%- if display_helpers %}
import { {{ display_helpers | join(sep=", ") }} } from "../../../shared/forms";
{%- endif %}
{%- if targets %}
import { ReferenceLink } from "../../../shared/ui/reference-link";
{%- endif %}

type {{ pascal }} = Schemas["Dto{{ pascal }}"];

{% if targets -%}
/** `{{ ident }}`, and the label of each {% for t in targets %}{{ t.words }}{% if not loop.last %} and {% endif %}{% endfor %} it references, for its links. */
export function {{ pascal }}DetailView({
  {{ ident }},
{%- for t in targets %}
  {{ t.camel }}Label,
{%- endfor %}
}: {
  {{ ident }}: {{ pascal }};
{%- for t in targets %}
  {{ t.camel }}Label: (id: string) => Promise<string>;
{%- endfor %}
}) {
{%- else -%}
export function {{ pascal }}DetailView({ {{ ident }} }: { {{ ident }}: {{ pascal }} }) {
{%- endif %}
  return (
    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
{%- for f in fields %}
      <dt className="font-semibold">{{ f.label }}</dt>
{%- if f.input == "reference" %}
{%- for r in references %}{% if r.camel == f.camel %}
      <dd>
{%- if r.link_inline %}
        <ReferenceLink path="{{ r.ref_path }}" id={{ "{" }}{{ ident }}.{{ r.camel }}} load={{ "{" }}{{ r.loader }}} />
{%- else %}
        <ReferenceLink
          path="{{ r.ref_path }}"
          id={{ "{" }}{{ ident }}.{{ r.camel }}}
          load={{ "{" }}{{ r.loader }}}
        />
{%- endif %}
      </dd>
{%- endif %}{% endfor %}
{%- else %}
      <dd>{{ "{" }}{{ f.display }}}</dd>
{%- endif %}
{%- endfor %}
    </dl>
  );
}
