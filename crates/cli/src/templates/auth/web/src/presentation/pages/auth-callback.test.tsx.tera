import { describe, expect, test } from "bun:test";
import { screen, waitFor } from "@testing-library/react";
import { CurrentUserMother, fakeAuthGateway } from "../../test-support/auth";
import { renderScreen } from "../../test-support/render";
import { AuthCallbackPage } from "./auth-callback";

describe("AuthCallbackPage", () => {
  test("should go back to the page the sign-in started on", async () => {
    // Arrange
    const auth = { ...fakeAuthGateway(), completeLogin: async () => "/orders?page=2" };

    // Act
    const { history } = renderScreen(<AuthCallbackPage />, { auth }, "/auth/callback");

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/orders?page=2"));
  });

  test("should show why when the provider's answer is refused", async () => {
    // Arrange
    const auth = {
      ...fakeAuthGateway({ user: CurrentUserMother.random() }),
      completeLogin: () => Promise.reject(new Error("No matching state found in storage")),
    };

    // Act
    renderScreen(<AuthCallbackPage />, { auth }, "/auth/callback");

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "No matching state found in storage",
    );
  });
});
