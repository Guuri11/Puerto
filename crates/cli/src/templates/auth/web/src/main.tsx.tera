import "./index.css";

import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import { Route, Switch } from "wouter";
import { ProveedorAuth } from "./auth/auth";
import { Marco } from "./compartido/ui/marco";
import { MarcoAcceso } from "./compartido/ui/marco-acceso";
import { ProveedorDependencias } from "./dependencias";
import { crearDependencias } from "./generado/dependencias";
import { entradasMenu, RutasApp } from "./generado/rutas";
import { marca } from "./marca/marca";
{% if local -%}
import { PaginaLogin } from "./paginas/login";
import { PaginaRegistro } from "./paginas/registro";
{% else -%}
import { PaginaAuthCallback } from "./paginas/auth-callback";
{% endif %}
const raiz = document.getElementById("root");
if (raiz === null) {
  throw new Error("index.html no tiene el elemento #root");
}
document.title = marca.nombre;

createRoot(raiz).render(
  <StrictMode>
    <ProveedorDependencias valor={crearDependencias()}>
      <ProveedorAuth>
        <Switch>
{%- if local %}
          <Route path="/login">
            <MarcoAcceso>
              <PaginaLogin />
            </MarcoAcceso>
          </Route>
          <Route path="/registro">
            <MarcoAcceso>
              <PaginaRegistro />
            </MarcoAcceso>
          </Route>
{%- else %}
          <Route path="/auth/callback">
            <MarcoAcceso>
              <PaginaAuthCallback />
            </MarcoAcceso>
          </Route>
{%- endif %}
          <Route>
            <Marco menu={entradasMenu}>
              <RutasApp />
            </Marco>
          </Route>
        </Switch>
      </ProveedorAuth>
    </ProveedorDependencias>
  </StrictMode>,
);
