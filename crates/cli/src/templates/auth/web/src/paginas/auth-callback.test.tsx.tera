import { describe, expect, test } from "bun:test";
import { screen, waitFor } from "@testing-library/react";
import { MadreUsuarioActual, pasarelaAuthFalsa } from "../pruebas/auth";
import { renderizarPantalla } from "../pruebas/renderizar";
import { PaginaAuthCallback } from "./auth-callback";

describe("PaginaAuthCallback", () => {
  test("debería volver a la página en la que empezó el inicio de sesión", async () => {
    // Preparar
    const auth = { ...pasarelaAuthFalsa(), completarLogin: async () => "/pedidos?pagina=2" };

    // Actuar
    const { historial } = renderizarPantalla(<PaginaAuthCallback />, { auth }, "/auth/callback");

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/pedidos?pagina=2"));
  });

  test("debería decir por qué cuando se rechaza la respuesta del proveedor", async () => {
    // Preparar
    const auth = {
      ...pasarelaAuthFalsa({ usuario: MadreUsuarioActual.aleatorio() }),
      completarLogin: () => Promise.reject(new Error("No matching state found in storage")),
    };

    // Actuar
    renderizarPantalla(<PaginaAuthCallback />, { auth }, "/auth/callback");

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(
      "No matching state found in storage",
    );
  });
});
