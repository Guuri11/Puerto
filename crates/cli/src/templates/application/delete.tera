{% import "application/macros.tera" as macros %}{% set required = fields | filter(attribute="required_string", value=true) %}{% set string_vos = fields | filter(attribute="string_vo", value=true) %}use std::sync::Arc;

use async_trait::async_trait;

use dominio_{{ snake }}::{
    errores::Error{{ pascal }},
    repositorio::Repositorio{{ pascal }},
};

pub struct Borrar{{ pascal }}Impl {
    pub repositorio: Arc<dyn Repositorio{{ pascal }}>,
}

#[async_trait]
impl Borrar{{ pascal }} for Borrar{{ pascal }}Impl {
    async fn ejecutar(&self, params: ParamsBorrar{{ pascal }}) -> Result<(), Error{{ pascal }}> {
        tracing::info!(id = %params.id, "borrar_{{ snake }}: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_{{ snake }}: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = Error{{ pascal }}::NoEncontrado;
                tracing::warn!(error = %err, "borrar_{{ snake }}: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio.guardar(&entidad).await.inspect_err(|e| tracing::error!(error = %e, "borrar_{{ snake }}: fallo del repositorio"))?;
        Ok(())
    }
}

