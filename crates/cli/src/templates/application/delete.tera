{% import "application/macros.tera" as macros %}{% set required = fields | filter(attribute="required_string", value=true) %}{% set string_vos = fields | filter(attribute="string_vo", value=true) %}use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::{{ snake }}::{
    errors::{{ pascal }}Error,
    repository::{{ pascal }}RepositoryTrait,
    use_cases::delete_{{ snake }}::{Delete{{ pascal }}Params, Delete{{ pascal }}UseCaseTrait},
};

pub struct Delete{{ pascal }}UseCaseImpl {
    pub repository: Arc<dyn {{ pascal }}RepositoryTrait>,
}

#[async_trait]
impl Delete{{ pascal }}UseCaseTrait for Delete{{ pascal }}UseCaseImpl {
    async fn execute(&self, params: Delete{{ pascal }}Params) -> Result<(), {{ pascal }}Error> {
        tracing::info!(id = %params.id, "delete_{{ snake }}: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_{{ snake }}: repository failed"))?
            .ok_or_else(|| {
                let err = {{ pascal }}Error::NotFound;
                tracing::warn!(error = %err, "delete_{{ snake }}: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "delete_{{ snake }}: repository failed"))?;
        Ok(())
    }
}

