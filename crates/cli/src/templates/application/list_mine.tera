use dominio_{{ snake }}::{
    errores::Error{{ pascal }},
    modelo::{{ pascal }},
    repositorio::{Filtro{{ pascal }}, Repositorio{{ pascal }}},
};

#[derive(Debug, Clone)]
pub struct ParamsListarMis{{ plural_pascal }} {
    /// Quien lo pide: la lista son sus filas (`propietario` en puerto.toml).
    pub actor: Principal,
    pub pagina: PeticionPagina,
}

/// Las filas de quien llama, paginadas: `GET /mis_{{ plural }}`.
#[async_trait]
pub trait ListarMis{{ plural_pascal }}: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsListarMis{{ plural_pascal }},
    ) -> Result<Pagina<{{ pascal }}>, Error{{ pascal }}>;
}

