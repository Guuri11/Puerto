{% import "application/macros.tera" as macros %}{% set required = fields | filter(attribute="required_string", value=true) %}{% set string_vos = fields | filter(attribute="string_vo", value=true) %}use std::sync::Arc;

use async_trait::async_trait;
{% for import in vo_imports %}use {{ import }};
{% endfor %}
use dominio_{{ snake }}::{
    errores::Error{{ pascal }},
    modelo::{{ "{" }}{{ pascal }}, Props{{ pascal }}},
    repositorio::Repositorio{{ pascal }},
};

pub struct Actualizar{{ pascal }}Impl {
    pub repositorio: Arc<dyn Repositorio{{ pascal }}>,
}

#[async_trait]
impl Actualizar{{ pascal }} for Actualizar{{ pascal }}Impl {
    async fn ejecutar(&self, params: ParamsActualizar{{ pascal }}) -> Result<{{ pascal }}, Error{{ pascal }}> {
        tracing::info!(id = %params.id, "actualizar_{{ snake }}: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "actualizar_{{ snake }}: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = Error{{ pascal }}::NoEncontrado;
                tracing::warn!(error = %err, "actualizar_{{ snake }}: rechazado");
                err
            })?;
{% for f in fields | filter(attribute="is_vo", value=true) %}let {{ f.name }}{% if f.is_vec_vo %}: Vec<{{ f.vo }}>{% endif %} = {{ f.from_params }};
{% endfor %}        entidad
            .actualizar(Props{{ pascal }} {
{% for f in fields %}                {{ f.name }}{% if not f.is_vo %}: params.{{ f.name }}{% endif %},
{% endfor %}            })
            .inspect_err(|e| tracing::warn!(error = %e, "actualizar_{{ snake }}: rechazado"))?;
        self.repositorio.guardar(&entidad).await.inspect_err(|e| tracing::error!(error = %e, "actualizar_{{ snake }}: fallo del repositorio"))?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
