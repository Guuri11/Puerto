};

pub struct Actualizar{{ pascal }}Impl {
    pub repositorio: Arc<dyn Repositorio{{ pascal }}>,
}

#[async_trait]
impl Actualizar{{ pascal }} for Actualizar{{ pascal }}Impl {
    #[tracing::instrument(name = "actualizar_{{ snake }}", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsActualizar{{ pascal }}) -> Result<{{ pascal }}, Error{{ pascal }}> {
        let mut entidad = self.repositorio.buscar_por_id(params.id).await?.ok_or(Error{{ pascal }}::NoEncontrado)?;{% if owner %}{{ macros::owner_check(owner=owner, roles=owner_roles, pascal=pascal) }}{% endif %}
{% for f in asked | filter(attribute="is_vo", value=true) %}let {{ f.name }}{% if f.is_vec_vo %}: Vec<{{ f.vo }}>{% endif %} = {{ f.from_params }};
{% endfor %}{% for f in fields | filter(attribute="in_update", value=false) %}        let {{ f.name }} = entidad.{{ f.name }}{% if f.needs_clone %}.clone(){% endif %};
{% endfor %}        entidad
            .actualizar(Props{{ pascal }} {
{% for f in fields %}                {{ f.name }}{% if f.in_update and not f.is_vo %}: params.{{ f.name }}{% endif %},
{% endfor %}            })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

