            .returning(|_| Err(ErrorRepositorio::ReferenciaInexistente("{{ r.name }}")));
        let caso_de_uso = Crear{{ pascal }}Impl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrear{{ pascal }} {
{% if actor %}                actor: MadrePrincipal::aleatorio(),
{% endif %}{{ macros::params_madre(fields=fields) }}            })
