{% import "application/macros.tera" as macros %}{% set required = fields | filter(attribute="required_string", value=true) %}{% set string_vos = fields | filter(attribute="string_vo", value=true) %}use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::RepositoryError;
{% for import in vo_imports %}use {{ import }};
{% endfor %}
use crate::domain::{{ snake }}::{
    errors::{{ pascal }}Error,
    events::{{ "{" }}{{ pascal }}Event, {{ pascal }}Snapshot},
    model::{{ pascal }},
    repository::{{ pascal }}RepositoryTrait,
    unit_of_work::{{ pascal }}UnitOfWorkFactory,
    use_cases::update_{{ snake }}::{Update{{ pascal }}Params, Update{{ pascal }}UseCaseTrait},
};

pub struct Update{{ pascal }}UseCaseImpl {
    pub repository: Arc<dyn {{ pascal }}RepositoryTrait>,
    pub uow_factory: Arc<dyn {{ pascal }}UnitOfWorkFactory>,
}

#[async_trait]
impl Update{{ pascal }}UseCaseTrait for Update{{ pascal }}UseCaseImpl {
    async fn execute(&self, params: Update{{ pascal }}Params) -> Result<{{ pascal }}, {{ pascal }}Error> {
        tracing::info!(id = %params.id, "update_{{ snake }}: start");
        let failed = |e: &RepositoryError| tracing::error!(error = %e, "update_{{ snake }}: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = {{ pascal }}Error::NotFound;
                tracing::warn!(error = %err, "update_{{ snake }}: rejected");
                err
            })?;
{% for f in required %}        if params.{{ f.name }}.trim().is_empty() {
            let err = {{ pascal }}Error::ValidationError("{{ f.name }}_empty".into());
            tracing::warn!(error = %err, "update_{{ snake }}: rejected");
            return Err(err);
        }
{% endfor %}{% for f in fields | filter(attribute="is_vo", value=true) %}let {{ f.name }}{% if f.is_vec_vo %}: Vec<{{ f.vo }}>{% endif %} = {{ f.from_params }};
{% endfor %}{% for f in fields %}        entity.{{ f.name }} = {% if not f.is_vo %}params.{% endif %}{{ f.name }};
{% endfor %}        entity.updated_at = chrono::Utc::now();
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record({{ pascal }}Event::Updated({{ pascal }}Snapshot::from_entity(&entity))).await.inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
{% if actor %}    use crate::tests::mothers::principal_mother::PrincipalMother;
{% endif %}    use crate::domain::{{ snake }}::{
