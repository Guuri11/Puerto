    fn repository_holding(entity: {{ pascal }}) -> Mock{{ pascal }}Repository {
        let mut mock_repo = Mock{{ pascal }}Repository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo
    }

    #[tokio::test]
    async fn should_record_{{ snake }}_updated_when_params_are_valid() {
        // Arrange
        let entity = {{ pascal }}::new({{ pascal }}Props {
{{ macros::props(fields=fields, word="original") }}        }).unwrap();
        let entity_id = entity.id;
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = Update{{ pascal }}UseCaseImpl {
            repository: Arc::new(repository_holding(entity)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(Update{{ pascal }}Params {
{% if actor %}                actor: PrincipalMother::random(),
{% endif %}            id: entity_id,
{{ macros::params(fields=fields, word="updated") }}            })
            .await;

        // Assert
        {% if required %}assert_eq!(result.unwrap().{{ required.0.name }}, "updated");{% elif string_vos %}assert_eq!(result.unwrap().{{ string_vos.0.name }}.value(), "updated");{% else %}assert!(result.is_ok());{% endif %}
        let recorded = uow_factory.recorded();
        assert!(recorded.committed);
        assert_eq!(recorded.events.len(), 1);
        assert_eq!(recorded.events[0].event_type(), "{{ snake }}_updated");
        assert_eq!(recorded.events[0].aggregate_id(), entity_id.value());
    }

    #[tokio::test]
    async fn should_return_not_found_and_record_nothing_when_the_{{ snake }}_does_not_exist() {
        // Arrange
        let mut mock_repo = Mock{{ pascal }}Repository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = Update{{ pascal }}UseCaseImpl {
            repository: Arc::new(mock_repo),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(Update{{ pascal }}Params {
{% if actor %}                actor: PrincipalMother::random(),
{% endif %}            id: {{ pascal }}Id::generate(),
{{ macros::params(fields=fields, word="new") }}            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "{{ snake }}.not_found");
        let recorded = uow_factory.recorded();
        assert!(recorded.saved.is_empty());
        assert!(recorded.events.is_empty());
    }
