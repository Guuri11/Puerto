use async_trait::async_trait;
{% for import in vo_imports %}use {{ import }};
{% endfor %}
use dominio_{{ snake }}::{
    errores::Error{{ pascal }},
    modelo::{{ "{" }}{{ pascal }}, Props{{ pascal }}},
    repositorio::Repositorio{{ pascal }},
    unit_of_work::UnitOfWorkFactory{{ pascal }},
};

pub struct Actualizar{{ pascal }}Impl {
    pub repositorio: Arc<dyn Repositorio{{ pascal }}>,
    pub uow_factory: Arc<dyn UnitOfWorkFactory{{ pascal }}>,
}

#[async_trait]
impl Actualizar{{ pascal }} for Actualizar{{ pascal }}Impl {
    #[tracing::instrument(name = "actualizar_{{ snake }}", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsActualizar{{ pascal }}) -> Result<{{ pascal }}, Error{{ pascal }}> {
        let mut entidad = self.repositorio.buscar_por_id(params.id).await?.ok_or(Error{{ pascal }}::NoEncontrado)?;
{% for f in fields | filter(attribute="is_vo", value=true) %}let {{ f.name }}{% if f.is_vec_vo %}: Vec<{{ f.vo }}>{% endif %} = {{ f.from_params }};
{% endfor %}        let evento = entidad
            .actualizar(Props{{ pascal }} {
{% for f in fields %}                {{ f.name }}{% if not f.is_vo %}: params.{{ f.name }}{% endif %},
{% endfor %}            })?;
        self.uow_factory.guardar(&entidad, evento).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
{% if actor %}    use puerto_nucleo::auth::dobles::MadrePrincipal;
{% endif %}    use dominio_{{ snake }}::{
        modelo::Id{{ pascal }},
        pruebas::madres::Madre{{ pascal }},
        repositorio::dobles::MockRepositorio{{ pascal }},
        unit_of_work::dobles::UnitOfWorkFactoryGrabadora,
    };
    use puerto_nucleo::EventoDominio;


    fn repositorio_con(entidad: {{ pascal }}) -> MockRepositorio{{ pascal }} {
        let mut repositorio_doble = MockRepositorio{{ pascal }}::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble
    }

    #[tokio::test]
    async fn deberia_registrar_el_evento_{{ snake }}_actualizado_cuando_los_parametros_son_validos() {
        // Preparar
        let props = Madre{{ pascal }}::new().construir_props();
        let {% if required %}mut {% endif %}entidad = Madre{{ pascal }}::aleatorio();{% if required %}
        // Lo que estaba guardado, distinto de lo que trae la actualización.
        entidad.{{ required.0.name }} = "original".to_string();{% endif %}
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = Actualizar{{ pascal }}Impl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizar{{ pascal }} {
{% if actor %}                actor: MadrePrincipal::aleatorio(),
{% endif %}            id: id_entidad,
{{ macros::params_madre(fields=fields) }}            })
            .await;

        // Comprobar
        {% if required %}assert_eq!(resultado.unwrap().{{ required.0.name }}, Madre{{ pascal }}::new().construir_props().{{ required.0.name }});{% else %}assert!(resultado.is_ok());{% endif %}
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "{{ snake }}_actualizado");
        assert_eq!(grabado.eventos[0].id_agregado(), id_entidad.valor());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_sin_registrar_nada_cuando_{{ snake }}_no_existe() {
        // Preparar
        let props = Madre{{ pascal }}::new().construir_props();
        let mut repositorio_doble = MockRepositorio{{ pascal }}::new();
        repositorio_doble.expect_buscar_por_id().returning(|_| Ok(None));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = Actualizar{{ pascal }}Impl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizar{{ pascal }} {
{% if actor %}                actor: MadrePrincipal::aleatorio(),
{% endif %}            id: Id{{ pascal }}::generar(),
{{ macros::params_madre(fields=fields) }}            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "{{ snake }}.no_encontrado");
        let grabado = uow_factory.grabado();
        assert!(grabado.guardados.is_empty());
        assert!(grabado.eventos.is_empty());
    }
