            "{% if f.is_vo %}{{ snake }}.{{ f.vo_snake }}_invalido{% else %}{{ snake }}.validacion.{{ f.name }}_vacio{% endif %}"
        );
        assert!(uow_factory.grabado().guardados.is_empty());
    }
