    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = Mock{{ pascal }}Repository::new();
        mock_repo
            .expect_find_all()
            .withf(|page{% if refs %}, _{% endif %}| page.limit() == 5 && page.offset() == 10)
            .returning(|page{% if refs %}, _{% endif %}| Ok(Page::new(vec![], 0, page)));
        let use_case = List{{ plural_pascal }}UseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(List{{ plural_pascal }}Params { {% if actor %}actor: PrincipalMother::random(), {% endif %}page: PageRequest::new(Some(5), Some(10)){% for r in refs %}, {{ r.name }}: None{% endfor %} })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
