[package]
name = "aplicacion_usuario"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_usuario = { workspace = true }
puerto-nucleo = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# The use cases' doubles (`mock!`), for the tests of other crates (ADR-0023 § 5 of Puerto).
pruebas = ["dep:mockall", "dominio_usuario/pruebas"]

[dev-dependencies]
dominio_usuario = { workspace = true, features = ["pruebas"] }
# The auth ports' doubles (`MockHasherContrasena`, …).
puerto-nucleo = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }
