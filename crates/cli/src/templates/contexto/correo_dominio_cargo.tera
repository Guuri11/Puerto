[package]
name = "dominio_correo"
version = "0.1.0"
edition = "2024"

[dependencies]
puerto-nucleo = { workspace = true }
async-trait = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los enviadores (`mock!`), para los tests del código que envía los correos
# (ADR-0023 § 5 de Puerto).
pruebas = ["dep:mockall"]

[dev-dependencies]
mockall = { workspace = true }
