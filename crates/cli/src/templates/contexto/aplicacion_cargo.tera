[package]
name = "aplicacion_{{ c }}"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_{{ c }} = { workspace = true }
puerto-nucleo = { workspace = true }
{% if shared %}nucleo = { workspace = true }
{% endif %}{% for r in refs %}dominio_{{ r }} = { workspace = true }
{% endfor %}async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_{{ c }}/pruebas"]

[dev-dependencies]
{% if auth %}# Quien llama en los tests: `MadrePrincipal`, y el `MockAutenticador` de las rutas.
puerto-nucleo = { workspace = true, features = ["pruebas"] }
{% endif %}dominio_{{ c }} = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }
