[package]
name = "rest_{{ c }}"
version = "0.1.0"
edition = "2024"

[dependencies]
aplicacion_{{ c }} = { workspace = true }
dominio_{{ c }} = { workspace = true }
{% for r in refs %}dominio_{{ r }} = { workspace = true }
{% endfor %}puerto-nucleo = { workspace = true }
puerto-web = { workspace = true }
poem = { workspace = true }
poem-openapi = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }

[dev-dependencies]
{% if auth %}# Quien llama en los tests: `MadrePrincipal`, y el `MockAutenticador` de las rutas.
puerto-nucleo = { workspace = true, features = ["pruebas"] }
{% endif %}aplicacion_{{ c }} = { workspace = true, features = ["pruebas"] }
dominio_{{ c }} = { workspace = true, features = ["pruebas"] }
{% for r in refs %}dominio_{{ r }} = { workspace = true, features = ["pruebas"] }
{% endfor %}poem = { workspace = true, features = ["test"] }
tokio = { workspace = true }
