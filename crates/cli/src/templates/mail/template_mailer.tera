//! Renders the `{{ name }}` mail from its templates and hands it to the mailer. Written once by
//! `puerto generar correo`; it is yours now. The text is in `plantillas/{{ name }}/`:
//! change it there — the tests below render it again, so a typo fails `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::{{ name }}::{ {{- pascal }}Mail, {{ pascal }}Mailer};
use puerto_correo::{ErrorCorreo, EnviadorCorreo, Plantillas};
use serde::Serialize;
{%- for import in imports %}
use {{ import }};
{%- endfor %}

const TEMPLATES: Plantillas = Plantillas::new(
    include_str!("../plantillas/{{ name }}/subject.txt"),
    include_str!("../plantillas/{{ name }}/body.html"),
)
.con_texto(include_str!("../plantillas/{{ name }}/body.txt"));

/// What the templates see: the mail's fields but the recipient, under their own names.
#[derive(Serialize)]
struct Context<'a> {
{%- for f in fields %}
    {{ f.name }}: &'a {{ f.rust_type }},
{%- endfor %}
}

impl<'a> Context<'a> {
    fn of(mail: &'a {{ pascal }}Mail) -> Self {
        Self {
{%- for f in fields %}
            {{ f.name }}: &mail.{{ f.name }},
{%- endfor %}
        }
    }
}

/// The `{{ name }}` mail, rendered from `plantillas/{{ name }}/` and sent through `mailer`
/// (`puerto_correo::EnviadorCorreoSmtp` where it runs).
pub struct Template{{ pascal }}Mailer {
    mailer: Arc<dyn EnviadorCorreo>,
}

impl Template{{ pascal }}Mailer {
    pub fn new(mailer: Arc<dyn EnviadorCorreo>) -> Self {
        Self { mailer }
    }
}

#[async_trait]
impl {{ pascal }}Mailer for Template{{ pascal }}Mailer {
    async fn send(&self, mail: &{{ pascal }}Mail) -> Result<(), ErrorCorreo> {
        let email = TEMPLATES.renderizar(mail.to.clone(), Context::of(mail))?;
        self.mailer.enviar(&email).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn {{ name }}() -> {{ pascal }}Mail {
        {{ pascal }}Mail {
            to: "ada@example.com".to_string(),
{%- for f in fields %}
            {{ f.name }}: {{ f.sample }},
{%- endfor %}
        }
    }

    #[test]
    fn should_render_every_template_when_the_mail_has_its_fields() {
        // Act
        let email = TEMPLATES.renderizar("ada@example.com", Context::of(&{{ name }}()));

        // Assert
        let email = match email {
            Ok(email) => email,
            Err(err) => panic!("plantillas/{{ name }}/ does not render: {err}"),
        };
        assert!(!email.asunto.is_empty());
        assert!(!email.html.is_empty());
        assert!(email.texto.is_some());
    }

    #[tokio::test]
    async fn should_send_the_rendered_mail_to_its_recipient() {
        // Arrange
        let recorder = Arc::new(EnviadorCorreoGrabador::new());
        let mailer = Template{{ pascal }}Mailer::new(recorder.clone());

        // Act
        let result = mailer.send(&{{ name }}()).await;

        // Assert
        assert_eq!(result, Ok(()));
        let sent = recorder.enviados();
        assert_eq!(sent.len(), 1);
        assert_eq!(sent[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn should_return_the_mailer_error_when_sending_fails() {
        // Arrange
        let rejected = ErrorCorreo::Permanente("550 no such user".to_string());
        let mailer =
            Template{{ pascal }}Mailer::new(Arc::new(EnviadorCorreoGrabador::fallando_con(rejected.clone())));

        // Act
        let result = mailer.send(&{{ name }}()).await;

        // Assert
        assert_eq!(result, Err(rejected));
    }
}
