/// Sends the `{{ name }}` mail. `Template{{ pascal }}Mailer` (infrastructure) renders and sends it;
/// tests use `mocks::Mock{{ pascal }}Mailer`.
#[async_trait]
pub trait {{ pascal }}Mailer: Send + Sync {
    async fn send(&self, mail: &{{ pascal }}Mail) -> Result<(), MailError>;
}

