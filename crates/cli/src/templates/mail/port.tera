//! El correo `{{ name }}`: lo que lleva y el puerto que lo envía. Lo escribe una vez
//! `puerto generar correo`; desde entonces es tuyo: añade un campo, renombra otro, calcula el
//! destinatario. Su texto está en `contextos/correo/infraestructura/plantillas/{{ name }}/`, y lo
//! renderiza `EnviadorCorreo{{ pascal }}Plantilla`.

use async_trait::async_trait;
use puerto_nucleo::correo::ErrorCorreo;
{%- for import in imports %}
use {{ import }};
{%- endfor %}

/// Lo que dice el correo `{{ name }}`: a quién va y los valores que muestran sus plantillas.
#[derive(Debug, Clone, PartialEq)]
pub struct Correo{{ pascal }} {
    pub para: String,
{%- for f in fields %}
    pub {{ f.name }}: {{ f.rust_type }},
{%- endfor %}
}

/// Envía el correo `{{ name }}`. `EnviadorCorreo{{ pascal }}Plantilla` (infraestructura) lo
/// renderiza y lo envía; los tests usan `dobles::MockEnviadorCorreo{{ pascal }}`.
#[async_trait]
pub trait EnviadorCorreo{{ pascal }}: Send + Sync {
    async fn enviar(&self, correo: &Correo{{ pascal }}) -> Result<(), ErrorCorreo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use super::*;
    use mockall::mock;

    mock! {
        pub EnviadorCorreo{{ pascal }} {}

        #[async_trait]
        impl EnviadorCorreo{{ pascal }} for EnviadorCorreo{{ pascal }} {
            async fn enviar(&self, correo: &Correo{{ pascal }}) -> Result<(), ErrorCorreo>;
        }
    }
}
