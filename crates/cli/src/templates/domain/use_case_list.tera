{% endif %}use puerto_nucleo::{Pagina, PeticionPagina};

use dominio_{{ snake }}::{errores::Error{{ pascal }}, modelo::{{ pascal }}};
{% for import in reference_imports %}use {{ import }};
{% endfor %}
#[derive(Debug, Clone)]
pub struct ParamsListar{{ plural_pascal }} {
{% if actor %}    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
{% endif %}    pub pagina: PeticionPagina,
{% for r in fields | filter(attribute="is_ref", value=true) %}    /// Si se indica, solo {{ plural }} con este `{{ r.name }}`.
    pub {{ r.name }}: Option<Id{{ r.ref_target }}>,
{% endfor %}}

#[async_trait]
pub trait Listar{{ plural_pascal }}: Send + Sync {
    async fn ejecutar(&self, params: ParamsListar{{ plural_pascal }}) -> Result<Pagina<{{ pascal }}>, Error{{ pascal }}>;
}

