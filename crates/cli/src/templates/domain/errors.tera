use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum Error{{ pascal }} {
    #[error("{{ snake }}.validacion.{0}")]
    Validacion(String),
    #[error("{{ snake }}.no_encontrado")]
    NoEncontrado,
    #[error("{{ snake }}.duplicado")]
    Duplicado,
    #[error("{{ snake }}.repositorio")]
    Repositorio,
    #[error("{{ snake }}.desconocido")]
    Desconocido,
{% if auth %}    /// Quien llama no puede hacer esto con estos datos: regla del caso de uso, sobre su `actor`.
    #[error("{{ snake }}.prohibido")]
    Prohibido,
{% endif %}{% for f in vo_fields %}    #[error("{{ snake }}.{{ f.vo_snake }}_invalido")]
    {{ f.vo_pascal }}Invalido,
{% endfor %}}

impl From<ErrorRepositorio> for Error{{ pascal }} {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
{% if references %}            // Una referencia nombra una fila inexistente: la entrada de quien llama, en ese campo.
            ErrorRepositorio::ReferenciaInexistente(campo) => {
                Self::Validacion(format!("{campo}_no_encontrado"))
            }
{% endif %}            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = Error{{ pascal }}::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "{{ snake }}.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = Error{{ pascal }}::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "{{ snake }}.repositorio");
    }

{% if references %}    #[test]
    fn deberia_convertir_una_referencia_inexistente_en_una_validacion_de_su_campo() {
        let err = Error{{ pascal }}::from(ErrorRepositorio::ReferenciaInexistente("{{ first_reference }}"));
        assert_eq!(err.to_string(), "{{ snake }}.validacion.{{ first_reference }}_no_encontrado");
    }

{% endif %}    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = Error{{ pascal }}::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "{{ snake }}.repositorio");
    }
}
