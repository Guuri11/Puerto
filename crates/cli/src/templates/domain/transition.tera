/// La transición `{{ verb }}` (`puerto generar transicion`): un `impl` aparte, así que `modelo.rs`
/// no cambia. La regla y el cambio son tuyos.
impl {{ pascal }} {
    pub fn {{ verb }}(&mut self) -> Result<{% if events %}Evento{{ pascal }}{% else %}(){% endif %}, Error{{ pascal }}> {
        // La regla: cuándo no se puede {{ verb_words }}. {% if internal %}Quien la llama recibe{% else %}La API responde 422 con{% endif %} este código:
        // if <no se puede> {
        //     return Err(Error{{ pascal }}::Validacion("no_se_puede_{{ verb }}".into()));
        // }
        // El cambio: los campos que pasan a otro valor (p. ej. un estado).
        self.actualizado_en = chrono::Utc::now();
        Ok({% if events %}Evento{{ pascal }}::{{ variant }}(Snapshot{{ pascal }}::from_entidad(self)){% else %}(){% endif %})
    }
}

