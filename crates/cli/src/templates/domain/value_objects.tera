{% import "domain/value_object_macros.tera" as macros %}{% for import in imports %}use {{ import }};
{% endfor %}{% for v in vos %}
{% if not loop.first %}
{% endif %}{% if v.variants %}#[derive(Debug, Clone, PartialEq)]
pub enum {{ v.vo }} {
{% for variant in v.variants %}    {{ variant }},
{% endfor %}}

impl std::str::FromStr for {{ v.vo }} {
    type Err = Error{{ pascal }};

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
{% for variant in v.variants %}            "{{ variant }}" => Ok(Self::{{ variant }}),
{% endfor %}            _ => Err(Error{{ pascal }}::{{ v.vo }}Invalido),
        }
    }
}

impl {{ v.vo }} {
    pub fn as_str(&self) -> &'static str {
        match self {
{% for variant in v.variants %}            Self::{{ variant }} => "{{ variant }}",
{% endfor %}        }
    }
}{% else %}{{ macros::value_object(vo=v.vo, inner=v.inner, error="Error" ~ pascal, invalid="Error" ~ pascal ~ "::" ~ v.vo ~ "Invalido", class=v.class) }}{% endif %}{% endfor %}{{ macros::rule_tests(vos=vos) }}
