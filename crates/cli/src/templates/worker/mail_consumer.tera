//! `mail_{{ name }}`: sends the `{{ name }}` mail on {% for e in events %}`{{ e.event_type }}`{% if not loop.last %}, {% endif %}{% endfor %}. Written once by
//! `puerto generar correo --tras`; it is yours now — change who it goes to, skip some events, add
//! values the snapshot does not carry.
//!
//! Delivery is at-least-once: `enviar_una_vez` keeps a `correos_enviados` row per event, so a redelivered
//! event does not send the mail again. Keep `MAIL` as it is: renaming it sends every mail again.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::{{ name }}::{ {{- pascal }}Mail, {{ pascal }}Mailer};
{%- for import in imports %}
use {{ import }};
{%- endfor %}
use puerto_nucleo::eventos::{SobreEvento, ManejadorEvento, ResultadoManejo, MOTIVO_PAYLOAD_INVALIDO};
use puerto_nucleo::correo::CorreosEnviados;
use puerto_correo::enviar_una_vez;

/// The key of this mail in `correos_enviados`.
const MAIL: &str = "{{ name }}";

pub struct Send{{ pascal }}Mail {
    pub mailer: Arc<dyn {{ pascal }}Mailer>,
    pub sent_mails: Arc<dyn CorreosEnviados>,
}

#[async_trait]
impl ManejadorEvento for Send{{ pascal }}Mail {
    async fn manejar(&self, event: &SobreEvento) -> ResultadoManejo {
        let mail = match event.tipo_evento.as_str() {
{%- for e in events %}
            {{ e.constant }} => match event.decodificar::<{{ e.entity_pascal }}Snapshot>() {
                Ok({{ e.entity_snake }}) => {{ pascal }}Mail {
                    to: {{ e.entity_snake }}.{{ to }}.clone(),
{%- for f in fields %}
                    {{ f.name }}: {{ e.entity_snake }}.{{ f.name }},
{%- endfor %}
                },
                Err(err) => return ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle),
            },
{%- endfor %}
            // Not one of its events (puerto.toml `[[correo]] tras`): nothing to send.
            _ => return ResultadoManejo::Ack,
        };
        if mail.to.trim().is_empty() {
            tracing::warn!(event_id = %event.id, "mail_{{ name }}: no recipient, not sent");
            return ResultadoManejo::Ack;
        }
        enviar_una_vez(self.sent_mails.as_ref(), event.id, MAIL, self.mailer.send(&mail)).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_correo::{{ name }}::mocks::Mock{{ pascal }}Mailer;
    use dominio_{{ first.entity_snake }}::eventos::{{ first.entity_pascal }}Event;
    use dominio_{{ first.entity_snake }}::pruebas::madres::{{ first.entity_pascal }}Mother;
    use puerto_nucleo::eventos::MOTIVO_ERROR_PERMANENTE;
    use puerto_nucleo::correo::ErrorCorreo;
    use puerto_correo::pruebas::CorreosEnviadosEnMemoria;

    fn {{ first.const_lower }}() -> ({{ first.entity_pascal }}Snapshot, SobreEvento) {
        let snapshot = {{ first.entity_pascal }}Snapshot::from_entity(&{{ first.entity_pascal }}Mother::random());
        let event = SobreEvento::new(&{{ first.entity_pascal }}Event::{{ first.variant }}(snapshot.clone()));
        (snapshot, event)
    }

    /// A mailer expected to send `times` mails, each answering `result`.
    fn mailer(times: usize, result: Result<(), ErrorCorreo>) -> Mock{{ pascal }}Mailer {
        let mut mailer = Mock{{ pascal }}Mailer::new();
        mailer
            .expect_send()
            .times(times)
            .returning(move |_| result.clone());
        mailer
    }

    fn handler(mailer: Mock{{ pascal }}Mailer) -> Send{{ pascal }}Mail {
        Send{{ pascal }}Mail {
            mailer: Arc::new(mailer),
            sent_mails: Arc::new(CorreosEnviadosEnMemoria::new()),
        }
    }

    #[tokio::test]
    async fn should_send_the_mail_to_the_{{ to }}_when_a_{{ first.event_type }}_event_arrives() {
        // Arrange
        let (snapshot, event) = {{ first.const_lower }}();
        let mut mock = Mock{{ pascal }}Mailer::new();
        mock.expect_send()
            .withf(move |mail| mail.to == snapshot.{{ to }})
            .times(1)
            .returning(|_| Ok(()));

        // Act
        let outcome = handler(mock).manejar(&event).await;

        // Assert
        assert_eq!(outcome, ResultadoManejo::Ack);
    }

    #[tokio::test]
    async fn should_send_it_once_when_the_same_event_is_delivered_twice() {
        // Arrange
        let (_, event) = {{ first.const_lower }}();
        let handler = handler(mailer(1, Ok(())));

        // Act
        let first = handler.manejar(&event).await;
        let second = handler.manejar(&event).await;

        // Assert
        assert_eq!((first, second), (ResultadoManejo::Ack, ResultadoManejo::Ack));
    }

    #[tokio::test]
    async fn should_dead_letter_without_sending_when_the_payload_is_malformed() {
        // Arrange
        let (_, mut event) = {{ first.const_lower }}();
        event.payload = serde_json::json!({ "unexpected": true });

        // Act
        let outcome = handler(mailer(0, Ok(()))).manejar(&event).await;

        // Assert
        assert!(
            matches!(
                outcome,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_PAYLOAD_INVALIDO,
                    ..
                }
            ),
            "{outcome:?}"
        );
    }

    #[tokio::test]
    async fn should_retry_when_the_mail_server_is_unavailable() {
        // Arrange
        let (_, event) = {{ first.const_lower }}();
        let refused = Err(ErrorCorreo::Transitorio("connection refused".to_string()));

        // Act
        let outcome = handler(mailer(1, refused)).manejar(&event).await;

        // Assert
        assert_eq!(outcome, ResultadoManejo::Reintentar);
    }

    #[tokio::test]
    async fn should_dead_letter_when_the_mail_is_rejected() {
        // Arrange
        let (_, event) = {{ first.const_lower }}();
        let rejected = Err(ErrorCorreo::Permanente("550 no such user".to_string()));

        // Act
        let outcome = handler(mailer(1, rejected)).manejar(&event).await;

        // Assert
        assert!(
            matches!(
                outcome,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_ERROR_PERMANENTE,
                    ..
                }
            ),
            "{outcome:?}"
        );
    }
}
