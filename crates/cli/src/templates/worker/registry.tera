// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`; add a
// consumer with `puerto generate consumer <name> --on <event_type>`.
{%- if consumers %}
use std::sync::Arc;
{% endif %}
{% for import in imports -%}
use {{ import }};
{% endfor -%}
{% if consumers %}
{% for m in modules -%}
use crate::consumers::{{ m.0 }}::{{ m.1 }};
{% endfor -%}
{% endif %}
/// The relay and one consumer per `[[consumer]]`, on the `db` transport: the relay hands each
/// event to `event_deliveries`, one row per consumer subscribed to its type.
pub async fn build_worker(config: WorkerConfig) -> Loops {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let pool = infrastructure::db::create_postgres_pool(&database_url)
        .await
        .expect("Failed to connect to database");
    infrastructure::db::run_migrations(&pool, &infrastructure::db::MIGRATOR)
        .await
        .expect("Failed to run migrations");
{% if consumers %}
    let deliveries = PgDeliveries::new(pool.clone())
{%- for c in consumers %}
        .route("{{ c.name }}", &[{{ c.events | join(sep=", ") }}])
{%- endfor %};
    let dead_letters = Arc::new(PgDeadLetters::new(pool.clone()));

    Loops::new(&config)
        .relay(PgOutbox::new(pool.clone()), deliveries)
{%- for c in consumers %}
        .consumer(
            PgSubscription::new(pool.clone(), "{{ c.name }}"),
            {{ c.pascal }},
            {% if loop.last %}dead_letters{% else %}dead_letters.clone(){% endif %},
        )
{%- endfor %}
{%- else %}
    Loops::new(&config).relay(PgOutbox::new(pool.clone()), PgDeliveries::new(pool))
{%- endif %}
}
