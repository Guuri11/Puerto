// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`; añade un
// consumidor con `puerto generar consumidor <nombre> --tras <tipo_evento>`.
{%- if consumers %}
use std::sync::Arc;
{% endif %}
{% for import in imports -%}
use {{ import }};
{% endfor -%}
{% if consumers %}
{% for m in modules -%}
use crate::consumidores::{{ m.0 }}::{{ m.1 }};
{% endfor -%}
{% endif %}
/// El relay y un consumidor por cada `[[consumidor]]`, sobre el transporte `kafka`: el relay
/// publica cada evento en el topic de su agregado, `<KAFKA_TOPIC_PREFIX>.<agregado>`, y cada
/// consumidor es un grupo de consumidores sobre los topics de sus eventos. Los descartados se
/// quedan en Postgres.
pub async fn construir_worker(config: ConfigWorker) -> Result<Bucles, String> {
    let database_url = std::env::var("DATABASE_URL")
        .map_err(|_| "DATABASE_URL no está definida — defínela en .env (.env.example trae una)".to_string())?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — ¿está arrancada la base de datos? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;
    let kafka = ConfigKafka::from_env("{{ project }}").map_err(|e| e.to_string())?;
{%- if aggregates %}
    kafka
        .asegurar_topics(&[{% for a in aggregates %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}])
        .await
        .map_err(|e| format!("no se pueden crear los topics de Kafka: {e} — ¿está arrancado el broker? `make docker-compose/up`"))?;
{%- endif %}
    let publicador = PublicadorKafka::new(&kafka).map_err(|e| format!("no se puede crear el productor de Kafka: {e}"))?;
{%- if mails %}
    // Los correos que se envían tras eventos (ADR-0020): un cliente SMTP y un registro de enviados
    // para todos.
    let enviador = Arc::new(
        EnviadorCorreoSmtp::new(&ConfigCorreo::from_env().map_err(|e| e.to_string())?)
            .map_err(|e| e.to_string())?,
    );
    let correos_enviados = Arc::new(CorreosEnviadosPostgres::new(pool.clone()));
{%- endif %}
{% if consumers %}    let descartados = Arc::new(DescartadosPostgres::new(pool.clone()));

    Ok(Bucles::new(&config)
        .relay(OutboxPostgres::new(pool.clone()), publicador)
{%- for c in consumers %}
        .consumidor(
            SuscripcionKafka::new(
                &kafka,
                "{{ c.name }}",
                &[{% for a in c.aggregates %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}],
                &[{{ c.events | join(sep=", ") }}],
                descartados.clone(),
            )
            .map_err(|e| format!("no se puede suscribir {{ c.name }} a Kafka: {e}"))?,
            {{ c.handler }},
            {% if loop.last %}descartados{% else %}descartados.clone(){% endif %},
        )
{%- endfor %})
{%- else %}
    Ok(Bucles::new(&config).relay(OutboxPostgres::new(pool), publicador))
{%- endif %}
}
