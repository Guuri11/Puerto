mod consumers;
mod generated;

/// The second process of this project (ADR-0018 of Puerto): it relays the outbox the API writes
/// and runs the consumers. The loops, health probes and graceful shutdown come from the Puerto
/// runtime, `puerto-eventos`; the wiring is in `generated/registry.rs`, the consumers in
/// `consumers/`.
#[tokio::main]
async fn main() -> Result<(), puerto_eventos::Error> {
    let config = puerto_eventos::ConfigWorker::from_env()?;
    puerto_eventos::Worker::new(config)
        .intentar_ejecutar(generated::registry::build_worker)
        .await
}
