[package]
name = "worker"
version = "0.1.0"
edition = "2024"

[dependencies]
puerto-nucleo = { workspace = true }
# The relay, the consume loops, health probes and graceful shutdown (`main.rs`, `generado/registro.rs`).
puerto-eventos = { workspace = true }
# The pool, the migrations at startup and the outbox, delivery and dead-letter tables.
puerto-sqlx = { workspace = true }
migrador = { workspace = true }
{%- if kafka %}
# The Kafka transport: the publisher and the subscriptions `generado/registro.rs` wires.
puerto-kafka = { workspace = true }
{%- endif %}
async-trait = { workspace = true }
tokio = { workspace = true }
tracing = { workspace = true }

[dev-dependencies]
serde_json = { workspace = true }
