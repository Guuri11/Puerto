//! `{{ name }}`: reacts to {% for e in events %}`{{ e.event_type }}`{% if not loop.last %}, {% endif %}{% endfor %}. Written once by
//! `puerto generar consumidor`; it is yours now.
//!
//! Delivery is at-least-once: the same event (the same `event.id`) can arrive twice — after a
//! crash, a timeout or a redeploy. Whatever this does must be **idempotent**: check whether it
//! already happened (keyed on `event.id`) before doing it again.
//!
//! `Ack` when done; `Retry` for a failure that may pass (the worker redelivers with a growing
//! backoff, then dead-letters); `ResultadoManejo::descartar(…)` for one that never will.

use async_trait::async_trait;
{% for import in imports -%}
use {{ import }};
{% endfor -%}
use puerto_nucleo::eventos::{SobreEvento, ManejadorEvento, ResultadoManejo, MOTIVO_PAYLOAD_INVALIDO};

pub struct {{ pascal }};

#[async_trait]
impl ManejadorEvento for {{ pascal }} {
    async fn manejar(&self, event: &SobreEvento) -> ResultadoManejo {
        match event.tipo_evento.as_str() {
{%- for e in events %}
            {{ e.constant }} => match event.decodificar::<{{ e.entity_pascal }}Snapshot>() {
                Ok({{ e.entity_snake }}) => {
                    tracing::info!(
                        event_id = %event.id,
                        {{ e.entity_snake }}_id = %{{ e.entity_snake }}.id,
                        "{{ name }}: {{ e.event_type }}"
                    );
                    ResultadoManejo::Ack
                }
                Err(err) => ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle),
            },
{%- endfor %}
            // Not subscribed (puerto.toml `[[consumidor]] eventos`): nothing to do.
            _ => ResultadoManejo::Ack,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_{{ first.entity_snake }}::eventos::{{ first.entity_pascal }}Event;
    use dominio_{{ first.entity_snake }}::pruebas::madres::{{ first.entity_pascal }}Mother;

    fn {{ first.const_lower }}() -> SobreEvento {
        let snapshot = {{ first.entity_pascal }}Snapshot::from_entity(&{{ first.entity_pascal }}Mother::random());
        SobreEvento::new(&{{ first.entity_pascal }}Event::{{ first.variant }}(snapshot))
    }

    #[tokio::test]
    async fn should_ack_when_a_{{ first.event_type }}_event_is_valid() {
        // Arrange
        let event = {{ first.const_lower }}();

        // Act
        let outcome = {{ pascal }}.manejar(&event).await;

        // Assert
        assert_eq!(outcome, ResultadoManejo::Ack);
    }

    #[tokio::test]
    async fn should_ack_again_when_the_same_event_is_delivered_twice() {
        // Arrange
        let event = {{ first.const_lower }}();

        // Act
        let first = {{ pascal }}.manejar(&event).await;
        let second = {{ pascal }}.manejar(&event).await;

        // Assert
        assert_eq!((first, second), (ResultadoManejo::Ack, ResultadoManejo::Ack));
    }

    #[tokio::test]
    async fn should_dead_letter_when_the_payload_is_malformed() {
        // Arrange
        let mut event = {{ first.const_lower }}();
        event.payload = serde_json::json!({ "unexpected": true });

        // Act
        let outcome = {{ pascal }}.manejar(&event).await;

        // Assert
        assert!(
            matches!(
                outcome,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_PAYLOAD_INVALIDO,
                    ..
                }
            ),
            "{outcome:?}"
        );
    }
}
