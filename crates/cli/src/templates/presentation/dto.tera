use dominio_{{ snake }}::modelo::{{ pascal }};
use poem_openapi::Object;
{% if is_crud %}use puerto_nucleo::Pagina;
{% endif %}use uuid::Uuid;{% for import in imports %}
use {{ import }};{% endfor %}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
{% set private_fields = fields | filter(attribute="private", value=true) %}pub struct Dto{{ pascal }} {
    pub id: Uuid,
{% for f in fields %}{% if f.private %}    /// Privado: una ruta pública no lo da a quien llama sin sesión.
    #[oai(skip_serializing_if_is_none)]
    pub {{ f.name }}: {% if f.field_type is starting_with("Option<") %}{{ f.field_type }}{% else %}Option<{{ f.field_type }}>{% endif %},
{% else %}    pub {{ f.name }}: {{ f.field_type }},
{% endif %}{% endfor %}}

impl Dto{{ pascal }} {
    pub fn from_dominio(entidad: &{{ pascal }}) -> Self {
        Self {
            id: entidad.id.valor(),
{% for f in fields %}            {{ f.name }}: {% if f.private and not f.field_type is starting_with("Option<") %}Some({{ f.accessor }}){% else %}{{ f.accessor }}{% endif %},
{% endfor %}        }
    }
{% if private_fields %}
    /// Sin los campos privados: lo que una ruta pública da a quien llama sin sesión.
    pub fn from_dominio_publico(entidad: &{{ pascal }}) -> Self {
        Self {
{% for f in private_fields %}            {{ f.name }}: None,
{% endfor %}            ..Self::from_dominio(entidad)
        }
    }
{% endif %}}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrear{{ pascal }} {
{% for f in create_fields %}    pub {{ f.name }}: {{ f.field_type }},
{% endfor %}}
{% if is_crud %}

/// Una página de {{ plural_pascal }}: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPagina{{ pascal }} {
    pub elementos: Vec<Dto{{ pascal }}>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPagina{{ pascal }} {
    pub fn from_dominio(pagina: &Pagina<{{ pascal }}>) -> Self {
        Self {
            elementos: pagina.elementos.iter().map(Dto{{ pascal }}::from_dominio).collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
{% if private_fields %}
    /// La página sin los campos privados de sus elementos.
    pub fn from_dominio_publico(pagina: &Pagina<{{ pascal }}>) -> Self {
        Self {
            elementos: pagina.elementos.iter().map(Dto{{ pascal }}::from_dominio_publico).collect(),
            ..Self::from_dominio(pagina)
        }
    }
{% endif %}}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizar{{ pascal }} {
{% for f in update_fields %}    pub {{ f.name }}: {{ f.field_type }},
{% endfor %}}
{% endif %}
