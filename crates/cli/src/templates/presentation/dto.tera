    pub id: Uuid,
{% for f in fields %}    pub {{ f.name }}: {{ f.field_type }},
{% endfor %}}

impl Dto{{ pascal }} {
    pub fn from_dominio(entidad: &{{ pascal }}) -> Self {
        Self {
            id: entidad.id.valor(),
{% for f in fields %}            {{ f.name }}: {{ f.accessor }},
{% endfor %}        }
    }
}

