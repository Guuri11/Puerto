/// One page of {{ plural_pascal }}: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct {{ pascal }}PageDto {
    pub items: Vec<{{ pascal }}Dto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl {{ pascal }}PageDto {
    pub fn from_domain(page: &Page<{{ pascal }}>) -> Self {
        Self {
            items: page.items.iter().map({{ pascal }}Dto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

