/// Una página de {{ plural_pascal }}: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPagina{{ pascal }} {
    pub elementos: Vec<Dto{{ pascal }}>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPagina{{ pascal }} {
    pub fn from_dominio(pagina: &Pagina<{{ pascal }}>) -> Self {
        Self {
            elementos: pagina.elementos.iter().map(Dto{{ pascal }}::from_dominio).collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

