{% import "presentation/macros.tera" as macros %}use dominio_{{ snake }}::errores::Error{{ pascal }};
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de {{ snake }} como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: Error{{ pascal }}) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        Error{{ pascal }}::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        Error{{ pascal }}::NoEncontrado => StatusCode::NOT_FOUND,
        Error{{ pascal }}::Duplicado => StatusCode::CONFLICT,
        Error{{ pascal }}::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        Error{{ pascal }}::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,{% if auth %}
        Error{{ pascal }}::Prohibido => StatusCode::FORBIDDEN,{% endif %}{% for v in vos %}
        Error{{ pascal }}::{{ v.vo }}Invalido => StatusCode::UNPROCESSABLE_ENTITY,{% endfor %}
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;
{# One test per arm, so a status cannot drift unnoticed. -#}
{{ macros::error_case(name="deberia_mapear_validacion_a_422_con_su_codigo", error="Error" ~ pascal ~ '::Validacion("nombre_vacio".into())', status="UNPROCESSABLE_ENTITY", code=snake ~ ".validacion.nombre_vacio") }}
{{- macros::error_case(name="deberia_mapear_no_encontrado_a_404_con_su_codigo", error="Error" ~ pascal ~ "::NoEncontrado", status="NOT_FOUND", code=snake ~ ".no_encontrado") }}
{{- macros::error_case(name="deberia_mapear_duplicado_a_409_con_su_codigo", error="Error" ~ pascal ~ "::Duplicado", status="CONFLICT", code=snake ~ ".duplicado") }}
{{- macros::error_case(name="deberia_mapear_repositorio_a_500_con_su_codigo", error="Error" ~ pascal ~ "::Repositorio", status="INTERNAL_SERVER_ERROR", code=snake ~ ".repositorio") }}
{{- macros::error_case(name="deberia_mapear_desconocido_a_500_con_su_codigo", error="Error" ~ pascal ~ "::Desconocido", status="INTERNAL_SERVER_ERROR", code=snake ~ ".desconocido") }}
{%- if auth %}{{ macros::error_case(name="deberia_mapear_prohibido_a_403_con_su_codigo", error="Error" ~ pascal ~ "::Prohibido", status="FORBIDDEN", code=snake ~ ".prohibido") }}{% endif %}
{%- for v in vos %}{{ macros::error_case(name="deberia_mapear_" ~ v.vo_snake ~ "_invalido_a_422_con_su_codigo", error="Error" ~ pascal ~ "::" ~ v.vo ~ "Invalido", status="UNPROCESSABLE_ENTITY", code=snake ~ "." ~ v.vo_snake ~ "_invalido") }}{% endfor %}}
