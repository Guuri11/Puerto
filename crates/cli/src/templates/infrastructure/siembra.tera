//! Las filas que necesitan los tests de Postgres —una entidad {{ snake }} válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_{{ snake }}::modelo::{{ pascal }};
{% if seeded %}use dominio_{{ snake }}::modelo::Props{{ pascal }};
{% endif %}{% if seeded | length < fields | length or seeds_from_mother %}use dominio_{{ snake }}::pruebas::madres::Madre{{ pascal }};
{% endif %}{% if events %}use dominio_{{ snake }}::unit_of_work::UnitOfWorkFactory{{ pascal }};
{% else %}use dominio_{{ snake }}::repositorio::Repositorio{{ pascal }};
{% endif %}use sqlx::PgPool;
{% for import in test_imports %}use {{ import }};
{% endfor %}
{% if events %}use crate::unit_of_work::UnitOfWorkFactory{{ pascal }}Postgres;
{% else %}use crate::repositorio::Repositorio{{ pascal }}Postgres;
{% endif %}
/// Una entidad {{ snake }} válida, sin guardar, con los valores de la madre{% if seeded %} salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada){% endif %}.
pub {% if seeds_references %}async fn construir(pool: &PgPool){% else %}fn construir(){% endif %} -> {{ pascal }} {
    {% if seeded %}{{ pascal }}::new(Props{{ pascal }} {
{% for f in fields %}{% if f.name in seeded %}        {{ f.name }}: {{ f.seed_literal }},
{% endif %}{% endfor %}{% if seeded | length < fields | length %}        ..Madre{{ pascal }}::new().construir_props()
{% endif %}    })
    .unwrap(){% else %}Madre{{ pascal }}::aleatorio(){% endif %}
}
{% if events %}
/// Guarda la entidad a través de la unidad de trabajo: el repositorio solo lee.
pub async fn guardar(pool: &PgPool, entidad: &{{ pascal }}) {
    let mut uow = UnitOfWorkFactory{{ pascal }}Postgres::new(pool.clone()).begin().await.unwrap();
    uow.guardar(entidad).await.unwrap();
    uow.commit().await.unwrap();
}
{% endif %}
/// Una entidad {{ snake }} guardada.
pub async fn sembrar(pool: &PgPool) -> {{ pascal }} {
    let entidad = construir({% if seeds_references %}pool).await{% else %}){% endif %};
    {% if events %}guardar(pool, &entidad).await;{% else %}Repositorio{{ pascal }}Postgres::new(pool.clone())
        .guardar(&entidad)
        .await
        .unwrap();{% endif %}
    entidad
}
