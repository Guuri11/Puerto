{% if events %}use dominio_{{ snake }}::unit_of_work::{{ pascal }}UnitOfWorkFactory;
{% else %}use dominio_{{ snake }}::repositorio::{{ pascal }}RepositoryTrait;
{% endif %}use sqlx::PgPool;
{% for import in test_imports %}use {{ import }};
{% endfor %}
{% if events %}use crate::unit_of_work::Pg{{ pascal }}UnitOfWorkFactory;
{% else %}use crate::repositorio::Pg{{ pascal }}Repository;
