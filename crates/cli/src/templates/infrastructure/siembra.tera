{% if events %}
/// Writes a {{ snake }} through the unit of work: the repository only reads.
pub async fn store(pool: &PgPool, entity: &{{ pascal }}) {
    let mut uow = Pg{{ pascal }}UnitOfWorkFactory::new(pool.clone()).begin().await.unwrap();
    uow.save(entity).await.unwrap();
    uow.commit().await.unwrap();
}
{% endif %}
/// A stored {{ snake }}.
pub async fn seed(pool: &PgPool) -> {{ pascal }} {
    let entity = build({% if seeds_references %}pool).await{% else %}){% endif %};
    {% if events %}store(pool, &entity).await;{% else %}Pg{{ pascal }}Repository::new(pool.clone())
        .save(&entity)
        .await
        .unwrap();{% endif %}
    entity
}
