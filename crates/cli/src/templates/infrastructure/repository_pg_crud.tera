        let primero = sembrar(&pool).await;
        let mut segundo = construir({% if seeds_references %}&pool).await{% else %}){% endif %};
{% for f in g.fields %}        segundo.{{ f.name }} = primero.{{ f.name }}{% if f.needs_clone %}.clone(){% endif %};
{% endfor %}
        // Actuar
