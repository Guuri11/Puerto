use crate::fila::{{ pascal }}Db;

pub struct Pg{{ pascal }}Repository {
    pub pool: PgPool,
}

impl Pg{{ pascal }}Repository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}
{% if references and not events %}{% include "infrastructure/references.tera" %}{% endif %}
/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: {{ pascal }}Db) -> Result<{{ pascal }}, ErrorRepositorio> {
    {{ pascal }}::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid {{ snake }}");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl {{ pascal }}RepositoryTrait for Pg{{ pascal }}Repository {
    async fn find_all(&self, page: PeticionPagina{% if refs %}, filter: {{ pascal }}Filter{% endif %}) -> Result<Pagina<{{ pascal }}>, ErrorRepositorio> {
        tracing::debug!(limit = page.limite(), offset = page.desplazamiento(), "find_all");
{% if refs %}        // One static query whatever the filter: an unset id is NULL and matches every row.
{% for r in refs %}        let {{ r.name }} = filter.{{ r.name }}.map(|id| id.value());
{% endfor %}{% endif %}        let rows = sqlx::query_as!(
            {{ pascal }}Db,
            "SELECT {{ select_cols }}
             FROM {{ plural }} WHERE {{ page_where }}
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limite()),
            i64::from(page.desplazamiento()){% for r in refs %},
            {{ r.name }}{% endfor %}
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM {{ plural }} WHERE {{ count_where }}"#{% for r in refs %},
            {{ r.name }}{% endfor %}
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            mapear_error_sqlx(&e)
        })?;

        let items = rows.into_iter().map(to_domain).collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(items, total, page))
    }

    async fn find_by_id(&self, id: {{ pascal }}Id) -> Result<Option<{{ pascal }}>, ErrorRepositorio> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            {{ pascal }}Db,
            "SELECT {{ select_cols }}
             FROM {{ plural }} WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            mapear_error_sqlx(&e)
        })?;

        row.map(to_domain).transpose()
    }
{% if not events %}
    async fn save(&self, entity: &{{ pascal }}) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entity.id, "save");
        let db = {{ pascal }}Db::from(entity);
        sqlx::query!(
            "INSERT INTO {{ plural }} ({{ all_cols }})
             VALUES ({{ all_params }})
             ON CONFLICT (id) DO UPDATE
             SET {{ all_updates }}",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
{% for f in fields %}            {% if f.is_array %}&db.{{ f.name }}{% elif f.is_map %}db.{{ f.name }} as _{% else %}db.{{ f.name }}{% endif %},
{% endfor %}        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            {% if references %}mapear_error_sqlx_con(&e, REFERENCES){% else %}mapear_error_sqlx(&e){% endif %}
        })?;
        Ok(())
    }
{% endif %}}

#[cfg(test)]
mod integration_tests {
    use super::*;
{% set uniques = fields | filter(attribute="unique", value=true) %}    use crate::pruebas::siembra::{{ "{" }}{% if refs or (uniques and not events) %}build, {% endif %}seed{% if events %}, store{% endif %}};
{% if not events %}{% if update_vo_import %}    use {{ update_vo_import }};
{% endif %}{% for import in reference_imports %}    use {{ import }};
{% endfor %}{% endif %}
    fn test_repo(pool: PgPool) -> Pg{{ pascal }}Repository {
        Pg{{ pascal }}Repository::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool).find_by_id(entity.id).await.unwrap().unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
{% for f in fields %}        assert_eq!(found.{{ f.name }}, entity.{{ f.name }});
{% endfor %}        assert!(!found.deleted);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool).find_by_id({{ pascal }}Id::generate()).await.unwrap();

        // Assert
        assert!(result.is_none());
    }

{% if not events %}    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_update_entity_on_save_conflict(pool: PgPool) {
        // Arrange
{% set required = fields | filter(attribute="required_string", value=true) %}{% set string_vos = fields | filter(attribute="string_vo", value=true) %}{% if required or string_vos %}{% if required %}{% set f = required.0 %}{% else %}{% set f = string_vos.0 %}{% endif %}        let mut entity = seed(&pool).await;
        entity.{{ f.name }} = {% if f.is_vo %}{{ f.vo }}::new("updated".to_string()).unwrap(){% else %}"updated".to_string(){% endif %};
        entity.updated_at = chrono::Utc::now();

        // Act
        test_repo(pool.clone()).save(&entity).await.unwrap();

        // Assert
        let found = test_repo(pool).find_by_id(entity.id).await.unwrap().unwrap();
        assert_eq!(found.{{ f.name }}{% if f.is_vo %}.value(){% endif %}, "updated");
{% else %}        let entity = seed(&pool).await;

        // Act
        test_repo(pool.clone()).save(&entity).await.unwrap();

        // Assert
        let found = test_repo(pool).find_by_id(entity.id).await.unwrap();
        assert!(found.is_some());
{% endif %}    }

{% endif %}    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_list_all_{{ plural }}_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        {% if events %}store(&pool, &deleted).await;{% else %}test_repo(pool.clone()).save(&deleted).await.unwrap();{% endif %}

        // Act
        let page = test_repo(pool).find_all(PeticionPagina::default(){% if refs %}, {{ pascal }}Filter::default(){% endif %}).await.unwrap();

        // Assert
        assert_eq!(page.elementos.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(PeticionPagina::new(Some(2), Some(2)){% if refs %}, {{ pascal }}Filter::default(){% endif %})
            .await
            .unwrap();

        // Assert
        assert_eq!(page.elementos.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limite, page.desplazamiento), (2, 2));
    }
{% set uniques = fields | filter(attribute="unique", value=true) %}{% if uniques and not events %}{% set u = uniques.0 %}

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_reject_a_duplicate_{{ u.name }}(pool: PgPool) {
        // Arrange
        let first = seed(&pool).await;
        let mut second = build({% if seeds_references %}&pool).await{% else %}){% endif %};
        second.{{ u.name }} = first.{{ u.name }}{% if u.needs_clone %}.clone(){% endif %};

        // Act
        let result = test_repo(pool).save(&second).await;

        // Assert
        assert_eq!(result.unwrap_err(), ErrorRepositorio::Duplicado);
    }
{% endif %}{% if not events %}{% for r in references %}

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_reject_a_missing_{{ r.field }}(pool: PgPool) {
        // Arrange: a {{ r.field }} no row has.
        let mut entity = build({% if seeds_references %}&pool).await{% else %}){% endif %};
        entity.{{ r.field }} = {% if r.optional %}Some({{ r.id }}::generate()){% else %}{{ r.id }}::generate(){% endif %};

        // Act
        let result = test_repo(pool).save(&entity).await;

        // Assert
        assert_eq!(result.unwrap_err(), ErrorRepositorio::ReferenciaInexistente("{{ r.field }}"));
    }
{% endfor %}{% endif %}{% for r in refs %}

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_list_only_the_{{ plural }}_of_the_requested_{{ r.name }}(pool: PgPool) {
        // Arrange: one {{ snake }} with this {{ r.name }}, one without.
        let target = infra_{{ r.ref_target_snake }}::pruebas::siembra::seed(&pool).await;
        let mut wanted = build({% if seeds_references %}&pool).await{% else %}){% endif %};
        wanted.{{ r.name }} = {% if r.field_type is starting_with("Option<") %}Some(target.id){% else %}target.id{% endif %};
        {% if events %}store(&pool, &wanted).await;{% else %}test_repo(pool.clone()).save(&wanted).await.unwrap();{% endif %}
        seed(&pool).await;

        // Act
        let page = test_repo(pool)
            .find_all(
                PeticionPagina::default(),
                {{ pascal }}Filter {
{% for o in refs %}                    {{ o.name }}: {% if o.name == r.name %}Some(target.id){% else %}None{% endif %},
{% endfor %}                },
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(page.elementos.iter().map(|row| row.id).collect::<Vec<_>>(), vec![wanted.id]);
        assert_eq!(page.total, 1);
    }
{% endfor %}}
