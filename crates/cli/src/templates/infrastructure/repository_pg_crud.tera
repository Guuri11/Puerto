{% endfor %}{% for r in references %}

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_{{ r.field }}_inexistente(pool: PgPool) {
        // Preparar: un valor de {{ r.field }} que no tiene ninguna fila.
        let mut entidad = construir({% if seeds_references %}&pool).await{% else %}){% endif %};
        entidad.{{ r.field }} = {% if r.optional %}Some({{ r.id }}::generar()){% else %}{{ r.id }}::generar(){% endif %};

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&entidad).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::ReferenciaInexistente("{{ r.field }}"));
    }
{% endfor %}{% endif %}{% for r in refs %}

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_{{ plural }}_con_ese_valor_de_{{ r.name }}(pool: PgPool) {
        // Preparar: una entidad {{ snake }} con este valor de {{ r.name }} y otra sin él.
        let destino = infra_{{ r.ref_target_snake }}::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir({% if seeds_references %}&pool).await{% else %}){% endif %};
        esperado.{{ r.name }} = {% if r.field_type is starting_with("Option<") %}Some(destino.id){% else %}destino.id{% endif %};
        {% if events %}guardar(&pool, &esperado).await;{% else %}repositorio_de_prueba(pool.clone()).guardar(&esperado).await.unwrap();{% endif %}
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                Filtro{{ pascal }} {
{% for o in refs %}                    {{ o.name }}: {% if o.name == r.name %}Some(destino.id){% else %}None{% endif %},
{% endfor %}                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.iter().map(|fila| fila.id).collect::<Vec<_>>(), vec![esperado.id]);
        assert_eq!(pagina.total, 1);
    }
{% endfor %}}
