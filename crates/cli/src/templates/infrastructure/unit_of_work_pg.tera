    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_{{ r.field }}_inexistente(pool: PgPool) {
        // Preparar: un valor de {{ r.field }} que no tiene ninguna fila.
        let mut entidad = construir({% if seeds_references %}&pool).await{% else %}){% endif %};
        entidad.{{ r.field }} = {% if r.optional %}Some({{ r.id }}::generar()){% else %}{{ r.id }}::generar(){% endif %};

        // Actuar
        let resultado = crear(&pool, &entidad).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::ReferenciaInexistente("{{ r.field }}"));
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }
