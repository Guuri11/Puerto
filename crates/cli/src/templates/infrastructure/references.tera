
/// Las claves foráneas por las que pasa una escritura (ADR-0022 de Puerto): la base de datos
/// rechaza una referencia a una fila que no existe, y quien llama recibe como error el campo que la
/// nombra.
const REFERENCES: &[ClaveForanea] = &[
{% for r in references %}    ClaveForanea {
        restriccion: "{{ r.constraint }}",
        campo: "{{ r.field }}",
    },
{% endfor %}];
