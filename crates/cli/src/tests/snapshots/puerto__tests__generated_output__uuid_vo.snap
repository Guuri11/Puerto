use dominio_reserva::valores::TenantId;
use std::sync::Arc;
use uuid::Uuid;

#[derive(Debug, Clone)]
pub struct ParamsCrearReserva {
    pub reference: String,
    pub tenant_id: Uuid,
}

#[async_trait]
pub trait CrearReserva: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearReserva) -> Result<Reserva, ErrorReserva>;
}

#[cfg(any(test, feature = "pruebas"))]
