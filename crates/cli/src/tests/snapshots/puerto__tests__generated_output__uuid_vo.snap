#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoReserva {
    pub id: Uuid,
    pub reference: String,
    pub tenant_id: Uuid,
}

impl DtoReserva {
    pub fn from_dominio(entidad: &Reserva) -> Self {
        Self {
            id: entidad.id.valor(),
            reference: entidad.reference.clone(),
            tenant_id: entidad.tenant_id.valor(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearReserva {
    pub reference: String,
    pub tenant_id: Uuid,
}

/// Una página de Reservas: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaReserva {
    pub elementos: Vec<DtoReserva>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaReserva {
    pub fn from_dominio(pagina: &Pagina<Reserva>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoReserva::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

