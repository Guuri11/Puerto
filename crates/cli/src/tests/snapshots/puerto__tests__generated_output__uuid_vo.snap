use async_trait::async_trait;
use dominio_reserva::errores::ErrorReserva;
use dominio_reserva::modelo::{PropsReserva, Reserva};
use dominio_reserva::repositorio::RepositorioReserva;
use dominio_reserva::valores::TenantId;
use std::sync::Arc;
use uuid::Uuid;

#[derive(Debug, Clone)]
pub struct ParamsCrearReserva {
    pub reference: String,
    pub tenant_id: Uuid,
}

#[async_trait]
pub trait CrearReserva: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearReserva) -> Result<Reserva, ErrorReserva>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearReserva {}

        #[async_trait]
        impl CrearReserva for CrearReserva {
            async fn ejecutar(&self, params: ParamsCrearReserva) -> Result<Reserva, ErrorReserva>;
        }
    }
}

pub struct CrearReservaImpl {
    pub repositorio: Arc<dyn RepositorioReserva>,
}

#[async_trait]
impl CrearReserva for CrearReservaImpl {
    async fn ejecutar(&self, params: ParamsCrearReserva) -> Result<Reserva, ErrorReserva> {
        tracing::info!("crear_reserva: inicio");
        let tenant_id = TenantId::new(params.tenant_id)?;
        let entidad = Reserva::new(PropsReserva {
            reference: params.reference,
            tenant_id,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_reserva: rechazado"))?;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "crear_reserva: fallo del repositorio"))?;
        tracing::info!(id = %entidad.id, "crear_reserva: fin");
        Ok(entidad)
    }
}

