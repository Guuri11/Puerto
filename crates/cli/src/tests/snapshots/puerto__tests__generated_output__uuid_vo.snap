use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::booking::{
    errors::BookingError,
    model::Booking,
    repository::BookingRepositoryTrait,
    use_cases::get_booking::{GetBookingParams, GetBookingUseCaseTrait},
};

pub struct GetBookingUseCaseImpl {
    pub repository: Arc<dyn BookingRepositoryTrait>,
}

#[async_trait]
impl GetBookingUseCaseTrait for GetBookingUseCaseImpl {
    async fn execute(&self, params: GetBookingParams) -> Result<Booking, BookingError> {
        tracing::info!(id = %params.id, "get_booking: start");
        let result = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "get_booking: repository failed"))?;
        result.ok_or_else(|| {
            let err = BookingError::NotFound;
            tracing::warn!(error = %err, "get_booking: rejected");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::booking::value_objects::TenantId;
    use crate::domain::booking::{
        model::{Booking, BookingId, BookingProps},
        repository::mocks::MockBookingRepository,
    };
    use puerto_core::RepositoryError;
    use uuid::Uuid;

    #[tokio::test]
    async fn should_return_booking_when_id_exists() {
        let entity = Booking::new(BookingProps {
            reference: "example".to_string(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockBookingRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = GetBookingUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(GetBookingParams { id: entity_id }).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().reference, "example");
    }

    #[tokio::test]
    async fn should_return_not_found_when_id_does_not_exist() {
        let mut mock_repo = MockBookingRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = GetBookingUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetBookingParams {
                id: BookingId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "booking.not_found");
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_store_is_unavailable() {
        let mut mock_repo = MockBookingRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(|_| Err(RepositoryError::Unavailable));
        let use_case = GetBookingUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetBookingParams {
                id: BookingId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "booking.repository_error");
    }
}

=== business/src/application/booking/list_bookings.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::booking::{
    errors::BookingError,
    model::Booking,
    repository::BookingRepositoryTrait,
    use_cases::list_bookings::{ListBookingsParams, ListBookingsUseCaseTrait},
};

pub struct ListBookingsUseCaseImpl {
    pub repository: Arc<dyn BookingRepositoryTrait>,
}

#[async_trait]
impl ListBookingsUseCaseTrait for ListBookingsUseCaseImpl {
    async fn execute(&self, params: ListBookingsParams) -> Result<Page<Booking>, BookingError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_bookings: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_bookings: repository failed"))
            .map_err(BookingError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::booking::value_objects::TenantId;
    use crate::domain::booking::{
        model::{Booking, BookingProps},
        repository::mocks::MockBookingRepository,
    };
    use puerto_core::PageRequest;
    use uuid::Uuid;

    #[tokio::test]
    async fn should_return_the_page_of_bookings() {
        let entities = vec![
            Booking::new(BookingProps {
                reference: "first".to_string(),
                tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
            })
            .unwrap(),
            Booking::new(BookingProps {
                reference: "second".to_string(),
                tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockBookingRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListBookingsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListBookingsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_bookings_exist() {
        let mut mock_repo = MockBookingRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListBookingsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListBookingsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockBookingRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListBookingsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListBookingsParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

=== business/src/application/booking/update_booking.rs ===
use std::sync::Arc;

use crate::domain::booking::value_objects::TenantId;
use async_trait::async_trait;

use crate::domain::booking::{
    errors::BookingError,
    model::Booking,
    repository::BookingRepositoryTrait,
    use_cases::update_booking::{UpdateBookingParams, UpdateBookingUseCaseTrait},
};

pub struct UpdateBookingUseCaseImpl {
    pub repository: Arc<dyn BookingRepositoryTrait>,
}

#[async_trait]
impl UpdateBookingUseCaseTrait for UpdateBookingUseCaseImpl {
    async fn execute(&self, params: UpdateBookingParams) -> Result<Booking, BookingError> {
        tracing::info!(id = %params.id, "update_booking: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_booking: repository failed"))?
            .ok_or_else(|| {
                let err = BookingError::NotFound;
                tracing::warn!(error = %err, "update_booking: rejected");
                err
            })?;
        if params.reference.trim().is_empty() {
            let err = BookingError::ValidationError("reference_empty".into());
            tracing::warn!(error = %err, "update_booking: rejected");
            return Err(err);
        }
        let tenant_id = TenantId::new(params.tenant_id)?;
        entity.reference = params.reference;
        entity.tenant_id = tenant_id;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_booking: repository failed"))?;
        Ok(entity)
    }
}

