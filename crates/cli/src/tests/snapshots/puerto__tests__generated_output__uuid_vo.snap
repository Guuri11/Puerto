};

/// A stand-in that stores nothing — replace it with a real adapter (`puerto new --db` generates
/// Postgres repositories).
#[derive(Default)]
pub struct InMemoryBookingRepository;

impl InMemoryBookingRepository {
    pub fn new() -> Self {
        Self
    }
}

#[async_trait]
impl BookingRepositoryTrait for InMemoryBookingRepository {
    async fn find_all(&self) -> Result<Vec<Booking>, BookingError> {
        tracing::debug!("find_all");
        Ok(vec![])
    }

    async fn find_by_id(&self, id: Uuid) -> Result<Option<Booking>, BookingError> {
        tracing::debug!(%id, "find_by_id");
        Ok(None)
    }

    async fn save(&self, entity: &Booking) -> Result<(), BookingError> {
        tracing::debug!(id = %entity.id, "save");
        Ok(())
    }
}

