=== presentacion/cableado/src/lib.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod reserva {
    use std::sync::Arc;

    use aplicacion_reserva::actualizar_reserva::{ActualizarReserva, ActualizarReservaImpl};
    use aplicacion_reserva::borrar_reserva::{BorrarReserva, BorrarReservaImpl};
    use aplicacion_reserva::crear_reserva::{CrearReserva, CrearReservaImpl};
    use aplicacion_reserva::listar_reservas::{ListarReservas, ListarReservasImpl};
    use aplicacion_reserva::obtener_reserva::{ObtenerReserva, ObtenerReservaImpl};
    use dominio_reserva::repositorio::RepositorioReserva;
    use infra_reserva::repositorio::RepositorioReservaEnMemoria;

    /// Los casos de uso de `reserva`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_reserva: Arc<dyn CrearReserva>,
        pub obtener_reserva: Arc<dyn ObtenerReserva>,
        pub listar_reservas: Arc<dyn ListarReservas>,
        pub actualizar_reserva: Arc<dyn ActualizarReserva>,
        pub borrar_reserva: Arc<dyn BorrarReserva>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioReserva> = Arc::new(RepositorioReservaEnMemoria::new());
        CasosDeUso {
            crear_reserva: Arc::new(CrearReservaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_reserva: Arc::new(ObtenerReservaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_reservas: Arc::new(ListarReservasImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_reserva: Arc::new(ActualizarReservaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_reserva: Arc::new(BorrarReservaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

