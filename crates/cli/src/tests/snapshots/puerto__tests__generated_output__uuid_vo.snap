pub struct CrearReservaImpl {
    pub repositorio: Arc<dyn RepositorioReserva>,
}

#[async_trait]
impl CrearReserva for CrearReservaImpl {
    #[tracing::instrument(name = "crear_reserva", skip_all, err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsCrearReserva) -> Result<Reserva, ErrorReserva> {
        let tenant_id = TenantId::new(params.tenant_id)?;
        let entidad = Reserva::new(PropsReserva {
            reference: params.reference,
            tenant_id,
        })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

