=== web/src/contextos/reserva/vistas/formulario-reserva.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaReserva } from "../mensajes";

type Reserva = Esquemas["DtoReserva"];
type PeticionReserva = Esquemas["PeticionCrearReserva"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioReserva {
  reference: string;
  tenantId: string;
}

/** Los inputs de `reserva`, vacíos cuando todavía no hay ninguno. */
export function aFormularioReserva(reserva: Reserva | null): ValoresFormularioReserva {
  if (reserva === null) {
    return {
      reference: "",
      tenantId: "",
    };
  }
  return {
    reference: reserva.reference,
    tenantId: reserva.tenantId,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionReserva(valores: ValoresFormularioReserva): PeticionReserva {
  return {
    reference: valores.reference,
    tenantId: valores.tenantId,
  };
}

export function VistaFormularioReserva({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioReserva;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaReserva | null;
  alCambiar: (valores: ValoresFormularioReserva) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Reference</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "reference"}
          required
          value={valores.reference}
          onChange={(event) => alCambiar({ ...valores, reference: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="reference" />
      <label className="fieldset">
        <span className="fieldset-legend">Tenant id</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "tenantId"}
          required
          value={valores.tenantId}
          onChange={(event) => alCambiar({ ...valores, tenantId: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="tenantId" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/reserva/vistas/lista-reserva.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";

type Reserva = Esquemas["DtoReserva"];

export function VistaListaReserva({ reservas }: { reservas: Reserva[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Reference</th>
            <th>Tenant id</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {reservas.map((reserva) => (
            <tr key={reserva.id}>
              <td>{reserva.reference}</td>
              <td>{reserva.tenantId}</td>
              <td className="text-right">
                <Link href={`/reservas/${reserva.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/generado/dependencias.ts ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//
// La raíz de composición: el único módulo que construye el cliente de la API. Las pantallas llegan
// a él con `useDependencias()`, así un test les da un falso.

import { type ClienteApi, crearClienteApi } from "../api/cliente";

export interface Dependencias {
  api: ClienteApi;
}

export function crearDependencias(): Dependencias {
  const api = crearClienteApi();
  return { api };
}

=== web/src/generado/rutas.tsx ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.

import { Route, Switch } from "wouter";
import { contarTotal, PAGINA_DE_UNO } from "../api/http";
import type { EntradaMenu } from "../compartido/ui/marco";
import { ContenedorDetalleReserva } from "../contextos/reserva/contenedores/detalle-reserva";
import { ContenedorFormularioReserva } from "../contextos/reserva/contenedores/formulario-reserva";
import { ContenedorListaReserva } from "../contextos/reserva/contenedores/lista-reserva";
import { PaginaNoEncontrada } from "../paginas/no-encontrada";
import { PaginaPanel } from "../paginas/panel";
import { rutasPropias } from "../rutas";

/** Dónde va la app: en la raíz o, con portada, en `[proyecto] ruta_app` (`puerto nuevo --portada`). */
export const rutaApp = "/";

export const entradasMenu: EntradaMenu[] = [
  {
    etiqueta: "Reservas",
    href: "/reservas",
    total: ({ api }) => contarTotal(api.GET("/reservas", PAGINA_DE_UNO)),
  },
];

export function RutasApp() {
  return (
    <Switch>
      <Route path="/">
        <PaginaPanel entradas={entradasMenu} />
      </Route>
      {rutasPropias}
      <Route path="/reservas">
        <ContenedorListaReserva />
      </Route>
      <Route path="/reservas/nuevo">
        <ContenedorFormularioReserva />
      </Route>
      <Route path="/reservas/:id/editar">
        {(params) => <ContenedorFormularioReserva id={params.id} />}
      </Route>
      <Route path="/reservas/:id">{(params) => <ContenedorDetalleReserva id={params.id} />}</Route>
      <Route>
        <PaginaNoEncontrada />
      </Route>
    </Switch>
  );
}

=== web/src/pruebas/api-falsa.test.ts ===
import { describe, expect, test } from "bun:test";
import { coleccion, fetchFalso } from "./api-falsa";

function pedir(metodo: string, ruta: string) {
  return new Request(`http://localhost/api${ruta}`, { method: metodo });
}

function sembrarCosas() {
  return coleccion("/cosas", "cosa", [{ id: "1", estado: "Activa" }], {
    cancelar: { estado: "Cancelada" },
  });
}

describe("fetchFalso", () => {
  test("debería poner en el elemento los campos de la acción cuando se le pide", async () => {
    // Preparar
    const cosas = sembrarCosas();

    // Actuar
    const respuesta = await fetchFalso([cosas])(pedir("POST", "/cosas/1/cancelar"));

    // Comprobar
    expect(respuesta.status).toBe(200);
    expect(await respuesta.json()).toEqual({ id: "1", estado: "Cancelada" });
    expect(cosas.elementos.get("1")).toEqual({ id: "1", estado: "Cancelada" });
  });

  test("debería responder 404 cuando la acción no existe", async () => {
    // Preparar
    const cosas = sembrarCosas();

    // Actuar
    const respuesta = await fetchFalso([cosas])(pedir("POST", "/cosas/1/archivar"));

    // Comprobar
    expect(respuesta.status).toBe(404);
    expect(cosas.elementos.get("1")).toEqual({ id: "1", estado: "Activa" });
  });

  test("debería responder el fallo de la acción sin cambiar el elemento", async () => {
    // Preparar
    const cosas = sembrarCosas();
    const fallos = { "POST /cosas/{id}/cancelar": "cosa.validacion.ya_cancelada" };

    // Actuar
    const respuesta = await fetchFalso([cosas], fallos)(pedir("POST", "/cosas/1/cancelar"));

    // Comprobar
    expect((await respuesta.json()).codigo).toBe("cosa.validacion.ya_cancelada");
    expect(cosas.elementos.get("1")).toEqual({ id: "1", estado: "Activa" });
  });
});

=== web/src/pruebas/api-falsa.ts ===
import { type ClienteApi, crearClienteApi } from "../api/cliente";

/** Lo que guarda la API falsa bajo `ruta`: los DTO de la API, por id. */
export interface Coleccion<T extends { id: string }> {
  ruta: string;
  /** El código que responde un elemento que no está: `producto.no_encontrado`. */
  noEncontrado: string;
  elementos: Map<string, T>;
  /** Los campos que `POST <ruta>/{id}/<accion>` pone en el elemento, por acción. */
  acciones: Record<string, Partial<T>>;
}

/**
 * Los elementos bajo `ruta` (`/productos`) de `entidad` (`producto`), empezando por `semilla`, y
 * las `acciones` que entiende: `{ cancelar: { estado: "Cancelado" } }`.
 */
export function coleccion<T extends { id: string }>(
  ruta: string,
  entidad: string,
  semilla: T[] = [],
  acciones: Record<string, Partial<T>> = {},
): Coleccion<T> {
  const elementos = new Map(semilla.map((elemento) => [elemento.id, elemento]));
  return { ruta, noEncontrado: `${entidad}.no_encontrado`, elementos, acciones };
}

/** Un `ClienteApi` sobre {@link fetchFalso}. */
export function apiFalsa(
  colecciones: Coleccion<{ id: string }>[],
  fallos: Record<string, string> = {},
): ClienteApi {
  return crearClienteApi({
    baseUrl: "http://localhost/api",
    fetch: fetchFalso(colecciones, fallos),
  });
}

/**
 * Un `fetch` que responde como la API generada, sobre colecciones en memoria: una página por
 * `limite` / `desplazamiento`, un `404` con `<entidad>.no_encontrado`, `201`, `200` y `204`, y
 * `200` con el elemento cambiado a una acción. Cada uno de `fallos` responde su código en su lugar:
 * `{ "POST /productos": "producto.duplicado" }` (también a las acciones), o solo el de una acción,
 * `{ "POST /productos/{id}/publicar": "producto.validacion.ya_publicado" }`.
 */
export function fetchFalso(
  colecciones: Coleccion<{ id: string }>[],
  fallos: Record<string, string> = {},
) {
  return async (peticion: Request): Promise<Response> => {
    const url = new URL(peticion.url);
    const ruta = url.pathname.replace(/^\/api/, "");
    const objetivo = colecciones.find((c) => ruta === c.ruta || ruta.startsWith(`${c.ruta}/`));
    if (objetivo === undefined) return responderError(404, "http.404");
    const [id = "", accion] = ruta.slice(objetivo.ruta.length + 1).split("/");
    const fallo =
      fallos[`${peticion.method} ${objetivo.ruta}/{id}/${accion}`] ??
      fallos[`${peticion.method} ${objetivo.ruta}`];
    if (fallo !== undefined) return responderError(400, fallo);
    if (accion !== undefined) return servirAccion(objetivo, peticion, id, accion);
    return id === ""
      ? servirLista(objetivo, peticion, url)
      : servirElemento(objetivo, peticion, id);
  };
}

async function servirLista(objetivo: Coleccion<{ id: string }>, peticion: Request, url: URL) {
  if (peticion.method === "POST") {
    const creado = { ...(await peticion.json()), id: crypto.randomUUID() };
    objetivo.elementos.set(creado.id, creado);
    return Response.json(creado, { status: 201 });
  }
  const limite = Number(url.searchParams.get("limite") ?? 20);
  const desplazamiento = Number(url.searchParams.get("desplazamiento") ?? 0);
  const todos = [...objetivo.elementos.values()];
  const elementos = todos.slice(desplazamiento, desplazamiento + limite);
  return Response.json({ elementos, total: todos.length, limite, desplazamiento });
}

async function servirElemento(objetivo: Coleccion<{ id: string }>, peticion: Request, id: string) {
  const encontrado = objetivo.elementos.get(id);
  if (encontrado === undefined) return responderError(404, objetivo.noEncontrado);
  if (peticion.method === "DELETE") {
    objetivo.elementos.delete(id);
    return new Response(null, { status: 204 });
  }
  if (peticion.method === "PUT") {
    // Como la API, actualizar reemplaza todos los campos: el que no se manda queda vacío.
    const actualizado = { ...(await peticion.json()), id };
    objetivo.elementos.set(id, actualizado);
    return Response.json(actualizado);
  }
  return Response.json(encontrado);
}

function servirAccion(
  objetivo: Coleccion<{ id: string }>,
  peticion: Request,
  id: string,
  accion: string,
) {
  const cambios = objetivo.acciones[accion];
  if (peticion.method !== "POST" || cambios === undefined) return responderError(404, "http.404");
  const encontrado = objetivo.elementos.get(id);
  if (encontrado === undefined) return responderError(404, objetivo.noEncontrado);
  const cambiado = { ...encontrado, ...cambios };
  objetivo.elementos.set(id, cambiado);
  return Response.json(cambiado);
}

/** Un `RespuestaError` como lo responde la API. */
function responderError(estado: number, codigo: string) {
  return Response.json({ codigo, mensaje: codigo }, { status: estado });
}

=== web/src/pruebas/reserva.ts ===
import type { Esquemas } from "../api/cliente";
import { coleccion } from "./api-falsa";

type Reserva = Esquemas["DtoReserva"];
type PeticionReserva = Esquemas["PeticionCrearReserva"];

/** Datos válidos de reservas; en `cambios`, los campos de los que trata el test. */
export const MadreReserva = {
  peticion(cambios: Partial<PeticionReserva> = {}): PeticionReserva {
    return {
      reference: "example",
      tenantId: crypto.randomUUID(),
      ...cambios,
    };
  },

  aleatorio(cambios: Partial<Reserva> = {}): Reserva {
    return { id: crypto.randomUUID(), ...MadreReserva.peticion(), ...cambios };
  },
};

/** El `/reservas` de la API falsa, con `semilla`. */
export function coleccionReserva(semilla: Reserva[] = []) {
  return coleccion("/reservas", "reserva", semilla);
}
