import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { BookingError } from "../../../../domain/booking/errors";
import { BookingMother, fakeBookingRepository } from "../../../../test-support/booking";
import { renderScreen } from "../../../../test-support/render";
import { BookingListContainer } from "./booking-list-container";

describe("BookingListContainer", () => {
  test("should show a row per booking when there are some", async () => {
    // Arrange
    const seed = [BookingMother.random(), BookingMother.random()];
    const bookingRepository = fakeBookingRepository(seed);

    // Act
    renderScreen(<BookingListContainer />, { bookingRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => BookingMother.random());
    const bookingRepository = fakeBookingRepository(seed);
    renderScreen(<BookingListContainer />, { bookingRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => BookingMother.random());
    const bookingRepository = fakeBookingRepository(seed);
    const path = "/bookings?page=2";

    // Act
    renderScreen(<BookingListContainer />, { bookingRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no booking", async () => {
    // Arrange
    const bookingRepository = fakeBookingRepository();

    // Act
    renderScreen(<BookingListContainer />, { bookingRepository });

    // Assert
    expect(await screen.findByText("No bookings yet.")).toBeTruthy();
  });

  test("should show the error code when the bookings cannot be listed", async () => {
    // Arrange
    const bookingRepository = {
      ...fakeBookingRepository(),
      list: () => Promise.reject(new BookingError("booking.repository_error")),
    };

    // Act
    renderScreen(<BookingListContainer />, { bookingRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("booking.repository_error");
  });
});

=== web/src/presentation/features/booking/containers/booking-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { BookingListView } from "../views/booking-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function BookingListContainer() {
  const { bookingRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const bookings = useAsync(
    () => bookingRepository.list({ limit: PAGE_SIZE, offset }),
    [bookingRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Bookings</h1>
        <Link href="/bookings/new" className="btn btn-primary">
          New booking
        </Link>
      </div>
      {bookings.status === "loading" && <span className="loading loading-spinner" />}
      {bookings.status === "error" && <ErrorAlert error={bookings.error} />}
      {bookings.status === "ok" &&
        (bookings.data.total === 0 ? (
          <EmptyState message="No bookings yet." />
        ) : (
          <>
            <BookingListView bookings={bookings.data.items} />
            <Pagination {...bookings.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

