=== web/src/domain/booking/errors.ts ===
/**
 * A request about a booking that the API refused. `code` is the API's `ErrorResponse.name`:
 * `booking.not_found`, `booking.validation_error.<field>_empty`.
 */
export class BookingError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "BookingError";
    this.code = code;
  }
}

=== web/src/domain/booking/messages.ts ===
import type { BookingDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface BookingProblem {
  field: keyof BookingDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "booking.validation_error.reference_empty": "Reference is required",
  "booking.invalid_tenant_id": "Tenant id is not valid",
  "booking.duplicate": "A booking with these values already exists",
  "booking.not_found": "This booking no longer exists",
  "booking.repository_error": "The booking could not be saved, try again later",
  "booking.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof BookingDraft> = {
  "booking.validation_error.reference_empty": "reference",
  "booking.invalid_tenant_id": "tenantId",
};

export function toProblem(code: string): BookingProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

