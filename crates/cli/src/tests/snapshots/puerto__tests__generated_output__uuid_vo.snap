=== web/src/presentation/features/booking/views/booking-form-view.tsx ===
import type { BookingProblem } from "../../../../domain/booking/messages";
import type { Booking, BookingDraft } from "../../../../domain/booking/model";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface BookingFormValues {
  reference: string;
  tenantId: string;
}

/** The inputs for `booking`, empty when there is none yet. */
export function toBookingForm(booking: Booking | null): BookingFormValues {
  if (booking === null) {
    return {
      reference: "",
      tenantId: "",
    };
  }
  return {
    reference: booking.reference,
    tenantId: booking.tenantId,
  };
}

export function toBookingDraft(values: BookingFormValues): BookingDraft {
  return {
    reference: values.reference,
    tenantId: values.tenantId,
  };
}

export function BookingFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: BookingFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: BookingProblem | null;
  onChange: (values: BookingFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Reference</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "reference"}
          required
          value={values.reference}
          onChange={(event) => onChange({ ...values, reference: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="reference" />
      <label className="fieldset">
        <span className="fieldset-legend">Tenant id</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "tenantId"}
          required
          value={values.tenantId}
          onChange={(event) => onChange({ ...values, tenantId: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="tenantId" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

