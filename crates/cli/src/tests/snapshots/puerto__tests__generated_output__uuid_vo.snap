import { Link } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { BookingListView } from "../views/booking-list-view";

export function BookingListContainer() {
  const { bookingRepository } = useDependencies();
  const bookings = useAsync(() => bookingRepository.list(), [bookingRepository]);

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Bookings</h1>
        <Link href="/bookings/new" className="btn btn-primary">
          New booking
        </Link>
      </div>
      {bookings.status === "loading" && <span className="loading loading-spinner" />}
      {bookings.status === "error" && <ErrorAlert error={bookings.error} />}
      {bookings.status === "ok" &&
        (bookings.data.length === 0 ? (
          <EmptyState message="No bookings yet." />
        ) : (
          <BookingListView bookings={bookings.data} />
        ))}
    </section>
  );
}

