                <Link href={`/reservas/${reserva.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/reserva.ts ===
import { ReservaError } from "../domain/reserva/errors";
import type { Reserva, ReservaDraft } from "../domain/reserva/model";
import type { ReservaRepository } from "../domain/reserva/repository";

/** Valid reservas for tests; pass `overrides` for the fields a test is about. */
export const ReservaMother = {
  draft(overrides: Partial<ReservaDraft> = {}): ReservaDraft {
    return {
      reference: "example",
      tenantId: crypto.randomUUID(),
      ...overrides,
    };
  },

  random(overrides: Partial<Reserva> = {}): Reserva {
    return { id: crypto.randomUUID(), ...ReservaMother.draft(), ...overrides };
  },
};

/** An in-memory `ReservaRepository`. Override a method to make it fail. */
export function fakeReservaRepository(seed: Reserva[] = []): ReservaRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new ReservaError("reserva.no_encontrado");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
