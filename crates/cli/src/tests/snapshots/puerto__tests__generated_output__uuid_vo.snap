#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::booking::{
        model::{Booking, BookingProps},
        repository::mocks::MockBookingRepository,
    };
    use uuid::Uuid;
    use crate::domain::booking::value_objects::TenantId;


    #[tokio::test]
    async fn should_return_all_bookings() {
        let entities = vec![
            Booking::new(BookingProps {
            reference: "first".to_string(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        }).unwrap(),
            Booking::new(BookingProps {
            reference: "second".to_string(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        }).unwrap(),
        ];
        let mut mock_repo = MockBookingRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListBookingsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListBookingsParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_bookings_exist() {
        let mut mock_repo = MockBookingRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListBookingsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListBookingsParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

