use async_trait::async_trait;
use uuid::Uuid;

use super::{errors::BookingError, model::Booking};

#[async_trait]
pub trait BookingRepositoryTrait: Send + Sync {
    async fn find_all(&self) -> Result<Vec<Booking>, BookingError>;
    async fn find_by_id(&self, id: Uuid) -> Result<Option<Booking>, BookingError>;
    async fn save(&self, entity: &Booking) -> Result<(), BookingError>;
}

#[cfg(any(test, feature = "test-utils"))]
pub mod mocks {
    use mockall::mock;
    use uuid::Uuid;

    use super::*;

    mock! {
        pub BookingRepository {}

        #[async_trait]
        impl BookingRepositoryTrait for BookingRepository {
            async fn find_all(&self) -> Result<Vec<Booking>, BookingError>;
            async fn find_by_id(&self, id: Uuid) -> Result<Option<Booking>, BookingError>;
            async fn save(&self, entity: &Booking) -> Result<(), BookingError>;
        }
    }
}

