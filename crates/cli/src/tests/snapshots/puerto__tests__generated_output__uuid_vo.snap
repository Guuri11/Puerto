import type { ReservaRepository } from "../../../domain/reserva/repository";
import { createApiClient } from "../../../infrastructure/http/client";
import { reservaRepositoryHttp } from "../../../infrastructure/reserva/reserva-repository-http";

export interface Dependencies {
