use std::sync::Arc;

use business::domain::booking::model::BookingId;
use business::domain::booking::use_cases::{
    create_booking::{CreateBookingParams, CreateBookingUseCaseTrait},
    delete_booking::{DeleteBookingParams, DeleteBookingUseCaseTrait},
    get_booking::{GetBookingParams, GetBookingUseCaseTrait},
    list_bookings::{ListBookingsParams, ListBookingsUseCaseTrait},
    update_booking::{UpdateBookingParams, UpdateBookingUseCaseTrait},
};
use poem_openapi::{OpenApi, param::Path, payload::Json};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::booking::dto::{CreateBookingRequest, UpdateBookingRequest, BookingDto};
use crate::api::booking::responses::{
    CreateBookingResponse, DeleteBookingResponse, GetBookingResponse, ListBookingsResponse,
    UpdateBookingResponse,
};

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct BookingApi {
    pub create_booking: Arc<dyn CreateBookingUseCaseTrait>,
    pub get_booking: Arc<dyn GetBookingUseCaseTrait>,
    pub list_bookings: Arc<dyn ListBookingsUseCaseTrait>,
    pub update_booking: Arc<dyn UpdateBookingUseCaseTrait>,
    pub delete_booking: Arc<dyn DeleteBookingUseCaseTrait>,
}

#[OpenApi]
impl BookingApi {
    /// Create a new Booking
    #[oai(path = "/bookings", method = "post", tag = "ApiTags::Booking")]
    async fn create(&self, body: Json<CreateBookingRequest>) -> CreateBookingResponse {
        match self
            .create_booking
            .execute(CreateBookingParams {
                reference: body.reference.clone(),
                tenant_id: body.tenant_id,
            })
            .await
        {
            Ok(entity) => CreateBookingResponse::Created(Json(BookingDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_booking failed");
                CreateBookingResponse::from_status(status, error)
            }
        }
    }

    /// Get a Booking by ID
    #[oai(path = "/bookings/:id", method = "get", tag = "ApiTags::Booking")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetBookingResponse {
        match self
            .get_booking
            .execute(GetBookingParams { id: BookingId::from_uuid(id.0) })
            .await
        {
            Ok(entity) => GetBookingResponse::Ok(Json(BookingDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_booking failed");
                GetBookingResponse::from_status(status, error)
            }
        }
    }

    /// List all Bookings
    #[oai(path = "/bookings", method = "get", tag = "ApiTags::Booking")]
    async fn list(&self) -> ListBookingsResponse {
        match self.list_bookings.execute(ListBookingsParams).await {
            Ok(entities) => {
                ListBookingsResponse::Ok(Json(entities.iter().map(BookingDto::from_domain).collect()))
            }
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_bookings failed");
                ListBookingsResponse::from_status(status, error)
            }
        }
    }

    /// Update a Booking
    #[oai(path = "/bookings/:id", method = "put", tag = "ApiTags::Booking")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateBookingRequest>) -> UpdateBookingResponse {
        match self
            .update_booking
            .execute(UpdateBookingParams {
                id: BookingId::from_uuid(id.0),
                reference: body.reference.clone(),
                tenant_id: body.tenant_id,
            })
            .await
        {
            Ok(entity) => UpdateBookingResponse::Ok(Json(BookingDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_booking failed");
                UpdateBookingResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Booking
    #[oai(path = "/bookings/:id", method = "delete", tag = "ApiTags::Booking")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteBookingResponse {
        match self
            .delete_booking
            .execute(DeleteBookingParams { id: BookingId::from_uuid(id.0) })
            .await
        {
            Ok(()) => DeleteBookingResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_booking failed");
                DeleteBookingResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::booking::errors::BookingError;
    use business::domain::booking::use_cases::{
        create_booking::mocks::MockCreateBookingUseCase, delete_booking::mocks::MockDeleteBookingUseCase,
        get_booking::mocks::MockGetBookingUseCase, list_bookings::mocks::MockListBookingsUseCase,
        update_booking::mocks::MockUpdateBookingUseCase,
    };
    use business::tests::mothers::booking_mother::BookingMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateBookingUseCase,
        get: MockGetBookingUseCase,
        list: MockListBookingsUseCase,
        update: MockUpdateBookingUseCase,
        delete: MockDeleteBookingUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = BookingApi {
                create_booking: Arc::new(self.create),
                get_booking: Arc::new(self.get),
                list_bookings: Arc::new(self.list),
                update_booking: Arc::new(self.update),
                delete_booking: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateBookingRequest {
        CreateBookingRequest {
            reference: "example".to_string(),
            tenant_id: Uuid::new_v4(),
        }
    }

    fn update_request() -> UpdateBookingRequest {
        UpdateBookingRequest {
            reference: "example".to_string(),
            tenant_id: Uuid::new_v4(),
        }
    }

    fn item_path() -> String {
        format!("/bookings/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_booking_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| Ok(BookingMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/bookings")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_booking_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(BookingError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/bookings")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_booking_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Ok(BookingMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_booking_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Err(BookingError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_every_booking_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Ok(BookingMother::random_vec(2)));

        // Act
        let response = mocks.client().get("/bookings").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        response.json().await.value().array().assert_len(2);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Err(BookingError::RepositoryError));

        // Act
        let response = mocks.client().get("/bookings").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_booking_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Ok(BookingMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_booking() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Err(BookingError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_booking_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_booking() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Err(BookingError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

