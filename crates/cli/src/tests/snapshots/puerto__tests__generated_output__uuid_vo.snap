use crate::domain::booking::model::Booking;
use crate::domain::booking::model::BookingProps;
use crate::domain::booking::value_objects::TenantId;
use uuid::Uuid;

pub struct BookingMother {
    reference: Option<String>,
    tenant_id: Option<TenantId>,
}

impl BookingMother {
    pub fn new() -> Self {
        Self {
            reference: None,
            tenant_id: None,
        }
    }

    pub fn with_reference(mut self, reference: &str) -> Self {
        self.reference = Some(reference.to_string());
        self
    }

    pub fn with_tenant_id(mut self, tenant_id: TenantId) -> Self {
        self.tenant_id = Some(tenant_id);
        self
    }

    pub fn with_empty_reference(mut self) -> Self {
        self.reference = Some(String::new());
        self
    }

    pub fn build(self) -> Booking {
        Booking::new(BookingProps {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            tenant_id: self
                .tenant_id
                .unwrap_or_else(|| TenantId::new(Uuid::new_v4()).expect("valid TenantId")),
        })
        .expect("BookingMother: failed to build valid Booking")
    }

    pub fn build_props(self) -> BookingProps {
        BookingProps {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            tenant_id: self
                .tenant_id
                .unwrap_or_else(|| TenantId::new(Uuid::new_v4()).expect("valid TenantId")),
        }
    }

    pub fn random() -> Booking {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Booking> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for BookingMother {
    fn default() -> Self {
        Self::new()
    }
}

=== infrastructure/src/booking/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::booking::{
    model::{Booking, BookingId},
    repository::BookingRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// Keeps the bookings it is given in process memory: they are lost when the process stops.
/// Like the Postgres adapter, it hides deleted rows and lists newest first.
/// It stands in until there is a database (`puerto new --db` generates Postgres repositories).
#[derive(Default)]
pub struct InMemoryBookingRepository {
    rows: RwLock<HashMap<BookingId, Booking>>,
}

impl InMemoryBookingRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<BookingId, Booking>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<BookingId, Booking>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl BookingRepositoryTrait for InMemoryBookingRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Booking>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = self.read();
        let mut live: Vec<&Booking> = rows.values().filter(|row| !row.deleted).collect();
        live.sort_by(|a, b| {
            b.created_at
                .cmp(&a.created_at)
                .then_with(|| a.id.value().cmp(&b.id.value()))
        });
        let total = live.len() as u64;
        let items = live
            .into_iter()
            .skip(page.offset() as usize)
            .take(page.limit() as usize)
            .cloned()
            .collect();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: BookingId) -> Result<Option<Booking>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(self.read().get(&id).filter(|row| !row.deleted).cloned())
    }

    async fn save(&self, entity: &Booking) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let mut rows = self.write();
        rows.insert(entity.id, entity.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::booking::model::BookingProps;
    use business::domain::booking::value_objects::TenantId;
    use uuid::Uuid;

    fn new_booking() -> Booking {
        Booking::new(BookingProps {
            reference: "example".to_string(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        })
        .unwrap()
    }

    #[tokio::test]
    async fn should_find_a_saved_booking_by_id() {
        // Arrange
        let repo = InMemoryBookingRepository::new();
        let entity = new_booking();
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();

        // Assert
        assert_eq!(found.map(|row| row.id), Some(entity.id));
    }

    #[tokio::test]
    async fn should_update_the_row_when_saved_again() {
        // Arrange
        let repo = InMemoryBookingRepository::new();
        let mut entity = new_booking();
        repo.save(&entity).await.unwrap();
        entity.updated_at = chrono::Utc::now();

        // Act
        repo.save(&entity).await.unwrap();

        // Assert
        let page = repo.find_all(PageRequest::default()).await.unwrap();
        assert_eq!(page.total, 1);
        assert_eq!(page.items[0].updated_at, entity.updated_at);
    }

    #[tokio::test]
    async fn should_not_find_a_deleted_booking() {
        // Arrange
        let repo = InMemoryBookingRepository::new();
        let mut entity = new_booking();
        entity.deleted = true;
        entity.deleted_at = Some(entity.updated_at);
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();
        let page = repo.find_all(PageRequest::default()).await.unwrap();

        // Assert
        assert!(found.is_none());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_return_the_requested_page_of_a_larger_list() {
        // Arrange
        let repo = InMemoryBookingRepository::new();
        for _ in 0..3 {
            repo.save(&new_booking()).await.unwrap();
        }

        // Act
        let page = repo
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }
}

