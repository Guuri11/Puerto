import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { BookingMother, fakeBookingRepository } from "../../../../test-support/booking";
import { renderScreen } from "../../../../test-support/render";
import { BookingDetailContainer } from "./booking-detail-container";

describe("BookingDetailContainer", () => {
  test("should show the booking when it exists", async () => {
    // Arrange
    const seeded = BookingMother.random();
    const bookingRepository = fakeBookingRepository([seeded]);

    // Act
    renderScreen(<BookingDetailContainer id={seeded.id} />, { bookingRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the booking does not exist", async () => {
    // Arrange
    const bookingRepository = fakeBookingRepository();

    // Act
    renderScreen(<BookingDetailContainer id={crypto.randomUUID()} />, { bookingRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("booking.not_found");
  });

  test("should delete the booking only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = BookingMother.random();
    const fake = fakeBookingRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<BookingDetailContainer id={seeded.id} />, {
      bookingRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/bookings"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/booking/containers/booking-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { BookingDetailView } from "../views/booking-detail-view";

export function BookingDetailContainer({ id }: { id: string }) {
  const { bookingRepository } = useDependencies();
  const booking = useAsync(() => bookingRepository.get(id), [bookingRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await bookingRepository.remove(id);
      navigate("/bookings");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Booking</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {booking.status === "loading" && <span className="loading loading-spinner" />}
      {booking.status === "error" && <ErrorAlert error={booking.error} />}
      {booking.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <BookingDetailView booking={booking.data} />
            <div className="card-actions justify-end">
              <Link href={`/bookings/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/bookings" className="link">
        Back to bookings
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this booking?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/booking/containers/booking-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { BookingError } from "../../../../domain/booking/errors";
import type { BookingDraft } from "../../../../domain/booking/model";
import { BookingMother, fakeBookingRepository } from "../../../../test-support/booking";
import { renderScreen } from "../../../../test-support/render";
import { BookingFormContainer } from "./booking-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: BookingDraft) {
  await screen.findByText("Save");
  type("Reference", draft.reference);
  type("Tenant id", draft.tenantId);
}

describe("BookingFormContainer", () => {
  test("should create the booking from what was typed and show it", async () => {
    // Arrange
    const draft = BookingMother.draft();
    const bookingRepository = fakeBookingRepository();
    const { history } = renderScreen(<BookingFormContainer />, { bookingRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/bookings/"));
    const [created] = await bookingRepository.list();
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/bookings/${created?.id}`);
  });

  test("should save the edited booking when an existing one is submitted", async () => {
    // Arrange
    const seeded = BookingMother.random();
    const bookingRepository = fakeBookingRepository([seeded]);
    const { history } = renderScreen(<BookingFormContainer id={seeded.id} />, {
      bookingRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/bookings/${seeded.id}`));
    expect(await bookingRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the validation code when the API rejects the booking", async () => {
    // Arrange
    const code = "booking.validation_error.invalid";
    const bookingRepository = {
      ...fakeBookingRepository(),
      create: () => Promise.reject(new BookingError(code)),
    };
    renderScreen(<BookingFormContainer />, { bookingRepository });
    await fillIn(BookingMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });
});

=== web/src/presentation/features/booking/containers/booking-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Booking } from "../../../../domain/booking/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { BookingFormView, toBookingDraft, toBookingForm } from "../views/booking-form-view";

/** Creates a booking, or edits the one with `id`. */
export function BookingFormContainer({ id }: { id?: string }) {
  const { bookingRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : bookingRepository.get(id)),
    [bookingRepository, id],
  );
  const title = id === undefined ? "New booking" : "Edit booking";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <BookingForm existing={existing.data} />}
      <Link href={id === undefined ? "/bookings" : `/bookings/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function BookingForm({ existing }: { existing: Booking | null }) {
  const { bookingRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toBookingForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toBookingDraft(values);
      const saved =
        existing === null
          ? await bookingRepository.create(draft)
          : await bookingRepository.update(existing.id, draft);
      navigate(`/bookings/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {failure !== null && <ErrorAlert error={failure} />}
        <BookingFormView values={values} saving={saving} onChange={setValues} onSubmit={save} />
      </div>
    </div>
  );
}

