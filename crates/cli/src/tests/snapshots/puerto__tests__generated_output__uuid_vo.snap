export interface Booking {
  id: string;
  reference: string;
  tenantId: string;
}

/** What a create or an update sends: a booking without its id. */
export type BookingDraft = Omit<Booking, "id">;

=== web/src/domain/booking/repository.ts ===
import type { Booking, BookingDraft } from "./model";

/** The port the screens call. Every method rejects with the `BookingError` the API answered. */
export interface BookingRepository {
  list(): Promise<Booking[]>;
  get(id: string): Promise<Booking>;
  create(draft: BookingDraft): Promise<Booking>;
  update(id: string, draft: BookingDraft): Promise<Booking>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/booking/booking-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { BookingError } from "../../domain/booking/errors";
import { BookingMother } from "../../test-support/booking";
import { createApiClient } from "../http/client";
import { bookingRepositoryHttp } from "./booking-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: bookingRepositoryHttp(api), requests };
}

describe("bookingRepositoryHttp", () => {
  test("should return every booking when the API lists them", async () => {
    // Arrange
    const booking = BookingMother.random();
    const { repository } = answering(200, [booking]);

    // Act
    const listed = await repository.list();

    // Assert
    expect(listed).toEqual([booking]);
  });

  test("should send the draft when creating a booking", async () => {
    // Arrange
    const draft = BookingMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the booking does not exist", async () => {
    // Arrange
    const code = "booking.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(BookingError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the booking", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/bookings/42");
  });
});

=== web/src/infrastructure/booking/booking-repository-http.ts ===
import { BookingError } from "../../domain/booking/errors";
import type { Booking, BookingDraft } from "../../domain/booking/model";
import type { BookingRepository } from "../../domain/booking/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type BookingDto = components["schemas"]["BookingDto"];
type BookingRequest = components["schemas"]["CreateBookingRequest"];

function toBooking(dto: BookingDto): Booking {
  return {
    id: dto.id,
    reference: dto.reference,
    tenantId: dto.tenantId,
  };
}

function toRequest(draft: BookingDraft): BookingRequest {
  return {
    reference: draft.reference,
    tenantId: draft.tenantId,
  };
}

/** `BookingRepository` over the REST API (`/bookings`). */
export function bookingRepositoryHttp(api: ApiClient): BookingRepository {
  return {
    async list() {
      const { data, error, response } = await api.GET("/bookings");
      if (data === undefined) throw new BookingError(apiErrorCode(error, response));
      return data.map(toBooking);
    },
    async get(id) {
      const { data, error, response } = await api.GET("/bookings/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new BookingError(apiErrorCode(error, response));
      return toBooking(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/bookings", { body: toRequest(draft) });
      if (data === undefined) throw new BookingError(apiErrorCode(error, response));
      return toBooking(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/bookings/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new BookingError(apiErrorCode(error, response));
      return toBooking(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/bookings/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new BookingError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

