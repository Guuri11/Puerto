/** What a create or an update sends: a reserva without its id. */
export type ReservaDraft = Omit<Reserva, "id">;

=== web/src/domain/reserva/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Reserva, ReservaDraft } from "./model";

/** The port the screens call. Every method rejects with the `ReservaError` the API answered. */
export interface ReservaRepository {
  list(page: PageRequest): Promise<Page<Reserva>>;
  get(id: string): Promise<Reserva>;
  create(draft: ReservaDraft): Promise<Reserva>;
  update(id: string, draft: ReservaDraft): Promise<Reserva>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `RespuestaError.codigo` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "codigo" in error) {
    const { codigo } = error;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/reserva/reserva-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { ReservaError } from "../../domain/reserva/errors";
import { ReservaMother } from "../../test-support/reserva";
import { createApiClient } from "../http/client";
import { reservaRepositoryHttp } from "./reserva-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: reservaRepositoryHttp(api), requests };
}

describe("reservaRepositoryHttp", () => {
  test("should ask for the page and return its reservas", async () => {
    // Arrange
    const reserva = ReservaMother.random();
    const { repository, requests } = answering(200, {
      elementos: [reserva],
      total: 21,
      limite: 20,
      desplazamiento: 20,
    });

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    const url = new URL(requests[0]?.url ?? "");
    expect(url.pathname).toBe("/api/reservas");
    expect(url.search).toBe("?limite=20&desplazamiento=20");
    expect(listed).toEqual({ items: [reserva], total: 21, limit: 20, offset: 20 });
  });

  test("should send the draft when creating a reserva", async () => {
    // Arrange
    const draft = ReservaMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the reserva does not exist", async () => {
    // Arrange
    const code = "reserva.no_encontrado";
    const { repository } = answering(404, { codigo: code, mensaje: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(ReservaError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the reserva", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/reservas/42");
  });
});

=== web/src/infrastructure/reserva/reserva-repository-http.ts ===
import { ReservaError } from "../../domain/reserva/errors";
import type { Reserva, ReservaDraft } from "../../domain/reserva/model";
import type { ReservaRepository } from "../../domain/reserva/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ReservaDto = components["schemas"]["DtoReserva"];
type ReservaRequest = components["schemas"]["PeticionCrearReserva"];

function toReserva(dto: ReservaDto): Reserva {
  return {
    id: dto.id,
    reference: dto.reference,
    tenantId: dto.tenantId,
  };
}

function toRequest(draft: ReservaDraft): ReservaRequest {
  return {
    reference: draft.reference,
    tenantId: draft.tenantId,
  };
}

/** `ReservaRepository` over the REST API (`/reservas`). */
export function reservaRepositoryHttp(api: ApiClient): ReservaRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/reservas", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new ReservaError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toReserva),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/reservas/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ReservaError(apiErrorCode(error, response));
      return toReserva(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/reservas", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new ReservaError(apiErrorCode(error, response));
      return toReserva(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/reservas/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ReservaError(apiErrorCode(error, response));
      return toReserva(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/reservas/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ReservaError(apiErrorCode(error, response));
    },
  };
}

