use std::sync::Arc;

use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ParamsObtenerSaludo};
use poem_openapi::{OpenApi, Tags, param::Path};

use crate::{dto::DtoSaludo, errores::a_respuesta_error, respuestas::RespuestaObtenerSaludo};

#[derive(Tags)]
enum ApiTags {
    Saludo,
}

/// Guarda el puerto del caso de uso; `generado/bootstrap.rs` conecta la implementación.
pub struct ApiSaludo {
    pub obtener_saludo: Arc<dyn ObtenerSaludo>,
}

#[OpenApi]
impl ApiSaludo {
    /// Obtiene un saludo para el nombre dado
    #[oai(path = "/saludos/:nombre", method = "get", tag = "ApiTags::Saludo")]
    async fn obtener_saludo(&self, nombre: Path<String>) -> RespuestaObtenerSaludo {
        match self
            .obtener_saludo
            .ejecutar(ParamsObtenerSaludo { nombre: nombre.0 })
            .await
        {
            Ok(saludo) => RespuestaObtenerSaludo::Ok(poem_openapi::payload::Json(
                DtoSaludo::from_dominio(&saludo),
            )),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_saludo falló");
                RespuestaObtenerSaludo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;
    use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo};
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::OpenApiService;

    use super::*;

    fn cliente(caso_de_uso: MockObtenerSaludo) -> TestClient<Route> {
        let api = ApiSaludo {
            obtener_saludo: Arc::new(caso_de_uso),
        };
        TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
    }

    #[tokio::test]
    async fn deberia_responder_200_con_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|params| Saludo::new(&params.nombre));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("nombre")
            .assert_string("Ada");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_se_rechaza_el_saludo() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|_| Err(ErrorSaludo::Validacion("nombre_vacio".into())));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }
}

=== presentacion/api/Cargo.toml ===
[package]
name = "api"
version = "0.1.0"
edition = "2024"

[[bin]]
name = "snapshot"
path = "src/main.rs"

[dependencies]
# Los repositorios y casos de uso de cada contexto, ya construidos (`generado/bootstrap.rs`).
cableado = { workspace = true }
# El servidor, las sondas de salud, la configuración y el cuerpo de error (`main.rs`,
# `generado/bootstrap.rs`).
puerto-web = { workspace = true }
poem = { workspace = true }
poem-openapi = { workspace = true }
tokio = { workspace = true }
rest_saludo = { workspace = true }
rest_reserva = { workspace = true }

[dev-dependencies]
# El test que exporta la spec construye cada API con los dobles de los casos de uso.
aplicacion_saludo = { workspace = true, features = ["pruebas"] }
aplicacion_reserva = { workspace = true, features = ["pruebas"] }

=== presentacion/api/src/generado/bootstrap.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
use poem::Endpoint;
use poem_openapi::OpenApiService;
use rest_reserva::rutas::ApiReserva;
use rest_saludo::rutas::ApiSaludo;

/// Las rutas, cableadas. Un error es lo que paró el arranque: `main` lo muestra y sale con 1.
pub async fn construir_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let casos_saludo = cableado::saludo::construir();
    let api_saludo = ApiSaludo {
        obtener_saludo: casos_saludo.obtener_saludo,
    };

    let casos_reserva = cableado::reserva::construir();
    let api_reserva = ApiReserva {
        crear_reserva: casos_reserva.crear_reserva,
        obtener_reserva: casos_reserva.obtener_reserva,
        listar_reservas: casos_reserva.listar_reservas,
        actualizar_reserva: casos_reserva.actualizar_reserva,
        borrar_reserva: casos_reserva.borrar_reserva,
    };

    let disponible = puerto_web::health::siempre_disponible();

    // `app.rs` es del proyecto: el middleware y las rutas que se añadan allí envuelven todo esto.
    Ok(crate::app::configurar(puerto_web::rutas(
        servicio_openapi((api_saludo, api_reserva)),
        &config,
        disponible,
    )))
}

/// El servicio de la API, construido en un solo sitio: cualquier otro que lea su spec (el test de
/// exportación de un proyecto con `web/`) ve la API que responde el servidor.
fn servicio_openapi<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::sync::Arc;

    use aplicacion_reserva::actualizar_reserva::dobles::MockActualizarReserva;
    use aplicacion_reserva::borrar_reserva::dobles::MockBorrarReserva;
    use aplicacion_reserva::crear_reserva::dobles::MockCrearReserva;
    use aplicacion_reserva::listar_reservas::dobles::MockListarReservas;
    use aplicacion_reserva::obtener_reserva::dobles::MockObtenerReserva;
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;

    /// El contrato de la API del que se generan los tipos del frontend (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../../docs/api/openapi.json");

    /// Se construye con casos de uso dobles: sin servidor ni base de datos. Si falta el fichero,
    /// se escribe; si es distinto, falla: ejecuta `make web/sync` (pone `UPDATE_OPENAPI=1`) y haz
    /// commit del diff.
    #[test]
    fn la_spec_openapi_coincide_con_docs_api_openapi_json() {
        let api_saludo = ApiSaludo {
            obtener_saludo: Arc::new(MockObtenerSaludo::new()),
        };
        let api_reserva = ApiReserva {
            crear_reserva: Arc::new(MockCrearReserva::new()),
            obtener_reserva: Arc::new(MockObtenerReserva::new()),
            listar_reservas: Arc::new(MockListarReservas::new()),
            actualizar_reserva: Arc::new(MockActualizarReserva::new()),
            borrar_reserva: Arc::new(MockBorrarReserva::new()),
        };
        let spec = servicio_openapi((api_saludo, api_reserva)).spec();

        let ruta = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !ruta.exists() {
            let directorio = ruta
                .parent()
                .expect("docs/api/openapi.json tiene directorio padre");
            std::fs::create_dir_all(directorio).expect("crear docs/api");
            std::fs::write(ruta, &spec).expect("escribir docs/api/openapi.json");
            return;
        }
        let en_disco = std::fs::read_to_string(ruta).expect("leer docs/api/openapi.json");
        assert!(
            en_disco == spec,
            "docs/api/openapi.json no es la API que sirve este código: ejecuta `make web/sync`"
        );
    }
}

