use crate::modelo::PropsReserva;
use crate::modelo::Reserva;
use crate::valores::TenantId;
use uuid::Uuid;

pub struct MadreReserva {
    reference: Option<String>,
    tenant_id: Option<TenantId>,
}

impl MadreReserva {
    pub fn new() -> Self {
        Self {
            reference: None,
            tenant_id: None,
        }
    }

    pub fn con_reference(mut self, reference: &str) -> Self {
        self.reference = Some(reference.to_string());
        self
    }

    pub fn con_tenant_id(mut self, tenant_id: TenantId) -> Self {
        self.tenant_id = Some(tenant_id);
        self
    }

    pub fn con_reference_vacio(mut self) -> Self {
        self.reference = Some(String::new());
        self
    }

    pub fn construir(self) -> Reserva {
        Reserva::new(PropsReserva {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            tenant_id: self.tenant_id.unwrap_or_else(|| {
                TenantId::new(Uuid::new_v4()).expect("TenantId::new rechazó el valor de ejemplo")
            }),
        })
        .expect("MadreReserva: Reserva::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsReserva {
        PropsReserva {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            tenant_id: self.tenant_id.unwrap_or_else(|| {
                TenantId::new(Uuid::new_v4()).expect("TenantId::new rechazó el valor de ejemplo")
            }),
        }
    }

    pub fn aleatorio() -> Reserva {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Reserva> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreReserva {
    fn default() -> Self {
        Self::new()
    }
}

