use async_trait::async_trait;
use dominio_reserva::errores::ErrorReserva;
use dominio_reserva::modelo::Reserva;
use dominio_reserva::repositorio::RepositorioReserva;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarReservas {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarReservas: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarReservas)
    -> Result<Pagina<Reserva>, ErrorReserva>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarReservas {}

        #[async_trait]
        impl ListarReservas for ListarReservas {
            async fn ejecutar(&self, params: ParamsListarReservas) -> Result<Pagina<Reserva>, ErrorReserva>;
        }
    }
}

pub struct ListarReservasImpl {
    pub repositorio: Arc<dyn RepositorioReserva>,
}

#[async_trait]
impl ListarReservas for ListarReservasImpl {
    #[tracing::instrument(name = "listar_reservas", skip_all, err(level = "warn"))]
    async fn ejecutar(
        &self,
        params: ParamsListarReservas,
    ) -> Result<Pagina<Reserva>, ErrorReserva> {
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .map_err(ErrorReserva::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_reserva::{
        pruebas::madres::MadreReserva, repositorio::dobles::MockRepositorioReserva,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_reservas() {
        let entidades = MadreReserva::aleatorios(2);
        let mut repositorio_doble = MockRepositorioReserva::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarReservasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarReservas {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_reservas() {
        let mut repositorio_doble = MockRepositorioReserva::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarReservasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarReservas {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioReserva::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarReservasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarReservas {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

