use async_trait::async_trait;
use dominio_reserva::errores::ErrorReserva;
use dominio_reserva::modelo::IdReserva;
use dominio_reserva::repositorio::RepositorioReserva;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarReserva {
    pub id: IdReserva,
}

#[async_trait]
pub trait BorrarReserva: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarReserva) -> Result<(), ErrorReserva>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarReserva {}

        #[async_trait]
        impl BorrarReserva for BorrarReserva {
            async fn ejecutar(&self, params: ParamsBorrarReserva) -> Result<(), ErrorReserva>;
        }
    }
}

pub struct BorrarReservaImpl {
    pub repositorio: Arc<dyn RepositorioReserva>,
}

#[async_trait]
impl BorrarReserva for BorrarReservaImpl {
    async fn ejecutar(&self, params: ParamsBorrarReserva) -> Result<(), ErrorReserva> {
        tracing::info!(id = %params.id, "borrar_reserva: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_reserva: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = ErrorReserva::NoEncontrado;
                tracing::warn!(error = %err, "borrar_reserva: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "borrar_reserva: fallo del repositorio"),
        )?;
        Ok(())
    }
}

