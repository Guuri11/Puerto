=== web/src/presentation/features/reserva/views/reserva-form-view.tsx ===
import type { ReservaProblem } from "../../../../domain/reserva/messages";
import type { Reserva, ReservaDraft } from "../../../../domain/reserva/model";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ReservaFormValues {
  reference: string;
  tenantId: string;
}

/** The inputs for `reserva`, empty when there is none yet. */
export function toReservaForm(reserva: Reserva | null): ReservaFormValues {
  if (reserva === null) {
    return {
      reference: "",
      tenantId: "",
    };
  }
  return {
    reference: reserva.reference,
    tenantId: reserva.tenantId,
  };
}

export function toReservaDraft(values: ReservaFormValues): ReservaDraft {
  return {
    reference: values.reference,
    tenantId: values.tenantId,
  };
}

export function ReservaFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: ReservaFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: ReservaProblem | null;
  onChange: (values: ReservaFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Reference</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "reference"}
          required
          value={values.reference}
          onChange={(event) => onChange({ ...values, reference: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="reference" />
      <label className="fieldset">
        <span className="fieldset-legend">Tenant id</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "tenantId"}
          required
          value={values.tenantId}
          onChange={(event) => onChange({ ...values, tenantId: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="tenantId" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

