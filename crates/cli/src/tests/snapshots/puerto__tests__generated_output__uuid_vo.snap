=== web/src/presentation/features/reserva/containers/reserva-detail-container.test.tsx ===
import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { renderScreen } from "../../../../test-support/render";
import { fakeReservaRepository, ReservaMother } from "../../../../test-support/reserva";
import { ReservaDetailContainer } from "./reserva-detail-container";

describe("ReservaDetailContainer", () => {
  test("should show the reserva when it exists", async () => {
    // Arrange
    const seeded = ReservaMother.random();
    const reservaRepository = fakeReservaRepository([seeded]);

    // Act
    renderScreen(<ReservaDetailContainer id={seeded.id} />, { reservaRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the reserva does not exist", async () => {
    // Arrange
    const reservaRepository = fakeReservaRepository();

    // Act
    renderScreen(<ReservaDetailContainer id={crypto.randomUUID()} />, {
      reservaRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("reserva.no_encontrado");
  });

  test("should delete the reserva only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ReservaMother.random();
    const fake = fakeReservaRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<ReservaDetailContainer id={seeded.id} />, {
      reservaRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/reservas"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/reserva/containers/reserva-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ReservaDetailView } from "../views/reserva-detail-view";

export function ReservaDetailContainer({ id }: { id: string }) {
  const { reservaRepository } = useDependencies();
  const reserva = useAsync(() => reservaRepository.get(id), [reservaRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await reservaRepository.remove(id);
      navigate("/reservas");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Reserva</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {reserva.status === "loading" && <span className="loading loading-spinner" />}
      {reserva.status === "error" && <ErrorAlert error={reserva.error} />}
      {reserva.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ReservaDetailView reserva={reserva.data} />
            <div className="card-actions justify-end">
              <Link href={`/reservas/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/reservas" className="link">
        Back to reservas
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this reserva?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/reserva/containers/reserva-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ReservaError } from "../../../../domain/reserva/errors";
import type { ReservaDraft } from "../../../../domain/reserva/model";
import { renderScreen } from "../../../../test-support/render";
import { fakeReservaRepository, ReservaMother } from "../../../../test-support/reserva";
import { ReservaFormContainer } from "./reserva-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ReservaDraft) {
  await screen.findByText("Save");
  type("Reference", draft.reference);
  type("Tenant id", draft.tenantId);
}

describe("ReservaFormContainer", () => {
  test("should create the reserva from what was typed and show it", async () => {
    // Arrange
    const draft = ReservaMother.draft();
    const reservaRepository = fakeReservaRepository();
    const { history } = renderScreen(<ReservaFormContainer />, { reservaRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/reservas/"));
    const {
      items: [created],
    } = await reservaRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/reservas/${created?.id}`);
  });

  test("should save the edited reserva when an existing one is submitted", async () => {
    // Arrange
    const seeded = ReservaMother.random();
    const reservaRepository = fakeReservaRepository([seeded]);
    const { history } = renderScreen(<ReservaFormContainer id={seeded.id} />, {
      reservaRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/reservas/${seeded.id}`));
    expect(await reservaRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "reserva.validacion.invalid";
    const reservaRepository = {
      ...fakeReservaRepository(),
      create: () => Promise.reject(new ReservaError(code)),
    };
    renderScreen(<ReservaFormContainer />, { reservaRepository });
    await fillIn(ReservaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a reserva with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const reservaRepository = {
      ...fakeReservaRepository(),
      create: () => Promise.reject(new ReservaError("reserva.duplicado")),
    };
    renderScreen(<ReservaFormContainer />, { reservaRepository });
    await fillIn(ReservaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A reserva with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const reservaRepository = {
      ...fakeReservaRepository(),
      create: () => Promise.reject(new ReservaError("reserva.validacion.reference_vacio")),
    };
    renderScreen(<ReservaFormContainer />, { reservaRepository });
    await fillIn(ReservaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Reference is required")).toBeTruthy();
    const input = screen.getByLabelText("Reference");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/reserva/containers/reserva-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/reserva/messages";
import type { Reserva } from "../../../../domain/reserva/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { ReservaFormView, toReservaDraft, toReservaForm } from "../views/reserva-form-view";

/** Creates a reserva, or edits the one with `id`. */
export function ReservaFormContainer({ id }: { id?: string }) {
  const { reservaRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : reservaRepository.get(id)),
    [reservaRepository, id],
  );
  const title = id === undefined ? "New reserva" : "Edit reserva";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ReservaForm existing={existing.data} />}
      <Link href={id === undefined ? "/reservas" : `/reservas/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ReservaForm({ existing }: { existing: Reserva | null }) {
  const { reservaRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toReservaForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toReservaDraft(values);
      const saved =
        existing === null
          ? await reservaRepository.create(draft)
          : await reservaRepository.update(existing.id, draft);
      navigate(`/reservas/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <ReservaFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

=== web/src/presentation/features/reserva/containers/reserva-list-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { ReservaError } from "../../../../domain/reserva/errors";
import { renderScreen } from "../../../../test-support/render";
import { fakeReservaRepository, ReservaMother } from "../../../../test-support/reserva";
import { ReservaListContainer } from "./reserva-list-container";

describe("ReservaListContainer", () => {
  test("should show a row per reserva when there are some", async () => {
    // Arrange
    const seed = [ReservaMother.random(), ReservaMother.random()];
    const reservaRepository = fakeReservaRepository(seed);

    // Act
    renderScreen(<ReservaListContainer />, { reservaRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ReservaMother.random());
    const reservaRepository = fakeReservaRepository(seed);
    renderScreen(<ReservaListContainer />, { reservaRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ReservaMother.random());
    const reservaRepository = fakeReservaRepository(seed);
    const path = "/reservas?page=2";

    // Act
    renderScreen(<ReservaListContainer />, { reservaRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no reserva", async () => {
    // Arrange
    const reservaRepository = fakeReservaRepository();

    // Act
    renderScreen(<ReservaListContainer />, { reservaRepository });

    // Assert
    expect(await screen.findByText("No reservas yet.")).toBeTruthy();
  });

  test("should show the error code when the reservas cannot be listed", async () => {
    // Arrange
    const reservaRepository = {
      ...fakeReservaRepository(),
      list: () => Promise.reject(new ReservaError("reserva.repositorio")),
    };

    // Act
    renderScreen(<ReservaListContainer />, { reservaRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("reserva.repositorio");
  });
});

=== web/src/presentation/features/reserva/containers/reserva-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { ReservaListView } from "../views/reserva-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function ReservaListContainer() {
  const { reservaRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const reservas = useAsync(
    () => reservaRepository.list({ limit: PAGE_SIZE, offset }),
    [reservaRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Reservas</h1>
        <Link href="/reservas/new" className="btn btn-primary">
          New reserva
        </Link>
      </div>
      {reservas.status === "loading" && <span className="loading loading-spinner" />}
      {reservas.status === "error" && <ErrorAlert error={reservas.error} />}
      {reservas.status === "ok" &&
        (reservas.data.total === 0 ? (
          <EmptyState message="No reservas yet." />
        ) : (
          <>
            <ReservaListView reservas={reservas.data.items} />
            <Pagination {...reservas.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

