import { Link } from "wouter";
import type { Booking } from "../../../../domain/booking/model";

export function BookingListView({ bookings }: { bookings: Booking[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Reference</th>
            <th>Tenant id</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {bookings.map((booking) => (
            <tr key={booking.id}>
              <td>{booking.reference}</td>
              <td>{booking.tenantId}</td>
              <td className="text-right">
                <Link href={`/bookings/${booking.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/booking.ts ===
import { BookingError } from "../domain/booking/errors";
import type { Booking, BookingDraft } from "../domain/booking/model";
import type { BookingRepository } from "../domain/booking/repository";

/** Valid bookings for tests; pass `overrides` for the fields a test is about. */
export const BookingMother = {
  draft(overrides: Partial<BookingDraft> = {}): BookingDraft {
    return {
      reference: "example",
      tenantId: crypto.randomUUID(),
      ...overrides,
    };
  },

  random(overrides: Partial<Booking> = {}): Booking {
    return { id: crypto.randomUUID(), ...BookingMother.draft(), ...overrides };
  },
};

/** An in-memory `BookingRepository`. Override a method to make it fail. */
export function fakeBookingRepository(seed: Booking[] = []): BookingRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new BookingError("booking.not_found");
    return found;
  };
  return {
    list: async () => [...store.values()],
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
