=== web/src/api/cliente.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { components, paths } from "./esquema";

/** El cliente tipado de la API. `paths` sale de la especificación del backend (`make web/sync`). */
export type ClienteApi = Client<paths>;

/** Los DTO de la API por nombre: `Esquemas["DtoProducto"]`, `Esquemas["PeticionCrearProducto"]`. */
export type Esquemas = components["schemas"];

/** `/api` es el backend: en desarrollo, Vite lo pasa a `:8080`. */
export function crearClienteApi(opciones: ClientOptions = {}): ClienteApi {
  return createClient<paths>({ baseUrl: "/api", ...opciones });
}

=== web/src/contextos/reserva/contenedores/detalle-reserva.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { coleccionReserva, MadreReserva } from "../../../pruebas/reserva";
import { ContenedorDetalleReserva } from "./detalle-reserva";

describe("ContenedorDetalleReserva", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreReserva.aleatorio();
    const api = apiFalsa([coleccionReserva([sembrado])]);

    const pantalla = <ContenedorDetalleReserva id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionReserva()]);
    const pantalla = <ContenedorDetalleReserva id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("reserva.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreReserva.aleatorio();
    const guardados = coleccionReserva([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleReserva id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/reservas"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/reserva/contenedores/detalle-reserva.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleReserva } from "../vistas/detalle-reserva";

export function ContenedorDetalleReserva({ id }: { id: string }) {
  const { api } = useDependencias();
  const reserva = useCarga(
    () => desenvolver(api.GET("/reservas/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/reservas/{id}", { params: { path: { id } } }));
      navegar("/reservas");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Reserva</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {reserva.estado === "cargando" && <span className="loading loading-spinner" />}
      {reserva.estado === "error" && <AlertaError error={reserva.error} />}
      {reserva.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleReserva reserva={reserva.datos} />
            <div className="card-actions justify-end">
              <Link href={`/reservas/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/reservas" className="link">
        Volver a reservas
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar reserva?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/reserva/contenedores/formulario-reserva.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { coleccionReserva, MadreReserva } from "../../../pruebas/reserva";
import { aProblema } from "../mensajes";
import { ContenedorFormularioReserva } from "./formulario-reserva";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearReserva"]) {
  await screen.findByText("Guardar");
  escribir("Reference", peticion.reference);
  escribir("Tenant id", peticion.tenantId);
}

describe("ContenedorFormularioReserva", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreReserva.peticion();
    const guardados = coleccionReserva();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioReserva />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/reservas/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/reservas/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreReserva.aleatorio();
    const guardados = coleccionReserva([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioReserva id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/reservas/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreReserva.peticion();
    const codigo = "reserva.validacion.invalido";
    const fallos = { "POST /reservas": codigo };
    const api = apiFalsa([coleccionReserva()], fallos);
    renderizarPantalla(<ContenedorFormularioReserva />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreReserva.peticion();
    const codigo = "reserva.duplicado";
    const fallos = { "POST /reservas": codigo };
    const api = apiFalsa([coleccionReserva()], fallos);
    renderizarPantalla(<ContenedorFormularioReserva />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreReserva.peticion();
    const codigo = "reserva.validacion.reference_vacio";
    const fallos = { "POST /reservas": codigo };
    const api = apiFalsa([coleccionReserva()], fallos);
    renderizarPantalla(<ContenedorFormularioReserva />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Reference");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/reserva/contenedores/formulario-reserva.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioReserva,
  aPeticionReserva,
  VistaFormularioReserva,
} from "../vistas/formulario-reserva";

type Reserva = Esquemas["DtoReserva"];

/** Crear, o editar con `id`: el formulario de reservas. */
export function ContenedorFormularioReserva({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/reservas/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear reserva" : "Editar reserva";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioReserva existente={existente.datos} />}
      <Link href={id === undefined ? "/reservas" : `/reservas/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioReserva({ existente }: { existente: Reserva | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioReserva(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionReserva(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/reservas", { body: cuerpo })
          : api.PUT("/reservas/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/reservas/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioReserva
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/reserva/contenedores/lista-reserva.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { coleccionReserva, MadreReserva } from "../../../pruebas/reserva";
import { ContenedorListaReserva } from "./lista-reserva";

describe("ContenedorListaReserva", () => {
  test("debería mostrar una fila por cada reserva", async () => {
    // Preparar
    const semilla = [MadreReserva.aleatorio(), MadreReserva.aleatorio()];
    const api = apiFalsa([coleccionReserva(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaReserva />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreReserva.aleatorio());
    const api = apiFalsa([coleccionReserva(semilla)]);
    renderizarPantalla(<ContenedorListaReserva />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreReserva.aleatorio());
    const api = apiFalsa([coleccionReserva(semilla)]);
    const ruta = "/reservas?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaReserva />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay reservas", async () => {
    // Preparar
    const api = apiFalsa([coleccionReserva()]);

    // Actuar
    renderizarPantalla(<ContenedorListaReserva />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay reservas.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /reservas": "reserva.repositorio" };
    const api = apiFalsa([coleccionReserva()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaReserva />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("reserva.repositorio");
  });
});

=== web/src/contextos/reserva/contenedores/lista-reserva.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaReserva } from "../vistas/lista-reserva";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaReserva() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const reservas = useCarga(
    () => desenvolver(api.GET("/reservas", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Reservas</h1>
        <Link href="/reservas/nuevo" className="btn btn-primary">
          Crear reserva
        </Link>
      </div>
      {reservas.estado === "cargando" && <span className="loading loading-spinner" />}
      {reservas.estado === "error" && <AlertaError error={reservas.error} />}
      {reservas.estado === "listo" &&
        (reservas.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay reservas." />
        ) : (
          <>
            <VistaListaReserva reservas={reservas.datos.elementos} />
            <Paginacion
              total={reservas.datos.total}
              limite={reservas.datos.limite}
              desplazamiento={reservas.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/reserva/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaReserva {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "reserva.validacion.reference_vacio": "Reference: obligatorio",
  "reserva.tenant_id_invalido": "Tenant id: no válido",
  "reserva.duplicado": "Estos valores ya están en uso",
  "reserva.no_encontrado": "Ya no existe",
  "reserva.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "reserva.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "reserva.validacion.reference_vacio": "reference",
  "reserva.tenant_id_invalido": "tenantId",
};

export function aProblema(codigo: string): ProblemaReserva {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

