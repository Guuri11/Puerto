use business::domain::booking::model::Booking;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct BookingDto {
    pub id: Uuid,
    pub reference: String,
    pub tenant_id: Uuid,
}

impl BookingDto {
    pub fn from_domain(entity: &Booking) -> Self {
        Self {
            id: entity.id.value(),
            reference: entity.reference.clone(),
            tenant_id: entity.tenant_id.value(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateBookingRequest {
    pub reference: String,
    pub tenant_id: Uuid,
}

/// One page of Bookings: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct BookingPageDto {
    pub items: Vec<BookingDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl BookingPageDto {
    pub fn from_domain(page: &Page<Booking>) -> Self {
        Self {
            items: page.items.iter().map(BookingDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateBookingRequest {
    pub reference: String,
    pub tenant_id: Uuid,
}

