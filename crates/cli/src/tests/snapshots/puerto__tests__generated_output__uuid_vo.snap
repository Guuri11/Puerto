use thiserror::Error;

#[derive(Debug, Error)]
pub enum BookingError {
    #[error("booking.validation_error.{0}")]
    ValidationError(String),
    #[error("booking.not_found")]
    NotFound,
    #[error("booking.duplicate")]
    Duplicate,
    #[error("booking.repository_error")]
    RepositoryError,
    #[error("booking.unknown")]
    Unknown,
    #[error("booking.invalid_tenant_id")]
    InvalidTenantId,
}

=== business/src/domain/booking/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;
use super::value_objects::TenantId;

use super::errors::BookingError;

/// The id of every `Booking`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct BookingId(Uuid);

impl BookingId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for BookingId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct BookingProps {
    pub reference: String,
    pub tenant_id: TenantId,
}

#[derive(Debug, Clone)]
pub struct Booking {
    pub id: BookingId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub reference: String,
    pub tenant_id: TenantId,
}

impl Booking {
    pub fn new(props: BookingProps) -> Result<Self, BookingError> {
        if props.reference.trim().is_empty() {
            return Err(BookingError::ValidationError("reference_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: BookingId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            reference: props.reference,
            tenant_id: props.tenant_id,
        })
    }

    pub fn from_repository(data: Booking) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_booking_when_fields_are_valid() {
        let result = Booking::new(BookingProps {
            reference: "example".to_string(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        });
        assert_eq!(result.unwrap().reference, "example");
    }


    #[test]
    fn should_reject_booking_when_reference_is_empty() {
        let result = Booking::new(BookingProps {
            reference: "".into(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "booking.validation_error.reference_empty"
        );
    }

    #[test]
    fn should_reject_booking_when_reference_is_only_whitespace() {
        let result = Booking::new(BookingProps {
            reference: "   ".into(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        });
        assert!(result.is_err());
    }
}

