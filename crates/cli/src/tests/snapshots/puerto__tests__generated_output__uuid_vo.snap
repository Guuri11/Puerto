use std::sync::Arc;

use async_trait::async_trait;
use crate::domain::booking::value_objects::TenantId;

use crate::domain::booking::{
    errors::BookingError,
    model::{Booking, BookingProps},
    repository::BookingRepositoryTrait,
    use_cases::create_booking::{CreateBookingParams, CreateBookingUseCaseTrait},
};

pub struct CreateBookingUseCaseImpl {
    pub repository: Arc<dyn BookingRepositoryTrait>,
}

#[async_trait]
impl CreateBookingUseCaseTrait for CreateBookingUseCaseImpl {
    async fn execute(&self, params: CreateBookingParams) -> Result<Booking, BookingError> {
        tracing::info!("create_booking: start");
let tenant_id = TenantId::new(params.tenant_id)?;
        let entity = Booking::new(BookingProps {
            reference: params.reference,
            tenant_id,
        }).inspect_err(|e| tracing::warn!(error = %e, "create_booking: rejected"))?;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "create_booking: repository failed"))?;
        tracing::info!(id = %entity.id, "create_booking: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::booking::repository::mocks::MockBookingRepository;
    use uuid::Uuid;


    #[tokio::test]
    async fn should_create_booking_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockBookingRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateBookingUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateBookingParams {
            reference: "example".to_string(),
            tenant_id: Uuid::new_v4(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().reference, "example");
    }

    #[tokio::test]
    async fn should_return_error_when_reference_is_empty() {
        // Arrange
        let mock_repo = MockBookingRepository::new();
        let use_case = CreateBookingUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateBookingParams {
            reference: "".to_string(),
            tenant_id: Uuid::new_v4(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "booking.validation_error.reference_empty"
        );
    }
}

=== business/src/application/booking/delete_booking.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::booking::{
    errors::BookingError,
    repository::BookingRepositoryTrait,
    use_cases::delete_booking::{DeleteBookingParams, DeleteBookingUseCaseTrait},
};

pub struct DeleteBookingUseCaseImpl {
    pub repository: Arc<dyn BookingRepositoryTrait>,
}

#[async_trait]
impl DeleteBookingUseCaseTrait for DeleteBookingUseCaseImpl {
    async fn execute(&self, params: DeleteBookingParams) -> Result<(), BookingError> {
        tracing::info!(id = %params.id, "delete_booking: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_booking: repository failed"))?
            .ok_or_else(|| {
                let err = BookingError::NotFound;
                tracing::warn!(error = %err, "delete_booking: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "delete_booking: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::booking::{
        model::{Booking, BookingId, BookingProps},
        repository::mocks::MockBookingRepository,
    };
    use uuid::Uuid;
    use crate::domain::booking::value_objects::TenantId;


    #[tokio::test]
    async fn should_soft_delete_booking_when_id_exists() {
        let entity = Booking::new(BookingProps {
            reference: "example".to_string(),
            tenant_id: TenantId::new(Uuid::new_v4()).expect("valid TenantId"),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockBookingRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteBookingUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteBookingParams { id: entity_id })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_booking_does_not_exist() {
        let mut mock_repo = MockBookingRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteBookingUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteBookingParams { id: BookingId::generate() })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "booking.not_found");
    }
}

