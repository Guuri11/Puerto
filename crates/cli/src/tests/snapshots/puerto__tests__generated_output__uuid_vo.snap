=== web/src/domain/booking/errors.ts ===
/**
 * A request about a booking that the API refused. `code` is the API's `ErrorResponse.name`:
 * `booking.not_found`, `booking.validation_error.<field>_empty`.
 */
export class BookingError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "BookingError";
    this.code = code;
  }
}

