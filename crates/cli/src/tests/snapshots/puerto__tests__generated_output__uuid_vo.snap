=== web/src/domain/reserva/errors.ts ===
/**
 * A request about a reserva that the API refused. `code` is the API's `RespuestaError.codigo`:
 * `reserva.no_encontrado`, `reserva.validacion.<field>_vacio`.
 */
export class ReservaError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "ReservaError";
    this.code = code;
  }
}

=== web/src/domain/reserva/messages.ts ===
import type { ReservaDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface ReservaProblem {
  field: keyof ReservaDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "reserva.validacion.reference_vacio": "Reference is required",
  "reserva.tenant_id_invalido": "Tenant id is not valid",
  "reserva.duplicado": "A reserva with these values already exists",
  "reserva.no_encontrado": "This reserva no longer exists",
  "reserva.repositorio": "The reserva could not be saved, try again later",
  "reserva.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof ReservaDraft> = {
  "reserva.validacion.reference_vacio": "reference",
  "reserva.tenant_id_invalido": "tenantId",
};

export function toProblem(code: string): ReservaProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

