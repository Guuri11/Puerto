#[derive(Debug, Clone, Copy, PartialEq)]
pub struct TenantId(Uuid);

impl TenantId {
    pub fn new(value: Uuid) -> Result<Self, BookingError> {
        Ok(Self(value))
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

