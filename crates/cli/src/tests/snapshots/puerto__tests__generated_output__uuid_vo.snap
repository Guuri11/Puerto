=== contextos/reserva/dominio/src/modelo.rs ===
use crate::valores::TenantId;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorReserva;

/// El id de cada `Reserva`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdReserva(Uuid);

impl IdReserva {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdReserva {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsReserva {
    pub reference: String,
    pub tenant_id: TenantId,
}

#[derive(Debug, Clone)]
pub struct Reserva {
    pub id: IdReserva,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub reference: String,
    pub tenant_id: TenantId,
}

impl Reserva {
    pub fn new(props: PropsReserva) -> Result<Self, ErrorReserva> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdReserva::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            reference: props.reference,
            tenant_id: props.tenant_id,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsReserva) -> Result<(), ErrorReserva> {
        Self::validar(&props)?;
        self.reference = props.reference;
        self.tenant_id = props.tenant_id;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Reserva) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsReserva) -> Result<(), ErrorReserva> {
        if props.reference.trim().is_empty() {
            return Err(ErrorReserva::Validacion("reference_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreReserva;

    #[test]
    fn deberia_crear_reserva_cuando_los_campos_son_validos() {
        let resultado = Reserva::new(MadreReserva::new().construir_props());
        assert_eq!(
            resultado.unwrap().reference,
            MadreReserva::new().construir_props().reference
        );
    }

    #[test]
    fn deberia_rechazar_reserva_cuando_reference_es_una_cadena_vacia() {
        let resultado = Reserva::new(MadreReserva::new().con_reference_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "reserva.validacion.reference_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_reserva_cuando_reference_solo_tiene_espacios() {
        let resultado = Reserva::new(MadreReserva::new().con_reference("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_reserva_cuando_reference_es_una_cadena_vacia() {
        let mut entidad = MadreReserva::aleatorio();
        let resultado =
            entidad.actualizar(MadreReserva::new().con_reference_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "reserva.validacion.reference_vacio"
        );
    }
}

