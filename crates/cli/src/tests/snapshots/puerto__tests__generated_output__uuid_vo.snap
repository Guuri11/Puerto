use crate::domain::booking::model::Booking;
use crate::domain::booking::model::BookingProps;
use uuid::Uuid;
use crate::domain::booking::value_objects::TenantId;

pub struct BookingMother {
    reference: Option<String>,
    tenant_id: Option<TenantId>,
}

impl BookingMother {
    pub fn new() -> Self {
        Self { reference: None, tenant_id: None }
    }

    pub fn with_reference(mut self, reference: &str) -> Self {
        self.reference = Some(reference.to_string());
        self
    }

    pub fn with_tenant_id(mut self, tenant_id: TenantId) -> Self {
        self.tenant_id = Some(tenant_id);
        self
    }

    pub fn with_empty_reference(mut self) -> Self {
        self.reference = Some(String::new());
        self
    }

    pub fn build(self) -> Booking {
        Booking::new(BookingProps {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            tenant_id: self.tenant_id.unwrap_or_else(|| TenantId::new(Uuid::new_v4()).expect("valid TenantId")),
        })
        .expect("BookingMother: failed to build valid Booking")
    }

    pub fn build_props(self) -> BookingProps {
        BookingProps {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            tenant_id: self.tenant_id.unwrap_or_else(|| TenantId::new(Uuid::new_v4()).expect("valid TenantId")),
        }
    }

    pub fn random() -> Booking {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Booking> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for BookingMother {
    fn default() -> Self {
        Self::new()
    }
}

