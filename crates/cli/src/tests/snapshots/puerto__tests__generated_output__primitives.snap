#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::{
        model::{Product, ProductProps},
        repository::mocks::MockProductRepository,
    };
    use chrono::Utc;
    use std::collections::HashMap;
    use uuid::Uuid;


    #[tokio::test]
    async fn should_return_all_products() {
        let entities = vec![
            Product::new(ProductProps {
            title: "first".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
        }).unwrap(),
            Product::new(ProductProps {
            title: "second".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
        }).unwrap(),
        ];
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListProductsParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_products_exist() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListProductsParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

=== business/src/application/product/update_product.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    model::Product,
    repository::ProductRepositoryTrait,
    use_cases::update_product::{UpdateProductParams, UpdateProductUseCaseTrait},
};

pub struct UpdateProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl UpdateProductUseCaseTrait for UpdateProductUseCaseImpl {
    async fn execute(&self, params: UpdateProductParams) -> Result<Product, ProductError> {
        tracing::info!(id = %params.id, "update_product: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_product: repository failed"))?
            .ok_or_else(|| {
                let err = ProductError::NotFound;
                tracing::warn!(error = %err, "update_product: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = ProductError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_product: rejected");
            return Err(err);
        }
        entity.title = params.title;
        entity.price = params.price;
        entity.in_stock = params.in_stock;
        entity.rate = params.rate;
        entity.released_at = params.released_at;
        entity.meta = params.meta;
        entity.category_id = params.category_id;
        entity.updated_at = chrono::Utc::now();
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "update_product: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::{
        model::{Product, ProductProps},
        repository::mocks::MockProductRepository,
    };
    use uuid::Uuid;
    use chrono::Utc;
    use std::collections::HashMap;


    #[tokio::test]
    async fn should_update_product_when_params_are_valid() {
        // Arrange
        let entity = Product::new(ProductProps {
            title: "original".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
            id: entity_id,
            title: "updated".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().title, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_product_does_not_exist() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
            id: Uuid::new_v4(),
            title: "new".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            title: "original".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
            id: entity_id,
            title: "".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.title_empty"
        );
    }
}

