use crate::domain::product::model::Product;
use crate::domain::product::model::ProductProps;
use chrono::{DateTime, Utc};
use std::collections::HashMap;
use uuid::Uuid;

pub struct ProductMother {
    title: Option<String>,
    price: Option<i64>,
    in_stock: Option<bool>,
    rate: Option<f64>,
    released_at: Option<DateTime<Utc>>,
    meta: Option<HashMap<String, String>>,
    category_id: Option<Uuid>,
}

impl ProductMother {
    pub fn new() -> Self {
        Self { title: None, price: None, in_stock: None, rate: None, released_at: None, meta: None, category_id: None }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn with_in_stock(mut self, in_stock: bool) -> Self {
        self.in_stock = Some(in_stock);
        self
    }

    pub fn with_rate(mut self, rate: f64) -> Self {
        self.rate = Some(rate);
        self
    }

    pub fn with_released_at(mut self, released_at: DateTime<Utc>) -> Self {
        self.released_at = Some(released_at);
        self
    }

    pub fn with_meta(mut self, meta: HashMap<String, String>) -> Self {
        self.meta = Some(meta);
        self
    }

    pub fn with_category_id(mut self, category_id: Uuid) -> Self {
        self.category_id = Some(category_id);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn build(self) -> Product {
        Product::new(ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            in_stock: self.in_stock.unwrap_or(true),
            rate: self.rate.unwrap_or(1.5),
            released_at: self.released_at.unwrap_or_else(Utc::now),
            meta: self.meta.unwrap_or_default(),
            category_id: self.category_id.unwrap_or_else(Uuid::new_v4),
        })
        .expect("ProductMother: failed to build valid Product")
    }

    pub fn build_props(self) -> ProductProps {
        ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            in_stock: self.in_stock.unwrap_or(true),
            rate: self.rate.unwrap_or(1.5),
            released_at: self.released_at.unwrap_or_else(Utc::now),
            meta: self.meta.unwrap_or_default(),
            category_id: self.category_id.unwrap_or_else(Uuid::new_v4),
        }
    }

    pub fn random() -> Product {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Product> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for ProductMother {
    fn default() -> Self {
        Self::new()
    }
}

