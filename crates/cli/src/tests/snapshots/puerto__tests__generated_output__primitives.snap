// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;
use business::application::product::create_product::CreateProductUseCaseImpl;
use business::application::product::get_product::GetProductUseCaseImpl;
use business::application::product::list_products::ListProductsUseCaseImpl;
use business::application::product::update_product::UpdateProductUseCaseImpl;
use business::application::product::delete_product::DeleteProductUseCaseImpl;

use business::domain::greeting::repository::GreetingRepositoryTrait;
use infrastructure::greeting::repository::InMemoryGreetingRepository;
use business::domain::product::repository::ProductRepositoryTrait;
use infrastructure::product::repository::InMemoryProductRepository;

use poem::{EndpointExt, Route, get, middleware::{Cors, Tracing}};
use poem_openapi::OpenApiService;

use crate::api::greeting::routes::GreetingApi;
use crate::api::product::routes::ProductApi;

pub async fn build_app() -> impl poem::Endpoint {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl { repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait> });
    let greeting_api = GreetingApi { get_greeting };

    let product_repo: Arc<dyn ProductRepositoryTrait> = Arc::new(InMemoryProductRepository::new());
    let create_product = Arc::new(CreateProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let get_product = Arc::new(GetProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let list_products = Arc::new(ListProductsUseCaseImpl { repository: Arc::clone(&product_repo) });
    let update_product = Arc::new(UpdateProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let delete_product = Arc::new(DeleteProductUseCaseImpl { repository: product_repo });
    let product_api = ProductApi { create_product, get_product, list_products, update_product, delete_product };

    let port = std::env::var("SERVICE_PORT").unwrap_or_else(|_| "8080".to_string());
    let api_service = OpenApiService::new(
        (greeting_api, product_api),
        env!("CARGO_PKG_NAME"),
        env!("CARGO_PKG_VERSION"),
    )
    .server(format!("http://localhost:{port}/api"));
    let ui = api_service.swagger_ui();

    let cors_origins = std::env::var("CORS_ALLOWED_ORIGINS").unwrap_or_default();
    let mut cors = Cors::new();
    for origin in cors_origins.split(',').map(str::trim).filter(|s| !s.is_empty()) {
        cors = cors.allow_origin(origin);
    }

    Route::new()
        .at("/health", get(crate::health::liveness))
        .at(
            "/health/ready",
            get(poem::endpoint::make_sync(|_| crate::health::readiness(true))),
        )
        .nest("/api", api_service)
        .nest("/", ui)
        .with(Tracing)
        .with(cors)
}

