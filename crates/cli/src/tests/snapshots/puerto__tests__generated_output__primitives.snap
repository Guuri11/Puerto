=== presentation/src/api/product/routes.rs ===
use std::sync::Arc;

use business::domain::product::use_cases::{
    create_product::{CreateProductParams, CreateProductUseCaseTrait},
    delete_product::{DeleteProductParams, DeleteProductUseCaseTrait},
    get_product::{GetProductParams, GetProductUseCaseTrait},
    list_products::{ListProductsParams, ListProductsUseCaseTrait},
    update_product::{UpdateProductParams, UpdateProductUseCaseTrait},
};
use poem_openapi::{OpenApi, param::Path, payload::Json};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::product::dto::{CreateProductRequest, UpdateProductRequest, ProductDto};
use crate::api::product::responses::{
    CreateProductResponse, DeleteProductResponse, GetProductResponse, ListProductsResponse,
    UpdateProductResponse,
};

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct ProductApi {
    pub create_product: Arc<dyn CreateProductUseCaseTrait>,
    pub get_product: Arc<dyn GetProductUseCaseTrait>,
    pub list_products: Arc<dyn ListProductsUseCaseTrait>,
    pub update_product: Arc<dyn UpdateProductUseCaseTrait>,
    pub delete_product: Arc<dyn DeleteProductUseCaseTrait>,
}

#[OpenApi]
impl ProductApi {
    /// Create a new Product
    #[oai(path = "/products", method = "post", tag = "ApiTags::Product")]
    async fn create(&self, body: Json<CreateProductRequest>) -> CreateProductResponse {
        match self
            .create_product
            .execute(CreateProductParams {
                title: body.title.clone(),
                price: body.price,
                in_stock: body.in_stock,
                rate: body.rate,
                released_at: body.released_at,
                meta: body.meta.clone(),
                category_id: body.category_id,
            })
            .await
        {
            Ok(entity) => CreateProductResponse::Created(Json(ProductDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_product failed");
                CreateProductResponse::from_status(status, error)
            }
        }
    }

    /// Get a Product by ID
    #[oai(path = "/products/:id", method = "get", tag = "ApiTags::Product")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetProductResponse {
        match self
            .get_product
            .execute(GetProductParams { id: id.0 })
            .await
        {
            Ok(entity) => GetProductResponse::Ok(Json(ProductDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_product failed");
                GetProductResponse::from_status(status, error)
            }
        }
    }

    /// List all Products
    #[oai(path = "/products", method = "get", tag = "ApiTags::Product")]
    async fn list(&self) -> ListProductsResponse {
        match self.list_products.execute(ListProductsParams).await {
            Ok(entities) => {
                ListProductsResponse::Ok(Json(entities.iter().map(ProductDto::from_domain).collect()))
            }
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_products failed");
                ListProductsResponse::from_status(status, error)
            }
        }
    }

    /// Update a Product
    #[oai(path = "/products/:id", method = "put", tag = "ApiTags::Product")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateProductRequest>) -> UpdateProductResponse {
        match self
            .update_product
            .execute(UpdateProductParams {
                id: id.0,
                title: body.title.clone(),
                price: body.price,
                in_stock: body.in_stock,
                rate: body.rate,
                released_at: body.released_at,
                meta: body.meta.clone(),
                category_id: body.category_id,
            })
            .await
        {
            Ok(entity) => UpdateProductResponse::Ok(Json(ProductDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_product failed");
                UpdateProductResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Product
    #[oai(path = "/products/:id", method = "delete", tag = "ApiTags::Product")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteProductResponse {
        match self
            .delete_product
            .execute(DeleteProductParams { id: id.0 })
            .await
        {
            Ok(()) => DeleteProductResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_product failed");
                DeleteProductResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::product::errors::ProductError;
    use business::domain::product::use_cases::{
        create_product::mocks::MockCreateProductUseCase, delete_product::mocks::MockDeleteProductUseCase,
        get_product::mocks::MockGetProductUseCase, list_products::mocks::MockListProductsUseCase,
        update_product::mocks::MockUpdateProductUseCase,
    };
    use business::tests::mothers::product_mother::ProductMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use chrono::Utc;
    use std::collections::HashMap;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateProductUseCase,
        get: MockGetProductUseCase,
        list: MockListProductsUseCase,
        update: MockUpdateProductUseCase,
        delete: MockDeleteProductUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = ProductApi {
                create_product: Arc::new(self.create),
                get_product: Arc::new(self.get),
                list_products: Arc::new(self.list),
                update_product: Arc::new(self.update),
                delete_product: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateProductRequest {
        CreateProductRequest {
            title: "example".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
        }
    }

    fn update_request() -> UpdateProductRequest {
        UpdateProductRequest {
            title: "example".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
        }
    }

    fn item_path() -> String {
        format!("/products/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_product_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| Ok(ProductMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/products")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_product_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(ProductError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/products")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_product_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Ok(ProductMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_product_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Err(ProductError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_every_product_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Ok(ProductMother::random_vec(2)));

        // Act
        let response = mocks.client().get("/products").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        response.json().await.value().array().assert_len(2);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Err(ProductError::RepositoryError));

        // Act
        let response = mocks.client().get("/products").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_product_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Ok(ProductMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_product() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Err(ProductError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_product_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_product() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Err(ProductError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

