use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    model::Product,
    repository::ProductRepositoryTrait,
    use_cases::list_products::{ListProductsParams, ListProductsUseCaseTrait},
};

pub struct ListProductsUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl ListProductsUseCaseTrait for ListProductsUseCaseImpl {
    async fn execute(&self, _params: ListProductsParams) -> Result<Vec<Product>, ProductError> {
        tracing::info!("list_products: start");
        self.repository.find_all().await.inspect_err(|e| tracing::error!(error = %e, "list_products: repository failed"))
    }
