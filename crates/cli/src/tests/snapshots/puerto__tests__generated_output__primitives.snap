=== business/src/application/product/create_product.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    model::{Product, ProductProps},
    repository::ProductRepositoryTrait,
    use_cases::create_product::{CreateProductParams, CreateProductUseCaseTrait},
};

pub struct CreateProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl CreateProductUseCaseTrait for CreateProductUseCaseImpl {
    async fn execute(&self, params: CreateProductParams) -> Result<Product, ProductError> {
        tracing::info!("create_product: start");
        let entity = Product::new(ProductProps {
            title: params.title,
            price: params.price,
            in_stock: params.in_stock,
            rate: params.rate,
            released_at: params.released_at,
            meta: params.meta,
            category_id: params.category_id,
        }).inspect_err(|e| tracing::warn!(error = %e, "create_product: rejected"))?;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "create_product: repository failed"))?;
        tracing::info!(id = %entity.id, "create_product: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::repository::mocks::MockProductRepository;
    use chrono::Utc;
    use std::collections::HashMap;
    use uuid::Uuid;


    #[tokio::test]
    async fn should_create_product_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
            title: "example".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let mock_repo = MockProductRepository::new();
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
            title: "".to_string(),
            price: 42,
            in_stock: true,
            rate: 1.5,
            released_at: Utc::now(),
            meta: HashMap::new(),
            category_id: Uuid::new_v4(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.title_empty"
        );
    }
}

