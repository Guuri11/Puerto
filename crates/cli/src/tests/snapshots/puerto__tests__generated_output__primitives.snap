use async_trait::async_trait;
use uuid::Uuid;

use business::domain::product::{
    errors::ProductError,
    model::Product,
    repository::ProductRepositoryTrait,
};

/// A stand-in that stores nothing — replace it with a real adapter (`puerto new --db` generates
/// Postgres repositories).
#[derive(Default)]
pub struct InMemoryProductRepository;

impl InMemoryProductRepository {
    pub fn new() -> Self {
        Self
    }
}

#[async_trait]
impl ProductRepositoryTrait for InMemoryProductRepository {
    async fn find_all(&self) -> Result<Vec<Product>, ProductError> {
        tracing::debug!("find_all");
        Ok(vec![])
    }

    async fn find_by_id(&self, id: Uuid) -> Result<Option<Product>, ProductError> {
        tracing::debug!(%id, "find_by_id");
        Ok(None)
    }

    async fn save(&self, entity: &Product) -> Result<(), ProductError> {
        tracing::debug!(id = %entity.id, "save");
        Ok(())
    }
}

