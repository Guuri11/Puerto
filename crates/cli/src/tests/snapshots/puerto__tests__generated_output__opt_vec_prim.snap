import { Link } from "wouter";
import type { Article } from "../../../../domain/article/model";

export function ArticleListView({ articles }: { articles: Article[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Summary</th>
            <th>Views</th>
            <th>Tags</th>
            <th>Scores</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {articles.map((article) => (
            <tr key={article.id}>
              <td>{article.title}</td>
              <td>{article.summary ?? "—"}</td>
              <td>{article.views ?? "—"}</td>
              <td>{article.tags.join(", ")}</td>
              <td>{article.scores.join(", ")}</td>
              <td className="text-right">
                <Link href={`/articles/${article.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/article.ts ===
import { ArticleError } from "../domain/article/errors";
import type { Article, ArticleDraft } from "../domain/article/model";
import type { ArticleRepository } from "../domain/article/repository";

/** Valid articles for tests; pass `overrides` for the fields a test is about. */
export const ArticleMother = {
  draft(overrides: Partial<ArticleDraft> = {}): ArticleDraft {
    return {
      title: "example",
      summary: "example",
      views: 42,
      tags: ["example"],
      scores: [42],
      ...overrides,
    };
  },

  random(overrides: Partial<Article> = {}): Article {
    return { id: crypto.randomUUID(), ...ArticleMother.draft(), ...overrides };
  },
};

/** An in-memory `ArticleRepository`. Override a method to make it fail. */
export function fakeArticleRepository(seed: Article[] = []): ArticleRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new ArticleError("article.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
