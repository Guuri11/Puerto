=== business/src/tests/mothers/article_mother.rs ===
use crate::domain::article::model::Article;
use crate::domain::article::model::ArticleProps;

pub struct ArticleMother {
    title: Option<String>,
    summary: Option<String>,
    views: Option<i64>,
    tags: Option<Vec<String>>,
    scores: Option<Vec<i64>>,
}

impl ArticleMother {
    pub fn new() -> Self {
        Self { title: None, summary: None, views: None, tags: None, scores: None }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_summary(mut self, summary: &str) -> Self {
        self.summary = Some(summary.to_string());
        self
    }

    pub fn with_views(mut self, views: i64) -> Self {
        self.views = Some(views);
        self
    }

    pub fn with_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn with_scores(mut self, scores: Vec<i64>) -> Self {
        self.scores = Some(scores);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn build(self) -> Article {
        Article::new(ArticleProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
        })
        .expect("ArticleMother: failed to build valid Article")
    }

    pub fn build_props(self) -> ArticleProps {
        ArticleProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
        }
    }

    pub fn random() -> Article {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Article> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for ArticleMother {
    fn default() -> Self {
        Self::new()
    }
}

