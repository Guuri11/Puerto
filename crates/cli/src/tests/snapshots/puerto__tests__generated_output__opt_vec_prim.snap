=== contextos/article/dominio/src/modelo.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorArticle;

/// El id de cada `Article`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdArticle(Uuid);

impl IdArticle {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdArticle {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsArticle {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

#[derive(Debug, Clone)]
pub struct Article {
    pub id: IdArticle,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

impl Article {
    pub fn new(props: PropsArticle) -> Result<Self, ErrorArticle> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdArticle::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            title: props.title,
            summary: props.summary,
            views: props.views,
            tags: props.tags,
            scores: props.scores,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsArticle) -> Result<(), ErrorArticle> {
        Self::validar(&props)?;
        self.title = props.title;
        self.summary = props.summary;
        self.views = props.views;
        self.tags = props.tags;
        self.scores = props.scores;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Article) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsArticle) -> Result<(), ErrorArticle> {
        if props.title.trim().is_empty() {
            return Err(ErrorArticle::Validacion("title_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_crear_article_cuando_los_campos_son_validos() {
        let resultado = Article::new(PropsArticle {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert_eq!(resultado.unwrap().title, "example");
    }

    #[test]
    fn deberia_rechazar_article_cuando_title_es_una_cadena_vacia() {
        let resultado = Article::new(PropsArticle {
            title: "".into(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "article.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_article_cuando_title_solo_tiene_espacios() {
        let resultado = Article::new(PropsArticle {
            title: "   ".into(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_article_cuando_title_es_una_cadena_vacia() {
        let mut entidad = Article::new(PropsArticle {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        })
        .unwrap();
        let resultado = entidad.actualizar(PropsArticle {
            title: "".into(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "article.validacion.title_vacio"
        );
    }
}

