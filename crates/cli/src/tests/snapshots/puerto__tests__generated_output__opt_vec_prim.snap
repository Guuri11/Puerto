use async_trait::async_trait;
use business::domain::article::{
    model::{Article, ArticleId},
    repository::ArticleRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// A stand-in that stores nothing — replace it with a real adapter (`puerto new --db` generates
/// Postgres repositories).
#[derive(Default)]
pub struct InMemoryArticleRepository;

impl InMemoryArticleRepository {
    pub fn new() -> Self {
        Self
    }
}

#[async_trait]
impl ArticleRepositoryTrait for InMemoryArticleRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Article>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        Ok(Page::new(vec![], 0, page))
    }

    async fn find_by_id(&self, id: ArticleId) -> Result<Option<Article>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(None)
    }

    async fn save(&self, entity: &Article) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        Ok(())
    }
}

