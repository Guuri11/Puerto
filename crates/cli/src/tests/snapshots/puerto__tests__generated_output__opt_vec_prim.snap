use async_trait::async_trait;
use uuid::Uuid;

use super::{errors::ArticleError, model::Article};

#[async_trait]
pub trait ArticleRepositoryTrait: Send + Sync {
    async fn find_all(&self) -> Result<Vec<Article>, ArticleError>;
    async fn find_by_id(&self, id: Uuid) -> Result<Option<Article>, ArticleError>;
    async fn save(&self, entity: &Article) -> Result<(), ArticleError>;
}

#[cfg(any(test, feature = "test-utils"))]
