import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ArticleMother, fakeArticleRepository } from "../../../../test-support/article";
import { renderScreen } from "../../../../test-support/render";
import { ArticleDetailContainer } from "./article-detail-container";

describe("ArticleDetailContainer", () => {
  test("should show the article when it exists", async () => {
    // Arrange
    const seeded = ArticleMother.random();
    const articleRepository = fakeArticleRepository([seeded]);

    // Act
    renderScreen(<ArticleDetailContainer id={seeded.id} />, { articleRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the article does not exist", async () => {
    // Arrange
    const articleRepository = fakeArticleRepository();

    // Act
    renderScreen(<ArticleDetailContainer id={crypto.randomUUID()} />, { articleRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("article.not_found");
  });

  test("should delete the article only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ArticleMother.random();
    const fake = fakeArticleRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<ArticleDetailContainer id={seeded.id} />, {
      articleRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/articles"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/article/containers/article-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ArticleDetailView } from "../views/article-detail-view";

export function ArticleDetailContainer({ id }: { id: string }) {
  const { articleRepository } = useDependencies();
  const article = useAsync(() => articleRepository.get(id), [articleRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await articleRepository.remove(id);
      navigate("/articles");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Article</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {article.status === "loading" && <span className="loading loading-spinner" />}
      {article.status === "error" && <ErrorAlert error={article.error} />}
      {article.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ArticleDetailView article={article.data} />
            <div className="card-actions justify-end">
              <Link href={`/articles/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/articles" className="link">
        Back to articles
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this article?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/article/containers/article-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ArticleError } from "../../../../domain/article/errors";
import type { ArticleDraft } from "../../../../domain/article/model";
import { ArticleMother, fakeArticleRepository } from "../../../../test-support/article";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { ArticleFormContainer } from "./article-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ArticleDraft) {
  await screen.findByText("Save");
  type("Title", draft.title);
  type("Summary", textOf(draft.summary));
  type("Views", textOf(draft.views));
  type("Tags", draft.tags.join(", "));
  type("Scores", draft.scores.join(", "));
}

describe("ArticleFormContainer", () => {
  test("should create the article from what was typed and show it", async () => {
    // Arrange
    const draft = ArticleMother.draft();
    const articleRepository = fakeArticleRepository();
    const { history } = renderScreen(<ArticleFormContainer />, { articleRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/articles/"));
    const {
      items: [created],
    } = await articleRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/articles/${created?.id}`);
  });

  test("should save the edited article when an existing one is submitted", async () => {
    // Arrange
    const seeded = ArticleMother.random();
    const articleRepository = fakeArticleRepository([seeded]);
    const { history } = renderScreen(<ArticleFormContainer id={seeded.id} />, {
      articleRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/articles/${seeded.id}`));
    expect(await articleRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the validation code when the API rejects the article", async () => {
    // Arrange
    const code = "article.validation_error.invalid";
    const articleRepository = {
      ...fakeArticleRepository(),
      create: () => Promise.reject(new ArticleError(code)),
    };
    renderScreen(<ArticleFormContainer />, { articleRepository });
    await fillIn(ArticleMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });
});

=== web/src/presentation/features/article/containers/article-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Article } from "../../../../domain/article/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ArticleFormView, toArticleDraft, toArticleForm } from "../views/article-form-view";

/** Creates an article, or edits the one with `id`. */
export function ArticleFormContainer({ id }: { id?: string }) {
  const { articleRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : articleRepository.get(id)),
    [articleRepository, id],
  );
  const title = id === undefined ? "New article" : "Edit article";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ArticleForm existing={existing.data} />}
      <Link href={id === undefined ? "/articles" : `/articles/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ArticleForm({ existing }: { existing: Article | null }) {
  const { articleRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toArticleForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toArticleDraft(values);
      const saved =
        existing === null
          ? await articleRepository.create(draft)
          : await articleRepository.update(existing.id, draft);
      navigate(`/articles/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {failure !== null && <ErrorAlert error={failure} />}
        <ArticleFormView values={values} saving={saving} onChange={setValues} onSubmit={save} />
      </div>
    </div>
  );
}

=== web/src/presentation/features/article/containers/article-list-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { ArticleError } from "../../../../domain/article/errors";
import { ArticleMother, fakeArticleRepository } from "../../../../test-support/article";
import { renderScreen } from "../../../../test-support/render";
import { ArticleListContainer } from "./article-list-container";

describe("ArticleListContainer", () => {
  test("should show a row per article when there are some", async () => {
    // Arrange
    const seed = [ArticleMother.random(), ArticleMother.random()];
    const articleRepository = fakeArticleRepository(seed);

    // Act
    renderScreen(<ArticleListContainer />, { articleRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ArticleMother.random());
    const articleRepository = fakeArticleRepository(seed);
    renderScreen(<ArticleListContainer />, { articleRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should say so when there is no article", async () => {
    // Arrange
    const articleRepository = fakeArticleRepository();

    // Act
    renderScreen(<ArticleListContainer />, { articleRepository });

    // Assert
    expect(await screen.findByText("No articles yet.")).toBeTruthy();
  });

  test("should show the error code when the articles cannot be listed", async () => {
    // Arrange
    const articleRepository = {
      ...fakeArticleRepository(),
      list: () => Promise.reject(new ArticleError("article.repository_error")),
    };

    // Act
    renderScreen(<ArticleListContainer />, { articleRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("article.repository_error");
  });
});

=== web/src/presentation/features/article/containers/article-list-container.tsx ===
import { useState } from "react";
import { Link } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { Pagination } from "../../../shared/ui/pagination";
import { ArticleListView } from "../views/article-list-view";

export function ArticleListContainer() {
  const { articleRepository } = useDependencies();
  const [offset, setOffset] = useState(0);
  const articles = useAsync(
    () => articleRepository.list({ limit: PAGE_SIZE, offset }),
    [articleRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Articles</h1>
        <Link href="/articles/new" className="btn btn-primary">
          New article
        </Link>
      </div>
      {articles.status === "loading" && <span className="loading loading-spinner" />}
      {articles.status === "error" && <ErrorAlert error={articles.error} />}
      {articles.status === "ok" &&
        (articles.data.total === 0 ? (
          <EmptyState message="No articles yet." />
        ) : (
          <>
            <ArticleListView articles={articles.data.items} />
            <Pagination {...articles.data} onOffsetChange={setOffset} />
          </>
        ))}
    </section>
  );
}

