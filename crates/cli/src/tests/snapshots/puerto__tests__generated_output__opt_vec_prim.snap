export interface Article {
  id: string;
  title: string;
  summary: string | null;
  views: number | null;
  tags: string[];
  scores: number[];
}

/** What a create or an update sends: an article without its id. */
export type ArticleDraft = Omit<Article, "id">;

=== web/src/domain/article/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Article, ArticleDraft } from "./model";

/** The port the screens call. Every method rejects with the `ArticleError` the API answered. */
export interface ArticleRepository {
  list(page: PageRequest): Promise<Page<Article>>;
  get(id: string): Promise<Article>;
  create(draft: ArticleDraft): Promise<Article>;
  update(id: string, draft: ArticleDraft): Promise<Article>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/article/article-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { ArticleError } from "../../domain/article/errors";
import { ArticleMother } from "../../test-support/article";
import { createApiClient } from "../http/client";
import { articleRepositoryHttp } from "./article-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: articleRepositoryHttp(api), requests };
}

describe("articleRepositoryHttp", () => {
  test("should ask for the page and return its articles", async () => {
    // Arrange
    const article = ArticleMother.random();
    const page = { items: [article], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/articles?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating an article", async () => {
    // Arrange
    const draft = ArticleMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the article does not exist", async () => {
    // Arrange
    const code = "article.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(ArticleError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the article", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/articles/42");
  });
});

=== web/src/infrastructure/article/article-repository-http.ts ===
import { ArticleError } from "../../domain/article/errors";
import type { Article, ArticleDraft } from "../../domain/article/model";
import type { ArticleRepository } from "../../domain/article/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ArticleDto = components["schemas"]["ArticleDto"];
type ArticleRequest = components["schemas"]["CreateArticleRequest"];

function toArticle(dto: ArticleDto): Article {
  return {
    id: dto.id,
    title: dto.title,
    summary: dto.summary ?? null,
    views: dto.views ?? null,
    tags: dto.tags,
    scores: dto.scores,
  };
}

function toRequest(draft: ArticleDraft): ArticleRequest {
  return {
    title: draft.title,
    summary: draft.summary ?? undefined,
    views: draft.views ?? undefined,
    tags: draft.tags,
    scores: draft.scores,
  };
}

/** `ArticleRepository` over the REST API (`/articles`). */
export function articleRepositoryHttp(api: ApiClient): ArticleRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/articles", {
        params: { query: page },
      });
      if (data === undefined) throw new ArticleError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toArticle) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/articles/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ArticleError(apiErrorCode(error, response));
      return toArticle(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/articles", { body: toRequest(draft) });
      if (data === undefined) throw new ArticleError(apiErrorCode(error, response));
      return toArticle(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/articles/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ArticleError(apiErrorCode(error, response));
      return toArticle(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/articles/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ArticleError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

