=== contextos/article/dominio/src/modelo.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorArticle;

/// El id de cada `Article`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdArticle(Uuid);

impl IdArticle {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdArticle {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsArticle {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

#[derive(Debug, Clone)]
pub struct Article {
    pub id: IdArticle,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

impl Article {
    pub fn new(props: PropsArticle) -> Result<Self, ErrorArticle> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdArticle::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            title: props.title,
            summary: props.summary,
            views: props.views,
            tags: props.tags,
            scores: props.scores,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsArticle) -> Result<(), ErrorArticle> {
        Self::validar(&props)?;
        self.title = props.title;
        self.summary = props.summary;
        self.views = props.views;
        self.tags = props.tags;
        self.scores = props.scores;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Article) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsArticle) -> Result<(), ErrorArticle> {
        if props.title.trim().is_empty() {
            return Err(ErrorArticle::Validacion("title_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreArticle;

    #[test]
    fn deberia_crear_article_cuando_los_campos_son_validos() {
        let resultado = Article::new(MadreArticle::new().construir_props());
        assert_eq!(
            resultado.unwrap().title,
            MadreArticle::new().construir_props().title
        );
    }

    #[test]
    fn deberia_rechazar_article_cuando_title_es_una_cadena_vacia() {
        let resultado = Article::new(MadreArticle::new().con_title_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "article.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_article_cuando_title_solo_tiene_espacios() {
        let resultado = Article::new(MadreArticle::new().con_title("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_article_cuando_title_es_una_cadena_vacia() {
        let mut entidad = MadreArticle::aleatorio();
        let resultado = entidad.actualizar(MadreArticle::new().con_title_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "article.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_marcar_article_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreArticle::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

=== contextos/article/dominio/src/pruebas/madres.rs ===
use crate::modelo::Article;
use crate::modelo::PropsArticle;

pub struct MadreArticle {
    title: Option<String>,
    summary: Option<String>,
    views: Option<i64>,
    tags: Option<Vec<String>>,
    scores: Option<Vec<i64>>,
}

impl MadreArticle {
    pub fn new() -> Self {
        Self {
            title: None,
            summary: None,
            views: None,
            tags: None,
            scores: None,
        }
    }

    pub fn con_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn con_summary(mut self, summary: &str) -> Self {
        self.summary = Some(summary.to_string());
        self
    }

    pub fn con_views(mut self, views: i64) -> Self {
        self.views = Some(views);
        self
    }

    pub fn con_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn con_scores(mut self, scores: Vec<i64>) -> Self {
        self.scores = Some(scores);
        self
    }

    pub fn con_title_vacio(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn construir(self) -> Article {
        Article::new(PropsArticle {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
        })
        .expect("MadreArticle: Article::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsArticle {
        PropsArticle {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
        }
    }

    pub fn aleatorio() -> Article {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Article> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreArticle {
    fn default() -> Self {
        Self::new()
    }
}

