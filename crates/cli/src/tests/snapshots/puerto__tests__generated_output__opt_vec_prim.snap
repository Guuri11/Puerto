use async_trait::async_trait;
use dominio_article::errores::ErrorArticle;
use dominio_article::modelo::Article;
use dominio_article::repositorio::RepositorioArticle;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarArticles {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarArticles: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarArticles)
    -> Result<Pagina<Article>, ErrorArticle>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarArticles {}

        #[async_trait]
        impl ListarArticles for ListarArticles {
            async fn ejecutar(&self, params: ParamsListarArticles) -> Result<Pagina<Article>, ErrorArticle>;
        }
    }
}

pub struct ListarArticlesImpl {
    pub repositorio: Arc<dyn RepositorioArticle>,
}

#[async_trait]
impl ListarArticles for ListarArticlesImpl {
    #[tracing::instrument(name = "listar_articles", skip_all, err(level = "warn"))]
    async fn ejecutar(
        &self,
        params: ParamsListarArticles,
    ) -> Result<Pagina<Article>, ErrorArticle> {
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .map_err(ErrorArticle::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_article::{
        pruebas::madres::MadreArticle, repositorio::dobles::MockRepositorioArticle,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_articles() {
        let entidades = MadreArticle::aleatorios(2);
        let mut repositorio_doble = MockRepositorioArticle::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarArticlesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarArticles {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_articles() {
        let mut repositorio_doble = MockRepositorioArticle::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarArticlesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarArticles {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioArticle::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarArticlesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarArticles {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

