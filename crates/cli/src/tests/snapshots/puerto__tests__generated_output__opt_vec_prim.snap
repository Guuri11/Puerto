=== contextos/article/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorArticle {
    #[error("article.validacion.{0}")]
    Validacion(String),
    #[error("article.no_encontrado")]
    NoEncontrado,
    #[error("article.duplicado")]
    Duplicado,
    #[error("article.repositorio")]
    Repositorio,
    #[error("article.desconocido")]
    Desconocido,
}

impl From<ErrorRepositorio> for ErrorArticle {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorArticle::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "article.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorArticle::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "article.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorArticle::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "article.repositorio");
    }
}

