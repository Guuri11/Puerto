=== business/src/application/article/create_article.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::article::{
    errors::ArticleError,
    model::{Article, ArticleProps},
    repository::ArticleRepositoryTrait,
    use_cases::create_article::{CreateArticleParams, CreateArticleUseCaseTrait},
};

pub struct CreateArticleUseCaseImpl {
    pub repository: Arc<dyn ArticleRepositoryTrait>,
}

#[async_trait]
impl CreateArticleUseCaseTrait for CreateArticleUseCaseImpl {
    async fn execute(&self, params: CreateArticleParams) -> Result<Article, ArticleError> {
        tracing::info!("create_article: start");
        let entity = Article::new(ArticleProps {
            title: params.title,
            summary: params.summary,
            views: params.views,
            tags: params.tags,
            scores: params.scores,
        }).inspect_err(|e| tracing::warn!(error = %e, "create_article: rejected"))?;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "create_article: repository failed"))?;
        tracing::info!(id = %entity.id, "create_article: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::article::repository::mocks::MockArticleRepository;


    #[tokio::test]
    async fn should_create_article_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockArticleRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateArticleParams {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let mock_repo = MockArticleRepository::new();
        let use_case = CreateArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateArticleParams {
            title: "".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "article.validation_error.title_empty"
        );
    }
}

