    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

impl DtoArticle {
    pub fn from_dominio(entidad: &Article) -> Self {
        Self {
            id: entidad.id.valor(),
            title: entidad.title.clone(),
            summary: entidad.summary.clone(),
            views: entidad.views,
            tags: entidad.tags.clone(),
            scores: entidad.scores.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearArticle {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

/// Una página de Articles: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaArticle {
    pub elementos: Vec<DtoArticle>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaArticle {
    pub fn from_dominio(pagina: &Pagina<Article>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoArticle::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
