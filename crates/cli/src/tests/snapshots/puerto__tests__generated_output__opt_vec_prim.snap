=== contextos/article/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_article::{
    actualizar_article::{ActualizarArticle, ParamsActualizarArticle},
    borrar_article::{BorrarArticle, ParamsBorrarArticle},
    crear_article::{CrearArticle, ParamsCrearArticle},
    listar_articles::{ListarArticles, ParamsListarArticles},
    obtener_article::{ObtenerArticle, ParamsObtenerArticle},
};
use dominio_article::modelo::IdArticle;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoArticle, DtoPaginaArticle, PeticionActualizarArticle, PeticionCrearArticle};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarArticle, RespuestaBorrarArticle, RespuestaCrearArticle,
    RespuestaListarArticles, RespuestaObtenerArticle,
};

#[derive(Tags)]
enum ApiTags {
    Article,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiArticle {
    pub crear_article: Arc<dyn CrearArticle>,
    pub obtener_article: Arc<dyn ObtenerArticle>,
    pub listar_articles: Arc<dyn ListarArticles>,
    pub actualizar_article: Arc<dyn ActualizarArticle>,
    pub borrar_article: Arc<dyn BorrarArticle>,
}

#[OpenApi]
impl ApiArticle {
    /// Crea: Article
    #[oai(path = "/articles", method = "post", tag = "ApiTags::Article")]
    async fn crear(&self, cuerpo: Json<PeticionCrearArticle>) -> RespuestaCrearArticle {
        match self
            .crear_article
            .ejecutar(ParamsCrearArticle {
                title: cuerpo.title.clone(),
                summary: cuerpo.summary.clone(),
                views: cuerpo.views,
                tags: cuerpo.tags.clone(),
                scores: cuerpo.scores.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearArticle::Creado(Json(DtoArticle::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_article falló");
                RespuestaCrearArticle::from_status(status, error)
            }
        }
    }

    /// Obtiene: Article por id
    #[oai(path = "/articles/:id", method = "get", tag = "ApiTags::Article")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerArticle {
        match self
            .obtener_article
            .ejecutar(ParamsObtenerArticle {
                id: IdArticle::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerArticle::Ok(Json(DtoArticle::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_article falló");
                RespuestaObtenerArticle::from_status(status, error)
            }
        }
    }

    /// Lista Articles, página a página (el dominio acota `limite`)
    #[oai(path = "/articles", method = "get", tag = "ApiTags::Article")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarArticles {
        match self
            .listar_articles
            .ejecutar(ParamsListarArticles {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarArticles::Ok(Json(DtoPaginaArticle::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_articles falló");
                RespuestaListarArticles::from_status(status, error)
            }
        }
    }

    /// Actualiza: Article
    #[oai(path = "/articles/:id", method = "put", tag = "ApiTags::Article")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarArticle>,
    ) -> RespuestaActualizarArticle {
        match self
            .actualizar_article
            .ejecutar(ParamsActualizarArticle {
                id: IdArticle::from_uuid(id.0),
                title: cuerpo.title.clone(),
                summary: cuerpo.summary.clone(),
                views: cuerpo.views,
                tags: cuerpo.tags.clone(),
                scores: cuerpo.scores.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarArticle::Ok(Json(DtoArticle::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_article falló");
                RespuestaActualizarArticle::from_status(status, error)
            }
        }
    }

    /// Borra: Article
    #[oai(path = "/articles/:id", method = "delete", tag = "ApiTags::Article")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarArticle {
        match self
            .borrar_article
            .ejecutar(ParamsBorrarArticle {
                id: IdArticle::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarArticle::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_article falló");
                RespuestaBorrarArticle::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_article::{
        actualizar_article::dobles::MockActualizarArticle,
        borrar_article::dobles::MockBorrarArticle, crear_article::dobles::MockCrearArticle,
        listar_articles::dobles::MockListarArticles, obtener_article::dobles::MockObtenerArticle,
    };
    use dominio_article::errores::ErrorArticle;
    use dominio_article::pruebas::madres::MadreArticle;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearArticle,
        obtener: MockObtenerArticle,
        listar: MockListarArticles,
        actualizar: MockActualizarArticle,
        borrar: MockBorrarArticle,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiArticle {
                crear_article: Arc::new(self.crear),
                obtener_article: Arc::new(self.obtener),
                listar_articles: Arc::new(self.listar),
                actualizar_article: Arc::new(self.actualizar),
                borrar_article: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearArticle {
        PeticionCrearArticle {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }
    }

    fn peticion_actualizar() -> PeticionActualizarArticle {
        PeticionActualizarArticle {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }
    }

    fn ruta_elemento() -> String {
        format!("/articles/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_article() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreArticle::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/articles")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_article_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticle::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/articles")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_article_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreArticle::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_article_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticle::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_articles_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreArticle::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/articles").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/articles?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticle::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/articles").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_article() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreArticle::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_article_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticle::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_article() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_article_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticle::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

=== contextos/saludo/aplicacion/src/obtener_saludo.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo, repositorio::RepositorioSaludo};

#[derive(Debug, Clone)]
pub struct ParamsObtenerSaludo {
    pub nombre: String,
}

#[async_trait]
pub trait ObtenerSaludo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerSaludo {}

        #[async_trait]
        impl ObtenerSaludo for ObtenerSaludo {
            async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
        }
    }
}

pub struct ObtenerSaludoImpl {
    pub repositorio: Arc<dyn RepositorioSaludo>,
}

#[async_trait]
impl ObtenerSaludo for ObtenerSaludoImpl {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo> {
        tracing::info!(nombre = %params.nombre, "obtener_saludo: inicio");

        if params.nombre.trim().is_empty() {
            let err = ErrorSaludo::Validacion("nombre_vacio".into());
            tracing::warn!(error = %err, "obtener_saludo: rechazado");
            return Err(err);
        }

        let resultado = match self
            .repositorio
            .buscar_por_nombre(&params.nombre)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "obtener_saludo: fallo del repositorio"))?
        {
            Some(saludo) => saludo,
            None => Saludo::new(&params.nombre)?,
        };

        tracing::info!("obtener_saludo: fin");
        Ok(resultado)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_saludo::repositorio::dobles::MockRepositorioSaludo;

    #[tokio::test]
    async fn deberia_devolver_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(|_| Ok(None));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Mundo".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let saludo = resultado.unwrap();
        assert_eq!(saludo.nombre, "Mundo");
        assert!(saludo.mensaje.contains("Mundo"));
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_el_nombre_esta_vacio() {
        // Preparar
        let repositorio_doble = MockRepositorioSaludo::new();
        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo { nombre: "".into() })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "saludo.validacion.nombre_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_el_saludo_guardado_cuando_esta_en_el_repositorio() {
        // Preparar
        let en_cache = Saludo {
            nombre: "Puerto".into(),
            mensaje: "¡Hola desde la caché!".into(),
        };
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(move |_| Ok(Some(en_cache.clone())));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Puerto".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().mensaje, "¡Hola desde la caché!");
    }
}

