// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod article {
    use std::sync::Arc;

    use aplicacion_article::actualizar_article::{ActualizarArticle, ActualizarArticleImpl};
    use aplicacion_article::borrar_article::{BorrarArticle, BorrarArticleImpl};
    use aplicacion_article::crear_article::{CrearArticle, CrearArticleImpl};
    use aplicacion_article::listar_articles::{ListarArticles, ListarArticlesImpl};
    use aplicacion_article::obtener_article::{ObtenerArticle, ObtenerArticleImpl};
    use dominio_article::repositorio::RepositorioArticle;
    use infra_article::repositorio::RepositorioArticleEnMemoria;

    /// Los casos de uso de `article`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_article: Arc<dyn CrearArticle>,
        pub obtener_article: Arc<dyn ObtenerArticle>,
        pub listar_articles: Arc<dyn ListarArticles>,
        pub actualizar_article: Arc<dyn ActualizarArticle>,
        pub borrar_article: Arc<dyn BorrarArticle>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioArticle> = Arc::new(RepositorioArticleEnMemoria::new());
        CasosDeUso {
            crear_article: Arc::new(CrearArticleImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_article: Arc::new(ObtenerArticleImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_articles: Arc::new(ListarArticlesImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_article: Arc::new(ActualizarArticleImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_article: Arc::new(BorrarArticleImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

