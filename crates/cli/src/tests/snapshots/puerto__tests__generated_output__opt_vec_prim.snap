=== web/src/domain/article/errors.ts ===
/**
 * A request about an article that the API refused. `code` is the API's `RespuestaError.codigo`:
 * `article.no_encontrado`, `article.validacion.<field>_vacio`.
 */
export class ArticleError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "ArticleError";
    this.code = code;
  }
}

=== web/src/domain/article/messages.ts ===
import type { ArticleDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface ArticleProblem {
  field: keyof ArticleDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "article.validacion.title_vacio": "Title is required",
  "article.duplicado": "An article with these values already exists",
  "article.no_encontrado": "This article no longer exists",
  "article.repositorio": "The article could not be saved, try again later",
  "article.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof ArticleDraft> = {
  "article.validacion.title_vacio": "title",
};

export function toProblem(code: string): ArticleProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

