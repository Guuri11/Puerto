=== contextos/article/rest/src/respuestas.rs ===
// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoArticle, DtoPaginaArticle};

#[derive(ApiResponse)]
pub enum RespuestaCrearArticle {
    #[oai(status = 201)]
    Creado(Json<DtoArticle>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearArticle {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerArticle {
    #[oai(status = 200)]
    Ok(Json<DtoArticle>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerArticle {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarArticles {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaArticle>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarArticles {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarArticle {
    #[oai(status = 200)]
    Ok(Json<DtoArticle>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarArticle {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarArticle {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
