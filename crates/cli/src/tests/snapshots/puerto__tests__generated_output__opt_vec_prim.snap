        tracing::info!(id = %params.id, "borrar_article: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_article: fallo del repositorio"))?
