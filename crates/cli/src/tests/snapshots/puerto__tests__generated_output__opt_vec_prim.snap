use thiserror::Error;

#[derive(Debug, Error)]
pub enum ArticleError {
    #[error("article.validation_error.{0}")]
    ValidationError(String),
    #[error("article.not_found")]
    NotFound,
    #[error("article.duplicate")]
    Duplicate,
    #[error("article.repository_error")]
    RepositoryError,
    #[error("article.unknown")]
    Unknown,
}

=== business/src/domain/article/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::ArticleError;

#[derive(Debug, Clone)]
pub struct ArticleProps {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

#[derive(Debug, Clone)]
pub struct Article {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

impl Article {
    pub fn new(props: ArticleProps) -> Result<Self, ArticleError> {
        if props.title.trim().is_empty() {
            return Err(ArticleError::ValidationError("title_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            summary: props.summary,
            views: props.views,
            tags: props.tags,
            scores: props.scores,
        })
    }

    pub fn from_repository(data: Article) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_article_when_fields_are_valid() {
        let result = Article::new(ArticleProps {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert_eq!(result.unwrap().title, "example");
    }


    #[test]
    fn should_reject_article_when_title_is_empty() {
        let result = Article::new(ArticleProps {
            title: "".into(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "article.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_article_when_title_is_only_whitespace() {
        let result = Article::new(ArticleProps {
            title: "   ".into(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert!(result.is_err());
    }
}

