=== web/src/api/cliente.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { components, paths } from "./esquema";

/** El cliente tipado de la API. `paths` sale de la especificación del backend (`make web/sync`). */
export type ClienteApi = Client<paths>;

/** Los DTO de la API por nombre: `Esquemas["DtoProducto"]`, `Esquemas["PeticionCrearProducto"]`. */
export type Esquemas = components["schemas"];

/** `/api` es el backend: en desarrollo, Vite lo pasa a `:8080`. */
export function crearClienteApi(opciones: ClientOptions = {}): ClienteApi {
  return createClient<paths>({ baseUrl: "/api", ...opciones });
}

=== web/src/contextos/article/contenedores/detalle-article.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionArticle, MadreArticle } from "../../../pruebas/article";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleArticle } from "./detalle-article";

describe("ContenedorDetalleArticle", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreArticle.aleatorio();
    const api = apiFalsa([coleccionArticle([sembrado])]);

    const pantalla = <ContenedorDetalleArticle id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionArticle()]);
    const pantalla = <ContenedorDetalleArticle id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("article.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreArticle.aleatorio();
    const guardados = coleccionArticle([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleArticle id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/articles"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/article/contenedores/detalle-article.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleArticle } from "../vistas/detalle-article";

export function ContenedorDetalleArticle({ id }: { id: string }) {
  const { api } = useDependencias();
  const article = useCarga(
    () => desenvolver(api.GET("/articles/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/articles/{id}", { params: { path: { id } } }));
      navegar("/articles");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Article</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {article.estado === "cargando" && <span className="loading loading-spinner" />}
      {article.estado === "error" && <AlertaError error={article.error} />}
      {article.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleArticle article={article.datos} />
            <div className="card-actions justify-end">
              <Link href={`/articles/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/articles" className="link">
        Volver a articles
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar article?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/article/contenedores/formulario-article.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { textoDe } from "../../../compartido/formularios";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionArticle, MadreArticle } from "../../../pruebas/article";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioArticle } from "./formulario-article";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearArticle"]) {
  await screen.findByText("Guardar");
  escribir("Title", peticion.title);
  escribir("Summary", textoDe(peticion.summary));
  escribir("Views", textoDe(peticion.views));
  escribir("Tags", peticion.tags.join(", "));
  escribir("Scores", peticion.scores.join(", "));
}

describe("ContenedorFormularioArticle", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreArticle.peticion();
    const guardados = coleccionArticle();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioArticle />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/articles/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/articles/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreArticle.aleatorio();
    const guardados = coleccionArticle([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioArticle id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/articles/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreArticle.peticion();
    const codigo = "article.validacion.invalido";
    const fallos = { "POST /articles": codigo };
    const api = apiFalsa([coleccionArticle()], fallos);
    renderizarPantalla(<ContenedorFormularioArticle />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreArticle.peticion();
    const codigo = "article.duplicado";
    const fallos = { "POST /articles": codigo };
    const api = apiFalsa([coleccionArticle()], fallos);
    renderizarPantalla(<ContenedorFormularioArticle />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreArticle.peticion();
    const codigo = "article.validacion.title_vacio";
    const fallos = { "POST /articles": codigo };
    const api = apiFalsa([coleccionArticle()], fallos);
    renderizarPantalla(<ContenedorFormularioArticle />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Title");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/article/contenedores/formulario-article.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioArticle,
  aPeticionArticle,
  VistaFormularioArticle,
} from "../vistas/formulario-article";

type Article = Esquemas["DtoArticle"];

/** Crear, o editar con `id`: el formulario de articles. */
export function ContenedorFormularioArticle({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/articles/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear article" : "Editar article";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioArticle existente={existente.datos} />}
      <Link href={id === undefined ? "/articles" : `/articles/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioArticle({ existente }: { existente: Article | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioArticle(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionArticle(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/articles", { body: cuerpo })
          : api.PUT("/articles/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/articles/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioArticle
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/article/contenedores/lista-article.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionArticle, MadreArticle } from "../../../pruebas/article";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaArticle } from "./lista-article";

describe("ContenedorListaArticle", () => {
  test("debería mostrar una fila por cada article", async () => {
    // Preparar
    const semilla = [MadreArticle.aleatorio(), MadreArticle.aleatorio()];
    const api = apiFalsa([coleccionArticle(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaArticle />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreArticle.aleatorio());
    const api = apiFalsa([coleccionArticle(semilla)]);
    renderizarPantalla(<ContenedorListaArticle />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreArticle.aleatorio());
    const api = apiFalsa([coleccionArticle(semilla)]);
    const ruta = "/articles?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaArticle />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay articles", async () => {
    // Preparar
    const api = apiFalsa([coleccionArticle()]);

    // Actuar
    renderizarPantalla(<ContenedorListaArticle />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay articles.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /articles": "article.repositorio" };
    const api = apiFalsa([coleccionArticle()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaArticle />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("article.repositorio");
  });
});

=== web/src/contextos/article/contenedores/lista-article.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaArticle } from "../vistas/lista-article";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaArticle() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const articles = useCarga(
    () => desenvolver(api.GET("/articles", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Articles</h1>
        <Link href="/articles/nuevo" className="btn btn-primary">
          Crear article
        </Link>
      </div>
      {articles.estado === "cargando" && <span className="loading loading-spinner" />}
      {articles.estado === "error" && <AlertaError error={articles.error} />}
      {articles.estado === "listo" &&
        (articles.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay articles." />
        ) : (
          <>
            <VistaListaArticle articles={articles.datos.elementos} />
            <Paginacion
              total={articles.datos.total}
              limite={articles.datos.limite}
              desplazamiento={articles.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/article/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaArticle {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "article.validacion.title_vacio": "Title: obligatorio",
  "article.duplicado": "Estos valores ya están en uso",
  "article.no_encontrado": "Ya no existe",
  "article.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "article.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "article.validacion.title_vacio": "title",
};

export function aProblema(codigo: string): ProblemaArticle {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

=== web/src/contextos/article/vistas/detalle-article.tsx ===
import type { Esquemas } from "../../../api/cliente";

type Article = Esquemas["DtoArticle"];

export function VistaDetalleArticle({ article }: { article: Article }) {
  return (
    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
      <dt className="font-semibold">Title</dt>
      <dd>{article.title}</dd>
      <dt className="font-semibold">Summary</dt>
      <dd>{article.summary ?? "—"}</dd>
      <dt className="font-semibold">Views</dt>
      <dd>{article.views ?? "—"}</dd>
      <dt className="font-semibold">Tags</dt>
      <dd>{article.tags.join(", ")}</dd>
      <dt className="font-semibold">Scores</dt>
      <dd>{article.scores.join(", ")}</dd>
    </dl>
  );
}

=== web/src/contextos/article/vistas/formulario-article.tsx ===
import type { Esquemas } from "../../../api/cliente";
import {
  numeroOpcional,
  separarLista,
  separarNumeros,
  textoDe,
  textoOpcional,
} from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaArticle } from "../mensajes";

type Article = Esquemas["DtoArticle"];
type PeticionArticle = Esquemas["PeticionCrearArticle"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioArticle {
  title: string;
  summary: string;
  views: string;
  tags: string;
  scores: string;
}

/** Los inputs de `article`, vacíos cuando todavía no hay ninguno. */
export function aFormularioArticle(article: Article | null): ValoresFormularioArticle {
  if (article === null) {
    return {
      title: "",
      summary: "",
      views: "",
      tags: "",
      scores: "",
    };
  }
  return {
    title: article.title,
    summary: textoDe(article.summary),
    views: textoDe(article.views),
    tags: article.tags.join(", "),
    scores: article.scores.join(", "),
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionArticle(valores: ValoresFormularioArticle): PeticionArticle {
  return {
    title: valores.title,
    summary: textoOpcional(valores.summary),
    views: numeroOpcional(valores.views),
    tags: separarLista(valores.tags),
    scores: separarNumeros(valores.scores),
  };
}

export function VistaFormularioArticle({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioArticle;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaArticle | null;
  alCambiar: (valores: ValoresFormularioArticle) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "title"}
          required
          value={valores.title}
          onChange={(event) => alCambiar({ ...valores, title: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Summary</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "summary"}
          value={valores.summary}
          onChange={(event) => alCambiar({ ...valores, summary: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="summary" />
      <label className="fieldset">
        <span className="fieldset-legend">Views</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "views"}
          value={valores.views}
          onChange={(event) => alCambiar({ ...valores, views: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="views" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "tags"}
          value={valores.tags}
          onChange={(event) => alCambiar({ ...valores, tags: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Scores</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "scores"}
          value={valores.scores}
          onChange={(event) => alCambiar({ ...valores, scores: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="scores" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

