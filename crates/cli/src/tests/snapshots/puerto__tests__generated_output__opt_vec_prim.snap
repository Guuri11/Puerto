=== presentation/src/api/article/routes.rs ===
use std::sync::Arc;

use business::domain::article::model::ArticleId;
use business::domain::article::use_cases::{
    create_article::{CreateArticleParams, CreateArticleUseCaseTrait},
    delete_article::{DeleteArticleParams, DeleteArticleUseCaseTrait},
    get_article::{GetArticleParams, GetArticleUseCaseTrait},
    list_articles::{ListArticlesParams, ListArticlesUseCaseTrait},
    update_article::{UpdateArticleParams, UpdateArticleUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::article::dto::{
    CreateArticleRequest, UpdateArticleRequest, ArticleDto, ArticlePageDto,
};
use crate::api::article::responses::{
    CreateArticleResponse, DeleteArticleResponse, GetArticleResponse, ListArticlesResponse,
    UpdateArticleResponse,
};

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct ArticleApi {
    pub create_article: Arc<dyn CreateArticleUseCaseTrait>,
    pub get_article: Arc<dyn GetArticleUseCaseTrait>,
    pub list_articles: Arc<dyn ListArticlesUseCaseTrait>,
    pub update_article: Arc<dyn UpdateArticleUseCaseTrait>,
    pub delete_article: Arc<dyn DeleteArticleUseCaseTrait>,
}

#[OpenApi]
impl ArticleApi {
    /// Create a new Article
    #[oai(path = "/articles", method = "post", tag = "ApiTags::Article")]
    async fn create(&self, body: Json<CreateArticleRequest>) -> CreateArticleResponse {
        match self
            .create_article
            .execute(CreateArticleParams {
                title: body.title.clone(),
                summary: body.summary.clone(),
                views: body.views,
                tags: body.tags.clone(),
                scores: body.scores.clone(),
            })
            .await
        {
            Ok(entity) => CreateArticleResponse::Created(Json(ArticleDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_article failed");
                CreateArticleResponse::from_status(status, error)
            }
        }
    }

    /// Get a Article by ID
    #[oai(path = "/articles/:id", method = "get", tag = "ApiTags::Article")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetArticleResponse {
        match self
            .get_article
            .execute(GetArticleParams { id: ArticleId::from_uuid(id.0) })
            .await
        {
            Ok(entity) => GetArticleResponse::Ok(Json(ArticleDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_article failed");
                GetArticleResponse::from_status(status, error)
            }
        }
    }

    /// List Articles, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/articles", method = "get", tag = "ApiTags::Article")]
    async fn list(&self, limit: Query<Option<u32>>, offset: Query<Option<u32>>) -> ListArticlesResponse {
        match self
            .list_articles
            .execute(ListArticlesParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListArticlesResponse::Ok(Json(ArticlePageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_articles failed");
                ListArticlesResponse::from_status(status, error)
            }
        }
    }

    /// Update a Article
    #[oai(path = "/articles/:id", method = "put", tag = "ApiTags::Article")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateArticleRequest>) -> UpdateArticleResponse {
        match self
            .update_article
            .execute(UpdateArticleParams {
                id: ArticleId::from_uuid(id.0),
                title: body.title.clone(),
                summary: body.summary.clone(),
                views: body.views,
                tags: body.tags.clone(),
                scores: body.scores.clone(),
            })
            .await
        {
            Ok(entity) => UpdateArticleResponse::Ok(Json(ArticleDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_article failed");
                UpdateArticleResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Article
    #[oai(path = "/articles/:id", method = "delete", tag = "ApiTags::Article")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteArticleResponse {
        match self
            .delete_article
            .execute(DeleteArticleParams { id: ArticleId::from_uuid(id.0) })
            .await
        {
            Ok(()) => DeleteArticleResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_article failed");
                DeleteArticleResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::article::errors::ArticleError;
    use business::domain::article::use_cases::{
        create_article::mocks::MockCreateArticleUseCase, delete_article::mocks::MockDeleteArticleUseCase,
        get_article::mocks::MockGetArticleUseCase, list_articles::mocks::MockListArticlesUseCase,
        update_article::mocks::MockUpdateArticleUseCase,
    };
    use business::tests::mothers::article_mother::ArticleMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateArticleUseCase,
        get: MockGetArticleUseCase,
        list: MockListArticlesUseCase,
        update: MockUpdateArticleUseCase,
        delete: MockDeleteArticleUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = ArticleApi {
                create_article: Arc::new(self.create),
                get_article: Arc::new(self.get),
                list_articles: Arc::new(self.list),
                update_article: Arc::new(self.update),
                delete_article: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateArticleRequest {
        CreateArticleRequest {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }
    }

    fn update_request() -> UpdateArticleRequest {
        UpdateArticleRequest {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }
    }

    fn item_path() -> String {
        format!("/articles/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_article_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| Ok(ArticleMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/articles")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_article_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(ArticleError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/articles")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_article_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Ok(ArticleMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_article_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Err(ArticleError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_articles_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(ArticleMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/articles").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks.client().get("/articles?limit=5&offset=10").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Err(ArticleError::RepositoryError));

        // Act
        let response = mocks.client().get("/articles").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_article_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Ok(ArticleMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_article() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Err(ArticleError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_article_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_article() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Err(ArticleError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

