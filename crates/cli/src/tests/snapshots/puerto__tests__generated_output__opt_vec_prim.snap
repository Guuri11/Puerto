    repository::ArticleRepositoryTrait,
    use_cases::list_articles::{ListArticlesParams, ListArticlesUseCaseTrait},
};

pub struct ListArticlesUseCaseImpl {
    pub repository: Arc<dyn ArticleRepositoryTrait>,
}

#[async_trait]
impl ListArticlesUseCaseTrait for ListArticlesUseCaseImpl {
    async fn execute(&self, _params: ListArticlesParams) -> Result<Vec<Article>, ArticleError> {
        tracing::info!("list_articles: start");
        self.repository.find_all().await.inspect_err(|e| tracing::error!(error = %e, "list_articles: repository failed"))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::article::{
        model::{Article, ArticleProps},
        repository::mocks::MockArticleRepository,
    };


    #[tokio::test]
    async fn should_return_all_articles() {
        let entities = vec![
            Article::new(ArticleProps {
            title: "first".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }).unwrap(),
            Article::new(ArticleProps {
            title: "second".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }).unwrap(),
        ];
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListArticlesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListArticlesParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_articles_exist() {
        let mut mock_repo = MockArticleRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListArticlesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListArticlesParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

=== business/src/application/article/update_article.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::article::{
    errors::ArticleError,
    model::Article,
    repository::ArticleRepositoryTrait,
    use_cases::update_article::{UpdateArticleParams, UpdateArticleUseCaseTrait},
};

pub struct UpdateArticleUseCaseImpl {
    pub repository: Arc<dyn ArticleRepositoryTrait>,
}

#[async_trait]
impl UpdateArticleUseCaseTrait for UpdateArticleUseCaseImpl {
    async fn execute(&self, params: UpdateArticleParams) -> Result<Article, ArticleError> {
        tracing::info!(id = %params.id, "update_article: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_article: repository failed"))?
            .ok_or_else(|| {
                let err = ArticleError::NotFound;
                tracing::warn!(error = %err, "update_article: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = ArticleError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_article: rejected");
            return Err(err);
        }
        entity.title = params.title;
        entity.summary = params.summary;
        entity.views = params.views;
        entity.tags = params.tags;
        entity.scores = params.scores;
        entity.updated_at = chrono::Utc::now();
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "update_article: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::article::{
        model::{Article, ArticleProps},
        repository::mocks::MockArticleRepository,
    };
    use uuid::Uuid;


    #[tokio::test]
    async fn should_update_article_when_params_are_valid() {
        // Arrange
        let entity = Article::new(ArticleProps {
            title: "original".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateArticleParams {
            id: entity_id,
            title: "updated".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().title, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_article_does_not_exist() {
        // Arrange
        let mut mock_repo = MockArticleRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateArticleParams {
            id: Uuid::new_v4(),
            title: "new".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "article.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let entity = Article::new(ArticleProps {
            title: "original".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
