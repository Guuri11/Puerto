=== business/src/domain/article/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ArticleError {
    #[error("article.validation_error.{0}")]
    ValidationError(String),
    #[error("article.not_found")]
    NotFound,
    #[error("article.duplicate")]
    Duplicate,
    #[error("article.repository_error")]
    RepositoryError,
    #[error("article.unknown")]
    Unknown,
}

impl From<RepositoryError> for ArticleError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = ArticleError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "article.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = ArticleError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "article.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = ArticleError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "article.repository_error");
    }
}

=== business/src/domain/article/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::ArticleError;

/// The id of every `Article`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ArticleId(Uuid);

impl ArticleId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for ArticleId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct ArticleProps {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

#[derive(Debug, Clone)]
pub struct Article {
    pub id: ArticleId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

impl Article {
    pub fn new(props: ArticleProps) -> Result<Self, ArticleError> {
        if props.title.trim().is_empty() {
            return Err(ArticleError::ValidationError("title_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: ArticleId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            summary: props.summary,
            views: props.views,
            tags: props.tags,
            scores: props.scores,
        })
    }

    pub fn from_repository(data: Article) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_article_when_fields_are_valid() {
        let result = Article::new(ArticleProps {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert_eq!(result.unwrap().title, "example");
    }


    #[test]
    fn should_reject_article_when_title_is_empty() {
        let result = Article::new(ArticleProps {
            title: "".into(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "article.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_article_when_title_is_only_whitespace() {
        let result = Article::new(ArticleProps {
            title: "   ".into(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        });
        assert!(result.is_err());
    }
}

