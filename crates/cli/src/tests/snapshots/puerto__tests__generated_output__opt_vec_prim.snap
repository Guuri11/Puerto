use async_trait::async_trait;
use dominio_article::errores::ErrorArticle;
use dominio_article::modelo::IdArticle;
use dominio_article::repositorio::RepositorioArticle;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarArticle {
    pub id: IdArticle,
}

#[async_trait]
pub trait BorrarArticle: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarArticle) -> Result<(), ErrorArticle>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarArticle {}

        #[async_trait]
        impl BorrarArticle for BorrarArticle {
            async fn ejecutar(&self, params: ParamsBorrarArticle) -> Result<(), ErrorArticle>;
        }
    }
}

pub struct BorrarArticleImpl {
    pub repositorio: Arc<dyn RepositorioArticle>,
}

#[async_trait]
impl BorrarArticle for BorrarArticleImpl {
    #[tracing::instrument(name = "borrar_article", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsBorrarArticle) -> Result<(), ErrorArticle> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorArticle::NoEncontrado)?;
        entidad.borrar();
        self.repositorio.guardar(&entidad).await?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
