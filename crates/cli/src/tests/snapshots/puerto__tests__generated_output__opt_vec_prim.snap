use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::article::{
    errors::ArticleError,
    model::{Article, ArticleProps},
    repository::ArticleRepositoryTrait,
    use_cases::create_article::{CreateArticleParams, CreateArticleUseCaseTrait},
};

pub struct CreateArticleUseCaseImpl {
    pub repository: Arc<dyn ArticleRepositoryTrait>,
}

#[async_trait]
impl CreateArticleUseCaseTrait for CreateArticleUseCaseImpl {
    async fn execute(&self, params: CreateArticleParams) -> Result<Article, ArticleError> {
        tracing::info!("create_article: start");
        let entity = Article::new(ArticleProps {
            title: params.title,
            summary: params.summary,
            views: params.views,
            tags: params.tags,
            scores: params.scores,
        }).inspect_err(|e| tracing::warn!(error = %e, "create_article: rejected"))?;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "create_article: repository failed"))?;
        tracing::info!(id = %entity.id, "create_article: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::article::repository::mocks::MockArticleRepository;
    use puerto_core::RepositoryError;


    #[tokio::test]
    async fn should_create_article_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockArticleRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateArticleParams {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));
        let use_case = CreateArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateArticleParams {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "article.duplicate");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let mock_repo = MockArticleRepository::new();
        let use_case = CreateArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateArticleParams {
            title: "".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "article.validation_error.title_empty"
        );
    }
}

=== business/src/application/article/delete_article.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::article::{
    errors::ArticleError,
    repository::ArticleRepositoryTrait,
    use_cases::delete_article::{DeleteArticleParams, DeleteArticleUseCaseTrait},
};

pub struct DeleteArticleUseCaseImpl {
    pub repository: Arc<dyn ArticleRepositoryTrait>,
}

#[async_trait]
impl DeleteArticleUseCaseTrait for DeleteArticleUseCaseImpl {
    async fn execute(&self, params: DeleteArticleParams) -> Result<(), ArticleError> {
        tracing::info!(id = %params.id, "delete_article: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_article: repository failed"))?
            .ok_or_else(|| {
                let err = ArticleError::NotFound;
                tracing::warn!(error = %err, "delete_article: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "delete_article: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::article::{
        model::{Article, ArticleId, ArticleProps},
        repository::mocks::MockArticleRepository,
    };


    #[tokio::test]
    async fn should_soft_delete_article_when_id_exists() {
        let entity = Article::new(ArticleProps {
            title: "example".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteArticleParams { id: entity_id })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_article_does_not_exist() {
        let mut mock_repo = MockArticleRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteArticleUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteArticleParams { id: ArticleId::generate() })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "article.not_found");
    }
}

