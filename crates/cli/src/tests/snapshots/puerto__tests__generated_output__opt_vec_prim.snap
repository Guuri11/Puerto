=== web/src/presentation/features/article/views/article-form-view.tsx ===
import type { Article, ArticleDraft } from "../../../../domain/article/model";
import { numberOrNull, splitList, splitNumbers, textOf, textOrNull } from "../../../shared/forms";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ArticleFormValues {
  title: string;
  summary: string;
  views: string;
  tags: string;
  scores: string;
}

/** The inputs for `article`, empty when there is none yet. */
export function toArticleForm(article: Article | null): ArticleFormValues {
  if (article === null) {
    return {
      title: "",
      summary: "",
      views: "",
      tags: "",
      scores: "",
    };
  }
  return {
    title: article.title,
    summary: textOf(article.summary),
    views: textOf(article.views),
    tags: article.tags.join(", "),
    scores: article.scores.join(", "),
  };
}

export function toArticleDraft(values: ArticleFormValues): ArticleDraft {
  return {
    title: values.title,
    summary: textOrNull(values.summary),
    views: numberOrNull(values.views),
    tags: splitList(values.tags),
    scores: splitNumbers(values.scores),
  };
}

export function ArticleFormView({
  values,
  saving,
  onChange,
  onSubmit,
}: {
  values: ArticleFormValues;
  saving: boolean;
  onChange: (values: ArticleFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.title}
          onChange={(event) => onChange({ ...values, title: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Summary</span>
        <input
          className="input w-full"
          type="text"
          value={values.summary}
          onChange={(event) => onChange({ ...values, summary: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Views</span>
        <input
          className="input w-full"
          type="number"
          value={values.views}
          onChange={(event) => onChange({ ...values, views: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          value={values.tags}
          onChange={(event) => onChange({ ...values, tags: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Scores</span>
        <input
          className="input w-full"
          type="text"
          value={values.scores}
          onChange={(event) => onChange({ ...values, scores: event.target.value })}
        />
      </label>
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

