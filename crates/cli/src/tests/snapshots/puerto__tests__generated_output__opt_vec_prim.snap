use business::domain::article::model::Article;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct ArticleDto {
    pub id: Uuid,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}

impl ArticleDto {
    pub fn from_domain(entity: &Article) -> Self {
        Self {
            id: entity.id.value(),
            title: entity.title.clone(),
            summary: entity.summary.clone(),
            views: entity.views,
            tags: entity.tags.clone(),
            scores: entity.scores.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateArticleRequest {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}


/// One page of Articles: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct ArticlePageDto {
    pub items: Vec<ArticleDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl ArticlePageDto {
    pub fn from_domain(page: &Page<Article>) -> Self {
        Self {
            items: page.items.iter().map(ArticleDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateArticleRequest {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
}


=== presentation/src/api/article/error_mapper.rs ===
use business::domain::article::errors::ArticleError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;

use crate::api::error::{ErrorResponse, IntoErrorResponse};

impl IntoErrorResponse for ArticleError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            ArticleError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            ArticleError::NotFound => StatusCode::NOT_FOUND,
            ArticleError::Duplicate => StatusCode::CONFLICT,
            ArticleError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            ArticleError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = ArticleError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "article.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = ArticleError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "article.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = ArticleError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "article.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = ArticleError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "article.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = ArticleError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "article.unknown");
    }
}

