use crate::modelo::Article;
use crate::modelo::PropsArticle;

pub struct MadreArticle {
    title: Option<String>,
    summary: Option<String>,
    views: Option<i64>,
    tags: Option<Vec<String>>,
    scores: Option<Vec<i64>>,
}

impl MadreArticle {
    pub fn new() -> Self {
        Self {
            title: None,
            summary: None,
            views: None,
            tags: None,
            scores: None,
        }
    }

    pub fn con_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn con_summary(mut self, summary: &str) -> Self {
        self.summary = Some(summary.to_string());
        self
    }

    pub fn con_views(mut self, views: i64) -> Self {
        self.views = Some(views);
        self
    }

    pub fn con_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn con_scores(mut self, scores: Vec<i64>) -> Self {
        self.scores = Some(scores);
        self
    }

    pub fn con_title_vacio(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn construir(self) -> Article {
        Article::new(PropsArticle {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
        })
        .expect("MadreArticle: Article::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsArticle {
        PropsArticle {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
        }
    }

    pub fn aleatorio() -> Article {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Article> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreArticle {
    fn default() -> Self {
        Self::new()
    }
}

