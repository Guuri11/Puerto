use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::article::{
    errors::ArticleError,
    model::Article,
    repository::ArticleRepositoryTrait,
    use_cases::list_articles::{ListArticlesParams, ListArticlesUseCaseTrait},
};

pub struct ListArticlesUseCaseImpl {
    pub repository: Arc<dyn ArticleRepositoryTrait>,
}

#[async_trait]
impl ListArticlesUseCaseTrait for ListArticlesUseCaseImpl {
    async fn execute(&self, params: ListArticlesParams) -> Result<Page<Article>, ArticleError> {
        tracing::info!(limit = params.page.limit(), offset = params.page.offset(), "list_articles: start");
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_articles: repository failed"))
            .map_err(ArticleError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_core::PageRequest;
    use crate::domain::article::{
        model::{Article, ArticleProps},
        repository::mocks::MockArticleRepository,
    };


    #[tokio::test]
    async fn should_return_the_page_of_articles() {
        let entities = vec![
            Article::new(ArticleProps {
            title: "first".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }).unwrap(),
            Article::new(ArticleProps {
            title: "second".to_string(),
            summary: None,
            views: None,
            tags: vec![],
            scores: vec![],
        }).unwrap(),
        ];
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListArticlesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListArticlesParams { page: PageRequest::default() })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_articles_exist() {
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListArticlesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListArticlesParams { page: PageRequest::default() })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockArticleRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListArticlesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListArticlesParams { page: PageRequest::new(Some(5), Some(10)) })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

=== business/src/application/article/update_article.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::article::{
    errors::ArticleError,
    model::Article,
    repository::ArticleRepositoryTrait,
    use_cases::update_article::{UpdateArticleParams, UpdateArticleUseCaseTrait},
};

pub struct UpdateArticleUseCaseImpl {
    pub repository: Arc<dyn ArticleRepositoryTrait>,
}

#[async_trait]
impl UpdateArticleUseCaseTrait for UpdateArticleUseCaseImpl {
    async fn execute(&self, params: UpdateArticleParams) -> Result<Article, ArticleError> {
        tracing::info!(id = %params.id, "update_article: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_article: repository failed"))?
            .ok_or_else(|| {
                let err = ArticleError::NotFound;
                tracing::warn!(error = %err, "update_article: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = ArticleError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_article: rejected");
            return Err(err);
        }
        entity.title = params.title;
        entity.summary = params.summary;
        entity.views = params.views;
        entity.tags = params.tags;
        entity.scores = params.scores;
        entity.updated_at = chrono::Utc::now();
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "update_article: repository failed"))?;
        Ok(entity)
    }
}

