use async_trait::async_trait;
use puerto_core::{Page, PageRequest, RepositoryError};

use super::model::{Article, ArticleId};

#[async_trait]
pub trait ArticleRepositoryTrait: Send + Sync {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Article>, RepositoryError>;
    async fn find_by_id(&self, id: ArticleId) -> Result<Option<Article>, RepositoryError>;
    async fn save(&self, entity: &Article) -> Result<(), RepositoryError>;
}

#[cfg(any(test, feature = "test-utils"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub ArticleRepository {}

        #[async_trait]
        impl ArticleRepositoryTrait for ArticleRepository {
            async fn find_all(&self, page: PageRequest) -> Result<Page<Article>, RepositoryError>;
            async fn find_by_id(&self, id: ArticleId) -> Result<Option<Article>, RepositoryError>;
            async fn save(&self, entity: &Article) -> Result<(), RepositoryError>;
        }
    }
}

