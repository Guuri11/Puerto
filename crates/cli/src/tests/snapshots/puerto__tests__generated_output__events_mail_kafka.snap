use std::sync::Arc;

use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ParamsObtenerSaludo};
use poem_openapi::{OpenApi, Tags, param::Path};

use crate::{dto::DtoSaludo, errores::a_respuesta_error, respuestas::RespuestaObtenerSaludo};

#[derive(Tags)]
enum ApiTags {
    Saludo,
}

/// Guarda el puerto del caso de uso; `generado/bootstrap.rs` conecta la implementación.
pub struct ApiSaludo {
    pub obtener_saludo: Arc<dyn ObtenerSaludo>,
}

#[OpenApi]
impl ApiSaludo {
    /// Obtiene un saludo para el nombre dado
    #[oai(path = "/saludos/:nombre", method = "get", tag = "ApiTags::Saludo")]
    async fn obtener_saludo(&self, nombre: Path<String>) -> RespuestaObtenerSaludo {
        match self
            .obtener_saludo
            .ejecutar(ParamsObtenerSaludo { nombre: nombre.0 })
            .await
        {
            Ok(saludo) => RespuestaObtenerSaludo::Ok(poem_openapi::payload::Json(
                DtoSaludo::from_dominio(&saludo),
            )),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_saludo falló");
                RespuestaObtenerSaludo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;
    use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo};
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::OpenApiService;

    use super::*;

    fn cliente(caso_de_uso: MockObtenerSaludo) -> TestClient<Route> {
        let api = ApiSaludo {
            obtener_saludo: Arc::new(caso_de_uso),
        };
        TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
    }

    #[tokio::test]
    async fn deberia_responder_200_con_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|params| Saludo::new(&params.nombre));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("nombre")
            .assert_string("Ada");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_se_rechaza_el_saludo() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|_| Err(ErrorSaludo::Validacion("nombre_vacio".into())));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }
}

=== docker-compose.yml ===
services:
  postgres:
    image: postgres:16
    container_name: snapshot-postgres
    ports:
      - "${DB_HOST_PORT:-5432}:5432"
    environment:
      POSTGRES_USER: devuser
      POSTGRES_PASSWORD: password
      POSTGRES_DB: snapshot
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U devuser -d snapshot"]
      interval: 5s
      timeout: 5s
      retries: 5

  redpanda:
    image: docker.redpanda.com/redpandadata/redpanda:v24.2.7
    container_name: snapshot-redpanda
    command:
      - redpanda
      - start
      - --mode
      - dev-container
      - --smp
      - "1"
      - --kafka-addr
      - PLAINTEXT://0.0.0.0:9092
      - --advertise-kafka-addr
      - PLAINTEXT://localhost:${KAFKA_HOST_PORT:-9092}
    ports:
      - "${KAFKA_HOST_PORT:-9092}:9092"
    volumes:
      - redpanda-data:/var/lib/redpanda/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "rpk cluster health | grep -q 'Healthy:.*true'"]
      interval: 5s
      timeout: 5s
      retries: 10

  mailpit:
    image: axllent/mailpit:v1.31.1
    container_name: snapshot-mailpit
    ports:
      - "${SMTP_HOST_PORT:-1025}:1025"
      - "${MAILPIT_UI_PORT:-8025}:8025"
    restart: unless-stopped

volumes:
  postgres-data:
  redpanda-data:

=== migraciones/<version>_correos_enviados.sql ===
-- Migración de Puerto: correos_enviados
-- Ejecuta `make sqlx/prepare` después de editar este fichero.

-- Correo (ADR-0020): lo escribe puerto. Una fila por correo que un consumidor del worker envió por
-- un evento, para que un evento reentregado no lo envíe otra vez. Crece una fila por correo: borrar
-- las antiguas es cosa tuya.

CREATE TABLE correos_enviados (
    id_evento  UUID        NOT NULL,
    correo     TEXT        NOT NULL,
    enviado_en TIMESTAMPTZ NOT NULL DEFAULT now(),
    PRIMARY KEY (id_evento, correo)
);

=== migraciones/<version>_crear_tabla_producto.sql ===
-- Migración de Puerto: crear_tabla_producto
-- Ejecuta `make sqlx/prepare` después de editar este fichero.

CREATE TABLE productos (
    id UUID PRIMARY KEY,
    name TEXT NOT NULL,
    sku TEXT NOT NULL,
    price BIGINT NOT NULL,
    status TEXT NOT NULL,
    tags TEXT[] NOT NULL DEFAULT '{}',
    released_at TIMESTAMPTZ,
    meta JSONB NOT NULL DEFAULT '{}',
    creado_en TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    actualizado_en TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    borrado BOOLEAN NOT NULL DEFAULT FALSE,
    borrado_en TIMESTAMPTZ
);

CREATE UNIQUE INDEX productos_sku_key ON productos (sku) WHERE borrado = false;

=== migraciones/<version>_outbox.sql ===
-- Migración de Puerto: outbox
-- Ejecuta `make sqlx/prepare` después de editar este fichero.

-- Eventos de dominio (ADR-0018): lo escribe puerto. Las unidades de trabajo insertan en `outbox`
-- en la misma transacción que la entidad; el worker lo releva y registra lo que no pudo entregar.

CREATE TABLE outbox (
    id              UUID        PRIMARY KEY,
    secuencia       BIGSERIAL   NOT NULL,          -- orden del relay
    tipo_agregado   TEXT        NOT NULL,
    id_agregado     UUID        NOT NULL,
    tipo_evento     TEXT        NOT NULL,
    version_esquema INT         NOT NULL,
    payload         JSONB       NOT NULL,
    cabeceras       JSONB       NOT NULL DEFAULT '{}',
    ocurrido_en     TIMESTAMPTZ NOT NULL,
    publicado_en    TIMESTAMPTZ
);
CREATE INDEX outbox_sin_publicar ON outbox (secuencia) WHERE publicado_en IS NULL;

CREATE TABLE descartados (                       -- todos los transportes
    id            UUID        PRIMARY KEY,
    id_evento     UUID,
    consumidor    TEXT        NOT NULL,
    tipo_evento   TEXT,
    intentos      INT         NOT NULL,
    motivo        TEXT        NOT NULL,
    detalle       TEXT        NOT NULL,
    payload       TEXT        NOT NULL,           -- recortado a 4000 caracteres
    registrado_en TIMESTAMPTZ NOT NULL DEFAULT now()
);
-- Un descartado por evento y consumidor, para que un fallo que se reentrega no se registre dos
-- veces. Un mensaje que no era un sobre no tiene id_evento: los NULL nunca chocan.
CREATE UNIQUE INDEX descartados_evento_consumidor ON descartados (id_evento, consumidor);

