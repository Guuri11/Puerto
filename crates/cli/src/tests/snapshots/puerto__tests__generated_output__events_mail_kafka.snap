=== contextos/correo/infraestructura/src/price_alert.rs ===
//! Renderiza el correo `price_alert` con sus plantillas y se lo pasa al enviador. Lo escribe una
//! vez `puerto generar correo`; desde entonces es tuyo. El texto está en `plantillas/price_alert/`:
//! cámbialo allí; los tests de abajo lo vuelven a renderizar, así que una errata hace fallar
//! `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::price_alert::{CorreoPriceAlert, EnviadorCorreoPriceAlert};
use puerto_correo::{EnviadorCorreo, ErrorCorreo, Plantillas};
use serde::Serialize;

const PLANTILLAS: Plantillas = Plantillas::new(
    include_str!("../plantillas/price_alert/asunto.txt"),
    include_str!("../plantillas/price_alert/cuerpo.html"),
)
.con_texto(include_str!("../plantillas/price_alert/cuerpo.txt"));

/// Lo que ven las plantillas: los campos del correo salvo el destinatario, con sus propios nombres.
#[derive(Serialize)]
struct Contexto<'a> {
    name: &'a String,
    price: &'a i64,
}

impl<'a> Contexto<'a> {
    fn de(correo: &'a CorreoPriceAlert) -> Self {
        Self {
            name: &correo.name,
            price: &correo.price,
        }
    }
}

/// El correo `price_alert`, renderizado desde `plantillas/price_alert/` y enviado por `enviador`
/// (`puerto_correo::EnviadorCorreoSmtp` allí donde se ejecuta).
pub struct EnviadorCorreoPriceAlertPlantilla {
    enviador: Arc<dyn EnviadorCorreo>,
}

impl EnviadorCorreoPriceAlertPlantilla {
    pub fn new(enviador: Arc<dyn EnviadorCorreo>) -> Self {
        Self { enviador }
    }
}

#[async_trait]
impl EnviadorCorreoPriceAlert for EnviadorCorreoPriceAlertPlantilla {
    async fn enviar(&self, correo: &CorreoPriceAlert) -> Result<(), ErrorCorreo> {
        let renderizado = PLANTILLAS.renderizar(correo.para.clone(), Contexto::de(correo))?;
        self.enviador.enviar(&renderizado).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn price_alert() -> CorreoPriceAlert {
        CorreoPriceAlert {
            para: "ada@example.com".to_string(),
            name: "example".to_string(),
            price: 42,
        }
    }

    #[test]
    fn deberia_renderizar_todas_las_plantillas_cuando_el_correo_tiene_sus_campos() {
        // Actuar
        let renderizado = PLANTILLAS.renderizar("ada@example.com", Contexto::de(&price_alert()));

        // Comprobar
        let renderizado = match renderizado {
            Ok(renderizado) => renderizado,
            Err(err) => panic!("plantillas/price_alert/ no se renderiza: {err}"),
        };
        assert!(!renderizado.asunto.is_empty());
        assert!(!renderizado.html.is_empty());
        assert!(renderizado.texto.is_some());
    }

    #[tokio::test]
    async fn deberia_enviar_el_correo_renderizado_a_su_destinatario() {
        // Preparar
        let grabador = Arc::new(EnviadorCorreoGrabador::new());
        let enviador = EnviadorCorreoPriceAlertPlantilla::new(grabador.clone());

        // Actuar
        let resultado = enviador.enviar(&price_alert()).await;

        // Comprobar
        assert_eq!(resultado, Ok(()));
        let enviados = grabador.enviados();
        assert_eq!(enviados.len(), 1);
        assert_eq!(enviados[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn deberia_devolver_el_error_del_enviador_cuando_el_envio_falla() {
        // Preparar
        let rechazado = ErrorCorreo::Permanente("550 no such user".to_string());
        let enviador = EnviadorCorreoPriceAlertPlantilla::new(Arc::new(
            EnviadorCorreoGrabador::fallando_con(rechazado.clone()),
        ));

        // Actuar
        let resultado = enviador.enviar(&price_alert()).await;

        // Comprobar
        assert_eq!(resultado, Err(rechazado));
    }
}

=== contextos/correo/infraestructura/src/producto_live.rs ===
//! Renderiza el correo `producto_live` con sus plantillas y se lo pasa al enviador. Lo escribe una
//! vez `puerto generar correo`; desde entonces es tuyo. El texto está en `plantillas/producto_live/`:
//! cámbialo allí; los tests de abajo lo vuelven a renderizar, así que una errata hace fallar
//! `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_correo::producto_live::{CorreoProductoLive, EnviadorCorreoProductoLive};
use puerto_correo::{EnviadorCorreo, ErrorCorreo, Plantillas};
use serde::Serialize;

const PLANTILLAS: Plantillas = Plantillas::new(
    include_str!("../plantillas/producto_live/asunto.txt"),
    include_str!("../plantillas/producto_live/cuerpo.html"),
)
.con_texto(include_str!("../plantillas/producto_live/cuerpo.txt"));

/// Lo que ven las plantillas: los campos del correo salvo el destinatario, con sus propios nombres.
#[derive(Serialize)]
struct Contexto<'a> {
    name: &'a String,
    price: &'a i64,
    status: &'a String,
    released_at: &'a Option<DateTime<Utc>>,
}

impl<'a> Contexto<'a> {
    fn de(correo: &'a CorreoProductoLive) -> Self {
        Self {
            name: &correo.name,
            price: &correo.price,
            status: &correo.status,
            released_at: &correo.released_at,
        }
    }
}

/// El correo `producto_live`, renderizado desde `plantillas/producto_live/` y enviado por `enviador`
/// (`puerto_correo::EnviadorCorreoSmtp` allí donde se ejecuta).
pub struct EnviadorCorreoProductoLivePlantilla {
    enviador: Arc<dyn EnviadorCorreo>,
}

impl EnviadorCorreoProductoLivePlantilla {
    pub fn new(enviador: Arc<dyn EnviadorCorreo>) -> Self {
        Self { enviador }
    }
}

#[async_trait]
impl EnviadorCorreoProductoLive for EnviadorCorreoProductoLivePlantilla {
    async fn enviar(&self, correo: &CorreoProductoLive) -> Result<(), ErrorCorreo> {
        let renderizado = PLANTILLAS.renderizar(correo.para.clone(), Contexto::de(correo))?;
        self.enviador.enviar(&renderizado).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn producto_live() -> CorreoProductoLive {
        CorreoProductoLive {
            para: "ada@example.com".to_string(),
            name: "example".to_string(),
            price: 42,
            status: "example".to_string(),
            released_at: Some(Utc::now()),
        }
    }

    #[test]
    fn deberia_renderizar_todas_las_plantillas_cuando_el_correo_tiene_sus_campos() {
        // Actuar
        let renderizado = PLANTILLAS.renderizar("ada@example.com", Contexto::de(&producto_live()));

        // Comprobar
        let renderizado = match renderizado {
            Ok(renderizado) => renderizado,
            Err(err) => panic!("plantillas/producto_live/ no se renderiza: {err}"),
        };
        assert!(!renderizado.asunto.is_empty());
        assert!(!renderizado.html.is_empty());
        assert!(renderizado.texto.is_some());
    }

    #[tokio::test]
    async fn deberia_enviar_el_correo_renderizado_a_su_destinatario() {
        // Preparar
        let grabador = Arc::new(EnviadorCorreoGrabador::new());
        let enviador = EnviadorCorreoProductoLivePlantilla::new(grabador.clone());

        // Actuar
        let resultado = enviador.enviar(&producto_live()).await;

        // Comprobar
        assert_eq!(resultado, Ok(()));
        let enviados = grabador.enviados();
        assert_eq!(enviados.len(), 1);
        assert_eq!(enviados[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn deberia_devolver_el_error_del_enviador_cuando_el_envio_falla() {
        // Preparar
        let rechazado = ErrorCorreo::Permanente("550 no such user".to_string());
        let enviador = EnviadorCorreoProductoLivePlantilla::new(Arc::new(
            EnviadorCorreoGrabador::fallando_con(rechazado.clone()),
        ));

        // Actuar
        let resultado = enviador.enviar(&producto_live()).await;

        // Comprobar
        assert_eq!(resultado, Err(rechazado));
    }
}

