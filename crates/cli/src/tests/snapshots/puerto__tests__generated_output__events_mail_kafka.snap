use async_trait::async_trait;
use dominio_producto::errores::ErrorProducto;
use dominio_producto::modelo::IdProducto;
use dominio_producto::repositorio::RepositorioProducto;
use dominio_producto::unit_of_work::UnitOfWorkFactoryProducto;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarProducto {
    pub id: IdProducto,
}

#[async_trait]
pub trait BorrarProducto: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarProducto) -> Result<(), ErrorProducto>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarProducto {}

        #[async_trait]
        impl BorrarProducto for BorrarProducto {
            async fn ejecutar(&self, params: ParamsBorrarProducto) -> Result<(), ErrorProducto>;
        }
    }
}

pub struct BorrarProductoImpl {
    pub repositorio: Arc<dyn RepositorioProducto>,
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProducto>,
}

#[async_trait]
impl BorrarProducto for BorrarProductoImpl {
    #[tracing::instrument(name = "borrar_producto", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsBorrarProducto) -> Result<(), ErrorProducto> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorProducto::NoEncontrado)?;
        let evento = entidad.borrar();
        self.uow_factory.guardar(&entidad, evento).await?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::{
        modelo::IdProducto, pruebas::madres::MadreProducto,
        repositorio::dobles::MockRepositorioProducto,
        unit_of_work::dobles::UnitOfWorkFactoryGrabadora,
    };
    use puerto_nucleo::EventoDominio;

    #[tokio::test]
    async fn deberia_registrar_el_evento_producto_borrado_cuando_el_id_existe() {
        // Preparar
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = BorrarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarProducto { id: id_entidad })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert!(grabado.guardados.iter().all(|guardados| guardados.borrado));
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "producto_borrado");
        assert_eq!(grabado.eventos[0].id_agregado(), id_entidad.valor());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_sin_registrar_nada_cuando_producto_no_existe() {
        // Preparar
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = BorrarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarProducto {
                id: IdProducto::generar(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.no_encontrado");
        assert!(uow_factory.grabado().eventos.is_empty());
    }
}

=== contextos/producto/aplicacion/src/crear_producto.rs ===
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_producto::errores::ErrorProducto;
use dominio_producto::modelo::{Producto, PropsProducto};
use dominio_producto::unit_of_work::UnitOfWorkFactoryProducto;
use dominio_producto::valores::{Name, Sku, Status};
use std::collections::HashMap;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearProducto {
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

#[async_trait]
pub trait CrearProducto: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearProducto) -> Result<Producto, ErrorProducto>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearProducto {}

        #[async_trait]
        impl CrearProducto for CrearProducto {
            async fn ejecutar(&self, params: ParamsCrearProducto) -> Result<Producto, ErrorProducto>;
        }
    }
}

pub struct CrearProductoImpl {
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProducto>,
}

#[async_trait]
impl CrearProducto for CrearProductoImpl {
    #[tracing::instrument(name = "crear_producto", skip_all, err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsCrearProducto) -> Result<Producto, ErrorProducto> {
        let name = Name::new(params.name)?;
        let sku = Sku::new(params.sku)?;
        let status = params.status.parse::<Status>()?;
        let (entidad, evento) = Producto::crear(PropsProducto {
            name,
            sku,
            price: params.price,
            status,
            tags: params.tags,
            released_at: params.released_at,
            meta: params.meta,
        })?;
        self.uow_factory.guardar(&entidad, evento).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::pruebas::madres::MadreProducto;
    use dominio_producto::unit_of_work::dobles::{FallarEn, UnitOfWorkFactoryGrabadora};
    use puerto_nucleo::ErrorRepositorio;
    use puerto_nucleo::EventoDominio;

    #[tokio::test]
    async fn deberia_registrar_el_evento_producto_creado_cuando_los_campos_son_validos() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = CrearProductoImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProducto {
                name: props.name.valor().to_string(),
                sku: props.sku.valor().to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
                tags: props.tags,
                released_at: props.released_at,
                meta: props.meta,
            })
            .await;

        // Comprobar
        let entidad = match resultado {
            Ok(entidad) => entidad,
            Err(e) => panic!("la creación falló: {e}"),
        };
        assert_eq!(entidad.name, MadreProducto::new().construir_props().name);
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert_eq!(grabado.guardados.len(), 1);
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "producto_creado");
        assert_eq!(grabado.eventos[0].id_agregado(), entidad.id.valor());
    }

    #[tokio::test]
    async fn no_deberia_hacer_commit_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let uow_factory =
            UnitOfWorkFactoryGrabadora::fallando_en(FallarEn::Guardar, ErrorRepositorio::Duplicado);
        let caso_de_uso = CrearProductoImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProducto {
                name: props.name.valor().to_string(),
                sku: props.sku.valor().to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
                tags: props.tags,
                released_at: props.released_at,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.duplicado");
        let grabado = uow_factory.grabado();
        assert!(!grabado.confirmado);
        assert!(grabado.eventos.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_falla_el_commit() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let uow_factory = UnitOfWorkFactoryGrabadora::fallando_en(
            FallarEn::Commit,
            ErrorRepositorio::NoDisponible,
        );
        let caso_de_uso = CrearProductoImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProducto {
                name: props.name.valor().to_string(),
                sku: props.sku.valor().to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
                tags: props.tags,
                released_at: props.released_at,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.repositorio");
        assert!(!uow_factory.grabado().confirmado);
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_name_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
