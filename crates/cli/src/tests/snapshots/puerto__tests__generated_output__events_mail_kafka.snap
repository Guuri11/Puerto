=== contextos/correo/infraestructura/src/digest.rs ===
//! Renderiza el correo `digest` con sus plantillas y se lo pasa al enviador. Lo escribe una
//! vez `puerto generar correo`; desde entonces es tuyo. El texto está en `plantillas/digest/`:
//! cámbialo allí; los tests de abajo lo vuelven a renderizar, así que una errata hace fallar
//! `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::digest::{CorreoDigest, EnviadorCorreoDigest};
use puerto_correo::{EnviadorCorreo, ErrorCorreo, Plantillas};
use serde::Serialize;

const PLANTILLAS: Plantillas = Plantillas::new(
    include_str!("../plantillas/digest/asunto.txt"),
    include_str!("../plantillas/digest/cuerpo.html"),
)
.con_texto(include_str!("../plantillas/digest/cuerpo.txt"));

/// Lo que ven las plantillas: los campos del correo salvo el destinatario, con sus propios nombres.
#[derive(Serialize)]
struct Contexto<'a> {
    nombre: &'a String,
}

impl<'a> Contexto<'a> {
    fn de(correo: &'a CorreoDigest) -> Self {
        Self {
            nombre: &correo.nombre,
        }
    }
}

/// El correo `digest`, renderizado desde `plantillas/digest/` y enviado por `enviador`
/// (`puerto_correo::EnviadorCorreoSmtp` allí donde se ejecuta).
pub struct EnviadorCorreoDigestPlantilla {
    enviador: Arc<dyn EnviadorCorreo>,
}

impl EnviadorCorreoDigestPlantilla {
    pub fn new(enviador: Arc<dyn EnviadorCorreo>) -> Self {
        Self { enviador }
    }
}

#[async_trait]
impl EnviadorCorreoDigest for EnviadorCorreoDigestPlantilla {
    async fn enviar(&self, correo: &CorreoDigest) -> Result<(), ErrorCorreo> {
        let renderizado = PLANTILLAS.renderizar(correo.para.clone(), Contexto::de(correo))?;
        self.enviador.enviar(&renderizado).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn digest() -> CorreoDigest {
        CorreoDigest {
            para: "ada@example.com".to_string(),
            nombre: "example".to_string(),
        }
    }

    #[test]
    fn deberia_renderizar_todas_las_plantillas_cuando_el_correo_tiene_sus_campos() {
        // Actuar
        let renderizado = PLANTILLAS.renderizar("ada@example.com", Contexto::de(&digest()));

        // Comprobar
        let renderizado = match renderizado {
            Ok(renderizado) => renderizado,
            Err(err) => panic!("plantillas/digest/ no se renderiza: {err}"),
        };
        assert!(!renderizado.asunto.is_empty());
        assert!(!renderizado.html.is_empty());
        assert!(renderizado.texto.is_some());
    }

    #[tokio::test]
    async fn deberia_enviar_el_correo_renderizado_a_su_destinatario() {
        // Preparar
        let grabador = Arc::new(EnviadorCorreoGrabador::new());
        let enviador = EnviadorCorreoDigestPlantilla::new(grabador.clone());

        // Actuar
        let resultado = enviador.enviar(&digest()).await;

        // Comprobar
        assert_eq!(resultado, Ok(()));
        let enviados = grabador.enviados();
        assert_eq!(enviados.len(), 1);
        assert_eq!(enviados[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn deberia_devolver_el_error_del_enviador_cuando_el_envio_falla() {
        // Preparar
        let rechazado = ErrorCorreo::Permanente("550 no such user".to_string());
        let enviador = EnviadorCorreoDigestPlantilla::new(Arc::new(
            EnviadorCorreoGrabador::fallando_con(rechazado.clone()),
        ));

        // Actuar
        let resultado = enviador.enviar(&digest()).await;

        // Comprobar
        assert_eq!(resultado, Err(rechazado));
    }
}

