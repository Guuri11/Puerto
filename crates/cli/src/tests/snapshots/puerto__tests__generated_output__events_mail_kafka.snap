[package]
name = "aplicacion_producto"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_producto = { workspace = true }
puerto-nucleo = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_producto/pruebas"]

[dev-dependencies]
dominio_producto = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/producto/aplicacion/src/actualizar_producto.rs ===
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_producto::errores::ErrorProducto;
use dominio_producto::modelo::{IdProducto, Producto, PropsProducto};
use dominio_producto::repositorio::RepositorioProducto;
use dominio_producto::unit_of_work::UnitOfWorkFactoryProducto;
use dominio_producto::valores::{Name, Sku, Status};
use std::collections::HashMap;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsActualizarProducto {
    pub id: IdProducto,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

#[async_trait]
pub trait ActualizarProducto: Send + Sync {
    async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarProducto {}

        #[async_trait]
        impl ActualizarProducto for ActualizarProducto {
            async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto>;
        }
    }
}

pub struct ActualizarProductoImpl {
    pub repositorio: Arc<dyn RepositorioProducto>,
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProducto>,
}

#[async_trait]
impl ActualizarProducto for ActualizarProductoImpl {
    #[tracing::instrument(name = "actualizar_producto", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorProducto::NoEncontrado)?;
        let name = Name::new(params.name)?;
        let sku = Sku::new(params.sku)?;
        let status = params.status.parse::<Status>()?;
        let evento = entidad.actualizar(PropsProducto {
            name,
            sku,
            price: params.price,
            status,
            tags: params.tags,
            released_at: params.released_at,
            meta: params.meta,
        })?;
        self.uow_factory.guardar(&entidad, evento).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::{
        modelo::IdProducto, pruebas::madres::MadreProducto,
        repositorio::dobles::MockRepositorioProducto,
        unit_of_work::dobles::UnitOfWorkFactoryGrabadora,
    };
    use puerto_nucleo::EventoDominio;

    fn repositorio_con(entidad: Producto) -> MockRepositorioProducto {
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble
    }

    #[tokio::test]
    async fn deberia_registrar_el_evento_producto_actualizado_cuando_los_parametros_son_validos() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: id_entidad,
                name: props.name.valor().to_string(),
                sku: props.sku.valor().to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
                tags: props.tags,
                released_at: props.released_at,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "producto_actualizado");
        assert_eq!(grabado.eventos[0].id_agregado(), id_entidad.valor());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_sin_registrar_nada_cuando_producto_no_existe() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: IdProducto::generar(),
                name: props.name.valor().to_string(),
                sku: props.sku.valor().to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
                tags: props.tags,
                released_at: props.released_at,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.no_encontrado");
        let grabado = uow_factory.grabado();
        assert!(grabado.guardados.is_empty());
        assert!(grabado.eventos.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_name_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: id_entidad,
                name: "".to_string(),
                sku: props.sku.valor().to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
                tags: props.tags,
                released_at: props.released_at,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.name_invalido");
        assert!(uow_factory.grabado().guardados.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_sku_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: id_entidad,
                name: props.name.valor().to_string(),
                sku: "".to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
                tags: props.tags,
                released_at: props.released_at,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.sku_invalido");
        assert!(uow_factory.grabado().guardados.is_empty());
    }
}

