[dev-dependencies]
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/producto/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorProducto {
    #[error("producto.validacion.{0}")]
    Validacion(String),
    #[error("producto.no_encontrado")]
    NoEncontrado,
    #[error("producto.duplicado")]
    Duplicado,
    #[error("producto.repositorio")]
    Repositorio,
    #[error("producto.desconocido")]
    Desconocido,
    #[error("producto.name_invalido")]
    NameInvalido,
    #[error("producto.sku_invalido")]
    SkuInvalido,
    #[error("producto.status_invalido")]
    StatusInvalido,
}

impl From<ErrorRepositorio> for ErrorProducto {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorProducto::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "producto.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorProducto::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "producto.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorProducto::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "producto.repositorio");
    }
}

=== contextos/producto/dominio/src/eventos.rs ===
// GENERADO por puerto desde puerto.toml — no lo edites a mano. El snapshot sigue los campos de la
// entidad; añade un evento con `puerto generar evento Producto <nombre>`.
use chrono::{DateTime, Utc};
use puerto_nucleo::EventoDominio;
use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use uuid::Uuid;

use crate::modelo::Producto;

pub const PRODUCTO_CREADO: &str = "producto_creado";
pub const PRODUCTO_ACTUALIZADO: &str = "producto_actualizado";
pub const PRODUCTO_BORRADO: &str = "producto_borrado";
pub const PRODUCTO_PUBLISHED: &str = "producto_published";

/// Lo que lleva cada evento de producto: sus datos tal como los muestra la API — primitivos, con
/// los objetos valor desenvueltos. Un contrato público: los consumidores lo decodifican con
/// `evento.decodificar::<SnapshotProducto>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct SnapshotProducto {
    pub id: Uuid,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

impl SnapshotProducto {
    pub fn from_entidad(entidad: &Producto) -> Self {
        Self {
            id: entidad.id.valor(),
            name: entidad.name.valor().to_string(),
            sku: entidad.sku.valor().to_string(),
            price: entidad.price,
            status: entidad.status.as_str().to_string(),
            tags: entidad.tags.clone(),
            released_at: entidad.released_at,
            meta: entidad.meta.clone(),
        }
    }
}

/// Lo que le pasa a cada producto. Lo emiten los métodos de `Producto` (`crear`, `actualizar`,
/// `borrar`, los tuyos) y lo guarda la unidad de trabajo junto a la entidad (ADR-0026 de Puerto).
#[must_use = "un evento emitido se guarda con la entidad: `uow_factory.guardar(&entidad, evento)`"]
#[derive(Debug, Clone, PartialEq)]
pub enum EventoProducto {
    Creado(SnapshotProducto),
    Actualizado(SnapshotProducto),
    Borrado(SnapshotProducto),
    Published(SnapshotProducto),
}

impl EventoProducto {
    pub fn snapshot(&self) -> &SnapshotProducto {
        match self {
            Self::Creado(snapshot)
            | Self::Actualizado(snapshot)
            | Self::Borrado(snapshot)
            | Self::Published(snapshot) => snapshot,
        }
    }
}

impl EventoDominio for EventoProducto {
    fn tipo_evento(&self) -> &'static str {
        match self {
            Self::Creado(_) => PRODUCTO_CREADO,
            Self::Actualizado(_) => PRODUCTO_ACTUALIZADO,
            Self::Borrado(_) => PRODUCTO_BORRADO,
            Self::Published(_) => PRODUCTO_PUBLISHED,
        }
    }

    fn tipo_agregado(&self) -> &'static str {
        "producto"
    }

    fn id_agregado(&self) -> Uuid {
        self.snapshot().id
    }

    fn version_esquema(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // Un snapshot solo tiene primitivos: serializarlo no puede fallar.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreProducto;

    #[test]
    fn deberia_describir_cada_evento_cuando_se_registra() {
        // Preparar
        let entidad = MadreProducto::aleatorio();
        let snapshot = SnapshotProducto::from_entidad(&entidad);
        let eventos = [
            (EventoProducto::Creado(snapshot.clone()), "producto_creado"),
            (
                EventoProducto::Actualizado(snapshot.clone()),
                "producto_actualizado",
            ),
            (
                EventoProducto::Borrado(snapshot.clone()),
                "producto_borrado",
            ),
            (
                EventoProducto::Published(snapshot.clone()),
                "producto_published",
            ),
        ];

        for (evento, tipo_evento) in eventos {
            // Actuar y comprobar
            assert_eq!(evento.tipo_evento(), tipo_evento);
            assert_eq!(evento.tipo_agregado(), "producto");
            assert_eq!(evento.id_agregado(), entidad.id.valor());
            assert_eq!(evento.version_esquema(), 1);
            assert_eq!(evento.snapshot(), &snapshot);
        }
    }

    #[test]
    fn deberia_mantener_el_contrato_json_cuando_se_serializa_el_snapshot() {
        // Preparar
        let snapshot = SnapshotProducto::from_entidad(&MadreProducto::aleatorio());

        // Actuar
        let payload = EventoProducto::Creado(snapshot.clone()).payload();

        // Comprobar — una clave renombrada o quitada rompe a cada consumidor de estos eventos.
        let mut claves: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        claves.sort_unstable();
        assert_eq!(
            claves,
            [
                "id",
                "meta",
                "name",
                "price",
                "releasedAt",
                "sku",
                "status",
                "tags"
            ]
        );
        assert_eq!(
            serde_json::from_value::<SnapshotProducto>(payload).ok(),
            Some(snapshot)
        );
    }
}

