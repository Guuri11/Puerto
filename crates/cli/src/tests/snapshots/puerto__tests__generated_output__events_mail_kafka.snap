=== contextos/correo/dominio/src/price_alert.rs ===
//! El correo `price_alert`: lo que lleva y el puerto que lo envía. Lo escribe una vez
//! `puerto generar correo`; desde entonces es tuyo: añade un campo, renombra otro, calcula el
//! destinatario. Su texto está en `contextos/correo/infraestructura/plantillas/price_alert/`, y lo
//! renderiza `EnviadorCorreoPriceAlertPlantilla`.

use async_trait::async_trait;
use puerto_nucleo::correo::ErrorCorreo;

/// Lo que dice el correo `price_alert`: a quién va y los valores que muestran sus plantillas.
#[derive(Debug, Clone, PartialEq)]
pub struct CorreoPriceAlert {
    pub para: String,
    pub name: String,
    pub price: i64,
}

/// Envía el correo `price_alert`. `EnviadorCorreoPriceAlertPlantilla` (infraestructura) lo
/// renderiza y lo envía; los tests usan `dobles::MockEnviadorCorreoPriceAlert`.
#[async_trait]
pub trait EnviadorCorreoPriceAlert: Send + Sync {
    async fn enviar(&self, correo: &CorreoPriceAlert) -> Result<(), ErrorCorreo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use super::*;
    use mockall::mock;

    mock! {
        pub EnviadorCorreoPriceAlert {}

        #[async_trait]
        impl EnviadorCorreoPriceAlert for EnviadorCorreoPriceAlert {
            async fn enviar(&self, correo: &CorreoPriceAlert) -> Result<(), ErrorCorreo>;
        }
    }
}

=== contextos/correo/dominio/src/producto_live.rs ===
//! El correo `producto_live`: lo que lleva y el puerto que lo envía. Lo escribe una vez
//! `puerto generar correo`; desde entonces es tuyo: añade un campo, renombra otro, calcula el
//! destinatario. Su texto está en `contextos/correo/infraestructura/plantillas/producto_live/`, y lo
//! renderiza `EnviadorCorreoProductoLivePlantilla`.

use async_trait::async_trait;
use chrono::{DateTime, Utc};
use puerto_nucleo::correo::ErrorCorreo;

/// Lo que dice el correo `producto_live`: a quién va y los valores que muestran sus plantillas.
#[derive(Debug, Clone, PartialEq)]
pub struct CorreoProductoLive {
    pub para: String,
    pub name: String,
    pub price: i64,
    pub status: String,
    pub released_at: Option<DateTime<Utc>>,
}

/// Envía el correo `producto_live`. `EnviadorCorreoProductoLivePlantilla` (infraestructura) lo
/// renderiza y lo envía; los tests usan `dobles::MockEnviadorCorreoProductoLive`.
#[async_trait]
pub trait EnviadorCorreoProductoLive: Send + Sync {
    async fn enviar(&self, correo: &CorreoProductoLive) -> Result<(), ErrorCorreo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use super::*;
    use mockall::mock;

    mock! {
        pub EnviadorCorreoProductoLive {}

        #[async_trait]
        impl EnviadorCorreoProductoLive for EnviadorCorreoProductoLive {
            async fn enviar(&self, correo: &CorreoProductoLive) -> Result<(), ErrorCorreo>;
        }
    }
}

