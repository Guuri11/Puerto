=== presentacion/worker/src/consumidores/correo_price_alert.rs ===
//! `correo_price_alert`: envía el correo `price_alert` tras `producto_published`. Lo escribe una vez
//! `puerto generar correo --tras`; desde entonces es tuyo: cambia a quién va, sáltate algunos
//! eventos, añade valores que el snapshot no lleva.
//!
//! La entrega es al menos una vez: `enviar_una_vez` guarda una fila en `correos_enviados` por
//! evento, así que un evento que se vuelve a entregar no envía el correo otra vez. Deja `CORREO`
//! como está: renombrarlo vuelve a enviar todos los correos.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::price_alert::{CorreoPriceAlert, EnviadorCorreoPriceAlert};
use dominio_producto::eventos::{PRODUCTO_PUBLISHED, SnapshotProducto};
use puerto_correo::enviar_una_vez;
use puerto_nucleo::correo::CorreosEnviados;
use puerto_nucleo::eventos::{
    MOTIVO_PAYLOAD_INVALIDO, ManejadorEvento, ResultadoManejo, SobreEvento,
};

/// La clave de este correo en `correos_enviados`.
const CORREO: &str = "price_alert";

pub struct EnviarCorreoPriceAlert {
    pub enviador: Arc<dyn EnviadorCorreoPriceAlert>,
    pub correos_enviados: Arc<dyn CorreosEnviados>,
}

#[async_trait]
impl ManejadorEvento for EnviarCorreoPriceAlert {
    async fn manejar(&self, evento: &SobreEvento) -> ResultadoManejo {
        let correo = match evento.tipo_evento.as_str() {
            PRODUCTO_PUBLISHED => match evento.decodificar::<SnapshotProducto>() {
                Ok(producto) => CorreoPriceAlert {
                    para: producto.name.clone(),
                    name: producto.name,
                    price: producto.price,
                },
                Err(err) => {
                    return ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle);
                }
            },
            // No es uno de sus eventos (puerto.toml `[[correo]] tras`): nada que enviar.
            _ => return ResultadoManejo::Ack,
        };
        if correo.para.trim().is_empty() {
            tracing::warn!(id_evento = %evento.id, "correo_price_alert: sin destinatario, no se envía");
            return ResultadoManejo::Ack;
        }
        enviar_una_vez(
            self.correos_enviados.as_ref(),
            evento.id,
            CORREO,
            self.enviador.enviar(&correo),
        )
        .await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_correo::price_alert::dobles::MockEnviadorCorreoPriceAlert;
    use dominio_producto::eventos::EventoProducto;
    use dominio_producto::pruebas::madres::MadreProducto;
    use puerto_correo::pruebas::CorreosEnviadosEnMemoria;
    use puerto_nucleo::correo::ErrorCorreo;
    use puerto_nucleo::eventos::MOTIVO_ERROR_PERMANENTE;

    fn producto_published() -> (SnapshotProducto, SobreEvento) {
        let snapshot = SnapshotProducto::from_entidad(&MadreProducto::aleatorio());
        let evento = SobreEvento::new(&EventoProducto::Published(snapshot.clone()));
        (snapshot, evento)
    }

    /// Un enviador que espera enviar `times` correos, y cada uno responde `resultado`.
    fn enviador(times: usize, resultado: Result<(), ErrorCorreo>) -> MockEnviadorCorreoPriceAlert {
        let mut enviador = MockEnviadorCorreoPriceAlert::new();
        enviador
            .expect_enviar()
            .times(times)
            .returning(move |_| resultado.clone());
        enviador
    }

    fn manejador(enviador: MockEnviadorCorreoPriceAlert) -> EnviarCorreoPriceAlert {
        EnviarCorreoPriceAlert {
            enviador: Arc::new(enviador),
            correos_enviados: Arc::new(CorreosEnviadosEnMemoria::new()),
        }
    }

    #[tokio::test]
    async fn deberia_enviar_el_correo_a_name_cuando_llega_un_evento_producto_published() {
        // Preparar
        let (snapshot, evento) = producto_published();
        let mut doble = MockEnviadorCorreoPriceAlert::new();
        doble
            .expect_enviar()
            .withf(move |correo| correo.para == snapshot.name)
            .times(1)
            .returning(|_| Ok(()));

        // Actuar
        let resultado = manejador(doble).manejar(&evento).await;

        // Comprobar
        assert_eq!(resultado, ResultadoManejo::Ack);
    }

    #[tokio::test]
    async fn deberia_enviarlo_una_vez_cuando_el_mismo_evento_llega_dos_veces() {
        // Preparar
        let (_, evento) = producto_published();
        let manejador = manejador(enviador(1, Ok(())));

        // Actuar
        let primero = manejador.manejar(&evento).await;
        let segundo = manejador.manejar(&evento).await;

        // Comprobar
        assert_eq!(
            (primero, segundo),
            (ResultadoManejo::Ack, ResultadoManejo::Ack)
        );
    }

    #[tokio::test]
    async fn deberia_descartar_sin_enviar_cuando_el_payload_esta_mal_formado() {
        // Preparar
        let (_, mut evento) = producto_published();
        evento.payload = serde_json::json!({ "unexpected": true });

        // Actuar
        let resultado = manejador(enviador(0, Ok(()))).manejar(&evento).await;

        // Comprobar
        assert!(
            matches!(
                resultado,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_PAYLOAD_INVALIDO,
                    ..
                }
            ),
            "{resultado:?}"
        );
    }

    #[tokio::test]
    async fn deberia_reintentar_cuando_el_servidor_de_correo_no_esta_disponible() {
        // Preparar
        let (_, evento) = producto_published();
        let rechazado = Err(ErrorCorreo::Transitorio("connection refused".to_string()));

        // Actuar
        let resultado = manejador(enviador(1, rechazado)).manejar(&evento).await;

        // Comprobar
        assert_eq!(resultado, ResultadoManejo::Reintentar);
    }

    #[tokio::test]
    async fn deberia_descartar_cuando_el_servidor_rechaza_el_correo() {
        // Preparar
        let (_, evento) = producto_published();
        let rechazado = Err(ErrorCorreo::Permanente("550 no such user".to_string()));

        // Actuar
        let resultado = manejador(enviador(1, rechazado)).manejar(&evento).await;

        // Comprobar
        assert!(
            matches!(
                resultado,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_ERROR_PERMANENTE,
                    ..
                }
            ),
            "{resultado:?}"
        );
    }
}

=== presentacion/worker/src/consumidores/correo_producto_live.rs ===
//! `correo_producto_live`: envía el correo `producto_live` tras `producto_creado`, `producto_published`. Lo escribe una vez
//! `puerto generar correo --tras`; desde entonces es tuyo: cambia a quién va, sáltate algunos
//! eventos, añade valores que el snapshot no lleva.
//!
//! La entrega es al menos una vez: `enviar_una_vez` guarda una fila en `correos_enviados` por
//! evento, así que un evento que se vuelve a entregar no envía el correo otra vez. Deja `CORREO`
//! como está: renombrarlo vuelve a enviar todos los correos.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::producto_live::{CorreoProductoLive, EnviadorCorreoProductoLive};
use dominio_producto::eventos::{PRODUCTO_CREADO, PRODUCTO_PUBLISHED, SnapshotProducto};
use puerto_correo::enviar_una_vez;
use puerto_nucleo::correo::CorreosEnviados;
use puerto_nucleo::eventos::{
    MOTIVO_PAYLOAD_INVALIDO, ManejadorEvento, ResultadoManejo, SobreEvento,
};

/// La clave de este correo en `correos_enviados`.
const CORREO: &str = "producto_live";

pub struct EnviarCorreoProductoLive {
    pub enviador: Arc<dyn EnviadorCorreoProductoLive>,
    pub correos_enviados: Arc<dyn CorreosEnviados>,
}

#[async_trait]
impl ManejadorEvento for EnviarCorreoProductoLive {
    async fn manejar(&self, evento: &SobreEvento) -> ResultadoManejo {
        let correo = match evento.tipo_evento.as_str() {
            PRODUCTO_CREADO => match evento.decodificar::<SnapshotProducto>() {
                Ok(producto) => CorreoProductoLive {
                    para: producto.sku.clone(),
                    name: producto.name,
                    price: producto.price,
                    status: producto.status,
                    released_at: producto.released_at,
                },
                Err(err) => {
                    return ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle);
                }
            },
            PRODUCTO_PUBLISHED => match evento.decodificar::<SnapshotProducto>() {
                Ok(producto) => CorreoProductoLive {
                    para: producto.sku.clone(),
                    name: producto.name,
                    price: producto.price,
                    status: producto.status,
                    released_at: producto.released_at,
                },
                Err(err) => {
                    return ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle);
                }
            },
            // No es uno de sus eventos (puerto.toml `[[correo]] tras`): nada que enviar.
            _ => return ResultadoManejo::Ack,
        };
        if correo.para.trim().is_empty() {
            tracing::warn!(id_evento = %evento.id, "correo_producto_live: sin destinatario, no se envía");
            return ResultadoManejo::Ack;
        }
        enviar_una_vez(
            self.correos_enviados.as_ref(),
            evento.id,
            CORREO,
            self.enviador.enviar(&correo),
        )
        .await
    }
}

