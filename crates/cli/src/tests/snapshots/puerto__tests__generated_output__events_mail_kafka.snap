            matches!(
                resultado,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_PAYLOAD_INVALIDO,
                    ..
                }
            ),
            "{resultado:?}"
        );
    }
}

=== presentacion/worker/src/generado.rs ===
pub mod registro;

=== presentacion/worker/src/generado/registro.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`; añade un
// consumidor con `puerto generar consumidor <nombre> --tras <tipo_evento>`.
use std::sync::Arc;

use dominio_producto::eventos::{PRODUCTO_CREADO, PRODUCTO_PUBLISHED};
use infra_correo::price_alert::EnviadorCorreoPriceAlertPlantilla;
use infra_correo::producto_live::EnviadorCorreoProductoLivePlantilla;
use puerto_correo::{ConfigCorreo, EnviadorCorreoSmtp};
use puerto_eventos::{Bucles, ConfigWorker};
use puerto_kafka::{ConfigKafka, PublicadorKafka, SuscripcionKafka};
use puerto_sqlx::correo::CorreosEnviadosPostgres;
use puerto_sqlx::eventos::{DescartadosPostgres, OutboxPostgres};

use crate::consumidores::correo_price_alert::EnviarCorreoPriceAlert;
use crate::consumidores::correo_producto_live::EnviarCorreoProductoLive;
use crate::consumidores::notify_new_producto::NotifyNewProducto;

/// El relay y un consumidor por cada `[[consumidor]]`, sobre el transporte `kafka`: el relay
/// publica cada evento en el topic de su agregado, `<KAFKA_TOPIC_PREFIX>.<agregado>`, y cada
/// consumidor es un grupo de consumidores sobre los topics de sus eventos. Los descartados se
/// quedan en Postgres.
pub async fn construir_worker(config: ConfigWorker) -> Result<Bucles, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL no está definida — defínela en .env (.env.example trae una)".to_string()
    })?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — ¿está arrancada la base de datos? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;
    let kafka = ConfigKafka::from_env("snapshot").map_err(|e| e.to_string())?;
    kafka
        .asegurar_topics(&["producto"])
        .await
        .map_err(|e| format!("no se pueden crear los topics de Kafka: {e} — ¿está arrancado el broker? `make docker-compose/up`"))?;
    let publicador = PublicadorKafka::new(&kafka)
        .map_err(|e| format!("no se puede crear el productor de Kafka: {e}"))?;
    // Los correos que se envían tras eventos (ADR-0020): un cliente SMTP y un registro de enviados
    // para todos.
    let enviador = Arc::new(
        EnviadorCorreoSmtp::new(&ConfigCorreo::from_env().map_err(|e| e.to_string())?)
            .map_err(|e| e.to_string())?,
    );
    let correos_enviados = Arc::new(CorreosEnviadosPostgres::new(pool.clone()));
    let descartados = Arc::new(DescartadosPostgres::new(pool.clone()));

    Ok(Bucles::new(&config)
        .relay(OutboxPostgres::new(pool.clone()), publicador)
        .consumidor(
            SuscripcionKafka::new(
                &kafka,
                "notify_new_producto",
                &["producto"],
                &[PRODUCTO_CREADO, PRODUCTO_PUBLISHED],
                descartados.clone(),
            )
            .map_err(|e| format!("no se puede suscribir notify_new_producto a Kafka: {e}"))?,
            NotifyNewProducto::construir(&pool),
            descartados.clone(),
        )
        .consumidor(
            SuscripcionKafka::new(
                &kafka,
                "correo_producto_live",
                &["producto"],
                &[PRODUCTO_CREADO, PRODUCTO_PUBLISHED],
                descartados.clone(),
            )
            .map_err(|e| format!("no se puede suscribir correo_producto_live a Kafka: {e}"))?,
            EnviarCorreoProductoLive {
                enviador: Arc::new(EnviadorCorreoProductoLivePlantilla::new(enviador.clone())),
                correos_enviados: correos_enviados.clone(),
            },
            descartados.clone(),
        )
        .consumidor(
            SuscripcionKafka::new(
                &kafka,
                "correo_price_alert",
                &["producto"],
                &[PRODUCTO_PUBLISHED],
                descartados.clone(),
            )
            .map_err(|e| format!("no se puede suscribir correo_price_alert a Kafka: {e}"))?,
            EnviarCorreoPriceAlert {
                enviador: Arc::new(EnviadorCorreoPriceAlertPlantilla::new(enviador.clone())),
                correos_enviados: correos_enviados.clone(),
            },
            descartados,
        ))
}

=== presentacion/worker/src/main.rs ===
mod consumidores;
mod generado;

/// El segundo proceso de este proyecto (ADR-0018 de Puerto): hace de relay del outbox que escribe
/// la API y ejecuta los consumidores. Los bucles, las sondas de salud y el apagado ordenado vienen
/// del runtime de Puerto, `puerto-eventos`; el cableado está en `generado/registro.rs`, y los
/// consumidores, en `consumidores/`.
#[tokio::main]
async fn main() -> Result<(), puerto_eventos::Error> {
    let config = puerto_eventos::ConfigWorker::from_env()?;
    puerto_eventos::Worker::new(config)
        .intentar_ejecutar(generado::registro::construir_worker)
        .await
}

=== puerto.toml ===
[proyecto]
nombre = "snapshot"
