    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Name</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {personas.map((persona) => (
            <tr key={persona.id}>
              <td>{persona.name}</td>
              <td className="text-right">
                <Link href={`/personas/${persona.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/persona.ts ===
import { PersonaError } from "../domain/persona/errors";
import type { Persona, PersonaDraft } from "../domain/persona/model";
import type { PersonaRepository } from "../domain/persona/repository";

/** Valid personas for tests; pass `overrides` for the fields a test is about. */
export const PersonaMother = {
  draft(overrides: Partial<PersonaDraft> = {}): PersonaDraft {
    return {
      name: "example",
      ...overrides,
    };
  },

  random(overrides: Partial<Persona> = {}): Persona {
    return { id: crypto.randomUUID(), ...PersonaMother.draft(), ...overrides };
  },
};

/** An in-memory `PersonaRepository`. Override a method to make it fail. */
export function fakePersonaRepository(seed: Persona[] = []): PersonaRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new PersonaError("persona.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
