=== contextos/persona/rest/src/respuestas.rs ===
// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoPaginaPersona, DtoPersona};

#[derive(ApiResponse)]
pub enum RespuestaCrearPersona {
    #[oai(status = 201)]
    Creado(Json<DtoPersona>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearPersona {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerPersona {
    #[oai(status = 200)]
    Ok(Json<DtoPersona>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerPersona {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarPersonas {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaPersona>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarPersonas {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarPersona {
    #[oai(status = 200)]
    Ok(Json<DtoPersona>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarPersona {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarPersona {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaBorrarPersona {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

=== contextos/persona/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_persona::{
    actualizar_persona::{ActualizarPersona, ParamsActualizarPersona},
    borrar_persona::{BorrarPersona, ParamsBorrarPersona},
    crear_persona::{CrearPersona, ParamsCrearPersona},
    listar_personas::{ListarPersonas, ParamsListarPersonas},
    obtener_persona::{ObtenerPersona, ParamsObtenerPersona},
};
use dominio_persona::modelo::IdPersona;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoPaginaPersona, DtoPersona, PeticionActualizarPersona, PeticionCrearPersona};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarPersona, RespuestaBorrarPersona, RespuestaCrearPersona,
    RespuestaListarPersonas, RespuestaObtenerPersona,
};

#[derive(Tags)]
enum ApiTags {
    Persona,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiPersona {
    pub crear_persona: Arc<dyn CrearPersona>,
    pub obtener_persona: Arc<dyn ObtenerPersona>,
    pub listar_personas: Arc<dyn ListarPersonas>,
    pub actualizar_persona: Arc<dyn ActualizarPersona>,
    pub borrar_persona: Arc<dyn BorrarPersona>,
}

#[OpenApi]
impl ApiPersona {
    /// Crea: Persona
    #[oai(path = "/personas", method = "post", tag = "ApiTags::Persona")]
    async fn crear(&self, cuerpo: Json<PeticionCrearPersona>) -> RespuestaCrearPersona {
        match self
            .crear_persona
            .ejecutar(ParamsCrearPersona {
                name: cuerpo.name.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearPersona::Creado(Json(DtoPersona::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_persona falló");
                RespuestaCrearPersona::from_status(status, error)
            }
        }
    }

    /// Obtiene: Persona por id
    #[oai(path = "/personas/:id", method = "get", tag = "ApiTags::Persona")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerPersona {
        match self
            .obtener_persona
            .ejecutar(ParamsObtenerPersona {
                id: IdPersona::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerPersona::Ok(Json(DtoPersona::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_persona falló");
                RespuestaObtenerPersona::from_status(status, error)
            }
        }
    }

    /// Lista Personas, página a página (el dominio acota `limite`)
    #[oai(path = "/personas", method = "get", tag = "ApiTags::Persona")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarPersonas {
        match self
            .listar_personas
            .ejecutar(ParamsListarPersonas {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarPersonas::Ok(Json(DtoPaginaPersona::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_personas falló");
                RespuestaListarPersonas::from_status(status, error)
            }
        }
    }

    /// Actualiza: Persona
    #[oai(path = "/personas/:id", method = "put", tag = "ApiTags::Persona")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarPersona>,
    ) -> RespuestaActualizarPersona {
        match self
            .actualizar_persona
            .ejecutar(ParamsActualizarPersona {
                id: IdPersona::from_uuid(id.0),
                name: cuerpo.name.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarPersona::Ok(Json(DtoPersona::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_persona falló");
                RespuestaActualizarPersona::from_status(status, error)
            }
        }
    }

    /// Borra: Persona
    #[oai(path = "/personas/:id", method = "delete", tag = "ApiTags::Persona")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarPersona {
        match self
            .borrar_persona
            .ejecutar(ParamsBorrarPersona {
                id: IdPersona::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarPersona::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_persona falló");
                RespuestaBorrarPersona::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_persona::{
        actualizar_persona::dobles::MockActualizarPersona,
        borrar_persona::dobles::MockBorrarPersona, crear_persona::dobles::MockCrearPersona,
        listar_personas::dobles::MockListarPersonas, obtener_persona::dobles::MockObtenerPersona,
    };
    use dominio_persona::errores::ErrorPersona;
    use dominio_persona::pruebas::madres::MadrePersona;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearPersona,
        obtener: MockObtenerPersona,
        listar: MockListarPersonas,
        actualizar: MockActualizarPersona,
        borrar: MockBorrarPersona,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiPersona {
                crear_persona: Arc::new(self.crear),
                obtener_persona: Arc::new(self.obtener),
                listar_personas: Arc::new(self.listar),
                actualizar_persona: Arc::new(self.actualizar),
                borrar_persona: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearPersona {
        PeticionCrearPersona {
            name: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarPersona {
        PeticionActualizarPersona {
            name: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/personas/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_persona() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadrePersona::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/personas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_persona_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorPersona::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/personas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_persona_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadrePersona::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_persona_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorPersona::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_personas_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadrePersona::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/personas").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/personas?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorPersona::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/personas").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_persona() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadrePersona::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_persona_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorPersona::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_persona() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_persona_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorPersona::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

