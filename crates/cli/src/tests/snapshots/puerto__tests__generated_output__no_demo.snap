use async_trait::async_trait;
use dominio_persona::errores::ErrorPersona;
use dominio_persona::modelo::IdPersona;
use dominio_persona::repositorio::RepositorioPersona;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarPersona {
    pub id: IdPersona,
}

#[async_trait]
pub trait BorrarPersona: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarPersona) -> Result<(), ErrorPersona>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarPersona {}

        #[async_trait]
        impl BorrarPersona for BorrarPersona {
            async fn ejecutar(&self, params: ParamsBorrarPersona) -> Result<(), ErrorPersona>;
        }
    }
}

pub struct BorrarPersonaImpl {
    pub repositorio: Arc<dyn RepositorioPersona>,
}

#[async_trait]
impl BorrarPersona for BorrarPersonaImpl {
    async fn ejecutar(&self, params: ParamsBorrarPersona) -> Result<(), ErrorPersona> {
        tracing::info!(id = %params.id, "borrar_persona: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_persona: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = ErrorPersona::NoEncontrado;
                tracing::warn!(error = %err, "borrar_persona: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "borrar_persona: fallo del repositorio"),
        )?;
        Ok(())
    }
}

