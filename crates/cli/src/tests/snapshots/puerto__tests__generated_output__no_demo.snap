=== contextos/persona/dominio/src/modelo.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorPersona;

/// El id de cada `Persona`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdPersona(Uuid);

impl IdPersona {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdPersona {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsPersona {
    pub name: String,
}

#[derive(Debug, Clone)]
pub struct Persona {
    pub id: IdPersona,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: String,
}

impl Persona {
    pub fn new(props: PropsPersona) -> Result<Self, ErrorPersona> {
        if props.name.trim().is_empty() {
            return Err(ErrorPersona::Validacion("name_vacio".into()));
        }
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdPersona::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            name: props.name,
        })
    }

    pub fn from_repositorio(datos: Persona) -> Self {
        datos
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_crear_persona_cuando_los_campos_son_validos() {
        let resultado = Persona::new(PropsPersona {
            name: "example".to_string(),
        });
        assert_eq!(resultado.unwrap().name, "example");
    }

    #[test]
    fn deberia_rechazar_persona_cuando_name_es_una_cadena_vacia() {
        let resultado = Persona::new(PropsPersona { name: "".into() });
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "persona.validacion.name_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_persona_cuando_name_solo_tiene_espacios() {
        let resultado = Persona::new(PropsPersona { name: "   ".into() });
        assert!(resultado.is_err());
    }
}

=== contextos/persona/dominio/src/pruebas/madres.rs ===
use crate::modelo::Persona;
use crate::modelo::PropsPersona;

pub struct MadrePersona {
    name: Option<String>,
}

impl MadrePersona {
    pub fn new() -> Self {
        Self { name: None }
    }

    pub fn con_name(mut self, name: &str) -> Self {
        self.name = Some(name.to_string());
        self
    }

    pub fn con_name_vacio(mut self) -> Self {
        self.name = Some(String::new());
        self
    }

    pub fn construir(self) -> Persona {
        Persona::new(PropsPersona {
            name: self.name.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadrePersona: Persona::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsPersona {
        PropsPersona {
            name: self.name.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Persona {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Persona> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadrePersona {
    fn default() -> Self {
        Self::new()
    }
}

