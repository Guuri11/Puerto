use thiserror::Error;

#[derive(Debug, Error)]
pub enum PersonaError {
    #[error("persona.validation_error.{0}")]
    ValidationError(String),
    #[error("persona.not_found")]
    NotFound,
    #[error("persona.duplicate")]
    Duplicate,
    #[error("persona.repository_error")]
    RepositoryError,
    #[error("persona.unknown")]
    Unknown,
}

=== business/src/domain/persona/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::PersonaError;

#[derive(Debug, Clone)]
pub struct PersonaProps {
    pub name: String,
}

#[derive(Debug, Clone)]
pub struct Persona {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: String,
}

impl Persona {
    pub fn new(props: PersonaProps) -> Result<Self, PersonaError> {
        if props.name.trim().is_empty() {
            return Err(PersonaError::ValidationError("name_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
        })
    }

    pub fn from_repository(data: Persona) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_persona_when_name_is_valid() {
        let result = Persona::new(PersonaProps {
            name: "example".to_string(),
        });
        assert_eq!(result.unwrap().name, "example");
    }


    #[test]
    fn should_reject_persona_when_name_is_empty() {
        let result = Persona::new(PersonaProps {
            name: "".into(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "persona.validation_error.name_empty"
        );
    }

    #[test]
    fn should_reject_persona_when_name_is_only_whitespace() {
        let result = Persona::new(PersonaProps {
            name: "   ".into(),
        });
        assert!(result.is_err());
    }
}

