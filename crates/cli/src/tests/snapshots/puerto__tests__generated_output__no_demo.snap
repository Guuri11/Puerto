export type PersonaDraft = Omit<Persona, "id">;

=== web/src/domain/persona/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Persona, PersonaDraft } from "./model";

/** The port the screens call. Every method rejects with the `PersonaError` the API answered. */
export interface PersonaRepository {
  list(page: PageRequest): Promise<Page<Persona>>;
  get(id: string): Promise<Persona>;
  create(draft: PersonaDraft): Promise<Persona>;
  update(id: string, draft: PersonaDraft): Promise<Persona>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `RespuestaError.codigo` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "codigo" in error) {
    const { codigo } = error;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/persona/persona-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { PersonaError } from "../../domain/persona/errors";
import { PersonaMother } from "../../test-support/persona";
import { createApiClient } from "../http/client";
import { personaRepositoryHttp } from "./persona-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: personaRepositoryHttp(api), requests };
}

describe("personaRepositoryHttp", () => {
  test("should ask for the page and return its personas", async () => {
    // Arrange
    const persona = PersonaMother.random();
    const { repository, requests } = answering(200, {
      elementos: [persona],
      total: 21,
      limite: 20,
      desplazamiento: 20,
    });

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    const url = new URL(requests[0]?.url ?? "");
    expect(url.pathname).toBe("/api/personas");
    expect(url.search).toBe("?limite=20&desplazamiento=20");
    expect(listed).toEqual({ items: [persona], total: 21, limit: 20, offset: 20 });
  });

  test("should send the draft when creating a persona", async () => {
    // Arrange
    const draft = PersonaMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the persona does not exist", async () => {
    // Arrange
    const code = "persona.no_encontrado";
    const { repository } = answering(404, { codigo: code, mensaje: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(PersonaError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the persona", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/personas/42");
  });
});

=== web/src/infrastructure/persona/persona-repository-http.ts ===
import { PersonaError } from "../../domain/persona/errors";
import type { Persona, PersonaDraft } from "../../domain/persona/model";
import type { PersonaRepository } from "../../domain/persona/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type PersonaDto = components["schemas"]["DtoPersona"];
type PersonaRequest = components["schemas"]["PeticionCrearPersona"];

function toPersona(dto: PersonaDto): Persona {
  return {
    id: dto.id,
    name: dto.name,
  };
}

function toRequest(draft: PersonaDraft): PersonaRequest {
  return {
    name: draft.name,
  };
}

/** `PersonaRepository` over the REST API (`/personas`). */
export function personaRepositoryHttp(api: ApiClient): PersonaRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/personas", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toPersona),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/personas/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return toPersona(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/personas", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return toPersona(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/personas/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return toPersona(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/personas/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new PersonaError(apiErrorCode(error, response));
    },
  };
}

