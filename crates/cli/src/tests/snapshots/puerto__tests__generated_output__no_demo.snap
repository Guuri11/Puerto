use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::persona::{
    errors::PersonaError,
    model::Persona,
    repository::PersonaRepositoryTrait,
    use_cases::list_personas::{ListPersonasParams, ListPersonasUseCaseTrait},
};

pub struct ListPersonasUseCaseImpl {
    pub repository: Arc<dyn PersonaRepositoryTrait>,
}

#[async_trait]
impl ListPersonasUseCaseTrait for ListPersonasUseCaseImpl {
    async fn execute(&self, params: ListPersonasParams) -> Result<Page<Persona>, PersonaError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_personas: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_personas: repository failed"))
            .map_err(PersonaError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::persona::{
        model::{Persona, PersonaProps},
        repository::mocks::MockPersonaRepository,
    };
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_personas() {
        let entities = vec![
            Persona::new(PersonaProps {
                name: "first".to_string(),
            })
            .unwrap(),
            Persona::new(PersonaProps {
                name: "second".to_string(),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListPersonasUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListPersonasParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_personas_exist() {
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListPersonasUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListPersonasParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListPersonasUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListPersonasParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

