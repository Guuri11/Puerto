import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { PersonaError } from "../../../../domain/persona/errors";
import type { PersonaDraft } from "../../../../domain/persona/model";
import { fakePersonaRepository, PersonaMother } from "../../../../test-support/persona";
import { renderScreen } from "../../../../test-support/render";
import { PersonaFormContainer } from "./persona-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: PersonaDraft) {
  await screen.findByText("Save");
  type("Name", draft.name);
}

describe("PersonaFormContainer", () => {
  test("should create the persona from what was typed and show it", async () => {
    // Arrange
    const draft = PersonaMother.draft();
    const personaRepository = fakePersonaRepository();
    const { history } = renderScreen(<PersonaFormContainer />, { personaRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/personas/"));
    const {
      items: [created],
    } = await personaRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/personas/${created?.id}`);
  });

  test("should save the edited persona when an existing one is submitted", async () => {
    // Arrange
    const seeded = PersonaMother.random();
    const personaRepository = fakePersonaRepository([seeded]);
    const { history } = renderScreen(<PersonaFormContainer id={seeded.id} />, {
      personaRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/personas/${seeded.id}`));
    expect(await personaRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "persona.validation_error.invalid";
    const personaRepository = {
      ...fakePersonaRepository(),
      create: () => Promise.reject(new PersonaError(code)),
    };
    renderScreen(<PersonaFormContainer />, { personaRepository });
    await fillIn(PersonaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a persona with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const personaRepository = {
      ...fakePersonaRepository(),
      create: () => Promise.reject(new PersonaError("persona.duplicate")),
    };
    renderScreen(<PersonaFormContainer />, { personaRepository });
    await fillIn(PersonaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A persona with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const personaRepository = {
      ...fakePersonaRepository(),
      create: () => Promise.reject(new PersonaError("persona.validation_error.name_empty")),
    };
    renderScreen(<PersonaFormContainer />, { personaRepository });
    await fillIn(PersonaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Name is required")).toBeTruthy();
    const input = screen.getByLabelText("Name");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/persona/containers/persona-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/persona/messages";
import type { Persona } from "../../../../domain/persona/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { PersonaFormView, toPersonaDraft, toPersonaForm } from "../views/persona-form-view";

/** Creates a persona, or edits the one with `id`. */
export function PersonaFormContainer({ id }: { id?: string }) {
  const { personaRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : personaRepository.get(id)),
    [personaRepository, id],
  );
  const title = id === undefined ? "New persona" : "Edit persona";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <PersonaForm existing={existing.data} />}
      <Link href={id === undefined ? "/personas" : `/personas/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function PersonaForm({ existing }: { existing: Persona | null }) {
  const { personaRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toPersonaForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toPersonaDraft(values);
      const saved =
        existing === null
          ? await personaRepository.create(draft)
          : await personaRepository.update(existing.id, draft);
      navigate(`/personas/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <PersonaFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

=== web/src/presentation/features/persona/containers/persona-list-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { PersonaError } from "../../../../domain/persona/errors";
import { fakePersonaRepository, PersonaMother } from "../../../../test-support/persona";
import { renderScreen } from "../../../../test-support/render";
import { PersonaListContainer } from "./persona-list-container";

describe("PersonaListContainer", () => {
  test("should show a row per persona when there are some", async () => {
    // Arrange
    const seed = [PersonaMother.random(), PersonaMother.random()];
    const personaRepository = fakePersonaRepository(seed);

    // Act
    renderScreen(<PersonaListContainer />, { personaRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => PersonaMother.random());
    const personaRepository = fakePersonaRepository(seed);
    renderScreen(<PersonaListContainer />, { personaRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should say so when there is no persona", async () => {
    // Arrange
    const personaRepository = fakePersonaRepository();

    // Act
    renderScreen(<PersonaListContainer />, { personaRepository });

    // Assert
    expect(await screen.findByText("No personas yet.")).toBeTruthy();
  });

  test("should show the error code when the personas cannot be listed", async () => {
    // Arrange
    const personaRepository = {
      ...fakePersonaRepository(),
      list: () => Promise.reject(new PersonaError("persona.repository_error")),
    };

    // Act
    renderScreen(<PersonaListContainer />, { personaRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("persona.repository_error");
  });
});

=== web/src/presentation/features/persona/containers/persona-list-container.tsx ===
import { useState } from "react";
import { Link } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { Pagination } from "../../../shared/ui/pagination";
import { PersonaListView } from "../views/persona-list-view";

export function PersonaListContainer() {
  const { personaRepository } = useDependencies();
  const [offset, setOffset] = useState(0);
  const personas = useAsync(
    () => personaRepository.list({ limit: PAGE_SIZE, offset }),
    [personaRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Personas</h1>
        <Link href="/personas/new" className="btn btn-primary">
          New persona
        </Link>
      </div>
      {personas.status === "loading" && <span className="loading loading-spinner" />}
      {personas.status === "error" && <ErrorAlert error={personas.error} />}
      {personas.status === "ok" &&
        (personas.data.total === 0 ? (
          <EmptyState message="No personas yet." />
        ) : (
          <>
            <PersonaListView personas={personas.data.items} />
            <Pagination {...personas.data} onOffsetChange={setOffset} />
          </>
        ))}
    </section>
  );
}

