=== business/src/domain/persona/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum PersonaError {
    #[error("persona.validation_error.{0}")]
    ValidationError(String),
    #[error("persona.not_found")]
    NotFound,
    #[error("persona.duplicate")]
    Duplicate,
    #[error("persona.repository_error")]
    RepositoryError,
    #[error("persona.unknown")]
    Unknown,
}

impl From<RepositoryError> for PersonaError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = PersonaError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "persona.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = PersonaError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "persona.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = PersonaError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "persona.repository_error");
    }
}

=== business/src/domain/persona/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::PersonaError;

/// The id of every `Persona`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct PersonaId(Uuid);

impl PersonaId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for PersonaId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PersonaProps {
    pub name: String,
}

#[derive(Debug, Clone)]
pub struct Persona {
    pub id: PersonaId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: String,
}

impl Persona {
    pub fn new(props: PersonaProps) -> Result<Self, PersonaError> {
        if props.name.trim().is_empty() {
            return Err(PersonaError::ValidationError("name_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: PersonaId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
        })
    }

    pub fn from_repository(data: Persona) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_persona_when_name_is_valid() {
        let result = Persona::new(PersonaProps {
            name: "example".to_string(),
        });
        assert_eq!(result.unwrap().name, "example");
    }

    #[test]
    fn should_reject_persona_when_name_is_empty() {
        let result = Persona::new(PersonaProps { name: "".into() });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "persona.validation_error.name_empty"
        );
    }

    #[test]
    fn should_reject_persona_when_name_is_only_whitespace() {
        let result = Persona::new(PersonaProps { name: "   ".into() });
        assert!(result.is_err());
    }
}

