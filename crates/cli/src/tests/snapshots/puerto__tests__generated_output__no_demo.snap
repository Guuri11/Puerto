=== web/src/presentation/features/persona/views/persona-form-view.tsx ===
import type { Persona, PersonaDraft } from "../../../../domain/persona/model";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface PersonaFormValues {
  name: string;
}

/** The inputs for `persona`, empty when there is none yet. */
export function toPersonaForm(persona: Persona | null): PersonaFormValues {
  if (persona === null) {
    return {
      name: "",
    };
  }
  return {
    name: persona.name,
  };
}

export function toPersonaDraft(values: PersonaFormValues): PersonaDraft {
  return {
    name: values.name,
  };
}

export function PersonaFormView({
  values,
  saving,
  onChange,
  onSubmit,
}: {
  values: PersonaFormValues;
  saving: boolean;
  onChange: (values: PersonaFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

