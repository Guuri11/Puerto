use async_trait::async_trait;
use dominio_persona::errores::ErrorPersona;
use dominio_persona::modelo::Persona;
use dominio_persona::repositorio::RepositorioPersona;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarPersonas {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarPersonas: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarPersonas)
    -> Result<Pagina<Persona>, ErrorPersona>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarPersonas {}

        #[async_trait]
        impl ListarPersonas for ListarPersonas {
            async fn ejecutar(&self, params: ParamsListarPersonas) -> Result<Pagina<Persona>, ErrorPersona>;
        }
    }
}

pub struct ListarPersonasImpl {
    pub repositorio: Arc<dyn RepositorioPersona>,
}

#[async_trait]
impl ListarPersonas for ListarPersonasImpl {
    async fn ejecutar(
        &self,
        params: ParamsListarPersonas,
    ) -> Result<Pagina<Persona>, ErrorPersona> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_personas: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_personas: fallo del repositorio"))
            .map_err(ErrorPersona::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_persona::{
        modelo::{Persona, PropsPersona},
        repositorio::dobles::MockRepositorioPersona,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_personas() {
        let entidades = vec![
            Persona::new(PropsPersona {
                name: "first".to_string(),
            })
            .unwrap(),
            Persona::new(PropsPersona {
                name: "second".to_string(),
            })
            .unwrap(),
        ];
        let mut repositorio_doble = MockRepositorioPersona::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarPersonasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarPersonas {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_personas() {
        let mut repositorio_doble = MockRepositorioPersona::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarPersonasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarPersonas {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioPersona::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarPersonasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarPersonas {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

