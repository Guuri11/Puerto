use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::persona::{
    errors::PersonaError,
    repository::PersonaRepositoryTrait,
    use_cases::delete_persona::{DeletePersonaParams, DeletePersonaUseCaseTrait},
};

pub struct DeletePersonaUseCaseImpl {
    pub repository: Arc<dyn PersonaRepositoryTrait>,
}

#[async_trait]
impl DeletePersonaUseCaseTrait for DeletePersonaUseCaseImpl {
    async fn execute(&self, params: DeletePersonaParams) -> Result<(), PersonaError> {
        tracing::info!(id = %params.id, "delete_persona: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_persona: repository failed"))?
            .ok_or_else(|| {
                let err = PersonaError::NotFound;
                tracing::warn!(error = %err, "delete_persona: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "delete_persona: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::persona::{
        model::{Persona, PersonaProps},
        repository::mocks::MockPersonaRepository,
    };
    use uuid::Uuid;


    #[tokio::test]
    async fn should_soft_delete_persona_when_id_exists() {
        let entity = Persona::new(PersonaProps {
            name: "example".to_string(),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeletePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeletePersonaParams { id: entity_id })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_persona_does_not_exist() {
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeletePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeletePersonaParams { id: Uuid::new_v4() })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "persona.not_found");
    }
}

