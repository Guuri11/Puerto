// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::persona::create_persona::CreatePersonaUseCaseImpl;
use business::application::persona::delete_persona::DeletePersonaUseCaseImpl;
use business::application::persona::get_persona::GetPersonaUseCaseImpl;
use business::application::persona::list_personas::ListPersonasUseCaseImpl;
use business::application::persona::update_persona::UpdatePersonaUseCaseImpl;

use business::domain::persona::repository::PersonaRepositoryTrait;
use infrastructure::persona::repository::InMemoryPersonaRepository;

use poem::Endpoint;
use poem_openapi::OpenApiService;

use crate::api::persona::routes::PersonaApi;

/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let persona_repo: Arc<dyn PersonaRepositoryTrait> = Arc::new(InMemoryPersonaRepository::new());
    let create_persona = Arc::new(CreatePersonaUseCaseImpl {
        repository: Arc::clone(&persona_repo),
    });
    let get_persona = Arc::new(GetPersonaUseCaseImpl {
        repository: Arc::clone(&persona_repo),
    });
    let list_personas = Arc::new(ListPersonasUseCaseImpl {
        repository: Arc::clone(&persona_repo),
    });
    let update_persona = Arc::new(UpdatePersonaUseCaseImpl {
        repository: Arc::clone(&persona_repo),
    });
    let delete_persona = Arc::new(DeletePersonaUseCaseImpl {
        repository: persona_repo,
    });
    let persona_api = PersonaApi {
        create_persona,
        get_persona,
        list_personas,
        update_persona,
        delete_persona,
    };

    let ready = puerto_web::health::always_ready();

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::routes(
        openapi_service(persona_api),
        &config,
        ready,
    )))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;

    use business::domain::persona::use_cases::create_persona::mocks::MockCreatePersonaUseCase;
    use business::domain::persona::use_cases::delete_persona::mocks::MockDeletePersonaUseCase;
    use business::domain::persona::use_cases::get_persona::mocks::MockGetPersonaUseCase;
    use business::domain::persona::use_cases::list_personas::mocks::MockListPersonasUseCase;
    use business::domain::persona::use_cases::update_persona::mocks::MockUpdatePersonaUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let persona_api = PersonaApi {
            create_persona: Arc::new(MockCreatePersonaUseCase::new()),
            get_persona: Arc::new(MockGetPersonaUseCase::new()),
            list_personas: Arc::new(MockListPersonasUseCase::new()),
            update_persona: Arc::new(MockUpdatePersonaUseCase::new()),
            delete_persona: Arc::new(MockDeletePersonaUseCase::new()),
        };
        let spec = openapi_service(persona_api).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

