use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::persona::{
    errors::PersonaError,
    model::{Persona, PersonaProps},
    repository::PersonaRepositoryTrait,
    use_cases::create_persona::{CreatePersonaParams, CreatePersonaUseCaseTrait},
};

pub struct CreatePersonaUseCaseImpl {
    pub repository: Arc<dyn PersonaRepositoryTrait>,
}

#[async_trait]
impl CreatePersonaUseCaseTrait for CreatePersonaUseCaseImpl {
    async fn execute(&self, params: CreatePersonaParams) -> Result<Persona, PersonaError> {
        tracing::info!("create_persona: start");
        let entity = Persona::new(PersonaProps { name: params.name })
            .inspect_err(|e| tracing::warn!(error = %e, "create_persona: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_persona: repository failed"))?;
        tracing::info!(id = %entity.id, "create_persona: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::persona::repository::mocks::MockPersonaRepository;
    use puerto_core::RepositoryError;

    #[tokio::test]
    async fn should_create_persona_when_name_is_valid() {
        // Arrange
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreatePersonaParams {
                name: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().name, "example");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));
        let use_case = CreatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreatePersonaParams {
                name: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "persona.duplicate");
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let mock_repo = MockPersonaRepository::new();
        let use_case = CreatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreatePersonaParams {
                name: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "persona.validation_error.name_empty"
        );
    }
}

=== business/src/application/persona/delete_persona.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::persona::{
    errors::PersonaError,
    repository::PersonaRepositoryTrait,
    use_cases::delete_persona::{DeletePersonaParams, DeletePersonaUseCaseTrait},
};

pub struct DeletePersonaUseCaseImpl {
    pub repository: Arc<dyn PersonaRepositoryTrait>,
}

#[async_trait]
impl DeletePersonaUseCaseTrait for DeletePersonaUseCaseImpl {
    async fn execute(&self, params: DeletePersonaParams) -> Result<(), PersonaError> {
        tracing::info!(id = %params.id, "delete_persona: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_persona: repository failed"))?
            .ok_or_else(|| {
                let err = PersonaError::NotFound;
                tracing::warn!(error = %err, "delete_persona: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_persona: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::persona::{
        model::{Persona, PersonaId, PersonaProps},
        repository::mocks::MockPersonaRepository,
    };

    #[tokio::test]
    async fn should_soft_delete_persona_when_id_exists() {
        let entity = Persona::new(PersonaProps {
            name: "example".to_string(),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeletePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeletePersonaParams { id: entity_id })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_persona_does_not_exist() {
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeletePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeletePersonaParams {
                id: PersonaId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "persona.not_found");
    }
}

