// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod persona {
    use std::sync::Arc;

    use aplicacion_persona::actualizar_persona::{ActualizarPersona, ActualizarPersonaImpl};
    use aplicacion_persona::borrar_persona::{BorrarPersona, BorrarPersonaImpl};
    use aplicacion_persona::crear_persona::{CrearPersona, CrearPersonaImpl};
    use aplicacion_persona::listar_personas::{ListarPersonas, ListarPersonasImpl};
    use aplicacion_persona::obtener_persona::{ObtenerPersona, ObtenerPersonaImpl};
    use dominio_persona::repositorio::RepositorioPersona;
    use infra_persona::repositorio::RepositorioPersonaEnMemoria;

    /// Los casos de uso de `persona`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_persona: Arc<dyn CrearPersona>,
        pub obtener_persona: Arc<dyn ObtenerPersona>,
        pub listar_personas: Arc<dyn ListarPersonas>,
        pub actualizar_persona: Arc<dyn ActualizarPersona>,
        pub borrar_persona: Arc<dyn BorrarPersona>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioPersona> = Arc::new(RepositorioPersonaEnMemoria::new());
        CasosDeUso {
            crear_persona: Arc::new(CrearPersonaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_persona: Arc::new(ObtenerPersonaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_personas: Arc::new(ListarPersonasImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_persona: Arc::new(ActualizarPersonaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_persona: Arc::new(BorrarPersonaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

