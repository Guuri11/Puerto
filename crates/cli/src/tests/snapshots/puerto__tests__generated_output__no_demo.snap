import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakePersonaRepository, PersonaMother } from "../../../../test-support/persona";
import { renderScreen } from "../../../../test-support/render";
import { PersonaDetailContainer } from "./persona-detail-container";

describe("PersonaDetailContainer", () => {
  test("should show the persona when it exists", async () => {
    // Arrange
    const seeded = PersonaMother.random();
    const personaRepository = fakePersonaRepository([seeded]);

    // Act
    renderScreen(<PersonaDetailContainer id={seeded.id} />, { personaRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the persona does not exist", async () => {
    // Arrange
    const personaRepository = fakePersonaRepository();

    // Act
    renderScreen(<PersonaDetailContainer id={crypto.randomUUID()} />, { personaRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("persona.not_found");
  });

  test("should delete the persona only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = PersonaMother.random();
    const fake = fakePersonaRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<PersonaDetailContainer id={seeded.id} />, {
      personaRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/personas"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/persona/containers/persona-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { PersonaDetailView } from "../views/persona-detail-view";

export function PersonaDetailContainer({ id }: { id: string }) {
  const { personaRepository } = useDependencies();
  const persona = useAsync(() => personaRepository.get(id), [personaRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await personaRepository.remove(id);
      navigate("/personas");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Persona</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {persona.status === "loading" && <span className="loading loading-spinner" />}
      {persona.status === "error" && <ErrorAlert error={persona.error} />}
      {persona.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <PersonaDetailView persona={persona.data} />
            <div className="card-actions justify-end">
              <Link href={`/personas/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/personas" className="link">
        Back to personas
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this persona?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

