=== infrastructure/src/persona/repository.rs ===
use async_trait::async_trait;
use uuid::Uuid;

use business::domain::persona::{
    errors::PersonaError,
    model::Persona,
    repository::PersonaRepositoryTrait,
};

/// A stand-in that stores nothing — replace it with a real adapter (`puerto new --db` generates
/// Postgres repositories).
#[derive(Default)]
pub struct InMemoryPersonaRepository;

impl InMemoryPersonaRepository {
    pub fn new() -> Self {
        Self
    }
}

#[async_trait]
impl PersonaRepositoryTrait for InMemoryPersonaRepository {
    async fn find_all(&self) -> Result<Vec<Persona>, PersonaError> {
        tracing::debug!("find_all");
        Ok(vec![])
    }

    async fn find_by_id(&self, id: Uuid) -> Result<Option<Persona>, PersonaError> {
        tracing::debug!(%id, "find_by_id");
        Ok(None)
    }

    async fn save(&self, entity: &Persona) -> Result<(), PersonaError> {
        tracing::debug!(id = %entity.id, "save");
        Ok(())
    }
}

