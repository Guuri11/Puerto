=== presentation/src/api/persona/routes.rs ===
use std::sync::Arc;

use business::domain::persona::model::PersonaId;
use business::domain::persona::use_cases::{
    create_persona::{CreatePersonaParams, CreatePersonaUseCaseTrait},
    delete_persona::{DeletePersonaParams, DeletePersonaUseCaseTrait},
    get_persona::{GetPersonaParams, GetPersonaUseCaseTrait},
    list_personas::{ListPersonasParams, ListPersonasUseCaseTrait},
    update_persona::{UpdatePersonaParams, UpdatePersonaUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::persona::dto::{
    CreatePersonaRequest, PersonaDto, PersonaPageDto, UpdatePersonaRequest,
};
use crate::api::persona::responses::{
    CreatePersonaResponse, DeletePersonaResponse, GetPersonaResponse, ListPersonasResponse,
    UpdatePersonaResponse,
};
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct PersonaApi {
    pub create_persona: Arc<dyn CreatePersonaUseCaseTrait>,
    pub get_persona: Arc<dyn GetPersonaUseCaseTrait>,
    pub list_personas: Arc<dyn ListPersonasUseCaseTrait>,
    pub update_persona: Arc<dyn UpdatePersonaUseCaseTrait>,
    pub delete_persona: Arc<dyn DeletePersonaUseCaseTrait>,
}

#[OpenApi]
impl PersonaApi {
    /// Create a new Persona
    #[oai(path = "/personas", method = "post", tag = "ApiTags::Persona")]
    async fn create(&self, body: Json<CreatePersonaRequest>) -> CreatePersonaResponse {
        match self
            .create_persona
            .execute(CreatePersonaParams {
                name: body.name.clone(),
            })
            .await
        {
            Ok(entity) => CreatePersonaResponse::Created(Json(PersonaDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_persona failed");
                CreatePersonaResponse::from_status(status, error)
            }
        }
    }

    /// Get a Persona by ID
    #[oai(path = "/personas/:id", method = "get", tag = "ApiTags::Persona")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetPersonaResponse {
        match self
            .get_persona
            .execute(GetPersonaParams {
                id: PersonaId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetPersonaResponse::Ok(Json(PersonaDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_persona failed");
                GetPersonaResponse::from_status(status, error)
            }
        }
    }

    /// List Personas, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/personas", method = "get", tag = "ApiTags::Persona")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
    ) -> ListPersonasResponse {
        match self
            .list_personas
            .execute(ListPersonasParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListPersonasResponse::Ok(Json(PersonaPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_personas failed");
                ListPersonasResponse::from_status(status, error)
            }
        }
    }

    /// Update a Persona
    #[oai(path = "/personas/:id", method = "put", tag = "ApiTags::Persona")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdatePersonaRequest>,
    ) -> UpdatePersonaResponse {
        match self
            .update_persona
            .execute(UpdatePersonaParams {
                id: PersonaId::from_uuid(id.0),
                name: body.name.clone(),
            })
            .await
        {
            Ok(entity) => UpdatePersonaResponse::Ok(Json(PersonaDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_persona failed");
                UpdatePersonaResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Persona
    #[oai(path = "/personas/:id", method = "delete", tag = "ApiTags::Persona")]
    async fn delete(&self, id: Path<Uuid>) -> DeletePersonaResponse {
        match self
            .delete_persona
            .execute(DeletePersonaParams {
                id: PersonaId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeletePersonaResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_persona failed");
                DeletePersonaResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::persona::errors::PersonaError;
    use business::domain::persona::use_cases::{
        create_persona::mocks::MockCreatePersonaUseCase,
        delete_persona::mocks::MockDeletePersonaUseCase, get_persona::mocks::MockGetPersonaUseCase,
        list_personas::mocks::MockListPersonasUseCase,
        update_persona::mocks::MockUpdatePersonaUseCase,
    };
    use business::tests::mothers::persona_mother::PersonaMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreatePersonaUseCase,
        get: MockGetPersonaUseCase,
        list: MockListPersonasUseCase,
        update: MockUpdatePersonaUseCase,
        delete: MockDeletePersonaUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = PersonaApi {
                create_persona: Arc::new(self.create),
                get_persona: Arc::new(self.get),
                list_personas: Arc::new(self.list),
                update_persona: Arc::new(self.update),
                delete_persona: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreatePersonaRequest {
        CreatePersonaRequest {
            name: "example".to_string(),
        }
    }

    fn update_request() -> UpdatePersonaRequest {
        UpdatePersonaRequest {
            name: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/personas/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_persona_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(PersonaMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/personas")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_persona_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(PersonaError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/personas")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_persona_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(PersonaMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_persona_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(PersonaError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_personas_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(PersonaMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/personas").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/personas?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(PersonaError::RepositoryError));

        // Act
