use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::persona::{
    errors::PersonaError,
    model::{Persona, PersonaProps},
    repository::PersonaRepositoryTrait,
    use_cases::create_persona::{CreatePersonaParams, CreatePersonaUseCaseTrait},
};

pub struct CreatePersonaUseCaseImpl {
    pub repository: Arc<dyn PersonaRepositoryTrait>,
}

#[async_trait]
impl CreatePersonaUseCaseTrait for CreatePersonaUseCaseImpl {
    async fn execute(&self, params: CreatePersonaParams) -> Result<Persona, PersonaError> {
        tracing::info!("create_persona: start");
        let entity = Persona::new(PersonaProps {
            name: params.name,
        }).inspect_err(|e| tracing::warn!(error = %e, "create_persona: rejected"))?;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "create_persona: repository failed"))?;
        tracing::info!(id = %entity.id, "create_persona: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::persona::repository::mocks::MockPersonaRepository;


    #[tokio::test]
    async fn should_create_persona_when_name_is_valid() {
        // Arrange
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreatePersonaParams {
            name: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().name, "example");
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let mock_repo = MockPersonaRepository::new();
        let use_case = CreatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreatePersonaParams {
            name: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "persona.validation_error.name_empty"
        );
    }
}

