=== web/src/domain/persona/errors.ts ===
/**
 * A request about a persona that the API refused. `code` is the API's `ErrorResponse.name`:
 * `persona.not_found`, `persona.validation_error.<field>_empty`.
 */
export class PersonaError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "PersonaError";
    this.code = code;
  }
}

=== web/src/domain/persona/messages.ts ===
import type { PersonaDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface PersonaProblem {
  field: keyof PersonaDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "persona.validation_error.name_empty": "Name is required",
  "persona.duplicate": "A persona with these values already exists",
  "persona.not_found": "This persona no longer exists",
  "persona.repository_error": "The persona could not be saved, try again later",
  "persona.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof PersonaDraft> = {
  "persona.validation_error.name_empty": "name",
};

export function toProblem(code: string): PersonaProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

