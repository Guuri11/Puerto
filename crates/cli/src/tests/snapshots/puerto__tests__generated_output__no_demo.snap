use crate::domain::persona::model::Persona;
use crate::domain::persona::model::PersonaProps;

pub struct PersonaMother {
    name: Option<String>,
}

impl PersonaMother {
    pub fn new() -> Self {
        Self { name: None }
    }

    pub fn with_name(mut self, name: &str) -> Self {
        self.name = Some(name.to_string());
        self
    }

    pub fn with_empty_name(mut self) -> Self {
        self.name = Some(String::new());
        self
    }

    pub fn build(self) -> Persona {
        Persona::new(PersonaProps {
            name: self.name.unwrap_or_else(|| "example".to_string()),
        })
        .expect("PersonaMother: failed to build valid Persona")
    }

    pub fn build_props(self) -> PersonaProps {
        PersonaProps {
            name: self.name.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn random() -> Persona {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Persona> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for PersonaMother {
    fn default() -> Self {
        Self::new()
    }
}

