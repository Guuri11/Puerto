use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::persona::{
    errors::PersonaError,
    model::Persona,
    repository::PersonaRepositoryTrait,
    use_cases::list_personas::{ListPersonasParams, ListPersonasUseCaseTrait},
};

pub struct ListPersonasUseCaseImpl {
    pub repository: Arc<dyn PersonaRepositoryTrait>,
}

#[async_trait]
impl ListPersonasUseCaseTrait for ListPersonasUseCaseImpl {
    async fn execute(&self, _params: ListPersonasParams) -> Result<Vec<Persona>, PersonaError> {
        tracing::info!("list_personas: start");
        self.repository.find_all().await.inspect_err(|e| tracing::error!(error = %e, "list_personas: repository failed"))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::persona::{
        model::{Persona, PersonaProps},
        repository::mocks::MockPersonaRepository,
    };


    #[tokio::test]
    async fn should_return_all_personas() {
        let entities = vec![
            Persona::new(PersonaProps {
            name: "first".to_string(),
        }).unwrap(),
            Persona::new(PersonaProps {
            name: "second".to_string(),
        }).unwrap(),
        ];
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListPersonasUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListPersonasParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_personas_exist() {
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListPersonasUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListPersonasParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

