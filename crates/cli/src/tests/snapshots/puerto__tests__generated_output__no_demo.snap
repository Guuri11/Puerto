use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::persona::{
    errors::PersonaError,
    model::Persona,
    repository::PersonaRepositoryTrait,
    use_cases::update_persona::{UpdatePersonaParams, UpdatePersonaUseCaseTrait},
};

pub struct UpdatePersonaUseCaseImpl {
    pub repository: Arc<dyn PersonaRepositoryTrait>,
}

#[async_trait]
impl UpdatePersonaUseCaseTrait for UpdatePersonaUseCaseImpl {
    async fn execute(&self, params: UpdatePersonaParams) -> Result<Persona, PersonaError> {
        tracing::info!(id = %params.id, "update_persona: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_persona: repository failed"))?
            .ok_or_else(|| {
                let err = PersonaError::NotFound;
                tracing::warn!(error = %err, "update_persona: rejected");
                err
            })?;
        if params.name.trim().is_empty() {
            let err = PersonaError::ValidationError("name_empty".into());
            tracing::warn!(error = %err, "update_persona: rejected");
            return Err(err);
        }
        entity.name = params.name;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_persona: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::persona::{
        model::{Persona, PersonaId, PersonaProps},
        repository::mocks::MockPersonaRepository,
    };

    #[tokio::test]
    async fn should_update_persona_when_params_are_valid() {
        // Arrange
        let entity = Persona::new(PersonaProps {
            name: "original".to_string(),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdatePersonaParams {
                id: entity_id,
                name: "updated".to_string(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().name, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_persona_does_not_exist() {
        // Arrange
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdatePersonaParams {
                id: PersonaId::generate(),
                name: "new".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "persona.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let entity = Persona::new(PersonaProps {
            name: "original".to_string(),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockPersonaRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdatePersonaUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdatePersonaParams {
                id: entity_id,
                name: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "persona.validation_error.name_empty"
        );
    }
}

