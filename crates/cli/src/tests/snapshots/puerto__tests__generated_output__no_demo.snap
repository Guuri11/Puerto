import { describe, expect, test } from "bun:test";
import { PersonaError } from "../../domain/persona/errors";
import { PersonaMother } from "../../test-support/persona";
import { createApiClient } from "../http/client";
import { personaRepositoryHttp } from "./persona-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: personaRepositoryHttp(api), requests };
}

describe("personaRepositoryHttp", () => {
  test("should return every persona when the API lists them", async () => {
    // Arrange
    const persona = PersonaMother.random();
    const { repository } = answering(200, [persona]);

    // Act
    const listed = await repository.list();

    // Assert
    expect(listed).toEqual([persona]);
  });

  test("should send the draft when creating a persona", async () => {
    // Arrange
    const draft = PersonaMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the persona does not exist", async () => {
    // Arrange
    const code = "persona.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(PersonaError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the persona", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/personas/42");
  });
});

=== web/src/infrastructure/persona/persona-repository-http.ts ===
import { PersonaError } from "../../domain/persona/errors";
import type { Persona, PersonaDraft } from "../../domain/persona/model";
import type { PersonaRepository } from "../../domain/persona/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type PersonaDto = components["schemas"]["PersonaDto"];
type PersonaRequest = components["schemas"]["CreatePersonaRequest"];

function toPersona(dto: PersonaDto): Persona {
  return {
    id: dto.id,
    name: dto.name,
  };
}

function toRequest(draft: PersonaDraft): PersonaRequest {
  return {
    name: draft.name,
  };
}

/** `PersonaRepository` over the REST API (`/personas`). */
export function personaRepositoryHttp(api: ApiClient): PersonaRepository {
  return {
    async list() {
      const { data, error, response } = await api.GET("/personas");
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return data.map(toPersona);
    },
    async get(id) {
      const { data, error, response } = await api.GET("/personas/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return toPersona(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/personas", { body: toRequest(draft) });
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return toPersona(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/personas/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new PersonaError(apiErrorCode(error, response));
      return toPersona(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/personas/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new PersonaError(apiErrorCode(error, response));
    },
  };
}

