=== presentation/src/api/persona/error_mapper.rs ===
use business::domain::persona::errors::PersonaError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;

use crate::api::error::{ErrorResponse, IntoErrorResponse};

impl IntoErrorResponse for PersonaError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            PersonaError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            PersonaError::NotFound => StatusCode::NOT_FOUND,
            PersonaError::Duplicate => StatusCode::CONFLICT,
            PersonaError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            PersonaError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            PersonaError::InvalidMiddleName => StatusCode::UNPROCESSABLE_ENTITY,
            PersonaError::InvalidTag => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = PersonaError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "persona.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = PersonaError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "persona.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = PersonaError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "persona.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = PersonaError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "persona.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = PersonaError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "persona.unknown");
    }

    #[test]
    fn should_map_invalid_middle_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = PersonaError::InvalidMiddleName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "persona.invalid_middle_name");
    }

    #[test]
    fn should_map_invalid_tag_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = PersonaError::InvalidTag.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "persona.invalid_tag");
    }
}

