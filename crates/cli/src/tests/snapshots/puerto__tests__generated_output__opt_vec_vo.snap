use infrastructure::greeting::repository::InMemoryGreetingRepository;
use business::domain::persona::repository::PersonaRepositoryTrait;
use infrastructure::persona::repository::InMemoryPersonaRepository;

use poem::{EndpointExt, Route, get, middleware::{Cors, Tracing}};
use poem_openapi::OpenApiService;

use crate::api::greeting::routes::GreetingApi;
use crate::api::persona::routes::PersonaApi;

pub async fn build_app() -> impl poem::Endpoint {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl { repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait> });
    let greeting_api = GreetingApi { get_greeting };

    let persona_repo: Arc<dyn PersonaRepositoryTrait> = Arc::new(InMemoryPersonaRepository::new());
    let create_persona = Arc::new(CreatePersonaUseCaseImpl { repository: Arc::clone(&persona_repo) });
    let get_persona = Arc::new(GetPersonaUseCaseImpl { repository: Arc::clone(&persona_repo) });
    let list_persona = Arc::new(ListPersonaUseCaseImpl { repository: Arc::clone(&persona_repo) });
    let update_persona = Arc::new(UpdatePersonaUseCaseImpl { repository: Arc::clone(&persona_repo) });
    let delete_persona = Arc::new(DeletePersonaUseCaseImpl { repository: persona_repo });
    let persona_api = PersonaApi { create_persona, get_persona, list_persona, update_persona, delete_persona };

    let port = std::env::var("SERVICE_PORT").unwrap_or_else(|_| "8080".to_string());
    let api_service = OpenApiService::new(
        (greeting_api, persona_api),
        env!("CARGO_PKG_NAME"),
        env!("CARGO_PKG_VERSION"),
    )
    .server(format!("http://localhost:{port}/api"));
    let ui = api_service.swagger_ui();

    let cors_origins = std::env::var("CORS_ALLOWED_ORIGINS").unwrap_or_default();
    let mut cors = Cors::new();
    for origin in cors_origins.split(',').map(str::trim).filter(|s| !s.is_empty()) {
        cors = cors.allow_origin(origin);
    }

    Route::new()
        .at("/health", get(crate::health::liveness))
        .at(
            "/health/ready",
            get(poem::endpoint::make_sync(|_| crate::health::readiness(true))),
        )
        .nest("/api", api_service)
        .nest("/", ui)
        .with(Tracing)
        .with(cors)
}

=== puerto.toml ===
[project]
name = "snapshot"

[[entity]]
name = "Greeting"
use_cases = ["get_greeting"]
fields = []

[[entity]]
name = "Persona"
use_cases = [
    "create_persona",
    "get_persona",
    "list_persona",
    "update_persona",
    "delete_persona",
]

[[entity.fields]]
name = "name"
type = "String"

[[entity.fields]]
name = "middle_name"
type = "Option<String>"
value_object = "MiddleName"

[[entity.fields]]
name = "tags"
type = "Vec<String>"
value_object = "Tag"
