=== business/src/domain/persona/value_objects.rs ===
use super::errors::PersonaError;

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    value: String,
}

impl MiddleName {
    pub fn new(value: String) -> Result<Self, PersonaError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(PersonaError::InvalidMiddleName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Tag {
    value: String,
}

impl Tag {
    pub fn new(value: String) -> Result<Self, PersonaError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(PersonaError::InvalidTag);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

