use uuid::Uuid;

use super::{errors::PersonaError, model::Persona};

#[async_trait]
pub trait PersonaRepositoryTrait: Send + Sync {
    async fn find_all(&self) -> Result<Vec<Persona>, PersonaError>;
    async fn find_by_id(&self, id: Uuid) -> Result<Option<Persona>, PersonaError>;
    async fn save(&self, entity: &Persona) -> Result<(), PersonaError>;
}

