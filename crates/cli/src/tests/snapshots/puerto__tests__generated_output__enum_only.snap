use thiserror::Error;

#[derive(Debug, Error)]
pub enum TicketError {
    #[error("ticket.validation_error.{0}")]
    ValidationError(String),
    #[error("ticket.not_found")]
    NotFound,
    #[error("ticket.duplicate")]
    Duplicate,
    #[error("ticket.repository_error")]
    RepositoryError,
    #[error("ticket.unknown")]
    Unknown,
    #[error("ticket.invalid_state")]
    InvalidState,
}

=== business/src/domain/ticket/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;
use super::value_objects::State;

use super::errors::TicketError;

#[derive(Debug, Clone)]
pub struct TicketProps {
    pub state: State,
}

#[derive(Debug, Clone)]
pub struct Ticket {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub state: State,
}

impl Ticket {
    pub fn new(props: TicketProps) -> Result<Self, TicketError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            state: props.state,
        })
    }

    pub fn from_repository(data: Ticket) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_ticket_when_fields_are_valid() {
        let result = Ticket::new(TicketProps {
            state: State::Open,
        });
        assert!(result.is_ok());
    }


    #[test]
    fn should_reject_ticket_when_state_is_invalid() {
        let result = "InvalidVariant".parse::<State>();
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "ticket.invalid_state"
        );
    }
}

