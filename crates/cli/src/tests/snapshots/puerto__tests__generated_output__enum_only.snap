}

=== business/src/domain/ticket/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum TicketError {
    #[error("ticket.validation_error.{0}")]
    ValidationError(String),
    #[error("ticket.not_found")]
    NotFound,
    #[error("ticket.duplicate")]
    Duplicate,
    #[error("ticket.repository_error")]
    RepositoryError,
    #[error("ticket.unknown")]
    Unknown,
    #[error("ticket.invalid_state")]
    InvalidState,
}

impl From<RepositoryError> for TicketError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = TicketError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "ticket.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = TicketError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "ticket.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = TicketError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "ticket.repository_error");
    }
}

=== business/src/domain/ticket/model.rs ===
use super::value_objects::State;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::TicketError;

/// The id of every `Ticket`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct TicketId(Uuid);

impl TicketId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for TicketId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct TicketProps {
    pub state: State,
}

#[derive(Debug, Clone)]
pub struct Ticket {
    pub id: TicketId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub state: State,
}

impl Ticket {
    pub fn new(props: TicketProps) -> Result<Self, TicketError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: TicketId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            state: props.state,
        })
    }

    pub fn from_repository(data: Ticket) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_ticket_when_fields_are_valid() {
        let result = Ticket::new(TicketProps { state: State::Open });
        assert!(result.is_ok());
    }

    #[test]
    fn should_reject_ticket_when_state_is_invalid() {
        let result = "InvalidVariant".parse::<State>();
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "ticket.invalid_state");
    }
}

