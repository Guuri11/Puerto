        let mut mock_repo = MockTicketRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListTicketsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListTicketsParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
