pub struct TicketDto {
    pub id: Uuid,
    pub state: String,
}

impl TicketDto {
    pub fn from_domain(entity: &Ticket) -> Self {
        Self {
            id: entity.id.value(),
            state: entity.state.as_str().to_string(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateTicketRequest {
    pub state: String,
}

/// One page of Tickets: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct TicketPageDto {
    pub items: Vec<TicketDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl TicketPageDto {
    pub fn from_domain(page: &Page<Ticket>) -> Self {
        Self {
            items: page.items.iter().map(TicketDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

