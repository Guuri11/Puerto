use crate::modelo::Billete;
use crate::modelo::PropsBillete;
use crate::valores::State;

pub struct MadreBillete {
    state: Option<State>,
}

impl MadreBillete {
    pub fn new() -> Self {
        Self { state: None }
    }

    pub fn con_state(mut self, state: State) -> Self {
        self.state = Some(state);
        self
    }

    pub fn construir(self) -> Billete {
        Billete::new(PropsBillete {
            state: self.state.unwrap_or(State::Open),
        })
        .expect("MadreBillete: Billete::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsBillete {
        PropsBillete {
            state: self.state.unwrap_or(State::Open),
        }
    }

    pub fn aleatorio() -> Billete {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Billete> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreBillete {
    fn default() -> Self {
        Self::new()
    }
}

