=== presentation/src/api/ticket/routes.rs ===
use std::sync::Arc;

use business::domain::ticket::use_cases::{
    create_ticket::{CreateTicketParams, CreateTicketUseCaseTrait},
    delete_ticket::{DeleteTicketParams, DeleteTicketUseCaseTrait},
    get_ticket::{GetTicketParams, GetTicketUseCaseTrait},
    list_tickets::{ListTicketsParams, ListTicketsUseCaseTrait},
    update_ticket::{UpdateTicketParams, UpdateTicketUseCaseTrait},
};
use poem_openapi::{OpenApi, param::Path, payload::Json};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::ticket::dto::{CreateTicketRequest, UpdateTicketRequest, TicketDto};
use crate::api::ticket::responses::{
    CreateTicketResponse, DeleteTicketResponse, GetTicketResponse, ListTicketsResponse,
    UpdateTicketResponse,
};

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct TicketApi {
    pub create_ticket: Arc<dyn CreateTicketUseCaseTrait>,
    pub get_ticket: Arc<dyn GetTicketUseCaseTrait>,
    pub list_tickets: Arc<dyn ListTicketsUseCaseTrait>,
    pub update_ticket: Arc<dyn UpdateTicketUseCaseTrait>,
    pub delete_ticket: Arc<dyn DeleteTicketUseCaseTrait>,
}

#[OpenApi]
impl TicketApi {
    /// Create a new Ticket
    #[oai(path = "/tickets", method = "post", tag = "ApiTags::Ticket")]
    async fn create(&self, body: Json<CreateTicketRequest>) -> CreateTicketResponse {
        match self
            .create_ticket
            .execute(CreateTicketParams {
                state: body.state.clone(),
            })
            .await
        {
            Ok(entity) => CreateTicketResponse::Created(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_ticket failed");
                CreateTicketResponse::from_status(status, error)
            }
        }
    }

    /// Get a Ticket by ID
    #[oai(path = "/tickets/:id", method = "get", tag = "ApiTags::Ticket")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetTicketResponse {
        match self
            .get_ticket
            .execute(GetTicketParams { id: id.0 })
            .await
        {
            Ok(entity) => GetTicketResponse::Ok(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_ticket failed");
                GetTicketResponse::from_status(status, error)
            }
        }
    }

    /// List all Tickets
    #[oai(path = "/tickets", method = "get", tag = "ApiTags::Ticket")]
    async fn list(&self) -> ListTicketsResponse {
        match self.list_tickets.execute(ListTicketsParams).await {
            Ok(entities) => {
                ListTicketsResponse::Ok(Json(entities.iter().map(TicketDto::from_domain).collect()))
            }
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_tickets failed");
                ListTicketsResponse::from_status(status, error)
            }
        }
    }

    /// Update a Ticket
    #[oai(path = "/tickets/:id", method = "put", tag = "ApiTags::Ticket")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateTicketRequest>) -> UpdateTicketResponse {
        match self
            .update_ticket
            .execute(UpdateTicketParams {
                id: id.0,
                state: body.state.clone(),
            })
            .await
        {
            Ok(entity) => UpdateTicketResponse::Ok(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_ticket failed");
                UpdateTicketResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Ticket
    #[oai(path = "/tickets/:id", method = "delete", tag = "ApiTags::Ticket")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteTicketResponse {
        match self
            .delete_ticket
            .execute(DeleteTicketParams { id: id.0 })
            .await
        {
            Ok(()) => DeleteTicketResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_ticket failed");
                DeleteTicketResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::ticket::errors::TicketError;
    use business::domain::ticket::use_cases::{
        create_ticket::mocks::MockCreateTicketUseCase, delete_ticket::mocks::MockDeleteTicketUseCase,
        get_ticket::mocks::MockGetTicketUseCase, list_tickets::mocks::MockListTicketsUseCase,
        update_ticket::mocks::MockUpdateTicketUseCase,
    };
    use business::tests::mothers::ticket_mother::TicketMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateTicketUseCase,
        get: MockGetTicketUseCase,
        list: MockListTicketsUseCase,
        update: MockUpdateTicketUseCase,
        delete: MockDeleteTicketUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = TicketApi {
                create_ticket: Arc::new(self.create),
                get_ticket: Arc::new(self.get),
                list_tickets: Arc::new(self.list),
                update_ticket: Arc::new(self.update),
                delete_ticket: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateTicketRequest {
        CreateTicketRequest {
            state: "example".to_string(),
        }
    }

    fn update_request() -> UpdateTicketRequest {
        UpdateTicketRequest {
            state: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/tickets/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_ticket_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| Ok(TicketMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/tickets")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_ticket_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(TicketError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/tickets")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_ticket_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Ok(TicketMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_ticket_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Err(TicketError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_every_ticket_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Ok(TicketMother::random_vec(2)));

        // Act
        let response = mocks.client().get("/tickets").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        response.json().await.value().array().assert_len(2);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Err(TicketError::RepositoryError));

        // Act
        let response = mocks.client().get("/tickets").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_ticket_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Ok(TicketMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_ticket() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Err(TicketError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_ticket_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_ticket() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Err(TicketError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

=== presentation/src/generated/bootstrap.rs ===
// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;
use business::application::ticket::create_ticket::CreateTicketUseCaseImpl;
use business::application::ticket::get_ticket::GetTicketUseCaseImpl;
use business::application::ticket::list_tickets::ListTicketsUseCaseImpl;
use business::application::ticket::update_ticket::UpdateTicketUseCaseImpl;
use business::application::ticket::delete_ticket::DeleteTicketUseCaseImpl;

use business::domain::greeting::repository::GreetingRepositoryTrait;
use infrastructure::greeting::repository::InMemoryGreetingRepository;
use business::domain::ticket::repository::TicketRepositoryTrait;
use infrastructure::ticket::repository::InMemoryTicketRepository;

use poem::{EndpointExt, Route, get, middleware::{Cors, Tracing}};
use poem_openapi::OpenApiService;

use crate::api::greeting::routes::GreetingApi;
use crate::api::ticket::routes::TicketApi;

pub async fn build_app() -> impl poem::Endpoint {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl { repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait> });
    let greeting_api = GreetingApi { get_greeting };

    let ticket_repo: Arc<dyn TicketRepositoryTrait> = Arc::new(InMemoryTicketRepository::new());
    let create_ticket = Arc::new(CreateTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let get_ticket = Arc::new(GetTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let list_tickets = Arc::new(ListTicketsUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let update_ticket = Arc::new(UpdateTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let delete_ticket = Arc::new(DeleteTicketUseCaseImpl { repository: ticket_repo });
    let ticket_api = TicketApi { create_ticket, get_ticket, list_tickets, update_ticket, delete_ticket };

    let port = std::env::var("SERVICE_PORT").unwrap_or_else(|_| "8080".to_string());
    let api_service =
        openapi_service((greeting_api, ticket_api)).server(format!("http://localhost:{port}/api"));
    let ui = api_service.swagger_ui();

    let cors_origins = std::env::var("CORS_ALLOWED_ORIGINS").unwrap_or_default();
    let mut cors = Cors::new();
    for origin in cors_origins.split(',').map(str::trim).filter(|s| !s.is_empty()) {
        cors = cors.allow_origin(origin);
    }

    Route::new()
        .at("/health", get(crate::health::liveness))
        .at(
            "/health/ready",
            get(poem::endpoint::make_sync(|_| crate::health::readiness(true))),
        )
        .nest("/api", api_service)
        .nest("/", ui)
        .with(Tracing)
        .with(cors)
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;

    use business::domain::greeting::use_cases::get_greeting::mocks::MockGetGreetingUseCase;
    use business::domain::ticket::use_cases::create_ticket::mocks::MockCreateTicketUseCase;
    use business::domain::ticket::use_cases::get_ticket::mocks::MockGetTicketUseCase;
    use business::domain::ticket::use_cases::list_tickets::mocks::MockListTicketsUseCase;
    use business::domain::ticket::use_cases::update_ticket::mocks::MockUpdateTicketUseCase;
    use business::domain::ticket::use_cases::delete_ticket::mocks::MockDeleteTicketUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let greeting_api = GreetingApi { get_greeting: Arc::new(MockGetGreetingUseCase::new()) };
        let ticket_api = TicketApi { create_ticket: Arc::new(MockCreateTicketUseCase::new()), get_ticket: Arc::new(MockGetTicketUseCase::new()), list_tickets: Arc::new(MockListTicketsUseCase::new()), update_ticket: Arc::new(MockUpdateTicketUseCase::new()), delete_ticket: Arc::new(MockDeleteTicketUseCase::new()) };
        let spec = openapi_service((greeting_api, ticket_api)).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

