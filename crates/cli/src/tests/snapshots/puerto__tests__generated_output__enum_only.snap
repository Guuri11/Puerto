use std::sync::Arc;

use crate::domain::ticket::value_objects::State;
use async_trait::async_trait;

use crate::domain::ticket::{
    errors::TicketError,
    model::{Ticket, TicketProps},
    repository::TicketRepositoryTrait,
    use_cases::create_ticket::{CreateTicketParams, CreateTicketUseCaseTrait},
};

pub struct CreateTicketUseCaseImpl {
    pub repository: Arc<dyn TicketRepositoryTrait>,
}

#[async_trait]
impl CreateTicketUseCaseTrait for CreateTicketUseCaseImpl {
    async fn execute(&self, params: CreateTicketParams) -> Result<Ticket, TicketError> {
        tracing::info!("create_ticket: start");
        let state = params.state.parse::<State>()?;
        let entity = Ticket::new(TicketProps { state })
            .inspect_err(|e| tracing::warn!(error = %e, "create_ticket: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_ticket: repository failed"))?;
        tracing::info!(id = %entity.id, "create_ticket: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::ticket::repository::mocks::MockTicketRepository;
    use puerto_core::RepositoryError;

    #[tokio::test]
    async fn should_create_ticket_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockTicketRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateTicketParams {
                state: "Open".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().state.as_str(), "Open");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockTicketRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));
        let use_case = CreateTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateTicketParams {
                state: "Open".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "ticket.duplicate");
    }

    #[tokio::test]
    async fn should_return_error_when_state_is_empty() {
        // Arrange
        let mock_repo = MockTicketRepository::new();
        let use_case = CreateTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateTicketParams {
                state: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "ticket.invalid_state");
    }
}

=== business/src/application/ticket/delete_ticket.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::ticket::{
    errors::TicketError,
    repository::TicketRepositoryTrait,
    use_cases::delete_ticket::{DeleteTicketParams, DeleteTicketUseCaseTrait},
};

pub struct DeleteTicketUseCaseImpl {
    pub repository: Arc<dyn TicketRepositoryTrait>,
}

#[async_trait]
impl DeleteTicketUseCaseTrait for DeleteTicketUseCaseImpl {
    async fn execute(&self, params: DeleteTicketParams) -> Result<(), TicketError> {
        tracing::info!(id = %params.id, "delete_ticket: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_ticket: repository failed"))?
            .ok_or_else(|| {
                let err = TicketError::NotFound;
                tracing::warn!(error = %err, "delete_ticket: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_ticket: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::ticket::value_objects::State;
    use crate::domain::ticket::{
        model::{Ticket, TicketId, TicketProps},
        repository::mocks::MockTicketRepository,
    };

    #[tokio::test]
    async fn should_soft_delete_ticket_when_id_exists() {
        let entity = Ticket::new(TicketProps { state: State::Open }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockTicketRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(DeleteTicketParams { id: entity_id }).await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_ticket_does_not_exist() {
        let mut mock_repo = MockTicketRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteTicketParams {
                id: TicketId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "ticket.not_found");
    }
}

