import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { renderScreen } from "../../../../test-support/render";
import { fakeTicketRepository, TicketMother } from "../../../../test-support/ticket";
import { TicketDetailContainer } from "./ticket-detail-container";

describe("TicketDetailContainer", () => {
  test("should show the ticket when it exists", async () => {
    // Arrange
    const seeded = TicketMother.random();
    const ticketRepository = fakeTicketRepository([seeded]);

    // Act
    renderScreen(<TicketDetailContainer id={seeded.id} />, { ticketRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the ticket does not exist", async () => {
    // Arrange
    const ticketRepository = fakeTicketRepository();

    // Act
    renderScreen(<TicketDetailContainer id={crypto.randomUUID()} />, { ticketRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("ticket.not_found");
  });

  test("should delete the ticket only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = TicketMother.random();
    const fake = fakeTicketRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<TicketDetailContainer id={seeded.id} />, {
      ticketRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/tickets"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/ticket/containers/ticket-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { TicketDetailView } from "../views/ticket-detail-view";

export function TicketDetailContainer({ id }: { id: string }) {
  const { ticketRepository } = useDependencies();
  const ticket = useAsync(() => ticketRepository.get(id), [ticketRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await ticketRepository.remove(id);
      navigate("/tickets");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Ticket</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {ticket.status === "loading" && <span className="loading loading-spinner" />}
      {ticket.status === "error" && <ErrorAlert error={ticket.error} />}
      {ticket.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <TicketDetailView ticket={ticket.data} />
            <div className="card-actions justify-end">
              <Link href={`/tickets/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/tickets" className="link">
        Back to tickets
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this ticket?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/ticket/containers/ticket-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { TicketError } from "../../../../domain/ticket/errors";
import type { TicketDraft } from "../../../../domain/ticket/model";
import { renderScreen } from "../../../../test-support/render";
import { fakeTicketRepository, TicketMother } from "../../../../test-support/ticket";
import { TicketFormContainer } from "./ticket-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: TicketDraft) {
  await screen.findByText("Save");
  type("State", draft.state);
}

describe("TicketFormContainer", () => {
  test("should create the ticket from what was typed and show it", async () => {
    // Arrange
    const draft = TicketMother.draft();
    const ticketRepository = fakeTicketRepository();
    const { history } = renderScreen(<TicketFormContainer />, { ticketRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/tickets/"));
    const {
      items: [created],
    } = await ticketRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/tickets/${created?.id}`);
  });

  test("should save the edited ticket when an existing one is submitted", async () => {
    // Arrange
    const seeded = TicketMother.random();
    const ticketRepository = fakeTicketRepository([seeded]);
    const { history } = renderScreen(<TicketFormContainer id={seeded.id} />, {
      ticketRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/tickets/${seeded.id}`));
    expect(await ticketRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the validation code when the API rejects the ticket", async () => {
    // Arrange
    const code = "ticket.validation_error.invalid";
    const ticketRepository = {
      ...fakeTicketRepository(),
      create: () => Promise.reject(new TicketError(code)),
    };
    renderScreen(<TicketFormContainer />, { ticketRepository });
    await fillIn(TicketMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });
});

