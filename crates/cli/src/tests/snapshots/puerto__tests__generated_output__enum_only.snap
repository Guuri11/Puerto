=== presentacion/cableado/src/lib.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod billete {
    use std::sync::Arc;

    use aplicacion_billete::actualizar_billete::{ActualizarBillete, ActualizarBilleteImpl};
    use aplicacion_billete::borrar_billete::{BorrarBillete, BorrarBilleteImpl};
    use aplicacion_billete::crear_billete::{CrearBillete, CrearBilleteImpl};
    use aplicacion_billete::listar_billetes::{ListarBilletes, ListarBilletesImpl};
    use aplicacion_billete::obtener_billete::{ObtenerBillete, ObtenerBilleteImpl};
    use dominio_billete::repositorio::RepositorioBillete;
    use infra_billete::repositorio::RepositorioBilleteEnMemoria;

    /// Los casos de uso de `billete`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_billete: Arc<dyn CrearBillete>,
        pub obtener_billete: Arc<dyn ObtenerBillete>,
        pub listar_billetes: Arc<dyn ListarBilletes>,
        pub actualizar_billete: Arc<dyn ActualizarBillete>,
        pub borrar_billete: Arc<dyn BorrarBillete>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioBillete> = Arc::new(RepositorioBilleteEnMemoria::new());
        CasosDeUso {
            crear_billete: Arc::new(CrearBilleteImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_billete: Arc::new(ObtenerBilleteImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_billetes: Arc::new(ListarBilletesImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_billete: Arc::new(ActualizarBilleteImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_billete: Arc::new(BorrarBilleteImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

