use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::ticket::{
    errors::TicketError,
    model::Ticket,
    repository::TicketRepositoryTrait,
    use_cases::list_tickets::{ListTicketsParams, ListTicketsUseCaseTrait},
};

pub struct ListTicketsUseCaseImpl {
    pub repository: Arc<dyn TicketRepositoryTrait>,
}

#[async_trait]
impl ListTicketsUseCaseTrait for ListTicketsUseCaseImpl {
    async fn execute(&self, params: ListTicketsParams) -> Result<Page<Ticket>, TicketError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_tickets: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_tickets: repository failed"))
            .map_err(TicketError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::ticket::value_objects::State;
    use crate::domain::ticket::{
        model::{Ticket, TicketProps},
        repository::mocks::MockTicketRepository,
    };
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_tickets() {
        let entities = vec![
            Ticket::new(TicketProps { state: State::Open }).unwrap(),
            Ticket::new(TicketProps { state: State::Open }).unwrap(),
        ];
        let mut mock_repo = MockTicketRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListTicketsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListTicketsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_tickets_exist() {
        let mut mock_repo = MockTicketRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListTicketsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListTicketsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockTicketRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListTicketsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListTicketsParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

