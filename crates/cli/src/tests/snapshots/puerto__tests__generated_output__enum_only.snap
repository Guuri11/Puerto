use std::sync::Arc;

use async_trait::async_trait;
use crate::domain::ticket::value_objects::State;

use crate::domain::ticket::{
    errors::TicketError,
    model::Ticket,
    repository::TicketRepositoryTrait,
    use_cases::update_ticket::{UpdateTicketParams, UpdateTicketUseCaseTrait},
};

pub struct UpdateTicketUseCaseImpl {
    pub repository: Arc<dyn TicketRepositoryTrait>,
}

#[async_trait]
impl UpdateTicketUseCaseTrait for UpdateTicketUseCaseImpl {
    async fn execute(&self, params: UpdateTicketParams) -> Result<Ticket, TicketError> {
        tracing::info!(id = %params.id, "update_ticket: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_ticket: repository failed"))?
            .ok_or_else(|| {
                let err = TicketError::NotFound;
                tracing::warn!(error = %err, "update_ticket: rejected");
                err
            })?;
let state = params.state.parse::<State>()?;
        entity.state = state;
        entity.updated_at = chrono::Utc::now();
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "update_ticket: repository failed"))?;
        Ok(entity)
    }
}

