=== web/src/domain/ticket/errors.ts ===
/**
 * A request about a ticket that the API refused. `code` is the API's `ErrorResponse.name`:
 * `ticket.not_found`, `ticket.validation_error.<field>_empty`.
 */
export class TicketError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "TicketError";
    this.code = code;
  }
}

=== web/src/domain/ticket/model.ts ===
import { TicketError } from "./errors";

export interface Ticket {
  id: string;
  state: State;
}

/** What a create or an update sends: a ticket without its id. */
export type TicketDraft = Omit<Ticket, "id">;

export const stateValues = ["Open", "Closed"] as const;

export type State = (typeof stateValues)[number];

/** Narrows the API's `string` to a `State`, rejecting with `ticket.invalid_state`. */
export function parseState(value: string): State {
  const found = stateValues.find((candidate) => candidate === value);
  if (found === undefined) throw new TicketError("ticket.invalid_state");
  return found;
}

=== web/src/domain/ticket/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Ticket, TicketDraft } from "./model";

/** The port the screens call. Every method rejects with the `TicketError` the API answered. */
export interface TicketRepository {
  list(page: PageRequest): Promise<Page<Ticket>>;
  get(id: string): Promise<Ticket>;
  create(draft: TicketDraft): Promise<Ticket>;
  update(id: string, draft: TicketDraft): Promise<Ticket>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/ticket/ticket-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { TicketError } from "../../domain/ticket/errors";
import { TicketMother } from "../../test-support/ticket";
import { createApiClient } from "../http/client";
import { ticketRepositoryHttp } from "./ticket-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: ticketRepositoryHttp(api), requests };
}

describe("ticketRepositoryHttp", () => {
  test("should ask for the page and return its tickets", async () => {
    // Arrange
    const ticket = TicketMother.random();
    const page = { items: [ticket], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/tickets?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating a ticket", async () => {
    // Arrange
    const draft = TicketMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the ticket does not exist", async () => {
    // Arrange
    const code = "ticket.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(TicketError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the ticket", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/tickets/42");
  });
});

=== web/src/infrastructure/ticket/ticket-repository-http.ts ===
import { TicketError } from "../../domain/ticket/errors";
import { parseState, type Ticket, type TicketDraft } from "../../domain/ticket/model";
import type { TicketRepository } from "../../domain/ticket/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type TicketDto = components["schemas"]["TicketDto"];
type TicketRequest = components["schemas"]["CreateTicketRequest"];

function toTicket(dto: TicketDto): Ticket {
  return {
    id: dto.id,
    state: parseState(dto.state),
  };
}

function toRequest(draft: TicketDraft): TicketRequest {
  return {
    state: draft.state,
  };
}

/** `TicketRepository` over the REST API (`/tickets`). */
export function ticketRepositoryHttp(api: ApiClient): TicketRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/tickets", {
        params: { query: page },
      });
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toTicket) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/tickets/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return toTicket(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/tickets", { body: toRequest(draft) });
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return toTicket(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/tickets/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return toTicket(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/tickets/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new TicketError(apiErrorCode(error, response));
    },
  };
}

