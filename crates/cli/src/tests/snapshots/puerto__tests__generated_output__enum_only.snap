use async_trait::async_trait;
use uuid::Uuid;

use business::domain::ticket::{
    errors::TicketError,
    model::Ticket,
    repository::TicketRepositoryTrait,
};

/// A stand-in that stores nothing — replace it with a real adapter (`puerto new --db` generates
/// Postgres repositories).
#[derive(Default)]
pub struct InMemoryTicketRepository;

impl InMemoryTicketRepository {
    pub fn new() -> Self {
        Self
    }
}

#[async_trait]
impl TicketRepositoryTrait for InMemoryTicketRepository {
    async fn find_all(&self) -> Result<Vec<Ticket>, TicketError> {
        tracing::debug!("find_all");
        Ok(vec![])
    }

    async fn find_by_id(&self, id: Uuid) -> Result<Option<Ticket>, TicketError> {
        tracing::debug!(%id, "find_by_id");
        Ok(None)
    }

    async fn save(&self, entity: &Ticket) -> Result<(), TicketError> {
        tracing::debug!(id = %entity.id, "save");
        Ok(())
    }
}

