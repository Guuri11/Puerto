use business::domain::ticket::model::Ticket;
use poem_openapi::Object;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct TicketDto {
    pub id: Uuid,
    pub state: String,
}

impl TicketDto {
    pub fn from_domain(entity: &Ticket) -> Self {
        Self {
            id: entity.id,
            state: entity.state.as_str().to_string(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateTicketRequest {
    pub state: String,
}


#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateTicketRequest {
    pub state: String,
}


