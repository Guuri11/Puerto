=== contextos/billete/dominio/src/modelo.rs ===
use crate::valores::State;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorBillete;

/// El id de cada `Billete`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdBillete(Uuid);

impl IdBillete {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdBillete {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsBillete {
    pub state: State,
}

#[derive(Debug, Clone)]
pub struct Billete {
    pub id: IdBillete,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub state: State,
}

impl Billete {
    pub fn new(props: PropsBillete) -> Result<Self, ErrorBillete> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdBillete::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            state: props.state,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsBillete) -> Result<(), ErrorBillete> {
        Self::validar(&props)?;
        self.state = props.state;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Billete) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(_props: &PropsBillete) -> Result<(), ErrorBillete> {
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreBillete;

    #[test]
    fn deberia_crear_billete_cuando_los_campos_son_validos() {
        let resultado = Billete::new(MadreBillete::new().construir_props());
        assert!(resultado.is_ok());
    }

    #[test]
    fn deberia_rechazar_billete_cuando_state_no_es_una_variante_conocida() {
        let resultado = "VarianteInvalida".parse::<State>();
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.state_invalido");
    }

    #[test]
    fn deberia_marcar_billete_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreBillete::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

