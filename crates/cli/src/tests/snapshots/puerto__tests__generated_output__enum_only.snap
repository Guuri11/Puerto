import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Ticket } from "../../../../domain/ticket/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { TicketFormView, toTicketDraft, toTicketForm } from "../views/ticket-form-view";

/** Creates a ticket, or edits the one with `id`. */
export function TicketFormContainer({ id }: { id?: string }) {
  const { ticketRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : ticketRepository.get(id)),
    [ticketRepository, id],
  );
  const title = id === undefined ? "New ticket" : "Edit ticket";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <TicketForm existing={existing.data} />}
      <Link href={id === undefined ? "/tickets" : `/tickets/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function TicketForm({ existing }: { existing: Ticket | null }) {
  const { ticketRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toTicketForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toTicketDraft(values);
      const saved =
        existing === null
          ? await ticketRepository.create(draft)
          : await ticketRepository.update(existing.id, draft);
      navigate(`/tickets/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {failure !== null && <ErrorAlert error={failure} />}
        <TicketFormView values={values} saving={saving} onChange={setValues} onSubmit={save} />
      </div>
    </div>
  );
}

=== web/src/presentation/features/ticket/containers/ticket-list-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { TicketError } from "../../../../domain/ticket/errors";
import { renderScreen } from "../../../../test-support/render";
import { fakeTicketRepository, TicketMother } from "../../../../test-support/ticket";
import { TicketListContainer } from "./ticket-list-container";

describe("TicketListContainer", () => {
  test("should show a row per ticket when there are some", async () => {
    // Arrange
    const seed = [TicketMother.random(), TicketMother.random()];
    const ticketRepository = fakeTicketRepository(seed);

    // Act
    renderScreen(<TicketListContainer />, { ticketRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => TicketMother.random());
    const ticketRepository = fakeTicketRepository(seed);
    renderScreen(<TicketListContainer />, { ticketRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should say so when there is no ticket", async () => {
    // Arrange
    const ticketRepository = fakeTicketRepository();

    // Act
    renderScreen(<TicketListContainer />, { ticketRepository });

    // Assert
    expect(await screen.findByText("No tickets yet.")).toBeTruthy();
  });

  test("should show the error code when the tickets cannot be listed", async () => {
    // Arrange
    const ticketRepository = {
      ...fakeTicketRepository(),
      list: () => Promise.reject(new TicketError("ticket.repository_error")),
    };

    // Act
    renderScreen(<TicketListContainer />, { ticketRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("ticket.repository_error");
  });
});

=== web/src/presentation/features/ticket/containers/ticket-list-container.tsx ===
import { useState } from "react";
import { Link } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { Pagination } from "../../../shared/ui/pagination";
import { TicketListView } from "../views/ticket-list-view";

export function TicketListContainer() {
  const { ticketRepository } = useDependencies();
  const [offset, setOffset] = useState(0);
  const tickets = useAsync(
    () => ticketRepository.list({ limit: PAGE_SIZE, offset }),
    [ticketRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Tickets</h1>
        <Link href="/tickets/new" className="btn btn-primary">
          New ticket
        </Link>
      </div>
      {tickets.status === "loading" && <span className="loading loading-spinner" />}
      {tickets.status === "error" && <ErrorAlert error={tickets.error} />}
      {tickets.status === "ok" &&
        (tickets.data.total === 0 ? (
          <EmptyState message="No tickets yet." />
        ) : (
          <>
            <TicketListView tickets={tickets.data.items} />
            <Pagination {...tickets.data} onOffsetChange={setOffset} />
          </>
        ))}
    </section>
  );
}

