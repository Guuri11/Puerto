=== contextos/equipo/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_equipo::{
    actualizar_equipo::{ActualizarEquipo, ParamsActualizarEquipo},
    borrar_equipo::{BorrarEquipo, ParamsBorrarEquipo},
    crear_equipo::{CrearEquipo, ParamsCrearEquipo},
    listar_equipos::{ListarEquipos, ParamsListarEquipos},
    obtener_equipo::{ObtenerEquipo, ParamsObtenerEquipo},
};
use dominio_equipo::modelo::IdEquipo;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use puerto_web::auth::BearerAuth;
use uuid::Uuid;

use crate::dto::{DtoEquipo, DtoPaginaEquipo, PeticionActualizarEquipo, PeticionCrearEquipo};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarEquipo, RespuestaBorrarEquipo, RespuestaCrearEquipo, RespuestaListarEquipos,
    RespuestaObtenerEquipo,
};

#[derive(Tags)]
enum ApiTags {
    Equipo,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiEquipo {
    pub crear_equipo: Arc<dyn CrearEquipo>,
    pub obtener_equipo: Arc<dyn ObtenerEquipo>,
    pub listar_equipos: Arc<dyn ListarEquipos>,
    pub actualizar_equipo: Arc<dyn ActualizarEquipo>,
    pub borrar_equipo: Arc<dyn BorrarEquipo>,
}

#[OpenApi]
impl ApiEquipo {
    /// Crea: Equipo
    #[oai(path = "/equipos", method = "post", tag = "ApiTags::Equipo")]
    async fn crear(
        &self,
        auth: BearerAuth,
        cuerpo: Json<PeticionCrearEquipo>,
    ) -> RespuestaCrearEquipo {
        match self
            .crear_equipo
            .ejecutar(ParamsCrearEquipo {
                actor: auth.0,
                nombre: cuerpo.nombre.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearEquipo::Creado(Json(DtoEquipo::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_equipo falló");
                RespuestaCrearEquipo::from_status(status, error)
            }
        }
    }

    /// Obtiene: Equipo por id
    #[oai(path = "/equipos/:id", method = "get", tag = "ApiTags::Equipo")]
    async fn obtener(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaObtenerEquipo {
        match self
            .obtener_equipo
            .ejecutar(ParamsObtenerEquipo {
                actor: auth.0,
                id: IdEquipo::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerEquipo::Ok(Json(DtoEquipo::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_equipo falló");
                RespuestaObtenerEquipo::from_status(status, error)
            }
        }
    }

    /// Lista Equipos, página a página (el dominio acota `limite`)
    #[oai(path = "/equipos", method = "get", tag = "ApiTags::Equipo")]
    async fn listar(
        &self,
        auth: BearerAuth,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarEquipos {
        match self
            .listar_equipos
            .ejecutar(ParamsListarEquipos {
                actor: auth.0,
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => RespuestaListarEquipos::Ok(Json(DtoPaginaEquipo::from_dominio(&pagina))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_equipos falló");
                RespuestaListarEquipos::from_status(status, error)
            }
        }
    }

    /// Actualiza: Equipo
    #[oai(path = "/equipos/:id", method = "put", tag = "ApiTags::Equipo")]
    async fn actualizar(
        &self,
        auth: BearerAuth,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarEquipo>,
    ) -> RespuestaActualizarEquipo {
        match self
            .actualizar_equipo
            .ejecutar(ParamsActualizarEquipo {
                actor: auth.0,
                id: IdEquipo::from_uuid(id.0),
                nombre: cuerpo.nombre.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarEquipo::Ok(Json(DtoEquipo::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_equipo falló");
                RespuestaActualizarEquipo::from_status(status, error)
            }
        }
    }

    /// Borra: Equipo
    #[oai(path = "/equipos/:id", method = "delete", tag = "ApiTags::Equipo")]
    async fn borrar(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaBorrarEquipo {
        match self
            .borrar_equipo
            .ejecutar(ParamsBorrarEquipo {
                actor: auth.0,
                id: IdEquipo::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarEquipo::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_equipo falló");
                RespuestaBorrarEquipo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_equipo::{
        actualizar_equipo::dobles::MockActualizarEquipo, borrar_equipo::dobles::MockBorrarEquipo,
        crear_equipo::dobles::MockCrearEquipo, listar_equipos::dobles::MockListarEquipos,
        obtener_equipo::dobles::MockObtenerEquipo,
    };
    use dominio_equipo::errores::ErrorEquipo;
    use dominio_equipo::pruebas::madres::MadreEquipo;
    use poem::{EndpointExt, Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;
    use puerto_nucleo::auth::dobles::MadrePrincipal;
    use puerto_nucleo::auth::dobles::MockAutenticador;
    use puerto_nucleo::auth::{Autenticador, ErrorAuth};

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearEquipo,
        obtener: MockObtenerEquipo,
        listar: MockListarEquipos,
        actualizar: MockActualizarEquipo,
        borrar: MockBorrarEquipo,
    }

    /// Acepta `llamante` (con todos los roles que pide alguna ruta de esta API) y `nadie`
    /// (sin roles).
    fn autenticador() -> Arc<dyn Autenticador> {
        let mut doble = MockAutenticador::new();
        doble.expect_autenticar().returning(|token| match token {
            "llamante" => Ok(MadrePrincipal::aleatorio()),
            "nadie" => Ok(MadrePrincipal::aleatorio()),
            _ => Err(ErrorAuth::Invalido),
        });
        Arc::new(doble)
    }

    impl Dobles {
        /// Todas las peticiones, con sesión iniciada como `llamante`.
        fn cliente(self) -> TestClient<impl poem::Endpoint> {
            self.cliente_con(Some("Bearer llamante"))
        }

        /// `autorizacion`: la cabecera que envía cada petición; con `None` no se envía ninguna.
        fn cliente_con(self, autorizacion: Option<&str>) -> TestClient<impl poem::Endpoint> {
            let api = ApiEquipo {
                crear_equipo: Arc::new(self.crear),
                obtener_equipo: Arc::new(self.obtener),
                listar_equipos: Arc::new(self.listar),
                actualizar_equipo: Arc::new(self.actualizar),
                borrar_equipo: Arc::new(self.borrar),
            };
            let cliente = TestClient::new(
                Route::new()
                    .nest("/", OpenApiService::new(api, "test", "1.0"))
                    .data(autenticador()),
            );
            match autorizacion {
                Some(valor) => cliente.default_header("Authorization", valor),
                None => cliente,
            }
        }
    }

    fn peticion_crear() -> PeticionCrearEquipo {
        PeticionCrearEquipo {
            nombre: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarEquipo {
        PeticionActualizarEquipo {
            nombre: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/equipos/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_equipo() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreEquipo::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/equipos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_equipo_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorEquipo::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/equipos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_equipo_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreEquipo::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_equipo_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorEquipo::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_equipos_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreEquipo::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/equipos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/equipos?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEquipo::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/equipos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_equipo() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreEquipo::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_equipo_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEquipo::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_equipo() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_equipo_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEquipo::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_crea_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .post("/equipos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_obtiene_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles.cliente_con(None).get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_lista_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles.cliente_con(None).get("/equipos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_actualiza_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_borra_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .delete(ruta_elemento())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }
}

=== contextos/jugador/aplicacion/Cargo.toml ===
[package]
name = "aplicacion_jugador"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_jugador = { workspace = true }
puerto-nucleo = { workspace = true }
dominio_equipo = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_jugador/pruebas"]

[dev-dependencies]
# Quien llama en los tests: `MadrePrincipal`, y el `MockAutenticador` de las rutas.
puerto-nucleo = { workspace = true, features = ["pruebas"] }
dominio_jugador = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/jugador/aplicacion/src/actualizar_jugador.rs ===
use async_trait::async_trait;
use dominio_equipo::modelo::IdEquipo;
use dominio_jugador::errores::ErrorJugador;
use dominio_jugador::modelo::{IdJugador, Jugador, PropsJugador};
use dominio_jugador::repositorio::RepositorioJugador;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsActualizarJugador {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub id: IdJugador,
    pub equipo_id: IdEquipo,
    pub dorsal: i64,
    pub email: String,
}

#[async_trait]
pub trait ActualizarJugador: Send + Sync {
    async fn ejecutar(&self, params: ParamsActualizarJugador) -> Result<Jugador, ErrorJugador>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarJugador {}

        #[async_trait]
        impl ActualizarJugador for ActualizarJugador {
            async fn ejecutar(&self, params: ParamsActualizarJugador) -> Result<Jugador, ErrorJugador>;
        }
    }
}

pub struct ActualizarJugadorImpl {
    pub repositorio: Arc<dyn RepositorioJugador>,
}

#[async_trait]
impl ActualizarJugador for ActualizarJugadorImpl {
    #[tracing::instrument(name = "actualizar_jugador", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsActualizarJugador) -> Result<Jugador, ErrorJugador> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorJugador::NoEncontrado)?;
        entidad.actualizar(PropsJugador {
            equipo_id: params.equipo_id,
            dorsal: params.dorsal,
            email: params.email,
        })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_jugador::{
        modelo::IdJugador, pruebas::madres::MadreJugador,
        repositorio::dobles::MockRepositorioJugador,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_actualizar_jugador_cuando_los_parametros_son_validos() {
        // Preparar
        let props = MadreJugador::new().construir_props();
        let mut entidad = MadreJugador::aleatorio();
        // Lo que estaba guardado, distinto de lo que trae la actualización.
        entidad.email = "original".to_string();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = ActualizarJugadorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarJugador {
                actor: MadrePrincipal::aleatorio(),
                id: id_entidad,
                equipo_id: props.equipo_id,
                dorsal: props.dorsal,
                email: props.email,
            })
            .await;

        // Comprobar
        assert_eq!(
            resultado.unwrap().email,
            MadreJugador::new().construir_props().email
        );
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_jugador_no_existe() {
        // Preparar
        let props = MadreJugador::new().construir_props();
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ActualizarJugadorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarJugador {
                actor: MadrePrincipal::aleatorio(),
                id: IdJugador::generar(),
                equipo_id: props.equipo_id,
                dorsal: props.dorsal,
                email: props.email,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "jugador.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_email_es_una_cadena_vacia() {
        // Preparar
        let props = MadreJugador::new().construir_props();
        let entidad = MadreJugador::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ActualizarJugadorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarJugador {
                actor: MadrePrincipal::aleatorio(),
                id: id_entidad,
                equipo_id: props.equipo_id,
                dorsal: props.dorsal,
                email: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "jugador.validacion.email_vacio"
        );
    }
}

