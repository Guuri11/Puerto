=== contextos/equipo/dominio/src/pruebas/madres.rs ===
use crate::modelo::Equipo;
use crate::modelo::PropsEquipo;

pub struct MadreEquipo {
    nombre: Option<String>,
}

impl MadreEquipo {
    pub fn new() -> Self {
        Self { nombre: None }
    }

    pub fn con_nombre(mut self, nombre: &str) -> Self {
        self.nombre = Some(nombre.to_string());
        self
    }

    pub fn con_nombre_vacio(mut self) -> Self {
        self.nombre = Some(String::new());
        self
    }

    pub fn construir(self) -> Equipo {
        Equipo::new(PropsEquipo {
            nombre: self.nombre.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadreEquipo: Equipo::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsEquipo {
        PropsEquipo {
            nombre: self.nombre.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Equipo {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Equipo> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreEquipo {
    fn default() -> Self {
        Self::new()
    }
}

