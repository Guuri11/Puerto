=== web/src/contextos/equipo/vistas/formulario-equipo.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaEquipo } from "../mensajes";

type Equipo = Esquemas["DtoEquipo"];
type PeticionEquipo = Esquemas["PeticionCrearEquipo"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioEquipo {
  nombre: string;
}

/** Los inputs de `equipo`, vacíos cuando todavía no hay ninguno. */
export function aFormularioEquipo(equipo: Equipo | null): ValoresFormularioEquipo {
  if (equipo === null) {
    return {
      nombre: "",
    };
  }
  return {
    nombre: equipo.nombre,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionEquipo(valores: ValoresFormularioEquipo): PeticionEquipo {
  return {
    nombre: valores.nombre,
  };
}

export function VistaFormularioEquipo({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioEquipo;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaEquipo | null;
  alCambiar: (valores: ValoresFormularioEquipo) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Nombre</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "nombre"}
          required
          value={valores.nombre}
          onChange={(event) => alCambiar({ ...valores, nombre: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="nombre" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

