// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.

import { Route, Switch } from "wouter";
import { contarTotal, PAGINA_DE_UNO } from "../api/http";
import { RequiereAuth } from "../auth/auth";
import type { EntradaMenu } from "../compartido/ui/marco";
import { ContenedorDetalleEquipo } from "../contextos/equipo/contenedores/detalle-equipo";
import { ContenedorFormularioEquipo } from "../contextos/equipo/contenedores/formulario-equipo";
import { ContenedorListaEquipo } from "../contextos/equipo/contenedores/lista-equipo";
import { ContenedorDetalleJugador } from "../contextos/jugador/contenedores/detalle-jugador";
import { ContenedorFormularioJugador } from "../contextos/jugador/contenedores/formulario-jugador";
import { ContenedorListaJugador } from "../contextos/jugador/contenedores/lista-jugador";
import { PaginaNoEncontrada } from "../paginas/no-encontrada";
import { PaginaPanel } from "../paginas/panel";
import { PaginaPerfil } from "../paginas/perfil";
import { rutasPropias } from "../rutas";

/** Dónde va la app: en la raíz o, con portada, en `[proyecto] ruta_app` (`puerto nuevo --portada`). */
export const rutaApp = "/";

export const entradasMenu: EntradaMenu[] = [
  {
    etiqueta: "Equipos",
    href: "/equipos",
    total: ({ api }) => contarTotal(api.GET("/equipos", PAGINA_DE_UNO)),
  },
  {
    etiqueta: "Jugadores",
    href: "/jugadores",
    total: ({ api }) => contarTotal(api.GET("/jugadores", PAGINA_DE_UNO)),
  },
];

export function RutasApp() {
  return (
    <Switch>
      <Route path="/">
        <RequiereAuth>
          <PaginaPanel entradas={entradasMenu} />
        </RequiereAuth>
      </Route>
      <Route path="/perfil">
        <RequiereAuth>
          <PaginaPerfil />
        </RequiereAuth>
      </Route>
      {rutasPropias}
      <Route path="/equipos">
        <RequiereAuth>
          <ContenedorListaEquipo />
        </RequiereAuth>
      </Route>
      <Route path="/equipos/nuevo">
        <RequiereAuth>
          <ContenedorFormularioEquipo />
        </RequiereAuth>
      </Route>
      <Route path="/equipos/:id/editar">
        {(params) => (
          <RequiereAuth>
            <ContenedorFormularioEquipo id={params.id} />
          </RequiereAuth>
        )}
      </Route>
      <Route path="/equipos/:id">
        {(params) => (
          <RequiereAuth>
            <ContenedorDetalleEquipo id={params.id} />
          </RequiereAuth>
        )}
      </Route>
      <Route path="/jugadores">
        <ContenedorListaJugador />
      </Route>
      <Route path="/jugadores/nuevo">
        <RequiereAuth>
          <ContenedorFormularioJugador />
        </RequiereAuth>
      </Route>
      <Route path="/jugadores/:id/editar">
        {(params) => (
          <RequiereAuth>
            <ContenedorFormularioJugador id={params.id} />
          </RequiereAuth>
        )}
      </Route>
      <Route path="/jugadores/:id">{(params) => <ContenedorDetalleJugador id={params.id} />}</Route>
      <Route>
        <PaginaNoEncontrada />
      </Route>
    </Switch>
  );
}

