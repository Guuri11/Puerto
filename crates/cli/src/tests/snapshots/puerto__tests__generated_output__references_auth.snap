use dominio_equipo::modelo::Equipo;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoEquipo {
    pub id: Uuid,
    pub nombre: String,
}

impl DtoEquipo {
    pub fn from_dominio(entidad: &Equipo) -> Self {
        Self {
            id: entidad.id.valor(),
            nombre: entidad.nombre.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearEquipo {
    pub nombre: String,
}

/// Una página de Equipos: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaEquipo {
    pub elementos: Vec<DtoEquipo>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaEquipo {
    pub fn from_dominio(pagina: &Pagina<Equipo>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoEquipo::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarEquipo {
    pub nombre: String,
}

=== contextos/equipo/rest/src/errores.rs ===
use dominio_equipo::errores::ErrorEquipo;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de equipo como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorEquipo) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorEquipo::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorEquipo::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorEquipo::Duplicado => StatusCode::CONFLICT,
        ErrorEquipo::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorEquipo::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorEquipo::Prohibido => StatusCode::FORBIDDEN,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorEquipo::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "equipo.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEquipo::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "equipo.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEquipo::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "equipo.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEquipo::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "equipo.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEquipo::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "equipo.desconocido");
    }

    #[test]
    fn deberia_mapear_prohibido_a_403_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEquipo::Prohibido);

        // Comprobar
        assert_eq!(status, StatusCode::FORBIDDEN);
        assert_eq!(cuerpo.codigo, "equipo.prohibido");
    }
}

