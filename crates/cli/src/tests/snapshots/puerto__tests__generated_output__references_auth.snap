    <Switch>
      <Route path="/">
        <HomePage entries={navEntries} />
      </Route>
      <Route path="/auth/callback">
        <AuthCallbackPage />
      </Route>
      {customRoutes}
      <Route path="/equipos">
        <RequireAuth>
          <EquipoListContainer />
        </RequireAuth>
      </Route>
      <Route path="/equipos/new">
        <RequireAuth>
          <EquipoFormContainer />
        </RequireAuth>
      </Route>
      <Route path="/equipos/:id/edit">
        {(params) => (
          <RequireAuth>
            <EquipoFormContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/equipos/:id">
        {(params) => (
          <RequireAuth>
            <EquipoDetailContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/jugadores">
        <JugadorListContainer />
      </Route>
      <Route path="/jugadores/new">
        <RequireAuth>
          <JugadorFormContainer />
        </RequireAuth>
      </Route>
      <Route path="/jugadores/:id/edit">
        {(params) => (
          <RequireAuth>
            <JugadorFormContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/jugadores/:id">{(params) => <JugadorDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

