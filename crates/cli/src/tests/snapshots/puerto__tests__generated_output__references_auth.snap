=== contextos/usuario/dominio/src/modelo.rs ===
//! Lo escribe una vez `puerto nuevo --auth`; desde entonces es tuyo. Todo el que llama con sesión
//! iniciada es una fila `Usuario` (ADR-0021 § 3 de Puerto): lo que referencian otras entidades
//! (`owner: IdUsuario`), sea cual sea el proveedor con el que inició sesión.

use chrono::{DateTime, Utc};
use uuid::Uuid;

/// El id de cada `Usuario`: un `Uuid` que no se puede pasar donde se espera el id de otra entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdUsuario(Uuid);

impl IdUsuario {
    /// Un id nuevo y aleatorio, para un usuario que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila), sin validar: todo `Uuid` es un id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdUsuario {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

/// Quien inició sesión, tal como lo conoce este proyecto. `(emisor, sujeto)` es el nombre que da
/// el proveedor a la persona y es único; `email` y `name` son lo que dijo el proveedor la primera
/// vez.
#[derive(Debug, Clone, PartialEq)]
pub struct Usuario {
    pub id: IdUsuario,
    pub emisor: String,
    pub sujeto: String,
    pub email: Option<String>,
    pub nombre: Option<String>,
    /// No se lee en un proyecto OIDC: allí los roles vienen solo del token, para que decida un
    /// único sitio.
    pub roles: Vec<String>,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
}

impl Usuario {
    /// El usuario que crea la primera petición de `(emisor, sujeto)` (alta just-in-time).
    pub fn aprovisionar(
        emisor: impl Into<String>,
        sujeto: impl Into<String>,
        email: Option<String>,
        nombre: Option<String>,
    ) -> Self {
        let ahora = Utc::now();
        Self {
            id: IdUsuario::generar(),
            emisor: emisor.into(),
            sujeto: sujeto.into(),
            email,
            nombre,
            roles: vec![],
            creado_en: ahora,
            actualizado_en: ahora,
        }
    }

    /// Reconstruye desde la persistencia, sin validar. SOLO lo usa la infraestructura.
    pub fn from_repositorio(datos: Usuario) -> Self {
        datos
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_guardar_lo_que_dijo_el_proveedor_cuando_se_da_de_alta() {
        // Actuar
        let usuario = Usuario::aprovisionar(
            "http://localhost:8180/realms/shop",
            "f81d4fae",
            Some("ada@example.com".into()),
            Some("Ada Lovelace".into()),
        );

        // Comprobar
        assert_eq!(usuario.emisor, "http://localhost:8180/realms/shop");
        assert_eq!(usuario.sujeto, "f81d4fae");
        assert_eq!(usuario.email.as_deref(), Some("ada@example.com"));
        assert_eq!(usuario.nombre.as_deref(), Some("Ada Lovelace"));
        assert!(usuario.roles.is_empty());
        assert_eq!(usuario.creado_en, usuario.actualizado_en);
    }

    #[test]
    fn deberia_recibir_un_id_nuevo_cuando_se_dan_de_alta_dos_usuarios() {
        // Actuar
        let ada = Usuario::aprovisionar("issuer", "ada", None, None);
        let bob = Usuario::aprovisionar("issuer", "bob", None, None);

        // Comprobar
        assert_ne!(ada.id, bob.id);
    }
}

=== contextos/usuario/dominio/src/repositorio.rs ===
use async_trait::async_trait;
use puerto_nucleo::ErrorRepositorio;

use crate::modelo::{IdUsuario, Usuario};

#[async_trait]
pub trait RepositorioUsuario: Send + Sync {
    /// El usuario al que el proveedor `emisor` llama `sujeto`.
    async fn buscar_por_sujeto(
        &self,
        emisor: &str,
        sujeto: &str,
    ) -> Result<Option<Usuario>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdUsuario) -> Result<Option<Usuario>, ErrorRepositorio>;
    /// Inserta o actualiza por id; otro usuario con el mismo `(emisor, sujeto)` es `Duplicado`.
    async fn guardar(&self, usuario: &Usuario) -> Result<(), ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub RepositorioUsuario {}

        #[async_trait]
        impl RepositorioUsuario for RepositorioUsuario {
            async fn buscar_por_sujeto(
                &self,
                emisor: &str,
                sujeto: &str,
            ) -> Result<Option<Usuario>, ErrorRepositorio>;
            async fn buscar_por_id(&self, id: IdUsuario) -> Result<Option<Usuario>, ErrorRepositorio>;
            async fn guardar(&self, usuario: &Usuario) -> Result<(), ErrorRepositorio>;
        }
    }
}

