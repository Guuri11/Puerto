import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionEquipo, MadreEquipo } from "../../../pruebas/equipo";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleEquipo } from "./detalle-equipo";

describe("ContenedorDetalleEquipo", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreEquipo.aleatorio();
    const api = apiFalsa([coleccionEquipo([sembrado])]);

    const pantalla = <ContenedorDetalleEquipo id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionEquipo()]);
    const pantalla = <ContenedorDetalleEquipo id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("equipo.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreEquipo.aleatorio();
    const guardados = coleccionEquipo([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleEquipo id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/equipos"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });

  test("debería mostrar auth.prohibido cuando la API rechaza el borrado", async () => {
    // Preparar
    const sembrado = MadreEquipo.aleatorio();
    const fallos = { "DELETE /equipos": "auth.prohibido" };
    const api = apiFalsa([coleccionEquipo([sembrado])], fallos);
    const pantalla = <ContenedorDetalleEquipo id={sembrado.id} />;
    renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
});

=== web/src/contextos/equipo/contenedores/detalle-equipo.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleEquipo } from "../vistas/detalle-equipo";

export function ContenedorDetalleEquipo({ id }: { id: string }) {
  const { api } = useDependencias();
  const equipo = useCarga(
    () => desenvolver(api.GET("/equipos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/equipos/{id}", { params: { path: { id } } }));
      navegar("/equipos");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Equipo</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {equipo.estado === "cargando" && <span className="loading loading-spinner" />}
      {equipo.estado === "error" && <AlertaError error={equipo.error} />}
      {equipo.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleEquipo equipo={equipo.datos} />
            <div className="card-actions justify-end">
              <Link href={`/equipos/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/equipos" className="link">
        Volver a equipos
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar equipo?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/equipo/contenedores/formulario-equipo.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionEquipo, MadreEquipo } from "../../../pruebas/equipo";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioEquipo } from "./formulario-equipo";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearEquipo"]) {
  await screen.findByText("Guardar");
  escribir("Nombre", peticion.nombre);
}

describe("ContenedorFormularioEquipo", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreEquipo.peticion();
    const guardados = coleccionEquipo();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioEquipo />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/equipos/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/equipos/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreEquipo.aleatorio();
    const guardados = coleccionEquipo([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioEquipo id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/equipos/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreEquipo.peticion();
    const codigo = "equipo.validacion.invalido";
    const fallos = { "POST /equipos": codigo };
    const api = apiFalsa([coleccionEquipo()], fallos);
    renderizarPantalla(<ContenedorFormularioEquipo />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreEquipo.peticion();
    const codigo = "equipo.duplicado";
    const fallos = { "POST /equipos": codigo };
    const api = apiFalsa([coleccionEquipo()], fallos);
    renderizarPantalla(<ContenedorFormularioEquipo />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreEquipo.peticion();
    const codigo = "equipo.validacion.nombre_vacio";
    const fallos = { "POST /equipos": codigo };
    const api = apiFalsa([coleccionEquipo()], fallos);
    renderizarPantalla(<ContenedorFormularioEquipo />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Nombre");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/equipo/contenedores/formulario-equipo.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioEquipo,
  aPeticionEquipo,
  VistaFormularioEquipo,
} from "../vistas/formulario-equipo";

type Equipo = Esquemas["DtoEquipo"];

/** Crear, o editar con `id`: el formulario de equipos. */
export function ContenedorFormularioEquipo({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/equipos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear equipo" : "Editar equipo";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioEquipo existente={existente.datos} />}
      <Link href={id === undefined ? "/equipos" : `/equipos/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioEquipo({ existente }: { existente: Equipo | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioEquipo(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionEquipo(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/equipos", { body: cuerpo })
          : api.PUT("/equipos/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/equipos/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioEquipo
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

