use async_trait::async_trait;
use dominio_equipo::errores::ErrorEquipo;
use dominio_equipo::modelo::IdEquipo;
use dominio_equipo::repositorio::RepositorioEquipo;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarEquipo {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub id: IdEquipo,
}

#[async_trait]
pub trait BorrarEquipo: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarEquipo) -> Result<(), ErrorEquipo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarEquipo {}

        #[async_trait]
        impl BorrarEquipo for BorrarEquipo {
            async fn ejecutar(&self, params: ParamsBorrarEquipo) -> Result<(), ErrorEquipo>;
        }
    }
}

pub struct BorrarEquipoImpl {
    pub repositorio: Arc<dyn RepositorioEquipo>,
}

#[async_trait]
impl BorrarEquipo for BorrarEquipoImpl {
    async fn ejecutar(&self, params: ParamsBorrarEquipo) -> Result<(), ErrorEquipo> {
        tracing::info!(id = %params.id, "borrar_equipo: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_equipo: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = ErrorEquipo::NoEncontrado;
                tracing::warn!(error = %err, "borrar_equipo: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_equipo: fallo del repositorio"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_equipo::{
        modelo::IdEquipo, pruebas::madres::MadreEquipo, repositorio::dobles::MockRepositorioEquipo,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_hacer_borrado_logico_de_equipo_cuando_el_id_existe() {
        let entidad = MadreEquipo::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = BorrarEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarEquipo {
                actor: MadrePrincipal::aleatorio(),
                id: id_entidad,
            })
            .await;

        assert!(resultado.is_ok());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_equipo_no_existe() {
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = BorrarEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarEquipo {
                actor: MadrePrincipal::aleatorio(),
                id: IdEquipo::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "equipo.no_encontrado");
    }
}

=== contextos/equipo/aplicacion/src/crear_equipo.rs ===
use async_trait::async_trait;
use dominio_equipo::errores::ErrorEquipo;
use dominio_equipo::modelo::{Equipo, PropsEquipo};
use dominio_equipo::repositorio::RepositorioEquipo;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearEquipo {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub nombre: String,
}

#[async_trait]
pub trait CrearEquipo: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearEquipo) -> Result<Equipo, ErrorEquipo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearEquipo {}

        #[async_trait]
        impl CrearEquipo for CrearEquipo {
            async fn ejecutar(&self, params: ParamsCrearEquipo) -> Result<Equipo, ErrorEquipo>;
        }
    }
}

pub struct CrearEquipoImpl {
    pub repositorio: Arc<dyn RepositorioEquipo>,
}

#[async_trait]
impl CrearEquipo for CrearEquipoImpl {
    async fn ejecutar(&self, params: ParamsCrearEquipo) -> Result<Equipo, ErrorEquipo> {
        tracing::info!("crear_equipo: inicio");
        let entidad = Equipo::new(PropsEquipo {
            nombre: params.nombre,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_equipo: rechazado"))?;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "crear_equipo: fallo del repositorio"))?;
        tracing::info!(id = %entidad.id, "crear_equipo: fin");
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_equipo::pruebas::madres::MadreEquipo;
    use dominio_equipo::repositorio::dobles::MockRepositorioEquipo;
    use puerto_nucleo::ErrorRepositorio;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_crear_equipo_cuando_el_nombre_es_valido() {
        // Preparar
        let props = MadreEquipo::new().construir_props();
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = CrearEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEquipo {
                actor: MadrePrincipal::aleatorio(),
                nombre: props.nombre,
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(
            resultado.unwrap().nombre,
            MadreEquipo::new().construir_props().nombre
        );
    }

    #[tokio::test]
    async fn deberia_devolver_duplicado_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let props = MadreEquipo::new().construir_props();
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::Duplicado));
        let caso_de_uso = CrearEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEquipo {
                actor: MadrePrincipal::aleatorio(),
                nombre: props.nombre,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "equipo.duplicado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_nombre_es_una_cadena_vacia() {
        // Preparar
        let repositorio_doble = MockRepositorioEquipo::new();
        let caso_de_uso = CrearEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEquipo {
                actor: MadrePrincipal::aleatorio(),
                nombre: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "equipo.validacion.nombre_vacio"
        );
    }
}

