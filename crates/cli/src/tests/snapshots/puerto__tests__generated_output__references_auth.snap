=== contextos/jugador/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorJugador {
    #[error("jugador.validacion.{0}")]
    Validacion(String),
    #[error("jugador.no_encontrado")]
    NoEncontrado,
    #[error("jugador.duplicado")]
    Duplicado,
    #[error("jugador.repositorio")]
    Repositorio,
    #[error("jugador.desconocido")]
    Desconocido,
    /// Quien llama no puede hacer esto con estos datos: regla del caso de uso, sobre su `actor`.
    #[error("jugador.prohibido")]
    Prohibido,
}

impl From<ErrorRepositorio> for ErrorJugador {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            // Una referencia nombra una fila inexistente: la entrada de quien llama, en ese campo.
            ErrorRepositorio::ReferenciaInexistente(campo) => {
                Self::Validacion(format!("{campo}_no_encontrado"))
            }
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorJugador::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "jugador.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorJugador::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "jugador.repositorio");
    }

    #[test]
    fn deberia_convertir_una_referencia_inexistente_en_una_validacion_de_su_campo() {
        let err = ErrorJugador::from(ErrorRepositorio::ReferenciaInexistente("equipo_id"));
        assert_eq!(
            err.to_string(),
            "jugador.validacion.equipo_id_no_encontrado"
        );
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorJugador::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "jugador.repositorio");
    }
}

