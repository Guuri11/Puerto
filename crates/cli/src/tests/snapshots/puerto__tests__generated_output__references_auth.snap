use async_trait::async_trait;
use dominio_equipo::modelo::IdEquipo;
use dominio_jugador::errores::ErrorJugador;
use dominio_jugador::modelo::{Jugador, PropsJugador};
use dominio_jugador::repositorio::RepositorioJugador;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearJugador {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub equipo_id: IdEquipo,
    pub dorsal: i64,
    pub email: String,
}

#[async_trait]
pub trait CrearJugador: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearJugador) -> Result<Jugador, ErrorJugador>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearJugador {}

        #[async_trait]
        impl CrearJugador for CrearJugador {
            async fn ejecutar(&self, params: ParamsCrearJugador) -> Result<Jugador, ErrorJugador>;
        }
    }
}

pub struct CrearJugadorImpl {
    pub repositorio: Arc<dyn RepositorioJugador>,
}

#[async_trait]
impl CrearJugador for CrearJugadorImpl {
    async fn ejecutar(&self, params: ParamsCrearJugador) -> Result<Jugador, ErrorJugador> {
        tracing::info!("crear_jugador: inicio");
        let entidad = Jugador::new(PropsJugador {
            equipo_id: params.equipo_id,
            dorsal: params.dorsal,
            email: params.email,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_jugador: rechazado"))?;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "crear_jugador: fallo del repositorio"))?;
        tracing::info!(id = %entidad.id, "crear_jugador: fin");
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_jugador::pruebas::madres::MadreJugador;
    use dominio_jugador::repositorio::dobles::MockRepositorioJugador;
    use puerto_nucleo::ErrorRepositorio;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_crear_jugador_cuando_los_campos_son_validos() {
        // Preparar
        let props = MadreJugador::new().construir_props();
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = CrearJugadorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearJugador {
                actor: MadrePrincipal::aleatorio(),
                equipo_id: props.equipo_id,
                dorsal: props.dorsal,
                email: props.email,
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(
            resultado.unwrap().email,
            MadreJugador::new().construir_props().email
        );
    }

    #[tokio::test]
    async fn deberia_devolver_duplicado_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let props = MadreJugador::new().construir_props();
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::Duplicado));
        let caso_de_uso = CrearJugadorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearJugador {
                actor: MadrePrincipal::aleatorio(),
                equipo_id: props.equipo_id,
                dorsal: props.dorsal,
                email: props.email,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "jugador.duplicado");
    }

    #[tokio::test]
    async fn deberia_devolver_un_error_de_validacion_cuando_equipo_id_no_existe() {
        // Preparar: en el almacén no hay Equipo con ese id.
        let props = MadreJugador::new().construir_props();
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::ReferenciaInexistente("equipo_id")));
        let caso_de_uso = CrearJugadorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearJugador {
                actor: MadrePrincipal::aleatorio(),
                equipo_id: props.equipo_id,
                dorsal: props.dorsal,
                email: props.email,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "jugador.validacion.equipo_id_no_encontrado"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_email_es_una_cadena_vacia() {
        // Preparar
        let props = MadreJugador::new().construir_props();
        let repositorio_doble = MockRepositorioJugador::new();
        let caso_de_uso = CrearJugadorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearJugador {
                actor: MadrePrincipal::aleatorio(),
                equipo_id: props.equipo_id,
                dorsal: props.dorsal,
                email: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "jugador.validacion.email_vacio"
        );
    }
}

