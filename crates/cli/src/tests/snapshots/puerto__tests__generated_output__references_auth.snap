// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generar bootstrap`.
//
// The composition root: the only module that builds the API client. Screens reach it through
// `useDependencies()`, so a test hands them a fake instead.

import { type ApiClient, createApiClient } from "../api/client";
import { bearerMiddleware } from "../auth/bearer-middleware";
import { oidcAuthGateway, oidcSettingsFromEnv } from "../auth/oidc-auth-gateway";
import type { AuthGateway } from "../auth/session";

export interface Dependencies {
  api: ApiClient;
  auth: AuthGateway;
}

export function createDependencies(): Dependencies {
  const auth = oidcAuthGateway(oidcSettingsFromEnv());
  const api = createApiClient();
  api.use(bearerMiddleware(auth));
  return { api, auth };
}

