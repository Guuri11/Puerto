use async_trait::async_trait;
use dominio_equipo::errores::ErrorEquipo;
use dominio_equipo::modelo::Equipo;
use dominio_equipo::repositorio::RepositorioEquipo;
use puerto_nucleo::auth::Principal;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarEquipos {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarEquipos: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarEquipos) -> Result<Pagina<Equipo>, ErrorEquipo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarEquipos {}

        #[async_trait]
        impl ListarEquipos for ListarEquipos {
            async fn ejecutar(&self, params: ParamsListarEquipos) -> Result<Pagina<Equipo>, ErrorEquipo>;
        }
    }
}

pub struct ListarEquiposImpl {
    pub repositorio: Arc<dyn RepositorioEquipo>,
}

#[async_trait]
impl ListarEquipos for ListarEquiposImpl {
    async fn ejecutar(&self, params: ParamsListarEquipos) -> Result<Pagina<Equipo>, ErrorEquipo> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_equipos: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_equipos: fallo del repositorio"))
            .map_err(ErrorEquipo::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_equipo::{
        pruebas::madres::MadreEquipo, repositorio::dobles::MockRepositorioEquipo,
    };
    use puerto_nucleo::PeticionPagina;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_equipos() {
        let entidades = MadreEquipo::aleatorios(2);
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarEquiposImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEquipos {
                actor: MadrePrincipal::aleatorio(),
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_equipos() {
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEquiposImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEquipos {
                actor: MadrePrincipal::aleatorio(),
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEquiposImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEquipos {
                actor: MadrePrincipal::aleatorio(),
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

