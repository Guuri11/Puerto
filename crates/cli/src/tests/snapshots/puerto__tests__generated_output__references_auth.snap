import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Schemas } from "../../../api/client";
import { EquipoMother, equipoCollection } from "../../../test-support/equipo";
import { fakeApi } from "../../../test-support/fake-api";
import { JugadorMother, jugadorCollection } from "../../../test-support/jugador";
import { renderScreen } from "../../../test-support/render";
import { JugadorFormContainer } from "./jugador-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The collections the selects read, holding what `owner` references. */
function referencedBy(owner: Partial<Schemas["DtoJugador"]>) {
  return [equipoCollection([EquipoMother.random({ id: owner.equipoId ?? crypto.randomUUID() })])];
}

/** Fills the empty form with `request`, the way a user would. */
async function fillIn(request: Schemas["PeticionCrearJugador"]) {
  await screen.findByText("Save");
  await choose("Equipo", request.equipoId);
  type("Dorsal", String(request.dorsal));
  type("Email", request.email);
}

describe("JugadorFormContainer", () => {
  test("should create the jugador from what was typed and show it", async () => {
    // Arrange
    const request = JugadorMother.request();
    const stored = jugadorCollection();
    const api = fakeApi([stored, ...referencedBy(request)]);
    const { history } = renderScreen(<JugadorFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/jugadores/"));
    const [created] = stored.items.values();
    expect(created).toMatchObject(request);
    expect(history.at(-1)).toBe(`/jugadores/${created?.id}`);
  });

  test("should save the edited jugador when an existing one is submitted", async () => {
    // Arrange
    const seeded = JugadorMother.random();
    const stored = jugadorCollection([seeded]);
    const api = fakeApi([stored, ...referencedBy(seeded)]);
    const { history } = renderScreen(<JugadorFormContainer id={seeded.id} />, { api });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/jugadores/${seeded.id}`));
    expect(stored.items.get(seeded.id)).toEqual(seeded);
  });
  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const request = JugadorMother.request();
    const code = "jugador.validacion.invalid";
    const failures = { "POST /jugadores": code };
    const api = fakeApi([jugadorCollection(), ...referencedBy(request)], failures);
    renderScreen(<JugadorFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a jugador with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const request = JugadorMother.request();
    const failures = { "POST /jugadores": "jugador.duplicado" };
    const api = fakeApi([jugadorCollection(), ...referencedBy(request)], failures);
    renderScreen(<JugadorFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A jugador with these values already exists",
    );
  });

  test("should offer every equipo in the selects that reference one", async () => {
    // Arrange
    const equipo = EquipoMother.random();
    const api = fakeApi([equipoCollection([equipo])]);

    // Act
    renderScreen(<JugadorFormContainer />, { api });

    // Assert
    const options = await screen.findAllByRole("option", { name: equipo.nombre });
    expect(options).toHaveLength(1);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const request = JugadorMother.request();
    const failures = { "POST /jugadores": "jugador.validacion.equipo_id_no_encontrado" };
    const api = fakeApi([jugadorCollection(), ...referencedBy(request)], failures);
    renderScreen(<JugadorFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Equipo does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Equipo");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/features/jugador/containers/jugador-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Schemas } from "../../../api/client";
import { MAX_PAGE_LIMIT, unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { toProblem } from "../messages";
import { JugadorFormView, toJugadorForm, toJugadorRequest } from "../views/jugador-form-view";

type Jugador = Schemas["DtoJugador"];

/** The first page of each referenced entity: what its selects offer. */
const OPTIONS = { params: { query: { limite: MAX_PAGE_LIMIT } } };

/** Creates a jugador, or edits the one with `id`. */
export function JugadorFormContainer({ id }: { id?: string }) {
  const { api } = useDependencies();
  const existing = useAsync(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : unwrap(api.GET("/jugadores/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const title = id === undefined ? "New jugador" : "Edit jugador";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <JugadorForm existing={existing.data} />}
      <Link href={id === undefined ? "/jugadores" : `/jugadores/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function JugadorForm({ existing }: { existing: Jugador | null }) {
  const { api } = useDependencies();
  const equipos = useAsync(() => unwrap(api.GET("/equipos", OPTIONS)), [api]);
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toJugadorForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const body = toJugadorRequest(values);
      const saved = await unwrap(
        existing === null
          ? api.POST("/jugadores", { body })
          : api.PUT("/jugadores/{id}", { params: { path: { id: existing.id } }, body }),
      );
      navigate(`/jugadores/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {equipos.status === "error" && <ErrorAlert error={equipos.error} />}
        <JugadorFormView
          values={values}
          options={{
            equipoId: referenceOptions(equipos, (equipo) => equipo.nombre),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

