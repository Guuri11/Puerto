        let entidad = MadreJugador::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
