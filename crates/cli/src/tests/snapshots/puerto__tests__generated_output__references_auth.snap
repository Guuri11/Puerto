  <StrictMode>
    <DependenciesProvider value={createDependencies()}>
      <AuthProvider>
        <Layout title={document.title} nav={navEntries}>
          <AppRoutes />
        </Layout>
      </AuthProvider>
    </DependenciesProvider>
  </StrictMode>,
);

