=== contextos/jugador/rest/src/respuestas.rs ===
// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoJugador, DtoPaginaJugador};

#[derive(ApiResponse)]
pub enum RespuestaCrearJugador {
    #[oai(status = 201)]
    Creado(Json<DtoJugador>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearJugador {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerJugador {
    #[oai(status = 200)]
    Ok(Json<DtoJugador>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerJugador {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarJugadores {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaJugador>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarJugadores {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarJugador {
    #[oai(status = 200)]
    Ok(Json<DtoJugador>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarJugador {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarJugador {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaBorrarJugador {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

=== contextos/jugador/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_jugador::{
    actualizar_jugador::{ActualizarJugador, ParamsActualizarJugador},
    borrar_jugador::{BorrarJugador, ParamsBorrarJugador},
    crear_jugador::{CrearJugador, ParamsCrearJugador},
    listar_jugadores::{ListarJugadores, ParamsListarJugadores},
    obtener_jugador::{ObtenerJugador, ParamsObtenerJugador},
};
use dominio_equipo::modelo::IdEquipo;
use dominio_jugador::modelo::IdJugador;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use puerto_web::auth::{BearerAuth, BearerAuthOpcional};
use puerto_web::requiere_rol;
use uuid::Uuid;

use crate::dto::{DtoJugador, DtoPaginaJugador, PeticionActualizarJugador, PeticionCrearJugador};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarJugador, RespuestaBorrarJugador, RespuestaCrearJugador,
    RespuestaListarJugadores, RespuestaObtenerJugador,
};

#[derive(Tags)]
enum ApiTags {
    Jugador,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiJugador {
    pub crear_jugador: Arc<dyn CrearJugador>,
    pub obtener_jugador: Arc<dyn ObtenerJugador>,
    pub listar_jugadores: Arc<dyn ListarJugadores>,
    pub actualizar_jugador: Arc<dyn ActualizarJugador>,
    pub borrar_jugador: Arc<dyn BorrarJugador>,
}

#[OpenApi]
impl ApiJugador {
    /// Crea: Jugador
    #[oai(path = "/jugadores", method = "post", tag = "ApiTags::Jugador")]
    async fn crear(
        &self,
        auth: BearerAuth,
        cuerpo: Json<PeticionCrearJugador>,
    ) -> RespuestaCrearJugador {
        match self
            .crear_jugador
            .ejecutar(ParamsCrearJugador {
                actor: auth.0,
                equipo_id: IdEquipo::from_uuid(cuerpo.equipo_id),
                dorsal: cuerpo.dorsal,
                email: cuerpo.email.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearJugador::Creado(Json(DtoJugador::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_jugador falló");
                RespuestaCrearJugador::from_status(status, error)
            }
        }
    }

    /// Obtiene: Jugador por id
    #[oai(path = "/jugadores/:id", method = "get", tag = "ApiTags::Jugador")]
    async fn obtener(&self, auth: BearerAuthOpcional, id: Path<Uuid>) -> RespuestaObtenerJugador {
        match self
            .obtener_jugador
            .ejecutar(ParamsObtenerJugador {
                id: IdJugador::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerJugador::Ok(Json(dto(&auth, &entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_jugador falló");
                RespuestaObtenerJugador::from_status(status, error)
            }
        }
    }

    /// Lista Jugadores, página a página (el dominio acota `limite`)
    #[oai(path = "/jugadores", method = "get", tag = "ApiTags::Jugador")]
    async fn listar(
        &self,
        auth: BearerAuthOpcional,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
        #[oai(name = "equipoId")] equipo_id: Query<Option<Uuid>>,
    ) -> RespuestaListarJugadores {
        match self
            .listar_jugadores
            .ejecutar(ParamsListarJugadores {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
                equipo_id: equipo_id.0.map(IdEquipo::from_uuid),
            })
            .await
        {
            Ok(pagina) => RespuestaListarJugadores::Ok(Json(if auth.0.is_some() {
                DtoPaginaJugador::from_dominio(&pagina)
            } else {
                DtoPaginaJugador::from_dominio_publico(&pagina)
            })),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_jugadores falló");
                RespuestaListarJugadores::from_status(status, error)
            }
        }
    }

    /// Actualiza: Jugador
    #[oai(path = "/jugadores/:id", method = "put", tag = "ApiTags::Jugador")]
    #[requiere_rol("admin")]
    async fn actualizar(
        &self,
        auth: BearerAuth,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarJugador>,
    ) -> RespuestaActualizarJugador {
        match self
            .actualizar_jugador
            .ejecutar(ParamsActualizarJugador {
                actor: auth.0,
                id: IdJugador::from_uuid(id.0),
                equipo_id: IdEquipo::from_uuid(cuerpo.equipo_id),
                dorsal: cuerpo.dorsal,
                email: cuerpo.email.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarJugador::Ok(Json(DtoJugador::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_jugador falló");
                RespuestaActualizarJugador::from_status(status, error)
            }
        }
    }

    /// Borra: Jugador
    #[oai(path = "/jugadores/:id", method = "delete", tag = "ApiTags::Jugador")]
    #[requiere_rol("admin")]
    async fn borrar(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaBorrarJugador {
        match self
            .borrar_jugador
            .ejecutar(ParamsBorrarJugador {
                actor: auth.0,
                id: IdJugador::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarJugador::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_jugador falló");
                RespuestaBorrarJugador::from_status(status, error)
            }
        }
    }
}

/// La entidad entera a quien tiene sesión; sin los campos privados a quien no la tiene.
fn dto(auth: &BearerAuthOpcional, entidad: &dominio_jugador::modelo::Jugador) -> DtoJugador {
    if auth.0.is_some() {
        DtoJugador::from_dominio(entidad)
    } else {
        DtoJugador::from_dominio_publico(entidad)
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_jugador::{
        actualizar_jugador::dobles::MockActualizarJugador,
        borrar_jugador::dobles::MockBorrarJugador, crear_jugador::dobles::MockCrearJugador,
        listar_jugadores::dobles::MockListarJugadores, obtener_jugador::dobles::MockObtenerJugador,
    };
    use dominio_jugador::errores::ErrorJugador;
    use dominio_jugador::pruebas::madres::MadreJugador;
    use poem::{EndpointExt, Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;
    use puerto_nucleo::auth::dobles::MadrePrincipal;
    use puerto_nucleo::auth::dobles::MockAutenticador;
    use puerto_nucleo::auth::{Autenticador, ErrorAuth};

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearJugador,
        obtener: MockObtenerJugador,
        listar: MockListarJugadores,
        actualizar: MockActualizarJugador,
        borrar: MockBorrarJugador,
    }

    /// Acepta `llamante` (con todos los roles que pide alguna ruta de esta API) y `nadie`
    /// (sin roles).
    fn autenticador() -> Arc<dyn Autenticador> {
        let mut doble = MockAutenticador::new();
        doble.expect_autenticar().returning(|token| match token {
            "llamante" => Ok(MadrePrincipal::new().con_roles(["admin"]).construir()),
            "nadie" => Ok(MadrePrincipal::aleatorio()),
            _ => Err(ErrorAuth::Invalido),
        });
        Arc::new(doble)
    }

    impl Dobles {
        /// Todas las peticiones, con sesión iniciada como `llamante`.
        fn cliente(self) -> TestClient<impl poem::Endpoint> {
            self.cliente_con(Some("Bearer llamante"))
        }

        /// `autorizacion`: la cabecera que envía cada petición; con `None` no se envía ninguna.
        fn cliente_con(self, autorizacion: Option<&str>) -> TestClient<impl poem::Endpoint> {
            let api = ApiJugador {
                crear_jugador: Arc::new(self.crear),
                obtener_jugador: Arc::new(self.obtener),
                listar_jugadores: Arc::new(self.listar),
                actualizar_jugador: Arc::new(self.actualizar),
                borrar_jugador: Arc::new(self.borrar),
            };
            let cliente = TestClient::new(
                Route::new()
                    .nest("/", OpenApiService::new(api, "test", "1.0"))
                    .data(autenticador()),
            );
            match autorizacion {
                Some(valor) => cliente.default_header("Authorization", valor),
                None => cliente,
            }
        }
    }

    fn peticion_crear() -> PeticionCrearJugador {
        PeticionCrearJugador {
            equipo_id: Uuid::new_v4(),
            dorsal: 42,
            email: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarJugador {
        PeticionActualizarJugador {
            equipo_id: Uuid::new_v4(),
            dorsal: 42,
            email: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/jugadores/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_jugador() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreJugador::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/jugadores")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_jugador_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorJugador::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/jugadores")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_no_existe_la_referencia_de_equipo_id() {
        // Preparar: en la base de datos no hay Equipo con ese id (ADR-0022 de Puerto).
        let mut dobles = Dobles::default();
        dobles.crear.expect_ejecutar().returning(|_| {
            Err(ErrorJugador::Validacion(
                "equipo_id_no_encontrado".to_string(),
            ))
        });

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/jugadores")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("jugador.validacion.equipo_id_no_encontrado");
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_jugador_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreJugador::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_ocultar_los_campos_privados_a_quien_llama_sin_sesion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreJugador::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente_con(None).get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let cuerpo = respuesta.json().await;
        assert!(cuerpo.value().object().get_opt("email").is_none());
    }

    #[tokio::test]
    async fn deberia_mostrar_los_campos_privados_a_quien_tiene_sesion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreJugador::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let cuerpo = respuesta.json().await;
        assert!(cuerpo.value().object().get_opt("email").is_some());
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_jugador_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorJugador::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_jugadores_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreJugador::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/jugadores").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/jugadores?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_por_equipo_id_al_caso_de_uso() {
        // Preparar
        let equipo_id = Uuid::new_v4();
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(move |params| params.equipo_id == Some(IdEquipo::from_uuid(equipo_id)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get(format!("/jugadores?equipoId={equipo_id}"))
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorJugador::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/jugadores").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_jugador() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreJugador::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_jugador_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorJugador::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_jugador() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_jugador_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorJugador::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_crea_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .post("/jugadores")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_actualiza_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_403_cuando_se_actualiza_sin_el_rol() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(Some("Bearer nadie"))
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::FORBIDDEN);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("auth.prohibido");
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_borra_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .delete(ruta_elemento())
