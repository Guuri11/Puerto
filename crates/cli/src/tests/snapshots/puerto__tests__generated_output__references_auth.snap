import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { fakeApi } from "../../../test-support/fake-api";
import { JugadorMother, jugadorCollection } from "../../../test-support/jugador";
import { renderScreen } from "../../../test-support/render";
import { JugadorListContainer } from "./jugador-list-container";

describe("JugadorListContainer", () => {
  test("should show a row per jugador when there are some", async () => {
    // Arrange
    const seed = [JugadorMother.random(), JugadorMother.random()];
    const api = fakeApi([jugadorCollection(seed)]);

    // Act
    renderScreen(<JugadorListContainer />, { api });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => JugadorMother.random());
    const api = fakeApi([jugadorCollection(seed)]);
    renderScreen(<JugadorListContainer />, { api });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => JugadorMother.random());
    const api = fakeApi([jugadorCollection(seed)]);
    const path = "/jugadores?page=2";

    // Act
    renderScreen(<JugadorListContainer />, { api }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no jugador", async () => {
    // Arrange
    const api = fakeApi([jugadorCollection()]);

    // Act
    renderScreen(<JugadorListContainer />, { api });

    // Assert
    expect(await screen.findByText("No jugadores yet.")).toBeTruthy();
  });

  test("should show the error code when the jugadores cannot be listed", async () => {
    // Arrange
    const failures = { "GET /jugadores": "jugador.repositorio" };
    const api = fakeApi([jugadorCollection()], failures);

    // Act
    renderScreen(<JugadorListContainer />, { api });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("jugador.repositorio");
  });
});

=== web/src/features/jugador/containers/jugador-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE, unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { useAsync } from "../../../shared/use-async";
import { JugadorListView } from "../views/jugador-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function JugadorListContainer() {
  const { api } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const query = { limite: PAGE_SIZE, desplazamiento: offset };
  const jugadores = useAsync(
    () => unwrap(api.GET("/jugadores", { params: { query } })),
    [api, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Jugadores</h1>
        <Link href="/jugadores/new" className="btn btn-primary">
          New jugador
        </Link>
      </div>
      {jugadores.status === "loading" && <span className="loading loading-spinner" />}
      {jugadores.status === "error" && <ErrorAlert error={jugadores.error} />}
      {jugadores.status === "ok" &&
        (jugadores.data.total === 0 ? (
          <EmptyState message="No jugadores yet." />
        ) : (
          <>
            <JugadorListView jugadores={jugadores.data.elementos} />
            <Pagination
              total={jugadores.data.total}
              limit={jugadores.data.limite}
              offset={jugadores.data.desplazamiento}
              onOffsetChange={goTo}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/features/jugador/messages.ts ===
/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface JugadorProblem {
  field: string | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "jugador.validacion.equipo_id_no_encontrado": "Equipo does not exist",
  "jugador.validacion.email_vacio": "Email is required",
  "jugador.duplicado": "A jugador with these values already exists",
  "jugador.no_encontrado": "This jugador no longer exists",
  "jugador.repositorio": "The jugador could not be saved, try again later",
  "jugador.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, string> = {
  "jugador.validacion.equipo_id_no_encontrado": "equipoId",
  "jugador.validacion.email_vacio": "email",
};

export function toProblem(code: string): JugadorProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

