import type { ReactNode } from "react";
import { Link } from "wouter";
import { marca } from "../../marca/marca";

/**
 * El marco de las páginas de acceso (iniciar sesión, crear una cuenta): sin el menú de la app, la
 * marca a un lado y el formulario en una tarjeta al otro. En una pantalla estrecha, solo la tarjeta.
 */
export function MarcoAcceso({ children }: { children: ReactNode }) {
  return (
    <div className="grid min-h-screen bg-base-200 lg:grid-cols-2">
      <aside className="hidden flex-col justify-between bg-primary p-12 text-primary-content lg:flex">
        <Link href="/" className="flex items-center gap-3 text-2xl font-bold">
          <img src={marca.logo} alt="" className="size-12" />
          {marca.nombre}
        </Link>
        <p className="max-w-md text-4xl font-semibold leading-tight">{marca.eslogan}</p>
      </aside>
      <main className="flex items-center justify-center p-4">
        <div className="card w-full max-w-sm bg-base-100 shadow-xl">
          <div className="card-body gap-4">
            <Link href="/" className="flex items-center gap-2 text-lg font-bold lg:hidden">
              <img src={marca.logo} alt="" className="size-8" />
              {marca.nombre}
            </Link>
            {children}
          </div>
        </div>
      </main>
    </div>
  );
}

=== web/src/compartido/ui/marco.tsx ===
import { type ReactNode, useState } from "react";
import { Link, useLocation } from "wouter";
import type { Dependencias } from "../../generado/dependencias";
import { marca } from "../../marca/marca";
import { MenuUsuario } from "./menu-usuario";

/** Una sección de la app: una entrada del menú y una tarjeta del panel. */
export interface EntradaMenu {
  etiqueta: string;
  href: string;
  /** Cuántos elementos tiene su lista: lo que enseña el panel. */
  total: (dependencias: Dependencias) => Promise<number>;
}

/**
 * La marca y el menú en un lateral, quien tiene la sesión arriba y el contenido debajo. En una
 * pantalla estrecha el lateral se esconde tras un botón y se cierra al elegir una entrada.
 */
export function Marco({ menu, children }: { menu: EntradaMenu[]; children: ReactNode }) {
  const [ubicacion] = useLocation();
  const [abierto, setAbierto] = useState(false);
  const enlace = (href: string, etiqueta: string) => {
    const actual = ubicacion === href || (href !== "/" && ubicacion.startsWith(`${href}/`));
    return (
      <li key={href}>
        <Link
          href={href}
          className={actual ? "menu-active" : undefined}
          aria-current={actual ? "page" : undefined}
          onClick={() => setAbierto(false)}
        >
          {etiqueta}
        </Link>
      </li>
    );
  };

  return (
    <div className="drawer lg:drawer-open">
      <input
        id="marco-menu"
        type="checkbox"
        className="drawer-toggle"
        checked={abierto}
        onChange={(event) => setAbierto(event.target.checked)}
      />
      <div className="drawer-content flex min-h-screen flex-col bg-base-200">
        <header className="navbar bg-base-100 shadow-sm">
          <label
            htmlFor="marco-menu"
            className="btn btn-square btn-ghost lg:hidden"
            aria-label="Abrir el menú"
          >
            <svg
              viewBox="0 0 24 24"
              className="size-6"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path strokeLinecap="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
          <Link href="/" className="flex items-center gap-2 px-2 text-lg font-bold lg:hidden">
            <img src={marca.logo} alt="" className="size-8" />
            {marca.nombre}
          </Link>
          <div className="ml-auto">
            <MenuUsuario />
          </div>
        </header>
        <main className="mx-auto w-full max-w-6xl flex-1 p-4 lg:p-8">{children}</main>
      </div>
      <div className="drawer-side z-20">
        <label htmlFor="marco-menu" className="drawer-overlay" aria-label="Cerrar el menú" />
        <aside className="flex min-h-full w-64 flex-col border-base-300 border-r bg-base-100">
          <Link href="/" className="flex items-center gap-3 p-5 text-xl font-bold">
            <img src={marca.logo} alt="" className="size-10" />
            {marca.nombre}
          </Link>
          <nav>
            <ul className="menu w-full gap-1">
              {enlace("/", "Panel")}
              {menu.map((entrada) => enlace(entrada.href, entrada.etiqueta))}
            </ul>
          </nav>
        </aside>
      </div>
    </div>
  );
}

