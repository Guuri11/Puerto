import { describe, expect, test } from "bun:test";
import { screen, waitFor } from "@testing-library/react";
import { MadreUsuarioActual, pasarelaAuthFalsa } from "../pruebas/auth";
import { renderizarPantalla } from "../pruebas/renderizar";
import { RequiereAuth, useAuth } from "./auth";

function Secreto() {
  const { puede } = useAuth();
  return <p>{puede("admin") ? "zona de admin" : "zona de socios"}</p>;
}

describe("RequiereAuth", () => {
  test("debería iniciar una sesión que vuelve aquí cuando no hay sesión", async () => {
    // Preparar
    const auth = pasarelaAuthFalsa({ usuario: null });

    // Actuar
    renderizarPantalla(
      <RequiereAuth>
        <Secreto />
      </RequiereAuth>,
      { auth },
      "/pedidos?pagina=2",
    );

    // Comprobar
    await waitFor(() => expect(auth.logins).toEqual(["/pedidos?pagina=2"]));
    expect(screen.queryByText("zona de socios")).toBeNull();
  });

  test("debería mostrar la página a quien tiene la sesión sin volver a iniciarla", async () => {
    // Preparar
    const auth = pasarelaAuthFalsa({ usuario: MadreUsuarioActual.aleatorio() });

    // Actuar
    renderizarPantalla(
      <RequiereAuth>
        <Secreto />
      </RequiereAuth>,
      { auth },
    );

    // Comprobar
    expect(await screen.findByText("zona de socios")).toBeTruthy();
    expect(auth.logins).toEqual([]);
  });
});

describe("useAuth", () => {
  test("debería permitir un rol solo cuando quien tiene la sesión lo tiene", async () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio({ roles: ["admin"] });

    // Actuar
    renderizarPantalla(<Secreto />, {}, "/", { usuario });

    // Comprobar
    expect(await screen.findByText("zona de admin")).toBeTruthy();
  });
});

describe("ProveedorAuth", () => {
  test("debería mostrar el código del error cuando la API no acepta la sesión", async () => {
    // Preparar
    const auth = {
      ...pasarelaAuthFalsa(),
      usuarioActual: () => Promise.reject(new Error("auth.no_autenticado")),
    };

    // Actuar
    renderizarPantalla(<Secreto />, { auth });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("auth.no_autenticado");
  });
});

=== web/src/auth/auth.tsx ===
import {
  createContext,
  type ReactNode,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import { useLocation, useSearch } from "wouter";
import { AlertaError } from "../compartido/ui/alerta-error";
import { useDependencias } from "../dependencias";
import type { UsuarioActual } from "./sesion";

export interface Auth {
  /** Quien tiene la sesión iniciada; `null` si no la tiene nadie. */
  usuario: UsuarioActual | null;
  /** Si tiene `rol`. Las pantallas esconden lo que la API rechazaría; decide la API. */
  puede(rol: string): boolean;
  /** Inicia sesión y después vuelve a la página actual. */
  login(): Promise<void>;
  logout(): Promise<void>;
  /** Vuelve a preguntar a la pasarela quién tiene la sesión: tras un inicio que no salió de la app. */
  refrescar(): Promise<void>;
  /** Termina un inicio de sesión (`/auth/callback`): responde la página a la que volver. */
  completarLogin(): Promise<string>;
}

type Estado =
  | { estado: "cargando" }
  | { estado: "listo"; usuario: UsuarioActual | null }
  | { estado: "error"; error: unknown };

const ContextoAuth = createContext<Auth | null>(null);

/** Pregunta a la pasarela quién tiene la sesión una vez, antes de pintar la app: nada parpadea. */
export function ProveedorAuth({ children }: { children: ReactNode }) {
  const { auth } = useDependencias();
  const [ubicacion] = useLocation();
  const busqueda = useSearch();
  const [estado, setEstado] = useState<Estado>({ estado: "cargando" });

  useEffect(() => {
    auth.usuarioActual().then(
      (usuario) => setEstado({ estado: "listo", usuario }),
      (error: unknown) => setEstado({ estado: "error", error }),
    );
  }, [auth]);

  const aqui = busqueda === "" ? ubicacion : `${ubicacion}?${busqueda}`;
  const login = useCallback(() => auth.login(aqui), [auth, aqui]);
  const refrescar = useCallback(async () => {
    setEstado({ estado: "listo", usuario: await auth.usuarioActual() });
  }, [auth]);
  const completarLogin = useCallback(async () => {
    const vuelta = await auth.completarLogin();
    await refrescar();
    return vuelta;
  }, [auth, refrescar]);
  const logout = useCallback(async () => {
    await auth.logout();
    setEstado({ estado: "listo", usuario: null });
  }, [auth]);
  const usuario = estado.estado === "listo" ? estado.usuario : null;
  const valor = useMemo<Auth>(
    () => ({
      usuario,
      puede: (rol) => usuario?.roles.includes(rol) ?? false,
      login,
      logout,
      refrescar,
      completarLogin,
    }),
    [usuario, login, logout, refrescar, completarLogin],
  );

  if (estado.estado === "cargando") return <span className="loading loading-spinner" />;
  if (estado.estado === "error") return <AlertaError error={estado.error} />;
  return <ContextoAuth value={valor}>{children}</ContextoAuth>;
}

export function useAuth(): Auth {
  const auth = useContext(ContextoAuth);
  if (auth === null) {
    throw new Error("useAuth() llamado fuera de <ProveedorAuth>");
  }
  return auth;
}

/** Pinta `children` a quien tiene la sesión iniciada; a cualquier otro lo manda a iniciarla, y vuelve. */
export function RequiereAuth({ children }: { children: ReactNode }) {
  const { usuario, login } = useAuth();
  const empezado = useRef(false);

  useEffect(() => {
    // Una vez: StrictMode ejecuta los efectos dos veces.
    if (usuario !== null || empezado.current) return;
    empezado.current = true;
    void login();
  }, [usuario, login]);

  return usuario === null ? <span className="loading loading-spinner" /> : children;
}

=== web/src/auth/middleware-bearer.test.ts ===
import { describe, expect, test } from "bun:test";
import createClient from "openapi-fetch";
import { MadreUsuarioActual, pasarelaAuthFalsa } from "../pruebas/auth";
import { middlewareBearer } from "./middleware-bearer";

/** Basta con una ruta: el middleware no mira la ruta. */
interface paths {
  "/me": { get: { responses: { 200: { content: { "application/json": unknown } } } } };
}

/** Un cliente que responde `estado` a todas sus peticiones, firmado por `auth`. */
function respondiendo(estado: number, auth: ReturnType<typeof pasarelaAuthFalsa>) {
  const peticiones: Request[] = [];
  const api = createClient<paths>({
    baseUrl: "http://localhost/api",
    fetch: async (peticion) => {
      peticiones.push(peticion);
      return Response.json({}, { status: estado });
    },
  });
  api.use(middlewareBearer(auth));
  return { api, peticiones };
}

describe("middlewareBearer", () => {
  test("debería mandar el token de quien tiene la sesión iniciada", async () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio();
    const { api, peticiones } = respondiendo(200, pasarelaAuthFalsa({ usuario }));

    // Actuar
    await api.GET("/me");

    // Comprobar
    expect(peticiones[0]?.headers.get("Authorization")).toBe(`Bearer token-de-${usuario.id}`);
  });

  test("no debería mandar ningún token cuando no hay sesión", async () => {
    // Preparar
    const { api, peticiones } = respondiendo(200, pasarelaAuthFalsa());

    // Actuar
    await api.GET("/me");

    // Comprobar
    expect(peticiones[0]?.headers.has("Authorization")).toBe(false);
  });

  test("debería volver a iniciar sesión cuando la API responde 401", async () => {
    // Preparar
    const auth = pasarelaAuthFalsa({ usuario: MadreUsuarioActual.aleatorio() });
    const { api } = respondiendo(401, auth);

    // Actuar
    await api.GET("/me");

    // Comprobar
    expect(auth.logins).toHaveLength(1);
  });
});

=== web/src/auth/middleware-bearer.ts ===
import type { Middleware } from "openapi-fetch";
import type { PasarelaAuth } from "./sesion";

/**
 * Firma cada llamada a la API con el token de quien tiene la sesión; un `401` quiere decir que la
 * sesión ya no vale, así que vuelve a iniciarla y regresa a la página en la que estaba.
 */
export function middlewareBearer(auth: PasarelaAuth): Middleware {
  return {
    async onRequest({ request }) {
      const token = await auth.tokenAcceso();
      if (token !== null) request.headers.set("Authorization", `Bearer ${token}`);
      return request;
    },
    async onResponse({ response }) {
      if (response.status === 401) {
        void auth.login(window.location.pathname + window.location.search);
      }
      return response;
    },
  };
}

=== web/src/auth/pasarela-oidc.test.ts ===
import { describe, expect, test } from "bun:test";
import type { User } from "oidc-client-ts";
import { ajustesOidcDeEntorno, type ClienteOidc, pasarelaOidcSobre } from "./pasarela-oidc";
import { ErrorAuth } from "./sesion";

/** Un cliente con `usuario` en sesión (`null`: nadie); `redirecciones` guarda cada redirección. */
function cliente(usuario: Partial<User> | null) {
  const redirecciones: unknown[] = [];
  const falso: ClienteOidc = {
    getUser: async () => usuario as User | null,
    signinRedirect: async (args) => {
      redirecciones.push(args);
    },
    signinRedirectCallback: async () => ({ state: "/pedidos" }) as User,
    signoutRedirect: async () => {},
  };
  return { falso, redirecciones };
}

/** Un `/me` que responde `estado` y `cuerpo`; `peticiones` guarda lo que se le pidió. */
function me(estado: number, cuerpo: unknown) {
  const peticiones: { url: string; init: RequestInit }[] = [];
  const pedirMe = async (url: string, init: RequestInit) => {
    peticiones.push({ url, init });
    return Response.json(cuerpo, { status: estado });
  };
  return { pedirMe, peticiones };
}

describe("pasarelaOidc", () => {
  test("debería preguntar a la API de quién es el token cuando hay sesión", async () => {
    // Preparar
    const { falso } = cliente({ access_token: "abc", expired: false });
    const id = crypto.randomUUID();
    const { pedirMe, peticiones } = me(200, { id, email: "ana@example.com", roles: ["admin"] });

    // Actuar
    const usuario = await pasarelaOidcSobre(falso, pedirMe).usuarioActual();

    // Comprobar
    expect(peticiones[0]?.url).toBe("/api/me");
    expect(peticiones[0]?.init.headers).toEqual({ Authorization: "Bearer abc" });
    expect(usuario).toEqual({ id, email: "ana@example.com", nombre: null, roles: ["admin"] });
  });

  test("no debería haber usuario ni token cuando la sesión caducó", async () => {
    // Preparar
    const { falso } = cliente({ access_token: "abc", expired: true });
    const { pedirMe, peticiones } = me(200, {});
    const pasarela = pasarelaOidcSobre(falso, pedirMe);

    // Actuar
    const usuario = await pasarela.usuarioActual();

    // Comprobar
    expect(usuario).toBeNull();
    expect(await pasarela.tokenAcceso()).toBeNull();
    expect(peticiones).toHaveLength(0);
  });

  test("debería fallar con el código de la API cuando rechaza el token", async () => {
    // Preparar
    const { falso } = cliente({ access_token: "abc", expired: false });
    const codigo = "auth.no_autenticado";
    const { pedirMe } = me(401, { codigo, mensaje: codigo });

    // Actuar
    const resultado = pasarelaOidcSobre(falso, pedirMe).usuarioActual();

    // Comprobar
    await expect(resultado).rejects.toBeInstanceOf(ErrorAuth);
    await expect(resultado).rejects.toMatchObject({ codigo });
  });

  test("debería volver a la página en la que empezó el inicio de sesión", async () => {
    // Preparar
    const { falso, redirecciones } = cliente(null);
    const pasarela = pasarelaOidcSobre(falso, me(200, {}).pedirMe);

    // Actuar
    await pasarela.login("/pedidos");
    const vuelta = await pasarela.completarLogin();

    // Comprobar
    expect(redirecciones).toEqual([{ state: "/pedidos" }]);
    expect(vuelta).toBe("/pedidos");
  });
});

describe("ajustesOidcDeEntorno", () => {
  test("debería nombrar la variable que falta cuando web/.env no tiene emisor", () => {
    // Actuar
    const leer = () => ajustesOidcDeEntorno({ VITE_AUTH_CLIENT_ID: "web" });

    // Comprobar
    expect(leer).toThrow("VITE_AUTH_ISSUER no está definida");
  });

  test("debería dejar vacía la audiencia cuando no está definida", () => {
    // Actuar
    const ajustes = ajustesOidcDeEntorno({
      VITE_AUTH_ISSUER: "http://localhost:8180/realms/tienda",
      VITE_AUTH_CLIENT_ID: "web",
    });

    // Comprobar
    expect(ajustes.audiencia).toBe("");
  });
});

=== web/src/auth/pasarela-oidc.ts ===
import { InMemoryWebStorage, UserManager, WebStorageStateStore } from "oidc-client-ts";
import { ErrorAuth, type PasarelaAuth, type UsuarioActual } from "./sesion";

/** Dónde está el proveedor y quién es esta app para él: `web/.env`. */
export interface AjustesOidc {
  /** `VITE_AUTH_ISSUER`: la URL del realm de Keycloak, `https://<tenant>.auth0.com/`. */
  emisor: string;
  /** `VITE_AUTH_CLIENT_ID`: un cliente público, Authorization Code + PKCE. */
  idCliente: string;
  /** `VITE_AUTH_AUDIENCE`: el identificador de la API en Auth0. Vacío en Keycloak, que lo añade un mapper. */
  audiencia: string;
}

/** Los ajustes de `web/.env`; si falta uno, es un error al arrancar, no una redirección a ninguna parte. */
export function ajustesOidcDeEntorno(
  entorno: Record<string, unknown> = import.meta.env,
): AjustesOidc {
  const leer = (nombre: string, obligatorio: boolean) => {
    const valor = entorno[nombre];
    if (typeof valor === "string" && valor !== "") return valor;
    if (obligatorio)
      throw new Error(`${nombre} no está definida: copia web/.env.example a web/.env`);
    return "";
  };
  return {
    emisor: leer("VITE_AUTH_ISSUER", true),
    idCliente: leer("VITE_AUTH_CLIENT_ID", true),
    audiencia: leer("VITE_AUTH_AUDIENCE", false),
  };
}

/** Lo que necesita la pasarela del `UserManager` de `oidc-client-ts`. */
export type ClienteOidc = Pick<
  UserManager,
  "getUser" | "signinRedirect" | "signinRedirectCallback" | "signoutRedirect"
>;

/** `PasarelaAuth` sobre un proveedor OpenID Connect (Keycloak, Auth0): Authorization Code + PKCE. */
export function pasarelaOidc(ajustes: AjustesOidc): PasarelaAuth {
  const origen = window.location.origin;
  const cliente = new UserManager({
    authority: ajustes.emisor,
    client_id: ajustes.idCliente,
    redirect_uri: `${origen}/auth/callback`,
    post_logout_redirect_uri: origen,
    scope: "openid profile email",
    // En memoria, nunca en un almacenamiento que pueda leer un script: al recargar se vuelve a
    // iniciar sesión con la sesión del propio proveedor (ADR-0021 § 5).
    userStore: new WebStorageStateStore({ store: new InMemoryWebStorage() }),
    extraQueryParams: ajustes.audiencia === "" ? {} : { audience: ajustes.audiencia },
  });
  return pasarelaOidcSobre(cliente, (url, init) => fetch(url, init));
}

interface CuerpoMe {
  id: string;
  email?: string | null;
  nombre?: string | null;
  roles: string[];
}

/** Cómo pide la pasarela `/me` a la API. */
export type PedirMe = (url: string, init: RequestInit) => Promise<Response>;

/** El `RespuestaError.codigo` de un `/me` que falló, o `http.<estado>` si la respuesta no es uno. */
async function codigoDeError(respuesta: Response): Promise<string> {
  const cuerpo: unknown = await respuesta.json().catch(() => null);
  if (typeof cuerpo === "object" && cuerpo !== null && "codigo" in cuerpo) {
    const { codigo } = cuerpo;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${respuesta.status}`;
}

/** La pasarela sobre cualquier cliente y `fetch`: lo que usan los tests. */
export function pasarelaOidcSobre(cliente: ClienteOidc, pedirMe: PedirMe): PasarelaAuth {
  const tokenAcceso = async () => {
    const usuario = await cliente.getUser();
    return usuario === null || usuario.expired === true ? null : usuario.access_token;
  };
  return {
    tokenAcceso,
    async usuarioActual(): Promise<UsuarioActual | null> {
      const token = await tokenAcceso();
      if (token === null) return null;
      // Lo que la API sabe de quien llama: su id de usuario y los roles que comprueba.
      const respuesta = await pedirMe("/api/me", { headers: { Authorization: `Bearer ${token}` } });
      if (!respuesta.ok) throw new ErrorAuth(await codigoDeError(respuesta));
      const me = (await respuesta.json()) as CuerpoMe;
      return { id: me.id, email: me.email ?? null, nombre: me.nombre ?? null, roles: me.roles };
    },
    login: (volverA) => cliente.signinRedirect({ state: volverA }),
    async completarLogin() {
      const usuario = await cliente.signinRedirectCallback();
      return typeof usuario.state === "string" ? usuario.state : "/";
    },
    logout: () => cliente.signoutRedirect(),
  };
}

=== web/src/auth/sesion.ts ===
/** Quien tiene la sesión iniciada, tal como lo resolvió la API (`GET /me`): nunca los claims del proveedor. */
export interface UsuarioActual {
  id: string;
  email: string | null;
  nombre: string | null;
  /** Lo que la API comprueba con `#[requiere_rol]`. */
  roles: string[];
}

/**
 * Quién tiene la sesión iniciada, y cómo iniciarla y cerrarla. La pasarela habla con el proveedor
 * (OIDC) o con la API (local); las pantallas llegan a ella con `useAuth()`.
 */
export interface PasarelaAuth {
  /** Quien tiene la sesión iniciada, o `null` si no la tiene nadie. */
  usuarioActual(): Promise<UsuarioActual | null>;
  /** El token bearer para la API, o `null` si no hay sesión. */
  tokenAcceso(): Promise<string | null>;
  /** Inicia sesión y después vuelve a `volverA` (una ruta de esta app). */
  login(volverA: string): Promise<void>;
  /** Termina un inicio de sesión en `/auth/callback`; responde la ruta que se le dio a `login`. */
  completarLogin(): Promise<string>;
  logout(): Promise<void>;
}

/** Un inicio de sesión que rechazó el proveedor o la API, o un `GET /me` que falló. */
export class ErrorAuth extends Error {
  readonly codigo: string;

  constructor(codigo: string) {
    super(codigo);
    this.name = "ErrorAuth";
    this.codigo = codigo;
  }
}

