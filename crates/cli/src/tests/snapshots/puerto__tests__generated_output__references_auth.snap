=== web/src/features/jugador/views/jugador-form-view.tsx ===
import type { Schemas } from "../../../api/client";
import type { ReferenceOption } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";
import type { JugadorProblem } from "../messages";

type Jugador = Schemas["DtoJugador"];
type JugadorRequest = Schemas["PeticionCrearJugador"];

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface JugadorFormValues {
  equipoId: string;
  dorsal: string;
  email: string;
}

/** The inputs for `jugador`, empty when there is none yet. */
export function toJugadorForm(jugador: Jugador | null): JugadorFormValues {
  if (jugador === null) {
    return {
      equipoId: "",
      dorsal: "",
      email: "",
    };
  }
  return {
    equipoId: jugador.equipoId,
    dorsal: String(jugador.dorsal),
    email: jugador.email ?? "",
  };
}

/** What each reference's select offers. */
export interface JugadorFormOptions {
  equipoId: ReferenceOption[];
}

/** What a create or an update sends: the same fields for both. */
export function toJugadorRequest(values: JugadorFormValues): JugadorRequest {
  return {
    equipoId: values.equipoId,
    dorsal: Number(values.dorsal),
    email: values.email,
  };
}

export function JugadorFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: JugadorFormValues;
  options: JugadorFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: JugadorProblem | null;
  onChange: (values: JugadorFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Equipo</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "equipoId"}
          required
          value={values.equipoId}
          onChange={(event) => onChange({ ...values, equipoId: event.target.value })}
        >
          <option value="">Choose an equipo</option>
          {options.equipoId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="equipoId" />
      <label className="fieldset">
        <span className="fieldset-legend">Dorsal</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "dorsal"}
          required
          value={values.dorsal}
          onChange={(event) => onChange({ ...values, dorsal: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="dorsal" />
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "email"}
          required
          value={values.email}
          onChange={(event) => onChange({ ...values, email: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="email" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

