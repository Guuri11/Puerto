pub mod repositorio;

=== contextos/jugador/infraestructura/src/repositorio.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use dominio_jugador::{
    modelo::{IdJugador, Jugador},
    repositorio::{FiltroJugador, RepositorioJugador},
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

/// Guarda jugadores en la memoria del proceso: se pierden cuando el proceso se para.
/// Como el adaptador de Postgres, oculta las filas borradas y lista en el orden de `puerto.toml`
/// (`dorsal DESC, creado_en DESC, id`; los textos, por bytes y no con la collation de Postgres);
/// un valor único que ya tiene otra fila viva es `Duplicado`.
/// Cubre el hueco hasta que haya base de datos (`puerto nuevo --db` genera repositorios Postgres).
#[derive(Default)]
pub struct RepositorioJugadorEnMemoria {
    filas: RwLock<HashMap<IdJugador, Jugador>>,
}

impl RepositorioJugadorEnMemoria {
    pub fn new() -> Self {
        Self::default()
    }

    // Un cerrojo envenenado significa que un escritor hizo panic; cada escritura es un solo
    // insert, así que el mapa sigue entero y se usa tal cual.
    fn leer(&self) -> RwLockReadGuard<'_, HashMap<IdJugador, Jugador>> {
        self.filas.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn escribir(&self) -> RwLockWriteGuard<'_, HashMap<IdJugador, Jugador>> {
        self.filas.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl RepositorioJugador for RepositorioJugadorEnMemoria {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroJugador,
    ) -> Result<Pagina<Jugador>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        let filas = self.leer();
        let mut vivos: Vec<&Jugador> = filas
            .values()
            .filter(|fila| !fila.borrado)
            .filter(|fila| filtro.equipo_id.is_none_or(|id| fila.equipo_id == id))
            .collect();
        vivos.sort_by(|a, b| {
            a.dorsal
                .cmp(&b.dorsal)
                .reverse()
                .then_with(|| b.creado_en.cmp(&a.creado_en))
                .then_with(|| a.id.valor().cmp(&b.id.valor()))
        });
        let total = vivos.len() as u64;
        let elementos = vivos
            .into_iter()
            .skip(pagina.desplazamiento() as usize)
            .take(pagina.limite() as usize)
            .cloned()
            .collect();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdJugador) -> Result<Option<Jugador>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        Ok(self.leer().get(&id).filter(|fila| !fila.borrado).cloned())
    }

    async fn guardar(&self, entidad: &Jugador) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let mut filas = self.escribir();
        // Como los índices únicos parciales: solo las filas vivas ocupan sus valores.
        let ocupado = !entidad.borrado
            && filas.values().any(|fila| {
                fila.id != entidad.id
                    && !fila.borrado
                    && (fila.equipo_id == entidad.equipo_id && fila.dorsal == entidad.dorsal)
            });
        if ocupado {
            tracing::warn!(id = %entidad.id, "guardar rechazado: un valor único ya está ocupado");
            return Err(ErrorRepositorio::Duplicado);
        }
        filas.insert(entidad.id, entidad.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_equipo::modelo::IdEquipo;
    use dominio_jugador::modelo::PropsJugador;
    use dominio_jugador::pruebas::madres::MadreJugador;
    use uuid::Uuid;

    /// Una entidad válida, con los valores de la madre salvo en los campos únicos (uno
    /// nuevo cada vez) y las fechas (un segundo exacto).
    fn nuevo_jugador() -> Jugador {
        Jugador::new(PropsJugador {
            equipo_id: IdEquipo::generar(),
            dorsal: (Uuid::new_v4().as_u128() >> 65) as i64,
            ..MadreJugador::new().construir_props()
        })
        .unwrap()
    }

    #[tokio::test]
    async fn deberia_encontrar_jugador_por_id_tras_guardar() {
        // Preparar
        let repositorio = RepositorioJugadorEnMemoria::new();
        let entidad = nuevo_jugador();
        repositorio.guardar(&entidad).await.unwrap();

        // Actuar
        let encontrado = repositorio.buscar_por_id(entidad.id).await.unwrap();

        // Comprobar
        assert_eq!(encontrado.map(|fila| fila.id), Some(entidad.id));
    }

    #[tokio::test]
    async fn deberia_actualizar_la_fila_cuando_se_guarda_de_nuevo() {
        // Preparar
        let repositorio = RepositorioJugadorEnMemoria::new();
        let mut entidad = nuevo_jugador();
        repositorio.guardar(&entidad).await.unwrap();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        repositorio.guardar(&entidad).await.unwrap();

        // Comprobar
        let pagina = repositorio
            .buscar_todos(PeticionPagina::default(), FiltroJugador::default())
            .await
            .unwrap();
        assert_eq!(pagina.total, 1);
        assert_eq!(pagina.elementos[0].actualizado_en, entidad.actualizado_en);
    }

    #[tokio::test]
    async fn no_deberia_encontrar_jugador_tras_su_borrado() {
        // Preparar
        let repositorio = RepositorioJugadorEnMemoria::new();
        let mut entidad = nuevo_jugador();
        entidad.borrado = true;
        entidad.borrado_en = Some(entidad.actualizado_en);
        repositorio.guardar(&entidad).await.unwrap();

        // Actuar
        let encontrado = repositorio.buscar_por_id(entidad.id).await.unwrap();
        let pagina = repositorio
            .buscar_todos(PeticionPagina::default(), FiltroJugador::default())
            .await
            .unwrap();

        // Comprobar
        assert!(encontrado.is_none());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor() {
        // Preparar
        let repositorio = RepositorioJugadorEnMemoria::new();
        for _ in 0..3 {
            repositorio.guardar(&nuevo_jugador()).await.unwrap();
        }

        // Actuar
        let pagina = repositorio
            .buscar_todos(
                PeticionPagina::new(Some(2), Some(2)),
                FiltroJugador::default(),
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[tokio::test]
    async fn deberia_rechazar_un_duplicado_de_equipo_id_y_dorsal() {
        // Preparar
        let repositorio = RepositorioJugadorEnMemoria::new();
        let primero = nuevo_jugador();
        repositorio.guardar(&primero).await.unwrap();
        let mut segundo = nuevo_jugador();
        segundo.equipo_id = primero.equipo_id;
        segundo.dorsal = primero.dorsal;

        // Actuar
        let resultado = repositorio.guardar(&segundo).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::Duplicado);
    }

    #[tokio::test]
    async fn deberia_aceptar_equipo_id_y_dorsal_cuando_solo_coincide_equipo_id() {
        // Preparar
        let repositorio = RepositorioJugadorEnMemoria::new();
        let primero = nuevo_jugador();
        repositorio.guardar(&primero).await.unwrap();
        let mut segundo = nuevo_jugador();
        segundo.equipo_id = primero.equipo_id;

        // Actuar
        let resultado = repositorio.guardar(&segundo).await;

        // Comprobar
        assert!(resultado.is_ok());
    }

    #[tokio::test]
    async fn deberia_listar_solo_jugadores_con_ese_valor_de_equipo_id() {
        // Preparar: una entidad jugador con este valor de equipo_id y otra sin él.
        let repositorio = RepositorioJugadorEnMemoria::new();
        let equipo_id = IdEquipo::generar();
        let mut esperado = nuevo_jugador();
        esperado.equipo_id = equipo_id;
        repositorio.guardar(&esperado).await.unwrap();
        repositorio.guardar(&nuevo_jugador()).await.unwrap();

        // Actuar
        let pagina = repositorio
            .buscar_todos(
                PeticionPagina::default(),
                FiltroJugador {
                    equipo_id: Some(equipo_id),
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }
}

