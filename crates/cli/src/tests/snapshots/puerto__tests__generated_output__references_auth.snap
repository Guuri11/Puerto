import { JugadorDetailContainer } from "../features/jugador/containers/jugador-detail-container";
import { JugadorFormContainer } from "../features/jugador/containers/jugador-form-container";
import { JugadorListContainer } from "../features/jugador/containers/jugador-list-container";
import { AuthCallbackPage } from "../pages/auth-callback";
import { HomePage } from "../pages/home";
import { NotFoundPage } from "../pages/not-found";
import { customRoutes } from "../routes";
import type { NavEntry } from "../shared/ui/layout";

export const navEntries: NavEntry[] = [
  { label: "Equipos", href: "/equipos" },
  { label: "Jugadores", href: "/jugadores" },
];

export function AppRoutes() {
