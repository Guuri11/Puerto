=== contextos/equipo/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorEquipo {
    #[error("equipo.validacion.{0}")]
    Validacion(String),
    #[error("equipo.no_encontrado")]
    NoEncontrado,
    #[error("equipo.duplicado")]
    Duplicado,
    #[error("equipo.repositorio")]
    Repositorio,
    #[error("equipo.desconocido")]
    Desconocido,
    /// Quien llama no puede hacer esto con estos datos: regla del caso de uso, sobre su `actor`.
    #[error("equipo.prohibido")]
    Prohibido,
}

impl From<ErrorRepositorio> for ErrorEquipo {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorEquipo::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "equipo.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorEquipo::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "equipo.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorEquipo::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "equipo.repositorio");
    }
}

