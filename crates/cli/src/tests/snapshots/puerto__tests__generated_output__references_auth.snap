import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Schemas } from "../../../api/client";
import { EquipoMother, equipoCollection } from "../../../test-support/equipo";
import { fakeApi } from "../../../test-support/fake-api";
import { renderScreen } from "../../../test-support/render";
import { EquipoFormContainer } from "./equipo-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `request`, the way a user would. */
async function fillIn(request: Schemas["PeticionCrearEquipo"]) {
  await screen.findByText("Save");
  type("Nombre", request.nombre);
}

describe("EquipoFormContainer", () => {
  test("should create the equipo from what was typed and show it", async () => {
    // Arrange
    const request = EquipoMother.request();
    const stored = equipoCollection();
    const api = fakeApi([stored]);
    const { history } = renderScreen(<EquipoFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/equipos/"));
    const [created] = stored.items.values();
    expect(created).toMatchObject(request);
    expect(history.at(-1)).toBe(`/equipos/${created?.id}`);
  });

  test("should save the edited equipo when an existing one is submitted", async () => {
    // Arrange
    const seeded = EquipoMother.random();
    const stored = equipoCollection([seeded]);
    const api = fakeApi([stored]);
    const { history } = renderScreen(<EquipoFormContainer id={seeded.id} />, { api });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/equipos/${seeded.id}`));
    expect(stored.items.get(seeded.id)).toEqual(seeded);
  });
  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const request = EquipoMother.request();
    const code = "equipo.validacion.invalid";
    const failures = { "POST /equipos": code };
    const api = fakeApi([equipoCollection()], failures);
    renderScreen(<EquipoFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a equipo with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const request = EquipoMother.request();
    const failures = { "POST /equipos": "equipo.duplicado" };
    const api = fakeApi([equipoCollection()], failures);
    renderScreen(<EquipoFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An equipo with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const request = EquipoMother.request();
    const failures = { "POST /equipos": "equipo.validacion.nombre_vacio" };
    const api = fakeApi([equipoCollection()], failures);
    renderScreen(<EquipoFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Nombre is required")).toBeTruthy();
    const input = screen.getByLabelText("Nombre");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/features/equipo/containers/equipo-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Schemas } from "../../../api/client";
import { unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { toProblem } from "../messages";
import { EquipoFormView, toEquipoForm, toEquipoRequest } from "../views/equipo-form-view";

type Equipo = Schemas["DtoEquipo"];

/** Creates an equipo, or edits the one with `id`. */
export function EquipoFormContainer({ id }: { id?: string }) {
  const { api } = useDependencies();
  const existing = useAsync(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : unwrap(api.GET("/equipos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const title = id === undefined ? "New equipo" : "Edit equipo";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <EquipoForm existing={existing.data} />}
      <Link href={id === undefined ? "/equipos" : `/equipos/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function EquipoForm({ existing }: { existing: Equipo | null }) {
  const { api } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toEquipoForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const body = toEquipoRequest(values);
      const saved = await unwrap(
        existing === null
          ? api.POST("/equipos", { body })
          : api.PUT("/equipos/{id}", { params: { path: { id: existing.id } }, body }),
      );
      navigate(`/equipos/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <EquipoFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

