import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE, unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { useAsync } from "../../../shared/use-async";
import { EquipoListView } from "../views/equipo-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function EquipoListContainer() {
  const { api } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const query = { limite: PAGE_SIZE, desplazamiento: offset };
  const equipos = useAsync(() => unwrap(api.GET("/equipos", { params: { query } })), [api, offset]);

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Equipos</h1>
        <Link href="/equipos/new" className="btn btn-primary">
          New equipo
        </Link>
      </div>
      {equipos.status === "loading" && <span className="loading loading-spinner" />}
      {equipos.status === "error" && <ErrorAlert error={equipos.error} />}
      {equipos.status === "ok" &&
        (equipos.data.total === 0 ? (
          <EmptyState message="No equipos yet." />
        ) : (
          <>
            <EquipoListView equipos={equipos.data.elementos} />
            <Pagination
              total={equipos.data.total}
              limit={equipos.data.limite}
              offset={equipos.data.desplazamiento}
              onOffsetChange={goTo}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/features/equipo/messages.ts ===
/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface EquipoProblem {
  field: string | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "equipo.validacion.nombre_vacio": "Nombre is required",
  "equipo.duplicado": "An equipo with these values already exists",
  "equipo.no_encontrado": "This equipo no longer exists",
  "equipo.repositorio": "The equipo could not be saved, try again later",
  "equipo.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, string> = {
  "equipo.validacion.nombre_vacio": "nombre",
};

export function toProblem(code: string): EquipoProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

