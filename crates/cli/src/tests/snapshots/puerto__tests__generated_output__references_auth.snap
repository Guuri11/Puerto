=== contextos/equipo/dominio/src/modelo.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorEquipo;

/// El id de cada `Equipo`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdEquipo(Uuid);

impl IdEquipo {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdEquipo {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsEquipo {
    pub nombre: String,
}

#[derive(Debug, Clone)]
pub struct Equipo {
    pub id: IdEquipo,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub nombre: String,
}

impl Equipo {
    pub fn new(props: PropsEquipo) -> Result<Self, ErrorEquipo> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdEquipo::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            nombre: props.nombre,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsEquipo) -> Result<(), ErrorEquipo> {
        Self::validar(&props)?;
        self.nombre = props.nombre;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Equipo) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsEquipo) -> Result<(), ErrorEquipo> {
        if props.nombre.trim().is_empty() {
            return Err(ErrorEquipo::Validacion("nombre_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreEquipo;

    #[test]
    fn deberia_crear_equipo_cuando_el_nombre_es_valido() {
        let resultado = Equipo::new(MadreEquipo::new().construir_props());
        assert_eq!(
            resultado.unwrap().nombre,
            MadreEquipo::new().construir_props().nombre
        );
    }

    #[test]
    fn deberia_rechazar_equipo_cuando_nombre_es_una_cadena_vacia() {
        let resultado = Equipo::new(MadreEquipo::new().con_nombre_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "equipo.validacion.nombre_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_equipo_cuando_nombre_solo_tiene_espacios() {
        let resultado = Equipo::new(MadreEquipo::new().con_nombre("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_equipo_cuando_nombre_es_una_cadena_vacia() {
        let mut entidad = MadreEquipo::aleatorio();
        let resultado = entidad.actualizar(MadreEquipo::new().con_nombre_vacio().construir_props());
