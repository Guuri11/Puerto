import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { EquipoMother, equipoCollection } from "../../../test-support/equipo";
import { fakeApi } from "../../../test-support/fake-api";
import { renderScreen } from "../../../test-support/render";
import { EquipoDetailContainer } from "./equipo-detail-container";

describe("EquipoDetailContainer", () => {
  test("should show the equipo when it exists", async () => {
    // Arrange
    const seeded = EquipoMother.random();
    const api = fakeApi([equipoCollection([seeded])]);

    // Act
    renderScreen(<EquipoDetailContainer id={seeded.id} />, { api });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the equipo does not exist", async () => {
    // Arrange
    const api = fakeApi([equipoCollection()]);

    // Act
    renderScreen(<EquipoDetailContainer id={crypto.randomUUID()} />, { api });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("equipo.no_encontrado");
  });

  test("should delete the equipo only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = EquipoMother.random();
    const stored = equipoCollection([seeded]);
    const api = fakeApi([stored]);
    const { history } = renderScreen(<EquipoDetailContainer id={seeded.id} />, { api });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(stored.items.has(seeded.id)).toBe(true);

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/equipos"));
    expect(stored.items.has(seeded.id)).toBe(false);
  });

  test("should show auth.prohibido when the API refuses the deletion", async () => {
    // Arrange
    const seeded = EquipoMother.random();
    const failures = { "DELETE /equipos": "auth.prohibido" };
    const api = fakeApi([equipoCollection([seeded])], failures);
    renderScreen(<EquipoDetailContainer id={seeded.id} />, { api });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
});

=== web/src/features/equipo/containers/equipo-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { EquipoDetailView } from "../views/equipo-detail-view";

export function EquipoDetailContainer({ id }: { id: string }) {
  const { api } = useDependencies();
  const equipo = useAsync(
    () => unwrap(api.GET("/equipos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await unwrap(api.DELETE("/equipos/{id}", { params: { path: { id } } }));
      navigate("/equipos");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Equipo</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {equipo.status === "loading" && <span className="loading loading-spinner" />}
      {equipo.status === "error" && <ErrorAlert error={equipo.error} />}
      {equipo.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <EquipoDetailView equipo={equipo.data} />
            <div className="card-actions justify-end">
              <Link href={`/equipos/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/equipos" className="link">
        Back to equipos
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this equipo?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

