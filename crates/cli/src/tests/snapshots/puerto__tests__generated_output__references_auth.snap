import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { MadreUsuarioActual, pasarelaAuthFalsa } from "../pruebas/auth";
import { renderizarPantalla } from "../pruebas/renderizar";
import { PaginaPerfil } from "./perfil";

describe("PaginaPerfil", () => {
  test("debería mostrar el nombre, el email y los roles de quien tiene la sesión", async () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio({
      nombre: "Ana Lozano",
      email: "ana@example.com",
      roles: ["admin"],
    });

    // Actuar
    renderizarPantalla(<PaginaPerfil />, {}, "/perfil", { usuario });

    // Comprobar
    expect(await screen.findByText("Ana Lozano")).toBeTruthy();
    expect(screen.getByText("ana@example.com")).toBeTruthy();
    expect(screen.getByText("admin")).toBeTruthy();
  });

  test("debería decirlo cuando quien tiene la sesión no tiene roles", async () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio({ roles: [] });

    // Actuar
    renderizarPantalla(<PaginaPerfil />, {}, "/perfil", { usuario });

    // Comprobar
    expect(await screen.findByText("Sin roles")).toBeTruthy();
  });

  test("debería cerrar la sesión cuando se pulsa Cerrar sesión", async () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio();
    let cerrada = false;
    const auth = {
      ...pasarelaAuthFalsa({ usuario }),
      logout: async () => {
        cerrada = true;
      },
    };
    renderizarPantalla(<PaginaPerfil />, { auth }, "/perfil");

    // Actuar
    fireEvent.click(await screen.findByText("Cerrar sesión"));

    // Comprobar
    await waitFor(() => expect(cerrada).toBe(true));
  });
});

=== web/src/paginas/perfil.tsx ===
import { useAuth } from "../auth/auth";
import { Avatar } from "../compartido/ui/avatar";

/** Quién tiene la sesión iniciada, tal como lo responde la API (`GET /me`), y el botón para cerrarla. */
export function PaginaPerfil() {
  const { usuario, logout } = useAuth();
  // `RequiereAuth` la protege: sin sesión, nunca llega a pintarse.
  if (usuario === null) return null;
  return (
    <section className="mx-auto max-w-xl space-y-6">
      <h1 className="text-3xl font-bold">Perfil</h1>
      <div className="card bg-base-100 shadow-sm">
        <div className="card-body gap-6">
          <div className="flex items-center gap-4">
            <Avatar usuario={usuario} className="w-16 text-xl" />
            <div>
              <p className="text-xl font-semibold">{usuario.nombre ?? "Sin nombre"}</p>
              <p className="text-base-content/70">{usuario.email ?? "Sin email"}</p>
            </div>
          </div>
          <div className="space-y-2">
            <h2 className="font-semibold">Roles</h2>
            {usuario.roles.length === 0 ? (
              <p className="text-base-content/70">Sin roles</p>
            ) : (
              <ul className="flex flex-wrap gap-2">
                {usuario.roles.map((rol) => (
                  <li key={rol} className="badge badge-outline">
                    {rol}
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div className="card-actions justify-end">
            <button type="button" className="btn" onClick={() => void logout()}>
              Cerrar sesión
            </button>
          </div>
        </div>
      </div>
    </section>
  );
}

=== web/src/pruebas/api-falsa.ts ===
import { type ClienteApi, crearClienteApi } from "../api/cliente";

/** Lo que guarda la API falsa bajo `ruta`: los DTO de la API, por id. */
export interface Coleccion<T extends { id: string }> {
  ruta: string;
  /** El código que responde un elemento que no está: `producto.no_encontrado`. */
  noEncontrado: string;
  elementos: Map<string, T>;
}

/** Los elementos bajo `ruta` (`/productos`) de `entidad` (`producto`), empezando por `semilla`. */
export function coleccion<T extends { id: string }>(
  ruta: string,
  entidad: string,
  semilla: T[] = [],
): Coleccion<T> {
  const elementos = new Map(semilla.map((elemento) => [elemento.id, elemento]));
  return { ruta, noEncontrado: `${entidad}.no_encontrado`, elementos };
}

/**
 * Un `ClienteApi` que responde como la API generada, sobre colecciones en memoria: una página por
 * `limite` / `desplazamiento`, un `404` con `<entidad>.no_encontrado`, `201`, `200` y `204`. Cada
 * uno de `fallos` (`{ "POST /productos": "producto.duplicado" }`) responde su código en su lugar.
 */
export function apiFalsa(
  colecciones: Coleccion<{ id: string }>[],
  fallos: Record<string, string> = {},
): ClienteApi {
  return crearClienteApi({
    baseUrl: "http://localhost/api",
    fetch: async (peticion) => {
      const url = new URL(peticion.url);
      const ruta = url.pathname.replace(/^\/api/, "");
      const objetivo = colecciones.find((c) => ruta === c.ruta || ruta.startsWith(`${c.ruta}/`));
      if (objetivo === undefined) return responderError(404, "http.404");
      const fallo = fallos[`${peticion.method} ${objetivo.ruta}`];
      if (fallo !== undefined) return responderError(400, fallo);
      const id = ruta.slice(objetivo.ruta.length + 1);
      return id === ""
        ? servirLista(objetivo, peticion, url)
        : servirElemento(objetivo, peticion, id);
    },
  });
}

async function servirLista(objetivo: Coleccion<{ id: string }>, peticion: Request, url: URL) {
  if (peticion.method === "POST") {
    const creado = { ...(await peticion.json()), id: crypto.randomUUID() };
    objetivo.elementos.set(creado.id, creado);
    return Response.json(creado, { status: 201 });
  }
  const limite = Number(url.searchParams.get("limite") ?? 20);
  const desplazamiento = Number(url.searchParams.get("desplazamiento") ?? 0);
  const todos = [...objetivo.elementos.values()];
  const elementos = todos.slice(desplazamiento, desplazamiento + limite);
  return Response.json({ elementos, total: todos.length, limite, desplazamiento });
}

async function servirElemento(objetivo: Coleccion<{ id: string }>, peticion: Request, id: string) {
  const encontrado = objetivo.elementos.get(id);
  if (encontrado === undefined) return responderError(404, objetivo.noEncontrado);
  if (peticion.method === "DELETE") {
    objetivo.elementos.delete(id);
    return new Response(null, { status: 204 });
  }
  if (peticion.method === "PUT") {
    // Como la API, actualizar reemplaza todos los campos: el que no se manda queda vacío.
    const actualizado = { ...(await peticion.json()), id };
    objetivo.elementos.set(id, actualizado);
    return Response.json(actualizado);
  }
  return Response.json(encontrado);
}

/** Un `RespuestaError` como lo responde la API. */
function responderError(estado: number, codigo: string) {
  return Response.json({ codigo, mensaje: codigo }, { status: estado });
}

=== web/src/pruebas/auth.ts ===
import type { PasarelaAuth, UsuarioActual } from "../auth/sesion";
import { ROLES } from "../generado/roles";

/** Usuarios con la sesión iniciada para los tests; en `cambios`, aquello de lo que trata el test. */
export const MadreUsuarioActual = {
  aleatorio(cambios: Partial<UsuarioActual> = {}): UsuarioActual {
    const id = crypto.randomUUID();
    return { id, email: `ana-${id.slice(0, 8)}@example.com`, nombre: "Ana", roles: [], ...cambios };
  },

  /** Tiene todos los roles que comprueba una pantalla generada: con él inicia sesión `renderizarPantalla`. */
  llamante(): UsuarioActual {
    return MadreUsuarioActual.aleatorio({ roles: [...ROLES] });
  },
};

/** Una `PasarelaAuth` con `usuario` en sesión (`null`: nadie). `logins` guarda cada llamada a `login`. */
export function pasarelaAuthFalsa({ usuario = null }: { usuario?: UsuarioActual | null } = {}) {
  const logins: string[] = [];
  const pasarela: PasarelaAuth = {
    usuarioActual: async () => usuario,
    tokenAcceso: async () => (usuario === null ? null : `token-de-${usuario.id}`),
    login: async (volverA) => {
      logins.push(volverA);
    },
    completarLogin: async () => "/",
    logout: async () => {},
  };
  return { ...pasarela, logins };
}

=== web/src/pruebas/equipo.ts ===
import type { Esquemas } from "../api/cliente";
import { coleccion } from "./api-falsa";

type Equipo = Esquemas["DtoEquipo"];
type PeticionEquipo = Esquemas["PeticionCrearEquipo"];

/** Datos válidos de equipos; en `cambios`, los campos de los que trata el test. */
export const MadreEquipo = {
  peticion(cambios: Partial<PeticionEquipo> = {}): PeticionEquipo {
    return {
      nombre: "example",
      ...cambios,
    };
  },

  aleatorio(cambios: Partial<Equipo> = {}): Equipo {
    return { id: crypto.randomUUID(), ...MadreEquipo.peticion(), ...cambios };
  },
};

/** El `/equipos` de la API falsa, con `semilla`. */
export function coleccionEquipo(semilla: Equipo[] = []) {
  return coleccion("/equipos", "equipo", semilla);
}

