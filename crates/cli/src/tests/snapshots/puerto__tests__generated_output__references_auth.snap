use dominio_jugador::modelo::Jugador;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoJugador {
    pub id: Uuid,
    pub equipo_id: Uuid,
    pub dorsal: i64,
    /// Privado: una ruta pública no lo da a quien llama sin sesión.
    #[oai(skip_serializing_if_is_none)]
    pub email: Option<String>,
}

impl DtoJugador {
    pub fn from_dominio(entidad: &Jugador) -> Self {
        Self {
            id: entidad.id.valor(),
            equipo_id: entidad.equipo_id.valor(),
            dorsal: entidad.dorsal,
            email: Some(entidad.email.clone()),
        }
    }

    /// Sin los campos privados: lo que una ruta pública da a quien llama sin sesión.
    pub fn from_dominio_publico(entidad: &Jugador) -> Self {
        Self {
            email: None,
            ..Self::from_dominio(entidad)
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearJugador {
    pub equipo_id: Uuid,
    pub dorsal: i64,
    pub email: String,
}

/// Una página de Jugadores: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaJugador {
    pub elementos: Vec<DtoJugador>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaJugador {
    pub fn from_dominio(pagina: &Pagina<Jugador>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoJugador::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }

    /// La página sin los campos privados de sus elementos.
    pub fn from_dominio_publico(pagina: &Pagina<Jugador>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoJugador::from_dominio_publico)
                .collect(),
            ..Self::from_dominio(pagina)
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarJugador {
    pub equipo_id: Uuid,
    pub dorsal: i64,
    pub email: String,
}

=== contextos/jugador/rest/src/errores.rs ===
use dominio_jugador::errores::ErrorJugador;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de jugador como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorJugador) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorJugador::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorJugador::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorJugador::Duplicado => StatusCode::CONFLICT,
        ErrorJugador::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorJugador::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorJugador::Prohibido => StatusCode::FORBIDDEN,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorJugador::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "jugador.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorJugador::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "jugador.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorJugador::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "jugador.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorJugador::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "jugador.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorJugador::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "jugador.desconocido");
    }

    #[test]
    fn deberia_mapear_prohibido_a_403_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorJugador::Prohibido);

        // Comprobar
        assert_eq!(status, StatusCode::FORBIDDEN);
        assert_eq!(cuerpo.codigo, "jugador.prohibido");
    }
}

