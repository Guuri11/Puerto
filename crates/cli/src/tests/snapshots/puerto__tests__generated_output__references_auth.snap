import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { MadreUsuarioActual } from "../../../pruebas/auth";
import { coleccionEquipo, MadreEquipo } from "../../../pruebas/equipo";
import { coleccionJugador, MadreJugador } from "../../../pruebas/jugador";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleJugador } from "./detalle-jugador";

describe("ContenedorDetalleJugador", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreJugador.aleatorio();
    const api = apiFalsa([coleccionJugador([sembrado])]);

    const pantalla = <ContenedorDetalleJugador id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería enlazar Equipo con su página y su etiqueta", async () => {
    // Preparar
    const sembrado = MadreJugador.aleatorio();
    const objetivo = MadreEquipo.aleatorio({ id: sembrado.equipoId });
    const api = apiFalsa([coleccionJugador([sembrado]), coleccionEquipo([objetivo])]);
    const pantalla = <ContenedorDetalleJugador id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/equipos/${sembrado.equipoId}"]`;
    expect(await screen.findByText(objetivo.nombre, { selector })).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionJugador()]);
    const pantalla = <ContenedorDetalleJugador id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("jugador.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreJugador.aleatorio();
    const guardados = coleccionJugador([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleJugador id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/jugadores"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });

  test("no debería ofrecer Editar a quien no tiene su rol", async () => {
    // Preparar
    const sembrado = MadreJugador.aleatorio();
    const api = apiFalsa([coleccionJugador([sembrado])]);
    const usuario = MadreUsuarioActual.aleatorio();
    const pantalla = <ContenedorDetalleJugador id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api }, "/", { usuario });

    // Comprobar
    expect(await screen.findByText("Equipo", { selector: "dt" })).toBeTruthy();
    expect(screen.queryByText("Editar", { selector: ".card-actions *" })).toBeNull();
  });

  test("no debería ofrecer Borrar a quien no tiene su rol", async () => {
    // Preparar
    const sembrado = MadreJugador.aleatorio();
    const api = apiFalsa([coleccionJugador([sembrado])]);
    const usuario = MadreUsuarioActual.aleatorio();
    const pantalla = <ContenedorDetalleJugador id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api }, "/", { usuario });

    // Comprobar
    expect(await screen.findByText("Equipo", { selector: "dt" })).toBeTruthy();
    expect(screen.queryByText("Borrar", { selector: ".card-actions *" })).toBeNull();
  });

  test("debería mostrar auth.prohibido cuando la API rechaza el borrado", async () => {
    // Preparar
    const sembrado = MadreJugador.aleatorio();
    const fallos = { "DELETE /jugadores": "auth.prohibido" };
    const api = apiFalsa([coleccionJugador([sembrado])], fallos);
    const pantalla = <ContenedorDetalleJugador id={sembrado.id} />;
    renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
});

=== web/src/contextos/jugador/contenedores/detalle-jugador.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { useAuth } from "../../../auth/auth";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleJugador } from "../vistas/detalle-jugador";

export function ContenedorDetalleJugador({ id }: { id: string }) {
  const { api } = useDependencias();
  const { puede } = useAuth();
  const jugador = useCarga(
    () => desenvolver(api.GET("/jugadores/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/jugadores/{id}", { params: { path: { id } } }));
      navegar("/jugadores");
    } catch (error) {
      setFallo(error);
    }
  };
  const etiquetaEquipo = async (objetivo: string) => {
    const params = { path: { id: objetivo } };
    const encontrado = await desenvolver(api.GET("/equipos/{id}", { params }));
    return encontrado.nombre;
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Jugador</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {jugador.estado === "cargando" && <span className="loading loading-spinner" />}
      {jugador.estado === "error" && <AlertaError error={jugador.error} />}
      {jugador.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleJugador jugador={jugador.datos} etiquetaEquipo={etiquetaEquipo} />
            <div className="card-actions justify-end">
              {puede("admin") && (
                <Link href={`/jugadores/${id}/editar`} className="btn">
                  Editar
                </Link>
              )}
              {puede("admin") && (
                <button
                  type="button"
                  className="btn btn-error"
                  onClick={() => setConfirmando(true)}
                >
                  Borrar
                </button>
              )}
            </div>
          </div>
        </div>
      )}
      <Link href="/jugadores" className="link">
        Volver a jugadores
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar jugador?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/jugador/contenedores/formulario-jugador.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionEquipo, MadreEquipo } from "../../../pruebas/equipo";
import { coleccionJugador, MadreJugador } from "../../../pruebas/jugador";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioJugador } from "./formulario-jugador";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Elige `id` en el select de una referencia, en cuanto se cargan sus objetivos. */
async function elegir(etiqueta: string, id: string) {
  const select = screen.getByLabelText(etiqueta);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** Las colecciones que leen los selects, con lo que referencia `dueno`. */
function referenciadosPor(dueno: Partial<Esquemas["DtoJugador"]>) {
  return [coleccionEquipo([MadreEquipo.aleatorio({ id: dueno.equipoId ?? crypto.randomUUID() })])];
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearJugador"]) {
  await screen.findByText("Guardar");
  await elegir("Equipo", peticion.equipoId);
  escribir("Dorsal", String(peticion.dorsal));
  escribir("Email", peticion.email);
}

describe("ContenedorFormularioJugador", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreJugador.peticion();
    const guardados = coleccionJugador();
    const api = apiFalsa([guardados, ...referenciadosPor(peticion)]);
    const pantalla = <ContenedorFormularioJugador />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/jugadores/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/jugadores/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreJugador.aleatorio();
    const guardados = coleccionJugador([sembrado]);
    const api = apiFalsa([guardados, ...referenciadosPor(sembrado)]);
    const pantalla = <ContenedorFormularioJugador id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/jugadores/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreJugador.peticion();
    const codigo = "jugador.validacion.invalido";
    const fallos = { "POST /jugadores": codigo };
    const api = apiFalsa([coleccionJugador(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioJugador />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreJugador.peticion();
    const codigo = "jugador.duplicado";
    const fallos = { "POST /jugadores": codigo };
    const api = apiFalsa([coleccionJugador(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioJugador />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería ofrecer cada equipo en sus selects", async () => {
    // Preparar
    const equipo = MadreEquipo.aleatorio();
    const api = apiFalsa([coleccionEquipo([equipo])]);

    // Actuar
    renderizarPantalla(<ContenedorFormularioJugador />, { api });

    // Comprobar
    const opciones = await screen.findAllByRole("option", { name: equipo.nombre });
    expect(opciones).toHaveLength(1);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreJugador.peticion();
    const codigo = "jugador.validacion.equipo_id_no_encontrado";
    const fallos = { "POST /jugadores": codigo };
    const api = apiFalsa([coleccionJugador(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioJugador />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Equipo");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/jugador/contenedores/formulario-jugador.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver, LIMITE_PAGINA_MAXIMO } from "../../../api/http";
import { opcionesReferencia } from "../../../compartido/formularios";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioJugador,
  aPeticionJugador,
  VistaFormularioJugador,
} from "../vistas/formulario-jugador";

type Jugador = Esquemas["DtoJugador"];

/** La primera página de cada entidad referenciada: lo que ofrecen sus selects. */
const PRIMERA_PAGINA = { params: { query: { limite: LIMITE_PAGINA_MAXIMO } } };

/** Crear, o editar con `id`: el formulario de jugadores. */
export function ContenedorFormularioJugador({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/jugadores/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear jugador" : "Editar jugador";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioJugador existente={existente.datos} />}
      <Link href={id === undefined ? "/jugadores" : `/jugadores/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioJugador({ existente }: { existente: Jugador | null }) {
  const { api } = useDependencias();
  const equipos = useCarga(() => desenvolver(api.GET("/equipos", PRIMERA_PAGINA)), [api]);
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioJugador(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionJugador(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/jugadores", { body: cuerpo })
          : api.PUT("/jugadores/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/jugadores/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        {equipos.estado === "error" && <AlertaError error={equipos.error} />}
        <VistaFormularioJugador
          valores={valores}
          opciones={{
            equipoId: opcionesReferencia(equipos, (equipo) => equipo.nombre),
          }}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/jugador/contenedores/lista-jugador.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionJugador, MadreJugador } from "../../../pruebas/jugador";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaJugador } from "./lista-jugador";

describe("ContenedorListaJugador", () => {
  test("debería mostrar una fila por cada jugador", async () => {
    // Preparar
    const semilla = [MadreJugador.aleatorio(), MadreJugador.aleatorio()];
    const api = apiFalsa([coleccionJugador(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaJugador />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreJugador.aleatorio());
    const api = apiFalsa([coleccionJugador(semilla)]);
    renderizarPantalla(<ContenedorListaJugador />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreJugador.aleatorio());
    const api = apiFalsa([coleccionJugador(semilla)]);
    const ruta = "/jugadores?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaJugador />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay jugadores", async () => {
    // Preparar
    const api = apiFalsa([coleccionJugador()]);

    // Actuar
    renderizarPantalla(<ContenedorListaJugador />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay jugadores.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /jugadores": "jugador.repositorio" };
    const api = apiFalsa([coleccionJugador()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaJugador />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("jugador.repositorio");
  });
});

=== web/src/contextos/jugador/contenedores/lista-jugador.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaJugador } from "../vistas/lista-jugador";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaJugador() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const jugadores = useCarga(
    () => desenvolver(api.GET("/jugadores", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Jugadores</h1>
        <Link href="/jugadores/nuevo" className="btn btn-primary">
          Crear jugador
        </Link>
      </div>
      {jugadores.estado === "cargando" && <span className="loading loading-spinner" />}
      {jugadores.estado === "error" && <AlertaError error={jugadores.error} />}
      {jugadores.estado === "listo" &&
        (jugadores.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay jugadores." />
        ) : (
          <>
            <VistaListaJugador jugadores={jugadores.datos.elementos} />
            <Paginacion
              total={jugadores.datos.total}
              limite={jugadores.datos.limite}
              desplazamiento={jugadores.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/jugador/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaJugador {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "jugador.validacion.equipo_id_no_encontrado": "Equipo: no existe",
  "jugador.validacion.email_vacio": "Email: obligatorio",
  "jugador.duplicado": "Estos valores ya están en uso",
  "jugador.no_encontrado": "Ya no existe",
  "jugador.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "jugador.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "jugador.validacion.equipo_id_no_encontrado": "equipoId",
  "jugador.validacion.email_vacio": "email",
};

export function aProblema(codigo: string): ProblemaJugador {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

