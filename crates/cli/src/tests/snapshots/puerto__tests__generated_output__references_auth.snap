=== contextos/jugador/dominio/src/modelo.rs ===
use chrono::{DateTime, Utc};
use dominio_equipo::modelo::IdEquipo;
use uuid::Uuid;

use crate::errores::ErrorJugador;

/// El id de cada `Jugador`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdJugador(Uuid);

impl IdJugador {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdJugador {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsJugador {
    pub equipo_id: IdEquipo,
    pub dorsal: i64,
    pub email: String,
}

#[derive(Debug, Clone)]
pub struct Jugador {
    pub id: IdJugador,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub equipo_id: IdEquipo,
    pub dorsal: i64,
    pub email: String,
}

impl Jugador {
    pub fn new(props: PropsJugador) -> Result<Self, ErrorJugador> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdJugador::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            equipo_id: props.equipo_id,
            dorsal: props.dorsal,
            email: props.email,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsJugador) -> Result<(), ErrorJugador> {
        Self::validar(&props)?;
        self.equipo_id = props.equipo_id;
        self.dorsal = props.dorsal;
        self.email = props.email;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Jugador) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsJugador) -> Result<(), ErrorJugador> {
        if props.email.trim().is_empty() {
            return Err(ErrorJugador::Validacion("email_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreJugador;

    #[test]
    fn deberia_crear_jugador_cuando_los_campos_son_validos() {
        let resultado = Jugador::new(MadreJugador::new().construir_props());
        assert_eq!(
            resultado.unwrap().email,
            MadreJugador::new().construir_props().email
        );
    }

    #[test]
    fn deberia_rechazar_jugador_cuando_email_es_una_cadena_vacia() {
        let resultado = Jugador::new(MadreJugador::new().con_email_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "jugador.validacion.email_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_jugador_cuando_email_solo_tiene_espacios() {
        let resultado = Jugador::new(MadreJugador::new().con_email("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_jugador_cuando_email_es_una_cadena_vacia() {
        let mut entidad = MadreJugador::aleatorio();
        let resultado = entidad.actualizar(MadreJugador::new().con_email_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "jugador.validacion.email_vacio"
        );
    }
}

=== contextos/jugador/dominio/src/pruebas/madres.rs ===
use crate::modelo::Jugador;
use crate::modelo::PropsJugador;
use dominio_equipo::modelo::IdEquipo;

pub struct MadreJugador {
    equipo_id: Option<IdEquipo>,
    dorsal: Option<i64>,
    email: Option<String>,
}

impl MadreJugador {
    pub fn new() -> Self {
        Self {
            equipo_id: None,
            dorsal: None,
            email: None,
        }
    }

    pub fn con_equipo_id(mut self, equipo_id: IdEquipo) -> Self {
        self.equipo_id = Some(equipo_id);
        self
    }

    pub fn con_dorsal(mut self, dorsal: i64) -> Self {
        self.dorsal = Some(dorsal);
        self
    }

    pub fn con_email(mut self, email: &str) -> Self {
        self.email = Some(email.to_string());
        self
    }

    pub fn con_email_vacio(mut self) -> Self {
        self.email = Some(String::new());
        self
    }

    pub fn construir(self) -> Jugador {
        Jugador::new(PropsJugador {
            equipo_id: self.equipo_id.unwrap_or_else(IdEquipo::generar),
            dorsal: self.dorsal.unwrap_or(42),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadreJugador: Jugador::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsJugador {
        PropsJugador {
            equipo_id: self.equipo_id.unwrap_or_else(IdEquipo::generar),
            dorsal: self.dorsal.unwrap_or(42),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Jugador {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Jugador> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreJugador {
    fn default() -> Self {
        Self::new()
    }
}

=== contextos/jugador/dominio/src/repositorio.rs ===
use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{IdJugador, Jugador};
use dominio_equipo::modelo::IdEquipo;

/// A qué reduce `buscar_todos` la página: un id por referencia; `None` no filtra.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct FiltroJugador {
    pub equipo_id: Option<IdEquipo>,
}

#[async_trait]
pub trait RepositorioJugador: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroJugador,
    ) -> Result<Pagina<Jugador>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdJugador) -> Result<Option<Jugador>, ErrorRepositorio>;
    async fn guardar(&self, entidad: &Jugador) -> Result<(), ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
