=== web/src/contextos/jugador/vistas/formulario-jugador.tsx ===
import type { Esquemas } from "../../../api/cliente";
import type { OpcionReferencia } from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaJugador } from "../mensajes";

type Jugador = Esquemas["DtoJugador"];
type PeticionJugador = Esquemas["PeticionCrearJugador"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioJugador {
  equipoId: string;
  dorsal: string;
  email: string;
}

/** Los inputs de `jugador`, vacíos cuando todavía no hay ninguno. */
export function aFormularioJugador(jugador: Jugador | null): ValoresFormularioJugador {
  if (jugador === null) {
    return {
      equipoId: "",
      dorsal: "",
      email: "",
    };
  }
  return {
    equipoId: jugador.equipoId,
    dorsal: String(jugador.dorsal),
    email: jugador.email ?? "",
  };
}

/** Lo que ofrece el select de cada referencia. */
export interface OpcionesFormularioJugador {
  equipoId: OpcionReferencia[];
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionJugador(valores: ValoresFormularioJugador): PeticionJugador {
  return {
    equipoId: valores.equipoId,
    dorsal: Number(valores.dorsal),
    email: valores.email,
  };
}

export function VistaFormularioJugador({
  valores,
  opciones,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioJugador;
  opciones: OpcionesFormularioJugador;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaJugador | null;
  alCambiar: (valores: ValoresFormularioJugador) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Equipo</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "equipoId"}
          required
          value={valores.equipoId}
          onChange={(event) => alCambiar({ ...valores, equipoId: event.target.value })}
        >
          <option value="">Elige una opción</option>
          {opciones.equipoId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="equipoId" />
      <label className="fieldset">
        <span className="fieldset-legend">Dorsal</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "dorsal"}
          required
          value={valores.dorsal}
          onChange={(event) => alCambiar({ ...valores, dorsal: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="dorsal" />
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "email"}
          required
          value={valores.email}
          onChange={(event) => alCambiar({ ...valores, email: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="email" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

