use async_trait::async_trait;
use dominio_equipo::errores::ErrorEquipo;
use dominio_equipo::modelo::{Equipo, IdEquipo};
use dominio_equipo::repositorio::RepositorioEquipo;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerEquipo {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub id: IdEquipo,
}

#[async_trait]
pub trait ObtenerEquipo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerEquipo) -> Result<Equipo, ErrorEquipo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerEquipo {}

        #[async_trait]
        impl ObtenerEquipo for ObtenerEquipo {
            async fn ejecutar(&self, params: ParamsObtenerEquipo) -> Result<Equipo, ErrorEquipo>;
        }
    }
}

pub struct ObtenerEquipoImpl {
    pub repositorio: Arc<dyn RepositorioEquipo>,
}

#[async_trait]
impl ObtenerEquipo for ObtenerEquipoImpl {
    async fn ejecutar(&self, params: ParamsObtenerEquipo) -> Result<Equipo, ErrorEquipo> {
        tracing::info!(id = %params.id, "obtener_equipo: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_equipo: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorEquipo::NoEncontrado;
            tracing::warn!(error = %err, "obtener_equipo: rechazado");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_equipo::{
        modelo::IdEquipo, pruebas::madres::MadreEquipo, repositorio::dobles::MockRepositorioEquipo,
    };
    use puerto_nucleo::ErrorRepositorio;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_devolver_equipo_cuando_el_id_existe() {
        let entidad = MadreEquipo::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ObtenerEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerEquipo {
                actor: MadrePrincipal::aleatorio(),
                id: id_entidad,
            })
            .await;

        assert_eq!(resultado.unwrap().id, id_entidad);
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_el_id_no_existe() {
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ObtenerEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerEquipo {
                actor: MadrePrincipal::aleatorio(),
                id: IdEquipo::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "equipo.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_el_almacen_no_esta_disponible() {
        let mut repositorio_doble = MockRepositorioEquipo::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Err(ErrorRepositorio::NoDisponible));
        let caso_de_uso = ObtenerEquipoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerEquipo {
                actor: MadrePrincipal::aleatorio(),
                id: IdEquipo::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "equipo.repositorio");
    }
}

