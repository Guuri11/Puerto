#[cfg(test)]
mod tests {
    use super::*;
    use dominio_jugador::{
        modelo::IdJugador, pruebas::madres::MadreJugador,
        repositorio::dobles::MockRepositorioJugador,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

