import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CurrentUserMother } from "../../../test-support/auth";
import { EquipoMother, equipoCollection } from "../../../test-support/equipo";
import { fakeApi } from "../../../test-support/fake-api";
import { JugadorMother, jugadorCollection } from "../../../test-support/jugador";
import { renderScreen } from "../../../test-support/render";
import { JugadorDetailContainer } from "./jugador-detail-container";

describe("JugadorDetailContainer", () => {
  test("should show the jugador when it exists", async () => {
    // Arrange
    const seeded = JugadorMother.random();
    const api = fakeApi([jugadorCollection([seeded])]);

    // Act
    renderScreen(<JugadorDetailContainer id={seeded.id} />, { api });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the equipo to its page, named by its label", async () => {
    // Arrange
    const seeded = JugadorMother.random();
    const target = EquipoMother.random({ id: seeded.equipoId });
    const api = fakeApi([jugadorCollection([seeded]), equipoCollection([target])]);

    // Act
    renderScreen(<JugadorDetailContainer id={seeded.id} />, { api });

    // Assert: by its href — two references to one target may share a label.
    const selector = `a[href="/equipos/${seeded.equipoId}"]`;
    expect(await screen.findByText(target.nombre, { selector })).toBeTruthy();
  });

  test("should show the not-found code when the jugador does not exist", async () => {
    // Arrange
    const api = fakeApi([jugadorCollection()]);

    // Act
    renderScreen(<JugadorDetailContainer id={crypto.randomUUID()} />, { api });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("jugador.no_encontrado");
  });

  test("should delete the jugador only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = JugadorMother.random();
    const stored = jugadorCollection([seeded]);
    const api = fakeApi([stored]);
    const { history } = renderScreen(<JugadorDetailContainer id={seeded.id} />, { api });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(stored.items.has(seeded.id)).toBe(true);

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/jugadores"));
    expect(stored.items.has(seeded.id)).toBe(false);
  });

  test("should not offer Edit to a user without its role", async () => {
    // Arrange
    const seeded = JugadorMother.random();
    const api = fakeApi([jugadorCollection([seeded])]);
    const user = CurrentUserMother.random();

    // Act
    renderScreen(<JugadorDetailContainer id={seeded.id} />, { api }, "/", { user });

    // Assert
    expect(await screen.findByText("Equipo", { selector: "dt" })).toBeTruthy();
    expect(screen.queryByText("Edit", { selector: ".card-actions *" })).toBeNull();
  });

  test("should not offer Delete to a user without its role", async () => {
    // Arrange
    const seeded = JugadorMother.random();
    const api = fakeApi([jugadorCollection([seeded])]);
    const user = CurrentUserMother.random();

    // Act
    renderScreen(<JugadorDetailContainer id={seeded.id} />, { api }, "/", { user });

    // Assert
    expect(await screen.findByText("Equipo", { selector: "dt" })).toBeTruthy();
    expect(screen.queryByText("Delete", { selector: ".card-actions *" })).toBeNull();
  });

  test("should show auth.prohibido when the API refuses the deletion", async () => {
    // Arrange
    const seeded = JugadorMother.random();
    const failures = { "DELETE /jugadores": "auth.prohibido" };
    const api = fakeApi([jugadorCollection([seeded])], failures);
    renderScreen(<JugadorDetailContainer id={seeded.id} />, { api });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
});

=== web/src/features/jugador/containers/jugador-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { unwrap } from "../../../api/http";
import { useAuth } from "../../../auth/auth";
import { useDependencies } from "../../../dependencies";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { JugadorDetailView } from "../views/jugador-detail-view";

export function JugadorDetailContainer({ id }: { id: string }) {
  const { api } = useDependencies();
  const { can } = useAuth();
  const jugador = useAsync(
    () => unwrap(api.GET("/jugadores/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await unwrap(api.DELETE("/jugadores/{id}", { params: { path: { id } } }));
      navigate("/jugadores");
    } catch (error) {
      setFailure(error);
    }
  };
  const equipoLabel = async (target: string) => {
    const params = { path: { id: target } };
    const found = await unwrap(api.GET("/equipos/{id}", { params }));
    return found.nombre;
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Jugador</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {jugador.status === "loading" && <span className="loading loading-spinner" />}
      {jugador.status === "error" && <ErrorAlert error={jugador.error} />}
      {jugador.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <JugadorDetailView jugador={jugador.data} equipoLabel={equipoLabel} />
            <div className="card-actions justify-end">
              {can("admin") && (
                <Link href={`/jugadores/${id}/edit`} className="btn">
                  Edit
                </Link>
              )}
              {can("admin") && (
                <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                  Delete
                </button>
              )}
            </div>
          </div>
        </div>
      )}
      <Link href="/jugadores" className="link">
        Back to jugadores
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this jugador?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

