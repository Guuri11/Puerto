use async_trait::async_trait;
use dominio_jugador::errores::ErrorJugador;
use dominio_jugador::modelo::{IdJugador, Jugador};
use dominio_jugador::repositorio::RepositorioJugador;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerJugador {
    pub id: IdJugador,
}

#[async_trait]
pub trait ObtenerJugador: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerJugador) -> Result<Jugador, ErrorJugador>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerJugador {}

        #[async_trait]
        impl ObtenerJugador for ObtenerJugador {
            async fn ejecutar(&self, params: ParamsObtenerJugador) -> Result<Jugador, ErrorJugador>;
        }
    }
}

pub struct ObtenerJugadorImpl {
    pub repositorio: Arc<dyn RepositorioJugador>,
}

#[async_trait]
impl ObtenerJugador for ObtenerJugadorImpl {
    async fn ejecutar(&self, params: ParamsObtenerJugador) -> Result<Jugador, ErrorJugador> {
        tracing::info!(id = %params.id, "obtener_jugador: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_jugador: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorJugador::NoEncontrado;
            tracing::warn!(error = %err, "obtener_jugador: rechazado");
            err
        })
    }
}

#[cfg(test)]
mod tests {
