=== presentacion/cableado/src/lib.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod equipo {
    use std::sync::Arc;

    use aplicacion_equipo::actualizar_equipo::{ActualizarEquipo, ActualizarEquipoImpl};
    use aplicacion_equipo::borrar_equipo::{BorrarEquipo, BorrarEquipoImpl};
    use aplicacion_equipo::crear_equipo::{CrearEquipo, CrearEquipoImpl};
    use aplicacion_equipo::listar_equipos::{ListarEquipos, ListarEquiposImpl};
    use aplicacion_equipo::obtener_equipo::{ObtenerEquipo, ObtenerEquipoImpl};
    use dominio_equipo::repositorio::RepositorioEquipo;
    use infra_equipo::repositorio::RepositorioEquipoEnMemoria;

    /// Los casos de uso de `equipo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_equipo: Arc<dyn CrearEquipo>,
        pub obtener_equipo: Arc<dyn ObtenerEquipo>,
        pub listar_equipos: Arc<dyn ListarEquipos>,
        pub actualizar_equipo: Arc<dyn ActualizarEquipo>,
        pub borrar_equipo: Arc<dyn BorrarEquipo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioEquipo> = Arc::new(RepositorioEquipoEnMemoria::new());
        CasosDeUso {
            crear_equipo: Arc::new(CrearEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_equipo: Arc::new(ObtenerEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_equipos: Arc::new(ListarEquiposImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_equipo: Arc::new(ActualizarEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_equipo: Arc::new(BorrarEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod jugador {
    use std::sync::Arc;

    use aplicacion_jugador::actualizar_jugador::{ActualizarJugador, ActualizarJugadorImpl};
    use aplicacion_jugador::borrar_jugador::{BorrarJugador, BorrarJugadorImpl};
    use aplicacion_jugador::crear_jugador::{CrearJugador, CrearJugadorImpl};
    use aplicacion_jugador::listar_jugadores::{ListarJugadores, ListarJugadoresImpl};
    use aplicacion_jugador::obtener_jugador::{ObtenerJugador, ObtenerJugadorImpl};
    use dominio_jugador::repositorio::RepositorioJugador;
    use infra_jugador::repositorio::RepositorioJugadorEnMemoria;

    /// Los casos de uso de `jugador`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_jugador: Arc<dyn CrearJugador>,
        pub obtener_jugador: Arc<dyn ObtenerJugador>,
        pub listar_jugadores: Arc<dyn ListarJugadores>,
        pub actualizar_jugador: Arc<dyn ActualizarJugador>,
        pub borrar_jugador: Arc<dyn BorrarJugador>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioJugador> = Arc::new(RepositorioJugadorEnMemoria::new());
        CasosDeUso {
            crear_jugador: Arc::new(CrearJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_jugador: Arc::new(ObtenerJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_jugadores: Arc::new(ListarJugadoresImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_jugador: Arc::new(ActualizarJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_jugador: Arc::new(BorrarJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

