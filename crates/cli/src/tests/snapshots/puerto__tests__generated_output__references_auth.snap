use async_trait::async_trait;
use dominio_jugador::errores::ErrorJugador;
use dominio_jugador::modelo::IdJugador;
use dominio_jugador::repositorio::RepositorioJugador;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarJugador {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub id: IdJugador,
}

#[async_trait]
pub trait BorrarJugador: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarJugador) -> Result<(), ErrorJugador>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarJugador {}

        #[async_trait]
        impl BorrarJugador for BorrarJugador {
            async fn ejecutar(&self, params: ParamsBorrarJugador) -> Result<(), ErrorJugador>;
        }
    }
}

pub struct BorrarJugadorImpl {
    pub repositorio: Arc<dyn RepositorioJugador>,
}

#[async_trait]
impl BorrarJugador for BorrarJugadorImpl {
    #[tracing::instrument(name = "borrar_jugador", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsBorrarJugador) -> Result<(), ErrorJugador> {
        let mut entidad = self
            .repositorio
