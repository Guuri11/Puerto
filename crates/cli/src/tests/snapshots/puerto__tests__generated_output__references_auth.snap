=== web/src/features/equipo/views/equipo-form-view.tsx ===
import type { Schemas } from "../../../api/client";
import { FieldError } from "../../../shared/ui/field-error";
import type { EquipoProblem } from "../messages";

type Equipo = Schemas["DtoEquipo"];
type EquipoRequest = Schemas["PeticionCrearEquipo"];

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface EquipoFormValues {
  nombre: string;
}

/** The inputs for `equipo`, empty when there is none yet. */
export function toEquipoForm(equipo: Equipo | null): EquipoFormValues {
  if (equipo === null) {
    return {
      nombre: "",
    };
  }
  return {
    nombre: equipo.nombre,
  };
}

/** What a create or an update sends: the same fields for both. */
export function toEquipoRequest(values: EquipoFormValues): EquipoRequest {
  return {
    nombre: values.nombre,
  };
}

export function EquipoFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: EquipoFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: EquipoProblem | null;
  onChange: (values: EquipoFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Nombre</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "nombre"}
          required
          value={values.nombre}
          onChange={(event) => onChange({ ...values, nombre: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="nombre" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

