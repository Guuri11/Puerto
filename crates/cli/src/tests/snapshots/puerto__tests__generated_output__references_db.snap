use business::domain::order::model::OrderId;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use business::domain::shipment::{
    errors::ShipmentError,
    model::{Shipment, ShipmentId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct ShipmentDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub order_id: Uuid,
    pub carrier: String,
}

impl TryFrom<ShipmentDb> for Shipment {
    type Error = ShipmentError;

    fn try_from(row: ShipmentDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Shipment {
            id: ShipmentId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            order_id: OrderId::from_uuid(row.order_id),
            carrier: row.carrier,
        }))
    }
}

impl From<&Shipment> for ShipmentDb {
    fn from(entity: &Shipment) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            order_id: entity.order_id.value(),
            carrier: entity.carrier.clone(),
        }
    }
}

