use dominio_envio::modelo::Envio;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoEnvio {
    pub id: Uuid,
    pub pedido_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

impl DtoEnvio {
    pub fn from_dominio(entidad: &Envio) -> Self {
        Self {
            id: entidad.id.valor(),
            pedido_id: entidad.pedido_id.valor(),
            destinatario_id: entidad.destinatario_id.map(|v| v.valor()),
            carrier: entidad.carrier.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearEnvio {
    pub pedido_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

/// Una página de Envios: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaEnvio {
    pub elementos: Vec<DtoEnvio>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaEnvio {
    pub fn from_dominio(pagina: &Pagina<Envio>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoEnvio::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarEnvio {
    pub pedido_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

=== contextos/envio/rest/src/errores.rs ===
use dominio_envio::errores::ErrorEnvio;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de envio como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorEnvio) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorEnvio::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorEnvio::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorEnvio::Duplicado => StatusCode::CONFLICT,
        ErrorEnvio::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorEnvio::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorEnvio::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "envio.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEnvio::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "envio.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEnvio::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "envio.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEnvio::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "envio.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEnvio::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "envio.desconocido");
    }
}

