import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { EnvioError } from "../../../../domain/envio/errors";
import { EnvioMother, fakeEnvioRepository } from "../../../../test-support/envio";
import { renderScreen } from "../../../../test-support/render";
import { EnvioListContainer } from "./envio-list-container";

describe("EnvioListContainer", () => {
  test("should show a row per envio when there are some", async () => {
    // Arrange
    const seed = [EnvioMother.random(), EnvioMother.random()];
    const envioRepository = fakeEnvioRepository(seed);

    // Act
    renderScreen(<EnvioListContainer />, { envioRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => EnvioMother.random());
    const envioRepository = fakeEnvioRepository(seed);
    renderScreen(<EnvioListContainer />, { envioRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => EnvioMother.random());
    const envioRepository = fakeEnvioRepository(seed);
    const path = "/envios?page=2";

    // Act
    renderScreen(<EnvioListContainer />, { envioRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no envio", async () => {
    // Arrange
    const envioRepository = fakeEnvioRepository();

    // Act
    renderScreen(<EnvioListContainer />, { envioRepository });

    // Assert
    expect(await screen.findByText("No envios yet.")).toBeTruthy();
  });

  test("should show the error code when the envios cannot be listed", async () => {
    // Arrange
    const envioRepository = {
      ...fakeEnvioRepository(),
      list: () => Promise.reject(new EnvioError("envio.repositorio")),
    };

    // Act
    renderScreen(<EnvioListContainer />, { envioRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("envio.repositorio");
  });
});

=== web/src/presentation/features/envio/containers/envio-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { EnvioListView } from "../views/envio-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function EnvioListContainer() {
  const { envioRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const envios = useAsync(
    () => envioRepository.list({ limit: PAGE_SIZE, offset }),
    [envioRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Envios</h1>
        <Link href="/envios/new" className="btn btn-primary">
          New envio
        </Link>
      </div>
      {envios.status === "loading" && <span className="loading loading-spinner" />}
      {envios.status === "error" && <ErrorAlert error={envios.error} />}
      {envios.status === "ok" &&
        (envios.data.total === 0 ? (
          <EmptyState message="No envios yet." />
        ) : (
          <>
            <EnvioListView envios={envios.data.items} />
            <Pagination {...envios.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

