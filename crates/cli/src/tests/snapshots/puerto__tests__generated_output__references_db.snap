import { ShipmentError } from "../domain/shipment/errors";
import type { Shipment, ShipmentDraft } from "../domain/shipment/model";
import type { ShipmentRepository } from "../domain/shipment/repository";

/** Valid shipments for tests; pass `overrides` for the fields a test is about. */
export const ShipmentMother = {
  draft(overrides: Partial<ShipmentDraft> = {}): ShipmentDraft {
    return {
      orderId: crypto.randomUUID(),
      carrier: "example",
      ...overrides,
    };
  },

  random(overrides: Partial<Shipment> = {}): Shipment {
    return { id: crypto.randomUUID(), ...ShipmentMother.draft(), ...overrides };
  },
};

/** An in-memory `ShipmentRepository`. Override a method to make it fail. */
export function fakeShipmentRepository(seed: Shipment[] = []): ShipmentRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new ShipmentError("shipment.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
