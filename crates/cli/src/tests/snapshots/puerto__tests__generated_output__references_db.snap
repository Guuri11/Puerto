=== infrastructure/src/order/entity.rs ===
use business::domain::customer::model::CustomerId;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use business::domain::order::{
    errors::OrderError,
    model::{Order, OrderId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct OrderDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub customer_id: Uuid,
    pub reviewer_id: Option<Uuid>,
    pub total: i64,
}

impl TryFrom<OrderDb> for Order {
    type Error = OrderError;

    fn try_from(row: OrderDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Order {
            id: OrderId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            customer_id: CustomerId::from_uuid(row.customer_id),
            reviewer_id: row.reviewer_id.map(CustomerId::from_uuid),
            total: row.total,
        }))
    }
}

impl From<&Order> for OrderDb {
    fn from(entity: &Order) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            customer_id: entity.customer_id.value(),
            reviewer_id: entity.reviewer_id.map(|v| v.value()),
            total: entity.total,
        }
    }
}

=== infrastructure/src/order/repository.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::order::{
    model::{Order, OrderId},
    repository::{OrderFilter, OrderRepositoryTrait},
};
use puerto_core::{Page, PageRequest, RepositoryError};

use super::entity::OrderDb;
use crate::db::{ForeignKey, map_sqlx_error, map_sqlx_error_with};

pub struct PgOrderRepository {
    pub pool: PgPool,
}

impl PgOrderRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// The foreign keys a write goes through (ADR-0022 of Puerto): the database rejects a reference to
/// a row that does not exist, and the field it names is the caller's error.
const REFERENCES: &[ForeignKey] = &[
    ForeignKey {
        constraint: "orders_customer_id_fkey",
        field: "customer_id",
    },
    ForeignKey {
        constraint: "orders_reviewer_id_fkey",
        field: "reviewer_id",
    },
];

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: OrderDb) -> Result<Order, RepositoryError> {
    Order::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid order");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl OrderRepositoryTrait for PgOrderRepository {
    async fn find_all(
        &self,
        page: PageRequest,
        filter: OrderFilter,
    ) -> Result<Page<Order>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        // One static query whatever the filter: an unset id is NULL and matches every row.
        let customer_id = filter.customer_id.map(|id| id.value());
        let reviewer_id = filter.reviewer_id.map(|id| id.value());
        let rows = sqlx::query_as!(
            OrderDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, customer_id, reviewer_id, total
             FROM orders WHERE deleted = false AND ($3::uuid IS NULL OR customer_id = $3) AND ($4::uuid IS NULL OR reviewer_id = $4)
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limit()),
            i64::from(page.offset()),
            customer_id,
            reviewer_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM orders WHERE deleted = false AND ($1::uuid IS NULL OR customer_id = $1) AND ($2::uuid IS NULL OR reviewer_id = $2)"#,
            customer_id,
            reviewer_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            map_sqlx_error(&e)
        })?;

        let items = rows
            .into_iter()
            .map(to_domain)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: OrderId) -> Result<Option<Order>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            OrderDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, customer_id, reviewer_id, total
             FROM orders WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }

    async fn save(&self, entity: &Order) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = OrderDb::from(entity);
        sqlx::query!(
            "INSERT INTO orders (id, created_at, updated_at, deleted, deleted_at, customer_id, reviewer_id, total)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, customer_id = $6, reviewer_id = $7, total = $8",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.customer_id,
            db.reviewer_id,
            db.total,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error_with(&e, REFERENCES)
        })?;
        Ok(())
    }
}

/// `pub(crate)`: an entity that references Order seeds its rows with this module's `seed`.
#[cfg(test)]
pub(crate) mod integration_tests {
    use super::*;
    use business::domain::order::model::OrderProps;

    use business::domain::customer::model::CustomerId;

    fn test_repo(pool: PgPool) -> PgOrderRepository {
