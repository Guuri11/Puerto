use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::shipment::{
    errors::ShipmentError,
    repository::ShipmentRepositoryTrait,
    use_cases::delete_shipment::{DeleteShipmentParams, DeleteShipmentUseCaseTrait},
};

pub struct DeleteShipmentUseCaseImpl {
    pub repository: Arc<dyn ShipmentRepositoryTrait>,
}

#[async_trait]
impl DeleteShipmentUseCaseTrait for DeleteShipmentUseCaseImpl {
    async fn execute(&self, params: DeleteShipmentParams) -> Result<(), ShipmentError> {
        tracing::info!(id = %params.id, "delete_shipment: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_shipment: repository failed"))?
            .ok_or_else(|| {
                let err = ShipmentError::NotFound;
                tracing::warn!(error = %err, "delete_shipment: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_shipment: repository failed"))?;
        Ok(())
    }
}

