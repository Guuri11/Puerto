import { ShipmentError } from "../../domain/shipment/errors";
import type { Shipment, ShipmentDraft } from "../../domain/shipment/model";
import type { ShipmentRepository } from "../../domain/shipment/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ShipmentDto = components["schemas"]["ShipmentDto"];
type ShipmentRequest = components["schemas"]["CreateShipmentRequest"];

function toShipment(dto: ShipmentDto): Shipment {
  return {
    id: dto.id,
    orderId: dto.orderId,
    carrier: dto.carrier,
  };
}

function toRequest(draft: ShipmentDraft): ShipmentRequest {
  return {
    orderId: draft.orderId,
    carrier: draft.carrier,
  };
}

/** `ShipmentRepository` over the REST API (`/shipments`). */
export function shipmentRepositoryHttp(api: ApiClient): ShipmentRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/shipments", {
        params: { query: page },
      });
      if (data === undefined) throw new ShipmentError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toShipment) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/shipments/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ShipmentError(apiErrorCode(error, response));
      return toShipment(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/shipments", { body: toRequest(draft) });
      if (data === undefined) throw new ShipmentError(apiErrorCode(error, response));
      return toShipment(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/shipments/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ShipmentError(apiErrorCode(error, response));
      return toShipment(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/shipments/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ShipmentError(apiErrorCode(error, response));
    },
  };
}

