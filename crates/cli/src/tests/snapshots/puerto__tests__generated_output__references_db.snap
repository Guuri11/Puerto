=== web/src/infrastructure/cliente/cliente-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { ClienteError } from "../../domain/cliente/errors";
import { ClienteMother } from "../../test-support/cliente";
import { createApiClient } from "../http/client";
import { clienteRepositoryHttp } from "./cliente-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: clienteRepositoryHttp(api), requests };
}

describe("clienteRepositoryHttp", () => {
  test("should ask for the page and return its clientes", async () => {
    // Arrange
    const cliente = ClienteMother.random();
    const { repository, requests } = answering(200, {
      elementos: [cliente],
      total: 21,
      limite: 20,
      desplazamiento: 20,
    });

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    const url = new URL(requests[0]?.url ?? "");
    expect(url.pathname).toBe("/api/clientes");
    expect(url.search).toBe("?limite=20&desplazamiento=20");
    expect(listed).toEqual({ items: [cliente], total: 21, limit: 20, offset: 20 });
  });

  test("should send the draft when creating a cliente", async () => {
    // Arrange
    const draft = ClienteMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the cliente does not exist", async () => {
    // Arrange
    const code = "cliente.no_encontrado";
    const { repository } = answering(404, { codigo: code, mensaje: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(ClienteError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the cliente", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/clientes/42");
  });
});

=== web/src/infrastructure/cliente/cliente-repository-http.ts ===
import { ClienteError } from "../../domain/cliente/errors";
import type { Cliente, ClienteDraft } from "../../domain/cliente/model";
import type { ClienteRepository } from "../../domain/cliente/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ClienteDto = components["schemas"]["DtoCliente"];
type ClienteRequest = components["schemas"]["PeticionCrearCliente"];

function toCliente(dto: ClienteDto): Cliente {
  return {
    id: dto.id,
    name: dto.name,
    email: dto.email,
  };
}

function toRequest(draft: ClienteDraft): ClienteRequest {
  return {
    name: draft.name,
    email: draft.email,
  };
}

/** `ClienteRepository` over the REST API (`/clientes`). */
export function clienteRepositoryHttp(api: ApiClient): ClienteRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/clientes", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toCliente),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/clientes/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return toCliente(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/clientes", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return toCliente(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/clientes/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return toCliente(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/clientes/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ClienteError(apiErrorCode(error, response));
    },
  };
}

