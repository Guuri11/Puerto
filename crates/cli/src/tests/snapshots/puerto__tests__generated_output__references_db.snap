import type { Pedido } from "../../../../domain/pedido/model";
import { useDependencies } from "../../../core/dependencies";
import { labelOf, ReferenceLink } from "../../../shared/ui/reference-link";

export function PedidoDetailView({ pedido }: { pedido: Pedido }) {
  const { clienteRepository } = useDependencies();
  return (
    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
      <dt className="font-semibold">Cliente</dt>
      <dd>
        <ReferenceLink
          path="/clientes"
          id={pedido.clienteId}
          load={labelOf(clienteRepository, (item) => item.name)}
        />
      </dd>
      <dt className="font-semibold">Reviewer</dt>
      <dd>
        <ReferenceLink
          path="/clientes"
          id={pedido.reviewerId}
          load={labelOf(clienteRepository, (item) => item.name)}
        />
      </dd>
      <dt className="font-semibold">Total</dt>
      <dd>{pedido.total}</dd>
    </dl>
  );
}

=== web/src/presentation/features/pedido/views/pedido-form-view.tsx ===
import type { PedidoProblem } from "../../../../domain/pedido/messages";
import type { Pedido, PedidoDraft } from "../../../../domain/pedido/model";
import { type ReferenceOption, textOf, textOrNull } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface PedidoFormValues {
  clienteId: string;
  reviewerId: string;
  total: string;
}

/** The inputs for `pedido`, empty when there is none yet. */
export function toPedidoForm(pedido: Pedido | null): PedidoFormValues {
  if (pedido === null) {
    return {
      clienteId: "",
      reviewerId: "",
      total: "",
    };
  }
  return {
    clienteId: pedido.clienteId,
    reviewerId: textOf(pedido.reviewerId),
    total: String(pedido.total),
  };
}

/** What each reference's select offers. */
export interface PedidoFormOptions {
  clienteId: ReferenceOption[];
  reviewerId: ReferenceOption[];
}

export function toPedidoDraft(values: PedidoFormValues): PedidoDraft {
  return {
    clienteId: values.clienteId,
    reviewerId: textOrNull(values.reviewerId),
    total: Number(values.total),
  };
}

export function PedidoFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: PedidoFormValues;
  options: PedidoFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: PedidoProblem | null;
  onChange: (values: PedidoFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Cliente</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "clienteId"}
          required
          value={values.clienteId}
          onChange={(event) => onChange({ ...values, clienteId: event.target.value })}
        >
          <option value="">Choose a cliente</option>
          {options.clienteId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="clienteId" />
      <label className="fieldset">
        <span className="fieldset-legend">Reviewer</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "reviewerId"}
          value={values.reviewerId}
          onChange={(event) => onChange({ ...values, reviewerId: event.target.value })}
        >
          <option value="">None</option>
          {options.reviewerId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="reviewerId" />
      <label className="fieldset">
        <span className="fieldset-legend">Total</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "total"}
          required
          value={values.total}
          onChange={(event) => onChange({ ...values, total: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="total" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

