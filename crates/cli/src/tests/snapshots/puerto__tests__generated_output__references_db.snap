=== contextos/envio/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad envio válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_envio::modelo::Envio;
use dominio_envio::modelo::PropsEnvio;
use dominio_envio::pruebas::madres::MadreEnvio;
use dominio_envio::repositorio::RepositorioEnvio;
use sqlx::PgPool;

use crate::repositorio::RepositorioEnvioPostgres;

/// Una entidad envio válida, sin guardar, con los valores de la madre salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada).
pub async fn construir(pool: &PgPool) -> Envio {
    Envio::new(PropsEnvio {
        pedido_id: infra_pedido::pruebas::siembra::sembrar(pool).await.id,
        ..MadreEnvio::new().construir_props()
    })
    .unwrap()
}

/// Una entidad envio guardada.
pub async fn sembrar(pool: &PgPool) -> Envio {
    let entidad = construir(pool).await;
    RepositorioEnvioPostgres::new(pool.clone())
        .guardar(&entidad)
        .await
        .unwrap();
    entidad
}

=== contextos/envio/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_envio::{
    modelo::{Envio, IdEnvio},
    repositorio::{FiltroEnvio, RepositorioEnvio},
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::{ClaveForanea, mapear_error_sqlx, mapear_error_sqlx_con};

use crate::fila::FilaEnvio;

pub struct RepositorioEnvioPostgres {
    pub pool: PgPool,
}

impl RepositorioEnvioPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Las claves foráneas por las que pasa una escritura (ADR-0022 de Puerto): la base de datos
/// rechaza una referencia a una fila que no existe, y quien llama recibe como error el campo que la
/// nombra.
const REFERENCES: &[ClaveForanea] = &[
    ClaveForanea {
        restriccion: "envios_pedido_id_fkey",
        campo: "pedido_id",
    },
    ClaveForanea {
        restriccion: "envios_destinatario_id_fkey",
        campo: "destinatario_id",
    },
];

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaEnvio) -> Result<Envio, ErrorRepositorio> {
    Envio::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad envio válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioEnvio for RepositorioEnvioPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroEnvio,
    ) -> Result<Pagina<Envio>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        // Una sola consulta estática sea cual sea el filtro: un id sin valor es NULL y casa con
        // todas las filas.
        let pedido_id = filtro.pedido_id.map(|id| id.valor());
        let destinatario_id = filtro.destinatario_id.map(|id| id.valor());
        let filas = sqlx::query_as!(
            FilaEnvio,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, pedido_id, destinatario_id, carrier
             FROM envios WHERE borrado = false AND ($3::uuid IS NULL OR pedido_id = $3) AND ($4::uuid IS NULL OR destinatario_id = $4)
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento()),
            pedido_id,
            destinatario_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM envios WHERE borrado = false AND ($1::uuid IS NULL OR pedido_id = $1) AND ($2::uuid IS NULL OR destinatario_id = $2)"#,
            pedido_id,
            destinatario_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdEnvio) -> Result<Option<Envio>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaEnvio,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, pedido_id, destinatario_id, carrier
             FROM envios WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }

    async fn guardar(&self, entidad: &Envio) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaEnvio::from(entidad);
        sqlx::query!(
            "INSERT INTO envios (id, creado_en, actualizado_en, borrado, borrado_en, pedido_id, destinatario_id, carrier)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, pedido_id = $6, destinatario_id = $7, carrier = $8",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.pedido_id,
            db.destinatario_id,
            db.carrier,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx_con(&e, REFERENCES)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::{construir, sembrar};
    use dominio_cliente::modelo::IdCliente;
    use dominio_pedido::modelo::IdPedido;

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioEnvioPostgres {
        RepositorioEnvioPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.pedido_id, entidad.pedido_id);
        assert_eq!(encontrado.destinatario_id, entidad.destinatario_id);
        assert_eq!(encontrado.carrier, entidad.carrier);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdEnvio::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_la_entidad_al_guardar_un_id_existente(pool: PgPool) {
        // Preparar
        let mut entidad = sembrar(&pool).await;
        entidad.carrier = "updated".to_string();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        repositorio_de_prueba(pool.clone())
            .guardar(&entidad)
            .await
            .unwrap();

        // Comprobar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(encontrado.carrier, "updated");
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_envios_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        repositorio_de_prueba(pool.clone())
            .guardar(&borrado)
            .await
            .unwrap();

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default(), FiltroEnvio::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::new(Some(2), Some(2)),
                FiltroEnvio::default(),
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_un_duplicado_de_pedido_id(pool: PgPool) {
        // Preparar
        let primero = sembrar(&pool).await;
        let mut segundo = construir(&pool).await;
        segundo.pedido_id = primero.pedido_id;

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&segundo).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::Duplicado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_pedido_id_inexistente(pool: PgPool) {
        // Preparar: un valor de pedido_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.pedido_id = IdPedido::generar();

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("pedido_id")
        );
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_destinatario_id_inexistente(pool: PgPool) {
        // Preparar: un valor de destinatario_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.destinatario_id = Some(IdCliente::generar());

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("destinatario_id")
        );
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_envios_con_ese_valor_de_pedido_id(pool: PgPool) {
        // Preparar: una entidad envio con este valor de pedido_id y otra sin él.
        let destino = infra_pedido::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.pedido_id = destino.id;
        repositorio_de_prueba(pool.clone())
            .guardar(&esperado)
            .await
            .unwrap();
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroEnvio {
                    pedido_id: Some(destino.id),
                    destinatario_id: None,
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_envios_con_ese_valor_de_destinatario_id(pool: PgPool) {
        // Preparar: una entidad envio con este valor de destinatario_id y otra sin él.
        let destino = infra_cliente::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.destinatario_id = Some(destino.id);
        repositorio_de_prueba(pool.clone())
            .guardar(&esperado)
            .await
            .unwrap();
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroEnvio {
                    pedido_id: None,
                    destinatario_id: Some(destino.id),
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }
}

