=== contextos/envio/infraestructura/src/fila.rs ===
use chrono::{DateTime, Utc};
use dominio_cliente::modelo::IdCliente;
use dominio_pedido::modelo::IdPedido;
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_envio::{
    errores::ErrorEnvio,
    modelo::{Envio, IdEnvio},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaEnvio {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub pedido_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

impl TryFrom<FilaEnvio> for Envio {
    type Error = ErrorEnvio;

    fn try_from(fila: FilaEnvio) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Envio {
            id: IdEnvio::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            pedido_id: IdPedido::from_uuid(fila.pedido_id),
            destinatario_id: fila.destinatario_id.map(IdCliente::from_uuid),
            carrier: fila.carrier,
        }))
    }
}

impl From<&Envio> for FilaEnvio {
    fn from(entidad: &Envio) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            pedido_id: entidad.pedido_id.valor(),
            destinatario_id: entidad.destinatario_id.map(|v| v.valor()),
            carrier: entidad.carrier.clone(),
        }
    }
}

