import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ShipmentError } from "../../../../domain/shipment/errors";
import type { ShipmentDraft } from "../../../../domain/shipment/model";
import { fakeOrderRepository, OrderMother } from "../../../../test-support/order";
import { renderScreen } from "../../../../test-support/render";
import { fakeShipmentRepository, ShipmentMother } from "../../../../test-support/shipment";
import { ShipmentFormContainer } from "./shipment-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: ShipmentDraft) {
  return {
    orderRepository: fakeOrderRepository([OrderMother.random({ id: draft.orderId })]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ShipmentDraft) {
  await screen.findByText("Save");
  await choose("Order", draft.orderId);
  type("Carrier", draft.carrier);
}

describe("ShipmentFormContainer", () => {
  test("should create the shipment from what was typed and show it", async () => {
    // Arrange
    const draft = ShipmentMother.draft();
    const shipmentRepository = fakeShipmentRepository();
    const { history } = renderScreen(<ShipmentFormContainer />, {
      shipmentRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/shipments/"));
    const {
      items: [created],
    } = await shipmentRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/shipments/${created?.id}`);
  });

  test("should save the edited shipment when an existing one is submitted", async () => {
    // Arrange
    const seeded = ShipmentMother.random();
    const shipmentRepository = fakeShipmentRepository([seeded]);
    const { history } = renderScreen(<ShipmentFormContainer id={seeded.id} />, {
      shipmentRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/shipments/${seeded.id}`));
    expect(await shipmentRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "shipment.validation_error.invalid";
    const shipmentRepository = {
      ...fakeShipmentRepository(),
      create: () => Promise.reject(new ShipmentError(code)),
    };
    const draft = ShipmentMother.draft();
    renderScreen(<ShipmentFormContainer />, {
      shipmentRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a shipment with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const shipmentRepository = {
      ...fakeShipmentRepository(),
      create: () => Promise.reject(new ShipmentError("shipment.duplicate")),
    };
    const draft = ShipmentMother.draft();
    renderScreen(<ShipmentFormContainer />, {
      shipmentRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A shipment with these values already exists",
    );
  });

  test("should offer every order in the selects that reference one", async () => {
    // Arrange
    const order = OrderMother.random();

    // Act
    renderScreen(<ShipmentFormContainer />, {
      shipmentRepository: fakeShipmentRepository(),
      orderRepository: fakeOrderRepository([order]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: order.id });
    expect(options).toHaveLength(1);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const shipmentRepository = {
      ...fakeShipmentRepository(),
      create: () =>
        Promise.reject(new ShipmentError("shipment.validation_error.order_id_not_found")),
    };
    const draft = ShipmentMother.draft();
    renderScreen(<ShipmentFormContainer />, {
      shipmentRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Order does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Order");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/shipment/containers/shipment-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { toProblem } from "../../../../domain/shipment/messages";
import type { Shipment } from "../../../../domain/shipment/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { ShipmentFormView, toShipmentDraft, toShipmentForm } from "../views/shipment-form-view";

/** Creates a shipment, or edits the one with `id`. */
export function ShipmentFormContainer({ id }: { id?: string }) {
  const { shipmentRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : shipmentRepository.get(id)),
    [shipmentRepository, id],
  );
  const title = id === undefined ? "New shipment" : "Edit shipment";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ShipmentForm existing={existing.data} />}
      <Link href={id === undefined ? "/shipments" : `/shipments/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ShipmentForm({ existing }: { existing: Shipment | null }) {
  const { shipmentRepository, orderRepository } = useDependencies();
  const orders = useAsync(
    () => orderRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [orderRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toShipmentForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toShipmentDraft(values);
      const saved =
        existing === null
          ? await shipmentRepository.create(draft)
          : await shipmentRepository.update(existing.id, draft);
      navigate(`/shipments/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {orders.status === "error" && <ErrorAlert error={orders.error} />}
        <ShipmentFormView
          values={values}
          options={{
            orderId: referenceOptions(orders, (order) => order.id),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

