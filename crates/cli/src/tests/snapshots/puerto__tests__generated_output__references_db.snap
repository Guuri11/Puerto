=== web/src/presentation/features/order/views/order-form-view.tsx ===
import type { OrderProblem } from "../../../../domain/order/messages";
import type { Order, OrderDraft } from "../../../../domain/order/model";
import { type ReferenceOption, textOf, textOrNull } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface OrderFormValues {
  customerId: string;
  reviewerId: string;
  total: string;
}

/** The inputs for `order`, empty when there is none yet. */
export function toOrderForm(order: Order | null): OrderFormValues {
  if (order === null) {
    return {
      customerId: "",
      reviewerId: "",
      total: "",
    };
  }
  return {
    customerId: order.customerId,
    reviewerId: textOf(order.reviewerId),
    total: String(order.total),
  };
}

/** What each reference's select offers. */
export interface OrderFormOptions {
  customerId: ReferenceOption[];
  reviewerId: ReferenceOption[];
}

export function toOrderDraft(values: OrderFormValues): OrderDraft {
  return {
    customerId: values.customerId,
    reviewerId: textOrNull(values.reviewerId),
    total: Number(values.total),
  };
}

export function OrderFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: OrderFormValues;
  options: OrderFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: OrderProblem | null;
  onChange: (values: OrderFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Customer</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "customerId"}
          required
          value={values.customerId}
          onChange={(event) => onChange({ ...values, customerId: event.target.value })}
        >
          <option value="">Choose a customer</option>
          {options.customerId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="customerId" />
      <label className="fieldset">
        <span className="fieldset-legend">Reviewer</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "reviewerId"}
          value={values.reviewerId}
          onChange={(event) => onChange({ ...values, reviewerId: event.target.value })}
        >
          <option value="">None</option>
          {options.reviewerId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="reviewerId" />
      <label className="fieldset">
        <span className="fieldset-legend">Total</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "total"}
          required
          value={values.total}
          onChange={(event) => onChange({ ...values, total: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="total" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

