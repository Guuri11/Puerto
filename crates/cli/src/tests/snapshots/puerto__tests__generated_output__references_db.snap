use async_trait::async_trait;
use dominio_cliente::modelo::IdCliente;
use dominio_envio::errores::ErrorEnvio;
use dominio_envio::modelo::{Envio, PropsEnvio};
use dominio_envio::repositorio::RepositorioEnvio;
use dominio_pedido::modelo::IdPedido;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearEnvio {
    pub pedido_id: IdPedido,
    pub destinatario_id: Option<IdCliente>,
    pub carrier: String,
}

#[async_trait]
pub trait CrearEnvio: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearEnvio) -> Result<Envio, ErrorEnvio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearEnvio {}

        #[async_trait]
        impl CrearEnvio for CrearEnvio {
            async fn ejecutar(&self, params: ParamsCrearEnvio) -> Result<Envio, ErrorEnvio>;
        }
    }
}

pub struct CrearEnvioImpl {
    pub repositorio: Arc<dyn RepositorioEnvio>,
}

#[async_trait]
impl CrearEnvio for CrearEnvioImpl {
    async fn ejecutar(&self, params: ParamsCrearEnvio) -> Result<Envio, ErrorEnvio> {
        tracing::info!("crear_envio: inicio");
        let entidad = Envio::new(PropsEnvio {
            pedido_id: params.pedido_id,
            destinatario_id: params.destinatario_id,
            carrier: params.carrier,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_envio: rechazado"))?;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "crear_envio: fallo del repositorio"))?;
        tracing::info!(id = %entidad.id, "crear_envio: fin");
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_envio::pruebas::madres::MadreEnvio;
    use dominio_envio::repositorio::dobles::MockRepositorioEnvio;
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_crear_envio_cuando_los_campos_son_validos() {
        // Preparar
        let props = MadreEnvio::new().construir_props();
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = CrearEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEnvio {
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: props.carrier,
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(
            resultado.unwrap().carrier,
            MadreEnvio::new().construir_props().carrier
        );
    }

    #[tokio::test]
    async fn deberia_devolver_duplicado_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let props = MadreEnvio::new().construir_props();
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::Duplicado));
        let caso_de_uso = CrearEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEnvio {
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: props.carrier,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "envio.duplicado");
    }

    #[tokio::test]
    async fn deberia_devolver_un_error_de_validacion_cuando_pedido_id_no_existe() {
        // Preparar: en el almacén no hay Pedido con ese id.
        let props = MadreEnvio::new().construir_props();
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::ReferenciaInexistente("pedido_id")));
        let caso_de_uso = CrearEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEnvio {
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: props.carrier,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "envio.validacion.pedido_id_no_encontrado"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_un_error_de_validacion_cuando_destinatario_id_no_existe() {
        // Preparar: en el almacén no hay Cliente con ese id.
        let props = MadreEnvio::new().construir_props();
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::ReferenciaInexistente("destinatario_id")));
        let caso_de_uso = CrearEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEnvio {
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: props.carrier,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "envio.validacion.destinatario_id_no_encontrado"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_carrier_es_una_cadena_vacia() {
        // Preparar
        let props = MadreEnvio::new().construir_props();
        let repositorio_doble = MockRepositorioEnvio::new();
        let caso_de_uso = CrearEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEnvio {
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "envio.validacion.carrier_vacio"
        );
    }
}

