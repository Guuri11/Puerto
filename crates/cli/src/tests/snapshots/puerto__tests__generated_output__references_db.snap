                .await
                .id,
            reviewer_id: None,
            total: 42,
        })
        .unwrap()
    }

    /// A stored order.
    pub(crate) async fn seed(pool: &PgPool) -> Order {
        let entity = build(pool).await;
        test_repo(pool.clone()).save(&entity).await.unwrap();
        entity
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.customer_id, entity.customer_id);
        assert_eq!(found.reviewer_id, entity.reviewer_id);
        assert_eq!(found.total, entity.total);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool)
            .find_by_id(OrderId::generate())
            .await
            .unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_entity_on_save_conflict(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        test_repo(pool.clone()).save(&entity).await.unwrap();

        // Assert
        let found = test_repo(pool).find_by_id(entity.id).await.unwrap();
        assert!(found.is_some());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_orders_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        test_repo(pool.clone()).save(&deleted).await.unwrap();

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::default(), OrderFilter::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::new(Some(2), Some(2)), OrderFilter::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_missing_customer_id(pool: PgPool) {
        // Arrange: a customer_id no row has.
        let mut entity = build(&pool).await;
        entity.customer_id = CustomerId::generate();

        // Act
        let result = test_repo(pool).save(&entity).await;

        // Assert
        assert_eq!(
            result.unwrap_err(),
            RepositoryError::MissingReference("customer_id")
        );
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_missing_reviewer_id(pool: PgPool) {
        // Arrange: a reviewer_id no row has.
        let mut entity = build(&pool).await;
        entity.reviewer_id = Some(CustomerId::generate());

        // Act
        let result = test_repo(pool).save(&entity).await;

        // Assert
        assert_eq!(
            result.unwrap_err(),
            RepositoryError::MissingReference("reviewer_id")
        );
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_only_the_orders_of_the_requested_customer_id(pool: PgPool) {
        // Arrange: one order with this customer_id, one without.
        let target = crate::customer::repository::integration_tests::seed(&pool).await;
        let mut wanted = build(&pool).await;
        wanted.customer_id = target.id;
        test_repo(pool.clone()).save(&wanted).await.unwrap();
        seed(&pool).await;

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::default(),
                OrderFilter {
                    customer_id: Some(target.id),
                    reviewer_id: None,
                },
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(
            page.items.iter().map(|row| row.id).collect::<Vec<_>>(),
            vec![wanted.id]
        );
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_only_the_orders_of_the_requested_reviewer_id(pool: PgPool) {
        // Arrange: one order with this reviewer_id, one without.
        let target = crate::customer::repository::integration_tests::seed(&pool).await;
        let mut wanted = build(&pool).await;
        wanted.reviewer_id = Some(target.id);
        test_repo(pool.clone()).save(&wanted).await.unwrap();
        seed(&pool).await;

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::default(),
                OrderFilter {
                    customer_id: None,
                    reviewer_id: Some(target.id),
                },
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(
            page.items.iter().map(|row| row.id).collect::<Vec<_>>(),
            vec![wanted.id]
        );
        assert_eq!(page.total, 1);
    }
}

