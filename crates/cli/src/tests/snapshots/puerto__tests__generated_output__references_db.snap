import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CustomerMother, fakeCustomerRepository } from "../../../../test-support/customer";
import { renderScreen } from "../../../../test-support/render";
import { CustomerDetailContainer } from "./customer-detail-container";

describe("CustomerDetailContainer", () => {
  test("should show the customer when it exists", async () => {
    // Arrange
    const seeded = CustomerMother.random();
    const customerRepository = fakeCustomerRepository([seeded]);

    // Act
    renderScreen(<CustomerDetailContainer id={seeded.id} />, { customerRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the customer does not exist", async () => {
    // Arrange
    const customerRepository = fakeCustomerRepository();

    // Act
    renderScreen(<CustomerDetailContainer id={crypto.randomUUID()} />, { customerRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("customer.not_found");
  });

  test("should delete the customer only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = CustomerMother.random();
    const fake = fakeCustomerRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<CustomerDetailContainer id={seeded.id} />, {
      customerRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/customers"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/customer/containers/customer-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { CustomerDetailView } from "../views/customer-detail-view";

export function CustomerDetailContainer({ id }: { id: string }) {
  const { customerRepository } = useDependencies();
  const customer = useAsync(() => customerRepository.get(id), [customerRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await customerRepository.remove(id);
      navigate("/customers");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Customer</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {customer.status === "loading" && <span className="loading loading-spinner" />}
      {customer.status === "error" && <ErrorAlert error={customer.error} />}
      {customer.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <CustomerDetailView customer={customer.data} />
            <div className="card-actions justify-end">
              <Link href={`/customers/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/customers" className="link">
        Back to customers
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this customer?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

