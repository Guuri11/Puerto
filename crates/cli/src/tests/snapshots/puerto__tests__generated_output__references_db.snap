    use crate::domain::shipment::{
        model::{Shipment, ShipmentId, ShipmentProps},
        repository::mocks::MockShipmentRepository,
    };

    #[tokio::test]
    async fn should_update_shipment_when_params_are_valid() {
        // Arrange
        let entity = Shipment::new(ShipmentProps {
            order_id: OrderId::generate(),
            carrier: "original".to_string(),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockShipmentRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateShipmentUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateShipmentParams {
                id: entity_id,
                order_id: OrderId::generate(),
                carrier: "updated".to_string(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().carrier, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_shipment_does_not_exist() {
        // Arrange
        let mut mock_repo = MockShipmentRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateShipmentUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateShipmentParams {
                id: ShipmentId::generate(),
                order_id: OrderId::generate(),
                carrier: "new".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "shipment.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_carrier_is_empty() {
        // Arrange
        let entity = Shipment::new(ShipmentProps {
            order_id: OrderId::generate(),
            carrier: "original".to_string(),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockShipmentRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateShipmentUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateShipmentParams {
                id: entity_id,
                order_id: OrderId::generate(),
                carrier: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shipment.validation_error.carrier_empty"
        );
    }
}

=== business/src/domain/customer/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum CustomerError {
    #[error("customer.validation_error.{0}")]
    ValidationError(String),
    #[error("customer.not_found")]
    NotFound,
    #[error("customer.duplicate")]
    Duplicate,
    #[error("customer.repository_error")]
    RepositoryError,
    #[error("customer.unknown")]
    Unknown,
    #[error("customer.invalid_name")]
    InvalidName,
}

impl From<RepositoryError> for CustomerError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = CustomerError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "customer.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = CustomerError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "customer.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = CustomerError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "customer.repository_error");
    }
}

