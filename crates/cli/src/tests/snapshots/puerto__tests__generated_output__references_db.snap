use business::domain::customer::model::Customer;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CustomerDto {
    pub id: Uuid,
    pub name: String,
    pub email: String,
}

impl CustomerDto {
    pub fn from_domain(entity: &Customer) -> Self {
        Self {
            id: entity.id.value(),
            name: entity.name.value().to_string(),
            email: entity.email.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateCustomerRequest {
    pub name: String,
    pub email: String,
}

/// One page of Customers: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CustomerPageDto {
    pub items: Vec<CustomerDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl CustomerPageDto {
    pub fn from_domain(page: &Page<Customer>) -> Self {
        Self {
            items: page.items.iter().map(CustomerDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateCustomerRequest {
    pub name: String,
    pub email: String,
}

=== presentation/src/api/customer/error_mapper.rs ===
use business::domain::customer::errors::CustomerError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::ErrorResponse;

use crate::api::error::IntoErrorResponse;

impl IntoErrorResponse for CustomerError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            CustomerError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::NotFound => StatusCode::NOT_FOUND,
            CustomerError::Duplicate => StatusCode::CONFLICT,
            CustomerError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            CustomerError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            CustomerError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            CustomerError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "customer.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = CustomerError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "customer.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = CustomerError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "customer.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = CustomerError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "customer.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = CustomerError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "customer.unknown");
    }

    #[test]
    fn should_map_invalid_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = CustomerError::InvalidName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "customer.invalid_name");
    }
}

