=== web/src/presentation/features/shipment/views/shipment-form-view.tsx ===
import type { ShipmentProblem } from "../../../../domain/shipment/messages";
import type { Shipment, ShipmentDraft } from "../../../../domain/shipment/model";
import type { ReferenceOption } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ShipmentFormValues {
  orderId: string;
  carrier: string;
}

/** The inputs for `shipment`, empty when there is none yet. */
export function toShipmentForm(shipment: Shipment | null): ShipmentFormValues {
  if (shipment === null) {
    return {
      orderId: "",
      carrier: "",
    };
  }
  return {
    orderId: shipment.orderId,
    carrier: shipment.carrier,
  };
}

/** What each reference's select offers. */
export interface ShipmentFormOptions {
  orderId: ReferenceOption[];
}

export function toShipmentDraft(values: ShipmentFormValues): ShipmentDraft {
  return {
    orderId: values.orderId,
    carrier: values.carrier,
  };
}

export function ShipmentFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: ShipmentFormValues;
  options: ShipmentFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: ShipmentProblem | null;
  onChange: (values: ShipmentFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Order</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "orderId"}
          required
          value={values.orderId}
          onChange={(event) => onChange({ ...values, orderId: event.target.value })}
        >
          <option value="">Choose an order</option>
          {options.orderId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="orderId" />
      <label className="fieldset">
        <span className="fieldset-legend">Carrier</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "carrier"}
          required
          value={values.carrier}
          onChange={(event) => onChange({ ...values, carrier: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="carrier" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

