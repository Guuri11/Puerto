import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { renderScreen } from "../../../../test-support/render";
import { fakeShipmentRepository, ShipmentMother } from "../../../../test-support/shipment";
import { ShipmentDetailContainer } from "./shipment-detail-container";

describe("ShipmentDetailContainer", () => {
  test("should show the shipment when it exists", async () => {
    // Arrange
    const seeded = ShipmentMother.random();
    const shipmentRepository = fakeShipmentRepository([seeded]);

    // Act
    renderScreen(<ShipmentDetailContainer id={seeded.id} />, { shipmentRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the order to its page", async () => {
    // Arrange
    const seeded = ShipmentMother.random();
    const shipmentRepository = fakeShipmentRepository([seeded]);

    // Act
    renderScreen(<ShipmentDetailContainer id={seeded.id} />, { shipmentRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.orderId });
    expect(link.getAttribute("href")).toBe(`/orders/${seeded.orderId}`);
  });

  test("should show the not-found code when the shipment does not exist", async () => {
    // Arrange
    const shipmentRepository = fakeShipmentRepository();

    // Act
    renderScreen(<ShipmentDetailContainer id={crypto.randomUUID()} />, { shipmentRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("shipment.not_found");
  });

  test("should delete the shipment only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ShipmentMother.random();
    const fake = fakeShipmentRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<ShipmentDetailContainer id={seeded.id} />, {
      shipmentRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/shipments"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/shipment/containers/shipment-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ShipmentDetailView } from "../views/shipment-detail-view";

export function ShipmentDetailContainer({ id }: { id: string }) {
  const { shipmentRepository } = useDependencies();
  const shipment = useAsync(() => shipmentRepository.get(id), [shipmentRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await shipmentRepository.remove(id);
      navigate("/shipments");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Shipment</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {shipment.status === "loading" && <span className="loading loading-spinner" />}
      {shipment.status === "error" && <ErrorAlert error={shipment.error} />}
      {shipment.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ShipmentDetailView shipment={shipment.data} />
            <div className="card-actions justify-end">
              <Link href={`/shipments/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/shipments" className="link">
        Back to shipments
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this shipment?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

