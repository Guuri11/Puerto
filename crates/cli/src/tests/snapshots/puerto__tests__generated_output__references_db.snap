use async_trait::async_trait;
use dominio_envio::errores::ErrorEnvio;
use dominio_envio::modelo::{Envio, IdEnvio};
use dominio_envio::repositorio::RepositorioEnvio;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerEnvio {
    pub id: IdEnvio,
}

#[async_trait]
pub trait ObtenerEnvio: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerEnvio) -> Result<Envio, ErrorEnvio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerEnvio {}

        #[async_trait]
        impl ObtenerEnvio for ObtenerEnvio {
            async fn ejecutar(&self, params: ParamsObtenerEnvio) -> Result<Envio, ErrorEnvio>;
        }
    }
}

pub struct ObtenerEnvioImpl {
    pub repositorio: Arc<dyn RepositorioEnvio>,
}

#[async_trait]
impl ObtenerEnvio for ObtenerEnvioImpl {
    async fn ejecutar(&self, params: ParamsObtenerEnvio) -> Result<Envio, ErrorEnvio> {
        tracing::info!(id = %params.id, "obtener_envio: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "obtener_envio: fallo del repositorio"))?;
        resultado.ok_or_else(|| {
            let err = ErrorEnvio::NoEncontrado;
            tracing::warn!(error = %err, "obtener_envio: rechazado");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_envio::{
        modelo::IdEnvio, pruebas::madres::MadreEnvio, repositorio::dobles::MockRepositorioEnvio,
    };
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_devolver_envio_cuando_el_id_existe() {
        let entidad = MadreEnvio::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ObtenerEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerEnvio { id: id_entidad })
            .await;

        assert_eq!(resultado.unwrap().id, id_entidad);
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_el_id_no_existe() {
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ObtenerEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerEnvio {
                id: IdEnvio::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "envio.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_el_almacen_no_esta_disponible() {
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Err(ErrorRepositorio::NoDisponible));
        let caso_de_uso = ObtenerEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerEnvio {
                id: IdEnvio::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "envio.repositorio");
    }
}

