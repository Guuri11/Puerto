import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Envio } from "../../../../domain/envio/model";
import { ClienteMother, fakeClienteRepository } from "../../../../test-support/cliente";
import { EnvioMother, fakeEnvioRepository } from "../../../../test-support/envio";
import { fakePedidoRepository, PedidoMother } from "../../../../test-support/pedido";
import { renderScreen } from "../../../../test-support/render";
import { EnvioDetailContainer } from "./envio-detail-container";

/** The repositories the reference links load from, holding what `seeded` references. */
function referencedBy(seeded: Envio) {
  return {
    pedidoRepository: fakePedidoRepository([PedidoMother.random({ id: seeded.pedidoId })]),
    clienteRepository: fakeClienteRepository([
      ClienteMother.random({ id: seeded.destinatarioId ?? crypto.randomUUID() }),
    ]),
  };
}

describe("EnvioDetailContainer", () => {
  test("should show the envio when it exists", async () => {
    // Arrange
    const seeded = EnvioMother.random();
    const envioRepository = fakeEnvioRepository([seeded]);

    // Act
    renderScreen(<EnvioDetailContainer id={seeded.id} />, {
      envioRepository,
      ...referencedBy(seeded),
    });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the pedido to its page, named by its label", async () => {
    // Arrange
    const seeded = EnvioMother.random();
    const envioRepository = fakeEnvioRepository([seeded]);
    const referenced = referencedBy(seeded);
    const target = await referenced.pedidoRepository.get(seeded.pedidoId);

    // Act
    renderScreen(<EnvioDetailContainer id={seeded.id} />, {
      envioRepository,
      ...referenced,
    });

    // Assert: by its href — two references to one target may share a label.
    const selector = `a[href="/pedidos/${seeded.pedidoId}"]`;
    expect(await screen.findByText(target.id, { selector })).toBeTruthy();
  });

  test("should link the destinatario to its page, named by its label", async () => {
    // Arrange
    const seeded = EnvioMother.random();
    const envioRepository = fakeEnvioRepository([seeded]);
    const referenced = referencedBy(seeded);
    const target = await referenced.clienteRepository.get(seeded.destinatarioId ?? "");

    // Act
    renderScreen(<EnvioDetailContainer id={seeded.id} />, {
      envioRepository,
      ...referenced,
    });

    // Assert: by its href — two references to one target may share a label.
    const selector = `a[href="/clientes/${seeded.destinatarioId}"]`;
    expect(await screen.findByText(target.name, { selector })).toBeTruthy();
  });

  test("should show the not-found code when the envio does not exist", async () => {
    // Arrange
    const envioRepository = fakeEnvioRepository();

    // Act
    renderScreen(<EnvioDetailContainer id={crypto.randomUUID()} />, {
      envioRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("envio.no_encontrado");
  });

  test("should delete the envio only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = EnvioMother.random();
    const fake = fakeEnvioRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<EnvioDetailContainer id={seeded.id} />, {
      envioRepository: { ...fake, remove },
      ...referencedBy(seeded),
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/envios"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/envio/containers/envio-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { EnvioDetailView } from "../views/envio-detail-view";

export function EnvioDetailContainer({ id }: { id: string }) {
  const { envioRepository } = useDependencies();
  const envio = useAsync(() => envioRepository.get(id), [envioRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await envioRepository.remove(id);
      navigate("/envios");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Envio</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {envio.status === "loading" && <span className="loading loading-spinner" />}
      {envio.status === "error" && <ErrorAlert error={envio.error} />}
      {envio.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <EnvioDetailView envio={envio.data} />
            <div className="card-actions justify-end">
              <Link href={`/envios/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/envios" className="link">
        Back to envios
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this envio?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

