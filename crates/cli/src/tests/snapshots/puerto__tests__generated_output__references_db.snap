use business::application::customer::get_customer::GetCustomerUseCaseImpl;
use business::application::customer::list_customers::ListCustomersUseCaseImpl;
use business::application::customer::update_customer::UpdateCustomerUseCaseImpl;
use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;
use business::application::order::create_order::CreateOrderUseCaseImpl;
use business::application::order::delete_order::DeleteOrderUseCaseImpl;
use business::application::order::get_order::GetOrderUseCaseImpl;
use business::application::order::list_orders::ListOrdersUseCaseImpl;
use business::application::order::update_order::UpdateOrderUseCaseImpl;
use business::application::shipment::create_shipment::CreateShipmentUseCaseImpl;
use business::application::shipment::delete_shipment::DeleteShipmentUseCaseImpl;
use business::application::shipment::get_shipment::GetShipmentUseCaseImpl;
use business::application::shipment::list_shipments::ListShipmentsUseCaseImpl;
use business::application::shipment::update_shipment::UpdateShipmentUseCaseImpl;

use business::domain::customer::repository::CustomerRepositoryTrait;
use business::domain::greeting::repository::GreetingRepositoryTrait;
use business::domain::order::repository::OrderRepositoryTrait;
use business::domain::shipment::repository::ShipmentRepositoryTrait;
use infrastructure::customer::repository::PgCustomerRepository;
use infrastructure::greeting::repository::InMemoryGreetingRepository;
use infrastructure::order::repository::PgOrderRepository;
use infrastructure::shipment::repository::PgShipmentRepository;

use poem::Endpoint;
use poem_openapi::OpenApiService;

use crate::api::customer::routes::CustomerApi;
use crate::api::greeting::routes::GreetingApi;
use crate::api::order::routes::OrderApi;
use crate::api::shipment::routes::ShipmentApi;

/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL is not set — set it in .env (.env.example has one)".to_string()
    })?;
    let pool = infrastructure::db::create_postgres_pool(&database_url)
        .await
        .map_err(|e| format!("{e} — is the database up? `make docker-compose/up`"))?;
    infrastructure::db::run_migrations(&pool, &infrastructure::db::MIGRATOR)
        .await
        .map_err(|e| e.to_string())?;

    let get_greeting = Arc::new(GetGreetingUseCaseImpl {
        repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait>,
    });
    let greeting_api = GreetingApi { get_greeting };

    let customer_repo: Arc<dyn CustomerRepositoryTrait> =
        Arc::new(PgCustomerRepository::new(pool.clone()));
    let create_customer = Arc::new(CreateCustomerUseCaseImpl {
        repository: Arc::clone(&customer_repo),
    });
    let get_customer = Arc::new(GetCustomerUseCaseImpl {
        repository: Arc::clone(&customer_repo),
    });
    let list_customers = Arc::new(ListCustomersUseCaseImpl {
        repository: Arc::clone(&customer_repo),
    });
    let update_customer = Arc::new(UpdateCustomerUseCaseImpl {
        repository: Arc::clone(&customer_repo),
    });
    let delete_customer = Arc::new(DeleteCustomerUseCaseImpl {
        repository: customer_repo,
    });
    let customer_api = CustomerApi {
        create_customer,
        get_customer,
        list_customers,
        update_customer,
        delete_customer,
    };

    let order_repo: Arc<dyn OrderRepositoryTrait> = Arc::new(PgOrderRepository::new(pool.clone()));
    let create_order = Arc::new(CreateOrderUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let get_order = Arc::new(GetOrderUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let list_orders = Arc::new(ListOrdersUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let update_order = Arc::new(UpdateOrderUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let delete_order = Arc::new(DeleteOrderUseCaseImpl {
        repository: order_repo,
    });
    let order_api = OrderApi {
        create_order,
        get_order,
        list_orders,
        update_order,
        delete_order,
    };

    let shipment_repo: Arc<dyn ShipmentRepositoryTrait> =
        Arc::new(PgShipmentRepository::new(pool.clone()));
    let create_shipment = Arc::new(CreateShipmentUseCaseImpl {
        repository: Arc::clone(&shipment_repo),
    });
    let get_shipment = Arc::new(GetShipmentUseCaseImpl {
        repository: Arc::clone(&shipment_repo),
    });
    let list_shipments = Arc::new(ListShipmentsUseCaseImpl {
        repository: Arc::clone(&shipment_repo),
    });
    let update_shipment = Arc::new(UpdateShipmentUseCaseImpl {
        repository: Arc::clone(&shipment_repo),
    });
    let delete_shipment = Arc::new(DeleteShipmentUseCaseImpl {
        repository: shipment_repo,
    });
    let shipment_api = ShipmentApi {
        create_shipment,
        get_shipment,
        list_shipments,
        update_shipment,
        delete_shipment,
    };

    let ready = puerto_web::health::probe(move || {
        let pool = pool.clone();
        async move { infrastructure::db::ping(&pool).await }
    });

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::routes(
        openapi_service((greeting_api, customer_api, order_api, shipment_api)),
        &config,
        ready,
    )))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;

    use business::domain::customer::use_cases::create_customer::mocks::MockCreateCustomerUseCase;
    use business::domain::customer::use_cases::delete_customer::mocks::MockDeleteCustomerUseCase;
    use business::domain::customer::use_cases::get_customer::mocks::MockGetCustomerUseCase;
    use business::domain::customer::use_cases::list_customers::mocks::MockListCustomersUseCase;
    use business::domain::customer::use_cases::update_customer::mocks::MockUpdateCustomerUseCase;
    use business::domain::greeting::use_cases::get_greeting::mocks::MockGetGreetingUseCase;
    use business::domain::order::use_cases::create_order::mocks::MockCreateOrderUseCase;
    use business::domain::order::use_cases::delete_order::mocks::MockDeleteOrderUseCase;
    use business::domain::order::use_cases::get_order::mocks::MockGetOrderUseCase;
    use business::domain::order::use_cases::list_orders::mocks::MockListOrdersUseCase;
    use business::domain::order::use_cases::update_order::mocks::MockUpdateOrderUseCase;
    use business::domain::shipment::use_cases::create_shipment::mocks::MockCreateShipmentUseCase;
    use business::domain::shipment::use_cases::delete_shipment::mocks::MockDeleteShipmentUseCase;
    use business::domain::shipment::use_cases::get_shipment::mocks::MockGetShipmentUseCase;
    use business::domain::shipment::use_cases::list_shipments::mocks::MockListShipmentsUseCase;
    use business::domain::shipment::use_cases::update_shipment::mocks::MockUpdateShipmentUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let greeting_api = GreetingApi {
            get_greeting: Arc::new(MockGetGreetingUseCase::new()),
        };
        let customer_api = CustomerApi {
            create_customer: Arc::new(MockCreateCustomerUseCase::new()),
            get_customer: Arc::new(MockGetCustomerUseCase::new()),
            list_customers: Arc::new(MockListCustomersUseCase::new()),
            update_customer: Arc::new(MockUpdateCustomerUseCase::new()),
            delete_customer: Arc::new(MockDeleteCustomerUseCase::new()),
        };
        let order_api = OrderApi {
            create_order: Arc::new(MockCreateOrderUseCase::new()),
            get_order: Arc::new(MockGetOrderUseCase::new()),
            list_orders: Arc::new(MockListOrdersUseCase::new()),
            update_order: Arc::new(MockUpdateOrderUseCase::new()),
            delete_order: Arc::new(MockDeleteOrderUseCase::new()),
        };
        let shipment_api = ShipmentApi {
            create_shipment: Arc::new(MockCreateShipmentUseCase::new()),
            get_shipment: Arc::new(MockGetShipmentUseCase::new()),
            list_shipments: Arc::new(MockListShipmentsUseCase::new()),
            update_shipment: Arc::new(MockUpdateShipmentUseCase::new()),
            delete_shipment: Arc::new(MockDeleteShipmentUseCase::new()),
        };
        let spec = openapi_service((greeting_api, customer_api, order_api, shipment_api)).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

