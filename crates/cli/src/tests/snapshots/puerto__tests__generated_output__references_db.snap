  });

  test("should show the error code when the shipments cannot be listed", async () => {
    // Arrange
    const shipmentRepository = {
      ...fakeShipmentRepository(),
      list: () => Promise.reject(new ShipmentError("shipment.repository_error")),
    };

    // Act
    renderScreen(<ShipmentListContainer />, { shipmentRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("shipment.repository_error");
  });
});

=== web/src/presentation/features/shipment/containers/shipment-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { ShipmentListView } from "../views/shipment-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function ShipmentListContainer() {
  const { shipmentRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const shipments = useAsync(
    () => shipmentRepository.list({ limit: PAGE_SIZE, offset }),
    [shipmentRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Shipments</h1>
        <Link href="/shipments/new" className="btn btn-primary">
          New shipment
        </Link>
      </div>
      {shipments.status === "loading" && <span className="loading loading-spinner" />}
      {shipments.status === "error" && <ErrorAlert error={shipments.error} />}
      {shipments.status === "ok" &&
        (shipments.data.total === 0 ? (
          <EmptyState message="No shipments yet." />
        ) : (
          <>
            <ShipmentListView shipments={shipments.data.items} />
            <Pagination {...shipments.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

