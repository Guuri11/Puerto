    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => PedidoMother.random());
    const pedidoRepository = fakePedidoRepository(seed);
    const path = "/pedidos?page=2";

    // Act
    renderScreen(<PedidoListContainer />, { pedidoRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no pedido", async () => {
    // Arrange
    const pedidoRepository = fakePedidoRepository();

    // Act
    renderScreen(<PedidoListContainer />, { pedidoRepository });

    // Assert
    expect(await screen.findByText("No pedidos yet.")).toBeTruthy();
  });

  test("should show the error code when the pedidos cannot be listed", async () => {
    // Arrange
    const pedidoRepository = {
      ...fakePedidoRepository(),
      list: () => Promise.reject(new PedidoError("pedido.repositorio")),
    };

    // Act
    renderScreen(<PedidoListContainer />, { pedidoRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("pedido.repositorio");
  });
});

=== web/src/presentation/features/pedido/containers/pedido-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { PedidoListView } from "../views/pedido-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function PedidoListContainer() {
  const { pedidoRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const pedidos = useAsync(
    () => pedidoRepository.list({ limit: PAGE_SIZE, offset }),
    [pedidoRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Pedidos</h1>
        <Link href="/pedidos/new" className="btn btn-primary">
          New pedido
        </Link>
      </div>
      {pedidos.status === "loading" && <span className="loading loading-spinner" />}
      {pedidos.status === "error" && <ErrorAlert error={pedidos.error} />}
      {pedidos.status === "ok" &&
        (pedidos.data.total === 0 ? (
          <EmptyState message="No pedidos yet." />
        ) : (
          <>
            <PedidoListView pedidos={pedidos.data.items} />
            <Pagination {...pedidos.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

