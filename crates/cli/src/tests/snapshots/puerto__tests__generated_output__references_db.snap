import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakeOrderRepository, OrderMother } from "../../../../test-support/order";
import { renderScreen } from "../../../../test-support/render";
import { OrderDetailContainer } from "./order-detail-container";

describe("OrderDetailContainer", () => {
  test("should show the order when it exists", async () => {
    // Arrange
    const seeded = OrderMother.random();
    const orderRepository = fakeOrderRepository([seeded]);

    // Act
    renderScreen(<OrderDetailContainer id={seeded.id} />, { orderRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the customer to its page", async () => {
    // Arrange
    const seeded = OrderMother.random();
    const orderRepository = fakeOrderRepository([seeded]);

    // Act
    renderScreen(<OrderDetailContainer id={seeded.id} />, { orderRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.customerId });
    expect(link.getAttribute("href")).toBe(`/customers/${seeded.customerId}`);
  });

  test("should link the reviewer to its page", async () => {
    // Arrange
    const seeded = OrderMother.random();
    const orderRepository = fakeOrderRepository([seeded]);

    // Act
    renderScreen(<OrderDetailContainer id={seeded.id} />, { orderRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.reviewerId ?? "" });
    expect(link.getAttribute("href")).toBe(`/customers/${seeded.reviewerId}`);
  });

  test("should show the not-found code when the order does not exist", async () => {
    // Arrange
    const orderRepository = fakeOrderRepository();

    // Act
    renderScreen(<OrderDetailContainer id={crypto.randomUUID()} />, { orderRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("order.not_found");
  });

  test("should delete the order only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = OrderMother.random();
    const fake = fakeOrderRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<OrderDetailContainer id={seeded.id} />, {
      orderRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/orders"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/order/containers/order-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { OrderDetailView } from "../views/order-detail-view";

export function OrderDetailContainer({ id }: { id: string }) {
  const { orderRepository } = useDependencies();
  const order = useAsync(() => orderRepository.get(id), [orderRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await orderRepository.remove(id);
      navigate("/orders");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Order</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {order.status === "loading" && <span className="loading loading-spinner" />}
      {order.status === "error" && <ErrorAlert error={order.error} />}
      {order.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <OrderDetailView order={order.data} />
            <div className="card-actions justify-end">
              <Link href={`/orders/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/orders" className="link">
        Back to orders
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this order?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/order/containers/order-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { OrderError } from "../../../../domain/order/errors";
import type { OrderDraft } from "../../../../domain/order/model";
import { CustomerMother, fakeCustomerRepository } from "../../../../test-support/customer";
import { fakeOrderRepository, OrderMother } from "../../../../test-support/order";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { OrderFormContainer } from "./order-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: OrderDraft) {
  return {
    customerRepository: fakeCustomerRepository([
      CustomerMother.random({ id: draft.customerId }),
      CustomerMother.random({ id: draft.reviewerId ?? crypto.randomUUID() }),
    ]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: OrderDraft) {
  await screen.findByText("Save");
  await choose("Customer", draft.customerId);
  await choose("Reviewer", textOf(draft.reviewerId));
  type("Total", String(draft.total));
}

describe("OrderFormContainer", () => {
  test("should create the order from what was typed and show it", async () => {
    // Arrange
    const draft = OrderMother.draft();
    const orderRepository = fakeOrderRepository();
    const { history } = renderScreen(<OrderFormContainer />, {
      orderRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/orders/"));
    const {
      items: [created],
    } = await orderRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/orders/${created?.id}`);
  });

  test("should save the edited order when an existing one is submitted", async () => {
    // Arrange
    const seeded = OrderMother.random();
    const orderRepository = fakeOrderRepository([seeded]);
    const { history } = renderScreen(<OrderFormContainer id={seeded.id} />, {
      orderRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/orders/${seeded.id}`));
    expect(await orderRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "order.validation_error.invalid";
    const orderRepository = {
      ...fakeOrderRepository(),
      create: () => Promise.reject(new OrderError(code)),
    };
    const draft = OrderMother.draft();
    renderScreen(<OrderFormContainer />, {
      orderRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a order with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const orderRepository = {
      ...fakeOrderRepository(),
      create: () => Promise.reject(new OrderError("order.duplicate")),
    };
    const draft = OrderMother.draft();
    renderScreen(<OrderFormContainer />, {
      orderRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An order with these values already exists",
    );
  });

  test("should offer every customer in the selects that reference one", async () => {
    // Arrange
    const customer = CustomerMother.random();

    // Act
    renderScreen(<OrderFormContainer />, {
      orderRepository: fakeOrderRepository(),
      customerRepository: fakeCustomerRepository([customer]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: customer.name });
    expect(options).toHaveLength(2);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const orderRepository = {
      ...fakeOrderRepository(),
      create: () => Promise.reject(new OrderError("order.validation_error.customer_id_not_found")),
    };
    const draft = OrderMother.draft();
    renderScreen(<OrderFormContainer />, {
      orderRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Customer does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Customer");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/order/containers/order-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/order/messages";
import type { Order } from "../../../../domain/order/model";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { OrderFormView, toOrderDraft, toOrderForm } from "../views/order-form-view";

/** Creates an order, or edits the one with `id`. */
export function OrderFormContainer({ id }: { id?: string }) {
  const { orderRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : orderRepository.get(id)),
    [orderRepository, id],
  );
  const title = id === undefined ? "New order" : "Edit order";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <OrderForm existing={existing.data} />}
      <Link href={id === undefined ? "/orders" : `/orders/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function OrderForm({ existing }: { existing: Order | null }) {
  const { orderRepository, customerRepository } = useDependencies();
  const customers = useAsync(
    () => customerRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [customerRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toOrderForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toOrderDraft(values);
      const saved =
        existing === null
          ? await orderRepository.create(draft)
          : await orderRepository.update(existing.id, draft);
      navigate(`/orders/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {customers.status === "error" && <ErrorAlert error={customers.error} />}
        <OrderFormView
          values={values}
          options={{
            customerId: referenceOptions(customers, (customer) => customer.name),
            reviewerId: referenceOptions(customers, (customer) => customer.name),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

