=== contextos/pedido/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad pedido válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_pedido::modelo::Pedido;
use dominio_pedido::modelo::PropsPedido;
use dominio_pedido::pruebas::madres::MadrePedido;
use dominio_pedido::repositorio::RepositorioPedido;
use sqlx::PgPool;

use crate::repositorio::RepositorioPedidoPostgres;

/// Una entidad pedido válida, sin guardar, con los valores de la madre salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada).
pub async fn construir(pool: &PgPool) -> Pedido {
    Pedido::new(PropsPedido {
        cliente_id: infra_cliente::pruebas::siembra::sembrar(pool).await.id,
        ..MadrePedido::new().construir_props()
    })
    .unwrap()
}

/// Una entidad pedido guardada.
pub async fn sembrar(pool: &PgPool) -> Pedido {
    let entidad = construir(pool).await;
    RepositorioPedidoPostgres::new(pool.clone())
        .guardar(&entidad)
        .await
        .unwrap();
    entidad
}

=== contextos/pedido/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_pedido::{
    modelo::{IdPedido, Pedido},
    repositorio::{FiltroPedido, RepositorioPedido},
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::{ClaveForanea, mapear_error_sqlx, mapear_error_sqlx_con};

use crate::fila::FilaPedido;

pub struct RepositorioPedidoPostgres {
    pub pool: PgPool,
}

impl RepositorioPedidoPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Las claves foráneas por las que pasa una escritura (ADR-0022 de Puerto): la base de datos
/// rechaza una referencia a una fila que no existe, y quien llama recibe como error el campo que la
/// nombra.
const REFERENCES: &[ClaveForanea] = &[
    ClaveForanea {
        restriccion: "pedidos_cliente_id_fkey",
        campo: "cliente_id",
    },
    ClaveForanea {
        restriccion: "pedidos_reviewer_id_fkey",
        campo: "reviewer_id",
    },
];

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaPedido) -> Result<Pedido, ErrorRepositorio> {
    Pedido::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad pedido válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioPedido for RepositorioPedidoPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroPedido,
    ) -> Result<Pagina<Pedido>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        // Una sola consulta estática sea cual sea el filtro: un id sin valor es NULL y casa con
        // todas las filas.
        let cliente_id = filtro.cliente_id.map(|id| id.valor());
        let reviewer_id = filtro.reviewer_id.map(|id| id.valor());
        let filas = sqlx::query_as!(
            FilaPedido,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, cliente_id, reviewer_id, total
             FROM pedidos WHERE borrado = false AND ($3::uuid IS NULL OR cliente_id = $3) AND ($4::uuid IS NULL OR reviewer_id = $4)
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento()),
            cliente_id,
            reviewer_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM pedidos WHERE borrado = false AND ($1::uuid IS NULL OR cliente_id = $1) AND ($2::uuid IS NULL OR reviewer_id = $2)"#,
            cliente_id,
            reviewer_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdPedido) -> Result<Option<Pedido>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaPedido,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, cliente_id, reviewer_id, total
             FROM pedidos WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }

    async fn guardar(&self, entidad: &Pedido) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaPedido::from(entidad);
        sqlx::query!(
            "INSERT INTO pedidos (id, creado_en, actualizado_en, borrado, borrado_en, cliente_id, reviewer_id, total)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, cliente_id = $6, reviewer_id = $7, total = $8",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.cliente_id,
            db.reviewer_id,
            db.total,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx_con(&e, REFERENCES)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::{construir, sembrar};
    use dominio_cliente::modelo::IdCliente;

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioPedidoPostgres {
        RepositorioPedidoPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.cliente_id, entidad.cliente_id);
        assert_eq!(encontrado.reviewer_id, entidad.reviewer_id);
        assert_eq!(encontrado.total, entidad.total);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdPedido::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_la_entidad_al_guardar_un_id_existente(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        repositorio_de_prueba(pool.clone())
            .guardar(&entidad)
            .await
            .unwrap();

        // Comprobar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap();
        assert!(encontrado.is_some());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_pedidos_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        repositorio_de_prueba(pool.clone())
            .guardar(&borrado)
            .await
            .unwrap();

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default(), FiltroPedido::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::new(Some(2), Some(2)),
                FiltroPedido::default(),
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_cliente_id_inexistente(pool: PgPool) {
        // Preparar: un valor de cliente_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.cliente_id = IdCliente::generar();

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("cliente_id")
        );
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_reviewer_id_inexistente(pool: PgPool) {
        // Preparar: un valor de reviewer_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.reviewer_id = Some(IdCliente::generar());

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("reviewer_id")
        );
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_pedidos_con_ese_valor_de_cliente_id(pool: PgPool) {
        // Preparar: una entidad pedido con este valor de cliente_id y otra sin él.
        let destino = infra_cliente::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.cliente_id = destino.id;
        repositorio_de_prueba(pool.clone())
            .guardar(&esperado)
            .await
            .unwrap();
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroPedido {
                    cliente_id: Some(destino.id),
                    reviewer_id: None,
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_pedidos_con_ese_valor_de_reviewer_id(pool: PgPool) {
        // Preparar: una entidad pedido con este valor de reviewer_id y otra sin él.
        let destino = infra_cliente::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.reviewer_id = Some(destino.id);
        repositorio_de_prueba(pool.clone())
            .guardar(&esperado)
            .await
            .unwrap();
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroPedido {
                    cliente_id: None,
                    reviewer_id: Some(destino.id),
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }
}

