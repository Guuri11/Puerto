        );
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = ShipmentError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "shipment.repository_error");
    }
}

=== business/src/domain/shipment/model.rs ===
use crate::domain::order::model::OrderId;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::ShipmentError;

/// The id of every `Shipment`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ShipmentId(Uuid);

impl ShipmentId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for ShipmentId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct ShipmentProps {
    pub order_id: OrderId,
    pub carrier: String,
}

#[derive(Debug, Clone)]
pub struct Shipment {
    pub id: ShipmentId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub order_id: OrderId,
    pub carrier: String,
}

impl Shipment {
    pub fn new(props: ShipmentProps) -> Result<Self, ShipmentError> {
        if props.carrier.trim().is_empty() {
            return Err(ShipmentError::ValidationError("carrier_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: ShipmentId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            order_id: props.order_id,
            carrier: props.carrier,
        })
    }

    pub fn from_repository(data: Shipment) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_shipment_when_fields_are_valid() {
        let result = Shipment::new(ShipmentProps {
            order_id: OrderId::generate(),
            carrier: "example".to_string(),
        });
        assert_eq!(result.unwrap().carrier, "example");
    }

    #[test]
    fn should_reject_shipment_when_carrier_is_empty() {
        let result = Shipment::new(ShipmentProps {
            order_id: OrderId::generate(),
            carrier: "".into(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shipment.validation_error.carrier_empty"
        );
    }

    #[test]
    fn should_reject_shipment_when_carrier_is_only_whitespace() {
        let result = Shipment::new(ShipmentProps {
            order_id: OrderId::generate(),
            carrier: "   ".into(),
        });
        assert!(result.is_err());
    }
}

