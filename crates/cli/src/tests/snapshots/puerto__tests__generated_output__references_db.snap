use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::shipment::{
    model::{Shipment, ShipmentId},
    repository::{ShipmentFilter, ShipmentRepositoryTrait},
};
use puerto_core::{Page, PageRequest, RepositoryError};

use super::entity::ShipmentDb;
use crate::db::{ForeignKey, map_sqlx_error, map_sqlx_error_with};

pub struct PgShipmentRepository {
    pub pool: PgPool,
}

impl PgShipmentRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// The foreign keys a write goes through (ADR-0022 of Puerto): the database rejects a reference to
/// a row that does not exist, and the field it names is the caller's error.
const REFERENCES: &[ForeignKey] = &[ForeignKey {
    constraint: "shipments_order_id_fkey",
    field: "order_id",
}];

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: ShipmentDb) -> Result<Shipment, RepositoryError> {
    Shipment::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid shipment");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl ShipmentRepositoryTrait for PgShipmentRepository {
    async fn find_all(
        &self,
        page: PageRequest,
        filter: ShipmentFilter,
    ) -> Result<Page<Shipment>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        // One static query whatever the filter: an unset id is NULL and matches every row.
        let order_id = filter.order_id.map(|id| id.value());
        let rows = sqlx::query_as!(
            ShipmentDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, order_id, carrier
             FROM shipments WHERE deleted = false AND ($3::uuid IS NULL OR order_id = $3)
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limit()),
            i64::from(page.offset()),
            order_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM shipments WHERE deleted = false AND ($1::uuid IS NULL OR order_id = $1)"#,
            order_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            map_sqlx_error(&e)
        })?;

        let items = rows
            .into_iter()
            .map(to_domain)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: ShipmentId) -> Result<Option<Shipment>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            ShipmentDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, order_id, carrier
             FROM shipments WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }

    async fn save(&self, entity: &Shipment) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = ShipmentDb::from(entity);
        sqlx::query!(
            "INSERT INTO shipments (id, created_at, updated_at, deleted, deleted_at, order_id, carrier)
             VALUES ($1, $2, $3, $4, $5, $6, $7)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, order_id = $6, carrier = $7",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.order_id,
            db.carrier,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error_with(&e, REFERENCES)
        })?;
        Ok(())
    }
}

