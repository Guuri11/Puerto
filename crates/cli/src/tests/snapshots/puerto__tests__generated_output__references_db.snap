use std::sync::Arc;

use business::domain::order::model::OrderId;
use business::domain::shipment::model::ShipmentId;
use business::domain::shipment::use_cases::{
    create_shipment::{CreateShipmentParams, CreateShipmentUseCaseTrait},
    delete_shipment::{DeleteShipmentParams, DeleteShipmentUseCaseTrait},
    get_shipment::{GetShipmentParams, GetShipmentUseCaseTrait},
    list_shipments::{ListShipmentsParams, ListShipmentsUseCaseTrait},
    update_shipment::{UpdateShipmentParams, UpdateShipmentUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::shipment::dto::{
    CreateShipmentRequest, ShipmentDto, ShipmentPageDto, UpdateShipmentRequest,
};
use crate::api::shipment::responses::{
    CreateShipmentResponse, DeleteShipmentResponse, GetShipmentResponse, ListShipmentsResponse,
    UpdateShipmentResponse,
};
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct ShipmentApi {
    pub create_shipment: Arc<dyn CreateShipmentUseCaseTrait>,
    pub get_shipment: Arc<dyn GetShipmentUseCaseTrait>,
    pub list_shipments: Arc<dyn ListShipmentsUseCaseTrait>,
    pub update_shipment: Arc<dyn UpdateShipmentUseCaseTrait>,
    pub delete_shipment: Arc<dyn DeleteShipmentUseCaseTrait>,
}

#[OpenApi]
impl ShipmentApi {
    /// Create a new Shipment
    #[oai(path = "/shipments", method = "post", tag = "ApiTags::Shipment")]
    async fn create(&self, body: Json<CreateShipmentRequest>) -> CreateShipmentResponse {
        match self
            .create_shipment
            .execute(CreateShipmentParams {
                order_id: OrderId::from_uuid(body.order_id),
                carrier: body.carrier.clone(),
            })
            .await
        {
            Ok(entity) => CreateShipmentResponse::Created(Json(ShipmentDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_shipment failed");
                CreateShipmentResponse::from_status(status, error)
            }
        }
    }

    /// Get a Shipment by ID
    #[oai(path = "/shipments/:id", method = "get", tag = "ApiTags::Shipment")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetShipmentResponse {
        match self
            .get_shipment
            .execute(GetShipmentParams {
                id: ShipmentId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetShipmentResponse::Ok(Json(ShipmentDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_shipment failed");
                GetShipmentResponse::from_status(status, error)
            }
        }
    }

    /// List Shipments, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/shipments", method = "get", tag = "ApiTags::Shipment")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
        #[oai(name = "orderId")] order_id: Query<Option<Uuid>>,
    ) -> ListShipmentsResponse {
        match self
            .list_shipments
            .execute(ListShipmentsParams {
                page: PageRequest::new(limit.0, offset.0),
                order_id: order_id.0.map(OrderId::from_uuid),
            })
            .await
        {
            Ok(page) => ListShipmentsResponse::Ok(Json(ShipmentPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_shipments failed");
                ListShipmentsResponse::from_status(status, error)
            }
        }
    }

    /// Update a Shipment
    #[oai(path = "/shipments/:id", method = "put", tag = "ApiTags::Shipment")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdateShipmentRequest>,
    ) -> UpdateShipmentResponse {
        match self
            .update_shipment
            .execute(UpdateShipmentParams {
                id: ShipmentId::from_uuid(id.0),
                order_id: OrderId::from_uuid(body.order_id),
                carrier: body.carrier.clone(),
            })
            .await
        {
            Ok(entity) => UpdateShipmentResponse::Ok(Json(ShipmentDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_shipment failed");
                UpdateShipmentResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Shipment
    #[oai(path = "/shipments/:id", method = "delete", tag = "ApiTags::Shipment")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteShipmentResponse {
        match self
            .delete_shipment
            .execute(DeleteShipmentParams {
                id: ShipmentId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteShipmentResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_shipment failed");
                DeleteShipmentResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::shipment::errors::ShipmentError;
    use business::domain::shipment::use_cases::{
        create_shipment::mocks::MockCreateShipmentUseCase,
        delete_shipment::mocks::MockDeleteShipmentUseCase,
        get_shipment::mocks::MockGetShipmentUseCase,
        list_shipments::mocks::MockListShipmentsUseCase,
        update_shipment::mocks::MockUpdateShipmentUseCase,
    };
    use business::tests::mothers::shipment_mother::ShipmentMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateShipmentUseCase,
        get: MockGetShipmentUseCase,
        list: MockListShipmentsUseCase,
        update: MockUpdateShipmentUseCase,
        delete: MockDeleteShipmentUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = ShipmentApi {
                create_shipment: Arc::new(self.create),
                get_shipment: Arc::new(self.get),
                list_shipments: Arc::new(self.list),
                update_shipment: Arc::new(self.update),
                delete_shipment: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateShipmentRequest {
        CreateShipmentRequest {
            order_id: Uuid::new_v4(),
            carrier: "example".to_string(),
        }
    }

    fn update_request() -> UpdateShipmentRequest {
        UpdateShipmentRequest {
            order_id: Uuid::new_v4(),
            carrier: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/shipments/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_shipment_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(ShipmentMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/shipments")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_shipment_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(ShipmentError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/shipments")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_422_when_a_referenced_order_id_does_not_exist() {
        // Arrange: the database found no Order with that id (ADR-0022 of Puerto).
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| {
            Err(ShipmentError::ValidationError(
                "order_id_not_found".to_string(),
            ))
        });

        // Act
        let response = mocks
            .client()
            .post("/shipments")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        response
            .json()
            .await
            .value()
            .object()
            .get("name")
            .assert_string("shipment.validation_error.order_id_not_found");
    }

    #[tokio::test]
    async fn should_respond_200_when_shipment_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(ShipmentMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_shipment_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(ShipmentError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_shipments_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(ShipmentMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/shipments").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/shipments?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_pass_the_order_id_filter_to_the_use_case() {
        // Arrange
        let order_id = Uuid::new_v4();
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(move |params| params.order_id == Some(OrderId::from_uuid(order_id)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get(format!("/shipments?orderId={order_id}"))
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(ShipmentError::RepositoryError));

        // Act
        let response = mocks.client().get("/shipments").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_shipment_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(ShipmentMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_shipment() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(ShipmentError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_shipment_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_shipment() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(ShipmentError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

