import { orderRepositoryHttp } from "../../../infrastructure/order/order-repository-http";
import { shipmentRepositoryHttp } from "../../../infrastructure/shipment/shipment-repository-http";

export interface Dependencies {
  customerRepository: CustomerRepository;
  orderRepository: OrderRepository;
  shipmentRepository: ShipmentRepository;
}

export function createDependencies(): Dependencies {
  const api = createApiClient();
  return {
    customerRepository: customerRepositoryHttp(api),
    orderRepository: orderRepositoryHttp(api),
    shipmentRepository: shipmentRepositoryHttp(api),
  };
}

