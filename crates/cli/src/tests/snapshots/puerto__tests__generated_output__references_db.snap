=== web/src/presentation/features/envio/views/envio-form-view.tsx ===
import type { EnvioProblem } from "../../../../domain/envio/messages";
import type { Envio, EnvioDraft } from "../../../../domain/envio/model";
import { type ReferenceOption, textOf, textOrNull } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface EnvioFormValues {
  pedidoId: string;
  destinatarioId: string;
  carrier: string;
}

/** The inputs for `envio`, empty when there is none yet. */
export function toEnvioForm(envio: Envio | null): EnvioFormValues {
  if (envio === null) {
    return {
      pedidoId: "",
      destinatarioId: "",
      carrier: "",
    };
  }
  return {
    pedidoId: envio.pedidoId,
    destinatarioId: textOf(envio.destinatarioId),
    carrier: envio.carrier,
  };
}

/** What each reference's select offers. */
export interface EnvioFormOptions {
  pedidoId: ReferenceOption[];
  destinatarioId: ReferenceOption[];
}

export function toEnvioDraft(values: EnvioFormValues): EnvioDraft {
  return {
    pedidoId: values.pedidoId,
    destinatarioId: textOrNull(values.destinatarioId),
    carrier: values.carrier,
  };
}

export function EnvioFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: EnvioFormValues;
  options: EnvioFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: EnvioProblem | null;
  onChange: (values: EnvioFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Pedido</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "pedidoId"}
          required
          value={values.pedidoId}
          onChange={(event) => onChange({ ...values, pedidoId: event.target.value })}
        >
          <option value="">Choose a pedido</option>
          {options.pedidoId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="pedidoId" />
      <label className="fieldset">
        <span className="fieldset-legend">Destinatario</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "destinatarioId"}
          value={values.destinatarioId}
          onChange={(event) => onChange({ ...values, destinatarioId: event.target.value })}
        >
          <option value="">None</option>
          {options.destinatarioId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="destinatarioId" />
      <label className="fieldset">
        <span className="fieldset-legend">Carrier</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "carrier"}
          required
          value={values.carrier}
          onChange={(event) => onChange({ ...values, carrier: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="carrier" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

