import { Link } from "wouter";
import type { Pedido } from "../../../../domain/pedido/model";

export function PedidoListView({ pedidos }: { pedidos: Pedido[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Reviewer</th>
            <th>Total</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {pedidos.map((pedido) => (
            <tr key={pedido.id}>
              <td>{pedido.clienteId}</td>
              <td>{pedido.reviewerId ?? "—"}</td>
              <td>{pedido.total}</td>
              <td className="text-right">
                <Link href={`/pedidos/${pedido.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

