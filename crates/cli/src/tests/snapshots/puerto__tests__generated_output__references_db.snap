use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::shipment::{
    errors::ShipmentError,
    model::Shipment,
    repository::ShipmentRepositoryTrait,
    use_cases::update_shipment::{UpdateShipmentParams, UpdateShipmentUseCaseTrait},
};

pub struct UpdateShipmentUseCaseImpl {
    pub repository: Arc<dyn ShipmentRepositoryTrait>,
}

#[async_trait]
impl UpdateShipmentUseCaseTrait for UpdateShipmentUseCaseImpl {
    async fn execute(&self, params: UpdateShipmentParams) -> Result<Shipment, ShipmentError> {
        tracing::info!(id = %params.id, "update_shipment: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_shipment: repository failed"))?
            .ok_or_else(|| {
                let err = ShipmentError::NotFound;
                tracing::warn!(error = %err, "update_shipment: rejected");
                err
            })?;
        if params.carrier.trim().is_empty() {
            let err = ShipmentError::ValidationError("carrier_empty".into());
            tracing::warn!(error = %err, "update_shipment: rejected");
            return Err(err);
        }
        entity.order_id = params.order_id;
        entity.carrier = params.carrier;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_shipment: repository failed"))?;
        Ok(entity)
    }
}

