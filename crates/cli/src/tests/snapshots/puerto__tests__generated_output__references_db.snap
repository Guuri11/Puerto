=== infrastructure/src/customer/entity.rs ===
use business::domain::customer::value_objects::Name;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use business::domain::customer::{
    errors::CustomerError,
    model::{Customer, CustomerId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct CustomerDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: String,
    pub email: String,
}

impl TryFrom<CustomerDb> for Customer {
    type Error = CustomerError;

    fn try_from(row: CustomerDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Customer {
            id: CustomerId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            name: Name::new(row.name)?,
            email: row.email,
        }))
    }
}

impl From<&Customer> for CustomerDb {
    fn from(entity: &Customer) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            name: entity.name.value().to_string(),
            email: entity.email.clone(),
        }
    }
}

=== infrastructure/src/customer/repository.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::customer::{
    model::{Customer, CustomerId},
    repository::CustomerRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

use super::entity::CustomerDb;
use crate::db::map_sqlx_error;

pub struct PgCustomerRepository {
    pub pool: PgPool,
}

impl PgCustomerRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: CustomerDb) -> Result<Customer, RepositoryError> {
    Customer::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid customer");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl CustomerRepositoryTrait for PgCustomerRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Customer>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = sqlx::query_as!(
            CustomerDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, name, email
             FROM customers WHERE deleted = false
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limit()),
            i64::from(page.offset())
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM customers WHERE deleted = false"#
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            map_sqlx_error(&e)
        })?;

        let items = rows
            .into_iter()
            .map(to_domain)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: CustomerId) -> Result<Option<Customer>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            CustomerDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, name, email
             FROM customers WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }

    async fn save(&self, entity: &Customer) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = CustomerDb::from(entity);
        sqlx::query!(
            "INSERT INTO customers (id, created_at, updated_at, deleted, deleted_at, name, email)
             VALUES ($1, $2, $3, $4, $5, $6, $7)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, name = $6, email = $7",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.name,
            db.email,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error(&e)
        })?;
        Ok(())
    }
}

/// `pub(crate)`: an entity that references Customer seeds its rows with this module's `seed`.
#[cfg(test)]
pub(crate) mod integration_tests {
    use super::*;
    use business::domain::customer::model::CustomerProps;

    use business::domain::customer::value_objects::Name;
    use uuid::Uuid;

    fn test_repo(pool: PgPool) -> PgCustomerRepository {
        PgCustomerRepository::new(pool)
    }

    /// A valid customer, not stored.
    fn build() -> Customer {
        Customer::new(CustomerProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            email: Uuid::new_v4().to_string(),
        })
        .unwrap()
    }

    /// A stored customer.
    pub(crate) async fn seed(pool: &PgPool) -> Customer {
        let entity = build();
        test_repo(pool.clone()).save(&entity).await.unwrap();
        entity
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.name, entity.name);
        assert_eq!(found.email, entity.email);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool)
            .find_by_id(CustomerId::generate())
            .await
            .unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_entity_on_save_conflict(pool: PgPool) {
        // Arrange
        let mut entity = seed(&pool).await;
        entity.email = "updated".to_string();
        entity.updated_at = chrono::Utc::now();

        // Act
        test_repo(pool.clone()).save(&entity).await.unwrap();

        // Assert
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(found.email, "updated");
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_customers_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        test_repo(pool.clone()).save(&deleted).await.unwrap();

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_duplicate_email(pool: PgPool) {
        // Arrange
        let first = seed(&pool).await;
        let mut second = build();
        second.email = first.email.clone();

        // Act
        let result = test_repo(pool).save(&second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
    }
}

