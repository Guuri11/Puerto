    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.order_id, entity.order_id);
        assert_eq!(found.carrier, entity.carrier);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool)
            .find_by_id(ShipmentId::generate())
            .await
            .unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_entity_on_save_conflict(pool: PgPool) {
        // Arrange
        let mut entity = seed(&pool).await;
        entity.carrier = "updated".to_string();
        entity.updated_at = chrono::Utc::now();

        // Act
        test_repo(pool.clone()).save(&entity).await.unwrap();

        // Assert
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(found.carrier, "updated");
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_shipments_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        test_repo(pool.clone()).save(&deleted).await.unwrap();

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::default(), ShipmentFilter::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::new(Some(2), Some(2)),
                ShipmentFilter::default(),
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_duplicate_order_id(pool: PgPool) {
        // Arrange
        let first = seed(&pool).await;
        let mut second = build(&pool).await;
        second.order_id = first.order_id;

        // Act
        let result = test_repo(pool).save(&second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_missing_order_id(pool: PgPool) {
        // Arrange: a order_id no row has.
        let mut entity = build(&pool).await;
        entity.order_id = OrderId::generate();

        // Act
        let result = test_repo(pool).save(&entity).await;

        // Assert
        assert_eq!(
            result.unwrap_err(),
            RepositoryError::MissingReference("order_id")
        );
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_only_the_shipments_of_the_requested_order_id(pool: PgPool) {
        // Arrange: one shipment with this order_id, one without.
        let target = crate::order::repository::integration_tests::seed(&pool).await;
        let mut wanted = build(&pool).await;
        wanted.order_id = target.id;
        test_repo(pool.clone()).save(&wanted).await.unwrap();
        seed(&pool).await;

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::default(),
                ShipmentFilter {
                    order_id: Some(target.id),
                },
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(
            page.items.iter().map(|row| row.id).collect::<Vec<_>>(),
            vec![wanted.id]
        );
        assert_eq!(page.total, 1);
    }
}

