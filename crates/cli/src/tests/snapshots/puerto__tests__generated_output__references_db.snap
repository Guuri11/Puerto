use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::shipment::{
    errors::ShipmentError,
    model::{Shipment, ShipmentProps},
    repository::ShipmentRepositoryTrait,
    use_cases::create_shipment::{CreateShipmentParams, CreateShipmentUseCaseTrait},
};

pub struct CreateShipmentUseCaseImpl {
    pub repository: Arc<dyn ShipmentRepositoryTrait>,
}

#[async_trait]
impl CreateShipmentUseCaseTrait for CreateShipmentUseCaseImpl {
    async fn execute(&self, params: CreateShipmentParams) -> Result<Shipment, ShipmentError> {
        tracing::info!("create_shipment: start");
        let entity = Shipment::new(ShipmentProps {
            order_id: params.order_id,
            carrier: params.carrier,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_shipment: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_shipment: repository failed"))?;
        tracing::info!(id = %entity.id, "create_shipment: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::order::model::OrderId;
    use crate::domain::shipment::repository::mocks::MockShipmentRepository;
    use puerto_core::RepositoryError;

    #[tokio::test]
    async fn should_create_shipment_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockShipmentRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateShipmentUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateShipmentParams {
                order_id: OrderId::generate(),
                carrier: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().carrier, "example");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockShipmentRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));
        let use_case = CreateShipmentUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateShipmentParams {
                order_id: OrderId::generate(),
                carrier: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "shipment.duplicate");
    }

    #[tokio::test]
    async fn should_return_a_validation_error_when_the_order_id_does_not_exist() {
        // Arrange: the store found no Order with that id.
        let mut mock_repo = MockShipmentRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::MissingReference("order_id")));
        let use_case = CreateShipmentUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateShipmentParams {
                order_id: OrderId::generate(),
                carrier: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shipment.validation_error.order_id_not_found"
        );
    }

    #[tokio::test]
    async fn should_return_error_when_carrier_is_empty() {
        // Arrange
        let mock_repo = MockShipmentRepository::new();
        let use_case = CreateShipmentUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateShipmentParams {
                order_id: OrderId::generate(),
                carrier: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shipment.validation_error.carrier_empty"
        );
    }
}

