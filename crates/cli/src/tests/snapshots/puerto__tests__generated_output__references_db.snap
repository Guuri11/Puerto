=== business/src/tests/mothers/customer_mother.rs ===
use crate::domain::customer::model::Customer;
use crate::domain::customer::model::CustomerProps;
use crate::domain::customer::value_objects::Name;

pub struct CustomerMother {
    name: Option<Name>,
    email: Option<String>,
}

impl CustomerMother {
    pub fn new() -> Self {
        Self {
            name: None,
            email: None,
        }
    }

    pub fn with_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn with_email(mut self, email: &str) -> Self {
        self.email = Some(email.to_string());
        self
    }

    pub fn with_empty_email(mut self) -> Self {
        self.email = Some(String::new());
        self
    }

    pub fn build(self) -> Customer {
        Customer::new(CustomerProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        })
        .expect("CustomerMother: failed to build valid Customer")
    }

    pub fn build_props(self) -> CustomerProps {
        CustomerProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn random() -> Customer {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Customer> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for CustomerMother {
    fn default() -> Self {
        Self::new()
    }
}

