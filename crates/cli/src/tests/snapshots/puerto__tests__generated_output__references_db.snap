      <Route path="/shipments/new">
        <ShipmentFormContainer />
      </Route>
      <Route path="/shipments/:id/edit">
        {(params) => <ShipmentFormContainer id={params.id} />}
      </Route>
      <Route path="/shipments/:id">{(params) => <ShipmentDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

