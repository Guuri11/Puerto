use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::customer::{
    errors::CustomerError,
    model::Customer,
    repository::CustomerRepositoryTrait,
    use_cases::list_customers::{ListCustomersParams, ListCustomersUseCaseTrait},
};

pub struct ListCustomersUseCaseImpl {
    pub repository: Arc<dyn CustomerRepositoryTrait>,
}

#[async_trait]
impl ListCustomersUseCaseTrait for ListCustomersUseCaseImpl {
    async fn execute(&self, params: ListCustomersParams) -> Result<Page<Customer>, CustomerError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_customers: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_customers: repository failed"))
            .map_err(CustomerError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::customer::value_objects::Name;
    use crate::domain::customer::{
        model::{Customer, CustomerProps},
        repository::mocks::MockCustomerRepository,
    };
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_customers() {
        let entities = vec![
            Customer::new(CustomerProps {
                name: Name::new("first".to_string()).expect("valid Name"),
                email: "first".to_string(),
            })
            .unwrap(),
            Customer::new(CustomerProps {
                name: Name::new("second".to_string()).expect("valid Name"),
                email: "second".to_string(),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListCustomersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCustomersParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_customers_exist() {
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListCustomersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCustomersParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListCustomersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCustomersParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

=== business/src/application/customer/update_customer.rs ===
use std::sync::Arc;

use crate::domain::customer::value_objects::Name;
use async_trait::async_trait;

use crate::domain::customer::{
    errors::CustomerError,
    model::Customer,
    repository::CustomerRepositoryTrait,
    use_cases::update_customer::{UpdateCustomerParams, UpdateCustomerUseCaseTrait},
};

pub struct UpdateCustomerUseCaseImpl {
    pub repository: Arc<dyn CustomerRepositoryTrait>,
}

#[async_trait]
impl UpdateCustomerUseCaseTrait for UpdateCustomerUseCaseImpl {
    async fn execute(&self, params: UpdateCustomerParams) -> Result<Customer, CustomerError> {
        tracing::info!(id = %params.id, "update_customer: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_customer: repository failed"))?
            .ok_or_else(|| {
                let err = CustomerError::NotFound;
                tracing::warn!(error = %err, "update_customer: rejected");
                err
            })?;
        if params.email.trim().is_empty() {
            let err = CustomerError::ValidationError("email_empty".into());
            tracing::warn!(error = %err, "update_customer: rejected");
            return Err(err);
        }
        let name = Name::new(params.name)?;
        entity.name = name;
        entity.email = params.email;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_customer: repository failed"))?;
        Ok(entity)
    }
}

