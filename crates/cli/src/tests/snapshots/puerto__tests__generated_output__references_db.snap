=== web/src/infrastructure/customer/customer-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { CustomerError } from "../../domain/customer/errors";
import { CustomerMother } from "../../test-support/customer";
import { createApiClient } from "../http/client";
import { customerRepositoryHttp } from "./customer-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: customerRepositoryHttp(api), requests };
}

describe("customerRepositoryHttp", () => {
  test("should ask for the page and return its customers", async () => {
    // Arrange
    const customer = CustomerMother.random();
    const page = { items: [customer], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/customers?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating a customer", async () => {
    // Arrange
    const draft = CustomerMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the customer does not exist", async () => {
    // Arrange
    const code = "customer.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(CustomerError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the customer", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/customers/42");
  });
});

=== web/src/infrastructure/customer/customer-repository-http.ts ===
import { CustomerError } from "../../domain/customer/errors";
import type { Customer, CustomerDraft } from "../../domain/customer/model";
import type { CustomerRepository } from "../../domain/customer/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type CustomerDto = components["schemas"]["CustomerDto"];
type CustomerRequest = components["schemas"]["CreateCustomerRequest"];

function toCustomer(dto: CustomerDto): Customer {
  return {
    id: dto.id,
    name: dto.name,
    email: dto.email,
  };
}

function toRequest(draft: CustomerDraft): CustomerRequest {
  return {
    name: draft.name,
    email: draft.email,
  };
}

/** `CustomerRepository` over the REST API (`/customers`). */
export function customerRepositoryHttp(api: ApiClient): CustomerRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/customers", {
        params: { query: page },
      });
      if (data === undefined) throw new CustomerError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toCustomer) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/customers/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new CustomerError(apiErrorCode(error, response));
      return toCustomer(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/customers", { body: toRequest(draft) });
      if (data === undefined) throw new CustomerError(apiErrorCode(error, response));
      return toCustomer(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/customers/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new CustomerError(apiErrorCode(error, response));
      return toCustomer(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/customers/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new CustomerError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

