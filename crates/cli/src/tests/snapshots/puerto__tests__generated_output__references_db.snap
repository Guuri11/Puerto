import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Pedido } from "../../../../domain/pedido/model";
import { ClienteMother, fakeClienteRepository } from "../../../../test-support/cliente";
import { fakePedidoRepository, PedidoMother } from "../../../../test-support/pedido";
import { renderScreen } from "../../../../test-support/render";
import { PedidoDetailContainer } from "./pedido-detail-container";

/** The repositories the reference links load from, holding what `seeded` references. */
function referencedBy(seeded: Pedido) {
  return {
    clienteRepository: fakeClienteRepository([
      ClienteMother.random({ id: seeded.clienteId }),
      ClienteMother.random({ id: seeded.reviewerId ?? crypto.randomUUID() }),
    ]),
  };
}

describe("PedidoDetailContainer", () => {
  test("should show the pedido when it exists", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const pedidoRepository = fakePedidoRepository([seeded]);

    // Act
    renderScreen(<PedidoDetailContainer id={seeded.id} />, {
      pedidoRepository,
      ...referencedBy(seeded),
    });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the cliente to its page, named by its label", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const pedidoRepository = fakePedidoRepository([seeded]);
    const referenced = referencedBy(seeded);
    const target = await referenced.clienteRepository.get(seeded.clienteId);

    // Act
    renderScreen(<PedidoDetailContainer id={seeded.id} />, {
      pedidoRepository,
      ...referenced,
    });

    // Assert: by its href — two references to one target may share a label.
    const selector = `a[href="/clientes/${seeded.clienteId}"]`;
    expect(await screen.findByText(target.name, { selector })).toBeTruthy();
  });

  test("should link the reviewer to its page, named by its label", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const pedidoRepository = fakePedidoRepository([seeded]);
    const referenced = referencedBy(seeded);
    const target = await referenced.clienteRepository.get(seeded.reviewerId ?? "");

    // Act
    renderScreen(<PedidoDetailContainer id={seeded.id} />, {
      pedidoRepository,
      ...referenced,
    });

    // Assert: by its href — two references to one target may share a label.
    const selector = `a[href="/clientes/${seeded.reviewerId}"]`;
    expect(await screen.findByText(target.name, { selector })).toBeTruthy();
  });

  test("should show the not-found code when the pedido does not exist", async () => {
    // Arrange
    const pedidoRepository = fakePedidoRepository();

    // Act
    renderScreen(<PedidoDetailContainer id={crypto.randomUUID()} />, {
      pedidoRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("pedido.no_encontrado");
  });

  test("should delete the pedido only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const fake = fakePedidoRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<PedidoDetailContainer id={seeded.id} />, {
      pedidoRepository: { ...fake, remove },
      ...referencedBy(seeded),
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/pedidos"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/pedido/containers/pedido-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { PedidoDetailView } from "../views/pedido-detail-view";

export function PedidoDetailContainer({ id }: { id: string }) {
  const { pedidoRepository } = useDependencies();
  const pedido = useAsync(() => pedidoRepository.get(id), [pedidoRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await pedidoRepository.remove(id);
      navigate("/pedidos");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Pedido</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {pedido.status === "loading" && <span className="loading loading-spinner" />}
      {pedido.status === "error" && <ErrorAlert error={pedido.error} />}
      {pedido.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <PedidoDetailView pedido={pedido.data} />
            <div className="card-actions justify-end">
              <Link href={`/pedidos/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/pedidos" className="link">
        Back to pedidos
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this pedido?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/pedido/containers/pedido-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { PedidoError } from "../../../../domain/pedido/errors";
import type { PedidoDraft } from "../../../../domain/pedido/model";
import { ClienteMother, fakeClienteRepository } from "../../../../test-support/cliente";
import { fakePedidoRepository, PedidoMother } from "../../../../test-support/pedido";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { PedidoFormContainer } from "./pedido-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: PedidoDraft) {
  return {
    clienteRepository: fakeClienteRepository([
      ClienteMother.random({ id: draft.clienteId }),
      ClienteMother.random({ id: draft.reviewerId ?? crypto.randomUUID() }),
    ]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: PedidoDraft) {
  await screen.findByText("Save");
  await choose("Cliente", draft.clienteId);
  await choose("Reviewer", textOf(draft.reviewerId));
  type("Total", String(draft.total));
}

describe("PedidoFormContainer", () => {
  test("should create the pedido from what was typed and show it", async () => {
    // Arrange
    const draft = PedidoMother.draft();
    const pedidoRepository = fakePedidoRepository();
    const { history } = renderScreen(<PedidoFormContainer />, {
      pedidoRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/pedidos/"));
    const {
      items: [created],
    } = await pedidoRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/pedidos/${created?.id}`);
  });

  test("should save the edited pedido when an existing one is submitted", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const pedidoRepository = fakePedidoRepository([seeded]);
    const { history } = renderScreen(<PedidoFormContainer id={seeded.id} />, {
      pedidoRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/pedidos/${seeded.id}`));
    expect(await pedidoRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "pedido.validacion.invalid";
    const pedidoRepository = {
      ...fakePedidoRepository(),
      create: () => Promise.reject(new PedidoError(code)),
    };
    const draft = PedidoMother.draft();
    renderScreen(<PedidoFormContainer />, {
      pedidoRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a pedido with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const pedidoRepository = {
      ...fakePedidoRepository(),
      create: () => Promise.reject(new PedidoError("pedido.duplicado")),
    };
    const draft = PedidoMother.draft();
    renderScreen(<PedidoFormContainer />, {
      pedidoRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A pedido with these values already exists",
    );
  });

  test("should offer every cliente in the selects that reference one", async () => {
    // Arrange
    const cliente = ClienteMother.random();

    // Act
    renderScreen(<PedidoFormContainer />, {
      pedidoRepository: fakePedidoRepository(),
      clienteRepository: fakeClienteRepository([cliente]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: cliente.name });
    expect(options).toHaveLength(2);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const pedidoRepository = {
      ...fakePedidoRepository(),
      create: () => Promise.reject(new PedidoError("pedido.validacion.cliente_id_no_encontrado")),
    };
    const draft = PedidoMother.draft();
    renderScreen(<PedidoFormContainer />, {
      pedidoRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Cliente does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Cliente");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/pedido/containers/pedido-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/pedido/messages";
import type { Pedido } from "../../../../domain/pedido/model";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { PedidoFormView, toPedidoDraft, toPedidoForm } from "../views/pedido-form-view";

/** Creates a pedido, or edits the one with `id`. */
export function PedidoFormContainer({ id }: { id?: string }) {
  const { pedidoRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : pedidoRepository.get(id)),
    [pedidoRepository, id],
  );
  const title = id === undefined ? "New pedido" : "Edit pedido";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <PedidoForm existing={existing.data} />}
      <Link href={id === undefined ? "/pedidos" : `/pedidos/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function PedidoForm({ existing }: { existing: Pedido | null }) {
  const { pedidoRepository, clienteRepository } = useDependencies();
  const clientes = useAsync(
    () => clienteRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [clienteRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toPedidoForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toPedidoDraft(values);
      const saved =
        existing === null
          ? await pedidoRepository.create(draft)
          : await pedidoRepository.update(existing.id, draft);
      navigate(`/pedidos/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {clientes.status === "error" && <ErrorAlert error={clientes.error} />}
        <PedidoFormView
          values={values}
          options={{
            clienteId: referenceOptions(clientes, (cliente) => cliente.name),
            reviewerId: referenceOptions(clientes, (cliente) => cliente.name),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

