import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ClienteMother, fakeClienteRepository } from "../../../../test-support/cliente";
import { renderScreen } from "../../../../test-support/render";
import { ClienteDetailContainer } from "./cliente-detail-container";

describe("ClienteDetailContainer", () => {
  test("should show the cliente when it exists", async () => {
    // Arrange
    const seeded = ClienteMother.random();
    const clienteRepository = fakeClienteRepository([seeded]);

    // Act
    renderScreen(<ClienteDetailContainer id={seeded.id} />, { clienteRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the cliente does not exist", async () => {
    // Arrange
    const clienteRepository = fakeClienteRepository();

    // Act
    renderScreen(<ClienteDetailContainer id={crypto.randomUUID()} />, {
      clienteRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("cliente.no_encontrado");
  });

  test("should delete the cliente only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ClienteMother.random();
    const fake = fakeClienteRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<ClienteDetailContainer id={seeded.id} />, {
      clienteRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/clientes"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/cliente/containers/cliente-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ClienteDetailView } from "../views/cliente-detail-view";

export function ClienteDetailContainer({ id }: { id: string }) {
  const { clienteRepository } = useDependencies();
  const cliente = useAsync(() => clienteRepository.get(id), [clienteRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await clienteRepository.remove(id);
      navigate("/clientes");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Cliente</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {cliente.status === "loading" && <span className="loading loading-spinner" />}
      {cliente.status === "error" && <ErrorAlert error={cliente.error} />}
      {cliente.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ClienteDetailView cliente={cliente.data} />
            <div className="card-actions justify-end">
              <Link href={`/clientes/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/clientes" className="link">
        Back to clientes
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this cliente?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

