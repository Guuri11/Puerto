use async_trait::async_trait;
use puerto_core::{Page, PageRequest, RepositoryError};

use super::model::{Order, OrderId};
use crate::domain::customer::model::CustomerId;

/// What `find_all` narrows the page to: one id per reference, `None` does not filter.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct OrderFilter {
    pub customer_id: Option<CustomerId>,
    pub reviewer_id: Option<CustomerId>,
}

#[async_trait]
pub trait OrderRepositoryTrait: Send + Sync {
    async fn find_all(
        &self,
        page: PageRequest,
        filter: OrderFilter,
    ) -> Result<Page<Order>, RepositoryError>;
    async fn find_by_id(&self, id: OrderId) -> Result<Option<Order>, RepositoryError>;
    async fn save(&self, entity: &Order) -> Result<(), RepositoryError>;
}

#[cfg(any(test, feature = "test-utils"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub OrderRepository {}

        #[async_trait]
        impl OrderRepositoryTrait for OrderRepository {
            async fn find_all(&self, page: PageRequest, filter: OrderFilter) -> Result<Page<Order>, RepositoryError>;
            async fn find_by_id(&self, id: OrderId) -> Result<Option<Order>, RepositoryError>;
            async fn save(&self, entity: &Order) -> Result<(), RepositoryError>;
        }
    }
}

