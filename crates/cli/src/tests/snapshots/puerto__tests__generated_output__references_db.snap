import { EnvioError } from "../../domain/envio/errors";
import type { Envio, EnvioDraft } from "../../domain/envio/model";
import type { EnvioRepository } from "../../domain/envio/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type EnvioDto = components["schemas"]["DtoEnvio"];
type EnvioRequest = components["schemas"]["PeticionCrearEnvio"];

function toEnvio(dto: EnvioDto): Envio {
  return {
    id: dto.id,
    pedidoId: dto.pedidoId,
    destinatarioId: dto.destinatarioId ?? null,
    carrier: dto.carrier,
  };
}

function toRequest(draft: EnvioDraft): EnvioRequest {
  return {
    pedidoId: draft.pedidoId,
    destinatarioId: draft.destinatarioId ?? undefined,
    carrier: draft.carrier,
  };
}

/** `EnvioRepository` over the REST API (`/envios`). */
export function envioRepositoryHttp(api: ApiClient): EnvioRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/envios", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new EnvioError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toEnvio),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/envios/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new EnvioError(apiErrorCode(error, response));
      return toEnvio(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/envios", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new EnvioError(apiErrorCode(error, response));
      return toEnvio(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/envios/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new EnvioError(apiErrorCode(error, response));
      return toEnvio(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/envios/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new EnvioError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `RespuestaError.codigo` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "codigo" in error) {
    const { codigo } = error;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${response.status}`;
}

