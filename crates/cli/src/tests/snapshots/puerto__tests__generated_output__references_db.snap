import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { EnvioError } from "../../../../domain/envio/errors";
import type { EnvioDraft } from "../../../../domain/envio/model";
import { ClienteMother, fakeClienteRepository } from "../../../../test-support/cliente";
import { EnvioMother, fakeEnvioRepository } from "../../../../test-support/envio";
import { fakePedidoRepository, PedidoMother } from "../../../../test-support/pedido";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { EnvioFormContainer } from "./envio-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: EnvioDraft) {
  return {
    pedidoRepository: fakePedidoRepository([PedidoMother.random({ id: draft.pedidoId })]),
    clienteRepository: fakeClienteRepository([
      ClienteMother.random({ id: draft.destinatarioId ?? crypto.randomUUID() }),
    ]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: EnvioDraft) {
  await screen.findByText("Save");
  await choose("Pedido", draft.pedidoId);
  await choose("Destinatario", textOf(draft.destinatarioId));
  type("Carrier", draft.carrier);
}

describe("EnvioFormContainer", () => {
  test("should create the envio from what was typed and show it", async () => {
    // Arrange
    const draft = EnvioMother.draft();
    const envioRepository = fakeEnvioRepository();
    const { history } = renderScreen(<EnvioFormContainer />, {
      envioRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/envios/"));
    const {
      items: [created],
    } = await envioRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/envios/${created?.id}`);
  });

  test("should save the edited envio when an existing one is submitted", async () => {
    // Arrange
    const seeded = EnvioMother.random();
    const envioRepository = fakeEnvioRepository([seeded]);
    const { history } = renderScreen(<EnvioFormContainer id={seeded.id} />, {
      envioRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/envios/${seeded.id}`));
    expect(await envioRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "envio.validacion.invalid";
    const envioRepository = {
      ...fakeEnvioRepository(),
      create: () => Promise.reject(new EnvioError(code)),
    };
    const draft = EnvioMother.draft();
    renderScreen(<EnvioFormContainer />, {
      envioRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a envio with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const envioRepository = {
      ...fakeEnvioRepository(),
      create: () => Promise.reject(new EnvioError("envio.duplicado")),
    };
    const draft = EnvioMother.draft();
    renderScreen(<EnvioFormContainer />, {
      envioRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An envio with these values already exists",
    );
  });

  test("should offer every pedido in the selects that reference one", async () => {
    // Arrange
    const pedido = PedidoMother.random();

    // Act
    renderScreen(<EnvioFormContainer />, {
      envioRepository: fakeEnvioRepository(),
      pedidoRepository: fakePedidoRepository([pedido]),
      clienteRepository: fakeClienteRepository(),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: pedido.id });
    expect(options).toHaveLength(1);
  });

  test("should offer every cliente in the selects that reference one", async () => {
    // Arrange
    const cliente = ClienteMother.random();

    // Act
    renderScreen(<EnvioFormContainer />, {
      envioRepository: fakeEnvioRepository(),
      pedidoRepository: fakePedidoRepository(),
      clienteRepository: fakeClienteRepository([cliente]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: cliente.name });
    expect(options).toHaveLength(1);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const envioRepository = {
      ...fakeEnvioRepository(),
      create: () => Promise.reject(new EnvioError("envio.validacion.pedido_id_no_encontrado")),
    };
    const draft = EnvioMother.draft();
    renderScreen(<EnvioFormContainer />, {
      envioRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Pedido does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Pedido");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/envio/containers/envio-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/envio/messages";
import type { Envio } from "../../../../domain/envio/model";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { EnvioFormView, toEnvioDraft, toEnvioForm } from "../views/envio-form-view";

/** Creates an envio, or edits the one with `id`. */
export function EnvioFormContainer({ id }: { id?: string }) {
  const { envioRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : envioRepository.get(id)),
    [envioRepository, id],
  );
  const title = id === undefined ? "New envio" : "Edit envio";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <EnvioForm existing={existing.data} />}
      <Link href={id === undefined ? "/envios" : `/envios/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function EnvioForm({ existing }: { existing: Envio | null }) {
  const { envioRepository, pedidoRepository, clienteRepository } = useDependencies();
  const pedidos = useAsync(
    () => pedidoRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [pedidoRepository],
  );
  const clientes = useAsync(
    () => clienteRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [clienteRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toEnvioForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toEnvioDraft(values);
      const saved =
        existing === null
          ? await envioRepository.create(draft)
          : await envioRepository.update(existing.id, draft);
      navigate(`/envios/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {pedidos.status === "error" && <ErrorAlert error={pedidos.error} />}
        {clientes.status === "error" && <ErrorAlert error={clientes.error} />}
        <EnvioFormView
          values={values}
          options={{
            pedidoId: referenceOptions(pedidos, (pedido) => pedido.id),
            destinatarioId: referenceOptions(clientes, (cliente) => cliente.name),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

