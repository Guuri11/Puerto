        <EnvioFormContainer />
      </Route>
      <Route path="/envios/:id/edit">{(params) => <EnvioFormContainer id={params.id} />}</Route>
      <Route path="/envios/:id">{(params) => <EnvioDetailContainer id={params.id} />}</Route>
      <Route path="/pedidos">
        <PedidoListContainer />
      </Route>
      <Route path="/pedidos/new">
        <PedidoFormContainer />
      </Route>
      <Route path="/pedidos/:id/edit">{(params) => <PedidoFormContainer id={params.id} />}</Route>
      <Route path="/pedidos/:id">{(params) => <PedidoDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

