import { renderScreen } from "../../../../test-support/render";
import { fakeShipmentRepository, ShipmentMother } from "../../../../test-support/shipment";
import { ShipmentListContainer } from "./shipment-list-container";

describe("ShipmentListContainer", () => {
  test("should show a row per shipment when there are some", async () => {
    // Arrange
    const seed = [ShipmentMother.random(), ShipmentMother.random()];
    const shipmentRepository = fakeShipmentRepository(seed);

    // Act
    renderScreen(<ShipmentListContainer />, { shipmentRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ShipmentMother.random());
    const shipmentRepository = fakeShipmentRepository(seed);
    renderScreen(<ShipmentListContainer />, { shipmentRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ShipmentMother.random());
