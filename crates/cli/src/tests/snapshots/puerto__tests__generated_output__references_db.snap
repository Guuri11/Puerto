#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::customer::model::CustomerId;
    use crate::domain::order::{
        model::{Order, OrderProps},
        repository::mocks::MockOrderRepository,
    };
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_orders() {
        let entities = vec![
            Order::new(OrderProps {
                customer_id: CustomerId::generate(),
                reviewer_id: None,
                total: 42,
            })
            .unwrap(),
            Order::new(OrderProps {
                customer_id: CustomerId::generate(),
                reviewer_id: None,
                total: 42,
            })
            .unwrap(),
        ];
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page, _| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrdersParams {
                page: PageRequest::default(),
                customer_id: None,
                reviewer_id: None,
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_orders_exist() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrdersParams {
                page: PageRequest::default(),
                customer_id: None,
                reviewer_id: None,
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page, _| page.limit() == 5 && page.offset() == 10)
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrdersParams {
                page: PageRequest::new(Some(5), Some(10)),
                customer_id: None,
                reviewer_id: None,
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }

    #[tokio::test]
    async fn should_pass_the_filter_to_the_repository() {
        let filter = OrderFilter {
            customer_id: Some(CustomerId::generate()),
            reviewer_id: Some(CustomerId::generate()),
        };
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .withf(move |_, f| *f == filter)
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrdersParams {
                page: PageRequest::default(),
                customer_id: filter.customer_id,
                reviewer_id: filter.reviewer_id,
            })
            .await;

        assert!(result.is_ok());
    }
}

