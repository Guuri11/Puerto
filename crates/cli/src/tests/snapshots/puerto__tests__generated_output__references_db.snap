use async_trait::async_trait;
use puerto_core::{Page, PageRequest, RepositoryError};

use super::model::{Shipment, ShipmentId};
use crate::domain::order::model::OrderId;

/// What `find_all` narrows the page to: one id per reference, `None` does not filter.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct ShipmentFilter {
    pub order_id: Option<OrderId>,
}

#[async_trait]
pub trait ShipmentRepositoryTrait: Send + Sync {
    async fn find_all(
        &self,
        page: PageRequest,
        filter: ShipmentFilter,
    ) -> Result<Page<Shipment>, RepositoryError>;
    async fn find_by_id(&self, id: ShipmentId) -> Result<Option<Shipment>, RepositoryError>;
    async fn save(&self, entity: &Shipment) -> Result<(), RepositoryError>;
}

