use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{Envio, IdEnvio};
use dominio_cliente::modelo::IdCliente;
use dominio_pedido::modelo::IdPedido;

/// A qué reduce `buscar_todos` la página: un id por referencia; `None` no filtra.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct FiltroEnvio {
    pub pedido_id: Option<IdPedido>,
    pub destinatario_id: Option<IdCliente>,
}

#[async_trait]
pub trait RepositorioEnvio: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroEnvio,
    ) -> Result<Pagina<Envio>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdEnvio) -> Result<Option<Envio>, ErrorRepositorio>;
    async fn guardar(&self, entidad: &Envio) -> Result<(), ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub RepositorioEnvio {}

        #[async_trait]
        impl RepositorioEnvio for RepositorioEnvio {
            async fn buscar_todos(&self, pagina: PeticionPagina, filtro: FiltroEnvio) -> Result<Pagina<Envio>, ErrorRepositorio>;
            async fn buscar_por_id(&self, id: IdEnvio) -> Result<Option<Envio>, ErrorRepositorio>;
            async fn guardar(&self, entidad: &Envio) -> Result<(), ErrorRepositorio>;
        }
    }
}

