use business::domain::shipment::model::Shipment;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct ShipmentDto {
    pub id: Uuid,
    pub order_id: Uuid,
    pub carrier: String,
}

impl ShipmentDto {
    pub fn from_domain(entity: &Shipment) -> Self {
        Self {
            id: entity.id.value(),
            order_id: entity.order_id.value(),
            carrier: entity.carrier.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateShipmentRequest {
    pub order_id: Uuid,
    pub carrier: String,
}

/// One page of Shipments: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct ShipmentPageDto {
    pub items: Vec<ShipmentDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl ShipmentPageDto {
    pub fn from_domain(page: &Page<Shipment>) -> Self {
        Self {
            items: page.items.iter().map(ShipmentDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateShipmentRequest {
    pub order_id: Uuid,
    pub carrier: String,
}

=== presentation/src/api/shipment/error_mapper.rs ===
use business::domain::shipment::errors::ShipmentError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::ErrorResponse;

use crate::api::error::IntoErrorResponse;

impl IntoErrorResponse for ShipmentError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            ShipmentError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            ShipmentError::NotFound => StatusCode::NOT_FOUND,
            ShipmentError::Duplicate => StatusCode::CONFLICT,
            ShipmentError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            ShipmentError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            ShipmentError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "shipment.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = ShipmentError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "shipment.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = ShipmentError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "shipment.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = ShipmentError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "shipment.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = ShipmentError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "shipment.unknown");
    }
}

