=== contextos/linea_pedido/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorLineaPedido {
    #[error("linea_pedido.validacion.{0}")]
    Validacion(String),
    #[error("linea_pedido.no_encontrado")]
    NoEncontrado,
    #[error("linea_pedido.duplicado")]
    Duplicado,
    #[error("linea_pedido.repositorio")]
    Repositorio,
    #[error("linea_pedido.desconocido")]
    Desconocido,
    #[error("linea_pedido.sku_invalido")]
    SkuInvalido,
}

impl From<ErrorRepositorio> for ErrorLineaPedido {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorLineaPedido::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "linea_pedido.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorLineaPedido::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "linea_pedido.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorLineaPedido::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "linea_pedido.repositorio");
    }
}

