use dominio_linea_pedido::modelo::LineaPedido;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoLineaPedido {
    pub id: Uuid,
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: String,
}

impl DtoLineaPedido {
    pub fn from_dominio(entidad: &LineaPedido) -> Self {
        Self {
            id: entidad.id.valor(),
            title: entidad.title.clone(),
            quantity: entidad.quantity,
            rate: entidad.rate,
            in_stock: entidad.in_stock,
            ref_id: entidad.ref_id,
            sku: entidad.sku.valor().to_string(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearLineaPedido {
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: String,
}

/// Una página de LineasPedido: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaLineaPedido {
    pub elementos: Vec<DtoLineaPedido>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaLineaPedido {
    pub fn from_dominio(pagina: &Pagina<LineaPedido>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoLineaPedido::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarLineaPedido {
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: String,
}

=== contextos/linea_pedido/rest/src/errores.rs ===
use dominio_linea_pedido::errores::ErrorLineaPedido;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de linea_pedido como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorLineaPedido) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorLineaPedido::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorLineaPedido::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorLineaPedido::Duplicado => StatusCode::CONFLICT,
        ErrorLineaPedido::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorLineaPedido::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorLineaPedido::SkuInvalido => StatusCode::UNPROCESSABLE_ENTITY,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorLineaPedido::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "linea_pedido.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorLineaPedido::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "linea_pedido.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorLineaPedido::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "linea_pedido.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorLineaPedido::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "linea_pedido.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorLineaPedido::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "linea_pedido.desconocido");
    }

    #[test]
    fn deberia_mapear_sku_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorLineaPedido::SkuInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "linea_pedido.sku_invalido");
    }
}

