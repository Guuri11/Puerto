use async_trait::async_trait;
use dominio_linea_pedido::errores::ErrorLineaPedido;
use dominio_linea_pedido::modelo::LineaPedido;
use dominio_linea_pedido::repositorio::RepositorioLineaPedido;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarLineasPedido {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarLineasPedido: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsListarLineasPedido,
    ) -> Result<Pagina<LineaPedido>, ErrorLineaPedido>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarLineasPedido {}

        #[async_trait]
        impl ListarLineasPedido for ListarLineasPedido {
            async fn ejecutar(&self, params: ParamsListarLineasPedido) -> Result<Pagina<LineaPedido>, ErrorLineaPedido>;
        }
    }
}

pub struct ListarLineasPedidoImpl {
    pub repositorio: Arc<dyn RepositorioLineaPedido>,
}

#[async_trait]
impl ListarLineasPedido for ListarLineasPedidoImpl {
    #[tracing::instrument(name = "listar_lineas_pedido", skip_all, err(level = "warn"))]
    async fn ejecutar(
        &self,
        params: ParamsListarLineasPedido,
    ) -> Result<Pagina<LineaPedido>, ErrorLineaPedido> {
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .map_err(ErrorLineaPedido::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_linea_pedido::{
        pruebas::madres::MadreLineaPedido, repositorio::dobles::MockRepositorioLineaPedido,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_lineas_pedido() {
        let entidades = MadreLineaPedido::aleatorios(2);
        let mut repositorio_doble = MockRepositorioLineaPedido::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarLineasPedidoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarLineasPedido {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_lineas_pedido() {
        let mut repositorio_doble = MockRepositorioLineaPedido::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarLineasPedidoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarLineasPedido {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioLineaPedido::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarLineasPedidoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarLineasPedido {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

