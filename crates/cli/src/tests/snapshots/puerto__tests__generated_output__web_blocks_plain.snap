use async_trait::async_trait;
use dominio_linea_pedido::errores::ErrorLineaPedido;
use dominio_linea_pedido::modelo::{LineaPedido, PropsLineaPedido};
use dominio_linea_pedido::repositorio::RepositorioLineaPedido;
use dominio_linea_pedido::valores::Sku;
use std::sync::Arc;
use uuid::Uuid;

#[derive(Debug, Clone)]
pub struct ParamsCrearLineaPedido {
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: String,
}

#[async_trait]
pub trait CrearLineaPedido: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsCrearLineaPedido,
    ) -> Result<LineaPedido, ErrorLineaPedido>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearLineaPedido {}

        #[async_trait]
        impl CrearLineaPedido for CrearLineaPedido {
            async fn ejecutar(&self, params: ParamsCrearLineaPedido) -> Result<LineaPedido, ErrorLineaPedido>;
        }
    }
}

pub struct CrearLineaPedidoImpl {
    pub repositorio: Arc<dyn RepositorioLineaPedido>,
}

#[async_trait]
impl CrearLineaPedido for CrearLineaPedidoImpl {
    #[tracing::instrument(name = "crear_linea_pedido", skip_all, err(level = "warn"))]
    async fn ejecutar(
        &self,
        params: ParamsCrearLineaPedido,
    ) -> Result<LineaPedido, ErrorLineaPedido> {
        let sku = Sku::new(params.sku)?;
        let entidad = LineaPedido::new(PropsLineaPedido {
            title: params.title,
            quantity: params.quantity,
            rate: params.rate,
            in_stock: params.in_stock,
            ref_id: params.ref_id,
            sku,
        })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

