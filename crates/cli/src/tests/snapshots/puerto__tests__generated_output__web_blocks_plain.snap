// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod linea_pedido {
    use std::sync::Arc;

    use aplicacion_linea_pedido::actualizar_linea_pedido::{
        ActualizarLineaPedido, ActualizarLineaPedidoImpl,
    };
    use aplicacion_linea_pedido::borrar_linea_pedido::{BorrarLineaPedido, BorrarLineaPedidoImpl};
    use aplicacion_linea_pedido::crear_linea_pedido::{CrearLineaPedido, CrearLineaPedidoImpl};
    use aplicacion_linea_pedido::listar_lineas_pedido::{
        ListarLineasPedido, ListarLineasPedidoImpl,
    };
    use aplicacion_linea_pedido::obtener_linea_pedido::{
        ObtenerLineaPedido, ObtenerLineaPedidoImpl,
    };
    use dominio_linea_pedido::repositorio::RepositorioLineaPedido;
    use infra_linea_pedido::repositorio::RepositorioLineaPedidoEnMemoria;

    /// Los casos de uso de `linea_pedido`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_linea_pedido: Arc<dyn CrearLineaPedido>,
        pub obtener_linea_pedido: Arc<dyn ObtenerLineaPedido>,
        pub listar_lineas_pedido: Arc<dyn ListarLineasPedido>,
        pub actualizar_linea_pedido: Arc<dyn ActualizarLineaPedido>,
        pub borrar_linea_pedido: Arc<dyn BorrarLineaPedido>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioLineaPedido> =
            Arc::new(RepositorioLineaPedidoEnMemoria::new());
        CasosDeUso {
            crear_linea_pedido: Arc::new(CrearLineaPedidoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_linea_pedido: Arc::new(ObtenerLineaPedidoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_lineas_pedido: Arc::new(ListarLineasPedidoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_linea_pedido: Arc::new(ActualizarLineaPedidoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_linea_pedido: Arc::new(BorrarLineaPedidoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

