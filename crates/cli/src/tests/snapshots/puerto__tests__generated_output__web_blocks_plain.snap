import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleLineaPedido } from "../vistas/detalle-linea-pedido";

export function ContenedorDetalleLineaPedido({ id }: { id: string }) {
  const { api } = useDependencias();
  const lineaPedido = useCarga(
    () => desenvolver(api.GET("/lineas_pedido/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/lineas_pedido/{id}", { params: { path: { id } } }));
      navegar("/lineas_pedido");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Linea pedido</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {lineaPedido.estado === "cargando" && <span className="loading loading-spinner" />}
      {lineaPedido.estado === "error" && <AlertaError error={lineaPedido.error} />}
      {lineaPedido.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleLineaPedido lineaPedido={lineaPedido.datos} />
            <div className="card-actions justify-end">
              <Link href={`/lineas_pedido/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/lineas_pedido" className="link">
        Volver a lineas pedido
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar linea pedido?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

