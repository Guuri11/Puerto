import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionLineaPedido, MadreLineaPedido } from "../../../pruebas/linea-pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaLineaPedido } from "./lista-linea-pedido";

describe("ContenedorListaLineaPedido", () => {
  test("debería mostrar una fila por cada linea pedido", async () => {
    // Preparar
    const semilla = [MadreLineaPedido.aleatorio(), MadreLineaPedido.aleatorio()];
    const api = apiFalsa([coleccionLineaPedido(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaLineaPedido />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreLineaPedido.aleatorio());
    const api = apiFalsa([coleccionLineaPedido(semilla)]);
    renderizarPantalla(<ContenedorListaLineaPedido />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreLineaPedido.aleatorio());
    const api = apiFalsa([coleccionLineaPedido(semilla)]);
    const ruta = "/lineas_pedido?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaLineaPedido />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay lineas pedido", async () => {
    // Preparar
    const api = apiFalsa([coleccionLineaPedido()]);

    // Actuar
    renderizarPantalla(<ContenedorListaLineaPedido />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay lineas pedido.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /lineas_pedido": "linea_pedido.repositorio" };
    const api = apiFalsa([coleccionLineaPedido()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaLineaPedido />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("linea_pedido.repositorio");
  });
});

=== web/src/contextos/linea-pedido/contenedores/lista-linea-pedido.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaLineaPedido } from "../vistas/lista-linea-pedido";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaLineaPedido() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const lineasPedido = useCarga(
    () => desenvolver(api.GET("/lineas_pedido", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Lineas pedido</h1>
        <Link href="/lineas_pedido/nuevo" className="btn btn-primary">
          Crear linea pedido
        </Link>
      </div>
      {lineasPedido.estado === "cargando" && <span className="loading loading-spinner" />}
      {lineasPedido.estado === "error" && <AlertaError error={lineasPedido.error} />}
      {lineasPedido.estado === "listo" &&
        (lineasPedido.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay lineas pedido." />
        ) : (
          <>
            <VistaListaLineaPedido lineasPedido={lineasPedido.datos.elementos} />
            <Paginacion
              total={lineasPedido.datos.total}
              limite={lineasPedido.datos.limite}
              desplazamiento={lineasPedido.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/linea-pedido/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaLineaPedido {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "linea_pedido.validacion.title_vacio": "Title: obligatorio",
  "linea_pedido.sku_invalido": "Sku: no válido",
  "linea_pedido.duplicado": "Estos valores ya están en uso",
  "linea_pedido.no_encontrado": "Ya no existe",
  "linea_pedido.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "linea_pedido.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "linea_pedido.validacion.title_vacio": "title",
  "linea_pedido.sku_invalido": "sku",
};

export function aProblema(codigo: string): ProblemaLineaPedido {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

