=== web/src/contextos/linea-pedido/vistas/formulario-linea-pedido.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaLineaPedido } from "../mensajes";

type LineaPedido = Esquemas["DtoLineaPedido"];
type PeticionLineaPedido = Esquemas["PeticionCrearLineaPedido"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioLineaPedido {
  title: string;
  quantity: string;
  rate: string;
  inStock: boolean;
  refId: string;
  sku: string;
}

/** Los inputs de `lineaPedido`, vacíos cuando todavía no hay ninguno. */
export function aFormularioLineaPedido(
  lineaPedido: LineaPedido | null,
): ValoresFormularioLineaPedido {
  if (lineaPedido === null) {
    return {
      title: "",
      quantity: "",
      rate: "",
      inStock: false,
      refId: "",
      sku: "",
    };
  }
  return {
    title: lineaPedido.title,
    quantity: String(lineaPedido.quantity),
    rate: String(lineaPedido.rate),
    inStock: lineaPedido.inStock,
    refId: lineaPedido.refId,
    sku: lineaPedido.sku,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionLineaPedido(valores: ValoresFormularioLineaPedido): PeticionLineaPedido {
  return {
    title: valores.title,
    quantity: Number(valores.quantity),
    rate: Number(valores.rate),
    inStock: valores.inStock,
    refId: valores.refId,
    sku: valores.sku,
  };
}

export function VistaFormularioLineaPedido({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioLineaPedido;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaLineaPedido | null;
  alCambiar: (valores: ValoresFormularioLineaPedido) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "title"}
          required
          value={valores.title}
          onChange={(event) => alCambiar({ ...valores, title: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Quantity</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "quantity"}
          required
          value={valores.quantity}
          onChange={(event) => alCambiar({ ...valores, quantity: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="quantity" />
      <label className="fieldset">
        <span className="fieldset-legend">Rate</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "rate"}
          step="any"
          required
          value={valores.rate}
          onChange={(event) => alCambiar({ ...valores, rate: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="rate" />
      <label className="label">
        <input
          className="checkbox"
          type="checkbox"
          checked={valores.inStock}
          onChange={(event) => alCambiar({ ...valores, inStock: event.target.checked })}
        />
        In stock
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Ref id</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "refId"}
          required
          value={valores.refId}
          onChange={(event) => alCambiar({ ...valores, refId: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="refId" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "sku"}
          required
          value={valores.sku}
          onChange={(event) => alCambiar({ ...valores, sku: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="sku" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/linea-pedido/vistas/lista-linea-pedido.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";

type LineaPedido = Esquemas["DtoLineaPedido"];

export function VistaListaLineaPedido({ lineasPedido }: { lineasPedido: LineaPedido[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Quantity</th>
            <th>Rate</th>
            <th>In stock</th>
            <th>Ref id</th>
            <th>Sku</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {lineasPedido.map((lineaPedido) => (
            <tr key={lineaPedido.id}>
              <td>{lineaPedido.title}</td>
              <td>{lineaPedido.quantity}</td>
              <td>{lineaPedido.rate}</td>
              <td>{lineaPedido.inStock ? "Sí" : "No"}</td>
              <td>{lineaPedido.refId}</td>
              <td>{lineaPedido.sku}</td>
              <td className="text-right">
                <Link href={`/lineas_pedido/${lineaPedido.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/generado/dependencias.ts ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//
// La raíz de composición: el único módulo que construye el cliente de la API. Las pantallas llegan
// a él con `useDependencias()`, así un test les da un falso.

import { type ClienteApi, crearClienteApi } from "../api/cliente";

export interface Dependencias {
  api: ClienteApi;
}

export function crearDependencias(): Dependencias {
  const api = crearClienteApi();
  return { api };
}

=== web/src/generado/rutas.tsx ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.

import { Route, Switch } from "wouter";
import { contarTotal, PAGINA_DE_UNO } from "../api/http";
import type { EntradaMenu } from "../compartido/ui/marco";
import { ContenedorDetalleLineaPedido } from "../contextos/linea-pedido/contenedores/detalle-linea-pedido";
import { ContenedorFormularioLineaPedido } from "../contextos/linea-pedido/contenedores/formulario-linea-pedido";
import { ContenedorListaLineaPedido } from "../contextos/linea-pedido/contenedores/lista-linea-pedido";
import { PaginaNoEncontrada } from "../paginas/no-encontrada";
import { PaginaPanel } from "../paginas/panel";
import { rutasPropias } from "../rutas";

/** Dónde va la app: en la raíz o, con portada, en `[proyecto] ruta_app` (`puerto nuevo --portada`). */
export const rutaApp = "/app";

export const entradasMenu: EntradaMenu[] = [
  {
    etiqueta: "Lineas pedido",
    href: "/lineas_pedido",
    total: ({ api }) => contarTotal(api.GET("/lineas_pedido", PAGINA_DE_UNO)),
  },
];

export function RutasApp() {
  return (
    <Switch>
      <Route path="/">
        <PaginaPanel entradas={entradasMenu} />
      </Route>
      {rutasPropias}
      <Route path="/lineas_pedido">
        <ContenedorListaLineaPedido />
      </Route>
      <Route path="/lineas_pedido/nuevo">
        <ContenedorFormularioLineaPedido />
      </Route>
      <Route path="/lineas_pedido/:id/editar">
        {(params) => <ContenedorFormularioLineaPedido id={params.id} />}
      </Route>
      <Route path="/lineas_pedido/:id">
        {(params) => <ContenedorDetalleLineaPedido id={params.id} />}
      </Route>
      <Route>
        <PaginaNoEncontrada />
      </Route>
    </Switch>
  );
}

=== web/src/main.tsx ===
import "./index.css";

import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import { Route, Switch } from "wouter";
import { Marco } from "./compartido/ui/marco";
import { ProveedorDependencias } from "./dependencias";
import { crearDependencias } from "./generado/dependencias";
import { entradasMenu, RutasApp, rutaApp } from "./generado/rutas";
import { marca } from "./marca/marca";
import { PaginaNoEncontrada } from "./paginas/no-encontrada";
import { PaginaPortada } from "./paginas/portada";

const raiz = document.getElementById("root");
if (raiz === null) {
  throw new Error("index.html no tiene el elemento #root");
}
document.title = marca.nombre;

createRoot(raiz).render(
  <StrictMode>
    <ProveedorDependencias valor={crearDependencias()}>
      <Switch>
        <Route path="/">
          <PaginaPortada />
        </Route>
        <Route path={rutaApp} nest>
          <Marco menu={entradasMenu}>
            <RutasApp />
          </Marco>
        </Route>
        <Route>
          <main className="mx-auto max-w-6xl p-4 lg:p-8">
            <PaginaNoEncontrada />
          </main>
        </Route>
      </Switch>
    </ProveedorDependencias>
  </StrictMode>,
);

=== web/src/marca/tema.css ===
/*
 * Los colores de la marca, sobre los temas claro y oscuro de daisyUI (se usa el del sistema). Lo que
 * no se cambia aquí sale del tema original. Genera otros en https://daisyui.com/theme-generator/ y
 * pega sus variables.
 */
@plugin "daisyui";

@plugin "daisyui/theme" {
  name: "light";
  default: true;
  --color-primary: oklch(27% 0.02 260);
  --color-primary-content: oklch(98% 0.005 260);
  --color-accent: oklch(58% 0.17 255);
  --color-accent-content: oklch(98% 0.01 255);
  --color-base-200: oklch(97% 0.004 260);
  --color-base-300: oklch(92% 0.006 260);
  --radius-box: 0.5rem;
  --radius-field: 0.375rem;
  --radius-selector: 0.25rem;
}

@plugin "daisyui/theme" {
  name: "dark";
  prefersdark: true;
  --color-primary: oklch(94% 0.01 260);
  --color-primary-content: oklch(22% 0.02 260);
  --color-accent: oklch(68% 0.15 255);
  --color-accent-content: oklch(18% 0.03 255);
  --color-base-100: oklch(20% 0.01 260);
  --color-base-200: oklch(17% 0.01 260);
  --color-base-300: oklch(26% 0.012 260);
  --radius-box: 0.5rem;
  --radius-field: 0.375rem;
  --radius-selector: 0.25rem;
}

=== web/src/paginas/panel.tsx ===
import { Link } from "wouter";
import type { EntradaMenu } from "../compartido/ui/marco";
import { SinElementos } from "../compartido/ui/sin-elementos";
import { useCarga } from "../compartido/use-carga";
import { useDependencias } from "../dependencias";
import { marca } from "../marca/marca";

/** La API sirve su Swagger UI en su raíz (`make run`). */
const URL_DOCS_API = "http://localhost:8080/";

/** La página de inicio: una banda con la marca y, debajo, una fila con el total de cada sección. */
export function PaginaPanel({ entradas }: { entradas: EntradaMenu[] }) {
  return (
    <section className="space-y-6">
      <header className="rounded-box bg-primary p-8 text-primary-content">
        <h1 className="text-3xl font-bold">Panel</h1>
        <p className="opacity-80">{marca.eslogan}</p>
      </header>
      {entradas.length === 0 ? (
        <SinElementos mensaje="Todavía no hay entidades. Añade una con `puerto generar scaffold <Nombre>`." />
      ) : (
        <div className="stats stats-vertical w-full bg-base-100 shadow-sm lg:stats-horizontal">
          {entradas.map((entrada) => (
            <TarjetaTotal key={entrada.href} entrada={entrada} />
          ))}
        </div>
      )}
      <a className="link link-hover text-sm" href={URL_DOCS_API}>
        Documentación de la API (Swagger UI)
      </a>
    </section>
  );
}

function TarjetaTotal({ entrada }: { entrada: EntradaMenu }) {
  const dependencias = useDependencias();
  const total = useCarga(() => entrada.total(dependencias), [entrada, dependencias]);
  return (
    <Link href={entrada.href} className="stat transition hover:bg-base-200">
      <div className="stat-title">{entrada.etiqueta}</div>
      <div className="stat-value">
        {total.estado === "listo" ? (
          total.datos
        ) : total.estado === "cargando" ? (
          <span className="loading loading-dots" />
        ) : (
          "—"
        )}
      </div>
      <div className="stat-desc">Ver la lista</div>
    </Link>
  );
}

