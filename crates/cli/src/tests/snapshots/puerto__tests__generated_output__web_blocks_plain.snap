                <p>
                  <span className="text-4xl font-bold">{plan.precio}</span>
                  <span className="text-base-content/70">{plan.periodo}</span>
                </p>
                <ul className="space-y-2">
                  {plan.incluye.map((linea) => (
                    <li key={linea} className="flex items-center gap-2">
                      <svg
                        viewBox="0 0 24 24"
                        className="size-5 text-primary"
                        fill="none"
                        stroke="currentColor"
                        strokeWidth="2"
                        aria-hidden="true"
                      >
                        <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      {linea}
                    </li>
                  ))}
                </ul>
                <Link
                  href={rutaApp}
                  className={`btn mt-2 ${plan.destacado ? "btn-primary" : "btn-outline"}`}
                >
                  Entrar
                </Link>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  );
}

