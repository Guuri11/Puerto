use std::sync::Arc;

use aplicacion_linea_pedido::{
    actualizar_linea_pedido::{ActualizarLineaPedido, ParamsActualizarLineaPedido},
    borrar_linea_pedido::{BorrarLineaPedido, ParamsBorrarLineaPedido},
    crear_linea_pedido::{CrearLineaPedido, ParamsCrearLineaPedido},
    listar_lineas_pedido::{ListarLineasPedido, ParamsListarLineasPedido},
    obtener_linea_pedido::{ObtenerLineaPedido, ParamsObtenerLineaPedido},
};
use dominio_linea_pedido::modelo::IdLineaPedido;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{
    DtoLineaPedido, DtoPaginaLineaPedido, PeticionActualizarLineaPedido, PeticionCrearLineaPedido,
};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarLineaPedido, RespuestaBorrarLineaPedido, RespuestaCrearLineaPedido,
    RespuestaListarLineasPedido, RespuestaObtenerLineaPedido,
};

#[derive(Tags)]
enum ApiTags {
    LineaPedido,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiLineaPedido {
    pub crear_linea_pedido: Arc<dyn CrearLineaPedido>,
    pub obtener_linea_pedido: Arc<dyn ObtenerLineaPedido>,
    pub listar_lineas_pedido: Arc<dyn ListarLineasPedido>,
    pub actualizar_linea_pedido: Arc<dyn ActualizarLineaPedido>,
    pub borrar_linea_pedido: Arc<dyn BorrarLineaPedido>,
}

#[OpenApi]
impl ApiLineaPedido {
    /// Crea: LineaPedido
    #[oai(path = "/lineas_pedido", method = "post", tag = "ApiTags::LineaPedido")]
    async fn crear(&self, cuerpo: Json<PeticionCrearLineaPedido>) -> RespuestaCrearLineaPedido {
        match self
            .crear_linea_pedido
            .ejecutar(ParamsCrearLineaPedido {
                title: cuerpo.title.clone(),
                quantity: cuerpo.quantity,
                rate: cuerpo.rate,
                in_stock: cuerpo.in_stock,
                ref_id: cuerpo.ref_id,
                sku: cuerpo.sku.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaCrearLineaPedido::Creado(Json(DtoLineaPedido::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_linea_pedido falló");
                RespuestaCrearLineaPedido::from_status(status, error)
            }
        }
    }

    /// Obtiene: LineaPedido por id
    #[oai(
        path = "/lineas_pedido/:id",
        method = "get",
        tag = "ApiTags::LineaPedido"
    )]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerLineaPedido {
        match self
            .obtener_linea_pedido
            .ejecutar(ParamsObtenerLineaPedido {
                id: IdLineaPedido::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaObtenerLineaPedido::Ok(Json(DtoLineaPedido::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_linea_pedido falló");
                RespuestaObtenerLineaPedido::from_status(status, error)
            }
        }
    }

    /// Lista LineasPedido, página a página (el dominio acota `limite`)
    #[oai(path = "/lineas_pedido", method = "get", tag = "ApiTags::LineaPedido")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarLineasPedido {
        match self
            .listar_lineas_pedido
            .ejecutar(ParamsListarLineasPedido {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarLineasPedido::Ok(Json(DtoPaginaLineaPedido::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_lineas_pedido falló");
                RespuestaListarLineasPedido::from_status(status, error)
            }
        }
    }

    /// Actualiza: LineaPedido
    #[oai(
        path = "/lineas_pedido/:id",
        method = "put",
        tag = "ApiTags::LineaPedido"
    )]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarLineaPedido>,
    ) -> RespuestaActualizarLineaPedido {
        match self
            .actualizar_linea_pedido
            .ejecutar(ParamsActualizarLineaPedido {
                id: IdLineaPedido::from_uuid(id.0),
                title: cuerpo.title.clone(),
                quantity: cuerpo.quantity,
                rate: cuerpo.rate,
                in_stock: cuerpo.in_stock,
                ref_id: cuerpo.ref_id,
                sku: cuerpo.sku.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaActualizarLineaPedido::Ok(Json(DtoLineaPedido::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_linea_pedido falló");
                RespuestaActualizarLineaPedido::from_status(status, error)
            }
        }
    }

    /// Borra: LineaPedido
    #[oai(
        path = "/lineas_pedido/:id",
        method = "delete",
        tag = "ApiTags::LineaPedido"
    )]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarLineaPedido {
        match self
            .borrar_linea_pedido
            .ejecutar(ParamsBorrarLineaPedido {
                id: IdLineaPedido::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarLineaPedido::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_linea_pedido falló");
                RespuestaBorrarLineaPedido::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_linea_pedido::{
        actualizar_linea_pedido::dobles::MockActualizarLineaPedido,
        borrar_linea_pedido::dobles::MockBorrarLineaPedido,
        crear_linea_pedido::dobles::MockCrearLineaPedido,
        listar_lineas_pedido::dobles::MockListarLineasPedido,
        obtener_linea_pedido::dobles::MockObtenerLineaPedido,
    };
    use dominio_linea_pedido::errores::ErrorLineaPedido;
    use dominio_linea_pedido::pruebas::madres::MadreLineaPedido;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearLineaPedido,
        obtener: MockObtenerLineaPedido,
        listar: MockListarLineasPedido,
        actualizar: MockActualizarLineaPedido,
        borrar: MockBorrarLineaPedido,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiLineaPedido {
                crear_linea_pedido: Arc::new(self.crear),
                obtener_linea_pedido: Arc::new(self.obtener),
                listar_lineas_pedido: Arc::new(self.listar),
                actualizar_linea_pedido: Arc::new(self.actualizar),
                borrar_linea_pedido: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearLineaPedido {
        PeticionCrearLineaPedido {
            title: "example".to_string(),
            quantity: 42,
            rate: 1.5,
            in_stock: true,
            ref_id: Uuid::new_v4(),
            sku: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarLineaPedido {
        PeticionActualizarLineaPedido {
            title: "example".to_string(),
            quantity: 42,
            rate: 1.5,
            in_stock: true,
            ref_id: Uuid::new_v4(),
            sku: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/lineas_pedido/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_linea_pedido() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreLineaPedido::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/lineas_pedido")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_linea_pedido_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorLineaPedido::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/lineas_pedido")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_linea_pedido_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreLineaPedido::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_linea_pedido_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorLineaPedido::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_lineas_pedido_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.listar.expect_ejecutar().returning(|params| {
            Ok(Pagina::new(
                MadreLineaPedido::aleatorios(2),
                7,
                params.pagina,
            ))
        });

        // Actuar
        let respuesta = dobles.cliente().get("/lineas_pedido").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/lineas_pedido?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorLineaPedido::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/lineas_pedido").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_linea_pedido() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreLineaPedido::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_linea_pedido_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorLineaPedido::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_linea_pedido() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_linea_pedido_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorLineaPedido::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

=== contextos/saludo/aplicacion/src/obtener_saludo.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo, repositorio::RepositorioSaludo};

#[derive(Debug, Clone)]
pub struct ParamsObtenerSaludo {
    pub nombre: String,
}

#[async_trait]
pub trait ObtenerSaludo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerSaludo {}

        #[async_trait]
        impl ObtenerSaludo for ObtenerSaludo {
            async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
        }
    }
}

pub struct ObtenerSaludoImpl {
    pub repositorio: Arc<dyn RepositorioSaludo>,
}

#[async_trait]
impl ObtenerSaludo for ObtenerSaludoImpl {
    // El span da nombre a los logs de lo que llama y registra el error que devuelve; `skip_all`:
    // el nombre es un dato del usuario y no va al log.
    #[tracing::instrument(name = "obtener_saludo", skip_all, err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo> {
        if params.nombre.trim().is_empty() {
            return Err(ErrorSaludo::Validacion("nombre_vacio".into()));
        }

        match self.repositorio.buscar_por_nombre(&params.nombre).await? {
            Some(saludo) => Ok(saludo),
            None => Saludo::new(&params.nombre),
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_saludo::repositorio::dobles::MockRepositorioSaludo;

    #[tokio::test]
    async fn deberia_devolver_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(|_| Ok(None));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Mundo".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let saludo = resultado.unwrap();
        assert_eq!(saludo.nombre, "Mundo");
        assert!(saludo.mensaje.contains("Mundo"));
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_el_nombre_esta_vacio() {
        // Preparar
        let repositorio_doble = MockRepositorioSaludo::new();
        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo { nombre: "".into() })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "saludo.validacion.nombre_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_el_saludo_guardado_cuando_esta_en_el_repositorio() {
        // Preparar
        let en_cache = Saludo {
            nombre: "Puerto".into(),
            mensaje: "¡Hola desde la caché!".into(),
        };
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(move |_| Ok(Some(en_cache.clone())));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Puerto".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().mensaje, "¡Hola desde la caché!");
    }
}

=== contextos/saludo/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ParamsObtenerSaludo};
use poem_openapi::{OpenApi, Tags, param::Path};

use crate::{dto::DtoSaludo, errores::a_respuesta_error, respuestas::RespuestaObtenerSaludo};

#[derive(Tags)]
enum ApiTags {
    Saludo,
}

/// Guarda el puerto del caso de uso; `generado/bootstrap.rs` conecta la implementación.
pub struct ApiSaludo {
    pub obtener_saludo: Arc<dyn ObtenerSaludo>,
}

#[OpenApi]
impl ApiSaludo {
    /// Obtiene un saludo para el nombre dado
    #[oai(path = "/saludos/:nombre", method = "get", tag = "ApiTags::Saludo")]
    async fn obtener_saludo(&self, nombre: Path<String>) -> RespuestaObtenerSaludo {
        match self
            .obtener_saludo
            .ejecutar(ParamsObtenerSaludo { nombre: nombre.0 })
            .await
        {
            Ok(saludo) => RespuestaObtenerSaludo::Ok(poem_openapi::payload::Json(
                DtoSaludo::from_dominio(&saludo),
            )),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_saludo falló");
                RespuestaObtenerSaludo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;
    use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo};
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::OpenApiService;

    use super::*;

    fn cliente(caso_de_uso: MockObtenerSaludo) -> TestClient<Route> {
        let api = ApiSaludo {
            obtener_saludo: Arc::new(caso_de_uso),
        };
        TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
    }

    #[tokio::test]
    async fn deberia_responder_200_con_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|params| Saludo::new(&params.nombre));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("nombre")
            .assert_string("Ada");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_se_rechaza_el_saludo() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|_| Err(ErrorSaludo::Validacion("nombre_vacio".into())));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }
}

