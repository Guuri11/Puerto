use crate::modelo::LineaPedido;
use crate::modelo::PropsLineaPedido;
use crate::valores::Sku;
use uuid::Uuid;

pub struct MadreLineaPedido {
    title: Option<String>,
    quantity: Option<i64>,
    rate: Option<f64>,
    in_stock: Option<bool>,
    ref_id: Option<Uuid>,
    sku: Option<Sku>,
}

impl MadreLineaPedido {
    pub fn new() -> Self {
        Self {
            title: None,
            quantity: None,
            rate: None,
            in_stock: None,
            ref_id: None,
            sku: None,
        }
    }

    pub fn con_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn con_quantity(mut self, quantity: i64) -> Self {
        self.quantity = Some(quantity);
        self
    }

    pub fn con_rate(mut self, rate: f64) -> Self {
        self.rate = Some(rate);
        self
    }

    pub fn con_in_stock(mut self, in_stock: bool) -> Self {
        self.in_stock = Some(in_stock);
        self
    }

    pub fn con_ref_id(mut self, ref_id: Uuid) -> Self {
        self.ref_id = Some(ref_id);
        self
    }

    pub fn con_sku(mut self, sku: Sku) -> Self {
        self.sku = Some(sku);
        self
    }

    pub fn con_title_vacio(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn construir(self) -> LineaPedido {
        LineaPedido::new(PropsLineaPedido {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            quantity: self.quantity.unwrap_or(42),
            rate: self.rate.unwrap_or(1.5),
            in_stock: self.in_stock.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            sku: self.sku.unwrap_or_else(|| {
                Sku::new("example".to_string()).expect("Sku::new rechazó el valor de ejemplo")
            }),
        })
        .expect("MadreLineaPedido: LineaPedido::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsLineaPedido {
        PropsLineaPedido {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            quantity: self.quantity.unwrap_or(42),
            rate: self.rate.unwrap_or(1.5),
            in_stock: self.in_stock.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            sku: self.sku.unwrap_or_else(|| {
                Sku::new("example".to_string()).expect("Sku::new rechazó el valor de ejemplo")
            }),
        }
    }

    pub fn aleatorio() -> LineaPedido {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<LineaPedido> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreLineaPedido {
    fn default() -> Self {
        Self::new()
    }
}

