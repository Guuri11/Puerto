use crate::errores::ErrorLineaPedido;

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    valor: String,
}

impl Sku {
    pub fn new(valor: String) -> Result<Self, ErrorLineaPedido> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorLineaPedido::SkuInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

