=== web/src/api/cliente.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { components, paths } from "./esquema";

/** El cliente tipado de la API. `paths` sale de la especificación del backend (`make web/sync`). */
export type ClienteApi = Client<paths>;

/** Los DTO de la API por nombre: `Esquemas["DtoProducto"]`, `Esquemas["PeticionCrearProducto"]`. */
export type Esquemas = components["schemas"];

/** `/api` es el backend: en desarrollo, Vite lo pasa a `:8080`. */
export function crearClienteApi(opciones: ClientOptions = {}): ClienteApi {
  return createClient<paths>({ baseUrl: "/api", ...opciones });
}

=== web/src/compartido/ui/marco.tsx ===
import { type ReactNode, useState } from "react";
import { Link, useLocation } from "wouter";
import type { Dependencias } from "../../generado/dependencias";
import { marca } from "../../marca/marca";

/** Una sección de la app: una entrada del menú y una tarjeta del panel. */
export interface EntradaMenu {
  etiqueta: string;
  href: string;
  /** Cuántos elementos tiene su lista: lo que enseña el panel. */
  total: (dependencias: Dependencias) => Promise<number>;
}

/**
 * La marca y el menú en una barra arriba y el contenido debajo.
 * En una pantalla estrecha el menú se despliega bajo la barra y se cierra al elegir una entrada.
 */
export function Marco({ menu, children }: { menu: EntradaMenu[]; children: ReactNode }) {
  const [ubicacion] = useLocation();
  const [abierto, setAbierto] = useState(false);
  const enlaces = [{ href: "/", etiqueta: "Panel" }, ...menu].map(({ href, etiqueta }) => {
    const actual = ubicacion === href || (href !== "/" && ubicacion.startsWith(`${href}/`));
    return (
      <li key={href}>
        <Link
          href={href}
          className={actual ? "menu-active" : undefined}
          aria-current={actual ? "page" : undefined}
          onClick={() => setAbierto(false)}
        >
          {etiqueta}
        </Link>
      </li>
    );
  });

  return (
    <div className="flex min-h-screen flex-col bg-base-200">
      <header className="sticky top-0 z-20 bg-base-100 shadow-sm">
        <div className="navbar mx-auto max-w-6xl gap-2 px-4">
          <button
            type="button"
            className="btn btn-square btn-ghost lg:hidden"
            aria-label={abierto ? "Cerrar el menú" : "Abrir el menú"}
            aria-expanded={abierto}
            onClick={() => setAbierto(!abierto)}
          >
            <svg
              viewBox="0 0 24 24"
              className="size-6"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path strokeLinecap="round" strokeWidth="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <Link href="/" className="flex items-center gap-2 px-2 text-lg font-bold">
            <img src={marca.logo} alt="" className="size-8" />
            {marca.nombre}
          </Link>
          <nav className="hidden lg:block">
            <ul className="menu menu-horizontal gap-1">{enlaces}</ul>
          </nav>
        </div>
        {abierto && (
          <nav className="border-base-300 border-t lg:hidden">
            <ul className="menu w-full">{enlaces}</ul>
          </nav>
        )}
      </header>
      <main className="mx-auto w-full max-w-6xl flex-1 p-4 lg:p-8">{children}</main>
    </div>
  );
}

=== web/src/contextos/linea-pedido/contenedores/detalle-linea-pedido.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionLineaPedido, MadreLineaPedido } from "../../../pruebas/linea-pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleLineaPedido } from "./detalle-linea-pedido";

describe("ContenedorDetalleLineaPedido", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreLineaPedido.aleatorio();
    const api = apiFalsa([coleccionLineaPedido([sembrado])]);

    const pantalla = <ContenedorDetalleLineaPedido id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionLineaPedido()]);
    const pantalla = <ContenedorDetalleLineaPedido id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("linea_pedido.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreLineaPedido.aleatorio();
    const guardados = coleccionLineaPedido([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleLineaPedido id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/lineas_pedido"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

