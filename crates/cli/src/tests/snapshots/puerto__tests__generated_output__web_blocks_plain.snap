use async_trait::async_trait;
use dominio_linea_pedido::errores::ErrorLineaPedido;
use dominio_linea_pedido::modelo::{IdLineaPedido, LineaPedido};
use dominio_linea_pedido::repositorio::RepositorioLineaPedido;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerLineaPedido {
    pub id: IdLineaPedido,
}

#[async_trait]
pub trait ObtenerLineaPedido: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsObtenerLineaPedido,
    ) -> Result<LineaPedido, ErrorLineaPedido>;
}

