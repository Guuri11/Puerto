#[cfg(test)]
mod tests {
    use super::*;
    use dominio_linea_pedido::{
        modelo::IdLineaPedido, pruebas::madres::MadreLineaPedido,
        repositorio::dobles::MockRepositorioLineaPedido,
    };
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
