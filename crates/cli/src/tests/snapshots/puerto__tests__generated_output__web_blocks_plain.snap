use async_trait::async_trait;
use dominio_linea_pedido::errores::ErrorLineaPedido;
use dominio_linea_pedido::modelo::IdLineaPedido;
use dominio_linea_pedido::repositorio::RepositorioLineaPedido;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarLineaPedido {
    pub id: IdLineaPedido,
}

#[async_trait]
pub trait BorrarLineaPedido: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarLineaPedido) -> Result<(), ErrorLineaPedido>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarLineaPedido {}

        #[async_trait]
        impl BorrarLineaPedido for BorrarLineaPedido {
            async fn ejecutar(&self, params: ParamsBorrarLineaPedido) -> Result<(), ErrorLineaPedido>;
        }
    }
}

pub struct BorrarLineaPedidoImpl {
    pub repositorio: Arc<dyn RepositorioLineaPedido>,
}

#[async_trait]
impl BorrarLineaPedido for BorrarLineaPedidoImpl {
    #[tracing::instrument(name = "borrar_linea_pedido", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsBorrarLineaPedido) -> Result<(), ErrorLineaPedido> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorLineaPedido::NoEncontrado)?;
        entidad.borrar();
        self.repositorio.guardar(&entidad).await?;
        Ok(())
    }
}

