                id: IdLineaPedido::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "linea_pedido.no_encontrado"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_el_almacen_no_esta_disponible() {
        let mut repositorio_doble = MockRepositorioLineaPedido::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Err(ErrorRepositorio::NoDisponible));
        let caso_de_uso = ObtenerLineaPedidoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerLineaPedido {
                id: IdLineaPedido::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "linea_pedido.repositorio"
        );
    }
}

