        let entidad = MadreLineaPedido::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioLineaPedido::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ObtenerLineaPedidoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerLineaPedido { id: id_entidad })
            .await;

