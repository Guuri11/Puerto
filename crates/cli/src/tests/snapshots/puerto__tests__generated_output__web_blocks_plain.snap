use crate::valores::Sku;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorLineaPedido;

/// El id de cada `LineaPedido`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdLineaPedido(Uuid);

impl IdLineaPedido {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdLineaPedido {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsLineaPedido {
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: Sku,
}

#[derive(Debug, Clone)]
pub struct LineaPedido {
    pub id: IdLineaPedido,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: Sku,
}

impl LineaPedido {
    pub fn new(props: PropsLineaPedido) -> Result<Self, ErrorLineaPedido> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdLineaPedido::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            title: props.title,
            quantity: props.quantity,
            rate: props.rate,
            in_stock: props.in_stock,
            ref_id: props.ref_id,
            sku: props.sku,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsLineaPedido) -> Result<(), ErrorLineaPedido> {
        Self::validar(&props)?;
        self.title = props.title;
        self.quantity = props.quantity;
        self.rate = props.rate;
        self.in_stock = props.in_stock;
        self.ref_id = props.ref_id;
        self.sku = props.sku;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: LineaPedido) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsLineaPedido) -> Result<(), ErrorLineaPedido> {
        if props.title.trim().is_empty() {
            return Err(ErrorLineaPedido::Validacion("title_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreLineaPedido;

    #[test]
    fn deberia_crear_linea_pedido_cuando_los_campos_son_validos() {
        let resultado = LineaPedido::new(MadreLineaPedido::new().construir_props());
        assert_eq!(
            resultado.unwrap().title,
            MadreLineaPedido::new().construir_props().title
        );
    }

    #[test]
    fn deberia_rechazar_linea_pedido_cuando_title_es_una_cadena_vacia() {
        let resultado =
            LineaPedido::new(MadreLineaPedido::new().con_title_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "linea_pedido.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_linea_pedido_cuando_title_solo_tiene_espacios() {
        let resultado =
            LineaPedido::new(MadreLineaPedido::new().con_title("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_linea_pedido_cuando_title_es_una_cadena_vacia() {
        let mut entidad = MadreLineaPedido::aleatorio();
        let resultado =
            entidad.actualizar(MadreLineaPedido::new().con_title_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "linea_pedido.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_linea_pedido_cuando_sku_es_una_cadena_vacia() {
        let resultado = Sku::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "linea_pedido.sku_invalido"
        );
    }

    #[test]
    fn deberia_marcar_linea_pedido_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreLineaPedido::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

