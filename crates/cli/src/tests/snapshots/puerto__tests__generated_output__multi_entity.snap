import { CategoryError } from "../domain/category/errors";
import type { Category, CategoryDraft } from "../domain/category/model";
import type { CategoryRepository } from "../domain/category/repository";

/** Valid categories for tests; pass `overrides` for the fields a test is about. */
export const CategoryMother = {
  draft(overrides: Partial<CategoryDraft> = {}): CategoryDraft {
    return {
      name: "example",
      ...overrides,
    };
  },

  random(overrides: Partial<Category> = {}): Category {
    return { id: crypto.randomUUID(), ...CategoryMother.draft(), ...overrides };
  },
};

/** An in-memory `CategoryRepository`. Override a method to make it fail. */
export function fakeCategoryRepository(seed: Category[] = []): CategoryRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new CategoryError("category.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

