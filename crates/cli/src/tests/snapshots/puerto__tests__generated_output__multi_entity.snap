import { useState } from "react";
import { Link } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { Pagination } from "../../../shared/ui/pagination";
import { CategoryListView } from "../views/category-list-view";

export function CategoryListContainer() {
  const { categoryRepository } = useDependencies();
  const [offset, setOffset] = useState(0);
  const categories = useAsync(
    () => categoryRepository.list({ limit: PAGE_SIZE, offset }),
    [categoryRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Categories</h1>
        <Link href="/categories/new" className="btn btn-primary">
          New category
        </Link>
      </div>
      {categories.status === "loading" && <span className="loading loading-spinner" />}
      {categories.status === "error" && <ErrorAlert error={categories.error} />}
      {categories.status === "ok" &&
        (categories.data.total === 0 ? (
          <EmptyState message="No categories yet." />
        ) : (
          <>
            <CategoryListView categories={categories.data.items} />
            <Pagination {...categories.data} onOffsetChange={setOffset} />
          </>
        ))}
    </section>
  );
}

