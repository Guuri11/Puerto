use async_trait::async_trait;
use dominio_categoria::errores::ErrorCategoria;
use dominio_categoria::modelo::Categoria;
use dominio_categoria::repositorio::RepositorioCategoria;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarCategorias {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarCategorias: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsListarCategorias,
    ) -> Result<Pagina<Categoria>, ErrorCategoria>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarCategorias {}

        #[async_trait]
        impl ListarCategorias for ListarCategorias {
            async fn ejecutar(&self, params: ParamsListarCategorias) -> Result<Pagina<Categoria>, ErrorCategoria>;
        }
    }
}

pub struct ListarCategoriasImpl {
    pub repositorio: Arc<dyn RepositorioCategoria>,
}

#[async_trait]
impl ListarCategorias for ListarCategoriasImpl {
    async fn ejecutar(
        &self,
        params: ParamsListarCategorias,
    ) -> Result<Pagina<Categoria>, ErrorCategoria> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_categorias: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "listar_categorias: fallo del repositorio"),
            )
            .map_err(ErrorCategoria::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_categoria::{
        pruebas::madres::MadreCategoria, repositorio::dobles::MockRepositorioCategoria,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_categorias() {
        let entidades = MadreCategoria::aleatorios(2);
        let mut repositorio_doble = MockRepositorioCategoria::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarCategoriasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCategorias {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_categorias() {
        let mut repositorio_doble = MockRepositorioCategoria::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarCategoriasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCategorias {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioCategoria::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarCategoriasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCategorias {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

