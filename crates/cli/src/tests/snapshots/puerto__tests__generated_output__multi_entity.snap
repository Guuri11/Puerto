use std::sync::Arc;

use crate::domain::category::value_objects::Name;
use async_trait::async_trait;

use crate::domain::category::{
    errors::CategoryError,
    model::{Category, CategoryProps},
    repository::CategoryRepositoryTrait,
    use_cases::create_category::{CreateCategoryParams, CreateCategoryUseCaseTrait},
};

pub struct CreateCategoryUseCaseImpl {
    pub repository: Arc<dyn CategoryRepositoryTrait>,
}

#[async_trait]
impl CreateCategoryUseCaseTrait for CreateCategoryUseCaseImpl {
    async fn execute(&self, params: CreateCategoryParams) -> Result<Category, CategoryError> {
        tracing::info!("create_category: start");
        let name = Name::new(params.name)?;
        let entity = Category::new(CategoryProps { name })
            .inspect_err(|e| tracing::warn!(error = %e, "create_category: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_category: repository failed"))?;
        tracing::info!(id = %entity.id, "create_category: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::category::repository::mocks::MockCategoryRepository;
    use puerto_core::RepositoryError;

    #[tokio::test]
    async fn should_create_category_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockCategoryRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateCategoryUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateCategoryParams {
                name: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().name.value(), "example");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockCategoryRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));
        let use_case = CreateCategoryUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateCategoryParams {
                name: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "category.duplicate");
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let mock_repo = MockCategoryRepository::new();
        let use_case = CreateCategoryUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateCategoryParams {
                name: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "category.invalid_name");
    }
}

