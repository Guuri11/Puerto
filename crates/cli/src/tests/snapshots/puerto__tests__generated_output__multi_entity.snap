use crate::errores::ErrorCategoria;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorCategoria> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCategoria::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

