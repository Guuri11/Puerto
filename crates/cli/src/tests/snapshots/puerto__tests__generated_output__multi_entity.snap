use super::value_objects::Name;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::CategoryError;

/// The id of every `Category`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct CategoryId(Uuid);

impl CategoryId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for CategoryId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct CategoryProps {
    pub name: Name,
}

#[derive(Debug, Clone)]
pub struct Category {
    pub id: CategoryId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: Name,
}

impl Category {
    pub fn new(props: CategoryProps) -> Result<Self, CategoryError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: CategoryId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
        })
    }

    pub fn from_repository(data: Category) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_category_when_fields_are_valid() {
        let result = Category::new(CategoryProps {
            name: Name::new("example".to_string()).expect("valid Name"),
        });
        assert!(result.is_ok());
    }

    #[test]
    fn should_reject_category_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "category.invalid_name");
    }
}

