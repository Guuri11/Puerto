import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CategoryMother, fakeCategoryRepository } from "../../../../test-support/category";
import { renderScreen } from "../../../../test-support/render";
import { CategoryDetailContainer } from "./category-detail-container";

describe("CategoryDetailContainer", () => {
  test("should show the category when it exists", async () => {
    // Arrange
    const seeded = CategoryMother.random();
    const categoryRepository = fakeCategoryRepository([seeded]);

    // Act
    renderScreen(<CategoryDetailContainer id={seeded.id} />, { categoryRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the category does not exist", async () => {
    // Arrange
    const categoryRepository = fakeCategoryRepository();

    // Act
    renderScreen(<CategoryDetailContainer id={crypto.randomUUID()} />, { categoryRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("category.not_found");
  });

  test("should delete the category only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = CategoryMother.random();
    const fake = fakeCategoryRepository([seeded]);
