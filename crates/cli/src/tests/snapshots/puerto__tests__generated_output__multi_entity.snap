=== contextos/categoria/dominio/src/modelo.rs ===
use crate::valores::Name;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorCategoria;

/// El id de cada `Categoria`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdCategoria(Uuid);

impl IdCategoria {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdCategoria {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsCategoria {
    pub name: Name,
}

#[derive(Debug, Clone)]
pub struct Categoria {
    pub id: IdCategoria,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: Name,
}

impl Categoria {
    pub fn new(props: PropsCategoria) -> Result<Self, ErrorCategoria> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdCategoria::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            name: props.name,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsCategoria) -> Result<(), ErrorCategoria> {
        Self::validar(&props)?;
        self.name = props.name;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Categoria) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(_props: &PropsCategoria) -> Result<(), ErrorCategoria> {
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreCategoria;

    #[test]
    fn deberia_crear_categoria_cuando_los_campos_son_validos() {
        let resultado = Categoria::new(MadreCategoria::new().construir_props());
        assert!(resultado.is_ok());
    }

    #[test]
    fn deberia_rechazar_categoria_cuando_name_es_una_cadena_vacia() {
        let resultado = Name::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "categoria.name_invalido"
        );
    }
}

