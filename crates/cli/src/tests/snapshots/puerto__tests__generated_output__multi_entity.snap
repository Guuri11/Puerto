import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCategoria, MadreCategoria } from "../../../pruebas/categoria";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaCategoria } from "./lista-categoria";

describe("ContenedorListaCategoria", () => {
  test("debería mostrar una fila por cada categoria", async () => {
    // Preparar
    const semilla = [MadreCategoria.aleatorio(), MadreCategoria.aleatorio()];
    const api = apiFalsa([coleccionCategoria(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaCategoria />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreCategoria.aleatorio());
    const api = apiFalsa([coleccionCategoria(semilla)]);
    renderizarPantalla(<ContenedorListaCategoria />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreCategoria.aleatorio());
    const api = apiFalsa([coleccionCategoria(semilla)]);
    const ruta = "/categorias?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaCategoria />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay categorias", async () => {
    // Preparar
    const api = apiFalsa([coleccionCategoria()]);

    // Actuar
    renderizarPantalla(<ContenedorListaCategoria />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay categorias.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /categorias": "categoria.repositorio" };
    const api = apiFalsa([coleccionCategoria()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaCategoria />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("categoria.repositorio");
  });
});

=== web/src/contextos/categoria/contenedores/lista-categoria.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaCategoria } from "../vistas/lista-categoria";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaCategoria() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const categorias = useCarga(
    () => desenvolver(api.GET("/categorias", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Categorias</h1>
        <Link href="/categorias/nuevo" className="btn btn-primary">
          Crear categoria
        </Link>
      </div>
      {categorias.estado === "cargando" && <span className="loading loading-spinner" />}
      {categorias.estado === "error" && <AlertaError error={categorias.error} />}
      {categorias.estado === "listo" &&
        (categorias.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay categorias." />
        ) : (
          <>
            <VistaListaCategoria categorias={categorias.datos.elementos} />
            <Paginacion
              total={categorias.datos.total}
              limite={categorias.datos.limite}
              desplazamiento={categorias.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/categoria/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaCategoria {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "categoria.name_invalido": "Name: no válido",
  "categoria.duplicado": "Estos valores ya están en uso",
  "categoria.no_encontrado": "Ya no existe",
  "categoria.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "categoria.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "categoria.name_invalido": "name",
};

export function aProblema(codigo: string): ProblemaCategoria {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

