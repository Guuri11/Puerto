=== business/src/tests/mothers/category_mother.rs ===
use crate::domain::category::model::Category;
use crate::domain::category::model::CategoryProps;
use crate::domain::category::value_objects::Name;

pub struct CategoryMother {
    name: Option<Name>,
}

impl CategoryMother {
    pub fn new() -> Self {
        Self { name: None }
    }

    pub fn with_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn build(self) -> Category {
        Category::new(CategoryProps {
            name: self.name.unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
        })
        .expect("CategoryMother: failed to build valid Category")
    }

    pub fn build_props(self) -> CategoryProps {
        CategoryProps {
            name: self.name.unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
        }
    }

    pub fn random() -> Category {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Category> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for CategoryMother {
    fn default() -> Self {
        Self::new()
    }
}

=== business/src/tests/mothers/product_mother.rs ===
use crate::domain::product::model::Product;
use crate::domain::product::model::ProductProps;

pub struct ProductMother {
    title: Option<String>,
    price: Option<i64>,
}

impl ProductMother {
    pub fn new() -> Self {
        Self { title: None, price: None }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn build(self) -> Product {
        Product::new(ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
        })
        .expect("ProductMother: failed to build valid Product")
    }

    pub fn build_props(self) -> ProductProps {
        ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
        }
    }

    pub fn random() -> Product {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Product> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for ProductMother {
    fn default() -> Self {
        Self::new()
    }
}

