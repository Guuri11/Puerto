  test("should show a row per category when there are some", async () => {
    // Arrange
    const seed = [CategoryMother.random(), CategoryMother.random()];
    const categoryRepository = fakeCategoryRepository(seed);

    // Act
    renderScreen(<CategoryListContainer />, { categoryRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => CategoryMother.random());
    const categoryRepository = fakeCategoryRepository(seed);
    renderScreen(<CategoryListContainer />, { categoryRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should say so when there is no category", async () => {
    // Arrange
