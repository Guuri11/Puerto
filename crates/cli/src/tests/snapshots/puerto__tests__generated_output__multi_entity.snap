import { Route, Switch } from "wouter";
import { CategoryDetailContainer } from "../../features/category/containers/category-detail-container";
import { CategoryFormContainer } from "../../features/category/containers/category-form-container";
import { CategoryListContainer } from "../../features/category/containers/category-list-container";
import { ProductDetailContainer } from "../../features/product/containers/product-detail-container";
import { ProductFormContainer } from "../../features/product/containers/product-form-container";
import { ProductListContainer } from "../../features/product/containers/product-list-container";
import { HomePage } from "../../pages/home";
import { NotFoundPage } from "../../pages/not-found";
import type { NavEntry } from "../../shared/ui/layout";
import { customRoutes } from "../routes";

export const navEntries: NavEntry[] = [
  { label: "Categories", href: "/categories" },
  { label: "Products", href: "/products" },
];

export function AppRoutes() {
  return (
    <Switch>
      <Route path="/">
        <HomePage entries={navEntries} />
      </Route>
      {customRoutes}
      <Route path="/categories">
        <CategoryListContainer />
      </Route>
      <Route path="/categories/new">
        <CategoryFormContainer />
      </Route>
      <Route path="/categories/:id/edit">
        {(params) => <CategoryFormContainer id={params.id} />}
      </Route>
      <Route path="/categories/:id">{(params) => <CategoryDetailContainer id={params.id} />}</Route>
      <Route path="/products">
        <ProductListContainer />
      </Route>
      <Route path="/products/new">
        <ProductFormContainer />
      </Route>
      <Route path="/products/:id/edit">{(params) => <ProductFormContainer id={params.id} />}</Route>
      <Route path="/products/:id">{(params) => <ProductDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

