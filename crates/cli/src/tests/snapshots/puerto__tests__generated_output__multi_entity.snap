    // Act
    renderScreen(<CategoryListContainer />, { categoryRepository });

    // Assert
    expect(await screen.findByText("No categories yet.")).toBeTruthy();
  });

  test("should show the error code when the categories cannot be listed", async () => {
    // Arrange
    const categoryRepository = {
      ...fakeCategoryRepository(),
      list: () => Promise.reject(new CategoryError("category.repository_error")),
    };

    // Act
    renderScreen(<CategoryListContainer />, { categoryRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("category.repository_error");
  });
});

