use business::application::product::update_product::UpdateProductUseCaseImpl;

use business::domain::category::repository::CategoryRepositoryTrait;
use business::domain::greeting::repository::GreetingRepositoryTrait;
use business::domain::product::repository::ProductRepositoryTrait;
use infrastructure::category::repository::InMemoryCategoryRepository;
use infrastructure::greeting::repository::InMemoryGreetingRepository;
use infrastructure::product::repository::InMemoryProductRepository;

use poem::Endpoint;
use poem_openapi::OpenApiService;

use crate::api::category::routes::CategoryApi;
use crate::api::greeting::routes::GreetingApi;
use crate::api::product::routes::ProductApi;

/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl {
        repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait>,
    });
    let greeting_api = GreetingApi { get_greeting };

    let product_repo: Arc<dyn ProductRepositoryTrait> = Arc::new(InMemoryProductRepository::new());
    let create_product = Arc::new(CreateProductUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let get_product = Arc::new(GetProductUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let list_products = Arc::new(ListProductsUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let update_product = Arc::new(UpdateProductUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let delete_product = Arc::new(DeleteProductUseCaseImpl {
        repository: product_repo,
    });
    let product_api = ProductApi {
        create_product,
        get_product,
        list_products,
        update_product,
        delete_product,
    };

    let category_repo: Arc<dyn CategoryRepositoryTrait> =
        Arc::new(InMemoryCategoryRepository::new());
    let create_category = Arc::new(CreateCategoryUseCaseImpl {
        repository: Arc::clone(&category_repo),
    });
    let get_category = Arc::new(GetCategoryUseCaseImpl {
        repository: Arc::clone(&category_repo),
    });
    let list_categories = Arc::new(ListCategoriesUseCaseImpl {
        repository: Arc::clone(&category_repo),
    });
    let update_category = Arc::new(UpdateCategoryUseCaseImpl {
        repository: Arc::clone(&category_repo),
    });
    let delete_category = Arc::new(DeleteCategoryUseCaseImpl {
        repository: category_repo,
    });
    let category_api = CategoryApi {
        create_category,
        get_category,
        list_categories,
        update_category,
        delete_category,
    };

    let ready = puerto_web::health::always_ready();

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::routes(
        openapi_service((greeting_api, product_api, category_api)),
        &config,
        ready,
    )))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

