use std::sync::Arc;

use business::domain::category::model::CategoryId;
use business::domain::category::use_cases::{
    create_category::{CreateCategoryParams, CreateCategoryUseCaseTrait},
    delete_category::{DeleteCategoryParams, DeleteCategoryUseCaseTrait},
    get_category::{GetCategoryParams, GetCategoryUseCaseTrait},
    list_categories::{ListCategoriesParams, ListCategoriesUseCaseTrait},
    update_category::{UpdateCategoryParams, UpdateCategoryUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::category::dto::{
    CategoryDto, CategoryPageDto, CreateCategoryRequest, UpdateCategoryRequest,
};
use crate::api::category::responses::{
    CreateCategoryResponse, DeleteCategoryResponse, GetCategoryResponse, ListCategoriesResponse,
    UpdateCategoryResponse,
};
use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct CategoryApi {
    pub create_category: Arc<dyn CreateCategoryUseCaseTrait>,
    pub get_category: Arc<dyn GetCategoryUseCaseTrait>,
    pub list_categories: Arc<dyn ListCategoriesUseCaseTrait>,
    pub update_category: Arc<dyn UpdateCategoryUseCaseTrait>,
    pub delete_category: Arc<dyn DeleteCategoryUseCaseTrait>,
}

#[OpenApi]
impl CategoryApi {
    /// Create a new Category
    #[oai(path = "/categories", method = "post", tag = "ApiTags::Category")]
    async fn create(&self, body: Json<CreateCategoryRequest>) -> CreateCategoryResponse {
        match self
            .create_category
            .execute(CreateCategoryParams {
                name: body.name.clone(),
            })
            .await
        {
            Ok(entity) => CreateCategoryResponse::Created(Json(CategoryDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_category failed");
                CreateCategoryResponse::from_status(status, error)
            }
        }
    }

    /// Get a Category by ID
    #[oai(path = "/categories/:id", method = "get", tag = "ApiTags::Category")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetCategoryResponse {
        match self
            .get_category
            .execute(GetCategoryParams {
                id: CategoryId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetCategoryResponse::Ok(Json(CategoryDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_category failed");
                GetCategoryResponse::from_status(status, error)
            }
        }
    }

    /// List Categories, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/categories", method = "get", tag = "ApiTags::Category")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
    ) -> ListCategoriesResponse {
        match self
            .list_categories
            .execute(ListCategoriesParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListCategoriesResponse::Ok(Json(CategoryPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_categories failed");
                ListCategoriesResponse::from_status(status, error)
            }
        }
    }

    /// Update a Category
    #[oai(path = "/categories/:id", method = "put", tag = "ApiTags::Category")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdateCategoryRequest>,
    ) -> UpdateCategoryResponse {
        match self
            .update_category
            .execute(UpdateCategoryParams {
                id: CategoryId::from_uuid(id.0),
                name: body.name.clone(),
            })
            .await
        {
            Ok(entity) => UpdateCategoryResponse::Ok(Json(CategoryDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_category failed");
                UpdateCategoryResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Category
    #[oai(path = "/categories/:id", method = "delete", tag = "ApiTags::Category")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteCategoryResponse {
        match self
            .delete_category
            .execute(DeleteCategoryParams {
                id: CategoryId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteCategoryResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_category failed");
                DeleteCategoryResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::category::errors::CategoryError;
    use business::domain::category::use_cases::{
        create_category::mocks::MockCreateCategoryUseCase,
        delete_category::mocks::MockDeleteCategoryUseCase,
        get_category::mocks::MockGetCategoryUseCase,
        list_categories::mocks::MockListCategoriesUseCase,
        update_category::mocks::MockUpdateCategoryUseCase,
    };
    use business::tests::mothers::category_mother::CategoryMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateCategoryUseCase,
        get: MockGetCategoryUseCase,
        list: MockListCategoriesUseCase,
        update: MockUpdateCategoryUseCase,
        delete: MockDeleteCategoryUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = CategoryApi {
                create_category: Arc::new(self.create),
                get_category: Arc::new(self.get),
                list_categories: Arc::new(self.list),
                update_category: Arc::new(self.update),
                delete_category: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateCategoryRequest {
        CreateCategoryRequest {
            name: "example".to_string(),
        }
    }

    fn update_request() -> UpdateCategoryRequest {
        UpdateCategoryRequest {
            name: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/categories/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_category_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(CategoryMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/categories")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_category_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(CategoryError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/categories")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_category_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(CategoryMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_category_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(CategoryError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_categories_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(CategoryMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/categories").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/categories?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(CategoryError::RepositoryError));

        // Act
        let response = mocks.client().get("/categories").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_category_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(CategoryMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_category() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(CategoryError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_category_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_category() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(CategoryError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

