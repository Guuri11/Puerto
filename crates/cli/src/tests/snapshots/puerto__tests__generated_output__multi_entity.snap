use crate::domain::category::model::Category;
use crate::domain::category::model::CategoryProps;
use crate::domain::category::value_objects::Name;

pub struct CategoryMother {
    name: Option<Name>,
}

impl CategoryMother {
    pub fn new() -> Self {
        Self { name: None }
    }

    pub fn with_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn build(self) -> Category {
        Category::new(CategoryProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
        })
        .expect("CategoryMother: failed to build valid Category")
    }

    pub fn build_props(self) -> CategoryProps {
        CategoryProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
        }
    }

    pub fn random() -> Category {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Category> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for CategoryMother {
    fn default() -> Self {
        Self::new()
    }
}

