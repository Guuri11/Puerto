use std::sync::Arc;

use aplicacion_categoria::{
    actualizar_categoria::{ActualizarCategoria, ParamsActualizarCategoria},
    borrar_categoria::{BorrarCategoria, ParamsBorrarCategoria},
    crear_categoria::{CrearCategoria, ParamsCrearCategoria},
    listar_categorias::{ListarCategorias, ParamsListarCategorias},
    obtener_categoria::{ObtenerCategoria, ParamsObtenerCategoria},
};
use dominio_categoria::modelo::IdCategoria;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{
    DtoCategoria, DtoPaginaCategoria, PeticionActualizarCategoria, PeticionCrearCategoria,
};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarCategoria, RespuestaBorrarCategoria, RespuestaCrearCategoria,
    RespuestaListarCategorias, RespuestaObtenerCategoria,
};

#[derive(Tags)]
enum ApiTags {
    Categoria,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiCategoria {
    pub crear_categoria: Arc<dyn CrearCategoria>,
    pub obtener_categoria: Arc<dyn ObtenerCategoria>,
    pub listar_categorias: Arc<dyn ListarCategorias>,
    pub actualizar_categoria: Arc<dyn ActualizarCategoria>,
    pub borrar_categoria: Arc<dyn BorrarCategoria>,
}

#[OpenApi]
impl ApiCategoria {
    /// Crea: Categoria
    #[oai(path = "/categorias", method = "post", tag = "ApiTags::Categoria")]
    async fn crear(&self, cuerpo: Json<PeticionCrearCategoria>) -> RespuestaCrearCategoria {
        match self
            .crear_categoria
            .ejecutar(ParamsCrearCategoria {
                name: cuerpo.name.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaCrearCategoria::Creado(Json(DtoCategoria::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_categoria falló");
                RespuestaCrearCategoria::from_status(status, error)
            }
        }
    }

    /// Obtiene: Categoria por id
    #[oai(path = "/categorias/:id", method = "get", tag = "ApiTags::Categoria")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerCategoria {
        match self
            .obtener_categoria
            .ejecutar(ParamsObtenerCategoria {
                id: IdCategoria::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaObtenerCategoria::Ok(Json(DtoCategoria::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_categoria falló");
                RespuestaObtenerCategoria::from_status(status, error)
            }
        }
    }

    /// Lista Categorias, página a página (el dominio acota `limite`)
    #[oai(path = "/categorias", method = "get", tag = "ApiTags::Categoria")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarCategorias {
        match self
            .listar_categorias
            .ejecutar(ParamsListarCategorias {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarCategorias::Ok(Json(DtoPaginaCategoria::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_categorias falló");
                RespuestaListarCategorias::from_status(status, error)
            }
        }
    }

    /// Actualiza: Categoria
    #[oai(path = "/categorias/:id", method = "put", tag = "ApiTags::Categoria")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarCategoria>,
    ) -> RespuestaActualizarCategoria {
        match self
            .actualizar_categoria
            .ejecutar(ParamsActualizarCategoria {
                id: IdCategoria::from_uuid(id.0),
                name: cuerpo.name.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaActualizarCategoria::Ok(Json(DtoCategoria::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_categoria falló");
                RespuestaActualizarCategoria::from_status(status, error)
            }
        }
    }

    /// Borra: Categoria
    #[oai(
        path = "/categorias/:id",
        method = "delete",
        tag = "ApiTags::Categoria"
    )]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarCategoria {
        match self
            .borrar_categoria
            .ejecutar(ParamsBorrarCategoria {
                id: IdCategoria::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarCategoria::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_categoria falló");
                RespuestaBorrarCategoria::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_categoria::{
        actualizar_categoria::dobles::MockActualizarCategoria,
        borrar_categoria::dobles::MockBorrarCategoria, crear_categoria::dobles::MockCrearCategoria,
        listar_categorias::dobles::MockListarCategorias,
        obtener_categoria::dobles::MockObtenerCategoria,
    };
    use dominio_categoria::errores::ErrorCategoria;
    use dominio_categoria::pruebas::madres::MadreCategoria;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearCategoria,
        obtener: MockObtenerCategoria,
        listar: MockListarCategorias,
        actualizar: MockActualizarCategoria,
        borrar: MockBorrarCategoria,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiCategoria {
                crear_categoria: Arc::new(self.crear),
                obtener_categoria: Arc::new(self.obtener),
                listar_categorias: Arc::new(self.listar),
                actualizar_categoria: Arc::new(self.actualizar),
                borrar_categoria: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearCategoria {
        PeticionCrearCategoria {
            name: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarCategoria {
        PeticionActualizarCategoria {
            name: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/categorias/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_categoria() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreCategoria::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/categorias")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_categoria_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorCategoria::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/categorias")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_categoria_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreCategoria::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_categoria_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorCategoria::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_categorias_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreCategoria::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/categorias").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/categorias?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCategoria::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/categorias").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_categoria() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreCategoria::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_categoria_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCategoria::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_categoria() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_categoria_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCategoria::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

