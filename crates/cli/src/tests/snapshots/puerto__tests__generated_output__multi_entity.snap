=== web/src/contextos/categoria/vistas/formulario-categoria.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaCategoria } from "../mensajes";

type Categoria = Esquemas["DtoCategoria"];
type PeticionCategoria = Esquemas["PeticionCrearCategoria"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioCategoria {
  name: string;
}

/** Los inputs de `categoria`, vacíos cuando todavía no hay ninguno. */
export function aFormularioCategoria(categoria: Categoria | null): ValoresFormularioCategoria {
  if (categoria === null) {
    return {
      name: "",
    };
  }
  return {
    name: categoria.name,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionCategoria(valores: ValoresFormularioCategoria): PeticionCategoria {
  return {
    name: valores.name,
  };
}

export function VistaFormularioCategoria({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioCategoria;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaCategoria | null;
  alCambiar: (valores: ValoresFormularioCategoria) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "name"}
          required
          value={valores.name}
          onChange={(event) => alCambiar({ ...valores, name: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="name" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/categoria/vistas/lista-categoria.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";

type Categoria = Esquemas["DtoCategoria"];

export function VistaListaCategoria({ categorias }: { categorias: Categoria[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Name</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {categorias.map((categoria) => (
            <tr key={categoria.id}>
              <td>{categoria.name}</td>
              <td className="text-right">
                <Link href={`/categorias/${categoria.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

