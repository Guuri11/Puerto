use chrono::{DateTime, Utc};
use uuid::Uuid;
use super::value_objects::Name;

use super::errors::CategoryError;

#[derive(Debug, Clone)]
pub struct CategoryProps {
    pub name: Name,
}

#[derive(Debug, Clone)]
pub struct Category {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: Name,
}

impl Category {
    pub fn new(props: CategoryProps) -> Result<Self, CategoryError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
        })
    }

    pub fn from_repository(data: Category) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_category_when_fields_are_valid() {
        let result = Category::new(CategoryProps {
            name: Name::new("example".to_string()).expect("valid Name"),
        });
        assert!(result.is_ok());
    }


    #[test]
    fn should_reject_category_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "category.invalid_name"
        );
    }
}

