=== web/src/infrastructure/category/category-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { CategoryError } from "../../domain/category/errors";
import { CategoryMother } from "../../test-support/category";
import { createApiClient } from "../http/client";
import { categoryRepositoryHttp } from "./category-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: categoryRepositoryHttp(api), requests };
}

describe("categoryRepositoryHttp", () => {
  test("should ask for the page and return its categories", async () => {
    // Arrange
    const category = CategoryMother.random();
    const page = { items: [category], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/categories?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating a category", async () => {
    // Arrange
    const draft = CategoryMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the category does not exist", async () => {
    // Arrange
    const code = "category.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(CategoryError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the category", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/categories/42");
  });
});

=== web/src/infrastructure/category/category-repository-http.ts ===
import { CategoryError } from "../../domain/category/errors";
import type { Category, CategoryDraft } from "../../domain/category/model";
import type { CategoryRepository } from "../../domain/category/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type CategoryDto = components["schemas"]["CategoryDto"];
type CategoryRequest = components["schemas"]["CreateCategoryRequest"];

function toCategory(dto: CategoryDto): Category {
  return {
    id: dto.id,
    name: dto.name,
  };
}

function toRequest(draft: CategoryDraft): CategoryRequest {
  return {
    name: draft.name,
  };
}

/** `CategoryRepository` over the REST API (`/categories`). */
export function categoryRepositoryHttp(api: ApiClient): CategoryRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/categories", {
        params: { query: page },
      });
      if (data === undefined) throw new CategoryError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toCategory) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/categories/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new CategoryError(apiErrorCode(error, response));
      return toCategory(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/categories", { body: toRequest(draft) });
      if (data === undefined) throw new CategoryError(apiErrorCode(error, response));
      return toCategory(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/categories/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new CategoryError(apiErrorCode(error, response));
      return toCategory(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/categories/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new CategoryError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

