import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCategoria, MadreCategoria } from "../../../pruebas/categoria";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleCategoria } from "./detalle-categoria";

describe("ContenedorDetalleCategoria", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreCategoria.aleatorio();
    const api = apiFalsa([coleccionCategoria([sembrado])]);

    const pantalla = <ContenedorDetalleCategoria id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionCategoria()]);
    const pantalla = <ContenedorDetalleCategoria id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("categoria.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreCategoria.aleatorio();
    const guardados = coleccionCategoria([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleCategoria id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/categorias"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/categoria/contenedores/detalle-categoria.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleCategoria } from "../vistas/detalle-categoria";

export function ContenedorDetalleCategoria({ id }: { id: string }) {
  const { api } = useDependencias();
  const categoria = useCarga(
    () => desenvolver(api.GET("/categorias/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/categorias/{id}", { params: { path: { id } } }));
      navegar("/categorias");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Categoria</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {categoria.estado === "cargando" && <span className="loading loading-spinner" />}
      {categoria.estado === "error" && <AlertaError error={categoria.error} />}
      {categoria.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleCategoria categoria={categoria.datos} />
            <div className="card-actions justify-end">
              <Link href={`/categorias/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/categorias" className="link">
        Volver a categorias
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar categoria?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/categoria/contenedores/formulario-categoria.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCategoria, MadreCategoria } from "../../../pruebas/categoria";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorFormularioCategoria } from "./formulario-categoria";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearCategoria"]) {
  await screen.findByText("Guardar");
  escribir("Name", peticion.name);
}

describe("ContenedorFormularioCategoria", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreCategoria.peticion();
    const guardados = coleccionCategoria();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioCategoria />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/categorias/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/categorias/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreCategoria.aleatorio();
    const guardados = coleccionCategoria([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioCategoria id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/categorias/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreCategoria.peticion();
    const codigo = "categoria.validacion.invalido";
    const fallos = { "POST /categorias": codigo };
    const api = apiFalsa([coleccionCategoria()], fallos);
    renderizarPantalla(<ContenedorFormularioCategoria />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreCategoria.peticion();
    const fallos = { "POST /categorias": "categoria.duplicado" };
    const api = apiFalsa([coleccionCategoria()], fallos);
    renderizarPantalla(<ContenedorFormularioCategoria />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("Estos valores ya están en uso");
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreCategoria.peticion();
    const fallos = { "POST /categorias": "categoria.name_invalido" };
    const api = apiFalsa([coleccionCategoria()], fallos);
    renderizarPantalla(<ContenedorFormularioCategoria />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText("Name: no válido")).toBeTruthy();
    const campo = screen.getByLabelText("Name");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/categoria/contenedores/formulario-categoria.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioCategoria,
  aPeticionCategoria,
  VistaFormularioCategoria,
} from "../vistas/formulario-categoria";

type Categoria = Esquemas["DtoCategoria"];

/** Crear, o editar con `id`: el formulario de categorias. */
export function ContenedorFormularioCategoria({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/categorias/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear categoria" : "Editar categoria";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioCategoria existente={existente.datos} />}
      <Link href={id === undefined ? "/categorias" : `/categorias/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioCategoria({ existente }: { existente: Categoria | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioCategoria(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionCategoria(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/categorias", { body: cuerpo })
          : api.PUT("/categorias/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/categorias/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioCategoria
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

