=== web/src/presentation/features/category/views/category-form-view.tsx ===
import type { Category, CategoryDraft } from "../../../../domain/category/model";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface CategoryFormValues {
  name: string;
}

/** The inputs for `category`, empty when there is none yet. */
export function toCategoryForm(category: Category | null): CategoryFormValues {
  if (category === null) {
    return {
      name: "",
    };
  }
  return {
    name: category.name,
  };
}

export function toCategoryDraft(values: CategoryFormValues): CategoryDraft {
  return {
    name: values.name,
  };
}

export function CategoryFormView({
  values,
  saving,
  onChange,
  onSubmit,
}: {
  values: CategoryFormValues;
  saving: boolean;
  onChange: (values: CategoryFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

