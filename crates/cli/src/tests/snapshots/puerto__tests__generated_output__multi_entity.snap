use std::sync::Arc;

use crate::domain::category::value_objects::Name;
use async_trait::async_trait;

use crate::domain::category::{
    errors::CategoryError,
    model::Category,
    repository::CategoryRepositoryTrait,
    use_cases::update_category::{UpdateCategoryParams, UpdateCategoryUseCaseTrait},
};

pub struct UpdateCategoryUseCaseImpl {
    pub repository: Arc<dyn CategoryRepositoryTrait>,
}

#[async_trait]
impl UpdateCategoryUseCaseTrait for UpdateCategoryUseCaseImpl {
    async fn execute(&self, params: UpdateCategoryParams) -> Result<Category, CategoryError> {
        tracing::info!(id = %params.id, "update_category: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_category: repository failed"))?
            .ok_or_else(|| {
                let err = CategoryError::NotFound;
                tracing::warn!(error = %err, "update_category: rejected");
                err
            })?;
        let name = Name::new(params.name)?;
        entity.name = name;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_category: repository failed"))?;
        Ok(entity)
    }
}

