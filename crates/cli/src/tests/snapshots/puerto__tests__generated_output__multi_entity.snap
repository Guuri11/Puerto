use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::category::{
    errors::CategoryError,
    model::Category,
    repository::CategoryRepositoryTrait,
    use_cases::list_categories::{ListCategoriesParams, ListCategoriesUseCaseTrait},
};

pub struct ListCategoriesUseCaseImpl {
    pub repository: Arc<dyn CategoryRepositoryTrait>,
}

#[async_trait]
impl ListCategoriesUseCaseTrait for ListCategoriesUseCaseImpl {
    async fn execute(&self, params: ListCategoriesParams) -> Result<Page<Category>, CategoryError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_categories: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_categories: repository failed"))
            .map_err(CategoryError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::category::value_objects::Name;
    use crate::domain::category::{
        model::{Category, CategoryProps},
        repository::mocks::MockCategoryRepository,
    };
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_categories() {
        let entities = vec![
            Category::new(CategoryProps {
                name: Name::new("first".to_string()).expect("valid Name"),
            })
            .unwrap(),
            Category::new(CategoryProps {
                name: Name::new("second".to_string()).expect("valid Name"),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockCategoryRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListCategoriesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCategoriesParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_categories_exist() {
        let mut mock_repo = MockCategoryRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListCategoriesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCategoriesParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockCategoryRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListCategoriesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCategoriesParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

