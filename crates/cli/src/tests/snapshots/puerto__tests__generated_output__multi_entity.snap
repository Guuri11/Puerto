use crate::modelo::Categoria;
use crate::modelo::PropsCategoria;
use crate::valores::Name;

pub struct MadreCategoria {
    name: Option<Name>,
}

impl MadreCategoria {
    pub fn new() -> Self {
        Self { name: None }
    }

    pub fn con_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn construir(self) -> Categoria {
        Categoria::new(PropsCategoria {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
        })
        .expect("MadreCategoria: Categoria::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsCategoria {
        PropsCategoria {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
        }
    }

    pub fn aleatorio() -> Categoria {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Categoria> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreCategoria {
    fn default() -> Self {
        Self::new()
    }
}

