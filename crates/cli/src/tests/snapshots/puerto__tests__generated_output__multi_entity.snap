import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { CategoryDetailView } from "../views/category-detail-view";

export function CategoryDetailContainer({ id }: { id: string }) {
  const { categoryRepository } = useDependencies();
  const category = useAsync(() => categoryRepository.get(id), [categoryRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await categoryRepository.remove(id);
      navigate("/categories");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Category</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {category.status === "loading" && <span className="loading loading-spinner" />}
      {category.status === "error" && <ErrorAlert error={category.error} />}
      {category.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <CategoryDetailView category={category.data} />
            <div className="card-actions justify-end">
              <Link href={`/categories/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/categories" className="link">
        Back to categories
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this category?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

