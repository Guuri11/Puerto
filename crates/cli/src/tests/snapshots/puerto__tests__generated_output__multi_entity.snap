use business::domain::category::model::Category;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CategoryDto {
    pub id: Uuid,
    pub name: String,
}

impl CategoryDto {
    pub fn from_domain(entity: &Category) -> Self {
        Self {
            id: entity.id.value(),
            name: entity.name.value().to_string(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateCategoryRequest {
    pub name: String,
}

/// One page of Categories: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CategoryPageDto {
    pub items: Vec<CategoryDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl CategoryPageDto {
    pub fn from_domain(page: &Page<Category>) -> Self {
        Self {
            items: page.items.iter().map(CategoryDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateCategoryRequest {
    pub name: String,
}

=== presentation/src/api/category/error_mapper.rs ===
use business::domain::category::errors::CategoryError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::ErrorResponse;

use crate::api::error::IntoErrorResponse;

impl IntoErrorResponse for CategoryError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            CategoryError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            CategoryError::NotFound => StatusCode::NOT_FOUND,
            CategoryError::Duplicate => StatusCode::CONFLICT,
            CategoryError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            CategoryError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            CategoryError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            CategoryError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "category.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = CategoryError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "category.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = CategoryError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "category.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = CategoryError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "category.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = CategoryError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "category.unknown");
    }

    #[test]
    fn should_map_invalid_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = CategoryError::InvalidName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "category.invalid_name");
    }
}

