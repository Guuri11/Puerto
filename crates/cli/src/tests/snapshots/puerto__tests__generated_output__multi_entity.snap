}

#[async_trait]
impl CrearCategoria for CrearCategoriaImpl {
    async fn ejecutar(&self, params: ParamsCrearCategoria) -> Result<Categoria, ErrorCategoria> {
        tracing::info!("crear_categoria: inicio");
        let name = Name::new(params.name)?;
        let entidad = Categoria::new(PropsCategoria { name })
            .inspect_err(|e| tracing::warn!(error = %e, "crear_categoria: rechazado"))?;
