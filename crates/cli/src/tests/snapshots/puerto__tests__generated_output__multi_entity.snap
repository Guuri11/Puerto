=== presentation/src/api/category/error_mapper.rs ===
use business::domain::category::errors::CategoryError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;

use crate::api::error::{ErrorResponse, IntoErrorResponse};

impl IntoErrorResponse for CategoryError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            CategoryError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            CategoryError::NotFound => StatusCode::NOT_FOUND,
            CategoryError::Duplicate => StatusCode::CONFLICT,
            CategoryError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            CategoryError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            CategoryError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
