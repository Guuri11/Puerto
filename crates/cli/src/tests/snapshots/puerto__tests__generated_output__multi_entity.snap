    use super::*;

    use business::domain::category::use_cases::create_category::mocks::MockCreateCategoryUseCase;
    use business::domain::category::use_cases::delete_category::mocks::MockDeleteCategoryUseCase;
    use business::domain::category::use_cases::get_category::mocks::MockGetCategoryUseCase;
    use business::domain::category::use_cases::list_categories::mocks::MockListCategoriesUseCase;
    use business::domain::category::use_cases::update_category::mocks::MockUpdateCategoryUseCase;
    use business::domain::greeting::use_cases::get_greeting::mocks::MockGetGreetingUseCase;
    use business::domain::product::use_cases::create_product::mocks::MockCreateProductUseCase;
    use business::domain::product::use_cases::delete_product::mocks::MockDeleteProductUseCase;
    use business::domain::product::use_cases::get_product::mocks::MockGetProductUseCase;
    use business::domain::product::use_cases::list_products::mocks::MockListProductsUseCase;
    use business::domain::product::use_cases::update_product::mocks::MockUpdateProductUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let greeting_api = GreetingApi {
            get_greeting: Arc::new(MockGetGreetingUseCase::new()),
        };
        let product_api = ProductApi {
            create_product: Arc::new(MockCreateProductUseCase::new()),
            get_product: Arc::new(MockGetProductUseCase::new()),
            list_products: Arc::new(MockListProductsUseCase::new()),
            update_product: Arc::new(MockUpdateProductUseCase::new()),
            delete_product: Arc::new(MockDeleteProductUseCase::new()),
        };
        let category_api = CategoryApi {
            create_category: Arc::new(MockCreateCategoryUseCase::new()),
            get_category: Arc::new(MockGetCategoryUseCase::new()),
            list_categories: Arc::new(MockListCategoriesUseCase::new()),
            update_category: Arc::new(MockUpdateCategoryUseCase::new()),
            delete_category: Arc::new(MockDeleteCategoryUseCase::new()),
        };
        let spec = openapi_service((greeting_api, product_api, category_api)).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

