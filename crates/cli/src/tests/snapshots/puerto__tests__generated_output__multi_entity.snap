use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::category::{
    errors::CategoryError,
    repository::CategoryRepositoryTrait,
    use_cases::delete_category::{DeleteCategoryParams, DeleteCategoryUseCaseTrait},
};

pub struct DeleteCategoryUseCaseImpl {
    pub repository: Arc<dyn CategoryRepositoryTrait>,
}

#[async_trait]
impl DeleteCategoryUseCaseTrait for DeleteCategoryUseCaseImpl {
    async fn execute(&self, params: DeleteCategoryParams) -> Result<(), CategoryError> {
        tracing::info!(id = %params.id, "delete_category: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_category: repository failed"))?
            .ok_or_else(|| {
                let err = CategoryError::NotFound;
                tracing::warn!(error = %err, "delete_category: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "delete_category: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::category::{
        model::{Category, CategoryProps},
        repository::mocks::MockCategoryRepository,
    };
    use uuid::Uuid;
    use crate::domain::category::value_objects::Name;


    #[tokio::test]
    async fn should_soft_delete_category_when_id_exists() {
        let entity = Category::new(CategoryProps {
            name: Name::new("example".to_string()).expect("valid Name"),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCategoryRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteCategoryUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteCategoryParams { id: entity_id })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_category_does_not_exist() {
        let mut mock_repo = MockCategoryRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteCategoryUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteCategoryParams { id: Uuid::new_v4() })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "category.not_found");
    }
}

