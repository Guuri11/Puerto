use async_trait::async_trait;
use dominio_categoria::errores::ErrorCategoria;
use dominio_categoria::modelo::IdCategoria;
use dominio_categoria::repositorio::RepositorioCategoria;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarCategoria {
    pub id: IdCategoria,
}

#[async_trait]
pub trait BorrarCategoria: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarCategoria) -> Result<(), ErrorCategoria>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarCategoria {}

        #[async_trait]
        impl BorrarCategoria for BorrarCategoria {
            async fn ejecutar(&self, params: ParamsBorrarCategoria) -> Result<(), ErrorCategoria>;
        }
    }
}

pub struct BorrarCategoriaImpl {
    pub repositorio: Arc<dyn RepositorioCategoria>,
}

#[async_trait]
impl BorrarCategoria for BorrarCategoriaImpl {
    async fn ejecutar(&self, params: ParamsBorrarCategoria) -> Result<(), ErrorCategoria> {
        tracing::info!(id = %params.id, "borrar_categoria: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "borrar_categoria: fallo del repositorio"),
            )?
            .ok_or_else(|| {
                let err = ErrorCategoria::NoEncontrado;
                tracing::warn!(error = %err, "borrar_categoria: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "borrar_categoria: fallo del repositorio"),
        )?;
        Ok(())
    }
}

