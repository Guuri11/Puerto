import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CategoryError } from "../../../../domain/category/errors";
import type { CategoryDraft } from "../../../../domain/category/model";
import { CategoryMother, fakeCategoryRepository } from "../../../../test-support/category";
import { renderScreen } from "../../../../test-support/render";
import { CategoryFormContainer } from "./category-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: CategoryDraft) {
  await screen.findByText("Save");
  type("Name", draft.name);
}

describe("CategoryFormContainer", () => {
  test("should create the category from what was typed and show it", async () => {
    // Arrange
    const draft = CategoryMother.draft();
    const categoryRepository = fakeCategoryRepository();
    const { history } = renderScreen(<CategoryFormContainer />, { categoryRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/categories/"));
    const {
      items: [created],
    } = await categoryRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/categories/${created?.id}`);
  });

  test("should save the edited category when an existing one is submitted", async () => {
    // Arrange
    const seeded = CategoryMother.random();
    const categoryRepository = fakeCategoryRepository([seeded]);
    const { history } = renderScreen(<CategoryFormContainer id={seeded.id} />, {
      categoryRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/categories/${seeded.id}`));
    expect(await categoryRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the validation code when the API rejects the category", async () => {
    // Arrange
    const code = "category.validation_error.invalid";
    const categoryRepository = {
      ...fakeCategoryRepository(),
      create: () => Promise.reject(new CategoryError(code)),
    };
    renderScreen(<CategoryFormContainer />, { categoryRepository });
    await fillIn(CategoryMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });
});

=== web/src/presentation/features/category/containers/category-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Category } from "../../../../domain/category/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { CategoryFormView, toCategoryDraft, toCategoryForm } from "../views/category-form-view";

/** Creates a category, or edits the one with `id`. */
export function CategoryFormContainer({ id }: { id?: string }) {
  const { categoryRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : categoryRepository.get(id)),
    [categoryRepository, id],
  );
  const title = id === undefined ? "New category" : "Edit category";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <CategoryForm existing={existing.data} />}
      <Link href={id === undefined ? "/categories" : `/categories/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function CategoryForm({ existing }: { existing: Category | null }) {
  const { categoryRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toCategoryForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toCategoryDraft(values);
      const saved =
        existing === null
          ? await categoryRepository.create(draft)
          : await categoryRepository.update(existing.id, draft);
      navigate(`/categories/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {failure !== null && <ErrorAlert error={failure} />}
        <CategoryFormView values={values} saving={saving} onChange={setValues} onSubmit={save} />
      </div>
    </div>
  );
}

