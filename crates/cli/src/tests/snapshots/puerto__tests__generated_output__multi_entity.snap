use crate::domain::product::model::Product;
use crate::domain::product::model::ProductProps;

pub struct ProductMother {
    title: Option<String>,
    price: Option<i64>,
}

impl ProductMother {
    pub fn new() -> Self {
        Self {
            title: None,
            price: None,
        }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn build(self) -> Product {
        Product::new(ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
        })
        .expect("ProductMother: failed to build valid Product")
    }

    pub fn build_props(self) -> ProductProps {
        ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
        }
    }

    pub fn random() -> Product {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Product> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for ProductMother {
    fn default() -> Self {
        Self::new()
    }
}

=== infrastructure/src/category/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::category::{
    model::{Category, CategoryId},
    repository::CategoryRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// Keeps the categories it is given in process memory: they are lost when the process stops.
/// Like the Postgres adapter, it hides deleted rows and lists newest first.
/// It stands in until there is a database (`puerto new --db` generates Postgres repositories).
#[derive(Default)]
pub struct InMemoryCategoryRepository {
    rows: RwLock<HashMap<CategoryId, Category>>,
}

impl InMemoryCategoryRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<CategoryId, Category>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<CategoryId, Category>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl CategoryRepositoryTrait for InMemoryCategoryRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Category>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = self.read();
        let mut live: Vec<&Category> = rows.values().filter(|row| !row.deleted).collect();
        live.sort_by(|a, b| {
            b.created_at
                .cmp(&a.created_at)
                .then_with(|| a.id.value().cmp(&b.id.value()))
        });
        let total = live.len() as u64;
        let items = live
            .into_iter()
            .skip(page.offset() as usize)
            .take(page.limit() as usize)
            .cloned()
            .collect();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: CategoryId) -> Result<Option<Category>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(self.read().get(&id).filter(|row| !row.deleted).cloned())
    }

    async fn save(&self, entity: &Category) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let mut rows = self.write();
        rows.insert(entity.id, entity.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::category::model::CategoryProps;
    use business::domain::category::value_objects::Name;

    fn new_category() -> Category {
        Category::new(CategoryProps {
            name: Name::new("example".to_string()).expect("valid Name"),
        })
        .unwrap()
    }

    #[tokio::test]
    async fn should_find_a_saved_category_by_id() {
        // Arrange
        let repo = InMemoryCategoryRepository::new();
        let entity = new_category();
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();

        // Assert
        assert_eq!(found.map(|row| row.id), Some(entity.id));
    }

    #[tokio::test]
    async fn should_update_the_row_when_saved_again() {
        // Arrange
        let repo = InMemoryCategoryRepository::new();
        let mut entity = new_category();
        repo.save(&entity).await.unwrap();
        entity.updated_at = chrono::Utc::now();

        // Act
        repo.save(&entity).await.unwrap();

        // Assert
        let page = repo.find_all(PageRequest::default()).await.unwrap();
        assert_eq!(page.total, 1);
        assert_eq!(page.items[0].updated_at, entity.updated_at);
    }

    #[tokio::test]
    async fn should_not_find_a_deleted_category() {
        // Arrange
        let repo = InMemoryCategoryRepository::new();
        let mut entity = new_category();
        entity.deleted = true;
        entity.deleted_at = Some(entity.updated_at);
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();
        let page = repo.find_all(PageRequest::default()).await.unwrap();

        // Assert
        assert!(found.is_none());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_return_the_requested_page_of_a_larger_list() {
        // Arrange
        let repo = InMemoryCategoryRepository::new();
        for _ in 0..3 {
            repo.save(&new_category()).await.unwrap();
        }

        // Act
        let page = repo
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }
}

