use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{Cuenta, IdCuenta};

#[async_trait]
pub trait RepositorioCuenta: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Cuenta>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdCuenta) -> Result<Option<Cuenta>, ErrorRepositorio>;
    async fn guardar(&self, entidad: &Cuenta) -> Result<(), ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub RepositorioCuenta {}

        #[async_trait]
        impl RepositorioCuenta for RepositorioCuenta {
            async fn buscar_todos(&self, pagina: PeticionPagina) -> Result<Pagina<Cuenta>, ErrorRepositorio>;
            async fn buscar_por_id(&self, id: IdCuenta) -> Result<Option<Cuenta>, ErrorRepositorio>;
            async fn guardar(&self, entidad: &Cuenta) -> Result<(), ErrorRepositorio>;
        }
    }
}

=== contextos/cuenta/dominio/src/valores.rs ===
use crate::errores::ErrorCuenta;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    valor: String,
}

impl Sku {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::SkuInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    valor: String,
}

impl MiddleName {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::MiddleNameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Tag {
    valor: String,
}

impl Tag {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::TagInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Active,
    Archived,
}

impl std::str::FromStr for Status {
    type Err = ErrorCuenta;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Active" => Ok(Self::Active),
            "Archived" => Ok(Self::Archived),
            _ => Err(ErrorCuenta::StatusInvalido),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Active => "Active",
            Self::Archived => "Archived",
        }
    }
}

