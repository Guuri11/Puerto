=== contextos/cuenta/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorCuenta {
    #[error("cuenta.validacion.{0}")]
    Validacion(String),
    #[error("cuenta.no_encontrado")]
    NoEncontrado,
    #[error("cuenta.duplicado")]
    Duplicado,
    #[error("cuenta.repositorio")]
    Repositorio,
    #[error("cuenta.desconocido")]
    Desconocido,
    #[error("cuenta.name_invalido")]
    NameInvalido,
    #[error("cuenta.sku_invalido")]
    SkuInvalido,
    #[error("cuenta.middle_name_invalido")]
    MiddleNameInvalido,
    #[error("cuenta.tag_invalido")]
    TagInvalido,
    #[error("cuenta.status_invalido")]
    StatusInvalido,
    #[error("cuenta.email_invalido")]
    EmailInvalido,
}

impl From<ErrorRepositorio> for ErrorCuenta {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorCuenta::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "cuenta.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorCuenta::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "cuenta.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorCuenta::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "cuenta.repositorio");
    }
}

