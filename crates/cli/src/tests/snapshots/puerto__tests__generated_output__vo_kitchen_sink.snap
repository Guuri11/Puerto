use dominio_cuenta::errores::ErrorCuenta;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de cuenta como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorCuenta) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorCuenta::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCuenta::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorCuenta::Duplicado => StatusCode::CONFLICT,
        ErrorCuenta::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorCuenta::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorCuenta::NameInvalido => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCuenta::SkuInvalido => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCuenta::MiddleNameInvalido => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCuenta::TagInvalido => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCuenta::StatusInvalido => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCuenta::EmailInvalido => StatusCode::UNPROCESSABLE_ENTITY,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorCuenta::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "cuenta.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "cuenta.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "cuenta.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "cuenta.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "cuenta.desconocido");
    }

    #[test]
    fn deberia_mapear_name_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::NameInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "cuenta.name_invalido");
    }

    #[test]
    fn deberia_mapear_sku_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::SkuInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "cuenta.sku_invalido");
    }

    #[test]
    fn deberia_mapear_middle_name_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::MiddleNameInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "cuenta.middle_name_invalido");
    }

    #[test]
    fn deberia_mapear_tag_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::TagInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "cuenta.tag_invalido");
    }

    #[test]
    fn deberia_mapear_status_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCuenta::StatusInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "cuenta.status_invalido");
