=== web/src/contextos/cuenta/vistas/formulario-cuenta.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { separarLista, textoDe, textoOpcional } from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaCuenta } from "../mensajes";

type Cuenta = Esquemas["DtoCuenta"];
type PeticionCuenta = Esquemas["PeticionCrearCuenta"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioCuenta {
  title: string;
  price: string;
  name: string;
  sku: string;
  note: string;
  middleName: string;
  tags: string;
  status: string;
  email: string;
}

/** Los inputs de `cuenta`, vacíos cuando todavía no hay ninguno. */
export function aFormularioCuenta(cuenta: Cuenta | null): ValoresFormularioCuenta {
  if (cuenta === null) {
    return {
      title: "",
      price: "",
      name: "",
      sku: "",
      note: "",
      middleName: "",
      tags: "",
      status: "",
      email: "",
    };
  }
  return {
    title: cuenta.title,
    price: String(cuenta.price),
    name: cuenta.name,
    sku: cuenta.sku,
    note: textoDe(cuenta.note),
    middleName: textoDe(cuenta.middleName),
    tags: cuenta.tags.join(", "),
    status: cuenta.status,
    email: cuenta.email,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionCuenta(valores: ValoresFormularioCuenta): PeticionCuenta {
  return {
    title: valores.title,
    price: Number(valores.price),
    name: valores.name,
    sku: valores.sku,
    note: textoOpcional(valores.note),
    middleName: textoOpcional(valores.middleName),
    tags: separarLista(valores.tags),
    status: valores.status,
    email: valores.email,
  };
}

export function VistaFormularioCuenta({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioCuenta;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaCuenta | null;
  alCambiar: (valores: ValoresFormularioCuenta) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "title"}
          required
          value={valores.title}
          onChange={(event) => alCambiar({ ...valores, title: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Price</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "price"}
          required
          value={valores.price}
          onChange={(event) => alCambiar({ ...valores, price: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="price" />
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "name"}
          required
          value={valores.name}
          onChange={(event) => alCambiar({ ...valores, name: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "sku"}
          required
          value={valores.sku}
          onChange={(event) => alCambiar({ ...valores, sku: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="sku" />
      <label className="fieldset">
        <span className="fieldset-legend">Note</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "note"}
          value={valores.note}
          onChange={(event) => alCambiar({ ...valores, note: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="note" />
      <label className="fieldset">
        <span className="fieldset-legend">Middle name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "middleName"}
          value={valores.middleName}
          onChange={(event) => alCambiar({ ...valores, middleName: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="middleName" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "tags"}
          value={valores.tags}
          onChange={(event) => alCambiar({ ...valores, tags: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "status"}
          required
          value={valores.status}
          onChange={(event) => alCambiar({ ...valores, status: event.target.value })}
        >
          <option value="">Elige una opción</option>
          <option value="Active">Active</option>
          <option value="Archived">Archived</option>
        </select>
      </label>
      <ErrorCampo problema={problema} campo="status" />
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "email"}
          required
          value={valores.email}
          onChange={(event) => alCambiar({ ...valores, email: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="email" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

