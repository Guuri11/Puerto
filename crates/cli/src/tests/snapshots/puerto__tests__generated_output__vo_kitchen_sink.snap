use std::sync::Arc;

use business::domain::account::model::AccountId;
use business::domain::account::use_cases::{
    create_account::{CreateAccountParams, CreateAccountUseCaseTrait},
    delete_account::{DeleteAccountParams, DeleteAccountUseCaseTrait},
    get_account::{GetAccountParams, GetAccountUseCaseTrait},
    list_accounts::{ListAccountsParams, ListAccountsUseCaseTrait},
    update_account::{UpdateAccountParams, UpdateAccountUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::account::dto::{
    AccountDto, AccountPageDto, CreateAccountRequest, UpdateAccountRequest,
};
use crate::api::account::responses::{
    CreateAccountResponse, DeleteAccountResponse, GetAccountResponse, ListAccountsResponse,
    UpdateAccountResponse,
};
use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct AccountApi {
    pub create_account: Arc<dyn CreateAccountUseCaseTrait>,
    pub get_account: Arc<dyn GetAccountUseCaseTrait>,
    pub list_accounts: Arc<dyn ListAccountsUseCaseTrait>,
    pub update_account: Arc<dyn UpdateAccountUseCaseTrait>,
    pub delete_account: Arc<dyn DeleteAccountUseCaseTrait>,
}

#[OpenApi]
impl AccountApi {
    /// Create a new Account
    #[oai(path = "/accounts", method = "post", tag = "ApiTags::Account")]
    async fn create(&self, body: Json<CreateAccountRequest>) -> CreateAccountResponse {
        match self
            .create_account
            .execute(CreateAccountParams {
                title: body.title.clone(),
                price: body.price,
                name: body.name.clone(),
                sku: body.sku.clone(),
                note: body.note.clone(),
                middle_name: body.middle_name.clone(),
                tags: body.tags.clone(),
                status: body.status.clone(),
                email: body.email.clone(),
            })
            .await
        {
            Ok(entity) => CreateAccountResponse::Created(Json(AccountDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_account failed");
                CreateAccountResponse::from_status(status, error)
            }
        }
    }

    /// Get a Account by ID
    #[oai(path = "/accounts/:id", method = "get", tag = "ApiTags::Account")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetAccountResponse {
        match self
            .get_account
            .execute(GetAccountParams {
                id: AccountId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetAccountResponse::Ok(Json(AccountDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_account failed");
                GetAccountResponse::from_status(status, error)
            }
        }
    }

    /// List Accounts, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/accounts", method = "get", tag = "ApiTags::Account")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
    ) -> ListAccountsResponse {
        match self
            .list_accounts
            .execute(ListAccountsParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListAccountsResponse::Ok(Json(AccountPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_accounts failed");
                ListAccountsResponse::from_status(status, error)
            }
        }
    }

    /// Update a Account
    #[oai(path = "/accounts/:id", method = "put", tag = "ApiTags::Account")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdateAccountRequest>,
    ) -> UpdateAccountResponse {
        match self
            .update_account
            .execute(UpdateAccountParams {
                id: AccountId::from_uuid(id.0),
                title: body.title.clone(),
                price: body.price,
                name: body.name.clone(),
                sku: body.sku.clone(),
                note: body.note.clone(),
                middle_name: body.middle_name.clone(),
                tags: body.tags.clone(),
                status: body.status.clone(),
                email: body.email.clone(),
            })
            .await
        {
            Ok(entity) => UpdateAccountResponse::Ok(Json(AccountDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_account failed");
                UpdateAccountResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Account
    #[oai(path = "/accounts/:id", method = "delete", tag = "ApiTags::Account")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteAccountResponse {
        match self
            .delete_account
            .execute(DeleteAccountParams {
                id: AccountId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteAccountResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_account failed");
                DeleteAccountResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::account::errors::AccountError;
    use business::domain::account::use_cases::{
        create_account::mocks::MockCreateAccountUseCase,
        delete_account::mocks::MockDeleteAccountUseCase, get_account::mocks::MockGetAccountUseCase,
        list_accounts::mocks::MockListAccountsUseCase,
        update_account::mocks::MockUpdateAccountUseCase,
    };
    use business::tests::mothers::account_mother::AccountMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateAccountUseCase,
        get: MockGetAccountUseCase,
        list: MockListAccountsUseCase,
        update: MockUpdateAccountUseCase,
        delete: MockDeleteAccountUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = AccountApi {
                create_account: Arc::new(self.create),
                get_account: Arc::new(self.get),
                list_accounts: Arc::new(self.list),
                update_account: Arc::new(self.update),
                delete_account: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateAccountRequest {
        CreateAccountRequest {
            title: "example".to_string(),
            price: 42,
            name: "example".to_string(),
            sku: "example".to_string(),
            note: None,
            middle_name: None,
            tags: vec![],
            status: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn update_request() -> UpdateAccountRequest {
        UpdateAccountRequest {
            title: "example".to_string(),
            price: 42,
            name: "example".to_string(),
            sku: "example".to_string(),
            note: None,
            middle_name: None,
            tags: vec![],
            status: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/accounts/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_account_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(AccountMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/accounts")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_account_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(AccountError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/accounts")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_account_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(AccountMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_account_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(AccountError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_accounts_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(AccountMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/accounts").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/accounts?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(AccountError::RepositoryError));

        // Act
        let response = mocks.client().get("/accounts").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_account_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(AccountMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_account() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(AccountError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_account_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_account() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(AccountError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

