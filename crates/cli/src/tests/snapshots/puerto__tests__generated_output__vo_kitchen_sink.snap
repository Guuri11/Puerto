import { Link } from "wouter";
import type { Account } from "../../../../domain/account/model";

export function AccountListView({ accounts }: { accounts: Account[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Price</th>
            <th>Name</th>
            <th>Sku</th>
            <th>Note</th>
            <th>Middle name</th>
            <th>Tags</th>
            <th>Status</th>
            <th>Email</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {accounts.map((account) => (
            <tr key={account.id}>
              <td>{account.title}</td>
              <td>{account.price}</td>
              <td>{account.name}</td>
              <td>{account.sku}</td>
              <td>{account.note ?? "—"}</td>
              <td>{account.middleName ?? "—"}</td>
              <td>{account.tags.join(", ")}</td>
              <td>{account.status}</td>
              <td>{account.email}</td>
              <td className="text-right">
                <Link href={`/accounts/${account.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/account.ts ===
import { AccountError } from "../domain/account/errors";
import type { Account, AccountDraft } from "../domain/account/model";
import type { AccountRepository } from "../domain/account/repository";

/** Valid accounts for tests; pass `overrides` for the fields a test is about. */
export const AccountMother = {
  draft(overrides: Partial<AccountDraft> = {}): AccountDraft {
    return {
      title: "example",
      price: 42,
      name: "example",
      sku: "example",
      note: "example",
      middleName: "example",
      tags: ["example"],
      status: "Active",
      email: "example",
      ...overrides,
    };
  },

  random(overrides: Partial<Account> = {}): Account {
    return { id: crypto.randomUUID(), ...AccountMother.draft(), ...overrides };
  },
};

/** An in-memory `AccountRepository`. Override a method to make it fail. */
export function fakeAccountRepository(seed: Account[] = []): AccountRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new AccountError("account.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
