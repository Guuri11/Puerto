                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/cuenta.ts ===
import { CuentaError } from "../domain/cuenta/errors";
import type { Cuenta, CuentaDraft } from "../domain/cuenta/model";
import type { CuentaRepository } from "../domain/cuenta/repository";

/** Valid cuentas for tests; pass `overrides` for the fields a test is about. */
export const CuentaMother = {
  draft(overrides: Partial<CuentaDraft> = {}): CuentaDraft {
    return {
      title: "example",
      price: 42,
      name: "example",
      sku: "example",
      note: "example",
      middleName: "example",
      tags: ["example"],
      status: "Active",
      email: "example",
      ...overrides,
    };
  },

  random(overrides: Partial<Cuenta> = {}): Cuenta {
    return { id: crypto.randomUUID(), ...CuentaMother.draft(), ...overrides };
  },
};

/** An in-memory `CuentaRepository`. Override a method to make it fail. */
export function fakeCuentaRepository(seed: Cuenta[] = []): CuentaRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new CuentaError("cuenta.no_encontrado");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
