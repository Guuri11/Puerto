import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { CuentaError } from "../../../../domain/cuenta/errors";
import { CuentaMother, fakeCuentaRepository } from "../../../../test-support/cuenta";
import { renderScreen } from "../../../../test-support/render";
import { CuentaListContainer } from "./cuenta-list-container";

describe("CuentaListContainer", () => {
  test("should show a row per cuenta when there are some", async () => {
    // Arrange
    const seed = [CuentaMother.random(), CuentaMother.random()];
    const cuentaRepository = fakeCuentaRepository(seed);

    // Act
    renderScreen(<CuentaListContainer />, { cuentaRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => CuentaMother.random());
    const cuentaRepository = fakeCuentaRepository(seed);
    renderScreen(<CuentaListContainer />, { cuentaRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => CuentaMother.random());
    const cuentaRepository = fakeCuentaRepository(seed);
    const path = "/cuentas?page=2";

    // Act
    renderScreen(<CuentaListContainer />, { cuentaRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no cuenta", async () => {
    // Arrange
    const cuentaRepository = fakeCuentaRepository();

    // Act
    renderScreen(<CuentaListContainer />, { cuentaRepository });

    // Assert
    expect(await screen.findByText("No cuentas yet.")).toBeTruthy();
  });

  test("should show the error code when the cuentas cannot be listed", async () => {
    // Arrange
    const cuentaRepository = {
      ...fakeCuentaRepository(),
      list: () => Promise.reject(new CuentaError("cuenta.repositorio")),
    };

    // Act
    renderScreen(<CuentaListContainer />, { cuentaRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("cuenta.repositorio");
  });
});

=== web/src/presentation/features/cuenta/containers/cuenta-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { CuentaListView } from "../views/cuenta-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function CuentaListContainer() {
  const { cuentaRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const cuentas = useAsync(
    () => cuentaRepository.list({ limit: PAGE_SIZE, offset }),
    [cuentaRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Cuentas</h1>
        <Link href="/cuentas/new" className="btn btn-primary">
          New cuenta
        </Link>
      </div>
      {cuentas.status === "loading" && <span className="loading loading-spinner" />}
      {cuentas.status === "error" && <ErrorAlert error={cuentas.error} />}
      {cuentas.status === "ok" &&
        (cuentas.data.total === 0 ? (
          <EmptyState message="No cuentas yet." />
        ) : (
          <>
            <CuentaListView cuentas={cuentas.data.items} />
            <Pagination {...cuentas.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

