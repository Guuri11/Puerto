=== web/src/presentation/features/account/views/account-form-view.tsx ===
import type { AccountProblem } from "../../../../domain/account/messages";
import { type Account, type AccountDraft, parseStatus } from "../../../../domain/account/model";
import { splitList, textOf, textOrNull } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface AccountFormValues {
  title: string;
  price: string;
  name: string;
  sku: string;
  note: string;
  middleName: string;
  tags: string;
  status: string;
  email: string;
}

/** The inputs for `account`, empty when there is none yet. */
export function toAccountForm(account: Account | null): AccountFormValues {
  if (account === null) {
    return {
      title: "",
      price: "",
      name: "",
      sku: "",
      note: "",
      middleName: "",
      tags: "",
      status: "",
      email: "",
    };
  }
  return {
    title: account.title,
    price: String(account.price),
    name: account.name,
    sku: account.sku,
    note: textOf(account.note),
    middleName: textOf(account.middleName),
    tags: account.tags.join(", "),
    status: account.status,
    email: account.email,
  };
}

export function toAccountDraft(values: AccountFormValues): AccountDraft {
  return {
    title: values.title,
    price: Number(values.price),
    name: values.name,
    sku: values.sku,
    note: textOrNull(values.note),
    middleName: textOrNull(values.middleName),
    tags: splitList(values.tags),
    status: parseStatus(values.status),
    email: values.email,
  };
}

export function AccountFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: AccountFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: AccountProblem | null;
  onChange: (values: AccountFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "title"}
          required
          value={values.title}
          onChange={(event) => onChange({ ...values, title: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Price</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "price"}
          required
          value={values.price}
          onChange={(event) => onChange({ ...values, price: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="price" />
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "name"}
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "sku"}
          required
          value={values.sku}
          onChange={(event) => onChange({ ...values, sku: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="sku" />
      <label className="fieldset">
        <span className="fieldset-legend">Note</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "note"}
          value={values.note}
          onChange={(event) => onChange({ ...values, note: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="note" />
      <label className="fieldset">
        <span className="fieldset-legend">Middle name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "middleName"}
          value={values.middleName}
          onChange={(event) => onChange({ ...values, middleName: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="middleName" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "tags"}
          value={values.tags}
          onChange={(event) => onChange({ ...values, tags: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "status"}
          required
          value={values.status}
          onChange={(event) => onChange({ ...values, status: event.target.value })}
        >
          <option value="">Choose…</option>
          <option value="Active">Active</option>
          <option value="Archived">Archived</option>
        </select>
      </label>
      <FieldError problem={problem} field="status" />
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "email"}
          required
          value={values.email}
          onChange={(event) => onChange({ ...values, email: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="email" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

