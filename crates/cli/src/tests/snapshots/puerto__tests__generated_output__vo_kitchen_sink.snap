use async_trait::async_trait;
use dominio_cuenta::errores::ErrorCuenta;
use dominio_cuenta::modelo::Cuenta;
use dominio_cuenta::repositorio::RepositorioCuenta;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarCuentas {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarCuentas: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarCuentas) -> Result<Pagina<Cuenta>, ErrorCuenta>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarCuentas {}

        #[async_trait]
        impl ListarCuentas for ListarCuentas {
            async fn ejecutar(&self, params: ParamsListarCuentas) -> Result<Pagina<Cuenta>, ErrorCuenta>;
        }
    }
}

pub struct ListarCuentasImpl {
    pub repositorio: Arc<dyn RepositorioCuenta>,
}

#[async_trait]
impl ListarCuentas for ListarCuentasImpl {
    async fn ejecutar(&self, params: ParamsListarCuentas) -> Result<Pagina<Cuenta>, ErrorCuenta> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_cuentas: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_cuentas: fallo del repositorio"))
            .map_err(ErrorCuenta::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_cuenta::{
        pruebas::madres::MadreCuenta, repositorio::dobles::MockRepositorioCuenta,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_cuentas() {
        let entidades = MadreCuenta::aleatorios(2);
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarCuentasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCuentas {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_cuentas() {
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarCuentasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCuentas {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarCuentasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCuentas {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

