use std::sync::Arc;

use aplicacion_cuenta::{
    actualizar_cuenta::{ActualizarCuenta, ParamsActualizarCuenta},
    borrar_cuenta::{BorrarCuenta, ParamsBorrarCuenta},
    crear_cuenta::{CrearCuenta, ParamsCrearCuenta},
    listar_cuentas::{ListarCuentas, ParamsListarCuentas},
    obtener_cuenta::{ObtenerCuenta, ParamsObtenerCuenta},
};
use dominio_cuenta::modelo::IdCuenta;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoCuenta, DtoPaginaCuenta, PeticionActualizarCuenta, PeticionCrearCuenta};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarCuenta, RespuestaBorrarCuenta, RespuestaCrearCuenta, RespuestaListarCuentas,
    RespuestaObtenerCuenta,
};

#[derive(Tags)]
enum ApiTags {
    Cuenta,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiCuenta {
    pub crear_cuenta: Arc<dyn CrearCuenta>,
    pub obtener_cuenta: Arc<dyn ObtenerCuenta>,
    pub listar_cuentas: Arc<dyn ListarCuentas>,
    pub actualizar_cuenta: Arc<dyn ActualizarCuenta>,
    pub borrar_cuenta: Arc<dyn BorrarCuenta>,
}

#[OpenApi]
impl ApiCuenta {
    /// Crea: Cuenta
    #[oai(path = "/cuentas", method = "post", tag = "ApiTags::Cuenta")]
    async fn crear(&self, cuerpo: Json<PeticionCrearCuenta>) -> RespuestaCrearCuenta {
        match self
            .crear_cuenta
            .ejecutar(ParamsCrearCuenta {
                title: cuerpo.title.clone(),
                price: cuerpo.price,
                name: cuerpo.name.clone(),
                sku: cuerpo.sku.clone(),
                note: cuerpo.note.clone(),
                middle_name: cuerpo.middle_name.clone(),
                tags: cuerpo.tags.clone(),
                status: cuerpo.status.clone(),
                email: cuerpo.email.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearCuenta::Creado(Json(DtoCuenta::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_cuenta falló");
                RespuestaCrearCuenta::from_status(status, error)
            }
        }
    }

    /// Obtiene: Cuenta por id
    #[oai(path = "/cuentas/:id", method = "get", tag = "ApiTags::Cuenta")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerCuenta {
        match self
            .obtener_cuenta
            .ejecutar(ParamsObtenerCuenta {
                id: IdCuenta::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerCuenta::Ok(Json(DtoCuenta::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_cuenta falló");
                RespuestaObtenerCuenta::from_status(status, error)
            }
        }
    }

    /// Lista Cuentas, página a página (el dominio acota `limite`)
    #[oai(path = "/cuentas", method = "get", tag = "ApiTags::Cuenta")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarCuentas {
        match self
            .listar_cuentas
            .ejecutar(ParamsListarCuentas {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => RespuestaListarCuentas::Ok(Json(DtoPaginaCuenta::from_dominio(&pagina))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_cuentas falló");
                RespuestaListarCuentas::from_status(status, error)
            }
        }
    }

    /// Actualiza: Cuenta
    #[oai(path = "/cuentas/:id", method = "put", tag = "ApiTags::Cuenta")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarCuenta>,
    ) -> RespuestaActualizarCuenta {
        match self
            .actualizar_cuenta
            .ejecutar(ParamsActualizarCuenta {
                id: IdCuenta::from_uuid(id.0),
                title: cuerpo.title.clone(),
                price: cuerpo.price,
                name: cuerpo.name.clone(),
                sku: cuerpo.sku.clone(),
                note: cuerpo.note.clone(),
                middle_name: cuerpo.middle_name.clone(),
                tags: cuerpo.tags.clone(),
                status: cuerpo.status.clone(),
                email: cuerpo.email.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarCuenta::Ok(Json(DtoCuenta::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_cuenta falló");
                RespuestaActualizarCuenta::from_status(status, error)
            }
        }
    }

    /// Borra: Cuenta
    #[oai(path = "/cuentas/:id", method = "delete", tag = "ApiTags::Cuenta")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarCuenta {
        match self
            .borrar_cuenta
            .ejecutar(ParamsBorrarCuenta {
                id: IdCuenta::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarCuenta::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_cuenta falló");
                RespuestaBorrarCuenta::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_cuenta::{
        actualizar_cuenta::dobles::MockActualizarCuenta, borrar_cuenta::dobles::MockBorrarCuenta,
        crear_cuenta::dobles::MockCrearCuenta, listar_cuentas::dobles::MockListarCuentas,
        obtener_cuenta::dobles::MockObtenerCuenta,
    };
    use dominio_cuenta::errores::ErrorCuenta;
    use dominio_cuenta::pruebas::madres::MadreCuenta;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearCuenta,
        obtener: MockObtenerCuenta,
        listar: MockListarCuentas,
        actualizar: MockActualizarCuenta,
        borrar: MockBorrarCuenta,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiCuenta {
                crear_cuenta: Arc::new(self.crear),
                obtener_cuenta: Arc::new(self.obtener),
                listar_cuentas: Arc::new(self.listar),
                actualizar_cuenta: Arc::new(self.actualizar),
                borrar_cuenta: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearCuenta {
        PeticionCrearCuenta {
            title: "example".to_string(),
            price: 42,
            name: "example".to_string(),
            sku: "example".to_string(),
            note: None,
            middle_name: None,
            tags: vec![],
            status: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarCuenta {
        PeticionActualizarCuenta {
            title: "example".to_string(),
            price: 42,
            name: "example".to_string(),
            sku: "example".to_string(),
            note: None,
            middle_name: None,
            tags: vec![],
            status: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/cuentas/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_cuenta() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreCuenta::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/cuentas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_cuenta_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorCuenta::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/cuentas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_cuenta_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreCuenta::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_cuenta_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorCuenta::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_cuentas_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreCuenta::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/cuentas").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/cuentas?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCuenta::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/cuentas").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_cuenta() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreCuenta::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_cuenta_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCuenta::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_cuenta() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_cuenta_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCuenta::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

=== contextos/saludo/aplicacion/src/obtener_saludo.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo, repositorio::RepositorioSaludo};

#[derive(Debug, Clone)]
pub struct ParamsObtenerSaludo {
    pub nombre: String,
}

#[async_trait]
pub trait ObtenerSaludo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerSaludo {}

        #[async_trait]
        impl ObtenerSaludo for ObtenerSaludo {
            async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
        }
    }
}

pub struct ObtenerSaludoImpl {
    pub repositorio: Arc<dyn RepositorioSaludo>,
}

#[async_trait]
impl ObtenerSaludo for ObtenerSaludoImpl {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo> {
        tracing::info!(nombre = %params.nombre, "obtener_saludo: inicio");

        if params.nombre.trim().is_empty() {
            let err = ErrorSaludo::Validacion("nombre_vacio".into());
            tracing::warn!(error = %err, "obtener_saludo: rechazado");
            return Err(err);
        }

        let resultado = match self
            .repositorio
            .buscar_por_nombre(&params.nombre)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "obtener_saludo: fallo del repositorio"))?
        {
            Some(saludo) => saludo,
            None => Saludo::new(&params.nombre)?,
        };

        tracing::info!("obtener_saludo: fin");
        Ok(resultado)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_saludo::repositorio::dobles::MockRepositorioSaludo;

    #[tokio::test]
    async fn deberia_devolver_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(|_| Ok(None));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Mundo".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let saludo = resultado.unwrap();
        assert_eq!(saludo.nombre, "Mundo");
        assert!(saludo.mensaje.contains("Mundo"));
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_el_nombre_esta_vacio() {
        // Preparar
        let repositorio_doble = MockRepositorioSaludo::new();
        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo { nombre: "".into() })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "saludo.validacion.nombre_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_el_saludo_guardado_cuando_esta_en_el_repositorio() {
        // Preparar
        let en_cache = Saludo {
            nombre: "Puerto".into(),
            mensaje: "¡Hola desde la caché!".into(),
        };
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(move |_| Ok(Some(en_cache.clone())));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Puerto".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().mensaje, "¡Hola desde la caché!");
    }
}

