            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "account.invalid_email");
    }
}

=== business/src/application/account/delete_account.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::account::{
    errors::AccountError,
    repository::AccountRepositoryTrait,
    use_cases::delete_account::{DeleteAccountParams, DeleteAccountUseCaseTrait},
};

pub struct DeleteAccountUseCaseImpl {
    pub repository: Arc<dyn AccountRepositoryTrait>,
}

#[async_trait]
impl DeleteAccountUseCaseTrait for DeleteAccountUseCaseImpl {
    async fn execute(&self, params: DeleteAccountParams) -> Result<(), AccountError> {
        tracing::info!(id = %params.id, "delete_account: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_account: repository failed"))?
            .ok_or_else(|| {
                let err = AccountError::NotFound;
                tracing::warn!(error = %err, "delete_account: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_account: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::account::value_objects::Name;
    use crate::domain::account::value_objects::Sku;
    use crate::domain::account::value_objects::Status;
    use crate::domain::account::{
        model::{Account, AccountId, AccountProps},
        repository::mocks::MockAccountRepository,
    };
    use crate::domain::shared::value_objects::Email;

    #[tokio::test]
    async fn should_soft_delete_account_when_id_exists() {
        let entity = Account::new(AccountProps {
            title: "example".to_string(),
            price: 42,
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            note: None,
            middle_name: None,
            tags: vec![],
            status: Status::Active,
            email: Email::new("example".to_string()).expect("valid Email"),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockAccountRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteAccountUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteAccountParams { id: entity_id })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_account_does_not_exist() {
        let mut mock_repo = MockAccountRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteAccountUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteAccountParams {
                id: AccountId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "account.not_found");
    }
}

=== business/src/application/account/get_account.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::account::{
    errors::AccountError,
    model::Account,
    repository::AccountRepositoryTrait,
    use_cases::get_account::{GetAccountParams, GetAccountUseCaseTrait},
};

pub struct GetAccountUseCaseImpl {
    pub repository: Arc<dyn AccountRepositoryTrait>,
}

#[async_trait]
impl GetAccountUseCaseTrait for GetAccountUseCaseImpl {
    async fn execute(&self, params: GetAccountParams) -> Result<Account, AccountError> {
        tracing::info!(id = %params.id, "get_account: start");
        let result = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "get_account: repository failed"))?;
        result.ok_or_else(|| {
            let err = AccountError::NotFound;
            tracing::warn!(error = %err, "get_account: rejected");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::account::value_objects::Name;
    use crate::domain::account::value_objects::Sku;
    use crate::domain::account::value_objects::Status;
    use crate::domain::account::{
        model::{Account, AccountId, AccountProps},
        repository::mocks::MockAccountRepository,
    };
    use crate::domain::shared::value_objects::Email;
    use puerto_core::RepositoryError;

    #[tokio::test]
    async fn should_return_account_when_id_exists() {
        let entity = Account::new(AccountProps {
            title: "example".to_string(),
            price: 42,
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            note: None,
            middle_name: None,
            tags: vec![],
            status: Status::Active,
            email: Email::new("example".to_string()).expect("valid Email"),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockAccountRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = GetAccountUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(GetAccountParams { id: entity_id }).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_not_found_when_id_does_not_exist() {
        let mut mock_repo = MockAccountRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = GetAccountUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetAccountParams {
                id: AccountId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "account.not_found");
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_store_is_unavailable() {
        let mut mock_repo = MockAccountRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(|_| Err(RepositoryError::Unavailable));
        let use_case = GetAccountUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetAccountParams {
                id: AccountId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "account.repository_error");
    }
}

