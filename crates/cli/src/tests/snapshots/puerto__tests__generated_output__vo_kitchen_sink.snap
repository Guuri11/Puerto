=== web/src/api/cliente.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { components, paths } from "./esquema";

/** El cliente tipado de la API. `paths` sale de la especificación del backend (`make web/sync`). */
export type ClienteApi = Client<paths>;

/** Los DTO de la API por nombre: `Esquemas["DtoProducto"]`, `Esquemas["PeticionCrearProducto"]`. */
export type Esquemas = components["schemas"];

/** `/api` es el backend: en desarrollo, Vite lo pasa a `:8080`. */
export function crearClienteApi(opciones: ClientOptions = {}): ClienteApi {
  return createClient<paths>({ baseUrl: "/api", ...opciones });
}

=== web/src/contextos/cuenta/contenedores/detalle-cuenta.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCuenta, MadreCuenta } from "../../../pruebas/cuenta";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleCuenta } from "./detalle-cuenta";

describe("ContenedorDetalleCuenta", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreCuenta.aleatorio();
    const api = apiFalsa([coleccionCuenta([sembrado])]);

    const pantalla = <ContenedorDetalleCuenta id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionCuenta()]);
    const pantalla = <ContenedorDetalleCuenta id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("cuenta.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreCuenta.aleatorio();
    const guardados = coleccionCuenta([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleCuenta id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/cuentas"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/cuenta/contenedores/detalle-cuenta.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleCuenta } from "../vistas/detalle-cuenta";

export function ContenedorDetalleCuenta({ id }: { id: string }) {
  const { api } = useDependencias();
  const cuenta = useCarga(
    () => desenvolver(api.GET("/cuentas/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/cuentas/{id}", { params: { path: { id } } }));
      navegar("/cuentas");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Cuenta</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {cuenta.estado === "cargando" && <span className="loading loading-spinner" />}
      {cuenta.estado === "error" && <AlertaError error={cuenta.error} />}
      {cuenta.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleCuenta cuenta={cuenta.datos} />
            <div className="card-actions justify-end">
              <Link href={`/cuentas/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/cuentas" className="link">
        Volver a cuentas
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar cuenta?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/cuenta/contenedores/formulario-cuenta.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { textoDe } from "../../../compartido/formularios";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCuenta, MadreCuenta } from "../../../pruebas/cuenta";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorFormularioCuenta } from "./formulario-cuenta";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearCuenta"]) {
  await screen.findByText("Guardar");
  escribir("Title", peticion.title);
  escribir("Price", String(peticion.price));
  escribir("Name", peticion.name);
  escribir("Sku", peticion.sku);
  escribir("Note", textoDe(peticion.note));
  escribir("Middle name", textoDe(peticion.middleName));
  escribir("Tags", peticion.tags.join(", "));
  escribir("Status", peticion.status);
  escribir("Email", peticion.email);
}

describe("ContenedorFormularioCuenta", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreCuenta.peticion();
    const guardados = coleccionCuenta();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioCuenta />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/cuentas/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/cuentas/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreCuenta.aleatorio();
    const guardados = coleccionCuenta([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioCuenta id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/cuentas/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreCuenta.peticion();
    const codigo = "cuenta.validacion.invalido";
    const fallos = { "POST /cuentas": codigo };
    const api = apiFalsa([coleccionCuenta()], fallos);
    renderizarPantalla(<ContenedorFormularioCuenta />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreCuenta.peticion();
    const fallos = { "POST /cuentas": "cuenta.duplicado" };
    const api = apiFalsa([coleccionCuenta()], fallos);
    renderizarPantalla(<ContenedorFormularioCuenta />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("Estos valores ya están en uso");
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreCuenta.peticion();
    const fallos = { "POST /cuentas": "cuenta.validacion.title_vacio" };
    const api = apiFalsa([coleccionCuenta()], fallos);
    renderizarPantalla(<ContenedorFormularioCuenta />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText("Title: obligatorio")).toBeTruthy();
    const campo = screen.getByLabelText("Title");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/cuenta/contenedores/formulario-cuenta.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioCuenta,
  aPeticionCuenta,
  VistaFormularioCuenta,
} from "../vistas/formulario-cuenta";

type Cuenta = Esquemas["DtoCuenta"];

/** Crear, o editar con `id`: el formulario de cuentas. */
export function ContenedorFormularioCuenta({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/cuentas/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear cuenta" : "Editar cuenta";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioCuenta existente={existente.datos} />}
      <Link href={id === undefined ? "/cuentas" : `/cuentas/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioCuenta({ existente }: { existente: Cuenta | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioCuenta(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionCuenta(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/cuentas", { body: cuerpo })
          : api.PUT("/cuentas/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/cuentas/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioCuenta
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/cuenta/contenedores/lista-cuenta.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCuenta, MadreCuenta } from "../../../pruebas/cuenta";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaCuenta } from "./lista-cuenta";

describe("ContenedorListaCuenta", () => {
  test("debería mostrar una fila por cada cuenta", async () => {
    // Preparar
    const semilla = [MadreCuenta.aleatorio(), MadreCuenta.aleatorio()];
    const api = apiFalsa([coleccionCuenta(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaCuenta />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreCuenta.aleatorio());
    const api = apiFalsa([coleccionCuenta(semilla)]);
    renderizarPantalla(<ContenedorListaCuenta />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreCuenta.aleatorio());
    const api = apiFalsa([coleccionCuenta(semilla)]);
    const ruta = "/cuentas?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaCuenta />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay cuentas", async () => {
    // Preparar
    const api = apiFalsa([coleccionCuenta()]);

    // Actuar
    renderizarPantalla(<ContenedorListaCuenta />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay cuentas.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /cuentas": "cuenta.repositorio" };
    const api = apiFalsa([coleccionCuenta()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaCuenta />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("cuenta.repositorio");
  });
});

=== web/src/contextos/cuenta/contenedores/lista-cuenta.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaCuenta } from "../vistas/lista-cuenta";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaCuenta() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const cuentas = useCarga(
    () => desenvolver(api.GET("/cuentas", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Cuentas</h1>
        <Link href="/cuentas/nuevo" className="btn btn-primary">
          Crear cuenta
        </Link>
      </div>
      {cuentas.estado === "cargando" && <span className="loading loading-spinner" />}
      {cuentas.estado === "error" && <AlertaError error={cuentas.error} />}
      {cuentas.estado === "listo" &&
        (cuentas.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay cuentas." />
        ) : (
          <>
            <VistaListaCuenta cuentas={cuentas.datos.elementos} />
            <Paginacion
              total={cuentas.datos.total}
              limite={cuentas.datos.limite}
              desplazamiento={cuentas.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/cuenta/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaCuenta {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "cuenta.validacion.title_vacio": "Title: obligatorio",
  "cuenta.name_invalido": "Name: no válido",
  "cuenta.sku_invalido": "Sku: no válido",
  "cuenta.middle_name_invalido": "Middle name: no válido",
  "cuenta.tag_invalido": "Tags: no válido",
  "cuenta.status_invalido": "Status: no válido",
  "cuenta.email_invalido": "Email: no válido",
  "cuenta.duplicado": "Estos valores ya están en uso",
  "cuenta.no_encontrado": "Ya no existe",
  "cuenta.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "cuenta.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "cuenta.validacion.title_vacio": "title",
  "cuenta.name_invalido": "name",
  "cuenta.sku_invalido": "sku",
  "cuenta.middle_name_invalido": "middleName",
  "cuenta.tag_invalido": "tags",
  "cuenta.status_invalido": "status",
  "cuenta.email_invalido": "email",
};

export function aProblema(codigo: string): ProblemaCuenta {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

