=== business/src/domain/account/value_objects.rs ===
use super::errors::AccountError;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    value: String,
}

impl Name {
    pub fn new(value: String) -> Result<Self, AccountError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(AccountError::InvalidName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    value: String,
}

impl Sku {
    pub fn new(value: String) -> Result<Self, AccountError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(AccountError::InvalidSku);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    value: String,
}

impl MiddleName {
    pub fn new(value: String) -> Result<Self, AccountError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(AccountError::InvalidMiddleName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Tag {
    value: String,
}

impl Tag {
    pub fn new(value: String) -> Result<Self, AccountError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(AccountError::InvalidTag);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Active,
    Archived,
}

impl std::str::FromStr for Status {
    type Err = AccountError;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Active" => Ok(Self::Active),
            "Archived" => Ok(Self::Archived),
            _ => Err(AccountError::InvalidStatus),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Active => "Active",
            Self::Archived => "Archived",
        }
    }
}

