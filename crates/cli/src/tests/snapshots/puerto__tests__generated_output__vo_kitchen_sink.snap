        // Preparar
        let props = MadreCuenta::new().construir_props();
        let mut entidad = MadreCuenta::aleatorio();
        // Lo que estaba guardado, distinto de lo que trae la actualización.
        entidad.title = "original".to_string();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_por_id()
