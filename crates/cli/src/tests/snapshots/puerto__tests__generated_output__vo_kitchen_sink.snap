use dominio_cuenta::modelo::Cuenta;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoCuenta {
    pub id: Uuid,
    pub title: String,
    pub price: i64,
    pub name: String,
    pub sku: String,
    pub note: Option<String>,
    pub middle_name: Option<String>,
    pub tags: Vec<String>,
    pub status: String,
    pub email: String,
}

impl DtoCuenta {
    pub fn from_dominio(entidad: &Cuenta) -> Self {
        Self {
            id: entidad.id.valor(),
            title: entidad.title.clone(),
            price: entidad.price,
            name: entidad.name.valor().to_string(),
            sku: entidad.sku.valor().to_string(),
            note: entidad.note.clone(),
            middle_name: entidad.middle_name.as_ref().map(|v| v.valor().to_string()),
            tags: entidad
                .tags
                .iter()
                .map(|v| v.valor().to_string())
                .collect::<Vec<_>>(),
            status: entidad.status.as_str().to_string(),
            email: entidad.email.valor().to_string(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearCuenta {
    pub title: String,
    pub price: i64,
    pub name: String,
    pub sku: String,
    pub note: Option<String>,
    pub middle_name: Option<String>,
    pub tags: Vec<String>,
    pub status: String,
    pub email: String,
}

/// Una página de Cuentas: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaCuenta {
    pub elementos: Vec<DtoCuenta>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaCuenta {
    pub fn from_dominio(pagina: &Pagina<Cuenta>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoCuenta::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarCuenta {
    pub title: String,
