import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { AccountMother, fakeAccountRepository } from "../../../../test-support/account";
import { renderScreen } from "../../../../test-support/render";
import { AccountDetailContainer } from "./account-detail-container";

describe("AccountDetailContainer", () => {
  test("should show the account when it exists", async () => {
    // Arrange
    const seeded = AccountMother.random();
    const accountRepository = fakeAccountRepository([seeded]);

    // Act
    renderScreen(<AccountDetailContainer id={seeded.id} />, { accountRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the account does not exist", async () => {
    // Arrange
    const accountRepository = fakeAccountRepository();

    // Act
    renderScreen(<AccountDetailContainer id={crypto.randomUUID()} />, { accountRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("account.not_found");
  });

  test("should delete the account only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = AccountMother.random();
    const fake = fakeAccountRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<AccountDetailContainer id={seeded.id} />, {
      accountRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/accounts"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/account/containers/account-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { AccountDetailView } from "../views/account-detail-view";

export function AccountDetailContainer({ id }: { id: string }) {
  const { accountRepository } = useDependencies();
  const account = useAsync(() => accountRepository.get(id), [accountRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await accountRepository.remove(id);
      navigate("/accounts");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Account</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {account.status === "loading" && <span className="loading loading-spinner" />}
      {account.status === "error" && <ErrorAlert error={account.error} />}
      {account.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <AccountDetailView account={account.data} />
            <div className="card-actions justify-end">
              <Link href={`/accounts/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/accounts" className="link">
        Back to accounts
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this account?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

