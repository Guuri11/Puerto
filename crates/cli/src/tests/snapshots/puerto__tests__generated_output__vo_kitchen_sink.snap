import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { AccountError } from "../../../../domain/account/errors";
import type { AccountDraft } from "../../../../domain/account/model";
import { AccountMother, fakeAccountRepository } from "../../../../test-support/account";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { AccountFormContainer } from "./account-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: AccountDraft) {
  await screen.findByText("Save");
  type("Title", draft.title);
  type("Price", String(draft.price));
  type("Name", draft.name);
  type("Sku", draft.sku);
  type("Note", textOf(draft.note));
  type("Middle name", textOf(draft.middleName));
  type("Tags", draft.tags.join(", "));
  type("Status", draft.status);
  type("Email", draft.email);
}

describe("AccountFormContainer", () => {
  test("should create the account from what was typed and show it", async () => {
    // Arrange
    const draft = AccountMother.draft();
    const accountRepository = fakeAccountRepository();
    const { history } = renderScreen(<AccountFormContainer />, { accountRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/accounts/"));
    const {
      items: [created],
    } = await accountRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/accounts/${created?.id}`);
  });

  test("should save the edited account when an existing one is submitted", async () => {
    // Arrange
    const seeded = AccountMother.random();
    const accountRepository = fakeAccountRepository([seeded]);
    const { history } = renderScreen(<AccountFormContainer id={seeded.id} />, {
      accountRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/accounts/${seeded.id}`));
    expect(await accountRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "account.validation_error.invalid";
    const accountRepository = {
      ...fakeAccountRepository(),
      create: () => Promise.reject(new AccountError(code)),
    };
    renderScreen(<AccountFormContainer />, { accountRepository });
    await fillIn(AccountMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a account with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const accountRepository = {
      ...fakeAccountRepository(),
      create: () => Promise.reject(new AccountError("account.duplicate")),
    };
    renderScreen(<AccountFormContainer />, { accountRepository });
    await fillIn(AccountMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An account with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const accountRepository = {
      ...fakeAccountRepository(),
      create: () => Promise.reject(new AccountError("account.validation_error.title_empty")),
    };
    renderScreen(<AccountFormContainer />, { accountRepository });
    await fillIn(AccountMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Title is required")).toBeTruthy();
    const input = screen.getByLabelText("Title");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/account/containers/account-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/account/messages";
import type { Account } from "../../../../domain/account/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { AccountFormView, toAccountDraft, toAccountForm } from "../views/account-form-view";

/** Creates an account, or edits the one with `id`. */
export function AccountFormContainer({ id }: { id?: string }) {
  const { accountRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : accountRepository.get(id)),
    [accountRepository, id],
  );
  const title = id === undefined ? "New account" : "Edit account";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <AccountForm existing={existing.data} />}
      <Link href={id === undefined ? "/accounts" : `/accounts/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function AccountForm({ existing }: { existing: Account | null }) {
  const { accountRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toAccountForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toAccountDraft(values);
      const saved =
        existing === null
          ? await accountRepository.create(draft)
          : await accountRepository.update(existing.id, draft);
      navigate(`/accounts/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <AccountFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

