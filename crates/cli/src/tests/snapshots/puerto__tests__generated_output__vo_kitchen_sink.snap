use async_trait::async_trait;
use dominio_cuenta::errores::ErrorCuenta;
use dominio_cuenta::modelo::IdCuenta;
use dominio_cuenta::repositorio::RepositorioCuenta;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarCuenta {
    pub id: IdCuenta,
}

#[async_trait]
pub trait BorrarCuenta: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarCuenta) -> Result<(), ErrorCuenta>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarCuenta {}

        #[async_trait]
        impl BorrarCuenta for BorrarCuenta {
            async fn ejecutar(&self, params: ParamsBorrarCuenta) -> Result<(), ErrorCuenta>;
        }
    }
}

pub struct BorrarCuentaImpl {
    pub repositorio: Arc<dyn RepositorioCuenta>,
}

#[async_trait]
impl BorrarCuenta for BorrarCuentaImpl {
    async fn ejecutar(&self, params: ParamsBorrarCuenta) -> Result<(), ErrorCuenta> {
        tracing::info!(id = %params.id, "borrar_cuenta: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_cuenta: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = ErrorCuenta::NoEncontrado;
                tracing::warn!(error = %err, "borrar_cuenta: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_cuenta: fallo del repositorio"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_cuenta::valores::Name;
    use dominio_cuenta::valores::Sku;
    use dominio_cuenta::valores::Status;
    use dominio_cuenta::{
        modelo::{Cuenta, IdCuenta, PropsCuenta},
        repositorio::dobles::MockRepositorioCuenta,
    };
    use nucleo::valores::Email;

    #[tokio::test]
    async fn deberia_hacer_borrado_logico_de_cuenta_cuando_el_id_existe() {
        let entidad = Cuenta::new(PropsCuenta {
            title: "example".to_string(),
            price: 42,
            name: Name::new("example".to_string()).expect("el literal de Name es válido"),
            sku: Sku::new("example".to_string()).expect("el literal de Sku es válido"),
            note: None,
            middle_name: None,
            tags: vec![],
            status: Status::Active,
            email: Email::new("example".to_string()).expect("el literal de Email es válido"),
        })
        .unwrap();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = BorrarCuentaImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarCuenta { id: id_entidad })
