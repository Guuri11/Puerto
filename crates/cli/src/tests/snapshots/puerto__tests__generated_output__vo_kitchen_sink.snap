        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = ActualizarCuentaImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarCuenta {
                id: id_entidad,
                title: props.title,
                price: props.price,
                name: props.name.valor().to_string(),
                sku: props.sku.valor().to_string(),
                note: props.note,
                middle_name: props.middle_name.as_ref().map(|v| v.valor().to_string()),
