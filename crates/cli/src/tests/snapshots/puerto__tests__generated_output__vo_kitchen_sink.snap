=== contextos/cuenta/aplicacion/src/crear_cuenta.rs ===
use async_trait::async_trait;
use dominio_cuenta::errores::ErrorCuenta;
use dominio_cuenta::modelo::{Cuenta, PropsCuenta};
use dominio_cuenta::repositorio::RepositorioCuenta;
use dominio_cuenta::valores::{MiddleName, Name, Sku, Status, Tag};
use nucleo::valores::Email;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearCuenta {
    pub title: String,
    pub price: i64,
    pub name: String,
    pub sku: String,
    pub note: Option<String>,
    pub middle_name: Option<String>,
    pub tags: Vec<String>,
    pub status: String,
    pub email: String,
}

#[async_trait]
pub trait CrearCuenta: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearCuenta) -> Result<Cuenta, ErrorCuenta>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearCuenta {}

        #[async_trait]
        impl CrearCuenta for CrearCuenta {
            async fn ejecutar(&self, params: ParamsCrearCuenta) -> Result<Cuenta, ErrorCuenta>;
        }
    }
}

pub struct CrearCuentaImpl {
    pub repositorio: Arc<dyn RepositorioCuenta>,
}

#[async_trait]
impl CrearCuenta for CrearCuentaImpl {
    async fn ejecutar(&self, params: ParamsCrearCuenta) -> Result<Cuenta, ErrorCuenta> {
        tracing::info!("crear_cuenta: inicio");
        let name = Name::new(params.name)?;
        let sku = Sku::new(params.sku)?;
        let middle_name = params.middle_name.map(MiddleName::new).transpose()?;
        let tags: Vec<Tag> = params
            .tags
            .into_iter()
            .map(Tag::new)
            .collect::<Result<Vec<_>, _>>()?;
        let status = params.status.parse::<Status>()?;
        let email = Email::new(params.email).map_err(|_| ErrorCuenta::EmailInvalido)?;
        let entidad = Cuenta::new(PropsCuenta {
            title: params.title,
            price: params.price,
            name,
            sku,
            note: params.note,
            middle_name,
            tags,
            status,
            email,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_cuenta: rechazado"))?;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "crear_cuenta: fallo del repositorio"))?;
        tracing::info!(id = %entidad.id, "crear_cuenta: fin");
        Ok(entidad)
    }
}

