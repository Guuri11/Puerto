use async_trait::async_trait;
use dominio_cuenta::errores::ErrorCuenta;
use dominio_cuenta::modelo::{Cuenta, IdCuenta};
use dominio_cuenta::repositorio::RepositorioCuenta;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerCuenta {
    pub id: IdCuenta,
}

#[async_trait]
pub trait ObtenerCuenta: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerCuenta) -> Result<Cuenta, ErrorCuenta>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerCuenta {}

        #[async_trait]
        impl ObtenerCuenta for ObtenerCuenta {
            async fn ejecutar(&self, params: ParamsObtenerCuenta) -> Result<Cuenta, ErrorCuenta>;
        }
    }
}

pub struct ObtenerCuentaImpl {
    pub repositorio: Arc<dyn RepositorioCuenta>,
}

#[async_trait]
impl ObtenerCuenta for ObtenerCuentaImpl {
    async fn ejecutar(&self, params: ParamsObtenerCuenta) -> Result<Cuenta, ErrorCuenta> {
        tracing::info!(id = %params.id, "obtener_cuenta: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_cuenta: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorCuenta::NoEncontrado;
            tracing::warn!(error = %err, "obtener_cuenta: rechazado");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_cuenta::{
        modelo::IdCuenta, pruebas::madres::MadreCuenta, repositorio::dobles::MockRepositorioCuenta,
    };
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_devolver_cuenta_cuando_el_id_existe() {
        let entidad = MadreCuenta::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ObtenerCuentaImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerCuenta { id: id_entidad })
            .await;

        assert_eq!(resultado.unwrap().id, id_entidad);
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_el_id_no_existe() {
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ObtenerCuentaImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerCuenta {
                id: IdCuenta::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cuenta.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_el_almacen_no_esta_disponible() {
        let mut repositorio_doble = MockRepositorioCuenta::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Err(ErrorRepositorio::NoDisponible));
        let caso_de_uso = ObtenerCuentaImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerCuenta {
                id: IdCuenta::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cuenta.repositorio");
    }
}

