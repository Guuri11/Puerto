use business::domain::account::model::Account;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct AccountDto {
    pub id: Uuid,
    pub title: String,
    pub price: i64,
    pub name: String,
    pub sku: String,
    pub note: Option<String>,
    pub middle_name: Option<String>,
    pub tags: Vec<String>,
    pub status: String,
    pub email: String,
}

impl AccountDto {
    pub fn from_domain(entity: &Account) -> Self {
        Self {
            id: entity.id.value(),
            title: entity.title.clone(),
            price: entity.price,
            name: entity.name.value().to_string(),
            sku: entity.sku.value().to_string(),
            note: entity.note.clone(),
            middle_name: entity.middle_name.as_ref().map(|v| v.value().to_string()),
            tags: entity
                .tags
                .iter()
                .map(|v| v.value().to_string())
                .collect::<Vec<_>>(),
            status: entity.status.as_str().to_string(),
            email: entity.email.value().to_string(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateAccountRequest {
    pub title: String,
    pub price: i64,
    pub name: String,
    pub sku: String,
    pub note: Option<String>,
    pub middle_name: Option<String>,
    pub tags: Vec<String>,
    pub status: String,
    pub email: String,
}

/// One page of Accounts: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct AccountPageDto {
    pub items: Vec<AccountDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl AccountPageDto {
    pub fn from_domain(page: &Page<Account>) -> Self {
        Self {
            items: page.items.iter().map(AccountDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateAccountRequest {
    pub title: String,
    pub price: i64,
    pub name: String,
    pub sku: String,
    pub note: Option<String>,
    pub middle_name: Option<String>,
    pub tags: Vec<String>,
    pub status: String,
    pub email: String,
}

=== presentation/src/api/account/error_mapper.rs ===
use business::domain::account::errors::AccountError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::ErrorResponse;

use crate::api::error::IntoErrorResponse;

impl IntoErrorResponse for AccountError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            AccountError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            AccountError::NotFound => StatusCode::NOT_FOUND,
            AccountError::Duplicate => StatusCode::CONFLICT,
            AccountError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            AccountError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            AccountError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
            AccountError::InvalidSku => StatusCode::UNPROCESSABLE_ENTITY,
            AccountError::InvalidMiddleName => StatusCode::UNPROCESSABLE_ENTITY,
            AccountError::InvalidTag => StatusCode::UNPROCESSABLE_ENTITY,
            AccountError::InvalidStatus => StatusCode::UNPROCESSABLE_ENTITY,
            AccountError::InvalidEmail => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            AccountError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "account.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "account.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "account.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "account.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "account.unknown");
    }

    #[test]
    fn should_map_invalid_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::InvalidName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "account.invalid_name");
    }

    #[test]
    fn should_map_invalid_sku_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::InvalidSku.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "account.invalid_sku");
    }

    #[test]
    fn should_map_invalid_middle_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::InvalidMiddleName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "account.invalid_middle_name");
    }

    #[test]
    fn should_map_invalid_tag_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::InvalidTag.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "account.invalid_tag");
    }

    #[test]
    fn should_map_invalid_status_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::InvalidStatus.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "account.invalid_status");
    }

    #[test]
    fn should_map_invalid_email_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = AccountError::InvalidEmail.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "account.invalid_email");
    }
}

