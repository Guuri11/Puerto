=== web/src/domain/account/errors.ts ===
/**
 * A request about an account that the API refused. `code` is the API's `ErrorResponse.name`:
 * `account.not_found`, `account.validation_error.<field>_empty`.
 */
export class AccountError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "AccountError";
    this.code = code;
  }
}

=== web/src/domain/account/messages.ts ===
import type { AccountDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface AccountProblem {
  field: keyof AccountDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "account.validation_error.title_empty": "Title is required",
  "account.invalid_name": "Name is not valid",
  "account.invalid_sku": "Sku is not valid",
  "account.invalid_middle_name": "Middle name is not valid",
  "account.invalid_tag": "Tags are not valid",
  "account.invalid_status": "Status is not valid",
  "account.invalid_email": "Email is not valid",
  "account.duplicate": "An account with these values already exists",
  "account.not_found": "This account no longer exists",
  "account.repository_error": "The account could not be saved, try again later",
  "account.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof AccountDraft> = {
  "account.validation_error.title_empty": "title",
  "account.invalid_name": "name",
  "account.invalid_sku": "sku",
  "account.invalid_middle_name": "middleName",
  "account.invalid_tag": "tags",
  "account.invalid_status": "status",
  "account.invalid_email": "email",
};

export function toProblem(code: string): AccountProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/domain/account/model.ts ===
import { AccountError } from "./errors";

export interface Account {
  id: string;
  title: string;
  price: number;
  name: string;
  sku: string;
  note: string | null;
  middleName: string | null;
  tags: string[];
  status: Status;
  email: string;
}

/** What a create or an update sends: an account without its id. */
export type AccountDraft = Omit<Account, "id">;

export const statusValues = ["Active", "Archived"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `account.invalid_status`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new AccountError("account.invalid_status");
  return found;
}

=== web/src/domain/account/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Account, AccountDraft } from "./model";

/** The port the screens call. Every method rejects with the `AccountError` the API answered. */
export interface AccountRepository {
  list(page: PageRequest): Promise<Page<Account>>;
  get(id: string): Promise<Account>;
  create(draft: AccountDraft): Promise<Account>;
  update(id: string, draft: AccountDraft): Promise<Account>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/account/account-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { AccountError } from "../../domain/account/errors";
import { AccountMother } from "../../test-support/account";
import { createApiClient } from "../http/client";
import { accountRepositoryHttp } from "./account-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: accountRepositoryHttp(api), requests };
}

describe("accountRepositoryHttp", () => {
  test("should ask for the page and return its accounts", async () => {
    // Arrange
    const account = AccountMother.random();
    const page = { items: [account], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/accounts?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating an account", async () => {
    // Arrange
    const draft = AccountMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the account does not exist", async () => {
    // Arrange
    const code = "account.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(AccountError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the account", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/accounts/42");
  });
});

=== web/src/infrastructure/account/account-repository-http.ts ===
import { AccountError } from "../../domain/account/errors";
import { type Account, type AccountDraft, parseStatus } from "../../domain/account/model";
import type { AccountRepository } from "../../domain/account/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type AccountDto = components["schemas"]["AccountDto"];
type AccountRequest = components["schemas"]["CreateAccountRequest"];

function toAccount(dto: AccountDto): Account {
  return {
    id: dto.id,
    title: dto.title,
    price: dto.price,
    name: dto.name,
    sku: dto.sku,
    note: dto.note ?? null,
    middleName: dto.middleName ?? null,
    tags: dto.tags,
    status: parseStatus(dto.status),
    email: dto.email,
  };
}

function toRequest(draft: AccountDraft): AccountRequest {
  return {
    title: draft.title,
    price: draft.price,
    name: draft.name,
    sku: draft.sku,
    note: draft.note ?? undefined,
    middleName: draft.middleName ?? undefined,
    tags: draft.tags,
    status: draft.status,
    email: draft.email,
  };
}

/** `AccountRepository` over the REST API (`/accounts`). */
export function accountRepositoryHttp(api: ApiClient): AccountRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/accounts", {
        params: { query: page },
      });
      if (data === undefined) throw new AccountError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toAccount) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/accounts/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new AccountError(apiErrorCode(error, response));
      return toAccount(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/accounts", { body: toRequest(draft) });
      if (data === undefined) throw new AccountError(apiErrorCode(error, response));
      return toAccount(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/accounts/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new AccountError(apiErrorCode(error, response));
      return toAccount(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/accounts/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new AccountError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

