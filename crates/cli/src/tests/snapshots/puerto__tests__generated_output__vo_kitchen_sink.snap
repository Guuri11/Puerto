use crate::domain::account::model::Account;
use crate::domain::account::model::AccountProps;
use crate::domain::account::value_objects::MiddleName;
use crate::domain::account::value_objects::Name;
use crate::domain::account::value_objects::Sku;
use crate::domain::account::value_objects::Status;
use crate::domain::account::value_objects::Tag;
use crate::domain::shared::value_objects::Email;

pub struct AccountMother {
    title: Option<String>,
    price: Option<i64>,
    name: Option<Name>,
    sku: Option<Sku>,
    note: Option<String>,
    middle_name: Option<MiddleName>,
    tags: Option<Vec<Tag>>,
    status: Option<Status>,
    email: Option<Email>,
}

impl AccountMother {
    pub fn new() -> Self {
        Self {
            title: None,
            price: None,
            name: None,
            sku: None,
            note: None,
            middle_name: None,
            tags: None,
            status: None,
            email: None,
        }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn with_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn with_sku(mut self, sku: Sku) -> Self {
        self.sku = Some(sku);
        self
    }

    pub fn with_note(mut self, note: &str) -> Self {
        self.note = Some(note.to_string());
        self
    }

    pub fn with_middle_name(mut self, middle_name: MiddleName) -> Self {
        self.middle_name = Some(middle_name);
        self
    }

    pub fn with_tags(mut self, tags: Vec<Tag>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn with_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn with_email(mut self, email: Email) -> Self {
        self.email = Some(email);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn build(self) -> Account {
        Account::new(AccountProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
            note: self.note,
            middle_name: self.middle_name,
            tags: self.tags.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
            email: self
                .email
                .unwrap_or_else(|| Email::new("example".to_string()).expect("valid Email")),
        })
        .expect("AccountMother: failed to build valid Account")
    }

    pub fn build_props(self) -> AccountProps {
        AccountProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
            note: self.note,
            middle_name: self.middle_name,
            tags: self.tags.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
            email: self
                .email
                .unwrap_or_else(|| Email::new("example".to_string()).expect("valid Email")),
        }
    }

    pub fn random() -> Account {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Account> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for AccountMother {
    fn default() -> Self {
        Self::new()
    }
}

=== infrastructure/src/account/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::account::{
    model::{Account, AccountId},
    repository::AccountRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// Keeps the accounts it is given in process memory: they are lost when the process stops.
/// Like the Postgres adapter, it hides deleted rows and lists newest first;
/// a unique value another live row holds is `Duplicate`.
/// It stands in until there is a database (`puerto new --db` generates Postgres repositories).
#[derive(Default)]
pub struct InMemoryAccountRepository {
    rows: RwLock<HashMap<AccountId, Account>>,
}

impl InMemoryAccountRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<AccountId, Account>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<AccountId, Account>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl AccountRepositoryTrait for InMemoryAccountRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Account>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = self.read();
        let mut live: Vec<&Account> = rows.values().filter(|row| !row.deleted).collect();
        live.sort_by(|a, b| {
            b.created_at
                .cmp(&a.created_at)
                .then_with(|| a.id.value().cmp(&b.id.value()))
        });
        let total = live.len() as u64;
        let items = live
            .into_iter()
            .skip(page.offset() as usize)
            .take(page.limit() as usize)
            .cloned()
            .collect();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: AccountId) -> Result<Option<Account>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(self.read().get(&id).filter(|row| !row.deleted).cloned())
    }

    async fn save(&self, entity: &Account) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let mut rows = self.write();
        // Like the partial unique indexes: only live rows hold their values.
        let taken = !entity.deleted
            && rows
                .values()
                .any(|row| row.id != entity.id && !row.deleted && row.sku == entity.sku);
        if taken {
            tracing::warn!(id = %entity.id, "save rejected: a unique value is taken");
            return Err(RepositoryError::Duplicate);
        }
        rows.insert(entity.id, entity.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::account::model::AccountProps;
    use business::domain::account::value_objects::Name;
    use business::domain::account::value_objects::Sku;
    use business::domain::account::value_objects::Status;
    use business::domain::shared::value_objects::Email;
    use uuid::Uuid;

    fn new_account() -> Account {
        Account::new(AccountProps {
            title: "example".to_string(),
            price: 42,
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new(Uuid::new_v4().to_string()).expect("valid Sku"),
            note: None,
            middle_name: None,
            tags: vec![],
            status: Status::Active,
            email: Email::new("example".to_string()).expect("valid Email"),
        })
        .unwrap()
    }

    #[tokio::test]
    async fn should_find_a_saved_account_by_id() {
        // Arrange
        let repo = InMemoryAccountRepository::new();
        let entity = new_account();
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();

        // Assert
        assert_eq!(found.map(|row| row.id), Some(entity.id));
    }

    #[tokio::test]
    async fn should_update_the_row_when_saved_again() {
        // Arrange
        let repo = InMemoryAccountRepository::new();
        let mut entity = new_account();
        repo.save(&entity).await.unwrap();
        entity.updated_at = chrono::Utc::now();

        // Act
        repo.save(&entity).await.unwrap();

        // Assert
        let page = repo.find_all(PageRequest::default()).await.unwrap();
        assert_eq!(page.total, 1);
        assert_eq!(page.items[0].updated_at, entity.updated_at);
    }

    #[tokio::test]
    async fn should_not_find_a_deleted_account() {
        // Arrange
        let repo = InMemoryAccountRepository::new();
        let mut entity = new_account();
        entity.deleted = true;
        entity.deleted_at = Some(entity.updated_at);
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();
        let page = repo.find_all(PageRequest::default()).await.unwrap();

        // Assert
        assert!(found.is_none());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_return_the_requested_page_of_a_larger_list() {
        // Arrange
        let repo = InMemoryAccountRepository::new();
        for _ in 0..3 {
            repo.save(&new_account()).await.unwrap();
        }

        // Act
        let page = repo
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[tokio::test]
    async fn should_reject_a_duplicate_sku() {
        // Arrange
        let repo = InMemoryAccountRepository::new();
        let first = new_account();
        repo.save(&first).await.unwrap();
        let mut second = new_account();
        second.sku = first.sku.clone();

        // Act
        let result = repo.save(&second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
    }
}

