import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CuentaMother, fakeCuentaRepository } from "../../../../test-support/cuenta";
import { renderScreen } from "../../../../test-support/render";
import { CuentaDetailContainer } from "./cuenta-detail-container";

describe("CuentaDetailContainer", () => {
  test("should show the cuenta when it exists", async () => {
    // Arrange
    const seeded = CuentaMother.random();
    const cuentaRepository = fakeCuentaRepository([seeded]);

    // Act
    renderScreen(<CuentaDetailContainer id={seeded.id} />, { cuentaRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the cuenta does not exist", async () => {
    // Arrange
    const cuentaRepository = fakeCuentaRepository();

    // Act
    renderScreen(<CuentaDetailContainer id={crypto.randomUUID()} />, {
      cuentaRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("cuenta.no_encontrado");
  });

  test("should delete the cuenta only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = CuentaMother.random();
    const fake = fakeCuentaRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<CuentaDetailContainer id={seeded.id} />, {
      cuentaRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/cuentas"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/cuenta/containers/cuenta-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { CuentaDetailView } from "../views/cuenta-detail-view";

export function CuentaDetailContainer({ id }: { id: string }) {
  const { cuentaRepository } = useDependencies();
  const cuenta = useAsync(() => cuentaRepository.get(id), [cuentaRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await cuentaRepository.remove(id);
      navigate("/cuentas");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Cuenta</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {cuenta.status === "loading" && <span className="loading loading-spinner" />}
      {cuenta.status === "error" && <ErrorAlert error={cuenta.error} />}
      {cuenta.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <CuentaDetailView cuenta={cuenta.data} />
            <div className="card-actions justify-end">
              <Link href={`/cuentas/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/cuentas" className="link">
        Back to cuentas
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this cuenta?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/cuenta/containers/cuenta-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CuentaError } from "../../../../domain/cuenta/errors";
import type { CuentaDraft } from "../../../../domain/cuenta/model";
import { CuentaMother, fakeCuentaRepository } from "../../../../test-support/cuenta";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { CuentaFormContainer } from "./cuenta-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: CuentaDraft) {
  await screen.findByText("Save");
  type("Title", draft.title);
  type("Price", String(draft.price));
  type("Name", draft.name);
  type("Sku", draft.sku);
  type("Note", textOf(draft.note));
  type("Middle name", textOf(draft.middleName));
  type("Tags", draft.tags.join(", "));
  type("Status", draft.status);
  type("Email", draft.email);
}

describe("CuentaFormContainer", () => {
  test("should create the cuenta from what was typed and show it", async () => {
    // Arrange
    const draft = CuentaMother.draft();
    const cuentaRepository = fakeCuentaRepository();
    const { history } = renderScreen(<CuentaFormContainer />, { cuentaRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/cuentas/"));
    const {
      items: [created],
    } = await cuentaRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/cuentas/${created?.id}`);
  });

  test("should save the edited cuenta when an existing one is submitted", async () => {
    // Arrange
    const seeded = CuentaMother.random();
    const cuentaRepository = fakeCuentaRepository([seeded]);
    const { history } = renderScreen(<CuentaFormContainer id={seeded.id} />, {
      cuentaRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/cuentas/${seeded.id}`));
    expect(await cuentaRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "cuenta.validacion.invalid";
    const cuentaRepository = {
      ...fakeCuentaRepository(),
      create: () => Promise.reject(new CuentaError(code)),
    };
    renderScreen(<CuentaFormContainer />, { cuentaRepository });
    await fillIn(CuentaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a cuenta with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const cuentaRepository = {
      ...fakeCuentaRepository(),
      create: () => Promise.reject(new CuentaError("cuenta.duplicado")),
    };
    renderScreen(<CuentaFormContainer />, { cuentaRepository });
    await fillIn(CuentaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A cuenta with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const cuentaRepository = {
      ...fakeCuentaRepository(),
      create: () => Promise.reject(new CuentaError("cuenta.validacion.title_vacio")),
    };
    renderScreen(<CuentaFormContainer />, { cuentaRepository });
    await fillIn(CuentaMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Title is required")).toBeTruthy();
    const input = screen.getByLabelText("Title");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/cuenta/containers/cuenta-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/cuenta/messages";
import type { Cuenta } from "../../../../domain/cuenta/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { CuentaFormView, toCuentaDraft, toCuentaForm } from "../views/cuenta-form-view";

/** Creates a cuenta, or edits the one with `id`. */
export function CuentaFormContainer({ id }: { id?: string }) {
  const { cuentaRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : cuentaRepository.get(id)),
    [cuentaRepository, id],
  );
  const title = id === undefined ? "New cuenta" : "Edit cuenta";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <CuentaForm existing={existing.data} />}
      <Link href={id === undefined ? "/cuentas" : `/cuentas/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function CuentaForm({ existing }: { existing: Cuenta | null }) {
  const { cuentaRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toCuentaForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toCuentaDraft(values);
      const saved =
        existing === null
          ? await cuentaRepository.create(draft)
          : await cuentaRepository.update(existing.id, draft);
      navigate(`/cuentas/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <CuentaFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

