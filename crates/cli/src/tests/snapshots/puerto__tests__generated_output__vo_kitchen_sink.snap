use crate::errores::ErrorCuenta;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    valor: String,
}

impl Sku {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::SkuInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    valor: String,
}

impl MiddleName {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::MiddleNameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Tag {
    valor: String,
}

impl Tag {
    pub fn new(valor: String) -> Result<Self, ErrorCuenta> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCuenta::TagInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Active,
    Archived,
}

impl std::str::FromStr for Status {
    type Err = ErrorCuenta;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Active" => Ok(Self::Active),
            "Archived" => Ok(Self::Archived),
            _ => Err(ErrorCuenta::StatusInvalido),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Active => "Active",
            Self::Archived => "Archived",
        }
    }
}

