=== web/src/domain/cuenta/errors.ts ===
/**
 * A request about a cuenta that the API refused. `code` is the API's `RespuestaError.codigo`:
 * `cuenta.no_encontrado`, `cuenta.validacion.<field>_vacio`.
 */
export class CuentaError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "CuentaError";
    this.code = code;
  }
}

=== web/src/domain/cuenta/messages.ts ===
import type { CuentaDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface CuentaProblem {
  field: keyof CuentaDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "cuenta.validacion.title_vacio": "Title is required",
  "cuenta.name_invalido": "Name is not valid",
  "cuenta.sku_invalido": "Sku is not valid",
  "cuenta.middle_name_invalido": "Middle name is not valid",
  "cuenta.tag_invalido": "Tags are not valid",
  "cuenta.status_invalido": "Status is not valid",
  "cuenta.email_invalido": "Email is not valid",
  "cuenta.duplicado": "A cuenta with these values already exists",
  "cuenta.no_encontrado": "This cuenta no longer exists",
  "cuenta.repositorio": "The cuenta could not be saved, try again later",
  "cuenta.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof CuentaDraft> = {
  "cuenta.validacion.title_vacio": "title",
  "cuenta.name_invalido": "name",
  "cuenta.sku_invalido": "sku",
  "cuenta.middle_name_invalido": "middleName",
  "cuenta.tag_invalido": "tags",
  "cuenta.status_invalido": "status",
  "cuenta.email_invalido": "email",
};

export function toProblem(code: string): CuentaProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/domain/cuenta/model.ts ===
import { CuentaError } from "./errors";

export interface Cuenta {
  id: string;
  title: string;
  price: number;
  name: string;
  sku: string;
  note: string | null;
  middleName: string | null;
  tags: string[];
  status: Status;
  email: string;
}

/** What a create or an update sends: a cuenta without its id. */
export type CuentaDraft = Omit<Cuenta, "id">;

export const statusValues = ["Active", "Archived"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `cuenta.status_invalido`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new CuentaError("cuenta.status_invalido");
  return found;
}

=== web/src/domain/cuenta/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Cuenta, CuentaDraft } from "./model";

/** The port the screens call. Every method rejects with the `CuentaError` the API answered. */
export interface CuentaRepository {
  list(page: PageRequest): Promise<Page<Cuenta>>;
  get(id: string): Promise<Cuenta>;
  create(draft: CuentaDraft): Promise<Cuenta>;
  update(id: string, draft: CuentaDraft): Promise<Cuenta>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/cuenta/cuenta-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { CuentaError } from "../../domain/cuenta/errors";
import { CuentaMother } from "../../test-support/cuenta";
import { createApiClient } from "../http/client";
import { cuentaRepositoryHttp } from "./cuenta-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: cuentaRepositoryHttp(api), requests };
}

describe("cuentaRepositoryHttp", () => {
  test("should ask for the page and return its cuentas", async () => {
    // Arrange
    const cuenta = CuentaMother.random();
    const { repository, requests } = answering(200, {
      elementos: [cuenta],
      total: 21,
      limite: 20,
      desplazamiento: 20,
    });

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    const url = new URL(requests[0]?.url ?? "");
    expect(url.pathname).toBe("/api/cuentas");
    expect(url.search).toBe("?limite=20&desplazamiento=20");
    expect(listed).toEqual({ items: [cuenta], total: 21, limit: 20, offset: 20 });
  });

  test("should send the draft when creating a cuenta", async () => {
    // Arrange
    const draft = CuentaMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the cuenta does not exist", async () => {
    // Arrange
    const code = "cuenta.no_encontrado";
    const { repository } = answering(404, { codigo: code, mensaje: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(CuentaError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the cuenta", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/cuentas/42");
  });
});

=== web/src/infrastructure/cuenta/cuenta-repository-http.ts ===
import { CuentaError } from "../../domain/cuenta/errors";
import { type Cuenta, type CuentaDraft, parseStatus } from "../../domain/cuenta/model";
import type { CuentaRepository } from "../../domain/cuenta/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type CuentaDto = components["schemas"]["DtoCuenta"];
type CuentaRequest = components["schemas"]["PeticionCrearCuenta"];

function toCuenta(dto: CuentaDto): Cuenta {
  return {
    id: dto.id,
    title: dto.title,
    price: dto.price,
    name: dto.name,
    sku: dto.sku,
    note: dto.note ?? null,
    middleName: dto.middleName ?? null,
    tags: dto.tags,
    status: parseStatus(dto.status),
    email: dto.email,
  };
}

function toRequest(draft: CuentaDraft): CuentaRequest {
  return {
    title: draft.title,
    price: draft.price,
    name: draft.name,
    sku: draft.sku,
    note: draft.note ?? undefined,
    middleName: draft.middleName ?? undefined,
    tags: draft.tags,
    status: draft.status,
    email: draft.email,
  };
}

/** `CuentaRepository` over the REST API (`/cuentas`). */
export function cuentaRepositoryHttp(api: ApiClient): CuentaRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/cuentas", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new CuentaError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toCuenta),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/cuentas/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new CuentaError(apiErrorCode(error, response));
      return toCuenta(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/cuentas", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new CuentaError(apiErrorCode(error, response));
      return toCuenta(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/cuentas/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new CuentaError(apiErrorCode(error, response));
      return toCuenta(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/cuentas/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new CuentaError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `RespuestaError.codigo` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "codigo" in error) {
    const { codigo } = error;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${response.status}`;
}

