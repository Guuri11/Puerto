=== contextos/cuenta/rest/src/respuestas.rs ===
// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoCuenta, DtoPaginaCuenta};

#[derive(ApiResponse)]
pub enum RespuestaCrearCuenta {
    #[oai(status = 201)]
    Creado(Json<DtoCuenta>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearCuenta {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerCuenta {
    #[oai(status = 200)]
    Ok(Json<DtoCuenta>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerCuenta {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarCuentas {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaCuenta>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarCuentas {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarCuenta {
    #[oai(status = 200)]
    Ok(Json<DtoCuenta>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarCuenta {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarCuenta {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaBorrarCuenta {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

