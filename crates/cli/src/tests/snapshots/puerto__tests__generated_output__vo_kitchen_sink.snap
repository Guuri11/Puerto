use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::account::{
    errors::AccountError,
    model::Account,
    repository::AccountRepositoryTrait,
    use_cases::list_accounts::{ListAccountsParams, ListAccountsUseCaseTrait},
};

pub struct ListAccountsUseCaseImpl {
    pub repository: Arc<dyn AccountRepositoryTrait>,
}

#[async_trait]
impl ListAccountsUseCaseTrait for ListAccountsUseCaseImpl {
    async fn execute(&self, params: ListAccountsParams) -> Result<Page<Account>, AccountError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_accounts: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_accounts: repository failed"))
            .map_err(AccountError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::account::value_objects::Name;
    use crate::domain::account::value_objects::Sku;
    use crate::domain::account::value_objects::Status;
    use crate::domain::account::{
        model::{Account, AccountProps},
        repository::mocks::MockAccountRepository,
    };
    use crate::domain::shared::value_objects::Email;
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_accounts() {
        let entities = vec![
            Account::new(AccountProps {
                title: "first".to_string(),
                price: 42,
                name: Name::new("first".to_string()).expect("valid Name"),
                sku: Sku::new("first".to_string()).expect("valid Sku"),
                note: None,
                middle_name: None,
                tags: vec![],
                status: Status::Active,
                email: Email::new("first".to_string()).expect("valid Email"),
            })
            .unwrap(),
            Account::new(AccountProps {
                title: "second".to_string(),
                price: 42,
                name: Name::new("second".to_string()).expect("valid Name"),
                sku: Sku::new("second".to_string()).expect("valid Sku"),
                note: None,
                middle_name: None,
                tags: vec![],
                status: Status::Active,
                email: Email::new("second".to_string()).expect("valid Email"),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockAccountRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListAccountsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListAccountsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_accounts_exist() {
        let mut mock_repo = MockAccountRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListAccountsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListAccountsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockAccountRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListAccountsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListAccountsParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

=== business/src/application/account/update_account.rs ===
use std::sync::Arc;

use crate::domain::account::value_objects::MiddleName;
use crate::domain::account::value_objects::Name;
use crate::domain::account::value_objects::Sku;
use crate::domain::account::value_objects::Status;
use crate::domain::account::value_objects::Tag;
use crate::domain::shared::value_objects::Email;
use async_trait::async_trait;

use crate::domain::account::{
    errors::AccountError,
    model::Account,
    repository::AccountRepositoryTrait,
    use_cases::update_account::{UpdateAccountParams, UpdateAccountUseCaseTrait},
};

pub struct UpdateAccountUseCaseImpl {
    pub repository: Arc<dyn AccountRepositoryTrait>,
}

#[async_trait]
impl UpdateAccountUseCaseTrait for UpdateAccountUseCaseImpl {
    async fn execute(&self, params: UpdateAccountParams) -> Result<Account, AccountError> {
        tracing::info!(id = %params.id, "update_account: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_account: repository failed"))?
            .ok_or_else(|| {
                let err = AccountError::NotFound;
                tracing::warn!(error = %err, "update_account: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = AccountError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_account: rejected");
            return Err(err);
        }
        let name = Name::new(params.name)?;
        let sku = Sku::new(params.sku)?;
        let middle_name = params.middle_name.map(MiddleName::new).transpose()?;
        let tags: Vec<Tag> = params
            .tags
            .into_iter()
            .map(Tag::new)
            .collect::<Result<Vec<_>, _>>()?;
        let status = params.status.parse::<Status>()?;
        let email = Email::new(params.email).map_err(|_| AccountError::InvalidEmail)?;
        entity.title = params.title;
        entity.price = params.price;
        entity.name = name;
        entity.sku = sku;
        entity.note = params.note;
        entity.middle_name = middle_name;
        entity.tags = tags;
        entity.status = status;
        entity.email = email;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_account: repository failed"))?;
        Ok(entity)
    }
}

