=== business/src/domain/account/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum AccountError {
    #[error("account.validation_error.{0}")]
    ValidationError(String),
    #[error("account.not_found")]
    NotFound,
    #[error("account.duplicate")]
    Duplicate,
    #[error("account.repository_error")]
    RepositoryError,
    #[error("account.unknown")]
    Unknown,
    #[error("account.invalid_name")]
    InvalidName,
    #[error("account.invalid_sku")]
    InvalidSku,
    #[error("account.invalid_middle_name")]
    InvalidMiddleName,
    #[error("account.invalid_tag")]
    InvalidTag,
    #[error("account.invalid_status")]
    InvalidStatus,
    #[error("account.invalid_email")]
    InvalidEmail,
}

impl From<RepositoryError> for AccountError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = AccountError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "account.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = AccountError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "account.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = AccountError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "account.repository_error");
    }
}

=== business/src/domain/account/model.rs ===
use super::value_objects::MiddleName;
use super::value_objects::Name;
use super::value_objects::Sku;
use super::value_objects::Status;
use super::value_objects::Tag;
use crate::domain::shared::value_objects::Email;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::AccountError;

/// The id of every `Account`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct AccountId(Uuid);

impl AccountId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for AccountId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct AccountProps {
    pub title: String,
    pub price: i64,
    pub name: Name,
    pub sku: Sku,
    pub note: Option<String>,
    pub middle_name: Option<MiddleName>,
    pub tags: Vec<Tag>,
    pub status: Status,
    pub email: Email,
}

#[derive(Debug, Clone)]
pub struct Account {
    pub id: AccountId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub price: i64,
    pub name: Name,
    pub sku: Sku,
    pub note: Option<String>,
    pub middle_name: Option<MiddleName>,
    pub tags: Vec<Tag>,
    pub status: Status,
    pub email: Email,
}

impl Account {
    pub fn new(props: AccountProps) -> Result<Self, AccountError> {
        if props.title.trim().is_empty() {
            return Err(AccountError::ValidationError("title_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: AccountId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            price: props.price,
            name: props.name,
            sku: props.sku,
            note: props.note,
            middle_name: props.middle_name,
            tags: props.tags,
            status: props.status,
            email: props.email,
        })
    }

    pub fn from_repository(data: Account) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_account_when_fields_are_valid() {
        let result = Account::new(AccountProps {
            title: "example".to_string(),
            price: 42,
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            note: None,
            middle_name: None,
            tags: vec![],
            status: Status::Active,
            email: Email::new("example".to_string()).expect("valid Email"),
        });
        assert_eq!(result.unwrap().title, "example");
    }

    #[test]
    fn should_reject_account_when_title_is_empty() {
        let result = Account::new(AccountProps {
            title: "".into(),
            price: 42,
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            note: None,
            middle_name: None,
            tags: vec![],
            status: Status::Active,
            email: Email::new("example".to_string()).expect("valid Email"),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "account.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_account_when_title_is_only_whitespace() {
        let result = Account::new(AccountProps {
            title: "   ".into(),
            price: 42,
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            note: None,
            middle_name: None,
            tags: vec![],
            status: Status::Active,
            email: Email::new("example".to_string()).expect("valid Email"),
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_account_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "account.invalid_name");
    }

    #[test]
    fn should_reject_account_when_sku_is_empty() {
        let result = Sku::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "account.invalid_sku");
    }

    #[test]
    fn should_reject_account_when_email_is_empty() {
        let result = Email::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shared.value_object.email.invalid"
        );
    }

    #[test]
    fn should_reject_account_when_status_is_invalid() {
        let result = "InvalidVariant".parse::<Status>();
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "account.invalid_status");
    }
}

=== business/src/domain/account/repository.rs ===
use async_trait::async_trait;
use puerto_core::{Page, PageRequest, RepositoryError};

use super::model::{Account, AccountId};

#[async_trait]
pub trait AccountRepositoryTrait: Send + Sync {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Account>, RepositoryError>;
    async fn find_by_id(&self, id: AccountId) -> Result<Option<Account>, RepositoryError>;
    async fn save(&self, entity: &Account) -> Result<(), RepositoryError>;
}

#[cfg(any(test, feature = "test-utils"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub AccountRepository {}

        #[async_trait]
        impl AccountRepositoryTrait for AccountRepository {
            async fn find_all(&self, page: PageRequest) -> Result<Page<Account>, RepositoryError>;
            async fn find_by_id(&self, id: AccountId) -> Result<Option<Account>, RepositoryError>;
            async fn save(&self, entity: &Account) -> Result<(), RepositoryError>;
        }
    }
}

