use crate::valores::MiddleName;
use crate::valores::Name;
use crate::valores::Sku;
use crate::valores::Status;
use crate::valores::Tag;
use chrono::{DateTime, Utc};
use nucleo::valores::Email;
use uuid::Uuid;

use crate::errores::ErrorCuenta;

/// El id de cada `Cuenta`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdCuenta(Uuid);

impl IdCuenta {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdCuenta {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsCuenta {
    pub title: String,
    pub price: i64,
    pub name: Name,
    pub sku: Sku,
    pub note: Option<String>,
    pub middle_name: Option<MiddleName>,
    pub tags: Vec<Tag>,
    pub status: Status,
    pub email: Email,
}

#[derive(Debug, Clone)]
pub struct Cuenta {
    pub id: IdCuenta,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub title: String,
    pub price: i64,
    pub name: Name,
    pub sku: Sku,
    pub note: Option<String>,
    pub middle_name: Option<MiddleName>,
    pub tags: Vec<Tag>,
    pub status: Status,
    pub email: Email,
}

impl Cuenta {
    pub fn new(props: PropsCuenta) -> Result<Self, ErrorCuenta> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdCuenta::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            title: props.title,
            price: props.price,
            name: props.name,
            sku: props.sku,
            note: props.note,
            middle_name: props.middle_name,
            tags: props.tags,
            status: props.status,
            email: props.email,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsCuenta) -> Result<(), ErrorCuenta> {
        Self::validar(&props)?;
        self.title = props.title;
        self.price = props.price;
        self.name = props.name;
        self.sku = props.sku;
        self.note = props.note;
        self.middle_name = props.middle_name;
        self.tags = props.tags;
        self.status = props.status;
        self.email = props.email;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Cuenta) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsCuenta) -> Result<(), ErrorCuenta> {
        if props.title.trim().is_empty() {
            return Err(ErrorCuenta::Validacion("title_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreCuenta;

    #[test]
    fn deberia_crear_cuenta_cuando_los_campos_son_validos() {
        let resultado = Cuenta::new(MadreCuenta::new().construir_props());
        assert_eq!(
            resultado.unwrap().title,
            MadreCuenta::new().construir_props().title
        );
    }

    #[test]
    fn deberia_rechazar_cuenta_cuando_title_es_una_cadena_vacia() {
        let resultado = Cuenta::new(MadreCuenta::new().con_title_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cuenta.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_cuenta_cuando_title_solo_tiene_espacios() {
        let resultado = Cuenta::new(MadreCuenta::new().con_title("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_cuenta_cuando_title_es_una_cadena_vacia() {
        let mut entidad = MadreCuenta::aleatorio();
        let resultado = entidad.actualizar(MadreCuenta::new().con_title_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cuenta.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_cuenta_cuando_name_es_una_cadena_vacia() {
        let resultado = Name::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cuenta.name_invalido");
    }

    #[test]
    fn deberia_rechazar_cuenta_cuando_sku_es_una_cadena_vacia() {
        let resultado = Sku::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cuenta.sku_invalido");
    }

    #[test]
    fn deberia_rechazar_cuenta_cuando_email_es_una_cadena_vacia() {
        let resultado = Email::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "nucleo.email_invalido");
    }

    #[test]
    fn deberia_rechazar_cuenta_cuando_status_no_es_una_variante_conocida() {
        let resultado = "VarianteInvalida".parse::<Status>();
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cuenta.status_invalido");
    }
}

=== contextos/cuenta/dominio/src/pruebas/madres.rs ===
use crate::modelo::Cuenta;
use crate::modelo::PropsCuenta;
use crate::valores::MiddleName;
use crate::valores::Name;
use crate::valores::Sku;
use crate::valores::Status;
use crate::valores::Tag;
use nucleo::valores::Email;

pub struct MadreCuenta {
    title: Option<String>,
    price: Option<i64>,
    name: Option<Name>,
    sku: Option<Sku>,
    note: Option<String>,
    middle_name: Option<MiddleName>,
    tags: Option<Vec<Tag>>,
    status: Option<Status>,
    email: Option<Email>,
}

impl MadreCuenta {
    pub fn new() -> Self {
        Self {
            title: None,
            price: None,
            name: None,
            sku: None,
            note: None,
            middle_name: None,
            tags: None,
            status: None,
            email: None,
        }
    }

    pub fn con_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn con_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn con_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn con_sku(mut self, sku: Sku) -> Self {
        self.sku = Some(sku);
        self
    }

    pub fn con_note(mut self, note: &str) -> Self {
        self.note = Some(note.to_string());
        self
    }

    pub fn con_middle_name(mut self, middle_name: MiddleName) -> Self {
        self.middle_name = Some(middle_name);
        self
    }

    pub fn con_tags(mut self, tags: Vec<Tag>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn con_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn con_email(mut self, email: Email) -> Self {
        self.email = Some(email);
        self
    }

    pub fn con_title_vacio(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn construir(self) -> Cuenta {
        Cuenta::new(PropsCuenta {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            sku: self.sku.unwrap_or_else(|| {
                Sku::new("example".to_string()).expect("Sku::new rechazó el valor de ejemplo")
            }),
            note: self.note,
            middle_name: self.middle_name,
            tags: self.tags.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
            email: self.email.unwrap_or_else(|| {
                Email::new("example".to_string()).expect("Email::new rechazó el valor de ejemplo")
            }),
        })
        .expect("MadreCuenta: Cuenta::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsCuenta {
        PropsCuenta {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            sku: self.sku.unwrap_or_else(|| {
                Sku::new("example".to_string()).expect("Sku::new rechazó el valor de ejemplo")
            }),
            note: self.note,
            middle_name: self.middle_name,
            tags: self.tags.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
            email: self.email.unwrap_or_else(|| {
                Email::new("example".to_string()).expect("Email::new rechazó el valor de ejemplo")
            }),
        }
    }

    pub fn aleatorio() -> Cuenta {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Cuenta> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreCuenta {
    fn default() -> Self {
        Self::new()
    }
}

