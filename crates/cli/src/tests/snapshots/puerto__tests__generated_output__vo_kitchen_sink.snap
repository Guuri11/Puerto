// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod cuenta {
    use std::sync::Arc;

    use aplicacion_cuenta::actualizar_cuenta::{ActualizarCuenta, ActualizarCuentaImpl};
    use aplicacion_cuenta::borrar_cuenta::{BorrarCuenta, BorrarCuentaImpl};
    use aplicacion_cuenta::crear_cuenta::{CrearCuenta, CrearCuentaImpl};
    use aplicacion_cuenta::listar_cuentas::{ListarCuentas, ListarCuentasImpl};
    use aplicacion_cuenta::obtener_cuenta::{ObtenerCuenta, ObtenerCuentaImpl};
    use dominio_cuenta::repositorio::RepositorioCuenta;
    use infra_cuenta::repositorio::RepositorioCuentaEnMemoria;

    /// Los casos de uso de `cuenta`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_cuenta: Arc<dyn CrearCuenta>,
        pub obtener_cuenta: Arc<dyn ObtenerCuenta>,
        pub listar_cuentas: Arc<dyn ListarCuentas>,
        pub actualizar_cuenta: Arc<dyn ActualizarCuenta>,
        pub borrar_cuenta: Arc<dyn BorrarCuenta>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioCuenta> = Arc::new(RepositorioCuentaEnMemoria::new());
        CasosDeUso {
            crear_cuenta: Arc::new(CrearCuentaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_cuenta: Arc::new(ObtenerCuentaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_cuentas: Arc::new(ListarCuentasImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_cuenta: Arc::new(ActualizarCuentaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_cuenta: Arc::new(BorrarCuentaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

