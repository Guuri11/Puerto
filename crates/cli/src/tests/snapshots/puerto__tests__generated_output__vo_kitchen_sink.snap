import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { AccountError } from "../../../../domain/account/errors";
import { AccountMother, fakeAccountRepository } from "../../../../test-support/account";
import { renderScreen } from "../../../../test-support/render";
import { AccountListContainer } from "./account-list-container";

describe("AccountListContainer", () => {
  test("should show a row per account when there are some", async () => {
    // Arrange
    const seed = [AccountMother.random(), AccountMother.random()];
    const accountRepository = fakeAccountRepository(seed);

    // Act
    renderScreen(<AccountListContainer />, { accountRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => AccountMother.random());
    const accountRepository = fakeAccountRepository(seed);
    renderScreen(<AccountListContainer />, { accountRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => AccountMother.random());
    const accountRepository = fakeAccountRepository(seed);
    const path = "/accounts?page=2";

    // Act
    renderScreen(<AccountListContainer />, { accountRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no account", async () => {
    // Arrange
    const accountRepository = fakeAccountRepository();

    // Act
    renderScreen(<AccountListContainer />, { accountRepository });

    // Assert
    expect(await screen.findByText("No accounts yet.")).toBeTruthy();
  });

  test("should show the error code when the accounts cannot be listed", async () => {
    // Arrange
    const accountRepository = {
      ...fakeAccountRepository(),
      list: () => Promise.reject(new AccountError("account.repository_error")),
    };

    // Act
    renderScreen(<AccountListContainer />, { accountRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("account.repository_error");
  });
});

=== web/src/presentation/features/account/containers/account-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { AccountListView } from "../views/account-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function AccountListContainer() {
  const { accountRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const accounts = useAsync(
    () => accountRepository.list({ limit: PAGE_SIZE, offset }),
    [accountRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Accounts</h1>
        <Link href="/accounts/new" className="btn btn-primary">
          New account
        </Link>
      </div>
      {accounts.status === "loading" && <span className="loading loading-spinner" />}
      {accounts.status === "error" && <ErrorAlert error={accounts.error} />}
      {accounts.status === "ok" &&
        (accounts.data.total === 0 ? (
          <EmptyState message="No accounts yet." />
        ) : (
          <>
            <AccountListView accounts={accounts.data.items} />
            <Pagination {...accounts.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

