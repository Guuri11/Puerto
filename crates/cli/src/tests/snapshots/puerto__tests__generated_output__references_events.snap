import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { EntregaError } from "../../../../domain/entrega/errors";
import { EntregaMother, fakeEntregaRepository } from "../../../../test-support/entrega";
import { renderScreen } from "../../../../test-support/render";
import { EntregaListContainer } from "./entrega-list-container";

describe("EntregaListContainer", () => {
  test("should show a row per entrega when there are some", async () => {
    // Arrange
    const seed = [EntregaMother.random(), EntregaMother.random()];
    const entregaRepository = fakeEntregaRepository(seed);

    // Act
    renderScreen(<EntregaListContainer />, { entregaRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => EntregaMother.random());
    const entregaRepository = fakeEntregaRepository(seed);
    renderScreen(<EntregaListContainer />, { entregaRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => EntregaMother.random());
    const entregaRepository = fakeEntregaRepository(seed);
    const path = "/entregas?page=2";

    // Act
    renderScreen(<EntregaListContainer />, { entregaRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no entrega", async () => {
    // Arrange
    const entregaRepository = fakeEntregaRepository();

    // Act
    renderScreen(<EntregaListContainer />, { entregaRepository });

    // Assert
    expect(await screen.findByText("No entregas yet.")).toBeTruthy();
  });

  test("should show the error code when the entregas cannot be listed", async () => {
    // Arrange
    const entregaRepository = {
      ...fakeEntregaRepository(),
      list: () => Promise.reject(new EntregaError("entrega.repositorio")),
    };

    // Act
    renderScreen(<EntregaListContainer />, { entregaRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("entrega.repositorio");
  });
});

=== web/src/presentation/features/entrega/containers/entrega-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { EntregaListView } from "../views/entrega-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function EntregaListContainer() {
  const { entregaRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const entregas = useAsync(
    () => entregaRepository.list({ limit: PAGE_SIZE, offset }),
    [entregaRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Entregas</h1>
        <Link href="/entregas/new" className="btn btn-primary">
          New entrega
        </Link>
      </div>
      {entregas.status === "loading" && <span className="loading loading-spinner" />}
      {entregas.status === "error" && <ErrorAlert error={entregas.error} />}
      {entregas.status === "ok" &&
        (entregas.data.total === 0 ? (
          <EmptyState message="No entregas yet." />
        ) : (
          <>
            <EntregaListView entregas={entregas.data.items} />
            <Pagination {...entregas.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

