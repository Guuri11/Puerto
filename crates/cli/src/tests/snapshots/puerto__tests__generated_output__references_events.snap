// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generar bootstrap`.
//
// The composition root: the only module that imports `infrastructure/`. Screens reach the
// adapters through `useDependencies()`, so a test hands them a fake instead.

import type { CompraRepository } from "../../../domain/compra/repository";
import type { EntregaRepository } from "../../../domain/entrega/repository";
import type { ProveedorRepository } from "../../../domain/proveedor/repository";
import { compraRepositoryHttp } from "../../../infrastructure/compra/compra-repository-http";
import { entregaRepositoryHttp } from "../../../infrastructure/entrega/entrega-repository-http";
import { createApiClient } from "../../../infrastructure/http/client";
import { proveedorRepositoryHttp } from "../../../infrastructure/proveedor/proveedor-repository-http";

export interface Dependencies {
  compraRepository: CompraRepository;
  entregaRepository: EntregaRepository;
  proveedorRepository: ProveedorRepository;
}

export function createDependencies(): Dependencies {
  const api = createApiClient();
  return {
    compraRepository: compraRepositoryHttp(api),
    entregaRepository: entregaRepositoryHttp(api),
    proveedorRepository: proveedorRepositoryHttp(api),
  };
}

