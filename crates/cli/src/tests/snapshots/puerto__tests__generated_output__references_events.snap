use business::domain::supplier::model::Supplier;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct SupplierDto {
    pub id: Uuid,
    pub name: String,
    pub email: String,
}

impl SupplierDto {
    pub fn from_domain(entity: &Supplier) -> Self {
        Self {
            id: entity.id.value(),
            name: entity.name.value().to_string(),
            email: entity.email.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateSupplierRequest {
    pub name: String,
    pub email: String,
}

/// One page of Suppliers: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct SupplierPageDto {
    pub items: Vec<SupplierDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl SupplierPageDto {
    pub fn from_domain(page: &Page<Supplier>) -> Self {
        Self {
            items: page.items.iter().map(SupplierDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateSupplierRequest {
    pub name: String,
    pub email: String,
}

=== presentation/src/api/supplier/error_mapper.rs ===
use business::domain::supplier::errors::SupplierError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::ErrorResponse;

use crate::api::error::IntoErrorResponse;

impl IntoErrorResponse for SupplierError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            SupplierError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            SupplierError::NotFound => StatusCode::NOT_FOUND,
            SupplierError::Duplicate => StatusCode::CONFLICT,
            SupplierError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            SupplierError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            SupplierError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            SupplierError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "supplier.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = SupplierError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "supplier.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = SupplierError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "supplier.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = SupplierError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "supplier.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = SupplierError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "supplier.unknown");
    }

    #[test]
    fn should_map_invalid_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = SupplierError::InvalidName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "supplier.invalid_name");
    }
}

