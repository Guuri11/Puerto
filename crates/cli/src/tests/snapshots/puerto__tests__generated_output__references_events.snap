// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoPaginaProveedor, DtoProveedor};

#[derive(ApiResponse)]
pub enum RespuestaCrearProveedor {
    #[oai(status = 201)]
    Creado(Json<DtoProveedor>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearProveedor {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerProveedor {
    #[oai(status = 200)]
    Ok(Json<DtoProveedor>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerProveedor {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarProveedores {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaProveedor>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarProveedores {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarProveedor {
    #[oai(status = 200)]
    Ok(Json<DtoProveedor>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarProveedor {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarProveedor {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaBorrarProveedor {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

=== contextos/proveedor/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_proveedor::{
    actualizar_proveedor::{ActualizarProveedor, ParamsActualizarProveedor},
    borrar_proveedor::{BorrarProveedor, ParamsBorrarProveedor},
    crear_proveedor::{CrearProveedor, ParamsCrearProveedor},
    listar_proveedores::{ListarProveedores, ParamsListarProveedores},
    obtener_proveedor::{ObtenerProveedor, ParamsObtenerProveedor},
};
use dominio_proveedor::modelo::IdProveedor;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{
    DtoPaginaProveedor, DtoProveedor, PeticionActualizarProveedor, PeticionCrearProveedor,
};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarProveedor, RespuestaBorrarProveedor, RespuestaCrearProveedor,
    RespuestaListarProveedores, RespuestaObtenerProveedor,
};

#[derive(Tags)]
enum ApiTags {
    Proveedor,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiProveedor {
    pub crear_proveedor: Arc<dyn CrearProveedor>,
    pub obtener_proveedor: Arc<dyn ObtenerProveedor>,
    pub listar_proveedores: Arc<dyn ListarProveedores>,
    pub actualizar_proveedor: Arc<dyn ActualizarProveedor>,
    pub borrar_proveedor: Arc<dyn BorrarProveedor>,
}

#[OpenApi]
impl ApiProveedor {
    /// Crea: Proveedor
    #[oai(path = "/proveedores", method = "post", tag = "ApiTags::Proveedor")]
    async fn crear(&self, cuerpo: Json<PeticionCrearProveedor>) -> RespuestaCrearProveedor {
        match self
            .crear_proveedor
            .ejecutar(ParamsCrearProveedor {
                name: cuerpo.name.clone(),
                email: cuerpo.email.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaCrearProveedor::Creado(Json(DtoProveedor::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_proveedor falló");
                RespuestaCrearProveedor::from_status(status, error)
            }
        }
    }

    /// Obtiene: Proveedor por id
    #[oai(path = "/proveedores/:id", method = "get", tag = "ApiTags::Proveedor")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerProveedor {
        match self
            .obtener_proveedor
            .ejecutar(ParamsObtenerProveedor {
                id: IdProveedor::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaObtenerProveedor::Ok(Json(DtoProveedor::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_proveedor falló");
                RespuestaObtenerProveedor::from_status(status, error)
            }
        }
    }

    /// Lista Proveedores, página a página (el dominio acota `limite`)
    #[oai(path = "/proveedores", method = "get", tag = "ApiTags::Proveedor")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarProveedores {
        match self
            .listar_proveedores
            .ejecutar(ParamsListarProveedores {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarProveedores::Ok(Json(DtoPaginaProveedor::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_proveedores falló");
                RespuestaListarProveedores::from_status(status, error)
            }
        }
    }

    /// Actualiza: Proveedor
    #[oai(path = "/proveedores/:id", method = "put", tag = "ApiTags::Proveedor")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarProveedor>,
    ) -> RespuestaActualizarProveedor {
        match self
            .actualizar_proveedor
            .ejecutar(ParamsActualizarProveedor {
                id: IdProveedor::from_uuid(id.0),
                name: cuerpo.name.clone(),
                email: cuerpo.email.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaActualizarProveedor::Ok(Json(DtoProveedor::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_proveedor falló");
                RespuestaActualizarProveedor::from_status(status, error)
            }
        }
    }

    /// Borra: Proveedor
    #[oai(
        path = "/proveedores/:id",
        method = "delete",
        tag = "ApiTags::Proveedor"
    )]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarProveedor {
        match self
            .borrar_proveedor
            .ejecutar(ParamsBorrarProveedor {
                id: IdProveedor::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarProveedor::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_proveedor falló");
                RespuestaBorrarProveedor::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_proveedor::{
        actualizar_proveedor::dobles::MockActualizarProveedor,
        borrar_proveedor::dobles::MockBorrarProveedor, crear_proveedor::dobles::MockCrearProveedor,
        listar_proveedores::dobles::MockListarProveedores,
        obtener_proveedor::dobles::MockObtenerProveedor,
    };
    use dominio_proveedor::errores::ErrorProveedor;
    use dominio_proveedor::pruebas::madres::MadreProveedor;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearProveedor,
        obtener: MockObtenerProveedor,
        listar: MockListarProveedores,
        actualizar: MockActualizarProveedor,
        borrar: MockBorrarProveedor,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiProveedor {
                crear_proveedor: Arc::new(self.crear),
                obtener_proveedor: Arc::new(self.obtener),
                listar_proveedores: Arc::new(self.listar),
                actualizar_proveedor: Arc::new(self.actualizar),
                borrar_proveedor: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearProveedor {
        PeticionCrearProveedor {
            name: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarProveedor {
        PeticionActualizarProveedor {
            name: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/proveedores/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_proveedor() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreProveedor::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/proveedores")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_proveedor_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorProveedor::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/proveedores")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_proveedor_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreProveedor::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_proveedor_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorProveedor::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_proveedores_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreProveedor::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/proveedores").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/proveedores?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorProveedor::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/proveedores").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_proveedor() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreProveedor::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_proveedor_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorProveedor::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_proveedor() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_proveedor_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorProveedor::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

=== contextos/saludo/aplicacion/src/obtener_saludo.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo, repositorio::RepositorioSaludo};

#[derive(Debug, Clone)]
pub struct ParamsObtenerSaludo {
    pub nombre: String,
}

#[async_trait]
pub trait ObtenerSaludo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerSaludo {}

        #[async_trait]
        impl ObtenerSaludo for ObtenerSaludo {
            async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
        }
    }
}

pub struct ObtenerSaludoImpl {
    pub repositorio: Arc<dyn RepositorioSaludo>,
}

#[async_trait]
impl ObtenerSaludo for ObtenerSaludoImpl {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo> {
        tracing::info!(nombre = %params.nombre, "obtener_saludo: inicio");

        if params.nombre.trim().is_empty() {
            let err = ErrorSaludo::Validacion("nombre_vacio".into());
            tracing::warn!(error = %err, "obtener_saludo: rechazado");
            return Err(err);
        }

        let resultado = match self
            .repositorio
            .buscar_por_nombre(&params.nombre)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "obtener_saludo: fallo del repositorio"))?
        {
            Some(saludo) => saludo,
            None => Saludo::new(&params.nombre)?,
        };

        tracing::info!("obtener_saludo: fin");
        Ok(resultado)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_saludo::repositorio::dobles::MockRepositorioSaludo;

    #[tokio::test]
    async fn deberia_devolver_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(|_| Ok(None));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Mundo".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let saludo = resultado.unwrap();
        assert_eq!(saludo.nombre, "Mundo");
        assert!(saludo.mensaje.contains("Mundo"));
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_el_nombre_esta_vacio() {
        // Preparar
        let repositorio_doble = MockRepositorioSaludo::new();
        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo { nombre: "".into() })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "saludo.validacion.nombre_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_el_saludo_guardado_cuando_esta_en_el_repositorio() {
        // Preparar
        let en_cache = Saludo {
            nombre: "Puerto".into(),
            mensaje: "¡Hola desde la caché!".into(),
        };
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(move |_| Ok(Some(en_cache.clone())));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Puerto".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().mensaje, "¡Hola desde la caché!");
    }
}

=== contextos/saludo/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ParamsObtenerSaludo};
use poem_openapi::{OpenApi, Tags, param::Path};

use crate::{dto::DtoSaludo, errores::a_respuesta_error, respuestas::RespuestaObtenerSaludo};

#[derive(Tags)]
enum ApiTags {
    Saludo,
}

/// Guarda el puerto del caso de uso; `generado/bootstrap.rs` conecta la implementación.
pub struct ApiSaludo {
    pub obtener_saludo: Arc<dyn ObtenerSaludo>,
}

#[OpenApi]
impl ApiSaludo {
    /// Obtiene un saludo para el nombre dado
    #[oai(path = "/saludos/:nombre", method = "get", tag = "ApiTags::Saludo")]
    async fn obtener_saludo(&self, nombre: Path<String>) -> RespuestaObtenerSaludo {
        match self
            .obtener_saludo
            .ejecutar(ParamsObtenerSaludo { nombre: nombre.0 })
            .await
        {
            Ok(saludo) => RespuestaObtenerSaludo::Ok(poem_openapi::payload::Json(
                DtoSaludo::from_dominio(&saludo),
            )),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_saludo falló");
                RespuestaObtenerSaludo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;
    use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo};
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::OpenApiService;

    use super::*;

    fn cliente(caso_de_uso: MockObtenerSaludo) -> TestClient<Route> {
        let api = ApiSaludo {
            obtener_saludo: Arc::new(caso_de_uso),
        };
        TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
    }

    #[tokio::test]
    async fn deberia_responder_200_con_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|params| Saludo::new(&params.nombre));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("nombre")
            .assert_string("Ada");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_se_rechaza_el_saludo() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|_| Err(ErrorSaludo::Validacion("nombre_vacio".into())));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }
}

