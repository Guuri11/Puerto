=== web/src/presentation/features/delivery/views/delivery-form-view.tsx ===
import type { DeliveryProblem } from "../../../../domain/delivery/messages";
import type { Delivery, DeliveryDraft } from "../../../../domain/delivery/model";
import type { ReferenceOption } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface DeliveryFormValues {
  purchaseId: string;
  carrier: string;
}

/** The inputs for `delivery`, empty when there is none yet. */
export function toDeliveryForm(delivery: Delivery | null): DeliveryFormValues {
  if (delivery === null) {
    return {
      purchaseId: "",
      carrier: "",
    };
  }
  return {
    purchaseId: delivery.purchaseId,
    carrier: delivery.carrier,
  };
}

/** What each reference's select offers. */
export interface DeliveryFormOptions {
  purchaseId: ReferenceOption[];
}

export function toDeliveryDraft(values: DeliveryFormValues): DeliveryDraft {
  return {
    purchaseId: values.purchaseId,
    carrier: values.carrier,
  };
}

export function DeliveryFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: DeliveryFormValues;
  options: DeliveryFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: DeliveryProblem | null;
  onChange: (values: DeliveryFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Purchase</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "purchaseId"}
          required
          value={values.purchaseId}
          onChange={(event) => onChange({ ...values, purchaseId: event.target.value })}
        >
          <option value="">Choose a purchase</option>
          {options.purchaseId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="purchaseId" />
      <label className="fieldset">
        <span className="fieldset-legend">Carrier</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "carrier"}
          required
          value={values.carrier}
          onChange={(event) => onChange({ ...values, carrier: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="carrier" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

