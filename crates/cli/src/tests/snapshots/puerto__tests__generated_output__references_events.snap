=== presentation/src/api/delivery/routes.rs ===
use std::sync::Arc;

use business::domain::delivery::model::DeliveryId;
use business::domain::delivery::use_cases::{
    create_delivery::{CreateDeliveryParams, CreateDeliveryUseCaseTrait},
    delete_delivery::{DeleteDeliveryParams, DeleteDeliveryUseCaseTrait},
    get_delivery::{GetDeliveryParams, GetDeliveryUseCaseTrait},
    list_deliveries::{ListDeliveriesParams, ListDeliveriesUseCaseTrait},
    update_delivery::{UpdateDeliveryParams, UpdateDeliveryUseCaseTrait},
};
use business::domain::purchase::model::PurchaseId;
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::delivery::dto::{
    CreateDeliveryRequest, DeliveryDto, DeliveryPageDto, UpdateDeliveryRequest,
};
use crate::api::delivery::responses::{
    CreateDeliveryResponse, DeleteDeliveryResponse, GetDeliveryResponse, ListDeliveriesResponse,
    UpdateDeliveryResponse,
};
use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct DeliveryApi {
    pub create_delivery: Arc<dyn CreateDeliveryUseCaseTrait>,
    pub get_delivery: Arc<dyn GetDeliveryUseCaseTrait>,
    pub list_deliveries: Arc<dyn ListDeliveriesUseCaseTrait>,
    pub update_delivery: Arc<dyn UpdateDeliveryUseCaseTrait>,
    pub delete_delivery: Arc<dyn DeleteDeliveryUseCaseTrait>,
}

#[OpenApi]
impl DeliveryApi {
    /// Create a new Delivery
    #[oai(path = "/deliveries", method = "post", tag = "ApiTags::Delivery")]
    async fn create(&self, body: Json<CreateDeliveryRequest>) -> CreateDeliveryResponse {
        match self
            .create_delivery
            .execute(CreateDeliveryParams {
                purchase_id: PurchaseId::from_uuid(body.purchase_id),
                carrier: body.carrier.clone(),
            })
            .await
        {
            Ok(entity) => CreateDeliveryResponse::Created(Json(DeliveryDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_delivery failed");
                CreateDeliveryResponse::from_status(status, error)
            }
        }
    }

    /// Get a Delivery by ID
    #[oai(path = "/deliveries/:id", method = "get", tag = "ApiTags::Delivery")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetDeliveryResponse {
        match self
            .get_delivery
            .execute(GetDeliveryParams {
                id: DeliveryId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetDeliveryResponse::Ok(Json(DeliveryDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_delivery failed");
                GetDeliveryResponse::from_status(status, error)
            }
        }
    }

    /// List Deliveries, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/deliveries", method = "get", tag = "ApiTags::Delivery")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
        #[oai(name = "purchaseId")] purchase_id: Query<Option<Uuid>>,
    ) -> ListDeliveriesResponse {
        match self
            .list_deliveries
            .execute(ListDeliveriesParams {
                page: PageRequest::new(limit.0, offset.0),
                purchase_id: purchase_id.0.map(PurchaseId::from_uuid),
            })
            .await
        {
            Ok(page) => ListDeliveriesResponse::Ok(Json(DeliveryPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_deliveries failed");
                ListDeliveriesResponse::from_status(status, error)
            }
        }
    }

    /// Update a Delivery
    #[oai(path = "/deliveries/:id", method = "put", tag = "ApiTags::Delivery")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdateDeliveryRequest>,
    ) -> UpdateDeliveryResponse {
        match self
            .update_delivery
            .execute(UpdateDeliveryParams {
                id: DeliveryId::from_uuid(id.0),
                purchase_id: PurchaseId::from_uuid(body.purchase_id),
                carrier: body.carrier.clone(),
            })
            .await
        {
            Ok(entity) => UpdateDeliveryResponse::Ok(Json(DeliveryDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_delivery failed");
                UpdateDeliveryResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Delivery
    #[oai(path = "/deliveries/:id", method = "delete", tag = "ApiTags::Delivery")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteDeliveryResponse {
        match self
            .delete_delivery
            .execute(DeleteDeliveryParams {
                id: DeliveryId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteDeliveryResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_delivery failed");
                DeleteDeliveryResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::delivery::errors::DeliveryError;
    use business::domain::delivery::use_cases::{
        create_delivery::mocks::MockCreateDeliveryUseCase,
        delete_delivery::mocks::MockDeleteDeliveryUseCase,
        get_delivery::mocks::MockGetDeliveryUseCase,
        list_deliveries::mocks::MockListDeliveriesUseCase,
        update_delivery::mocks::MockUpdateDeliveryUseCase,
    };
    use business::tests::mothers::delivery_mother::DeliveryMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateDeliveryUseCase,
        get: MockGetDeliveryUseCase,
        list: MockListDeliveriesUseCase,
        update: MockUpdateDeliveryUseCase,
        delete: MockDeleteDeliveryUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = DeliveryApi {
                create_delivery: Arc::new(self.create),
                get_delivery: Arc::new(self.get),
                list_deliveries: Arc::new(self.list),
                update_delivery: Arc::new(self.update),
                delete_delivery: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateDeliveryRequest {
        CreateDeliveryRequest {
            purchase_id: Uuid::new_v4(),
            carrier: "example".to_string(),
        }
    }

    fn update_request() -> UpdateDeliveryRequest {
        UpdateDeliveryRequest {
            purchase_id: Uuid::new_v4(),
            carrier: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/deliveries/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_delivery_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(DeliveryMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/deliveries")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_delivery_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(DeliveryError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/deliveries")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_422_when_a_referenced_purchase_id_does_not_exist() {
        // Arrange: the database found no Purchase with that id (ADR-0022 of Puerto).
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| {
            Err(DeliveryError::ValidationError(
                "purchase_id_not_found".to_string(),
            ))
        });

        // Act
        let response = mocks
            .client()
            .post("/deliveries")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        response
            .json()
            .await
            .value()
            .object()
            .get("name")
            .assert_string("delivery.validation_error.purchase_id_not_found");
    }

    #[tokio::test]
    async fn should_respond_200_when_delivery_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(DeliveryMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_delivery_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(DeliveryError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_deliveries_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(DeliveryMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/deliveries").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/deliveries?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_pass_the_purchase_id_filter_to_the_use_case() {
        // Arrange
        let purchase_id = Uuid::new_v4();
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(move |params| params.purchase_id == Some(PurchaseId::from_uuid(purchase_id)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get(format!("/deliveries?purchaseId={purchase_id}"))
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(DeliveryError::RepositoryError));

        // Act
        let response = mocks.client().get("/deliveries").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_delivery_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(DeliveryMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_delivery() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(DeliveryError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_delivery_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_delivery() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(DeliveryError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

