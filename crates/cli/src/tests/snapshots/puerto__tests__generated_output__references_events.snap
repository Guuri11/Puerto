use business::domain::supplier::model::SupplierId;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use business::domain::purchase::{
    errors::PurchaseError,
    model::{Purchase, PurchaseId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct PurchaseDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub supplier_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

impl TryFrom<PurchaseDb> for Purchase {
    type Error = PurchaseError;

    fn try_from(row: PurchaseDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Purchase {
            id: PurchaseId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            supplier_id: SupplierId::from_uuid(row.supplier_id),
            approver_id: row.approver_id.map(SupplierId::from_uuid),
            total: row.total,
        }))
    }
}

impl From<&Purchase> for PurchaseDb {
    fn from(entity: &Purchase) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            supplier_id: entity.supplier_id.value(),
            approver_id: entity.approver_id.map(|v| v.value()),
            total: entity.total,
        }
    }
}

=== infrastructure/src/purchase/repository.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::purchase::{
    model::{Purchase, PurchaseId},
    repository::{PurchaseFilter, PurchaseRepositoryTrait},
};
use puerto_core::{Page, PageRequest, RepositoryError};

use super::entity::PurchaseDb;
use crate::db::map_sqlx_error;

pub struct PgPurchaseRepository {
    pub pool: PgPool,
}

impl PgPurchaseRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: PurchaseDb) -> Result<Purchase, RepositoryError> {
    Purchase::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid purchase");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl PurchaseRepositoryTrait for PgPurchaseRepository {
    async fn find_all(
        &self,
        page: PageRequest,
        filter: PurchaseFilter,
    ) -> Result<Page<Purchase>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        // One static query whatever the filter: an unset id is NULL and matches every row.
        let supplier_id = filter.supplier_id.map(|id| id.value());
        let approver_id = filter.approver_id.map(|id| id.value());
        let rows = sqlx::query_as!(
            PurchaseDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, supplier_id, approver_id, total
             FROM purchases WHERE deleted = false AND ($3::uuid IS NULL OR supplier_id = $3) AND ($4::uuid IS NULL OR approver_id = $4)
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limit()),
            i64::from(page.offset()),
            supplier_id,
            approver_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM purchases WHERE deleted = false AND ($1::uuid IS NULL OR supplier_id = $1) AND ($2::uuid IS NULL OR approver_id = $2)"#,
            supplier_id,
            approver_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            map_sqlx_error(&e)
        })?;

        let items = rows
            .into_iter()
            .map(to_domain)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: PurchaseId) -> Result<Option<Purchase>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            PurchaseDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, supplier_id, approver_id, total
             FROM purchases WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }
}

/// `pub(crate)`: an entity that references Purchase seeds its rows with this module's `seed`.
#[cfg(test)]
pub(crate) mod integration_tests {
    use super::*;
    use business::domain::purchase::model::PurchaseProps;
    use business::domain::purchase::unit_of_work::PurchaseUnitOfWorkFactory;

    use crate::purchase::unit_of_work::PgPurchaseUnitOfWorkFactory;

    fn test_repo(pool: PgPool) -> PgPurchaseRepository {
        PgPurchaseRepository::new(pool)
    }

    /// The repository only reads: rows are written through the unit of work.
    async fn store(pool: &PgPool, entity: &Purchase) {
        let mut uow = PgPurchaseUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.save(entity).await.unwrap();
        uow.commit().await.unwrap();
    }

    /// A valid purchase, not stored: the rows it references are seeded first.
    async fn build(pool: &PgPool) -> Purchase {
        Purchase::new(PurchaseProps {
            supplier_id: crate::supplier::repository::integration_tests::seed(pool)
                .await
                .id,
            approver_id: None,
            total: 42,
        })
        .unwrap()
    }

    /// A stored purchase.
    pub(crate) async fn seed(pool: &PgPool) -> Purchase {
        let entity = build(pool).await;
        store(pool, &entity).await;
        entity
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.supplier_id, entity.supplier_id);
        assert_eq!(found.approver_id, entity.approver_id);
        assert_eq!(found.total, entity.total);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool)
            .find_by_id(PurchaseId::generate())
            .await
            .unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_purchases_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        store(&pool, &deleted).await;

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::default(), PurchaseFilter::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::new(Some(2), Some(2)),
                PurchaseFilter::default(),
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_only_the_purchases_of_the_requested_supplier_id(pool: PgPool) {
        // Arrange: one purchase with this supplier_id, one without.
        let target = crate::supplier::repository::integration_tests::seed(&pool).await;
        let mut wanted = build(&pool).await;
        wanted.supplier_id = target.id;
        store(&pool, &wanted).await;
        seed(&pool).await;

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::default(),
                PurchaseFilter {
                    supplier_id: Some(target.id),
                    approver_id: None,
                },
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(
            page.items.iter().map(|row| row.id).collect::<Vec<_>>(),
            vec![wanted.id]
        );
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_only_the_purchases_of_the_requested_approver_id(pool: PgPool) {
        // Arrange: one purchase with this approver_id, one without.
        let target = crate::supplier::repository::integration_tests::seed(&pool).await;
        let mut wanted = build(&pool).await;
        wanted.approver_id = Some(target.id);
        store(&pool, &wanted).await;
        seed(&pool).await;

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::default(),
                PurchaseFilter {
                    supplier_id: None,
                    approver_id: Some(target.id),
                },
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(
            page.items.iter().map(|row| row.id).collect::<Vec<_>>(),
            vec![wanted.id]
        );
        assert_eq!(page.total, 1);
    }
}

=== infrastructure/src/purchase/unit_of_work.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::purchase::{
    events::PurchaseEvent,
    model::Purchase,
    unit_of_work::{PurchaseUnitOfWork, PurchaseUnitOfWorkFactory},
};
use puerto_core::RepositoryError;
use puerto_sqlx::uow::PgTransaction;

use super::entity::PurchaseDb;
use crate::db::{ForeignKey, map_sqlx_error_with};

/// Opens a Postgres transaction per write: the purchase row and its outbox event commit together.
pub struct PgPurchaseUnitOfWorkFactory {
    pub pool: PgPool,
}

impl PgPurchaseUnitOfWorkFactory {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// The foreign keys a write goes through (ADR-0022 of Puerto): the database rejects a reference to
/// a row that does not exist, and the field it names is the caller's error.
const REFERENCES: &[ForeignKey] = &[
    ForeignKey {
        constraint: "purchases_supplier_id_fkey",
        field: "supplier_id",
    },
    ForeignKey {
        constraint: "purchases_approver_id_fkey",
        field: "approver_id",
    },
];

#[async_trait]
impl PurchaseUnitOfWorkFactory for PgPurchaseUnitOfWorkFactory {
    async fn begin(&self) -> Result<Box<dyn PurchaseUnitOfWork>, RepositoryError> {
        let tx = PgTransaction::begin(&self.pool).await?;
        Ok(Box::new(PgPurchaseUnitOfWork { tx }))
    }
}

struct PgPurchaseUnitOfWork {
    tx: PgTransaction,
}

#[async_trait]
impl PurchaseUnitOfWork for PgPurchaseUnitOfWork {
    async fn save(&mut self, entity: &Purchase) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = PurchaseDb::from(entity);
        sqlx::query!(
            "INSERT INTO purchases (id, created_at, updated_at, deleted, deleted_at, supplier_id, approver_id, total)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, supplier_id = $6, approver_id = $7, total = $8",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.supplier_id,
            db.approver_id,
            db.total,
        )
        .execute(self.tx.tx())
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error_with(&e, REFERENCES)
        })?;
        Ok(())
    }

    async fn record(&mut self, event: PurchaseEvent) -> Result<(), RepositoryError> {
        self.tx.record(&event).await
    }

    async fn commit(self: Box<Self>) -> Result<(), RepositoryError> {
        self.tx.commit().await
    }
}

#[cfg(test)]
mod integration_tests {
    use super::*;
    use business::domain::purchase::{
        events::PurchaseSnapshot, model::PurchaseProps, repository::PurchaseRepositoryTrait,
    };

    use crate::purchase::repository::PgPurchaseRepository;
    use business::domain::supplier::model::SupplierId;

    async fn new_purchase(pool: &PgPool) -> Purchase {
        Purchase::new(PurchaseProps {
            supplier_id: crate::supplier::repository::integration_tests::seed(pool)
                .await
                .id,
            approver_id: None,
            total: 42,
        })
        .unwrap()
    }

    /// What a create use case does: save, record, commit.
    async fn create(pool: &PgPool, entity: &Purchase) -> Result<(), RepositoryError> {
        let mut uow = PgPurchaseUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await?;
        uow.save(entity).await?;
        uow.record(PurchaseEvent::Created(PurchaseSnapshot::from_entity(
            entity,
        )))
        .await?;
        uow.commit().await
    }

    async fn count(pool: &PgPool, sql: &str) -> i64 {
        sqlx::query_scalar(sql).fetch_one(pool).await.unwrap()
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_the_purchase_and_its_event_when_committed(pool: PgPool) {
        // Arrange
        let entity = new_purchase(&pool).await;

        // Act
        create(&pool, &entity).await.unwrap();

        // Assert
        let found = PgPurchaseRepository::new(pool.clone())
            .find_by_id(entity.id)
            .await
            .unwrap();
        assert!(found.is_some());
        let (event_type, aggregate_id): (String, uuid::Uuid) =
            sqlx::query_as("SELECT event_type, aggregate_id FROM outbox")
                .fetch_one(&pool)
                .await
                .unwrap();
        assert_eq!(event_type, "purchase_created");
        assert_eq!(aggregate_id, entity.id.value());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_nothing_when_dropped_without_commit(pool: PgPool) {
        // Arrange
        let entity = new_purchase(&pool).await;

        // Act
        {
            let mut uow = PgPurchaseUnitOfWorkFactory::new(pool.clone())
                .begin()
                .await
                .unwrap();
            uow.save(&entity).await.unwrap();
            uow.record(PurchaseEvent::Created(PurchaseSnapshot::from_entity(
                &entity,
            )))
            .await
            .unwrap();
        }

        // Assert
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM purchases").await, 0);
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_the_purchase_when_saved_again(pool: PgPool) {
        // Arrange
        let entity = new_purchase(&pool).await;
        create(&pool, &entity).await.unwrap();

        // Act
        let mut uow = PgPurchaseUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.save(&entity).await.unwrap();
        uow.commit().await.unwrap();

        // Assert
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM purchases").await, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_missing_supplier_id(pool: PgPool) {
        // Arrange: a supplier_id no row has.
        let mut entity = new_purchase(&pool).await;
        entity.supplier_id = SupplierId::generate();

        // Act
        let result = create(&pool, &entity).await;

        // Assert
        assert_eq!(
            result.unwrap_err(),
            RepositoryError::MissingReference("supplier_id")
        );
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_missing_approver_id(pool: PgPool) {
        // Arrange: a approver_id no row has.
        let mut entity = new_purchase(&pool).await;
        entity.approver_id = Some(SupplierId::generate());

        // Act
        let result = create(&pool, &entity).await;

        // Assert
        assert_eq!(
            result.unwrap_err(),
            RepositoryError::MissingReference("approver_id")
        );
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }
}

