use async_trait::async_trait;
use dominio_proveedor::errores::ErrorProveedor;
use dominio_proveedor::eventos::{EventoProveedor, SnapshotProveedor};
use dominio_proveedor::modelo::{PropsProveedor, Proveedor};
use dominio_proveedor::unit_of_work::UnitOfWorkFactoryProveedor;
use dominio_proveedor::valores::Name;
use puerto_nucleo::ErrorRepositorio;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearProveedor {
    pub name: String,
    pub email: String,
}

#[async_trait]
pub trait CrearProveedor: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearProveedor) -> Result<Proveedor, ErrorProveedor>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearProveedor {}

        #[async_trait]
        impl CrearProveedor for CrearProveedor {
            async fn ejecutar(&self, params: ParamsCrearProveedor) -> Result<Proveedor, ErrorProveedor>;
        }
    }
}

pub struct CrearProveedorImpl {
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProveedor>,
}

#[async_trait]
impl CrearProveedor for CrearProveedorImpl {
    async fn ejecutar(&self, params: ParamsCrearProveedor) -> Result<Proveedor, ErrorProveedor> {
        tracing::info!("crear_proveedor: inicio");
        let fallido = |e: &ErrorRepositorio| tracing::error!(error = %e, "crear_proveedor: fallo del repositorio");
        let name = Name::new(params.name)?;
        let entidad = Proveedor::new(PropsProveedor {
            name,
            email: params.email,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_proveedor: rechazado"))?;
        let mut uow = self.uow_factory.begin().await.inspect_err(fallido)?;
        uow.guardar(&entidad).await.inspect_err(fallido)?;
        uow.registrar(EventoProveedor::Creado(SnapshotProveedor::from_entidad(
            &entidad,
        )))
        .await
        .inspect_err(fallido)?;
        uow.commit().await.inspect_err(fallido)?;
        tracing::info!(id = %entidad.id, "crear_proveedor: fin");
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_proveedor::unit_of_work::dobles::{FallarEn, UnitOfWorkFactoryGrabadora};
    use puerto_nucleo::EventoDominio;

    #[tokio::test]
    async fn deberia_registrar_el_evento_proveedor_creado_cuando_los_campos_son_validos() {
        // Preparar
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = CrearProveedorImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProveedor {
                name: "example".to_string(),
                email: "example".to_string(),
            })
            .await;

        // Comprobar
        let entidad = match resultado {
            Ok(entidad) => entidad,
            Err(e) => panic!("la creación falló: {e}"),
        };
        assert_eq!(entidad.email, "example");
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert_eq!(grabado.guardados.len(), 1);
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "proveedor_creado");
        assert_eq!(grabado.eventos[0].id_agregado(), entidad.id.valor());
    }

    #[tokio::test]
    async fn no_deberia_hacer_commit_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let uow_factory =
            UnitOfWorkFactoryGrabadora::fallando_en(FallarEn::Guardar, ErrorRepositorio::Duplicado);
        let caso_de_uso = CrearProveedorImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProveedor {
                name: "example".to_string(),
                email: "example".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "proveedor.duplicado");
        let grabado = uow_factory.grabado();
        assert!(!grabado.confirmado);
        assert!(grabado.eventos.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_falla_el_commit() {
        // Preparar
        let uow_factory = UnitOfWorkFactoryGrabadora::fallando_en(
            FallarEn::Commit,
            ErrorRepositorio::NoDisponible,
        );
        let caso_de_uso = CrearProveedorImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProveedor {
                name: "example".to_string(),
                email: "example".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "proveedor.repositorio");
        assert!(!uow_factory.grabado().confirmado);
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_email_es_una_cadena_vacia() {
        // Preparar
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = CrearProveedorImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProveedor {
                name: "example".to_string(),
                email: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.validacion.email_vacio"
        );
        assert!(uow_factory.grabado().guardados.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_name_es_una_cadena_vacia() {
        // Preparar
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = CrearProveedorImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProveedor {
                name: "".to_string(),
                email: "example".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.name_invalido"
        );
        assert!(uow_factory.grabado().guardados.is_empty());
    }
}

