=== web/src/test-support/delivery.ts ===
import { DeliveryError } from "../domain/delivery/errors";
import type { Delivery, DeliveryDraft } from "../domain/delivery/model";
import type { DeliveryRepository } from "../domain/delivery/repository";

/** Valid deliveries for tests; pass `overrides` for the fields a test is about. */
export const DeliveryMother = {
  draft(overrides: Partial<DeliveryDraft> = {}): DeliveryDraft {
    return {
      purchaseId: crypto.randomUUID(),
      carrier: "example",
      ...overrides,
    };
  },

  random(overrides: Partial<Delivery> = {}): Delivery {
    return { id: crypto.randomUUID(), ...DeliveryMother.draft(), ...overrides };
  },
};

/** An in-memory `DeliveryRepository`. Override a method to make it fail. */
export function fakeDeliveryRepository(seed: Delivery[] = []): DeliveryRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new DeliveryError("delivery.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

