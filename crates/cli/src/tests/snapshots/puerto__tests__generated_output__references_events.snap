use crate::valores::Name;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorProveedor;

/// El id de cada `Proveedor`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdProveedor(Uuid);

impl IdProveedor {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdProveedor {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsProveedor {
    pub name: Name,
    pub email: String,
}

#[derive(Debug, Clone)]
pub struct Proveedor {
    pub id: IdProveedor,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: Name,
    pub email: String,
}

impl Proveedor {
    pub fn new(props: PropsProveedor) -> Result<Self, ErrorProveedor> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdProveedor::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            name: props.name,
            email: props.email,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsProveedor) -> Result<(), ErrorProveedor> {
        Self::validar(&props)?;
        self.name = props.name;
        self.email = props.email;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Proveedor) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsProveedor) -> Result<(), ErrorProveedor> {
        if props.email.trim().is_empty() {
            return Err(ErrorProveedor::Validacion("email_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreProveedor;

    #[test]
    fn deberia_crear_proveedor_cuando_los_campos_son_validos() {
        let resultado = Proveedor::new(MadreProveedor::new().construir_props());
        assert_eq!(
            resultado.unwrap().email,
            MadreProveedor::new().construir_props().email
        );
    }

    #[test]
    fn deberia_rechazar_proveedor_cuando_email_es_una_cadena_vacia() {
        let resultado = Proveedor::new(MadreProveedor::new().con_email_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.validacion.email_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_proveedor_cuando_email_solo_tiene_espacios() {
        let resultado = Proveedor::new(MadreProveedor::new().con_email("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_proveedor_cuando_email_es_una_cadena_vacia() {
        let mut entidad = MadreProveedor::aleatorio();
        let resultado =
            entidad.actualizar(MadreProveedor::new().con_email_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.validacion.email_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_proveedor_cuando_name_es_una_cadena_vacia() {
        let resultado = Name::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.name_invalido"
        );
    }
}

=== contextos/proveedor/dominio/src/pruebas/madres.rs ===
use crate::modelo::PropsProveedor;
use crate::modelo::Proveedor;
use crate::valores::Name;

pub struct MadreProveedor {
    name: Option<Name>,
    email: Option<String>,
}

impl MadreProveedor {
    pub fn new() -> Self {
        Self {
            name: None,
            email: None,
        }
    }

    pub fn con_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn con_email(mut self, email: &str) -> Self {
        self.email = Some(email.to_string());
        self
    }

    pub fn con_email_vacio(mut self) -> Self {
        self.email = Some(String::new());
        self
    }

    pub fn construir(self) -> Proveedor {
        Proveedor::new(PropsProveedor {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadreProveedor: Proveedor::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsProveedor {
        PropsProveedor {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Proveedor {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Proveedor> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreProveedor {
    fn default() -> Self {
        Self::new()
    }
}

