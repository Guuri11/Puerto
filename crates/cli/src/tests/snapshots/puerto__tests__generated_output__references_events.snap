use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::purchase::{
    errors::PurchaseError,
    events::{PurchaseEvent, PurchaseSnapshot},
    model::{Purchase, PurchaseProps},
    unit_of_work::PurchaseUnitOfWorkFactory,
    use_cases::create_purchase::{CreatePurchaseParams, CreatePurchaseUseCaseTrait},
};

pub struct CreatePurchaseUseCaseImpl {
    pub uow_factory: Arc<dyn PurchaseUnitOfWorkFactory>,
}

#[async_trait]
impl CreatePurchaseUseCaseTrait for CreatePurchaseUseCaseImpl {
    async fn execute(&self, params: CreatePurchaseParams) -> Result<Purchase, PurchaseError> {
        tracing::info!("create_purchase: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "create_purchase: repository failed");
        let entity = Purchase::new(PurchaseProps {
            supplier_id: params.supplier_id,
            approver_id: params.approver_id,
            total: params.total,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_purchase: rejected"))?;
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(PurchaseEvent::Created(PurchaseSnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        tracing::info!(id = %entity.id, "create_purchase: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::purchase::unit_of_work::mocks::{FailAt, RecordingUnitOfWorkFactory};
    use crate::domain::supplier::model::SupplierId;
    use puerto_core::DomainEvent;

    #[tokio::test]
    async fn should_record_purchase_created_when_fields_are_valid() {
        // Arrange
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = CreatePurchaseUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreatePurchaseParams {
                supplier_id: SupplierId::generate(),
                approver_id: None,
                total: 42,
            })
            .await;

        // Assert
        let entity = match result {
            Ok(entity) => entity,
            Err(e) => panic!("create failed: {e}"),
        };
        let recorded = uow_factory.recorded();
        assert!(recorded.committed);
        assert_eq!(recorded.saved.len(), 1);
        assert_eq!(recorded.events.len(), 1);
        assert_eq!(recorded.events[0].event_type(), "purchase_created");
        assert_eq!(recorded.events[0].aggregate_id(), entity.id.value());
    }

    #[tokio::test]
    async fn should_not_commit_when_the_store_rejects_a_duplicate() {
        // Arrange
        let uow_factory =
            RecordingUnitOfWorkFactory::failing_at(FailAt::Save, RepositoryError::Duplicate);
        let use_case = CreatePurchaseUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreatePurchaseParams {
                supplier_id: SupplierId::generate(),
                approver_id: None,
                total: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "purchase.duplicate");
        let recorded = uow_factory.recorded();
        assert!(!recorded.committed);
        assert!(recorded.events.is_empty());
    }

    #[tokio::test]
    async fn should_return_a_validation_error_when_the_supplier_id_does_not_exist() {
        // Arrange: the store found no Supplier with that id.
        let uow_factory = RecordingUnitOfWorkFactory::failing_at(
            FailAt::Save,
            RepositoryError::MissingReference("supplier_id"),
        );
        let use_case = CreatePurchaseUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreatePurchaseParams {
                supplier_id: SupplierId::generate(),
                approver_id: None,
                total: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "purchase.validation_error.supplier_id_not_found"
        );
        assert!(!uow_factory.recorded().committed);
    }

    #[tokio::test]
    async fn should_return_a_validation_error_when_the_approver_id_does_not_exist() {
        // Arrange: the store found no Supplier with that id.
        let uow_factory = RecordingUnitOfWorkFactory::failing_at(
            FailAt::Save,
            RepositoryError::MissingReference("approver_id"),
        );
        let use_case = CreatePurchaseUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreatePurchaseParams {
                supplier_id: SupplierId::generate(),
                approver_id: None,
                total: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "purchase.validation_error.approver_id_not_found"
        );
        assert!(!uow_factory.recorded().committed);
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_commit_fails() {
        // Arrange
        let uow_factory =
            RecordingUnitOfWorkFactory::failing_at(FailAt::Commit, RepositoryError::Unavailable);
        let use_case = CreatePurchaseUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreatePurchaseParams {
                supplier_id: SupplierId::generate(),
                approver_id: None,
                total: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "purchase.repository_error");
        assert!(!uow_factory.recorded().committed);
    }
}

=== business/src/application/purchase/delete_purchase.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::purchase::{
    errors::PurchaseError,
    events::{PurchaseEvent, PurchaseSnapshot},
    repository::PurchaseRepositoryTrait,
    unit_of_work::PurchaseUnitOfWorkFactory,
    use_cases::delete_purchase::{DeletePurchaseParams, DeletePurchaseUseCaseTrait},
};

pub struct DeletePurchaseUseCaseImpl {
    pub repository: Arc<dyn PurchaseRepositoryTrait>,
    pub uow_factory: Arc<dyn PurchaseUnitOfWorkFactory>,
}

#[async_trait]
impl DeletePurchaseUseCaseTrait for DeletePurchaseUseCaseImpl {
    async fn execute(&self, params: DeletePurchaseParams) -> Result<(), PurchaseError> {
        tracing::info!(id = %params.id, "delete_purchase: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "delete_purchase: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = PurchaseError::NotFound;
                tracing::warn!(error = %err, "delete_purchase: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(PurchaseEvent::Deleted(PurchaseSnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::purchase::{
        model::{Purchase, PurchaseId, PurchaseProps},
        repository::mocks::MockPurchaseRepository,
        unit_of_work::mocks::RecordingUnitOfWorkFactory,
    };
    use crate::domain::supplier::model::SupplierId;
    use puerto_core::DomainEvent;

    #[tokio::test]
    async fn should_record_purchase_deleted_when_id_exists() {
        // Arrange
        let entity = Purchase::new(PurchaseProps {
            supplier_id: SupplierId::generate(),
            approver_id: None,
            total: 42,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockPurchaseRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = DeletePurchaseUseCaseImpl {
            repository: Arc::new(mock_repo),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(DeletePurchaseParams { id: entity_id })
            .await;

        // Assert
        assert!(result.is_ok());
        let recorded = uow_factory.recorded();
        assert!(recorded.committed);
        assert!(recorded.saved.iter().all(|saved| saved.deleted));
        assert_eq!(recorded.events.len(), 1);
        assert_eq!(recorded.events[0].event_type(), "purchase_deleted");
        assert_eq!(recorded.events[0].aggregate_id(), entity_id.value());
    }

    #[tokio::test]
    async fn should_return_not_found_and_record_nothing_when_the_purchase_does_not_exist() {
        // Arrange
        let mut mock_repo = MockPurchaseRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = DeletePurchaseUseCaseImpl {
            repository: Arc::new(mock_repo),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(DeletePurchaseParams {
                id: PurchaseId::generate(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "purchase.not_found");
        assert!(uow_factory.recorded().events.is_empty());
    }
}

