=== contextos/compra/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad compra válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_compra::modelo::Compra;
use dominio_compra::modelo::PropsCompra;
use dominio_compra::pruebas::madres::MadreCompra;
use dominio_compra::unit_of_work::UnitOfWorkFactoryCompra;
use sqlx::PgPool;

use crate::unit_of_work::UnitOfWorkFactoryCompraPostgres;

/// Una entidad compra válida, sin guardar, con los valores de la madre salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada).
pub async fn construir(pool: &PgPool) -> Compra {
    Compra::new(PropsCompra {
        proveedor_id: infra_proveedor::pruebas::siembra::sembrar(pool).await.id,
        ..MadreCompra::new().construir_props()
    })
    .unwrap()
}

/// Guarda la entidad a través de la unidad de trabajo: el repositorio solo lee.
pub async fn guardar(pool: &PgPool, entidad: &Compra) {
    let mut uow = UnitOfWorkFactoryCompraPostgres::new(pool.clone())
        .begin()
        .await
        .unwrap();
    uow.guardar(entidad).await.unwrap();
    uow.commit().await.unwrap();
}

/// Una entidad compra guardada.
pub async fn sembrar(pool: &PgPool) -> Compra {
    let entidad = construir(pool).await;
    guardar(pool, &entidad).await;
    entidad
}

=== contextos/compra/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_compra::{
    modelo::{Compra, IdCompra},
    repositorio::{FiltroCompra, RepositorioCompra},
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::mapear_error_sqlx;

use crate::fila::FilaCompra;

pub struct RepositorioCompraPostgres {
    pub pool: PgPool,
}

impl RepositorioCompraPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaCompra) -> Result<Compra, ErrorRepositorio> {
    Compra::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad compra válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioCompra for RepositorioCompraPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroCompra,
    ) -> Result<Pagina<Compra>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        // Una sola consulta estática sea cual sea el filtro: un id sin valor es NULL y casa con
        // todas las filas.
        let proveedor_id = filtro.proveedor_id.map(|id| id.valor());
        let approver_id = filtro.approver_id.map(|id| id.valor());
        let filas = sqlx::query_as!(
            FilaCompra,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, proveedor_id, approver_id, total
             FROM compras WHERE borrado = false AND ($3::uuid IS NULL OR proveedor_id = $3) AND ($4::uuid IS NULL OR approver_id = $4)
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento()),
            proveedor_id,
            approver_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM compras WHERE borrado = false AND ($1::uuid IS NULL OR proveedor_id = $1) AND ($2::uuid IS NULL OR approver_id = $2)"#,
            proveedor_id,
            approver_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdCompra) -> Result<Option<Compra>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaCompra,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, proveedor_id, approver_id, total
             FROM compras WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::{construir, guardar, sembrar};

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioCompraPostgres {
        RepositorioCompraPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.proveedor_id, entidad.proveedor_id);
        assert_eq!(encontrado.approver_id, entidad.approver_id);
        assert_eq!(encontrado.total, entidad.total);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdCompra::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_compras_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        guardar(&pool, &borrado).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default(), FiltroCompra::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::new(Some(2), Some(2)),
                FiltroCompra::default(),
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_compras_con_ese_valor_de_proveedor_id(pool: PgPool) {
        // Preparar: una entidad compra con este valor de proveedor_id y otra sin él.
        let destino = infra_proveedor::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.proveedor_id = destino.id;
        guardar(&pool, &esperado).await;
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroCompra {
                    proveedor_id: Some(destino.id),
                    approver_id: None,
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_compras_con_ese_valor_de_approver_id(pool: PgPool) {
        // Preparar: una entidad compra con este valor de approver_id y otra sin él.
        let destino = infra_proveedor::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.approver_id = Some(destino.id);
        guardar(&pool, &esperado).await;
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroCompra {
                    proveedor_id: None,
                    approver_id: Some(destino.id),
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }
}

=== contextos/compra/infraestructura/src/unit_of_work.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_compra::{
    eventos::EventoCompra,
    modelo::Compra,
    unit_of_work::{UnitOfWorkCompra, UnitOfWorkFactoryCompra},
};
use puerto_nucleo::ErrorRepositorio;
use puerto_sqlx::uow::TransaccionPostgres;
use puerto_sqlx::{ClaveForanea, mapear_error_sqlx_con};

use crate::fila::FilaCompra;

/// Abre una transacción de Postgres por escritura: la fila de compra y su evento del outbox
/// hacen commit juntos.
pub struct UnitOfWorkFactoryCompraPostgres {
    pub pool: PgPool,
}

impl UnitOfWorkFactoryCompraPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Las claves foráneas por las que pasa una escritura (ADR-0022 de Puerto): la base de datos
/// rechaza una referencia a una fila que no existe, y quien llama recibe como error el campo que la
/// nombra.
const REFERENCES: &[ClaveForanea] = &[
    ClaveForanea {
        restriccion: "compras_proveedor_id_fkey",
        campo: "proveedor_id",
    },
    ClaveForanea {
        restriccion: "compras_approver_id_fkey",
        campo: "approver_id",
    },
];

#[async_trait]
impl UnitOfWorkFactoryCompra for UnitOfWorkFactoryCompraPostgres {
    async fn begin(&self) -> Result<Box<dyn UnitOfWorkCompra>, ErrorRepositorio> {
        let tx = TransaccionPostgres::begin(&self.pool).await?;
        Ok(Box::new(UnitOfWorkCompraPostgres { tx }))
    }
}

struct UnitOfWorkCompraPostgres {
    tx: TransaccionPostgres,
}

#[async_trait]
impl UnitOfWorkCompra for UnitOfWorkCompraPostgres {
    async fn guardar(&mut self, entidad: &Compra) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaCompra::from(entidad);
        sqlx::query!(
            "INSERT INTO compras (id, creado_en, actualizado_en, borrado, borrado_en, proveedor_id, approver_id, total)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, proveedor_id = $6, approver_id = $7, total = $8",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.proveedor_id,
            db.approver_id,
            db.total,
        )
        .execute(self.tx.tx())
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx_con(&e, REFERENCES)
        })?;
        Ok(())
    }

    async fn registrar(&mut self, evento: EventoCompra) -> Result<(), ErrorRepositorio> {
        self.tx.registrar(&evento).await
    }

    async fn commit(self: Box<Self>) -> Result<(), ErrorRepositorio> {
        self.tx.commit().await
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use dominio_compra::{eventos::SnapshotCompra, repositorio::RepositorioCompra};

    use crate::pruebas::siembra::construir;
    use crate::repositorio::RepositorioCompraPostgres;
    use dominio_proveedor::modelo::IdProveedor;

    /// Lo que hace un caso de uso de creación: guardar, registrar, commit.
    async fn crear(pool: &PgPool, entidad: &Compra) -> Result<(), ErrorRepositorio> {
        let mut uow = UnitOfWorkFactoryCompraPostgres::new(pool.clone())
            .begin()
            .await?;
        uow.guardar(entidad).await?;
        uow.registrar(EventoCompra::Creado(SnapshotCompra::from_entidad(entidad)))
            .await?;
        uow.commit().await
    }

    async fn contar(pool: &PgPool, sql: &str) -> i64 {
        sqlx::query_scalar(sql).fetch_one(pool).await.unwrap()
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_escribir_compra_y_su_evento_cuando_hace_commit(pool: PgPool) {
        // Preparar
        let entidad = construir(&pool).await;

        // Actuar
        crear(&pool, &entidad).await.unwrap();

        // Comprobar
        let encontrado = RepositorioCompraPostgres::new(pool.clone())
            .buscar_por_id(entidad.id)
            .await
            .unwrap();
        assert!(encontrado.is_some());
        let (tipo_evento, id_agregado): (String, uuid::Uuid) =
            sqlx::query_as("SELECT tipo_evento, id_agregado FROM outbox")
                .fetch_one(&pool)
                .await
                .unwrap();
        assert_eq!(tipo_evento, "compra_creado");
        assert_eq!(id_agregado, entidad.id.valor());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn no_deberia_escribir_nada_cuando_se_libera_sin_commit(pool: PgPool) {
        // Preparar
        let entidad = construir(&pool).await;

        // Actuar
        {
            let mut uow = UnitOfWorkFactoryCompraPostgres::new(pool.clone())
                .begin()
                .await
                .unwrap();
            uow.guardar(&entidad).await.unwrap();
            uow.registrar(EventoCompra::Creado(SnapshotCompra::from_entidad(&entidad)))
                .await
                .unwrap();
        }

        // Comprobar
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM compras").await, 0);
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_compra_cuando_se_guarda_de_nuevo(pool: PgPool) {
        // Preparar
        let entidad = construir(&pool).await;
        crear(&pool, &entidad).await.unwrap();

        // Actuar
        let mut uow = UnitOfWorkFactoryCompraPostgres::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.guardar(&entidad).await.unwrap();
        uow.commit().await.unwrap();

        // Comprobar
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM compras").await, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_proveedor_id_inexistente(pool: PgPool) {
        // Preparar: un valor de proveedor_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.proveedor_id = IdProveedor::generar();

        // Actuar
        let resultado = crear(&pool, &entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("proveedor_id")
        );
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_approver_id_inexistente(pool: PgPool) {
        // Preparar: un valor de approver_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.approver_id = Some(IdProveedor::generar());

        // Actuar
        let resultado = crear(&pool, &entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("approver_id")
        );
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }
}

