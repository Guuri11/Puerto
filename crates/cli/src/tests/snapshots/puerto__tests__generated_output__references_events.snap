import type { Page, PageRequest } from "../shared/page";
import type { Purchase, PurchaseDraft } from "./model";

/** The port the screens call. Every method rejects with the `PurchaseError` the API answered. */
export interface PurchaseRepository {
  list(page: PageRequest): Promise<Page<Purchase>>;
  get(id: string): Promise<Purchase>;
  create(draft: PurchaseDraft): Promise<Purchase>;
  update(id: string, draft: PurchaseDraft): Promise<Purchase>;
