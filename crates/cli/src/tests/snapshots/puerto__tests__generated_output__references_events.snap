=== web/src/presentation/features/proveedor/views/proveedor-form-view.tsx ===
import type { ProveedorProblem } from "../../../../domain/proveedor/messages";
import type { Proveedor, ProveedorDraft } from "../../../../domain/proveedor/model";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ProveedorFormValues {
  name: string;
  email: string;
}

/** The inputs for `proveedor`, empty when there is none yet. */
export function toProveedorForm(proveedor: Proveedor | null): ProveedorFormValues {
  if (proveedor === null) {
    return {
      name: "",
      email: "",
    };
  }
  return {
    name: proveedor.name,
    email: proveedor.email,
  };
}

export function toProveedorDraft(values: ProveedorFormValues): ProveedorDraft {
  return {
    name: values.name,
    email: values.email,
  };
}

export function ProveedorFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: ProveedorFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: ProveedorProblem | null;
  onChange: (values: ProveedorFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "name"}
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "email"}
          required
          value={values.email}
          onChange={(event) => onChange({ ...values, email: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="email" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

