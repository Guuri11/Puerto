=== web/src/presentation/features/purchase/views/purchase-form-view.tsx ===
import type { PurchaseProblem } from "../../../../domain/purchase/messages";
import type { Purchase, PurchaseDraft } from "../../../../domain/purchase/model";
import { type ReferenceOption, textOf, textOrNull } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface PurchaseFormValues {
  supplierId: string;
  approverId: string;
  total: string;
}

/** The inputs for `purchase`, empty when there is none yet. */
export function toPurchaseForm(purchase: Purchase | null): PurchaseFormValues {
  if (purchase === null) {
    return {
      supplierId: "",
      approverId: "",
      total: "",
    };
  }
  return {
    supplierId: purchase.supplierId,
    approverId: textOf(purchase.approverId),
    total: String(purchase.total),
  };
}

/** What each reference's select offers. */
export interface PurchaseFormOptions {
  supplierId: ReferenceOption[];
  approverId: ReferenceOption[];
}

export function toPurchaseDraft(values: PurchaseFormValues): PurchaseDraft {
  return {
    supplierId: values.supplierId,
    approverId: textOrNull(values.approverId),
    total: Number(values.total),
  };
}

export function PurchaseFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: PurchaseFormValues;
  options: PurchaseFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: PurchaseProblem | null;
  onChange: (values: PurchaseFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Supplier</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "supplierId"}
          required
          value={values.supplierId}
          onChange={(event) => onChange({ ...values, supplierId: event.target.value })}
        >
          <option value="">Choose a supplier</option>
          {options.supplierId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="supplierId" />
      <label className="fieldset">
        <span className="fieldset-legend">Approver</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "approverId"}
          value={values.approverId}
          onChange={(event) => onChange({ ...values, approverId: event.target.value })}
        >
          <option value="">None</option>
          {options.approverId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="approverId" />
      <label className="fieldset">
        <span className="fieldset-legend">Total</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "total"}
          required
          value={values.total}
          onChange={(event) => onChange({ ...values, total: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="total" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

