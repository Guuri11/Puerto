use std::sync::Arc;

use crate::domain::supplier::value_objects::Name;
use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::supplier::{
    errors::SupplierError,
    events::{SupplierEvent, SupplierSnapshot},
    model::{Supplier, SupplierProps},
    unit_of_work::SupplierUnitOfWorkFactory,
    use_cases::create_supplier::{CreateSupplierParams, CreateSupplierUseCaseTrait},
};

pub struct CreateSupplierUseCaseImpl {
    pub uow_factory: Arc<dyn SupplierUnitOfWorkFactory>,
}

#[async_trait]
impl CreateSupplierUseCaseTrait for CreateSupplierUseCaseImpl {
    async fn execute(&self, params: CreateSupplierParams) -> Result<Supplier, SupplierError> {
        tracing::info!("create_supplier: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "create_supplier: repository failed");
        let name = Name::new(params.name)?;
        let entity = Supplier::new(SupplierProps {
            name,
            email: params.email,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_supplier: rejected"))?;
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(SupplierEvent::Created(SupplierSnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        tracing::info!(id = %entity.id, "create_supplier: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::supplier::unit_of_work::mocks::{FailAt, RecordingUnitOfWorkFactory};
    use puerto_core::DomainEvent;

    #[tokio::test]
    async fn should_record_supplier_created_when_fields_are_valid() {
        // Arrange
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = CreateSupplierUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreateSupplierParams {
                name: "example".to_string(),
                email: "example".to_string(),
            })
            .await;

        // Assert
        let entity = match result {
            Ok(entity) => entity,
            Err(e) => panic!("create failed: {e}"),
        };
        assert_eq!(entity.email, "example");
        let recorded = uow_factory.recorded();
        assert!(recorded.committed);
        assert_eq!(recorded.saved.len(), 1);
        assert_eq!(recorded.events.len(), 1);
        assert_eq!(recorded.events[0].event_type(), "supplier_created");
        assert_eq!(recorded.events[0].aggregate_id(), entity.id.value());
    }

    #[tokio::test]
    async fn should_not_commit_when_the_store_rejects_a_duplicate() {
        // Arrange
        let uow_factory =
            RecordingUnitOfWorkFactory::failing_at(FailAt::Save, RepositoryError::Duplicate);
        let use_case = CreateSupplierUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreateSupplierParams {
                name: "example".to_string(),
                email: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "supplier.duplicate");
        let recorded = uow_factory.recorded();
        assert!(!recorded.committed);
        assert!(recorded.events.is_empty());
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_commit_fails() {
        // Arrange
        let uow_factory =
            RecordingUnitOfWorkFactory::failing_at(FailAt::Commit, RepositoryError::Unavailable);
        let use_case = CreateSupplierUseCaseImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(CreateSupplierParams {
                name: "example".to_string(),
                email: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "supplier.repository_error");
        assert!(!uow_factory.recorded().committed);
    }

    #[tokio::test]
    async fn should_return_error_and_record_nothing_when_email_is_empty() {
        // Arrange
