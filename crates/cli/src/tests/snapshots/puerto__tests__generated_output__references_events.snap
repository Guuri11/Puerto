import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { DeliveryError } from "../../../../domain/delivery/errors";
import type { DeliveryDraft } from "../../../../domain/delivery/model";
import { DeliveryMother, fakeDeliveryRepository } from "../../../../test-support/delivery";
import { fakePurchaseRepository, PurchaseMother } from "../../../../test-support/purchase";
import { renderScreen } from "../../../../test-support/render";
import { DeliveryFormContainer } from "./delivery-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: DeliveryDraft) {
  return {
    purchaseRepository: fakePurchaseRepository([PurchaseMother.random({ id: draft.purchaseId })]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: DeliveryDraft) {
  await screen.findByText("Save");
  await choose("Purchase", draft.purchaseId);
  type("Carrier", draft.carrier);
}

describe("DeliveryFormContainer", () => {
  test("should create the delivery from what was typed and show it", async () => {
    // Arrange
    const draft = DeliveryMother.draft();
    const deliveryRepository = fakeDeliveryRepository();
    const { history } = renderScreen(<DeliveryFormContainer />, {
      deliveryRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/deliveries/"));
    const {
      items: [created],
    } = await deliveryRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/deliveries/${created?.id}`);
  });

  test("should save the edited delivery when an existing one is submitted", async () => {
    // Arrange
    const seeded = DeliveryMother.random();
    const deliveryRepository = fakeDeliveryRepository([seeded]);
    const { history } = renderScreen(<DeliveryFormContainer id={seeded.id} />, {
      deliveryRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/deliveries/${seeded.id}`));
    expect(await deliveryRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "delivery.validation_error.invalid";
    const deliveryRepository = {
      ...fakeDeliveryRepository(),
      create: () => Promise.reject(new DeliveryError(code)),
    };
    const draft = DeliveryMother.draft();
    renderScreen(<DeliveryFormContainer />, {
      deliveryRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a delivery with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const deliveryRepository = {
      ...fakeDeliveryRepository(),
      create: () => Promise.reject(new DeliveryError("delivery.duplicate")),
    };
    const draft = DeliveryMother.draft();
    renderScreen(<DeliveryFormContainer />, {
      deliveryRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A delivery with these values already exists",
    );
  });

  test("should offer every purchase in the selects that reference one", async () => {
    // Arrange
    const purchase = PurchaseMother.random();

    // Act
    renderScreen(<DeliveryFormContainer />, {
      deliveryRepository: fakeDeliveryRepository(),
      purchaseRepository: fakePurchaseRepository([purchase]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: purchase.id });
    expect(options).toHaveLength(1);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const deliveryRepository = {
      ...fakeDeliveryRepository(),
      create: () =>
        Promise.reject(new DeliveryError("delivery.validation_error.purchase_id_not_found")),
    };
    const draft = DeliveryMother.draft();
    renderScreen(<DeliveryFormContainer />, {
      deliveryRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Purchase does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Purchase");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/delivery/containers/delivery-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/delivery/messages";
import type { Delivery } from "../../../../domain/delivery/model";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { DeliveryFormView, toDeliveryDraft, toDeliveryForm } from "../views/delivery-form-view";

/** Creates a delivery, or edits the one with `id`. */
export function DeliveryFormContainer({ id }: { id?: string }) {
  const { deliveryRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : deliveryRepository.get(id)),
    [deliveryRepository, id],
  );
  const title = id === undefined ? "New delivery" : "Edit delivery";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <DeliveryForm existing={existing.data} />}
      <Link href={id === undefined ? "/deliveries" : `/deliveries/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function DeliveryForm({ existing }: { existing: Delivery | null }) {
  const { deliveryRepository, purchaseRepository } = useDependencies();
  const purchases = useAsync(
    () => purchaseRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [purchaseRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toDeliveryForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toDeliveryDraft(values);
      const saved =
        existing === null
          ? await deliveryRepository.create(draft)
          : await deliveryRepository.update(existing.id, draft);
      navigate(`/deliveries/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {purchases.status === "error" && <ErrorAlert error={purchases.error} />}
        <DeliveryFormView
          values={values}
          options={{
            purchaseId: referenceOptions(purchases, (purchase) => purchase.id),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

