use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::supplier::{
    errors::SupplierError,
    events::{SupplierEvent, SupplierSnapshot},
    repository::SupplierRepositoryTrait,
    unit_of_work::SupplierUnitOfWorkFactory,
    use_cases::delete_supplier::{DeleteSupplierParams, DeleteSupplierUseCaseTrait},
};

pub struct DeleteSupplierUseCaseImpl {
    pub repository: Arc<dyn SupplierRepositoryTrait>,
    pub uow_factory: Arc<dyn SupplierUnitOfWorkFactory>,
}

#[async_trait]
impl DeleteSupplierUseCaseTrait for DeleteSupplierUseCaseImpl {
    async fn execute(&self, params: DeleteSupplierParams) -> Result<(), SupplierError> {
        tracing::info!(id = %params.id, "delete_supplier: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "delete_supplier: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = SupplierError::NotFound;
                tracing::warn!(error = %err, "delete_supplier: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(SupplierEvent::Deleted(SupplierSnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(())
    }
}

