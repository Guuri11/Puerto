=== contextos/entrega/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorEntrega {
    #[error("entrega.validacion.{0}")]
    Validacion(String),
    #[error("entrega.no_encontrado")]
    NoEncontrado,
    #[error("entrega.duplicado")]
    Duplicado,
    #[error("entrega.repositorio")]
    Repositorio,
    #[error("entrega.desconocido")]
    Desconocido,
}

impl From<ErrorRepositorio> for ErrorEntrega {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            // Una referencia nombra una fila inexistente: la entrada de quien llama, en ese campo.
            ErrorRepositorio::ReferenciaInexistente(campo) => {
                Self::Validacion(format!("{campo}_no_encontrado"))
            }
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorEntrega::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "entrega.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorEntrega::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "entrega.repositorio");
    }

    #[test]
    fn deberia_convertir_una_referencia_inexistente_en_una_validacion_de_su_campo() {
        let err = ErrorEntrega::from(ErrorRepositorio::ReferenciaInexistente("compra_id"));
        assert_eq!(
            err.to_string(),
            "entrega.validacion.compra_id_no_encontrado"
        );
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorEntrega::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "entrega.repositorio");
    }
}

=== contextos/entrega/dominio/src/eventos.rs ===
// GENERADO por puerto desde puerto.toml — no lo edites a mano. El snapshot sigue los campos de la
// entidad; añade un evento con `puerto generar evento Entrega <nombre>`.
use puerto_nucleo::EventoDominio;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use crate::modelo::Entrega;

pub const ENTREGA_CREADO: &str = "entrega_creado";
pub const ENTREGA_ACTUALIZADO: &str = "entrega_actualizado";
pub const ENTREGA_BORRADO: &str = "entrega_borrado";

/// Lo que lleva cada evento de entrega: sus datos tal como los muestra la API — primitivos, con
/// los objetos valor desenvueltos. Un contrato público: los consumidores lo decodifican con
/// `evento.decodificar::<SnapshotEntrega>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct SnapshotEntrega {
    pub id: Uuid,
    pub compra_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

impl SnapshotEntrega {
    pub fn from_entidad(entidad: &Entrega) -> Self {
        Self {
            id: entidad.id.valor(),
            compra_id: entidad.compra_id.valor(),
            destinatario_id: entidad.destinatario_id.map(|v| v.valor()),
            carrier: entidad.carrier.clone(),
        }
    }
}

/// Lo que le pasa a cada entrega. Sus casos de uso de escritura registran uno con su unidad de
/// trabajo.
#[derive(Debug, Clone, PartialEq)]
pub enum EventoEntrega {
    Creado(SnapshotEntrega),
    Actualizado(SnapshotEntrega),
    Borrado(SnapshotEntrega),
}

impl EventoEntrega {
    pub fn snapshot(&self) -> &SnapshotEntrega {
        match self {
            Self::Creado(snapshot) | Self::Actualizado(snapshot) | Self::Borrado(snapshot) => {
                snapshot
            }
        }
    }
}

impl EventoDominio for EventoEntrega {
    fn tipo_evento(&self) -> &'static str {
        match self {
            Self::Creado(_) => ENTREGA_CREADO,
            Self::Actualizado(_) => ENTREGA_ACTUALIZADO,
            Self::Borrado(_) => ENTREGA_BORRADO,
        }
    }

    fn tipo_agregado(&self) -> &'static str {
        "entrega"
    }

    fn id_agregado(&self) -> Uuid {
        self.snapshot().id
    }

    fn version_esquema(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // Un snapshot solo tiene primitivos: serializarlo no puede fallar.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreEntrega;

    #[test]
    fn deberia_describir_cada_evento_cuando_se_registra() {
        // Preparar
        let entidad = MadreEntrega::aleatorio();
        let snapshot = SnapshotEntrega::from_entidad(&entidad);
        let eventos = [
            (EventoEntrega::Creado(snapshot.clone()), "entrega_creado"),
            (
                EventoEntrega::Actualizado(snapshot.clone()),
                "entrega_actualizado",
            ),
            (EventoEntrega::Borrado(snapshot.clone()), "entrega_borrado"),
        ];

        for (evento, tipo_evento) in eventos {
            // Actuar y comprobar
            assert_eq!(evento.tipo_evento(), tipo_evento);
            assert_eq!(evento.tipo_agregado(), "entrega");
            assert_eq!(evento.id_agregado(), entidad.id.valor());
            assert_eq!(evento.version_esquema(), 1);
            assert_eq!(evento.snapshot(), &snapshot);
        }
    }

    #[test]
    fn deberia_mantener_el_contrato_json_cuando_se_serializa_el_snapshot() {
        // Preparar
        let snapshot = SnapshotEntrega::from_entidad(&MadreEntrega::aleatorio());

        // Actuar
        let payload = EventoEntrega::Creado(snapshot.clone()).payload();

        // Comprobar — una clave renombrada o quitada rompe a cada consumidor de estos eventos.
        let mut claves: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        claves.sort_unstable();
        assert_eq!(claves, ["carrier", "compraId", "destinatarioId", "id"]);
        assert_eq!(
            serde_json::from_value::<SnapshotEntrega>(payload).ok(),
            Some(snapshot)
        );
    }
}

