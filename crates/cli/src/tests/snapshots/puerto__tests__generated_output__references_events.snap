/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL is not set — set it in .env (.env.example has one)".to_string()
    })?;
    let pool = infrastructure::db::create_postgres_pool(&database_url)
        .await
        .map_err(|e| format!("{e} — is the database up? `make docker-compose/up`"))?;
    infrastructure::db::run_migrations(&pool, &infrastructure::db::MIGRATOR)
        .await
        .map_err(|e| e.to_string())?;

    let get_greeting = Arc::new(GetGreetingUseCaseImpl {
        repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait>,
    });
    let greeting_api = GreetingApi { get_greeting };

    let supplier_repo: Arc<dyn SupplierRepositoryTrait> =
        Arc::new(PgSupplierRepository::new(pool.clone()));
    let supplier_uow: Arc<dyn SupplierUnitOfWorkFactory> =
        Arc::new(PgSupplierUnitOfWorkFactory::new(pool.clone()));
    let create_supplier = Arc::new(CreateSupplierUseCaseImpl {
        uow_factory: Arc::clone(&supplier_uow),
    });
    let get_supplier = Arc::new(GetSupplierUseCaseImpl {
        repository: Arc::clone(&supplier_repo),
    });
    let list_suppliers = Arc::new(ListSuppliersUseCaseImpl {
        repository: Arc::clone(&supplier_repo),
    });
    let update_supplier = Arc::new(UpdateSupplierUseCaseImpl {
        repository: Arc::clone(&supplier_repo),
        uow_factory: Arc::clone(&supplier_uow),
    });
    let delete_supplier = Arc::new(DeleteSupplierUseCaseImpl {
        repository: Arc::clone(&supplier_repo),
        uow_factory: Arc::clone(&supplier_uow),
    });
    let supplier_api = SupplierApi {
        create_supplier,
        get_supplier,
        list_suppliers,
        update_supplier,
        delete_supplier,
    };

    let purchase_repo: Arc<dyn PurchaseRepositoryTrait> =
        Arc::new(PgPurchaseRepository::new(pool.clone()));
    let purchase_uow: Arc<dyn PurchaseUnitOfWorkFactory> =
        Arc::new(PgPurchaseUnitOfWorkFactory::new(pool.clone()));
    let create_purchase = Arc::new(CreatePurchaseUseCaseImpl {
        uow_factory: Arc::clone(&purchase_uow),
    });
    let get_purchase = Arc::new(GetPurchaseUseCaseImpl {
        repository: Arc::clone(&purchase_repo),
    });
    let list_purchases = Arc::new(ListPurchasesUseCaseImpl {
        repository: Arc::clone(&purchase_repo),
    });
    let update_purchase = Arc::new(UpdatePurchaseUseCaseImpl {
        repository: Arc::clone(&purchase_repo),
        uow_factory: Arc::clone(&purchase_uow),
    });
    let delete_purchase = Arc::new(DeletePurchaseUseCaseImpl {
        repository: Arc::clone(&purchase_repo),
        uow_factory: Arc::clone(&purchase_uow),
    });
    let purchase_api = PurchaseApi {
        create_purchase,
        get_purchase,
        list_purchases,
        update_purchase,
        delete_purchase,
    };

    let delivery_repo: Arc<dyn DeliveryRepositoryTrait> =
        Arc::new(PgDeliveryRepository::new(pool.clone()));
    let delivery_uow: Arc<dyn DeliveryUnitOfWorkFactory> =
        Arc::new(PgDeliveryUnitOfWorkFactory::new(pool.clone()));
    let create_delivery = Arc::new(CreateDeliveryUseCaseImpl {
        uow_factory: Arc::clone(&delivery_uow),
    });
    let get_delivery = Arc::new(GetDeliveryUseCaseImpl {
        repository: Arc::clone(&delivery_repo),
    });
    let list_deliveries = Arc::new(ListDeliveriesUseCaseImpl {
        repository: Arc::clone(&delivery_repo),
    });
    let update_delivery = Arc::new(UpdateDeliveryUseCaseImpl {
        repository: Arc::clone(&delivery_repo),
        uow_factory: Arc::clone(&delivery_uow),
    });
    let delete_delivery = Arc::new(DeleteDeliveryUseCaseImpl {
        repository: Arc::clone(&delivery_repo),
        uow_factory: Arc::clone(&delivery_uow),
    });
    let delivery_api = DeliveryApi {
        create_delivery,
        get_delivery,
        list_deliveries,
        update_delivery,
        delete_delivery,
    };

    let ready = puerto_web::health::probe(move || {
        let pool = pool.clone();
        async move { infrastructure::db::ping(&pool).await }
    });

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::routes(
        openapi_service((greeting_api, supplier_api, purchase_api, delivery_api)),
        &config,
        ready,
    )))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;

    use business::domain::delivery::use_cases::create_delivery::mocks::MockCreateDeliveryUseCase;
    use business::domain::delivery::use_cases::delete_delivery::mocks::MockDeleteDeliveryUseCase;
    use business::domain::delivery::use_cases::get_delivery::mocks::MockGetDeliveryUseCase;
    use business::domain::delivery::use_cases::list_deliveries::mocks::MockListDeliveriesUseCase;
    use business::domain::delivery::use_cases::update_delivery::mocks::MockUpdateDeliveryUseCase;
    use business::domain::greeting::use_cases::get_greeting::mocks::MockGetGreetingUseCase;
    use business::domain::purchase::use_cases::create_purchase::mocks::MockCreatePurchaseUseCase;
    use business::domain::purchase::use_cases::delete_purchase::mocks::MockDeletePurchaseUseCase;
    use business::domain::purchase::use_cases::get_purchase::mocks::MockGetPurchaseUseCase;
    use business::domain::purchase::use_cases::list_purchases::mocks::MockListPurchasesUseCase;
    use business::domain::purchase::use_cases::update_purchase::mocks::MockUpdatePurchaseUseCase;
    use business::domain::supplier::use_cases::create_supplier::mocks::MockCreateSupplierUseCase;
    use business::domain::supplier::use_cases::delete_supplier::mocks::MockDeleteSupplierUseCase;
    use business::domain::supplier::use_cases::get_supplier::mocks::MockGetSupplierUseCase;
    use business::domain::supplier::use_cases::list_suppliers::mocks::MockListSuppliersUseCase;
    use business::domain::supplier::use_cases::update_supplier::mocks::MockUpdateSupplierUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let greeting_api = GreetingApi {
            get_greeting: Arc::new(MockGetGreetingUseCase::new()),
        };
        let supplier_api = SupplierApi {
            create_supplier: Arc::new(MockCreateSupplierUseCase::new()),
            get_supplier: Arc::new(MockGetSupplierUseCase::new()),
            list_suppliers: Arc::new(MockListSuppliersUseCase::new()),
            update_supplier: Arc::new(MockUpdateSupplierUseCase::new()),
            delete_supplier: Arc::new(MockDeleteSupplierUseCase::new()),
        };
        let purchase_api = PurchaseApi {
            create_purchase: Arc::new(MockCreatePurchaseUseCase::new()),
            get_purchase: Arc::new(MockGetPurchaseUseCase::new()),
            list_purchases: Arc::new(MockListPurchasesUseCase::new()),
            update_purchase: Arc::new(MockUpdatePurchaseUseCase::new()),
            delete_purchase: Arc::new(MockDeletePurchaseUseCase::new()),
        };
        let delivery_api = DeliveryApi {
            create_delivery: Arc::new(MockCreateDeliveryUseCase::new()),
            get_delivery: Arc::new(MockGetDeliveryUseCase::new()),
            list_deliveries: Arc::new(MockListDeliveriesUseCase::new()),
            update_delivery: Arc::new(MockUpdateDeliveryUseCase::new()),
            delete_delivery: Arc::new(MockDeleteDeliveryUseCase::new()),
        };
        let spec = openapi_service((greeting_api, supplier_api, purchase_api, delivery_api)).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

