=== contextos/proveedor/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorProveedor {
    #[error("proveedor.validacion.{0}")]
    Validacion(String),
    #[error("proveedor.no_encontrado")]
    NoEncontrado,
    #[error("proveedor.duplicado")]
    Duplicado,
    #[error("proveedor.repositorio")]
    Repositorio,
    #[error("proveedor.desconocido")]
    Desconocido,
    #[error("proveedor.name_invalido")]
    NameInvalido,
}

impl From<ErrorRepositorio> for ErrorProveedor {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorProveedor::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "proveedor.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorProveedor::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "proveedor.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorProveedor::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "proveedor.repositorio");
    }
}

=== contextos/proveedor/dominio/src/eventos.rs ===
// GENERADO por puerto desde puerto.toml — no lo edites a mano. El snapshot sigue los campos de la
// entidad; añade un evento con `puerto generar evento Proveedor <nombre>`.
use puerto_nucleo::EventoDominio;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use crate::modelo::Proveedor;

pub const PROVEEDOR_CREADO: &str = "proveedor_creado";
pub const PROVEEDOR_ACTUALIZADO: &str = "proveedor_actualizado";
pub const PROVEEDOR_BORRADO: &str = "proveedor_borrado";

/// Lo que lleva cada evento de proveedor: sus datos tal como los muestra la API — primitivos, con
/// los objetos valor desenvueltos. Un contrato público: los consumidores lo decodifican con
/// `evento.decodificar::<SnapshotProveedor>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct SnapshotProveedor {
    pub id: Uuid,
    pub name: String,
    pub email: String,
}

impl SnapshotProveedor {
    pub fn from_entidad(entidad: &Proveedor) -> Self {
        Self {
            id: entidad.id.valor(),
            name: entidad.name.valor().to_string(),
            email: entidad.email.clone(),
        }
    }
}

/// Lo que le pasa a cada proveedor. Sus casos de uso de escritura registran uno con su unidad de
/// trabajo.
#[derive(Debug, Clone, PartialEq)]
pub enum EventoProveedor {
    Creado(SnapshotProveedor),
    Actualizado(SnapshotProveedor),
    Borrado(SnapshotProveedor),
}

impl EventoProveedor {
    pub fn snapshot(&self) -> &SnapshotProveedor {
        match self {
            Self::Creado(snapshot) | Self::Actualizado(snapshot) | Self::Borrado(snapshot) => {
                snapshot
            }
        }
    }
}

impl EventoDominio for EventoProveedor {
    fn tipo_evento(&self) -> &'static str {
        match self {
            Self::Creado(_) => PROVEEDOR_CREADO,
            Self::Actualizado(_) => PROVEEDOR_ACTUALIZADO,
            Self::Borrado(_) => PROVEEDOR_BORRADO,
        }
    }

    fn tipo_agregado(&self) -> &'static str {
        "proveedor"
    }

    fn id_agregado(&self) -> Uuid {
        self.snapshot().id
    }

    fn version_esquema(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // Un snapshot solo tiene primitivos: serializarlo no puede fallar.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreProveedor;

    #[test]
    fn deberia_describir_cada_evento_cuando_se_registra() {
        // Preparar
        let entidad = MadreProveedor::aleatorio();
        let snapshot = SnapshotProveedor::from_entidad(&entidad);
        let eventos = [
            (
                EventoProveedor::Creado(snapshot.clone()),
                "proveedor_creado",
            ),
            (
                EventoProveedor::Actualizado(snapshot.clone()),
                "proveedor_actualizado",
            ),
            (
                EventoProveedor::Borrado(snapshot.clone()),
                "proveedor_borrado",
            ),
        ];

        for (evento, tipo_evento) in eventos {
            // Actuar y comprobar
            assert_eq!(evento.tipo_evento(), tipo_evento);
            assert_eq!(evento.tipo_agregado(), "proveedor");
            assert_eq!(evento.id_agregado(), entidad.id.valor());
            assert_eq!(evento.version_esquema(), 1);
            assert_eq!(evento.snapshot(), &snapshot);
        }
    }

    #[test]
    fn deberia_mantener_el_contrato_json_cuando_se_serializa_el_snapshot() {
        // Preparar
        let snapshot = SnapshotProveedor::from_entidad(&MadreProveedor::aleatorio());

        // Actuar
        let payload = EventoProveedor::Creado(snapshot.clone()).payload();

        // Comprobar — una clave renombrada o quitada rompe a cada consumidor de estos eventos.
        let mut claves: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        claves.sort_unstable();
        assert_eq!(claves, ["email", "id", "name"]);
        assert_eq!(
            serde_json::from_value::<SnapshotProveedor>(payload).ok(),
            Some(snapshot)
        );
    }
}

