use std::sync::Arc;

use crate::domain::supplier::value_objects::Name;
use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::supplier::{
    errors::SupplierError,
    events::{SupplierEvent, SupplierSnapshot},
    model::Supplier,
    repository::SupplierRepositoryTrait,
    unit_of_work::SupplierUnitOfWorkFactory,
    use_cases::update_supplier::{UpdateSupplierParams, UpdateSupplierUseCaseTrait},
};

pub struct UpdateSupplierUseCaseImpl {
    pub repository: Arc<dyn SupplierRepositoryTrait>,
    pub uow_factory: Arc<dyn SupplierUnitOfWorkFactory>,
}

#[async_trait]
impl UpdateSupplierUseCaseTrait for UpdateSupplierUseCaseImpl {
    async fn execute(&self, params: UpdateSupplierParams) -> Result<Supplier, SupplierError> {
        tracing::info!(id = %params.id, "update_supplier: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "update_supplier: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = SupplierError::NotFound;
                tracing::warn!(error = %err, "update_supplier: rejected");
                err
            })?;
        if params.email.trim().is_empty() {
            let err = SupplierError::ValidationError("email_empty".into());
            tracing::warn!(error = %err, "update_supplier: rejected");
            return Err(err);
        }
        let name = Name::new(params.name)?;
        entity.name = name;
        entity.email = params.email;
        entity.updated_at = chrono::Utc::now();
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(SupplierEvent::Updated(SupplierSnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(entity)
    }
}

