import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { EntregaMother, fakeEntregaRepository } from "../../../../test-support/entrega";
import { renderScreen } from "../../../../test-support/render";
import { EntregaDetailContainer } from "./entrega-detail-container";

describe("EntregaDetailContainer", () => {
  test("should show the entrega when it exists", async () => {
    // Arrange
    const seeded = EntregaMother.random();
    const entregaRepository = fakeEntregaRepository([seeded]);

    // Act
    renderScreen(<EntregaDetailContainer id={seeded.id} />, { entregaRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the compra to its page", async () => {
    // Arrange
    const seeded = EntregaMother.random();
    const entregaRepository = fakeEntregaRepository([seeded]);

    // Act
    renderScreen(<EntregaDetailContainer id={seeded.id} />, { entregaRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.compraId });
    expect(link.getAttribute("href")).toBe(`/compras/${seeded.compraId}`);
  });

  test("should link the destinatario to its page", async () => {
    // Arrange
    const seeded = EntregaMother.random();
    const entregaRepository = fakeEntregaRepository([seeded]);

    // Act
    renderScreen(<EntregaDetailContainer id={seeded.id} />, { entregaRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.destinatarioId ?? "" });
    expect(link.getAttribute("href")).toBe(`/proveedores/${seeded.destinatarioId}`);
  });

  test("should show the not-found code when the entrega does not exist", async () => {
    // Arrange
    const entregaRepository = fakeEntregaRepository();

    // Act
    renderScreen(<EntregaDetailContainer id={crypto.randomUUID()} />, {
      entregaRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("entrega.no_encontrado");
  });

  test("should delete the entrega only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = EntregaMother.random();
    const fake = fakeEntregaRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<EntregaDetailContainer id={seeded.id} />, {
      entregaRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/entregas"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/entrega/containers/entrega-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { EntregaDetailView } from "../views/entrega-detail-view";

export function EntregaDetailContainer({ id }: { id: string }) {
  const { entregaRepository } = useDependencies();
  const entrega = useAsync(() => entregaRepository.get(id), [entregaRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await entregaRepository.remove(id);
      navigate("/entregas");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Entrega</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {entrega.status === "loading" && <span className="loading loading-spinner" />}
      {entrega.status === "error" && <ErrorAlert error={entrega.error} />}
      {entrega.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <EntregaDetailView entrega={entrega.data} />
            <div className="card-actions justify-end">
              <Link href={`/entregas/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/entregas" className="link">
        Back to entregas
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this entrega?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

