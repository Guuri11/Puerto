import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { PurchaseDetailView } from "../views/purchase-detail-view";

export function PurchaseDetailContainer({ id }: { id: string }) {
  const { purchaseRepository } = useDependencies();
  const purchase = useAsync(() => purchaseRepository.get(id), [purchaseRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await purchaseRepository.remove(id);
      navigate("/purchases");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Purchase</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {purchase.status === "loading" && <span className="loading loading-spinner" />}
      {purchase.status === "error" && <ErrorAlert error={purchase.error} />}
      {purchase.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <PurchaseDetailView purchase={purchase.data} />
            <div className="card-actions justify-end">
              <Link href={`/purchases/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/purchases" className="link">
        Back to purchases
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this purchase?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

