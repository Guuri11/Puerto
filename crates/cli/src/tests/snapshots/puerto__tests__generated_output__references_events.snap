use async_trait::async_trait;
use dominio_entrega::errores::ErrorEntrega;
use dominio_entrega::modelo::{Entrega, IdEntrega};
use dominio_entrega::repositorio::RepositorioEntrega;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerEntrega {
    pub id: IdEntrega,
}

#[async_trait]
pub trait ObtenerEntrega: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerEntrega) -> Result<Entrega, ErrorEntrega>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerEntrega {}

        #[async_trait]
        impl ObtenerEntrega for ObtenerEntrega {
            async fn ejecutar(&self, params: ParamsObtenerEntrega) -> Result<Entrega, ErrorEntrega>;
        }
    }
}

pub struct ObtenerEntregaImpl {
    pub repositorio: Arc<dyn RepositorioEntrega>,
}

#[async_trait]
impl ObtenerEntrega for ObtenerEntregaImpl {
    async fn ejecutar(&self, params: ParamsObtenerEntrega) -> Result<Entrega, ErrorEntrega> {
        tracing::info!(id = %params.id, "obtener_entrega: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_entrega: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorEntrega::NoEncontrado;
            tracing::warn!(error = %err, "obtener_entrega: rechazado");
            err
        })
    }
}

