use crate::modelo::Entrega;
use crate::modelo::PropsEntrega;
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;

pub struct MadreEntrega {
    compra_id: Option<IdCompra>,
    destinatario_id: Option<IdProveedor>,
    carrier: Option<String>,
}

impl MadreEntrega {
    pub fn new() -> Self {
        Self {
            compra_id: None,
            destinatario_id: None,
            carrier: None,
        }
    }

    pub fn con_compra_id(mut self, compra_id: IdCompra) -> Self {
        self.compra_id = Some(compra_id);
        self
    }

    pub fn con_destinatario_id(mut self, destinatario_id: IdProveedor) -> Self {
        self.destinatario_id = Some(destinatario_id);
        self
    }

    pub fn con_carrier(mut self, carrier: &str) -> Self {
        self.carrier = Some(carrier.to_string());
        self
    }

    pub fn con_carrier_vacio(mut self) -> Self {
        self.carrier = Some(String::new());
        self
    }

    pub fn construir(self) -> Entrega {
        Entrega::new(PropsEntrega {
            compra_id: self.compra_id.unwrap_or_else(IdCompra::generar),
            destinatario_id: self.destinatario_id,
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadreEntrega: Entrega::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsEntrega {
        PropsEntrega {
            compra_id: self.compra_id.unwrap_or_else(IdCompra::generar),
            destinatario_id: self.destinatario_id,
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Entrega {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Entrega> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreEntrega {
    fn default() -> Self {
        Self::new()
    }
}

