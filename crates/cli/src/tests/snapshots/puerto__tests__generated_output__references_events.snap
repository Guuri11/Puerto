import { SupplierError } from "../../domain/supplier/errors";
import type { Supplier, SupplierDraft } from "../../domain/supplier/model";
import type { SupplierRepository } from "../../domain/supplier/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type SupplierDto = components["schemas"]["SupplierDto"];
type SupplierRequest = components["schemas"]["CreateSupplierRequest"];

function toSupplier(dto: SupplierDto): Supplier {
  return {
    id: dto.id,
    name: dto.name,
    email: dto.email,
  };
}

function toRequest(draft: SupplierDraft): SupplierRequest {
  return {
    name: draft.name,
    email: draft.email,
  };
}

/** `SupplierRepository` over the REST API (`/suppliers`). */
export function supplierRepositoryHttp(api: ApiClient): SupplierRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/suppliers", {
        params: { query: page },
      });
      if (data === undefined) throw new SupplierError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toSupplier) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/suppliers/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new SupplierError(apiErrorCode(error, response));
      return toSupplier(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/suppliers", { body: toRequest(draft) });
      if (data === undefined) throw new SupplierError(apiErrorCode(error, response));
      return toSupplier(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/suppliers/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new SupplierError(apiErrorCode(error, response));
      return toSupplier(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/suppliers/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new SupplierError(apiErrorCode(error, response));
    },
  };
}

