=== web/src/domain/compra/errors.ts ===
/**
 * A request about a compra that the API refused. `code` is the API's `RespuestaError.codigo`:
 * `compra.no_encontrado`, `compra.validacion.<field>_vacio`.
 */
export class CompraError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "CompraError";
    this.code = code;
  }
}

=== web/src/domain/compra/messages.ts ===
import type { CompraDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface CompraProblem {
  field: keyof CompraDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "compra.validacion.proveedor_id_no_encontrado": "Proveedor does not exist",
  "compra.validacion.approver_id_no_encontrado": "Approver does not exist",
  "compra.duplicado": "A compra with these values already exists",
  "compra.no_encontrado": "This compra no longer exists",
  "compra.repositorio": "The compra could not be saved, try again later",
  "compra.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof CompraDraft> = {
  "compra.validacion.proveedor_id_no_encontrado": "proveedorId",
  "compra.validacion.approver_id_no_encontrado": "approverId",
};

export function toProblem(code: string): CompraProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

