=== presentacion/cableado/src/lib.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod proveedor {
    use std::sync::Arc;

    use aplicacion_proveedor::actualizar_proveedor::{
        ActualizarProveedor, ActualizarProveedorImpl,
    };
    use aplicacion_proveedor::borrar_proveedor::{BorrarProveedor, BorrarProveedorImpl};
    use aplicacion_proveedor::crear_proveedor::{CrearProveedor, CrearProveedorImpl};
    use aplicacion_proveedor::listar_proveedores::{ListarProveedores, ListarProveedoresImpl};
    use aplicacion_proveedor::obtener_proveedor::{ObtenerProveedor, ObtenerProveedorImpl};
    use dominio_proveedor::repositorio::RepositorioProveedor;
    use dominio_proveedor::unit_of_work::UnitOfWorkFactoryProveedor;
    use infra_proveedor::repositorio::RepositorioProveedorPostgres;
    use infra_proveedor::unit_of_work::UnitOfWorkFactoryProveedorPostgres;

    /// Los casos de uso de `proveedor`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_proveedor: Arc<dyn CrearProveedor>,
        pub obtener_proveedor: Arc<dyn ObtenerProveedor>,
        pub listar_proveedores: Arc<dyn ListarProveedores>,
        pub actualizar_proveedor: Arc<dyn ActualizarProveedor>,
        pub borrar_proveedor: Arc<dyn BorrarProveedor>,
    }

    pub fn construir(pool: &sqlx::PgPool) -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioProveedor> =
            Arc::new(RepositorioProveedorPostgres::new(pool.clone()));
        let uow_factory: Arc<dyn UnitOfWorkFactoryProveedor> =
            Arc::new(UnitOfWorkFactoryProveedorPostgres::new(pool.clone()));
        CasosDeUso {
            crear_proveedor: Arc::new(CrearProveedorImpl {
                uow_factory: Arc::clone(&uow_factory),
            }),
            obtener_proveedor: Arc::new(ObtenerProveedorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_proveedores: Arc::new(ListarProveedoresImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_proveedor: Arc::new(ActualizarProveedorImpl {
                repositorio: Arc::clone(&repositorio),
                uow_factory: Arc::clone(&uow_factory),
            }),
            borrar_proveedor: Arc::new(BorrarProveedorImpl {
                repositorio: Arc::clone(&repositorio),
                uow_factory: Arc::clone(&uow_factory),
            }),
        }
    }
}

pub mod compra {
    use std::sync::Arc;

    use aplicacion_compra::actualizar_compra::{ActualizarCompra, ActualizarCompraImpl};
    use aplicacion_compra::borrar_compra::{BorrarCompra, BorrarCompraImpl};
    use aplicacion_compra::crear_compra::{CrearCompra, CrearCompraImpl};
    use aplicacion_compra::listar_compras::{ListarCompras, ListarComprasImpl};
    use aplicacion_compra::obtener_compra::{ObtenerCompra, ObtenerCompraImpl};
    use dominio_compra::repositorio::RepositorioCompra;
    use dominio_compra::unit_of_work::UnitOfWorkFactoryCompra;
    use infra_compra::repositorio::RepositorioCompraPostgres;
    use infra_compra::unit_of_work::UnitOfWorkFactoryCompraPostgres;

    /// Los casos de uso de `compra`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_compra: Arc<dyn CrearCompra>,
        pub obtener_compra: Arc<dyn ObtenerCompra>,
        pub listar_compras: Arc<dyn ListarCompras>,
        pub actualizar_compra: Arc<dyn ActualizarCompra>,
        pub borrar_compra: Arc<dyn BorrarCompra>,
    }

    pub fn construir(pool: &sqlx::PgPool) -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioCompra> =
            Arc::new(RepositorioCompraPostgres::new(pool.clone()));
        let uow_factory: Arc<dyn UnitOfWorkFactoryCompra> =
            Arc::new(UnitOfWorkFactoryCompraPostgres::new(pool.clone()));
        CasosDeUso {
            crear_compra: Arc::new(CrearCompraImpl {
                uow_factory: Arc::clone(&uow_factory),
            }),
            obtener_compra: Arc::new(ObtenerCompraImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_compras: Arc::new(ListarComprasImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_compra: Arc::new(ActualizarCompraImpl {
                repositorio: Arc::clone(&repositorio),
                uow_factory: Arc::clone(&uow_factory),
            }),
            borrar_compra: Arc::new(BorrarCompraImpl {
                repositorio: Arc::clone(&repositorio),
                uow_factory: Arc::clone(&uow_factory),
            }),
        }
    }
}

pub mod entrega {
    use std::sync::Arc;

    use aplicacion_entrega::actualizar_entrega::{ActualizarEntrega, ActualizarEntregaImpl};
    use aplicacion_entrega::borrar_entrega::{BorrarEntrega, BorrarEntregaImpl};
    use aplicacion_entrega::crear_entrega::{CrearEntrega, CrearEntregaImpl};
    use aplicacion_entrega::listar_entregas::{ListarEntregas, ListarEntregasImpl};
    use aplicacion_entrega::obtener_entrega::{ObtenerEntrega, ObtenerEntregaImpl};
    use dominio_entrega::repositorio::RepositorioEntrega;
    use dominio_entrega::unit_of_work::UnitOfWorkFactoryEntrega;
    use infra_entrega::repositorio::RepositorioEntregaPostgres;
    use infra_entrega::unit_of_work::UnitOfWorkFactoryEntregaPostgres;

    /// Los casos de uso de `entrega`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_entrega: Arc<dyn CrearEntrega>,
        pub obtener_entrega: Arc<dyn ObtenerEntrega>,
        pub listar_entregas: Arc<dyn ListarEntregas>,
        pub actualizar_entrega: Arc<dyn ActualizarEntrega>,
        pub borrar_entrega: Arc<dyn BorrarEntrega>,
    }

    pub fn construir(pool: &sqlx::PgPool) -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioEntrega> =
            Arc::new(RepositorioEntregaPostgres::new(pool.clone()));
        let uow_factory: Arc<dyn UnitOfWorkFactoryEntrega> =
            Arc::new(UnitOfWorkFactoryEntregaPostgres::new(pool.clone()));
        CasosDeUso {
            crear_entrega: Arc::new(CrearEntregaImpl {
                uow_factory: Arc::clone(&uow_factory),
            }),
            obtener_entrega: Arc::new(ObtenerEntregaImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_entregas: Arc::new(ListarEntregasImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_entrega: Arc::new(ActualizarEntregaImpl {
                repositorio: Arc::clone(&repositorio),
                uow_factory: Arc::clone(&uow_factory),
            }),
            borrar_entrega: Arc::new(BorrarEntregaImpl {
                repositorio: Arc::clone(&repositorio),
                uow_factory: Arc::clone(&uow_factory),
            }),
        }
    }
}

=== presentacion/worker/AGENTS.md ===
# Worker — notas para agentes de IA

El segundo proceso de este proyecto (ADR-0018 de Puerto). Las unidades de trabajo de la API
escriben cada evento en la tabla `outbox`, en la misma transacción que la entidad; este proceso
**hace de relay** del outbox al transporte y **ejecuta los consumidores**. Es una raíz de
composición, como `presentacion/api`: aquí no vive lógica de negocio; un consumidor decodifica el
evento y llama a un caso de uso.

## Estructura

```
presentacion/worker/src/
├── main.rs                  # `ConfigWorker::from_env()` + `Worker::new(config).intentar_ejecutar(…)` (no cambia nunca)
├── generado.rs              # `pub mod registro;`
├── generado/registro.rs     # GENERADO: el relay y cada `[[consumidor]]`; no lo edites a mano
├── consumidores.rs          # `pub mod <consumidor>;`, sin `mod.rs`
└── consumidores/
    └── <consumidor>.rs      # Tuyo: un `ManejadorEvento`, lo escribe una vez `puerto generar consumidor`
```

## Reglas críticas

- **Añade un consumidor con `puerto generar consumidor <nombre> --tras <tipo_evento>[,…]`**:
  declara `[[consumidor]]` en `puerto.toml`, escribe el handler y sus tests, y regenera
  `generado/registro.rs`. No cablees nunca uno a mano.
- **Los handlers deben ser idempotentes.** La entrega es al menos una vez: el mismo `evento.id`
  puede llegar dos veces. Comprueba si el trabajo ya se hizo (por `evento.id`) antes de volver a
  hacerlo.
- **Responde con honestidad**: `Ack` cuando termina; `Reintentar` para un fallo que puede pasar (se
  vuelve a entregar con una espera creciente de 1 s → 300 s, `MAX_DELIVERIES` veces);
  `ResultadoManejo::descartar(motivo, detalle)` para uno que no pasará nunca. Un payload que no se
  decodifica es `MOTIVO_PAYLOAD_INVALIDO`. Nada se tira sin una fila en `descartados`
  (`make eventos/descartados`).
- **Lo que necesita un consumidor se construye en su `construir(pool)`**, que `generado/registro.rs`
  llama al arrancar: guárdalo en un campo del struct (`cableado::<contexto>::construir(pool)` da los
  casos de uso de un contexto, como `Arc<dyn …>`). Sus tests construyen el struct con dobles
  (`dobles::Mock<Caso>`), sin base de datos.
- **Decodifica el snapshot, nunca el modelo de dominio**:
  `evento.decodificar::<SnapshotProducto>()`. El snapshot es el contrato público del evento.

## Salud y apagado

Lo sirve el runtime de Puerto, `puerto-eventos`, en `WORKER_PORT` (8081).

- `GET /health`: vida; el proceso responde.
- `GET /health/ready`: disponibilidad; `503` hasta que el relay y cada consumidor terminan una
  pasada sin fallos recientes (una base de datos caída se ve aquí).
- Con SIGTERM / Ctrl-C cada bucle termina el lote que está procesando, durante 8 s como mucho.

## Configuración

`WORKER_PORT` (8081), `RELAY_BATCH_SIZE` (100), `RELAY_POLL_INTERVAL_MS` (500),
`CONSUMER_POLL_INTERVAL_MS` (500), `MAX_DELIVERIES` (5), `RETRY_MAX_DELAY_MS` (sin valor: la espera
creciente de arriba), además de `DATABASE_URL`. Un valor presente pero inválido detiene el worker
en el arranque.

