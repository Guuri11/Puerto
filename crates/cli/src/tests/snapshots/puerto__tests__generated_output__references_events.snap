import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { SupplierError } from "../../../../domain/supplier/errors";
import { renderScreen } from "../../../../test-support/render";
import { fakeSupplierRepository, SupplierMother } from "../../../../test-support/supplier";
import { SupplierListContainer } from "./supplier-list-container";

describe("SupplierListContainer", () => {
  test("should show a row per supplier when there are some", async () => {
    // Arrange
    const seed = [SupplierMother.random(), SupplierMother.random()];
    const supplierRepository = fakeSupplierRepository(seed);

    // Act
    renderScreen(<SupplierListContainer />, { supplierRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => SupplierMother.random());
    const supplierRepository = fakeSupplierRepository(seed);
    renderScreen(<SupplierListContainer />, { supplierRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => SupplierMother.random());
    const supplierRepository = fakeSupplierRepository(seed);
    const path = "/suppliers?page=2";

    // Act
    renderScreen(<SupplierListContainer />, { supplierRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no supplier", async () => {
    // Arrange
    const supplierRepository = fakeSupplierRepository();

    // Act
    renderScreen(<SupplierListContainer />, { supplierRepository });

    // Assert
    expect(await screen.findByText("No suppliers yet.")).toBeTruthy();
  });

  test("should show the error code when the suppliers cannot be listed", async () => {
    // Arrange
    const supplierRepository = {
      ...fakeSupplierRepository(),
      list: () => Promise.reject(new SupplierError("supplier.repository_error")),
    };

    // Act
    renderScreen(<SupplierListContainer />, { supplierRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("supplier.repository_error");
  });
});

=== web/src/presentation/features/supplier/containers/supplier-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { SupplierListView } from "../views/supplier-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function SupplierListContainer() {
  const { supplierRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const suppliers = useAsync(
    () => supplierRepository.list({ limit: PAGE_SIZE, offset }),
    [supplierRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Suppliers</h1>
        <Link href="/suppliers/new" className="btn btn-primary">
          New supplier
        </Link>
      </div>
      {suppliers.status === "loading" && <span className="loading loading-spinner" />}
      {suppliers.status === "error" && <ErrorAlert error={suppliers.error} />}
      {suppliers.status === "ok" &&
        (suppliers.data.total === 0 ? (
          <EmptyState message="No suppliers yet." />
        ) : (
          <>
            <SupplierListView suppliers={suppliers.data.items} />
            <Pagination {...suppliers.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

