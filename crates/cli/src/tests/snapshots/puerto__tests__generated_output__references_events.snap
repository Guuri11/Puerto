use chrono::{DateTime, Utc};
use dominio_proveedor::modelo::IdProveedor;
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_compra::{
    errores::ErrorCompra,
    modelo::{Compra, IdCompra},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaCompra {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub proveedor_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

impl TryFrom<FilaCompra> for Compra {
    type Error = ErrorCompra;

    fn try_from(fila: FilaCompra) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Compra {
            id: IdCompra::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            proveedor_id: IdProveedor::from_uuid(fila.proveedor_id),
            approver_id: fila.approver_id.map(IdProveedor::from_uuid),
            total: fila.total,
        }))
    }
}

impl From<&Compra> for FilaCompra {
    fn from(entidad: &Compra) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            proveedor_id: entidad.proveedor_id.valor(),
            approver_id: entidad.approver_id.map(|v| v.valor()),
            total: entidad.total,
        }
    }
}

