import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { DeliveryMother, fakeDeliveryRepository } from "../../../../test-support/delivery";
import { renderScreen } from "../../../../test-support/render";
import { DeliveryDetailContainer } from "./delivery-detail-container";

describe("DeliveryDetailContainer", () => {
  test("should show the delivery when it exists", async () => {
    // Arrange
    const seeded = DeliveryMother.random();
    const deliveryRepository = fakeDeliveryRepository([seeded]);

    // Act
    renderScreen(<DeliveryDetailContainer id={seeded.id} />, { deliveryRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the purchase to its page", async () => {
    // Arrange
    const seeded = DeliveryMother.random();
    const deliveryRepository = fakeDeliveryRepository([seeded]);

    // Act
    renderScreen(<DeliveryDetailContainer id={seeded.id} />, { deliveryRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.purchaseId });
    expect(link.getAttribute("href")).toBe(`/purchases/${seeded.purchaseId}`);
  });

  test("should show the not-found code when the delivery does not exist", async () => {
    // Arrange
    const deliveryRepository = fakeDeliveryRepository();

    // Act
    renderScreen(<DeliveryDetailContainer id={crypto.randomUUID()} />, { deliveryRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("delivery.not_found");
  });

  test("should delete the delivery only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = DeliveryMother.random();
    const fake = fakeDeliveryRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<DeliveryDetailContainer id={seeded.id} />, {
      deliveryRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/deliveries"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

