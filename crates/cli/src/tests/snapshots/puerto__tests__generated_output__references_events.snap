use crate::domain::delivery::model::Delivery;
use crate::domain::delivery::model::DeliveryProps;
use crate::domain::purchase::model::PurchaseId;

pub struct DeliveryMother {
    purchase_id: Option<PurchaseId>,
    carrier: Option<String>,
}

impl DeliveryMother {
    pub fn new() -> Self {
        Self {
            purchase_id: None,
            carrier: None,
        }
    }

    pub fn with_purchase_id(mut self, purchase_id: PurchaseId) -> Self {
        self.purchase_id = Some(purchase_id);
        self
    }

    pub fn with_carrier(mut self, carrier: &str) -> Self {
        self.carrier = Some(carrier.to_string());
        self
    }

    pub fn with_empty_carrier(mut self) -> Self {
        self.carrier = Some(String::new());
        self
    }

    pub fn build(self) -> Delivery {
        Delivery::new(DeliveryProps {
            purchase_id: self.purchase_id.unwrap_or_else(PurchaseId::generate),
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        })
        .expect("DeliveryMother: failed to build valid Delivery")
    }

    pub fn build_props(self) -> DeliveryProps {
        DeliveryProps {
            purchase_id: self.purchase_id.unwrap_or_else(PurchaseId::generate),
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn random() -> Delivery {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Delivery> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for DeliveryMother {
    fn default() -> Self {
        Self::new()
    }
}

