use chrono::{DateTime, Utc};
use dominio_proveedor::valores::Name;
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_proveedor::{
    errores::ErrorProveedor,
    modelo::{IdProveedor, Proveedor},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaProveedor {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: String,
    pub email: String,
}

impl TryFrom<FilaProveedor> for Proveedor {
    type Error = ErrorProveedor;

    fn try_from(fila: FilaProveedor) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Proveedor {
            id: IdProveedor::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            name: Name::new(fila.name)?,
            email: fila.email,
        }))
    }
}

impl From<&Proveedor> for FilaProveedor {
    fn from(entidad: &Proveedor) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            name: entidad.name.valor().to_string(),
            email: entidad.email.clone(),
        }
    }
}

