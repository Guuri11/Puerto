use chrono::{DateTime, Utc};
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;
use uuid::Uuid;

use crate::errores::ErrorEntrega;

/// El id de cada `Entrega`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdEntrega(Uuid);

impl IdEntrega {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdEntrega {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsEntrega {
    pub compra_id: IdCompra,
    pub destinatario_id: Option<IdProveedor>,
    pub carrier: String,
}

#[derive(Debug, Clone)]
pub struct Entrega {
    pub id: IdEntrega,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub compra_id: IdCompra,
    pub destinatario_id: Option<IdProveedor>,
    pub carrier: String,
}

impl Entrega {
    pub fn new(props: PropsEntrega) -> Result<Self, ErrorEntrega> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdEntrega::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            compra_id: props.compra_id,
            destinatario_id: props.destinatario_id,
            carrier: props.carrier,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsEntrega) -> Result<(), ErrorEntrega> {
        Self::validar(&props)?;
        self.compra_id = props.compra_id;
        self.destinatario_id = props.destinatario_id;
        self.carrier = props.carrier;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Entrega) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsEntrega) -> Result<(), ErrorEntrega> {
        if props.carrier.trim().is_empty() {
            return Err(ErrorEntrega::Validacion("carrier_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreEntrega;

    #[test]
    fn deberia_crear_entrega_cuando_los_campos_son_validos() {
        let resultado = Entrega::new(MadreEntrega::new().construir_props());
        assert_eq!(
            resultado.unwrap().carrier,
            MadreEntrega::new().construir_props().carrier
        );
    }

    #[test]
    fn deberia_rechazar_entrega_cuando_carrier_es_una_cadena_vacia() {
        let resultado = Entrega::new(MadreEntrega::new().con_carrier_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "entrega.validacion.carrier_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_entrega_cuando_carrier_solo_tiene_espacios() {
        let resultado = Entrega::new(MadreEntrega::new().con_carrier("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_entrega_cuando_carrier_es_una_cadena_vacia() {
        let mut entidad = MadreEntrega::aleatorio();
        let resultado =
            entidad.actualizar(MadreEntrega::new().con_carrier_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "entrega.validacion.carrier_vacio"
        );
    }
}

=== contextos/entrega/dominio/src/pruebas/madres.rs ===
use crate::modelo::Entrega;
use crate::modelo::PropsEntrega;
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;

pub struct MadreEntrega {
    compra_id: Option<IdCompra>,
    destinatario_id: Option<IdProveedor>,
    carrier: Option<String>,
}

impl MadreEntrega {
    pub fn new() -> Self {
        Self {
            compra_id: None,
            destinatario_id: None,
            carrier: None,
        }
    }

    pub fn con_compra_id(mut self, compra_id: IdCompra) -> Self {
        self.compra_id = Some(compra_id);
        self
    }

    pub fn con_destinatario_id(mut self, destinatario_id: IdProveedor) -> Self {
        self.destinatario_id = Some(destinatario_id);
        self
    }

    pub fn con_carrier(mut self, carrier: &str) -> Self {
        self.carrier = Some(carrier.to_string());
        self
    }

    pub fn con_carrier_vacio(mut self) -> Self {
        self.carrier = Some(String::new());
        self
    }

    pub fn construir(self) -> Entrega {
        Entrega::new(PropsEntrega {
            compra_id: self.compra_id.unwrap_or_else(IdCompra::generar),
            destinatario_id: self.destinatario_id,
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadreEntrega: Entrega::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsEntrega {
        PropsEntrega {
            compra_id: self.compra_id.unwrap_or_else(IdCompra::generar),
            destinatario_id: self.destinatario_id,
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Entrega {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Entrega> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreEntrega {
    fn default() -> Self {
        Self::new()
    }
}

