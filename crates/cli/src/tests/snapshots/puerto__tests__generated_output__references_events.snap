=== business/src/domain/purchase/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum PurchaseError {
    #[error("purchase.validation_error.{0}")]
    ValidationError(String),
    #[error("purchase.not_found")]
    NotFound,
    #[error("purchase.duplicate")]
    Duplicate,
    #[error("purchase.repository_error")]
    RepositoryError,
    #[error("purchase.unknown")]
    Unknown,
}

impl From<RepositoryError> for PurchaseError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            // A reference names a row that does not exist: the caller's input, on that field.
            RepositoryError::MissingReference(field) => {
                Self::ValidationError(format!("{field}_not_found"))
            }
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = PurchaseError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "purchase.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = PurchaseError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "purchase.repository_error");
    }

    #[test]
    fn should_convert_a_missing_reference_into_a_validation_error_on_its_field() {
        let err = PurchaseError::from(RepositoryError::MissingReference("supplier_id"));
        assert_eq!(
            err.to_string(),
            "purchase.validation_error.supplier_id_not_found"
        );
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = PurchaseError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "purchase.repository_error");
    }
}

=== business/src/domain/purchase/events.rs ===
// AUTO-GENERATED by puerto from puerto.toml — never hand-edit. The snapshot follows the entity's
// fields; add an event with `puerto generate event Purchase <name>`.
use puerto_core::DomainEvent;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use super::model::Purchase;

pub const PURCHASE_CREATED: &str = "purchase_created";
pub const PURCHASE_UPDATED: &str = "purchase_updated";
pub const PURCHASE_DELETED: &str = "purchase_deleted";

/// What every purchase event carries: the purchase as the API shows it — primitives, value
/// objects unwrapped. A public contract: consumers decode it with
/// `envelope.decode::<PurchaseSnapshot>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct PurchaseSnapshot {
    pub id: Uuid,
    pub supplier_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

impl PurchaseSnapshot {
    pub fn from_entity(entity: &Purchase) -> Self {
        Self {
            id: entity.id.value(),
            supplier_id: entity.supplier_id.value(),
            approver_id: entity.approver_id.map(|v| v.value()),
            total: entity.total,
        }
    }
}

/// What happened to a purchase. Its write use cases record one through their unit of work.
#[derive(Debug, Clone, PartialEq)]
pub enum PurchaseEvent {
    Created(PurchaseSnapshot),
    Updated(PurchaseSnapshot),
    Deleted(PurchaseSnapshot),
}

impl PurchaseEvent {
    pub fn snapshot(&self) -> &PurchaseSnapshot {
        match self {
            Self::Created(snapshot) | Self::Updated(snapshot) | Self::Deleted(snapshot) => snapshot,
        }
    }
}

impl DomainEvent for PurchaseEvent {
    fn event_type(&self) -> &'static str {
        match self {
            Self::Created(_) => PURCHASE_CREATED,
            Self::Updated(_) => PURCHASE_UPDATED,
            Self::Deleted(_) => PURCHASE_DELETED,
        }
    }

    fn aggregate_type(&self) -> &'static str {
        "purchase"
    }

    fn aggregate_id(&self) -> Uuid {
        self.snapshot().id
    }

    fn schema_version(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // A snapshot holds primitives only: serialising it cannot fail.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::tests::mothers::purchase_mother::PurchaseMother;

    #[test]
    fn should_describe_every_event_when_one_is_recorded() {
        // Arrange
        let entity = PurchaseMother::random();
        let snapshot = PurchaseSnapshot::from_entity(&entity);
        let events = [
            (PurchaseEvent::Created(snapshot.clone()), "purchase_created"),
            (PurchaseEvent::Updated(snapshot.clone()), "purchase_updated"),
            (PurchaseEvent::Deleted(snapshot.clone()), "purchase_deleted"),
        ];

        for (event, event_type) in events {
            // Act + Assert
            assert_eq!(event.event_type(), event_type);
            assert_eq!(event.aggregate_type(), "purchase");
            assert_eq!(event.aggregate_id(), entity.id.value());
            assert_eq!(event.schema_version(), 1);
            assert_eq!(event.snapshot(), &snapshot);
        }
    }

    #[test]
    fn should_keep_the_json_contract_when_the_snapshot_is_serialised() {
        // Arrange
        let snapshot = PurchaseSnapshot::from_entity(&PurchaseMother::random());

        // Act
        let payload = PurchaseEvent::Created(snapshot.clone()).payload();

        // Assert — a renamed or removed key breaks every consumer of these events.
        let mut keys: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        keys.sort_unstable();
        assert_eq!(keys, ["approverId", "id", "supplierId", "total"]);
        assert_eq!(
            serde_json::from_value::<PurchaseSnapshot>(payload).ok(),
            Some(snapshot)
        );
    }
}

