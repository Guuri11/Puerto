use business::domain::supplier::value_objects::Name;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use business::domain::supplier::{
    errors::SupplierError,
    model::{Supplier, SupplierId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct SupplierDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: String,
    pub email: String,
}

impl TryFrom<SupplierDb> for Supplier {
    type Error = SupplierError;

    fn try_from(row: SupplierDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Supplier {
            id: SupplierId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            name: Name::new(row.name)?,
            email: row.email,
        }))
    }
}

impl From<&Supplier> for SupplierDb {
    fn from(entity: &Supplier) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            name: entity.name.value().to_string(),
            email: entity.email.clone(),
        }
    }
}

