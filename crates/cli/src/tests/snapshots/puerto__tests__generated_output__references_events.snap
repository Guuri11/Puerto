=== business/src/domain/supplier/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum SupplierError {
    #[error("supplier.validation_error.{0}")]
    ValidationError(String),
    #[error("supplier.not_found")]
    NotFound,
    #[error("supplier.duplicate")]
    Duplicate,
    #[error("supplier.repository_error")]
    RepositoryError,
    #[error("supplier.unknown")]
    Unknown,
    #[error("supplier.invalid_name")]
    InvalidName,
}

impl From<RepositoryError> for SupplierError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = SupplierError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "supplier.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = SupplierError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "supplier.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = SupplierError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "supplier.repository_error");
    }
}

=== business/src/domain/supplier/events.rs ===
// AUTO-GENERATED by puerto from puerto.toml — never hand-edit. The snapshot follows the entity's
// fields; add an event with `puerto generate event Supplier <name>`.
use puerto_core::DomainEvent;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use super::model::Supplier;

pub const SUPPLIER_CREATED: &str = "supplier_created";
pub const SUPPLIER_UPDATED: &str = "supplier_updated";
pub const SUPPLIER_DELETED: &str = "supplier_deleted";

/// What every supplier event carries: the supplier as the API shows it — primitives, value
/// objects unwrapped. A public contract: consumers decode it with
/// `envelope.decode::<SupplierSnapshot>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct SupplierSnapshot {
    pub id: Uuid,
    pub name: String,
    pub email: String,
}

impl SupplierSnapshot {
    pub fn from_entity(entity: &Supplier) -> Self {
        Self {
            id: entity.id.value(),
            name: entity.name.value().to_string(),
            email: entity.email.clone(),
        }
    }
}

/// What happened to a supplier. Its write use cases record one through their unit of work.
#[derive(Debug, Clone, PartialEq)]
pub enum SupplierEvent {
    Created(SupplierSnapshot),
    Updated(SupplierSnapshot),
    Deleted(SupplierSnapshot),
}

impl SupplierEvent {
    pub fn snapshot(&self) -> &SupplierSnapshot {
        match self {
            Self::Created(snapshot) | Self::Updated(snapshot) | Self::Deleted(snapshot) => snapshot,
        }
    }
}

impl DomainEvent for SupplierEvent {
    fn event_type(&self) -> &'static str {
        match self {
            Self::Created(_) => SUPPLIER_CREATED,
            Self::Updated(_) => SUPPLIER_UPDATED,
            Self::Deleted(_) => SUPPLIER_DELETED,
        }
    }

    fn aggregate_type(&self) -> &'static str {
        "supplier"
    }

    fn aggregate_id(&self) -> Uuid {
        self.snapshot().id
    }

    fn schema_version(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // A snapshot holds primitives only: serialising it cannot fail.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::tests::mothers::supplier_mother::SupplierMother;

    #[test]
    fn should_describe_every_event_when_one_is_recorded() {
        // Arrange
        let entity = SupplierMother::random();
        let snapshot = SupplierSnapshot::from_entity(&entity);
        let events = [
            (SupplierEvent::Created(snapshot.clone()), "supplier_created"),
            (SupplierEvent::Updated(snapshot.clone()), "supplier_updated"),
            (SupplierEvent::Deleted(snapshot.clone()), "supplier_deleted"),
        ];

        for (event, event_type) in events {
            // Act + Assert
            assert_eq!(event.event_type(), event_type);
            assert_eq!(event.aggregate_type(), "supplier");
            assert_eq!(event.aggregate_id(), entity.id.value());
            assert_eq!(event.schema_version(), 1);
            assert_eq!(event.snapshot(), &snapshot);
        }
    }

    #[test]
    fn should_keep_the_json_contract_when_the_snapshot_is_serialised() {
        // Arrange
        let snapshot = SupplierSnapshot::from_entity(&SupplierMother::random());

        // Act
        let payload = SupplierEvent::Created(snapshot.clone()).payload();

        // Assert — a renamed or removed key breaks every consumer of these events.
        let mut keys: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        keys.sort_unstable();
        assert_eq!(keys, ["email", "id", "name"]);
        assert_eq!(
            serde_json::from_value::<SupplierSnapshot>(payload).ok(),
            Some(snapshot)
        );
    }
}

=== business/src/domain/supplier/model.rs ===
use super::value_objects::Name;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::SupplierError;

/// The id of every `Supplier`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct SupplierId(Uuid);

impl SupplierId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for SupplierId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct SupplierProps {
    pub name: Name,
    pub email: String,
}

#[derive(Debug, Clone)]
pub struct Supplier {
    pub id: SupplierId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: Name,
    pub email: String,
}

impl Supplier {
    pub fn new(props: SupplierProps) -> Result<Self, SupplierError> {
        if props.email.trim().is_empty() {
            return Err(SupplierError::ValidationError("email_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: SupplierId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
            email: props.email,
        })
    }

    pub fn from_repository(data: Supplier) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_supplier_when_fields_are_valid() {
        let result = Supplier::new(SupplierProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            email: "example".to_string(),
        });
        assert_eq!(result.unwrap().email, "example");
    }

    #[test]
    fn should_reject_supplier_when_email_is_empty() {
        let result = Supplier::new(SupplierProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            email: "".into(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "supplier.validation_error.email_empty"
        );
    }

    #[test]
    fn should_reject_supplier_when_email_is_only_whitespace() {
        let result = Supplier::new(SupplierProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            email: "   ".into(),
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_supplier_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "supplier.invalid_name");
    }
}

