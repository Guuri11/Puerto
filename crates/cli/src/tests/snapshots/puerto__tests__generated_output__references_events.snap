=== web/src/presentation/features/supplier/views/supplier-form-view.tsx ===
import type { SupplierProblem } from "../../../../domain/supplier/messages";
import type { Supplier, SupplierDraft } from "../../../../domain/supplier/model";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface SupplierFormValues {
  name: string;
  email: string;
}

/** The inputs for `supplier`, empty when there is none yet. */
export function toSupplierForm(supplier: Supplier | null): SupplierFormValues {
  if (supplier === null) {
    return {
      name: "",
      email: "",
    };
  }
  return {
    name: supplier.name,
    email: supplier.email,
  };
}

export function toSupplierDraft(values: SupplierFormValues): SupplierDraft {
  return {
    name: values.name,
    email: values.email,
  };
}

export function SupplierFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: SupplierFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: SupplierProblem | null;
  onChange: (values: SupplierFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "name"}
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "email"}
          required
          value={values.email}
          onChange={(event) => onChange({ ...values, email: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="email" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

