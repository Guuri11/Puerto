use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::purchase::{
    errors::PurchaseError,
    model::Purchase,
    repository::{PurchaseFilter, PurchaseRepositoryTrait},
    use_cases::list_purchases::{ListPurchasesParams, ListPurchasesUseCaseTrait},
};

pub struct ListPurchasesUseCaseImpl {
    pub repository: Arc<dyn PurchaseRepositoryTrait>,
}

#[async_trait]
impl ListPurchasesUseCaseTrait for ListPurchasesUseCaseImpl {
    async fn execute(&self, params: ListPurchasesParams) -> Result<Page<Purchase>, PurchaseError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_purchases: start"
        );
        self.repository
            .find_all(
                params.page,
                PurchaseFilter {
                    supplier_id: params.supplier_id,
                    approver_id: params.approver_id,
                },
            )
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_purchases: repository failed"))
            .map_err(PurchaseError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::purchase::{
        model::{Purchase, PurchaseProps},
        repository::mocks::MockPurchaseRepository,
    };
    use crate::domain::supplier::model::SupplierId;
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_purchases() {
        let entities = vec![
            Purchase::new(PurchaseProps {
                supplier_id: SupplierId::generate(),
                approver_id: None,
                total: 42,
            })
            .unwrap(),
            Purchase::new(PurchaseProps {
                supplier_id: SupplierId::generate(),
                approver_id: None,
                total: 42,
            })
            .unwrap(),
        ];
        let mut mock_repo = MockPurchaseRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page, _| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListPurchasesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListPurchasesParams {
                page: PageRequest::default(),
                supplier_id: None,
                approver_id: None,
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_purchases_exist() {
        let mut mock_repo = MockPurchaseRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListPurchasesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListPurchasesParams {
                page: PageRequest::default(),
                supplier_id: None,
                approver_id: None,
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockPurchaseRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page, _| page.limit() == 5 && page.offset() == 10)
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListPurchasesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListPurchasesParams {
                page: PageRequest::new(Some(5), Some(10)),
                supplier_id: None,
                approver_id: None,
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }

    #[tokio::test]
    async fn should_pass_the_filter_to_the_repository() {
        let filter = PurchaseFilter {
            supplier_id: Some(SupplierId::generate()),
            approver_id: Some(SupplierId::generate()),
        };
        let mut mock_repo = MockPurchaseRepository::new();
        mock_repo
            .expect_find_all()
            .withf(move |_, f| *f == filter)
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListPurchasesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListPurchasesParams {
                page: PageRequest::default(),
                supplier_id: filter.supplier_id,
                approver_id: filter.approver_id,
            })
            .await;

        assert!(result.is_ok());
    }
}

