import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ProveedorError } from "../../../../domain/proveedor/errors";
import type { ProveedorDraft } from "../../../../domain/proveedor/model";
import { fakeProveedorRepository, ProveedorMother } from "../../../../test-support/proveedor";
import { renderScreen } from "../../../../test-support/render";
import { ProveedorFormContainer } from "./proveedor-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ProveedorDraft) {
  await screen.findByText("Save");
  type("Name", draft.name);
  type("Email", draft.email);
}

describe("ProveedorFormContainer", () => {
  test("should create the proveedor from what was typed and show it", async () => {
    // Arrange
    const draft = ProveedorMother.draft();
    const proveedorRepository = fakeProveedorRepository();
    const { history } = renderScreen(<ProveedorFormContainer />, { proveedorRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/proveedores/"));
    const {
      items: [created],
    } = await proveedorRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/proveedores/${created?.id}`);
  });

  test("should save the edited proveedor when an existing one is submitted", async () => {
    // Arrange
    const seeded = ProveedorMother.random();
    const proveedorRepository = fakeProveedorRepository([seeded]);
    const { history } = renderScreen(<ProveedorFormContainer id={seeded.id} />, {
      proveedorRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/proveedores/${seeded.id}`));
    expect(await proveedorRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "proveedor.validacion.invalid";
    const proveedorRepository = {
      ...fakeProveedorRepository(),
      create: () => Promise.reject(new ProveedorError(code)),
    };
    renderScreen(<ProveedorFormContainer />, { proveedorRepository });
    await fillIn(ProveedorMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a proveedor with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const proveedorRepository = {
      ...fakeProveedorRepository(),
      create: () => Promise.reject(new ProveedorError("proveedor.duplicado")),
    };
    renderScreen(<ProveedorFormContainer />, { proveedorRepository });
    await fillIn(ProveedorMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A proveedor with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const proveedorRepository = {
      ...fakeProveedorRepository(),
      create: () => Promise.reject(new ProveedorError("proveedor.name_invalido")),
    };
    renderScreen(<ProveedorFormContainer />, { proveedorRepository });
    await fillIn(ProveedorMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Name is not valid")).toBeTruthy();
    const input = screen.getByLabelText("Name");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/proveedor/containers/proveedor-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/proveedor/messages";
import type { Proveedor } from "../../../../domain/proveedor/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { ProveedorFormView, toProveedorDraft, toProveedorForm } from "../views/proveedor-form-view";

/** Creates a proveedor, or edits the one with `id`. */
export function ProveedorFormContainer({ id }: { id?: string }) {
  const { proveedorRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : proveedorRepository.get(id)),
    [proveedorRepository, id],
  );
  const title = id === undefined ? "New proveedor" : "Edit proveedor";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ProveedorForm existing={existing.data} />}
      <Link href={id === undefined ? "/proveedores" : `/proveedores/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ProveedorForm({ existing }: { existing: Proveedor | null }) {
  const { proveedorRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toProveedorForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toProveedorDraft(values);
      const saved =
        existing === null
          ? await proveedorRepository.create(draft)
          : await proveedorRepository.update(existing.id, draft);
      navigate(`/proveedores/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <ProveedorFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

=== web/src/presentation/features/proveedor/containers/proveedor-list-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { ProveedorError } from "../../../../domain/proveedor/errors";
import { fakeProveedorRepository, ProveedorMother } from "../../../../test-support/proveedor";
import { renderScreen } from "../../../../test-support/render";
import { ProveedorListContainer } from "./proveedor-list-container";

describe("ProveedorListContainer", () => {
  test("should show a row per proveedor when there are some", async () => {
    // Arrange
    const seed = [ProveedorMother.random(), ProveedorMother.random()];
    const proveedorRepository = fakeProveedorRepository(seed);

    // Act
    renderScreen(<ProveedorListContainer />, { proveedorRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ProveedorMother.random());
    const proveedorRepository = fakeProveedorRepository(seed);
    renderScreen(<ProveedorListContainer />, { proveedorRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ProveedorMother.random());
    const proveedorRepository = fakeProveedorRepository(seed);
    const path = "/proveedores?page=2";

    // Act
    renderScreen(<ProveedorListContainer />, { proveedorRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no proveedor", async () => {
    // Arrange
    const proveedorRepository = fakeProveedorRepository();

    // Act
    renderScreen(<ProveedorListContainer />, { proveedorRepository });

    // Assert
    expect(await screen.findByText("No proveedores yet.")).toBeTruthy();
  });

  test("should show the error code when the proveedores cannot be listed", async () => {
    // Arrange
    const proveedorRepository = {
      ...fakeProveedorRepository(),
      list: () => Promise.reject(new ProveedorError("proveedor.repositorio")),
    };

    // Act
    renderScreen(<ProveedorListContainer />, { proveedorRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("proveedor.repositorio");
  });
});

=== web/src/presentation/features/proveedor/containers/proveedor-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { ProveedorListView } from "../views/proveedor-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function ProveedorListContainer() {
  const { proveedorRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const proveedores = useAsync(
    () => proveedorRepository.list({ limit: PAGE_SIZE, offset }),
    [proveedorRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Proveedores</h1>
        <Link href="/proveedores/new" className="btn btn-primary">
          New proveedor
        </Link>
      </div>
      {proveedores.status === "loading" && <span className="loading loading-spinner" />}
      {proveedores.status === "error" && <ErrorAlert error={proveedores.error} />}
      {proveedores.status === "ok" &&
        (proveedores.data.total === 0 ? (
          <EmptyState message="No proveedores yet." />
        ) : (
          <>
            <ProveedorListView proveedores={proveedores.data.items} />
            <Pagination {...proveedores.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

