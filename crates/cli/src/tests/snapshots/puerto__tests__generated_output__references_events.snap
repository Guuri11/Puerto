use dominio_entrega::modelo::Entrega;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoEntrega {
    pub id: Uuid,
    pub compra_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

impl DtoEntrega {
    pub fn from_dominio(entidad: &Entrega) -> Self {
        Self {
            id: entidad.id.valor(),
            compra_id: entidad.compra_id.valor(),
            destinatario_id: entidad.destinatario_id.map(|v| v.valor()),
            carrier: entidad.carrier.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearEntrega {
    pub compra_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

/// Una página de Entregas: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaEntrega {
    pub elementos: Vec<DtoEntrega>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaEntrega {
    pub fn from_dominio(pagina: &Pagina<Entrega>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoEntrega::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarEntrega {
    pub compra_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

=== contextos/entrega/rest/src/errores.rs ===
use dominio_entrega::errores::ErrorEntrega;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de entrega como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorEntrega) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorEntrega::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorEntrega::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorEntrega::Duplicado => StatusCode::CONFLICT,
        ErrorEntrega::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorEntrega::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorEntrega::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "entrega.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEntrega::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "entrega.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEntrega::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "entrega.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEntrega::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "entrega.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorEntrega::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "entrega.desconocido");
    }
}

