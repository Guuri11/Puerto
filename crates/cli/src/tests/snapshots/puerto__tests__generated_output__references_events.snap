use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::delivery::{
    errors::DeliveryError,
    events::{DeliveryEvent, DeliverySnapshot},
    repository::DeliveryRepositoryTrait,
    unit_of_work::DeliveryUnitOfWorkFactory,
    use_cases::delete_delivery::{DeleteDeliveryParams, DeleteDeliveryUseCaseTrait},
};

pub struct DeleteDeliveryUseCaseImpl {
    pub repository: Arc<dyn DeliveryRepositoryTrait>,
    pub uow_factory: Arc<dyn DeliveryUnitOfWorkFactory>,
}

#[async_trait]
impl DeleteDeliveryUseCaseTrait for DeleteDeliveryUseCaseImpl {
    async fn execute(&self, params: DeleteDeliveryParams) -> Result<(), DeliveryError> {
        tracing::info!(id = %params.id, "delete_delivery: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "delete_delivery: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = DeliveryError::NotFound;
                tracing::warn!(error = %err, "delete_delivery: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(DeliveryEvent::Deleted(DeliverySnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::delivery::{
        model::{Delivery, DeliveryId, DeliveryProps},
        repository::mocks::MockDeliveryRepository,
        unit_of_work::mocks::RecordingUnitOfWorkFactory,
    };
    use crate::domain::purchase::model::PurchaseId;
    use puerto_core::DomainEvent;

    #[tokio::test]
    async fn should_record_delivery_deleted_when_id_exists() {
        // Arrange
        let entity = Delivery::new(DeliveryProps {
            purchase_id: PurchaseId::generate(),
            carrier: "example".to_string(),
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockDeliveryRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = DeleteDeliveryUseCaseImpl {
            repository: Arc::new(mock_repo),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(DeleteDeliveryParams { id: entity_id })
            .await;

        // Assert
        assert!(result.is_ok());
        let recorded = uow_factory.recorded();
        assert!(recorded.committed);
        assert!(recorded.saved.iter().all(|saved| saved.deleted));
        assert_eq!(recorded.events.len(), 1);
        assert_eq!(recorded.events[0].event_type(), "delivery_deleted");
        assert_eq!(recorded.events[0].aggregate_id(), entity_id.value());
    }

    #[tokio::test]
    async fn should_return_not_found_and_record_nothing_when_the_delivery_does_not_exist() {
        // Arrange
        let mut mock_repo = MockDeliveryRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = DeleteDeliveryUseCaseImpl {
            repository: Arc::new(mock_repo),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(DeleteDeliveryParams {
                id: DeliveryId::generate(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "delivery.not_found");
        assert!(uow_factory.recorded().events.is_empty());
    }
}

