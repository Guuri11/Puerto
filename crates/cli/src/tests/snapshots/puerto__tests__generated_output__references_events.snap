=== presentation/src/api/purchase/routes.rs ===
use std::sync::Arc;

use business::domain::purchase::model::PurchaseId;
use business::domain::purchase::use_cases::{
    create_purchase::{CreatePurchaseParams, CreatePurchaseUseCaseTrait},
    delete_purchase::{DeletePurchaseParams, DeletePurchaseUseCaseTrait},
    get_purchase::{GetPurchaseParams, GetPurchaseUseCaseTrait},
    list_purchases::{ListPurchasesParams, ListPurchasesUseCaseTrait},
    update_purchase::{UpdatePurchaseParams, UpdatePurchaseUseCaseTrait},
};
use business::domain::supplier::model::SupplierId;
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::purchase::dto::{
    CreatePurchaseRequest, PurchaseDto, PurchasePageDto, UpdatePurchaseRequest,
};
use crate::api::purchase::responses::{
    CreatePurchaseResponse, DeletePurchaseResponse, GetPurchaseResponse, ListPurchasesResponse,
    UpdatePurchaseResponse,
};
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct PurchaseApi {
    pub create_purchase: Arc<dyn CreatePurchaseUseCaseTrait>,
    pub get_purchase: Arc<dyn GetPurchaseUseCaseTrait>,
    pub list_purchases: Arc<dyn ListPurchasesUseCaseTrait>,
    pub update_purchase: Arc<dyn UpdatePurchaseUseCaseTrait>,
    pub delete_purchase: Arc<dyn DeletePurchaseUseCaseTrait>,
}

#[OpenApi]
impl PurchaseApi {
    /// Create a new Purchase
    #[oai(path = "/purchases", method = "post", tag = "ApiTags::Purchase")]
    async fn create(&self, body: Json<CreatePurchaseRequest>) -> CreatePurchaseResponse {
        match self
            .create_purchase
            .execute(CreatePurchaseParams {
                supplier_id: SupplierId::from_uuid(body.supplier_id),
                approver_id: body.approver_id.map(SupplierId::from_uuid),
                total: body.total,
            })
            .await
        {
            Ok(entity) => CreatePurchaseResponse::Created(Json(PurchaseDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_purchase failed");
                CreatePurchaseResponse::from_status(status, error)
            }
        }
    }

    /// Get a Purchase by ID
    #[oai(path = "/purchases/:id", method = "get", tag = "ApiTags::Purchase")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetPurchaseResponse {
        match self
            .get_purchase
            .execute(GetPurchaseParams {
                id: PurchaseId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetPurchaseResponse::Ok(Json(PurchaseDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_purchase failed");
                GetPurchaseResponse::from_status(status, error)
            }
        }
    }

    /// List Purchases, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/purchases", method = "get", tag = "ApiTags::Purchase")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
        #[oai(name = "supplierId")] supplier_id: Query<Option<Uuid>>,
        #[oai(name = "approverId")] approver_id: Query<Option<Uuid>>,
    ) -> ListPurchasesResponse {
        match self
            .list_purchases
            .execute(ListPurchasesParams {
                page: PageRequest::new(limit.0, offset.0),
                supplier_id: supplier_id.0.map(SupplierId::from_uuid),
                approver_id: approver_id.0.map(SupplierId::from_uuid),
            })
            .await
        {
            Ok(page) => ListPurchasesResponse::Ok(Json(PurchasePageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_purchases failed");
                ListPurchasesResponse::from_status(status, error)
            }
        }
    }

    /// Update a Purchase
    #[oai(path = "/purchases/:id", method = "put", tag = "ApiTags::Purchase")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdatePurchaseRequest>,
    ) -> UpdatePurchaseResponse {
        match self
            .update_purchase
            .execute(UpdatePurchaseParams {
                id: PurchaseId::from_uuid(id.0),
                supplier_id: SupplierId::from_uuid(body.supplier_id),
                approver_id: body.approver_id.map(SupplierId::from_uuid),
                total: body.total,
            })
            .await
        {
            Ok(entity) => UpdatePurchaseResponse::Ok(Json(PurchaseDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_purchase failed");
                UpdatePurchaseResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Purchase
    #[oai(path = "/purchases/:id", method = "delete", tag = "ApiTags::Purchase")]
    async fn delete(&self, id: Path<Uuid>) -> DeletePurchaseResponse {
        match self
            .delete_purchase
            .execute(DeletePurchaseParams {
                id: PurchaseId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeletePurchaseResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_purchase failed");
                DeletePurchaseResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::purchase::errors::PurchaseError;
    use business::domain::purchase::use_cases::{
        create_purchase::mocks::MockCreatePurchaseUseCase,
        delete_purchase::mocks::MockDeletePurchaseUseCase,
        get_purchase::mocks::MockGetPurchaseUseCase,
        list_purchases::mocks::MockListPurchasesUseCase,
        update_purchase::mocks::MockUpdatePurchaseUseCase,
    };
    use business::tests::mothers::purchase_mother::PurchaseMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreatePurchaseUseCase,
        get: MockGetPurchaseUseCase,
        list: MockListPurchasesUseCase,
        update: MockUpdatePurchaseUseCase,
        delete: MockDeletePurchaseUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = PurchaseApi {
                create_purchase: Arc::new(self.create),
                get_purchase: Arc::new(self.get),
                list_purchases: Arc::new(self.list),
                update_purchase: Arc::new(self.update),
                delete_purchase: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreatePurchaseRequest {
        CreatePurchaseRequest {
            supplier_id: Uuid::new_v4(),
            approver_id: None,
            total: 42,
        }
    }

    fn update_request() -> UpdatePurchaseRequest {
        UpdatePurchaseRequest {
            supplier_id: Uuid::new_v4(),
            approver_id: None,
            total: 42,
        }
    }

    fn item_path() -> String {
        format!("/purchases/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_purchase_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(PurchaseMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/purchases")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_purchase_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(PurchaseError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/purchases")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_422_when_a_referenced_supplier_id_does_not_exist() {
        // Arrange: the database found no Supplier with that id (ADR-0022 of Puerto).
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| {
            Err(PurchaseError::ValidationError(
                "supplier_id_not_found".to_string(),
            ))
        });

        // Act
        let response = mocks
            .client()
            .post("/purchases")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        response
            .json()
            .await
            .value()
            .object()
            .get("name")
            .assert_string("purchase.validation_error.supplier_id_not_found");
    }

    #[tokio::test]
    async fn should_respond_422_when_a_referenced_approver_id_does_not_exist() {
        // Arrange: the database found no Supplier with that id (ADR-0022 of Puerto).
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| {
            Err(PurchaseError::ValidationError(
                "approver_id_not_found".to_string(),
            ))
        });

        // Act
        let response = mocks
            .client()
            .post("/purchases")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        response
            .json()
            .await
            .value()
            .object()
            .get("name")
            .assert_string("purchase.validation_error.approver_id_not_found");
    }

    #[tokio::test]
    async fn should_respond_200_when_purchase_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(PurchaseMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_purchase_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(PurchaseError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_purchases_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(PurchaseMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/purchases").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/purchases?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_pass_the_supplier_id_filter_to_the_use_case() {
        // Arrange
        let supplier_id = Uuid::new_v4();
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(move |params| params.supplier_id == Some(SupplierId::from_uuid(supplier_id)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get(format!("/purchases?supplierId={supplier_id}"))
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_pass_the_approver_id_filter_to_the_use_case() {
        // Arrange
        let approver_id = Uuid::new_v4();
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(move |params| params.approver_id == Some(SupplierId::from_uuid(approver_id)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get(format!("/purchases?approverId={approver_id}"))
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(PurchaseError::RepositoryError));

        // Act
        let response = mocks.client().get("/purchases").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_purchase_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(PurchaseMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_purchase() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(PurchaseError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_purchase_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_purchase() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(PurchaseError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

