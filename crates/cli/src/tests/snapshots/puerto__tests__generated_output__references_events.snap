=== web/src/api/cliente.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { components, paths } from "./esquema";

/** El cliente tipado de la API. `paths` sale de la especificación del backend (`make web/sync`). */
export type ClienteApi = Client<paths>;

/** Los DTO de la API por nombre: `Esquemas["DtoProducto"]`, `Esquemas["PeticionCrearProducto"]`. */
export type Esquemas = components["schemas"];

/** `/api` es el backend: en desarrollo, Vite lo pasa a `:8080`. */
export function crearClienteApi(opciones: ClientOptions = {}): ClienteApi {
  return createClient<paths>({ baseUrl: "/api", ...opciones });
}

=== web/src/contextos/compra/contenedores/detalle-compra.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCompra, MadreCompra } from "../../../pruebas/compra";
import { coleccionProveedor, MadreProveedor } from "../../../pruebas/proveedor";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleCompra } from "./detalle-compra";

describe("ContenedorDetalleCompra", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreCompra.aleatorio();
    const api = apiFalsa([coleccionCompra([sembrado])]);

    const pantalla = <ContenedorDetalleCompra id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería enlazar Proveedor con su página y su etiqueta", async () => {
    // Preparar
    const sembrado = MadreCompra.aleatorio();
    const objetivo = MadreProveedor.aleatorio({ id: sembrado.proveedorId });
    const api = apiFalsa([coleccionCompra([sembrado]), coleccionProveedor([objetivo])]);
    const pantalla = <ContenedorDetalleCompra id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/proveedores/${sembrado.proveedorId}"]`;
    expect(await screen.findByText(objetivo.name, { selector })).toBeTruthy();
  });

  test("debería enlazar Approver con su página y su etiqueta", async () => {
    // Preparar
    const sembrado = MadreCompra.aleatorio();
    const objetivo = MadreProveedor.aleatorio({ id: sembrado.approverId ?? crypto.randomUUID() });
    const api = apiFalsa([coleccionCompra([sembrado]), coleccionProveedor([objetivo])]);
    const pantalla = <ContenedorDetalleCompra id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/proveedores/${sembrado.approverId}"]`;
    expect(await screen.findByText(objetivo.name, { selector })).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionCompra()]);
    const pantalla = <ContenedorDetalleCompra id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("compra.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreCompra.aleatorio();
    const guardados = coleccionCompra([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleCompra id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/compras"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/compra/contenedores/detalle-compra.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleCompra } from "../vistas/detalle-compra";

export function ContenedorDetalleCompra({ id }: { id: string }) {
  const { api } = useDependencias();
  const compra = useCarga(
    () => desenvolver(api.GET("/compras/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/compras/{id}", { params: { path: { id } } }));
      navegar("/compras");
    } catch (error) {
      setFallo(error);
    }
  };
  const etiquetaProveedor = async (objetivo: string) => {
    const params = { path: { id: objetivo } };
    const encontrado = await desenvolver(api.GET("/proveedores/{id}", { params }));
    return encontrado.name;
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Compra</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {compra.estado === "cargando" && <span className="loading loading-spinner" />}
      {compra.estado === "error" && <AlertaError error={compra.error} />}
      {compra.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleCompra compra={compra.datos} etiquetaProveedor={etiquetaProveedor} />
            <div className="card-actions justify-end">
              <Link href={`/compras/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/compras" className="link">
        Volver a compras
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar compra?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/compra/contenedores/formulario-compra.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { textoDe } from "../../../compartido/formularios";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCompra, MadreCompra } from "../../../pruebas/compra";
import { coleccionProveedor, MadreProveedor } from "../../../pruebas/proveedor";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorFormularioCompra } from "./formulario-compra";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Elige `id` en el select de una referencia, en cuanto se cargan sus objetivos. */
async function elegir(etiqueta: string, id: string) {
  const select = screen.getByLabelText(etiqueta);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** Las colecciones que leen los selects, con lo que referencia `dueno`. */
function referenciadosPor(dueno: Partial<Esquemas["DtoCompra"]>) {
  return [
    coleccionProveedor([
      MadreProveedor.aleatorio({ id: dueno.proveedorId ?? crypto.randomUUID() }),
      MadreProveedor.aleatorio({ id: dueno.approverId ?? crypto.randomUUID() }),
    ]),
  ];
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearCompra"]) {
  await screen.findByText("Guardar");
  await elegir("Proveedor", peticion.proveedorId);
  await elegir("Approver", textoDe(peticion.approverId));
  escribir("Total", String(peticion.total));
}

describe("ContenedorFormularioCompra", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreCompra.peticion();
    const guardados = coleccionCompra();
    const api = apiFalsa([guardados, ...referenciadosPor(peticion)]);
    const pantalla = <ContenedorFormularioCompra />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/compras/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/compras/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreCompra.aleatorio();
    const guardados = coleccionCompra([sembrado]);
    const api = apiFalsa([guardados, ...referenciadosPor(sembrado)]);
    const pantalla = <ContenedorFormularioCompra id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/compras/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreCompra.peticion();
    const codigo = "compra.validacion.invalido";
    const fallos = { "POST /compras": codigo };
    const api = apiFalsa([coleccionCompra(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioCompra />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreCompra.peticion();
    const fallos = { "POST /compras": "compra.duplicado" };
    const api = apiFalsa([coleccionCompra(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioCompra />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("Estos valores ya están en uso");
  });

  test("debería ofrecer cada proveedor en sus selects", async () => {
    // Preparar
    const proveedor = MadreProveedor.aleatorio();
    const api = apiFalsa([coleccionProveedor([proveedor])]);

    // Actuar
    renderizarPantalla(<ContenedorFormularioCompra />, { api });

    // Comprobar
    const opciones = await screen.findAllByRole("option", { name: proveedor.name });
    expect(opciones).toHaveLength(2);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreCompra.peticion();
    const fallos = { "POST /compras": "compra.validacion.proveedor_id_no_encontrado" };
    const api = apiFalsa([coleccionCompra(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioCompra />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText("Proveedor: no existe")).toBeTruthy();
    const campo = screen.getByLabelText("Proveedor");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/compra/contenedores/formulario-compra.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver, LIMITE_PAGINA_MAXIMO } from "../../../api/http";
import { opcionesReferencia } from "../../../compartido/formularios";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioCompra,
  aPeticionCompra,
  VistaFormularioCompra,
} from "../vistas/formulario-compra";

type Compra = Esquemas["DtoCompra"];

/** La primera página de cada entidad referenciada: lo que ofrecen sus selects. */
const PRIMERA_PAGINA = { params: { query: { limite: LIMITE_PAGINA_MAXIMO } } };

/** Crear, o editar con `id`: el formulario de compras. */
export function ContenedorFormularioCompra({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/compras/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear compra" : "Editar compra";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioCompra existente={existente.datos} />}
      <Link href={id === undefined ? "/compras" : `/compras/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioCompra({ existente }: { existente: Compra | null }) {
  const { api } = useDependencias();
  const proveedores = useCarga(() => desenvolver(api.GET("/proveedores", PRIMERA_PAGINA)), [api]);
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioCompra(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionCompra(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/compras", { body: cuerpo })
          : api.PUT("/compras/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/compras/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        {proveedores.estado === "error" && <AlertaError error={proveedores.error} />}
        <VistaFormularioCompra
          valores={valores}
          opciones={{
            proveedorId: opcionesReferencia(proveedores, (proveedor) => proveedor.name),
            approverId: opcionesReferencia(proveedores, (proveedor) => proveedor.name),
          }}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

