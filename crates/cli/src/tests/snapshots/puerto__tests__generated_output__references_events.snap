use chrono::{DateTime, Utc};
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_entrega::{
    errores::ErrorEntrega,
    modelo::{Entrega, IdEntrega},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaEntrega {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub compra_id: Uuid,
    pub destinatario_id: Option<Uuid>,
    pub carrier: String,
}

impl TryFrom<FilaEntrega> for Entrega {
    type Error = ErrorEntrega;

    fn try_from(fila: FilaEntrega) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Entrega {
            id: IdEntrega::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            compra_id: IdCompra::from_uuid(fila.compra_id),
            destinatario_id: fila.destinatario_id.map(IdProveedor::from_uuid),
            carrier: fila.carrier,
        }))
    }
}

impl From<&Entrega> for FilaEntrega {
    fn from(entidad: &Entrega) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            compra_id: entidad.compra_id.valor(),
            destinatario_id: entidad.destinatario_id.map(|v| v.valor()),
            carrier: entidad.carrier.clone(),
        }
    }
}

