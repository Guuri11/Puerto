=== contextos/entrega/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad entrega válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_entrega::modelo::Entrega;
use dominio_entrega::modelo::PropsEntrega;
use dominio_entrega::pruebas::madres::MadreEntrega;
use dominio_entrega::unit_of_work::UnitOfWorkFactoryEntrega;
use sqlx::PgPool;

use crate::unit_of_work::UnitOfWorkFactoryEntregaPostgres;

/// Una entidad entrega válida, sin guardar, con los valores de la madre salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada).
pub async fn construir(pool: &PgPool) -> Entrega {
    Entrega::new(PropsEntrega {
        compra_id: infra_compra::pruebas::siembra::sembrar(pool).await.id,
        ..MadreEntrega::new().construir_props()
    })
    .unwrap()
}

/// Guarda la entidad a través de la unidad de trabajo: el repositorio solo lee.
pub async fn guardar(pool: &PgPool, entidad: &Entrega) {
    let mut uow = UnitOfWorkFactoryEntregaPostgres::new(pool.clone())
        .begin()
        .await
        .unwrap();
    uow.guardar(entidad).await.unwrap();
    uow.commit().await.unwrap();
}

/// Una entidad entrega guardada.
pub async fn sembrar(pool: &PgPool) -> Entrega {
    let entidad = construir(pool).await;
    guardar(pool, &entidad).await;
    entidad
}

=== contextos/entrega/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_entrega::{
    modelo::{Entrega, IdEntrega},
    repositorio::{FiltroEntrega, RepositorioEntrega},
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::mapear_error_sqlx;

use crate::fila::FilaEntrega;

pub struct RepositorioEntregaPostgres {
    pub pool: PgPool,
}

impl RepositorioEntregaPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaEntrega) -> Result<Entrega, ErrorRepositorio> {
    Entrega::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad entrega válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioEntrega for RepositorioEntregaPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroEntrega,
    ) -> Result<Pagina<Entrega>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        // Una sola consulta estática sea cual sea el filtro: un id sin valor es NULL y casa con
        // todas las filas.
        let compra_id = filtro.compra_id.map(|id| id.valor());
        let destinatario_id = filtro.destinatario_id.map(|id| id.valor());
        let filas = sqlx::query_as!(
            FilaEntrega,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, compra_id, destinatario_id, carrier
             FROM entregas WHERE borrado = false AND ($3::uuid IS NULL OR compra_id = $3) AND ($4::uuid IS NULL OR destinatario_id = $4)
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento()),
            compra_id,
            destinatario_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM entregas WHERE borrado = false AND ($1::uuid IS NULL OR compra_id = $1) AND ($2::uuid IS NULL OR destinatario_id = $2)"#,
            compra_id,
            destinatario_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdEntrega) -> Result<Option<Entrega>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaEntrega,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, compra_id, destinatario_id, carrier
             FROM entregas WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::{construir, guardar, sembrar};

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioEntregaPostgres {
        RepositorioEntregaPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.compra_id, entidad.compra_id);
        assert_eq!(encontrado.destinatario_id, entidad.destinatario_id);
        assert_eq!(encontrado.carrier, entidad.carrier);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdEntrega::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_entregas_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        guardar(&pool, &borrado).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default(), FiltroEntrega::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::new(Some(2), Some(2)),
                FiltroEntrega::default(),
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_entregas_con_ese_valor_de_compra_id(pool: PgPool) {
        // Preparar: una entidad entrega con este valor de compra_id y otra sin él.
        let destino = infra_compra::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.compra_id = destino.id;
        guardar(&pool, &esperado).await;
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroEntrega {
                    compra_id: Some(destino.id),
                    destinatario_id: None,
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_entregas_con_ese_valor_de_destinatario_id(pool: PgPool) {
        // Preparar: una entidad entrega con este valor de destinatario_id y otra sin él.
        let destino = infra_proveedor::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.destinatario_id = Some(destino.id);
        guardar(&pool, &esperado).await;
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroEntrega {
                    compra_id: None,
                    destinatario_id: Some(destino.id),
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }
}

=== contextos/entrega/infraestructura/src/unit_of_work.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_entrega::{
    eventos::EventoEntrega,
    modelo::Entrega,
    unit_of_work::{UnitOfWorkEntrega, UnitOfWorkFactoryEntrega},
};
use puerto_nucleo::ErrorRepositorio;
use puerto_sqlx::uow::TransaccionPostgres;
use puerto_sqlx::{ClaveForanea, mapear_error_sqlx_con};

use crate::fila::FilaEntrega;

/// Abre una transacción de Postgres por escritura: la fila de entrega y su evento del outbox
/// hacen commit juntos.
pub struct UnitOfWorkFactoryEntregaPostgres {
    pub pool: PgPool,
}

impl UnitOfWorkFactoryEntregaPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Las claves foráneas por las que pasa una escritura (ADR-0022 de Puerto): la base de datos
/// rechaza una referencia a una fila que no existe, y quien llama recibe como error el campo que la
/// nombra.
const REFERENCES: &[ClaveForanea] = &[
    ClaveForanea {
        restriccion: "entregas_compra_id_fkey",
        campo: "compra_id",
    },
    ClaveForanea {
        restriccion: "entregas_destinatario_id_fkey",
        campo: "destinatario_id",
    },
];

#[async_trait]
impl UnitOfWorkFactoryEntrega for UnitOfWorkFactoryEntregaPostgres {
    async fn begin(&self) -> Result<Box<dyn UnitOfWorkEntrega>, ErrorRepositorio> {
        let tx = TransaccionPostgres::begin(&self.pool).await?;
        Ok(Box::new(UnitOfWorkEntregaPostgres { tx }))
    }
}

struct UnitOfWorkEntregaPostgres {
    tx: TransaccionPostgres,
}

#[async_trait]
impl UnitOfWorkEntrega for UnitOfWorkEntregaPostgres {
    async fn guardar(&mut self, entidad: &Entrega) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaEntrega::from(entidad);
        sqlx::query!(
            "INSERT INTO entregas (id, creado_en, actualizado_en, borrado, borrado_en, compra_id, destinatario_id, carrier)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, compra_id = $6, destinatario_id = $7, carrier = $8",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.compra_id,
            db.destinatario_id,
            db.carrier,
        )
        .execute(self.tx.tx())
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx_con(&e, REFERENCES)
        })?;
        Ok(())
    }

    async fn registrar(&mut self, evento: EventoEntrega) -> Result<(), ErrorRepositorio> {
        self.tx.registrar(&evento).await
    }

    async fn commit(self: Box<Self>) -> Result<(), ErrorRepositorio> {
        self.tx.commit().await
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use dominio_entrega::{eventos::SnapshotEntrega, repositorio::RepositorioEntrega};

    use crate::pruebas::siembra::construir;
    use crate::repositorio::RepositorioEntregaPostgres;
    use dominio_compra::modelo::IdCompra;
    use dominio_proveedor::modelo::IdProveedor;

    /// Lo que hace un caso de uso de creación: guardar, registrar, commit.
    async fn crear(pool: &PgPool, entidad: &Entrega) -> Result<(), ErrorRepositorio> {
        let mut uow = UnitOfWorkFactoryEntregaPostgres::new(pool.clone())
            .begin()
            .await?;
        uow.guardar(entidad).await?;
        uow.registrar(EventoEntrega::Creado(SnapshotEntrega::from_entidad(
            entidad,
        )))
        .await?;
        uow.commit().await
    }

    async fn contar(pool: &PgPool, sql: &str) -> i64 {
        sqlx::query_scalar(sql).fetch_one(pool).await.unwrap()
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_escribir_entrega_y_su_evento_cuando_hace_commit(pool: PgPool) {
        // Preparar
        let entidad = construir(&pool).await;

        // Actuar
        crear(&pool, &entidad).await.unwrap();

        // Comprobar
        let encontrado = RepositorioEntregaPostgres::new(pool.clone())
            .buscar_por_id(entidad.id)
            .await
            .unwrap();
        assert!(encontrado.is_some());
        let (tipo_evento, id_agregado): (String, uuid::Uuid) =
            sqlx::query_as("SELECT tipo_evento, id_agregado FROM outbox")
                .fetch_one(&pool)
                .await
                .unwrap();
        assert_eq!(tipo_evento, "entrega_creado");
        assert_eq!(id_agregado, entidad.id.valor());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn no_deberia_escribir_nada_cuando_se_libera_sin_commit(pool: PgPool) {
        // Preparar
        let entidad = construir(&pool).await;

        // Actuar
        {
            let mut uow = UnitOfWorkFactoryEntregaPostgres::new(pool.clone())
                .begin()
                .await
                .unwrap();
            uow.guardar(&entidad).await.unwrap();
            uow.registrar(EventoEntrega::Creado(SnapshotEntrega::from_entidad(
                &entidad,
            )))
            .await
            .unwrap();
        }

        // Comprobar
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM entregas").await, 0);
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_entrega_cuando_se_guarda_de_nuevo(pool: PgPool) {
        // Preparar
        let mut entidad = construir(&pool).await;
        crear(&pool, &entidad).await.unwrap();
        entidad.carrier = "updated".to_string();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        let mut uow = UnitOfWorkFactoryEntregaPostgres::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.guardar(&entidad).await.unwrap();
        uow.commit().await.unwrap();

        // Comprobar
        let encontrado = RepositorioEntregaPostgres::new(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(encontrado.carrier, "updated");
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn no_deberia_escribir_fila_ni_evento_cuando_compra_id_ya_esta_en_uso(pool: PgPool) {
        // Preparar
        let primero = construir(&pool).await;
        crear(&pool, &primero).await.unwrap();
        let mut segundo = construir(&pool).await;
        segundo.compra_id = primero.compra_id;

        // Actuar
        let resultado = crear(&pool, &segundo).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::Duplicado);
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM entregas").await, 1);
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_compra_id_inexistente(pool: PgPool) {
        // Preparar: un valor de compra_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.compra_id = IdCompra::generar();

        // Actuar
        let resultado = crear(&pool, &entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("compra_id")
        );
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_destinatario_id_inexistente(pool: PgPool) {
        // Preparar: un valor de destinatario_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.destinatario_id = Some(IdProveedor::generar());

        // Actuar
        let resultado = crear(&pool, &entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("destinatario_id")
        );
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }
}

