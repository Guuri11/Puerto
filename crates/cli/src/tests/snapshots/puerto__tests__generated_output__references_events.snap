import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { DeliveryDetailView } from "../views/delivery-detail-view";

export function DeliveryDetailContainer({ id }: { id: string }) {
  const { deliveryRepository } = useDependencies();
  const delivery = useAsync(() => deliveryRepository.get(id), [deliveryRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await deliveryRepository.remove(id);
      navigate("/deliveries");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Delivery</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {delivery.status === "loading" && <span className="loading loading-spinner" />}
      {delivery.status === "error" && <ErrorAlert error={delivery.error} />}
      {delivery.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <DeliveryDetailView delivery={delivery.data} />
            <div className="card-actions justify-end">
              <Link href={`/deliveries/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/deliveries" className="link">
        Back to deliveries
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this delivery?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

