import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleProveedor } from "../vistas/detalle-proveedor";

export function ContenedorDetalleProveedor({ id }: { id: string }) {
  const { api } = useDependencias();
  const proveedor = useCarga(
    () => desenvolver(api.GET("/proveedores/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/proveedores/{id}", { params: { path: { id } } }));
      navegar("/proveedores");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Proveedor</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {proveedor.estado === "cargando" && <span className="loading loading-spinner" />}
      {proveedor.estado === "error" && <AlertaError error={proveedor.error} />}
      {proveedor.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleProveedor proveedor={proveedor.datos} />
            <div className="card-actions justify-end">
              <Link href={`/proveedores/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/proveedores" className="link">
        Volver a proveedores
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar proveedor?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

