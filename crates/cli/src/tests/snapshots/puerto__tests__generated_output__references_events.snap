=== presentacion/api/src/generado/bootstrap.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
use poem::Endpoint;
use poem_openapi::OpenApiService;
use rest_compra::rutas::ApiCompra;
use rest_entrega::rutas::ApiEntrega;
use rest_proveedor::rutas::ApiProveedor;
use rest_saludo::rutas::ApiSaludo;

/// Las rutas, cableadas. Un error es lo que paró el arranque: `main` lo muestra y sale con 1.
pub async fn construir_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL no está definida — defínela en .env (.env.example trae una)".to_string()
    })?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — ¿está arrancada la base de datos? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;

    let casos_saludo = cableado::saludo::construir();
    let api_saludo = ApiSaludo {
        obtener_saludo: casos_saludo.obtener_saludo,
    };

    let casos_proveedor = cableado::proveedor::construir(&pool);
    let api_proveedor = ApiProveedor {
        crear_proveedor: casos_proveedor.crear_proveedor,
        obtener_proveedor: casos_proveedor.obtener_proveedor,
        listar_proveedores: casos_proveedor.listar_proveedores,
        actualizar_proveedor: casos_proveedor.actualizar_proveedor,
        borrar_proveedor: casos_proveedor.borrar_proveedor,
    };

    let casos_compra = cableado::compra::construir(&pool);
    let api_compra = ApiCompra {
        crear_compra: casos_compra.crear_compra,
        obtener_compra: casos_compra.obtener_compra,
        listar_compras: casos_compra.listar_compras,
        actualizar_compra: casos_compra.actualizar_compra,
        borrar_compra: casos_compra.borrar_compra,
    };

    let casos_entrega = cableado::entrega::construir(&pool);
    let api_entrega = ApiEntrega {
        crear_entrega: casos_entrega.crear_entrega,
        obtener_entrega: casos_entrega.obtener_entrega,
        listar_entregas: casos_entrega.listar_entregas,
        actualizar_entrega: casos_entrega.actualizar_entrega,
        borrar_entrega: casos_entrega.borrar_entrega,
    };

    let disponible = puerto_web::health::sondear(move || {
        let pool = pool.clone();
        async move { puerto_sqlx::ping(&pool).await }
    });

    // `app.rs` es del proyecto: el middleware y las rutas que se añadan allí envuelven todo esto.
    Ok(crate::app::configurar(puerto_web::rutas(
        servicio_openapi((api_saludo, api_proveedor, api_compra, api_entrega)),
        &config,
        disponible,
    )))
}

/// El servicio de la API, construido en un solo sitio: cualquier otro que lea su spec (el test de
/// exportación de un proyecto con `web/`) ve la API que responde el servidor.
fn servicio_openapi<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::sync::Arc;

    use aplicacion_compra::actualizar_compra::dobles::MockActualizarCompra;
    use aplicacion_compra::borrar_compra::dobles::MockBorrarCompra;
    use aplicacion_compra::crear_compra::dobles::MockCrearCompra;
    use aplicacion_compra::listar_compras::dobles::MockListarCompras;
    use aplicacion_compra::obtener_compra::dobles::MockObtenerCompra;
    use aplicacion_entrega::actualizar_entrega::dobles::MockActualizarEntrega;
    use aplicacion_entrega::borrar_entrega::dobles::MockBorrarEntrega;
    use aplicacion_entrega::crear_entrega::dobles::MockCrearEntrega;
    use aplicacion_entrega::listar_entregas::dobles::MockListarEntregas;
    use aplicacion_entrega::obtener_entrega::dobles::MockObtenerEntrega;
    use aplicacion_proveedor::actualizar_proveedor::dobles::MockActualizarProveedor;
    use aplicacion_proveedor::borrar_proveedor::dobles::MockBorrarProveedor;
    use aplicacion_proveedor::crear_proveedor::dobles::MockCrearProveedor;
    use aplicacion_proveedor::listar_proveedores::dobles::MockListarProveedores;
    use aplicacion_proveedor::obtener_proveedor::dobles::MockObtenerProveedor;
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;

    /// El contrato de la API del que se generan los tipos del frontend (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../../docs/api/openapi.json");

    /// Se construye con casos de uso dobles: sin servidor ni base de datos. Si falta el fichero,
    /// se escribe; si es distinto, falla: ejecuta `make web/sync` (pone `UPDATE_OPENAPI=1`) y haz
    /// commit del diff.
    #[test]
    fn la_spec_openapi_coincide_con_docs_api_openapi_json() {
        let api_saludo = ApiSaludo {
            obtener_saludo: Arc::new(MockObtenerSaludo::new()),
        };
        let api_proveedor = ApiProveedor {
            crear_proveedor: Arc::new(MockCrearProveedor::new()),
            obtener_proveedor: Arc::new(MockObtenerProveedor::new()),
            listar_proveedores: Arc::new(MockListarProveedores::new()),
            actualizar_proveedor: Arc::new(MockActualizarProveedor::new()),
            borrar_proveedor: Arc::new(MockBorrarProveedor::new()),
        };
        let api_compra = ApiCompra {
            crear_compra: Arc::new(MockCrearCompra::new()),
            obtener_compra: Arc::new(MockObtenerCompra::new()),
            listar_compras: Arc::new(MockListarCompras::new()),
            actualizar_compra: Arc::new(MockActualizarCompra::new()),
            borrar_compra: Arc::new(MockBorrarCompra::new()),
        };
        let api_entrega = ApiEntrega {
            crear_entrega: Arc::new(MockCrearEntrega::new()),
            obtener_entrega: Arc::new(MockObtenerEntrega::new()),
            listar_entregas: Arc::new(MockListarEntregas::new()),
            actualizar_entrega: Arc::new(MockActualizarEntrega::new()),
            borrar_entrega: Arc::new(MockBorrarEntrega::new()),
        };
        let spec = servicio_openapi((api_saludo, api_proveedor, api_compra, api_entrega)).spec();

        let ruta = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !ruta.exists() {
            let directorio = ruta
                .parent()
                .expect("docs/api/openapi.json tiene directorio padre");
            std::fs::create_dir_all(directorio).expect("crear docs/api");
            std::fs::write(ruta, &spec).expect("escribir docs/api/openapi.json");
            return;
        }
        let en_disco = std::fs::read_to_string(ruta).expect("leer docs/api/openapi.json");
        assert!(
            en_disco == spec,
            "docs/api/openapi.json no es la API que sirve este código: ejecuta `make web/sync`"
        );
    }
}

