import type { Esquemas } from "../api/cliente";
import { coleccion } from "./api-falsa";

type Proveedor = Esquemas["DtoProveedor"];
type PeticionProveedor = Esquemas["PeticionCrearProveedor"];

/** Datos válidos de proveedores; en `cambios`, los campos de los que trata el test. */
export const MadreProveedor = {
  peticion(cambios: Partial<PeticionProveedor> = {}): PeticionProveedor {
    return {
      name: "example",
      email: "example",
      ...cambios,
    };
  },

  aleatorio(cambios: Partial<Proveedor> = {}): Proveedor {
    return { id: crypto.randomUUID(), ...MadreProveedor.peticion(), ...cambios };
  },
};

/** El `/proveedores` de la API falsa, con `semilla`. */
export function coleccionProveedor(semilla: Proveedor[] = []) {
  return coleccion("/proveedores", "proveedor", semilla);
}
