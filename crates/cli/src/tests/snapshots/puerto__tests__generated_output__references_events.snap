import { Route, Switch } from "wouter";
import { DeliveryDetailContainer } from "../../features/delivery/containers/delivery-detail-container";
import { DeliveryFormContainer } from "../../features/delivery/containers/delivery-form-container";
import { DeliveryListContainer } from "../../features/delivery/containers/delivery-list-container";
import { PurchaseDetailContainer } from "../../features/purchase/containers/purchase-detail-container";
import { PurchaseFormContainer } from "../../features/purchase/containers/purchase-form-container";
import { PurchaseListContainer } from "../../features/purchase/containers/purchase-list-container";
import { SupplierDetailContainer } from "../../features/supplier/containers/supplier-detail-container";
import { SupplierFormContainer } from "../../features/supplier/containers/supplier-form-container";
import { SupplierListContainer } from "../../features/supplier/containers/supplier-list-container";
import { HomePage } from "../../pages/home";
import { NotFoundPage } from "../../pages/not-found";
import type { NavEntry } from "../../shared/ui/layout";
import { customRoutes } from "../routes";

export const navEntries: NavEntry[] = [
  { label: "Deliveries", href: "/deliveries" },
  { label: "Purchases", href: "/purchases" },
  { label: "Suppliers", href: "/suppliers" },
];

export function AppRoutes() {
  return (
    <Switch>
      <Route path="/">
        <HomePage entries={navEntries} />
      </Route>
      {customRoutes}
      <Route path="/deliveries">
        <DeliveryListContainer />
      </Route>
      <Route path="/deliveries/new">
        <DeliveryFormContainer />
      </Route>
      <Route path="/deliveries/:id/edit">
        {(params) => <DeliveryFormContainer id={params.id} />}
      </Route>
      <Route path="/deliveries/:id">{(params) => <DeliveryDetailContainer id={params.id} />}</Route>
      <Route path="/purchases">
        <PurchaseListContainer />
      </Route>
      <Route path="/purchases/new">
        <PurchaseFormContainer />
      </Route>
      <Route path="/purchases/:id/edit">
        {(params) => <PurchaseFormContainer id={params.id} />}
      </Route>
      <Route path="/purchases/:id">{(params) => <PurchaseDetailContainer id={params.id} />}</Route>
      <Route path="/suppliers">
        <SupplierListContainer />
      </Route>
      <Route path="/suppliers/new">
        <SupplierFormContainer />
      </Route>
      <Route path="/suppliers/:id/edit">
        {(params) => <SupplierFormContainer id={params.id} />}
      </Route>
      <Route path="/suppliers/:id">{(params) => <SupplierDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

