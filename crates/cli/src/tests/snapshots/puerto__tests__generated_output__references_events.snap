use chrono::{DateTime, Utc};
use dominio_proveedor::modelo::IdProveedor;
use uuid::Uuid;

use crate::errores::ErrorCompra;

/// El id de cada `Compra`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdCompra(Uuid);

impl IdCompra {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdCompra {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsCompra {
    pub proveedor_id: IdProveedor,
    pub approver_id: Option<IdProveedor>,
    pub total: i64,
}

#[derive(Debug, Clone)]
pub struct Compra {
    pub id: IdCompra,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub proveedor_id: IdProveedor,
    pub approver_id: Option<IdProveedor>,
    pub total: i64,
}

impl Compra {
    pub fn new(props: PropsCompra) -> Result<Self, ErrorCompra> {
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdCompra::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            proveedor_id: props.proveedor_id,
            approver_id: props.approver_id,
            total: props.total,
        })
    }

    pub fn from_repositorio(datos: Compra) -> Self {
        datos
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_crear_compra_cuando_los_campos_son_validos() {
        let resultado = Compra::new(PropsCompra {
            proveedor_id: IdProveedor::generar(),
            approver_id: None,
            total: 42,
        });
        assert!(resultado.is_ok());
    }
}

