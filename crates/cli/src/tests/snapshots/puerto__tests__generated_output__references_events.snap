use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{IdProveedor, Proveedor};

#[async_trait]
pub trait RepositorioProveedor: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Proveedor>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdProveedor) -> Result<Option<Proveedor>, ErrorRepositorio>;
    // Sin `guardar`: las escrituras pasan por `UnitOfWorkFactoryProveedor`, que registra sus
    // eventos.
}

