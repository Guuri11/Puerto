=== web/src/contextos/proveedor/vistas/formulario-proveedor.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaProveedor } from "../mensajes";

type Proveedor = Esquemas["DtoProveedor"];
type PeticionProveedor = Esquemas["PeticionCrearProveedor"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioProveedor {
  name: string;
  email: string;
}

/** Los inputs de `proveedor`, vacíos cuando todavía no hay ninguno. */
export function aFormularioProveedor(proveedor: Proveedor | null): ValoresFormularioProveedor {
  if (proveedor === null) {
    return {
      name: "",
      email: "",
    };
  }
  return {
    name: proveedor.name,
    email: proveedor.email,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionProveedor(valores: ValoresFormularioProveedor): PeticionProveedor {
  return {
    name: valores.name,
    email: valores.email,
  };
}

export function VistaFormularioProveedor({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioProveedor;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaProveedor | null;
  alCambiar: (valores: ValoresFormularioProveedor) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "name"}
          required
          value={valores.name}
          onChange={(event) => alCambiar({ ...valores, name: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "email"}
          required
          value={valores.email}
          onChange={(event) => alCambiar({ ...valores, email: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="email" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

