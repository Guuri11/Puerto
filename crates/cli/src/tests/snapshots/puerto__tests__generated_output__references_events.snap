=== contextos/proveedor/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad proveedor válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_proveedor::modelo::PropsProveedor;
use dominio_proveedor::modelo::Proveedor;
use dominio_proveedor::pruebas::madres::MadreProveedor;
use dominio_proveedor::unit_of_work::UnitOfWorkFactoryProveedor;
use sqlx::PgPool;
use uuid::Uuid;

use crate::unit_of_work::UnitOfWorkFactoryProveedorPostgres;

/// Una entidad proveedor válida, sin guardar, con los valores de la madre salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada).
pub fn construir() -> Proveedor {
    Proveedor::new(PropsProveedor {
        email: Uuid::new_v4().to_string(),
        ..MadreProveedor::new().construir_props()
    })
    .unwrap()
}

/// Guarda la entidad a través de la unidad de trabajo: el repositorio solo lee.
pub async fn guardar(pool: &PgPool, entidad: &Proveedor) {
    let mut uow = UnitOfWorkFactoryProveedorPostgres::new(pool.clone())
        .begin()
        .await
        .unwrap();
    uow.guardar(entidad).await.unwrap();
    uow.commit().await.unwrap();
}

/// Una entidad proveedor guardada.
pub async fn sembrar(pool: &PgPool) -> Proveedor {
    let entidad = construir();
    guardar(pool, &entidad).await;
    entidad
}

=== contextos/proveedor/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_proveedor::{
    modelo::{IdProveedor, Proveedor},
    repositorio::RepositorioProveedor,
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::mapear_error_sqlx;

use crate::fila::FilaProveedor;

pub struct RepositorioProveedorPostgres {
    pub pool: PgPool,
}

impl RepositorioProveedorPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaProveedor) -> Result<Proveedor, ErrorRepositorio> {
    Proveedor::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad proveedor válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioProveedor for RepositorioProveedorPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Proveedor>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        let filas = sqlx::query_as!(
            FilaProveedor,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, name, email
             FROM proveedores WHERE borrado = false
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento())
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM proveedores WHERE borrado = false"#
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdProveedor) -> Result<Option<Proveedor>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaProveedor,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, name, email
             FROM proveedores WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::{guardar, sembrar};

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioProveedorPostgres {
        RepositorioProveedorPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.name, entidad.name);
        assert_eq!(encontrado.email, entidad.email);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdProveedor::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_proveedores_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        guardar(&pool, &borrado).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }
}

=== contextos/proveedor/infraestructura/src/unit_of_work.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_proveedor::{
    eventos::EventoProveedor,
    modelo::Proveedor,
    unit_of_work::{UnitOfWorkFactoryProveedor, UnitOfWorkProveedor},
};
use puerto_nucleo::ErrorRepositorio;
use puerto_sqlx::mapear_error_sqlx;
use puerto_sqlx::uow::TransaccionPostgres;

use crate::fila::FilaProveedor;

/// Abre una transacción de Postgres por escritura: la fila de proveedor y su evento del outbox
/// hacen commit juntos.
pub struct UnitOfWorkFactoryProveedorPostgres {
    pub pool: PgPool,
}

impl UnitOfWorkFactoryProveedorPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl UnitOfWorkFactoryProveedor for UnitOfWorkFactoryProveedorPostgres {
    async fn begin(&self) -> Result<Box<dyn UnitOfWorkProveedor>, ErrorRepositorio> {
        let tx = TransaccionPostgres::begin(&self.pool).await?;
        Ok(Box::new(UnitOfWorkProveedorPostgres { tx }))
    }
}

struct UnitOfWorkProveedorPostgres {
    tx: TransaccionPostgres,
}

#[async_trait]
impl UnitOfWorkProveedor for UnitOfWorkProveedorPostgres {
    async fn guardar(&mut self, entidad: &Proveedor) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaProveedor::from(entidad);
        sqlx::query!(
            "INSERT INTO proveedores (id, creado_en, actualizado_en, borrado, borrado_en, name, email)
             VALUES ($1, $2, $3, $4, $5, $6, $7)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, name = $6, email = $7",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.name,
            db.email,
        )
        .execute(self.tx.tx())
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx(&e)
        })?;
        Ok(())
    }

    async fn registrar(&mut self, evento: EventoProveedor) -> Result<(), ErrorRepositorio> {
        self.tx.registrar(&evento).await
    }

    async fn commit(self: Box<Self>) -> Result<(), ErrorRepositorio> {
        self.tx.commit().await
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use dominio_proveedor::{eventos::SnapshotProveedor, repositorio::RepositorioProveedor};

    use crate::pruebas::siembra::construir;
    use crate::repositorio::RepositorioProveedorPostgres;

    /// Lo que hace un caso de uso de creación: guardar, registrar, commit.
    async fn crear(pool: &PgPool, entidad: &Proveedor) -> Result<(), ErrorRepositorio> {
        let mut uow = UnitOfWorkFactoryProveedorPostgres::new(pool.clone())
            .begin()
            .await?;
        uow.guardar(entidad).await?;
        uow.registrar(EventoProveedor::Creado(SnapshotProveedor::from_entidad(
            entidad,
        )))
        .await?;
        uow.commit().await
    }

    async fn contar(pool: &PgPool, sql: &str) -> i64 {
        sqlx::query_scalar(sql).fetch_one(pool).await.unwrap()
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_escribir_proveedor_y_su_evento_cuando_hace_commit(pool: PgPool) {
        // Preparar
        let entidad = construir();

        // Actuar
        crear(&pool, &entidad).await.unwrap();

        // Comprobar
        let encontrado = RepositorioProveedorPostgres::new(pool.clone())
            .buscar_por_id(entidad.id)
            .await
            .unwrap();
        assert!(encontrado.is_some());
        let (tipo_evento, id_agregado): (String, uuid::Uuid) =
            sqlx::query_as("SELECT tipo_evento, id_agregado FROM outbox")
                .fetch_one(&pool)
                .await
                .unwrap();
        assert_eq!(tipo_evento, "proveedor_creado");
        assert_eq!(id_agregado, entidad.id.valor());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn no_deberia_escribir_nada_cuando_se_libera_sin_commit(pool: PgPool) {
        // Preparar
        let entidad = construir();

        // Actuar
        {
            let mut uow = UnitOfWorkFactoryProveedorPostgres::new(pool.clone())
                .begin()
                .await
                .unwrap();
            uow.guardar(&entidad).await.unwrap();
            uow.registrar(EventoProveedor::Creado(SnapshotProveedor::from_entidad(
                &entidad,
            )))
            .await
            .unwrap();
        }

        // Comprobar
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM proveedores").await, 0);
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_proveedor_cuando_se_guarda_de_nuevo(pool: PgPool) {
        // Preparar
        let mut entidad = construir();
        crear(&pool, &entidad).await.unwrap();
        entidad.email = "updated".to_string();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        let mut uow = UnitOfWorkFactoryProveedorPostgres::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.guardar(&entidad).await.unwrap();
        uow.commit().await.unwrap();

        // Comprobar
        let encontrado = RepositorioProveedorPostgres::new(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(encontrado.email, "updated");
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn no_deberia_escribir_fila_ni_evento_cuando_email_ya_esta_en_uso(pool: PgPool) {
        // Preparar
        let primero = construir();
        crear(&pool, &primero).await.unwrap();
        let mut segundo = construir();
        segundo.email = primero.email.clone();

        // Actuar
        let resultado = crear(&pool, &segundo).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::Duplicado);
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM proveedores").await, 1);
        assert_eq!(contar(&pool, "SELECT COUNT(*) FROM outbox").await, 1);
    }
}

