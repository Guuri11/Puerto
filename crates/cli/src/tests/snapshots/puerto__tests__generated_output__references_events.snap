# contextos que referencian a este (ADR-0023 § 5 de Puerto).
pruebas = ["dominio_entrega/pruebas", "dep:infra_compra", "infra_compra/pruebas", "dep:infra_proveedor", "infra_proveedor/pruebas"]

[dev-dependencies]
