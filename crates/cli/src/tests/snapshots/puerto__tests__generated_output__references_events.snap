=== business/src/domain/supplier/value_objects.rs ===
use super::errors::SupplierError;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    value: String,
}

impl Name {
    pub fn new(value: String) -> Result<Self, SupplierError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(SupplierError::InvalidName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

