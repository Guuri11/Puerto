use async_trait::async_trait;
use dominio_proveedor::errores::ErrorProveedor;
use dominio_proveedor::eventos::{EventoProveedor, SnapshotProveedor};
use dominio_proveedor::modelo::{IdProveedor, PropsProveedor, Proveedor};
use dominio_proveedor::repositorio::RepositorioProveedor;
use dominio_proveedor::unit_of_work::UnitOfWorkFactoryProveedor;
use dominio_proveedor::valores::Name;
use puerto_nucleo::ErrorRepositorio;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsActualizarProveedor {
    pub id: IdProveedor,
    pub name: String,
    pub email: String,
}

#[async_trait]
pub trait ActualizarProveedor: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsActualizarProveedor,
    ) -> Result<Proveedor, ErrorProveedor>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarProveedor {}

        #[async_trait]
        impl ActualizarProveedor for ActualizarProveedor {
            async fn ejecutar(&self, params: ParamsActualizarProveedor) -> Result<Proveedor, ErrorProveedor>;
        }
    }
}

pub struct ActualizarProveedorImpl {
    pub repositorio: Arc<dyn RepositorioProveedor>,
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProveedor>,
}

#[async_trait]
impl ActualizarProveedor for ActualizarProveedorImpl {
    async fn ejecutar(
        &self,
        params: ParamsActualizarProveedor,
    ) -> Result<Proveedor, ErrorProveedor> {
        tracing::info!(id = %params.id, "actualizar_proveedor: inicio");
        let fallido = |e: &ErrorRepositorio| tracing::error!(error = %e, "actualizar_proveedor: fallo del repositorio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(fallido)?
            .ok_or_else(|| {
                let err = ErrorProveedor::NoEncontrado;
                tracing::warn!(error = %err, "actualizar_proveedor: rechazado");
                err
            })?;
        let name = Name::new(params.name)?;
        entidad
            .actualizar(PropsProveedor {
                name,
                email: params.email,
            })
            .inspect_err(|e| tracing::warn!(error = %e, "actualizar_proveedor: rechazado"))?;
        let mut uow = self.uow_factory.begin().await.inspect_err(fallido)?;
        uow.guardar(&entidad).await.inspect_err(fallido)?;
        uow.registrar(EventoProveedor::Actualizado(
            SnapshotProveedor::from_entidad(&entidad),
        ))
        .await
        .inspect_err(fallido)?;
        uow.commit().await.inspect_err(fallido)?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_proveedor::{
        modelo::IdProveedor, pruebas::madres::MadreProveedor,
        repositorio::dobles::MockRepositorioProveedor,
        unit_of_work::dobles::UnitOfWorkFactoryGrabadora,
    };
    use puerto_nucleo::EventoDominio;

    fn repositorio_con(entidad: Proveedor) -> MockRepositorioProveedor {
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble
    }

    #[tokio::test]
    async fn deberia_registrar_el_evento_proveedor_actualizado_cuando_los_parametros_son_validos() {
        // Preparar
        let props = MadreProveedor::new().construir_props();
        let mut entidad = MadreProveedor::aleatorio();
        // Lo que estaba guardado, distinto de lo que trae la actualización.
        entidad.email = "original".to_string();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProveedorImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProveedor {
                id: id_entidad,
                name: props.name.valor().to_string(),
                email: props.email,
            })
            .await;

        // Comprobar
        assert_eq!(
            resultado.unwrap().email,
            MadreProveedor::new().construir_props().email
        );
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "proveedor_actualizado");
        assert_eq!(grabado.eventos[0].id_agregado(), id_entidad.valor());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_sin_registrar_nada_cuando_proveedor_no_existe() {
        // Preparar
        let props = MadreProveedor::new().construir_props();
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProveedorImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProveedor {
                id: IdProveedor::generar(),
                name: props.name.valor().to_string(),
                email: props.email,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.no_encontrado"
        );
        let grabado = uow_factory.grabado();
        assert!(grabado.guardados.is_empty());
        assert!(grabado.eventos.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_email_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProveedor::new().construir_props();
        let entidad = MadreProveedor::aleatorio();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProveedorImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProveedor {
                id: id_entidad,
                name: props.name.valor().to_string(),
                email: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.validacion.email_vacio"
        );
        assert!(uow_factory.grabado().guardados.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_name_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProveedor::new().construir_props();
        let entidad = MadreProveedor::aleatorio();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarProveedorImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProveedor {
                id: id_entidad,
                name: "".to_string(),
                email: props.email,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.name_invalido"
        );
        assert!(uow_factory.grabado().guardados.is_empty());
    }
}

