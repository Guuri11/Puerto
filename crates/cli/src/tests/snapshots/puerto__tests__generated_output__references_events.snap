use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{Compra, IdCompra};
use dominio_proveedor::modelo::IdProveedor;

/// A qué reduce `buscar_todos` la página: un id por referencia; `None` no filtra.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct FiltroCompra {
    pub proveedor_id: Option<IdProveedor>,
    pub approver_id: Option<IdProveedor>,
}

#[async_trait]
pub trait RepositorioCompra: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroCompra,
    ) -> Result<Pagina<Compra>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdCompra) -> Result<Option<Compra>, ErrorRepositorio>;
    // Sin `guardar`: las escrituras pasan por `UnitOfWorkFactoryCompra`, que registra sus
    // eventos.
}

#[cfg(any(test, feature = "pruebas"))]
