use async_trait::async_trait;
use dominio_compra::errores::ErrorCompra;
use dominio_compra::modelo::{Compra, IdCompra};
use dominio_compra::repositorio::RepositorioCompra;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerCompra {
    pub id: IdCompra,
}

#[async_trait]
pub trait ObtenerCompra: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerCompra) -> Result<Compra, ErrorCompra>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerCompra {}

        #[async_trait]
        impl ObtenerCompra for ObtenerCompra {
            async fn ejecutar(&self, params: ParamsObtenerCompra) -> Result<Compra, ErrorCompra>;
        }
    }
}

pub struct ObtenerCompraImpl {
    pub repositorio: Arc<dyn RepositorioCompra>,
}

#[async_trait]
impl ObtenerCompra for ObtenerCompraImpl {
    async fn ejecutar(&self, params: ParamsObtenerCompra) -> Result<Compra, ErrorCompra> {
        tracing::info!(id = %params.id, "obtener_compra: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_compra: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorCompra::NoEncontrado;
            tracing::warn!(error = %err, "obtener_compra: rechazado");
            err
        })
    }
}

