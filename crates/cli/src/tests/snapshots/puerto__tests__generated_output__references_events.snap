}

=== web/src/domain/supplier/errors.ts ===
/**
 * A request about a supplier that the API refused. `code` is the API's `ErrorResponse.name`:
 * `supplier.not_found`, `supplier.validation_error.<field>_empty`.
 */
export class SupplierError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "SupplierError";
    this.code = code;
  }
}

=== web/src/domain/supplier/messages.ts ===
import type { SupplierDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface SupplierProblem {
  field: keyof SupplierDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "supplier.invalid_name": "Name is not valid",
  "supplier.validation_error.email_empty": "Email is required",
  "supplier.duplicate": "A supplier with these values already exists",
  "supplier.not_found": "This supplier no longer exists",
  "supplier.repository_error": "The supplier could not be saved, try again later",
  "supplier.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof SupplierDraft> = {
  "supplier.invalid_name": "name",
  "supplier.validation_error.email_empty": "email",
};

export function toProblem(code: string): SupplierProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

