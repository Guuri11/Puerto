use async_trait::async_trait;
use dominio_proveedor::errores::ErrorProveedor;
use dominio_proveedor::modelo::{IdProveedor, Proveedor};
use dominio_proveedor::repositorio::RepositorioProveedor;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerProveedor {
    pub id: IdProveedor,
}

#[async_trait]
pub trait ObtenerProveedor: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerProveedor) -> Result<Proveedor, ErrorProveedor>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerProveedor {}

        #[async_trait]
        impl ObtenerProveedor for ObtenerProveedor {
            async fn ejecutar(&self, params: ParamsObtenerProveedor) -> Result<Proveedor, ErrorProveedor>;
        }
    }
}

pub struct ObtenerProveedorImpl {
    pub repositorio: Arc<dyn RepositorioProveedor>,
}

#[async_trait]
impl ObtenerProveedor for ObtenerProveedorImpl {
    async fn ejecutar(&self, params: ParamsObtenerProveedor) -> Result<Proveedor, ErrorProveedor> {
        tracing::info!(id = %params.id, "obtener_proveedor: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_proveedor: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorProveedor::NoEncontrado;
            tracing::warn!(error = %err, "obtener_proveedor: rechazado");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_proveedor::valores::Name;
    use dominio_proveedor::{
        modelo::{IdProveedor, PropsProveedor, Proveedor},
        repositorio::dobles::MockRepositorioProveedor,
    };
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_devolver_proveedor_cuando_el_id_existe() {
        let entidad = Proveedor::new(PropsProveedor {
            name: Name::new("example".to_string()).expect("el literal de Name es válido"),
            email: "example".to_string(),
        })
        .unwrap();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ObtenerProveedorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerProveedor { id: id_entidad })
            .await;

        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().email, "example");
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_el_id_no_existe() {
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ObtenerProveedorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerProveedor {
                id: IdProveedor::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "proveedor.no_encontrado"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_el_almacen_no_esta_disponible() {
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Err(ErrorRepositorio::NoDisponible));
        let caso_de_uso = ObtenerProveedorImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerProveedor {
                id: IdProveedor::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "proveedor.repositorio");
    }
}

