import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { SupplierError } from "../../../../domain/supplier/errors";
import type { SupplierDraft } from "../../../../domain/supplier/model";
import { renderScreen } from "../../../../test-support/render";
import { fakeSupplierRepository, SupplierMother } from "../../../../test-support/supplier";
import { SupplierFormContainer } from "./supplier-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: SupplierDraft) {
  await screen.findByText("Save");
  type("Name", draft.name);
  type("Email", draft.email);
}

describe("SupplierFormContainer", () => {
  test("should create the supplier from what was typed and show it", async () => {
    // Arrange
    const draft = SupplierMother.draft();
    const supplierRepository = fakeSupplierRepository();
    const { history } = renderScreen(<SupplierFormContainer />, { supplierRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/suppliers/"));
    const {
      items: [created],
    } = await supplierRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/suppliers/${created?.id}`);
  });

  test("should save the edited supplier when an existing one is submitted", async () => {
    // Arrange
    const seeded = SupplierMother.random();
    const supplierRepository = fakeSupplierRepository([seeded]);
    const { history } = renderScreen(<SupplierFormContainer id={seeded.id} />, {
      supplierRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/suppliers/${seeded.id}`));
    expect(await supplierRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "supplier.validation_error.invalid";
    const supplierRepository = {
      ...fakeSupplierRepository(),
      create: () => Promise.reject(new SupplierError(code)),
    };
    renderScreen(<SupplierFormContainer />, { supplierRepository });
    await fillIn(SupplierMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a supplier with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const supplierRepository = {
      ...fakeSupplierRepository(),
      create: () => Promise.reject(new SupplierError("supplier.duplicate")),
    };
    renderScreen(<SupplierFormContainer />, { supplierRepository });
    await fillIn(SupplierMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A supplier with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const supplierRepository = {
      ...fakeSupplierRepository(),
      create: () => Promise.reject(new SupplierError("supplier.invalid_name")),
    };
    renderScreen(<SupplierFormContainer />, { supplierRepository });
    await fillIn(SupplierMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Name is not valid")).toBeTruthy();
    const input = screen.getByLabelText("Name");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

