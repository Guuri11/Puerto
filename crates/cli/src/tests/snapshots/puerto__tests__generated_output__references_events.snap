use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::purchase::{
    errors::PurchaseError,
    events::{PurchaseEvent, PurchaseSnapshot},
    model::Purchase,
    repository::PurchaseRepositoryTrait,
    unit_of_work::PurchaseUnitOfWorkFactory,
    use_cases::update_purchase::{UpdatePurchaseParams, UpdatePurchaseUseCaseTrait},
};

pub struct UpdatePurchaseUseCaseImpl {
    pub repository: Arc<dyn PurchaseRepositoryTrait>,
    pub uow_factory: Arc<dyn PurchaseUnitOfWorkFactory>,
}

#[async_trait]
impl UpdatePurchaseUseCaseTrait for UpdatePurchaseUseCaseImpl {
    async fn execute(&self, params: UpdatePurchaseParams) -> Result<Purchase, PurchaseError> {
        tracing::info!(id = %params.id, "update_purchase: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "update_purchase: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = PurchaseError::NotFound;
                tracing::warn!(error = %err, "update_purchase: rejected");
                err
            })?;
        entity.supplier_id = params.supplier_id;
        entity.approver_id = params.approver_id;
        entity.total = params.total;
        entity.updated_at = chrono::Utc::now();
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(PurchaseEvent::Updated(PurchaseSnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(entity)
    }
}

