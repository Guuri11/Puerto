import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { PurchaseError } from "../../../../domain/purchase/errors";
import type { PurchaseDraft } from "../../../../domain/purchase/model";
import { fakePurchaseRepository, PurchaseMother } from "../../../../test-support/purchase";
import { renderScreen } from "../../../../test-support/render";
import { fakeSupplierRepository, SupplierMother } from "../../../../test-support/supplier";
import { textOf } from "../../../shared/forms";
import { PurchaseFormContainer } from "./purchase-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: PurchaseDraft) {
  return {
    supplierRepository: fakeSupplierRepository([
      SupplierMother.random({ id: draft.supplierId }),
      SupplierMother.random({ id: draft.approverId ?? crypto.randomUUID() }),
    ]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: PurchaseDraft) {
  await screen.findByText("Save");
  await choose("Supplier", draft.supplierId);
  await choose("Approver", textOf(draft.approverId));
  type("Total", String(draft.total));
}

describe("PurchaseFormContainer", () => {
  test("should create the purchase from what was typed and show it", async () => {
    // Arrange
    const draft = PurchaseMother.draft();
    const purchaseRepository = fakePurchaseRepository();
    const { history } = renderScreen(<PurchaseFormContainer />, {
      purchaseRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/purchases/"));
    const {
      items: [created],
    } = await purchaseRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/purchases/${created?.id}`);
  });

  test("should save the edited purchase when an existing one is submitted", async () => {
    // Arrange
    const seeded = PurchaseMother.random();
    const purchaseRepository = fakePurchaseRepository([seeded]);
    const { history } = renderScreen(<PurchaseFormContainer id={seeded.id} />, {
      purchaseRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/purchases/${seeded.id}`));
    expect(await purchaseRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "purchase.validation_error.invalid";
    const purchaseRepository = {
      ...fakePurchaseRepository(),
      create: () => Promise.reject(new PurchaseError(code)),
    };
    const draft = PurchaseMother.draft();
    renderScreen(<PurchaseFormContainer />, {
      purchaseRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a purchase with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const purchaseRepository = {
      ...fakePurchaseRepository(),
      create: () => Promise.reject(new PurchaseError("purchase.duplicate")),
    };
    const draft = PurchaseMother.draft();
    renderScreen(<PurchaseFormContainer />, {
      purchaseRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A purchase with these values already exists",
    );
  });

  test("should offer every supplier in the selects that reference one", async () => {
    // Arrange
    const supplier = SupplierMother.random();

    // Act
    renderScreen(<PurchaseFormContainer />, {
      purchaseRepository: fakePurchaseRepository(),
      supplierRepository: fakeSupplierRepository([supplier]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: supplier.name });
    expect(options).toHaveLength(2);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const purchaseRepository = {
      ...fakePurchaseRepository(),
      create: () =>
        Promise.reject(new PurchaseError("purchase.validation_error.supplier_id_not_found")),
    };
    const draft = PurchaseMother.draft();
    renderScreen(<PurchaseFormContainer />, {
      purchaseRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Supplier does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Supplier");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/purchase/containers/purchase-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/purchase/messages";
import type { Purchase } from "../../../../domain/purchase/model";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { PurchaseFormView, toPurchaseDraft, toPurchaseForm } from "../views/purchase-form-view";

/** Creates a purchase, or edits the one with `id`. */
export function PurchaseFormContainer({ id }: { id?: string }) {
  const { purchaseRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : purchaseRepository.get(id)),
    [purchaseRepository, id],
  );
  const title = id === undefined ? "New purchase" : "Edit purchase";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <PurchaseForm existing={existing.data} />}
      <Link href={id === undefined ? "/purchases" : `/purchases/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function PurchaseForm({ existing }: { existing: Purchase | null }) {
  const { purchaseRepository, supplierRepository } = useDependencies();
  const suppliers = useAsync(
    () => supplierRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [supplierRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toPurchaseForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toPurchaseDraft(values);
      const saved =
        existing === null
          ? await purchaseRepository.create(draft)
          : await purchaseRepository.update(existing.id, draft);
      navigate(`/purchases/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {suppliers.status === "error" && <ErrorAlert error={suppliers.error} />}
        <PurchaseFormView
          values={values}
          options={{
            supplierId: referenceOptions(suppliers, (supplier) => supplier.name),
            approverId: referenceOptions(suppliers, (supplier) => supplier.name),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

