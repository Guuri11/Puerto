import type { Esquemas } from "../../../api/cliente";
import { EnlaceReferencia } from "../../../compartido/ui/enlace-referencia";

type Entrega = Esquemas["DtoEntrega"];

/** `entrega`, y cómo se cargan las etiquetas de lo que referencia, para sus enlaces. */
export function VistaDetalleEntrega({
  entrega,
  etiquetaCompra,
  etiquetaProveedor,
}: {
  entrega: Entrega;
  etiquetaCompra: (id: string) => Promise<string>;
  etiquetaProveedor: (id: string) => Promise<string>;
}) {
  return (
    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
      <dt className="font-semibold">Compra</dt>
      <dd>
        <EnlaceReferencia ruta="/compras" id={entrega.compraId} cargar={etiquetaCompra} />
      </dd>
      <dt className="font-semibold">Destinatario</dt>
      <dd>
        <EnlaceReferencia
          ruta="/proveedores"
          id={entrega.destinatarioId}
          cargar={etiquetaProveedor}
        />
      </dd>
      <dt className="font-semibold">Carrier</dt>
      <dd>{entrega.carrier}</dd>
    </dl>
  );
}

=== web/src/contextos/entrega/vistas/formulario-entrega.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { type OpcionReferencia, textoDe, textoOpcional } from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaEntrega } from "../mensajes";

type Entrega = Esquemas["DtoEntrega"];
type PeticionEntrega = Esquemas["PeticionCrearEntrega"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioEntrega {
  compraId: string;
  destinatarioId: string;
  carrier: string;
}

/** Los inputs de `entrega`, vacíos cuando todavía no hay ninguno. */
export function aFormularioEntrega(entrega: Entrega | null): ValoresFormularioEntrega {
  if (entrega === null) {
    return {
      compraId: "",
      destinatarioId: "",
      carrier: "",
    };
  }
  return {
    compraId: entrega.compraId,
    destinatarioId: textoDe(entrega.destinatarioId),
    carrier: entrega.carrier,
  };
}

/** Lo que ofrece el select de cada referencia. */
export interface OpcionesFormularioEntrega {
  compraId: OpcionReferencia[];
  destinatarioId: OpcionReferencia[];
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionEntrega(valores: ValoresFormularioEntrega): PeticionEntrega {
  return {
    compraId: valores.compraId,
    destinatarioId: textoOpcional(valores.destinatarioId),
    carrier: valores.carrier,
  };
}

export function VistaFormularioEntrega({
  valores,
  opciones,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioEntrega;
  opciones: OpcionesFormularioEntrega;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaEntrega | null;
  alCambiar: (valores: ValoresFormularioEntrega) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Compra</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "compraId"}
          required
          value={valores.compraId}
          onChange={(event) => alCambiar({ ...valores, compraId: event.target.value })}
        >
          <option value="">Elige una opción</option>
          {opciones.compraId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="compraId" />
      <label className="fieldset">
        <span className="fieldset-legend">Destinatario</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "destinatarioId"}
          value={valores.destinatarioId}
          onChange={(event) => alCambiar({ ...valores, destinatarioId: event.target.value })}
        >
          <option value="">—</option>
          {opciones.destinatarioId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="destinatarioId" />
      <label className="fieldset">
        <span className="fieldset-legend">Carrier</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "carrier"}
          required
          value={valores.carrier}
          onChange={(event) => alCambiar({ ...valores, carrier: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="carrier" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

