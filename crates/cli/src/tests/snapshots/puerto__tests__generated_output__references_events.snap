=== contextos/compra/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorCompra {
    #[error("compra.validacion.{0}")]
    Validacion(String),
    #[error("compra.no_encontrado")]
    NoEncontrado,
    #[error("compra.duplicado")]
    Duplicado,
    #[error("compra.repositorio")]
    Repositorio,
    #[error("compra.desconocido")]
    Desconocido,
}

impl From<ErrorRepositorio> for ErrorCompra {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            // Una referencia nombra una fila inexistente: la entrada de quien llama, en ese campo.
            ErrorRepositorio::ReferenciaInexistente(campo) => {
                Self::Validacion(format!("{campo}_no_encontrado"))
            }
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorCompra::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "compra.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorCompra::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "compra.repositorio");
    }

    #[test]
    fn deberia_convertir_una_referencia_inexistente_en_una_validacion_de_su_campo() {
        let err = ErrorCompra::from(ErrorRepositorio::ReferenciaInexistente("proveedor_id"));
        assert_eq!(
            err.to_string(),
            "compra.validacion.proveedor_id_no_encontrado"
        );
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorCompra::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "compra.repositorio");
    }
}

=== contextos/compra/dominio/src/eventos.rs ===
// GENERADO por puerto desde puerto.toml — no lo edites a mano. El snapshot sigue los campos de la
// entidad; añade un evento con `puerto generar evento Compra <nombre>`.
use puerto_nucleo::EventoDominio;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use crate::modelo::Compra;

pub const COMPRA_CREADO: &str = "compra_creado";
pub const COMPRA_ACTUALIZADO: &str = "compra_actualizado";
pub const COMPRA_BORRADO: &str = "compra_borrado";

/// Lo que lleva cada evento de compra: sus datos tal como los muestra la API — primitivos, con
/// los objetos valor desenvueltos. Un contrato público: los consumidores lo decodifican con
/// `evento.decodificar::<SnapshotCompra>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct SnapshotCompra {
    pub id: Uuid,
    pub proveedor_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

impl SnapshotCompra {
    pub fn from_entidad(entidad: &Compra) -> Self {
        Self {
            id: entidad.id.valor(),
            proveedor_id: entidad.proveedor_id.valor(),
            approver_id: entidad.approver_id.map(|v| v.valor()),
            total: entidad.total,
        }
    }
}

/// Lo que le pasa a cada compra. Sus casos de uso de escritura registran uno con su unidad de
/// trabajo.
#[derive(Debug, Clone, PartialEq)]
pub enum EventoCompra {
    Creado(SnapshotCompra),
    Actualizado(SnapshotCompra),
    Borrado(SnapshotCompra),
}

impl EventoCompra {
    pub fn snapshot(&self) -> &SnapshotCompra {
        match self {
            Self::Creado(snapshot) | Self::Actualizado(snapshot) | Self::Borrado(snapshot) => {
                snapshot
            }
        }
    }
}

impl EventoDominio for EventoCompra {
    fn tipo_evento(&self) -> &'static str {
        match self {
            Self::Creado(_) => COMPRA_CREADO,
            Self::Actualizado(_) => COMPRA_ACTUALIZADO,
            Self::Borrado(_) => COMPRA_BORRADO,
        }
    }

    fn tipo_agregado(&self) -> &'static str {
        "compra"
    }

    fn id_agregado(&self) -> Uuid {
        self.snapshot().id
    }

    fn version_esquema(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // Un snapshot solo tiene primitivos: serializarlo no puede fallar.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreCompra;

    #[test]
    fn deberia_describir_cada_evento_cuando_se_registra() {
        // Preparar
        let entidad = MadreCompra::aleatorio();
        let snapshot = SnapshotCompra::from_entidad(&entidad);
        let eventos = [
            (EventoCompra::Creado(snapshot.clone()), "compra_creado"),
            (
                EventoCompra::Actualizado(snapshot.clone()),
                "compra_actualizado",
            ),
            (EventoCompra::Borrado(snapshot.clone()), "compra_borrado"),
        ];

        for (evento, tipo_evento) in eventos {
            // Actuar y comprobar
            assert_eq!(evento.tipo_evento(), tipo_evento);
            assert_eq!(evento.tipo_agregado(), "compra");
            assert_eq!(evento.id_agregado(), entidad.id.valor());
            assert_eq!(evento.version_esquema(), 1);
            assert_eq!(evento.snapshot(), &snapshot);
        }
    }

    #[test]
    fn deberia_mantener_el_contrato_json_cuando_se_serializa_el_snapshot() {
        // Preparar
        let snapshot = SnapshotCompra::from_entidad(&MadreCompra::aleatorio());

        // Actuar
        let payload = EventoCompra::Creado(snapshot.clone()).payload();

        // Comprobar — una clave renombrada o quitada rompe a cada consumidor de estos eventos.
        let mut claves: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        claves.sort_unstable();
        assert_eq!(claves, ["approverId", "id", "proveedorId", "total"]);
        assert_eq!(
            serde_json::from_value::<SnapshotCompra>(payload).ok(),
            Some(snapshot)
        );
    }
}

