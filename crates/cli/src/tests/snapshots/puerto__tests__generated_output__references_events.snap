use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{Entrega, IdEntrega};
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;

/// A qué reduce `buscar_todos` la página: un id por referencia; `None` no filtra.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct FiltroEntrega {
    pub compra_id: Option<IdCompra>,
    pub destinatario_id: Option<IdProveedor>,
}

#[async_trait]
pub trait RepositorioEntrega: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroEntrega,
    ) -> Result<Pagina<Entrega>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdEntrega) -> Result<Option<Entrega>, ErrorRepositorio>;
    // Sin `guardar`: las escrituras pasan por `UnitOfWorkFactoryEntrega`, que registra sus
    // eventos.
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub RepositorioEntrega {}

        #[async_trait]
        impl RepositorioEntrega for RepositorioEntrega {
            async fn buscar_todos(&self, pagina: PeticionPagina, filtro: FiltroEntrega) -> Result<Pagina<Entrega>, ErrorRepositorio>;
            async fn buscar_por_id(&self, id: IdEntrega) -> Result<Option<Entrega>, ErrorRepositorio>;
        }
    }
}

=== contextos/entrega/dominio/src/unit_of_work.rs ===
use async_trait::async_trait;
use puerto_nucleo::ErrorRepositorio;

use crate::{eventos::EventoEntrega, modelo::Entrega};

/// Una transacción de entrega (ADR-0018 § 2): lo que guarda y los eventos que registra se
/// escriben juntos en el `commit`, o no se escriben. Soltarla sin `commit` la deshace, así que un
/// `?` temprano es el rollback.
#[async_trait]
pub trait UnitOfWorkEntrega: Send {
    async fn guardar(&mut self, entidad: &Entrega) -> Result<(), ErrorRepositorio>;
    async fn registrar(&mut self, evento: EventoEntrega) -> Result<(), ErrorRepositorio>;
    async fn commit(self: Box<Self>) -> Result<(), ErrorRepositorio>;
}

/// Abre una [`UnitOfWorkEntrega`]: por donde pasa toda escritura de entrega. El
/// repositorio solo lee, así que una escritura que se salte el outbox no compila.
#[async_trait]
pub trait UnitOfWorkFactoryEntrega: Send + Sync {
    async fn begin(&self) -> Result<Box<dyn UnitOfWorkEntrega>, ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use std::sync::{Arc, Mutex, MutexGuard};

    use super::*;

    /// Dónde falla una [`UnitOfWorkFactoryGrabadora`], si se le ha indicado.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum FallarEn {
        Begin,
        Guardar,
        Commit,
    }

    /// Lo que se pidió a las unidades de trabajo de una [`UnitOfWorkFactoryGrabadora`].
    #[derive(Debug, Clone, Default)]
    pub struct Grabado {
        pub guardados: Vec<Entrega>,
        pub eventos: Vec<EventoEntrega>,
        pub confirmado: bool,
    }

    /// Un `UnitOfWorkFactoryEntrega` falso para los tests de casos de uso: sus unidades de
    /// trabajo apuntan lo que guardan y registran y si hicieron `commit`, y fallan donde se les
    /// haya indicado.
    #[derive(Clone, Default)]
    pub struct UnitOfWorkFactoryGrabadora {
        grabado: Arc<Mutex<Grabado>>,
        fallo: Option<(FallarEn, ErrorRepositorio)>,
    }

    impl UnitOfWorkFactoryGrabadora {
        pub fn new() -> Self {
            Self::default()
        }

        pub fn fallando_en(punto: FallarEn, error: ErrorRepositorio) -> Self {
            Self {
                fallo: Some((punto, error)),
                ..Self::default()
            }
        }

        pub fn grabado(&self) -> Grabado {
            lock(&self.grabado).clone()
        }

        fn fallar_en(&self, punto: FallarEn) -> Result<(), ErrorRepositorio> {
            match self.fallo {
                Some((fallido, error)) if fallido == punto => Err(error),
                _ => Ok(()),
            }
        }
    }

    fn lock(grabado: &Mutex<Grabado>) -> MutexGuard<'_, Grabado> {
        grabado
            .lock()
            .unwrap_or_else(|envenenado| envenenado.into_inner())
    }

    struct UnitOfWorkGrabadora {
        factory: UnitOfWorkFactoryGrabadora,
    }

    #[async_trait]
    impl UnitOfWorkEntrega for UnitOfWorkGrabadora {
        async fn guardar(&mut self, entidad: &Entrega) -> Result<(), ErrorRepositorio> {
            self.factory.fallar_en(FallarEn::Guardar)?;
            lock(&self.factory.grabado).guardados.push(entidad.clone());
            Ok(())
        }

        async fn registrar(&mut self, evento: EventoEntrega) -> Result<(), ErrorRepositorio> {
            lock(&self.factory.grabado).eventos.push(evento);
            Ok(())
        }

        async fn commit(self: Box<Self>) -> Result<(), ErrorRepositorio> {
            self.factory.fallar_en(FallarEn::Commit)?;
            lock(&self.factory.grabado).confirmado = true;
            Ok(())
        }
    }

    #[async_trait]
    impl UnitOfWorkFactoryEntrega for UnitOfWorkFactoryGrabadora {
        async fn begin(&self) -> Result<Box<dyn UnitOfWorkEntrega>, ErrorRepositorio> {
            self.fallar_en(FallarEn::Begin)?;
            Ok(Box::new(UnitOfWorkGrabadora {
                factory: self.clone(),
            }))
        }
    }
}

