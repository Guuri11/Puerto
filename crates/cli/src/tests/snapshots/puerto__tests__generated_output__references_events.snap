use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::supplier::{
    model::{Supplier, SupplierId},
    repository::SupplierRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

use super::entity::SupplierDb;
use crate::db::map_sqlx_error;

pub struct PgSupplierRepository {
    pub pool: PgPool,
}

impl PgSupplierRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: SupplierDb) -> Result<Supplier, RepositoryError> {
    Supplier::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid supplier");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl SupplierRepositoryTrait for PgSupplierRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Supplier>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = sqlx::query_as!(
            SupplierDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, name, email
             FROM suppliers WHERE deleted = false
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limit()),
            i64::from(page.offset())
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM suppliers WHERE deleted = false"#
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            map_sqlx_error(&e)
        })?;

        let items = rows
            .into_iter()
            .map(to_domain)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: SupplierId) -> Result<Option<Supplier>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            SupplierDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, name, email
             FROM suppliers WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }
}

/// `pub(crate)`: an entity that references Supplier seeds its rows with this module's `seed`.
#[cfg(test)]
pub(crate) mod integration_tests {
    use super::*;
    use business::domain::supplier::model::SupplierProps;
    use business::domain::supplier::unit_of_work::SupplierUnitOfWorkFactory;

    use crate::supplier::unit_of_work::PgSupplierUnitOfWorkFactory;

    use business::domain::supplier::value_objects::Name;
    use uuid::Uuid;

    fn test_repo(pool: PgPool) -> PgSupplierRepository {
        PgSupplierRepository::new(pool)
    }

    /// The repository only reads: rows are written through the unit of work.
    async fn store(pool: &PgPool, entity: &Supplier) {
        let mut uow = PgSupplierUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.save(entity).await.unwrap();
        uow.commit().await.unwrap();
    }

    /// A valid supplier, not stored.
    fn build() -> Supplier {
        Supplier::new(SupplierProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            email: Uuid::new_v4().to_string(),
        })
        .unwrap()
    }

    /// A stored supplier.
    pub(crate) async fn seed(pool: &PgPool) -> Supplier {
        let entity = build();
        store(pool, &entity).await;
        entity
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.name, entity.name);
        assert_eq!(found.email, entity.email);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool)
            .find_by_id(SupplierId::generate())
            .await
            .unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_suppliers_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        store(&pool, &deleted).await;

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }
}

=== infrastructure/src/supplier/unit_of_work.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::supplier::{
    events::SupplierEvent,
    model::Supplier,
    unit_of_work::{SupplierUnitOfWork, SupplierUnitOfWorkFactory},
};
use puerto_core::RepositoryError;
use puerto_sqlx::uow::PgTransaction;

use super::entity::SupplierDb;
use crate::db::map_sqlx_error;

/// Opens a Postgres transaction per write: the supplier row and its outbox event commit together.
pub struct PgSupplierUnitOfWorkFactory {
    pub pool: PgPool,
}

impl PgSupplierUnitOfWorkFactory {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl SupplierUnitOfWorkFactory for PgSupplierUnitOfWorkFactory {
    async fn begin(&self) -> Result<Box<dyn SupplierUnitOfWork>, RepositoryError> {
        let tx = PgTransaction::begin(&self.pool).await?;
        Ok(Box::new(PgSupplierUnitOfWork { tx }))
    }
}

struct PgSupplierUnitOfWork {
    tx: PgTransaction,
}

#[async_trait]
impl SupplierUnitOfWork for PgSupplierUnitOfWork {
    async fn save(&mut self, entity: &Supplier) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = SupplierDb::from(entity);
        sqlx::query!(
            "INSERT INTO suppliers (id, created_at, updated_at, deleted, deleted_at, name, email)
             VALUES ($1, $2, $3, $4, $5, $6, $7)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, name = $6, email = $7",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.name,
            db.email,
        )
        .execute(self.tx.tx())
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error(&e)
        })?;
        Ok(())
    }

    async fn record(&mut self, event: SupplierEvent) -> Result<(), RepositoryError> {
        self.tx.record(&event).await
    }

    async fn commit(self: Box<Self>) -> Result<(), RepositoryError> {
        self.tx.commit().await
    }
}

#[cfg(test)]
mod integration_tests {
    use super::*;
    use business::domain::supplier::{
        events::SupplierSnapshot, model::SupplierProps, repository::SupplierRepositoryTrait,
    };

    use crate::supplier::repository::PgSupplierRepository;
    use business::domain::supplier::value_objects::Name;
    use uuid::Uuid;

    fn new_supplier() -> Supplier {
        Supplier::new(SupplierProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            email: Uuid::new_v4().to_string(),
        })
        .unwrap()
    }

    /// What a create use case does: save, record, commit.
    async fn create(pool: &PgPool, entity: &Supplier) -> Result<(), RepositoryError> {
        let mut uow = PgSupplierUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await?;
        uow.save(entity).await?;
        uow.record(SupplierEvent::Created(SupplierSnapshot::from_entity(
            entity,
        )))
        .await?;
        uow.commit().await
    }

    async fn count(pool: &PgPool, sql: &str) -> i64 {
        sqlx::query_scalar(sql).fetch_one(pool).await.unwrap()
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_the_supplier_and_its_event_when_committed(pool: PgPool) {
        // Arrange
        let entity = new_supplier();

        // Act
        create(&pool, &entity).await.unwrap();

        // Assert
        let found = PgSupplierRepository::new(pool.clone())
            .find_by_id(entity.id)
            .await
            .unwrap();
        assert!(found.is_some());
        let (event_type, aggregate_id): (String, uuid::Uuid) =
            sqlx::query_as("SELECT event_type, aggregate_id FROM outbox")
                .fetch_one(&pool)
                .await
                .unwrap();
        assert_eq!(event_type, "supplier_created");
        assert_eq!(aggregate_id, entity.id.value());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_nothing_when_dropped_without_commit(pool: PgPool) {
        // Arrange
        let entity = new_supplier();

        // Act
        {
            let mut uow = PgSupplierUnitOfWorkFactory::new(pool.clone())
                .begin()
                .await
                .unwrap();
            uow.save(&entity).await.unwrap();
            uow.record(SupplierEvent::Created(SupplierSnapshot::from_entity(
                &entity,
            )))
            .await
            .unwrap();
        }

        // Assert
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM suppliers").await, 0);
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_the_supplier_when_saved_again(pool: PgPool) {
        // Arrange
        let mut entity = new_supplier();
        create(&pool, &entity).await.unwrap();
        entity.email = "updated".to_string();
        entity.updated_at = chrono::Utc::now();

        // Act
        let mut uow = PgSupplierUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.save(&entity).await.unwrap();
        uow.commit().await.unwrap();

        // Assert
        let found = PgSupplierRepository::new(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(found.email, "updated");
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_neither_row_nor_event_when_the_email_is_taken(pool: PgPool) {
        // Arrange
        let first = new_supplier();
        create(&pool, &first).await.unwrap();
        let mut second = new_supplier();
        second.email = first.email.clone();

        // Act
        let result = create(&pool, &second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM suppliers").await, 1);
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 1);
    }
}

