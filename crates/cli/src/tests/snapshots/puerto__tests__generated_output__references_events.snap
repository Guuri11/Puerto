import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionEntrega, MadreEntrega } from "../../../pruebas/entrega";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaEntrega } from "./lista-entrega";

describe("ContenedorListaEntrega", () => {
  test("debería mostrar una fila por cada entrega", async () => {
    // Preparar
    const semilla = [MadreEntrega.aleatorio(), MadreEntrega.aleatorio()];
    const api = apiFalsa([coleccionEntrega(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaEntrega />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreEntrega.aleatorio());
    const api = apiFalsa([coleccionEntrega(semilla)]);
    renderizarPantalla(<ContenedorListaEntrega />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreEntrega.aleatorio());
    const api = apiFalsa([coleccionEntrega(semilla)]);
    const ruta = "/entregas?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaEntrega />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay entregas", async () => {
    // Preparar
    const api = apiFalsa([coleccionEntrega()]);

    // Actuar
    renderizarPantalla(<ContenedorListaEntrega />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay entregas.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /entregas": "entrega.repositorio" };
    const api = apiFalsa([coleccionEntrega()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaEntrega />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("entrega.repositorio");
  });
});

=== web/src/contextos/entrega/contenedores/lista-entrega.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaEntrega } from "../vistas/lista-entrega";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaEntrega() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const entregas = useCarga(
    () => desenvolver(api.GET("/entregas", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Entregas</h1>
        <Link href="/entregas/nuevo" className="btn btn-primary">
          Crear entrega
        </Link>
      </div>
      {entregas.estado === "cargando" && <span className="loading loading-spinner" />}
      {entregas.estado === "error" && <AlertaError error={entregas.error} />}
      {entregas.estado === "listo" &&
        (entregas.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay entregas." />
        ) : (
          <>
            <VistaListaEntrega entregas={entregas.datos.elementos} />
            <Paginacion
              total={entregas.datos.total}
              limite={entregas.datos.limite}
              desplazamiento={entregas.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/entrega/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaEntrega {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "entrega.validacion.compra_id_no_encontrado": "Compra: no existe",
  "entrega.validacion.destinatario_id_no_encontrado": "Destinatario: no existe",
  "entrega.validacion.carrier_vacio": "Carrier: obligatorio",
  "entrega.duplicado": "Estos valores ya están en uso",
  "entrega.no_encontrado": "Ya no existe",
  "entrega.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "entrega.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "entrega.validacion.compra_id_no_encontrado": "compraId",
  "entrega.validacion.destinatario_id_no_encontrado": "destinatarioId",
  "entrega.validacion.carrier_vacio": "carrier",
};

export function aProblema(codigo: string): ProblemaEntrega {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

