=== business/src/domain/delivery/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum DeliveryError {
    #[error("delivery.validation_error.{0}")]
    ValidationError(String),
    #[error("delivery.not_found")]
    NotFound,
    #[error("delivery.duplicate")]
    Duplicate,
    #[error("delivery.repository_error")]
    RepositoryError,
    #[error("delivery.unknown")]
    Unknown,
}

impl From<RepositoryError> for DeliveryError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            // A reference names a row that does not exist: the caller's input, on that field.
            RepositoryError::MissingReference(field) => {
                Self::ValidationError(format!("{field}_not_found"))
            }
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = DeliveryError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "delivery.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = DeliveryError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "delivery.repository_error");
    }

    #[test]
    fn should_convert_a_missing_reference_into_a_validation_error_on_its_field() {
        let err = DeliveryError::from(RepositoryError::MissingReference("purchase_id"));
        assert_eq!(
            err.to_string(),
            "delivery.validation_error.purchase_id_not_found"
        );
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = DeliveryError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "delivery.repository_error");
    }
}

=== business/src/domain/delivery/events.rs ===
// AUTO-GENERATED by puerto from puerto.toml — never hand-edit. The snapshot follows the entity's
// fields; add an event with `puerto generate event Delivery <name>`.
use puerto_core::DomainEvent;
use serde::{Deserialize, Serialize};
use uuid::Uuid;

use super::model::Delivery;

pub const DELIVERY_CREATED: &str = "delivery_created";
pub const DELIVERY_UPDATED: &str = "delivery_updated";
pub const DELIVERY_DELETED: &str = "delivery_deleted";

/// What every delivery event carries: the delivery as the API shows it — primitives, value
/// objects unwrapped. A public contract: consumers decode it with
/// `envelope.decode::<DeliverySnapshot>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct DeliverySnapshot {
    pub id: Uuid,
    pub purchase_id: Uuid,
    pub carrier: String,
}

impl DeliverySnapshot {
    pub fn from_entity(entity: &Delivery) -> Self {
        Self {
            id: entity.id.value(),
            purchase_id: entity.purchase_id.value(),
            carrier: entity.carrier.clone(),
        }
    }
}

/// What happened to a delivery. Its write use cases record one through their unit of work.
#[derive(Debug, Clone, PartialEq)]
pub enum DeliveryEvent {
    Created(DeliverySnapshot),
    Updated(DeliverySnapshot),
    Deleted(DeliverySnapshot),
}

impl DeliveryEvent {
    pub fn snapshot(&self) -> &DeliverySnapshot {
        match self {
            Self::Created(snapshot) | Self::Updated(snapshot) | Self::Deleted(snapshot) => snapshot,
        }
    }
}

impl DomainEvent for DeliveryEvent {
    fn event_type(&self) -> &'static str {
        match self {
            Self::Created(_) => DELIVERY_CREATED,
            Self::Updated(_) => DELIVERY_UPDATED,
            Self::Deleted(_) => DELIVERY_DELETED,
        }
    }

    fn aggregate_type(&self) -> &'static str {
        "delivery"
    }

    fn aggregate_id(&self) -> Uuid {
        self.snapshot().id
    }

    fn schema_version(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // A snapshot holds primitives only: serialising it cannot fail.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::tests::mothers::delivery_mother::DeliveryMother;

    #[test]
    fn should_describe_every_event_when_one_is_recorded() {
        // Arrange
        let entity = DeliveryMother::random();
        let snapshot = DeliverySnapshot::from_entity(&entity);
        let events = [
            (DeliveryEvent::Created(snapshot.clone()), "delivery_created"),
            (DeliveryEvent::Updated(snapshot.clone()), "delivery_updated"),
            (DeliveryEvent::Deleted(snapshot.clone()), "delivery_deleted"),
        ];

        for (event, event_type) in events {
            // Act + Assert
            assert_eq!(event.event_type(), event_type);
            assert_eq!(event.aggregate_type(), "delivery");
            assert_eq!(event.aggregate_id(), entity.id.value());
            assert_eq!(event.schema_version(), 1);
            assert_eq!(event.snapshot(), &snapshot);
        }
    }

    #[test]
    fn should_keep_the_json_contract_when_the_snapshot_is_serialised() {
        // Arrange
        let snapshot = DeliverySnapshot::from_entity(&DeliveryMother::random());

        // Act
        let payload = DeliveryEvent::Created(snapshot.clone()).payload();

        // Assert — a renamed or removed key breaks every consumer of these events.
        let mut keys: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        keys.sort_unstable();
        assert_eq!(keys, ["carrier", "id", "purchaseId"]);
        assert_eq!(
            serde_json::from_value::<DeliverySnapshot>(payload).ok(),
            Some(snapshot)
        );
    }
}

=== business/src/domain/delivery/model.rs ===
use crate::domain::purchase::model::PurchaseId;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::DeliveryError;

/// The id of every `Delivery`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct DeliveryId(Uuid);

impl DeliveryId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for DeliveryId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct DeliveryProps {
    pub purchase_id: PurchaseId,
    pub carrier: String,
}

#[derive(Debug, Clone)]
pub struct Delivery {
    pub id: DeliveryId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub purchase_id: PurchaseId,
    pub carrier: String,
}

impl Delivery {
    pub fn new(props: DeliveryProps) -> Result<Self, DeliveryError> {
        if props.carrier.trim().is_empty() {
            return Err(DeliveryError::ValidationError("carrier_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: DeliveryId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            purchase_id: props.purchase_id,
            carrier: props.carrier,
        })
    }

    pub fn from_repository(data: Delivery) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_delivery_when_fields_are_valid() {
        let result = Delivery::new(DeliveryProps {
            purchase_id: PurchaseId::generate(),
            carrier: "example".to_string(),
        });
        assert_eq!(result.unwrap().carrier, "example");
    }

    #[test]
    fn should_reject_delivery_when_carrier_is_empty() {
        let result = Delivery::new(DeliveryProps {
            purchase_id: PurchaseId::generate(),
            carrier: "".into(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "delivery.validation_error.carrier_empty"
        );
    }

    #[test]
    fn should_reject_delivery_when_carrier_is_only_whitespace() {
        let result = Delivery::new(DeliveryProps {
            purchase_id: PurchaseId::generate(),
            carrier: "   ".into(),
        });
        assert!(result.is_err());
    }
}

