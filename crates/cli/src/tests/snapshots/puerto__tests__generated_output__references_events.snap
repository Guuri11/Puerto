use crate::modelo::Compra;
use crate::modelo::PropsCompra;
use dominio_proveedor::modelo::IdProveedor;

pub struct MadreCompra {
    proveedor_id: Option<IdProveedor>,
    approver_id: Option<IdProveedor>,
    total: Option<i64>,
}

impl MadreCompra {
    pub fn new() -> Self {
        Self {
            proveedor_id: None,
            approver_id: None,
            total: None,
        }
    }

    pub fn con_proveedor_id(mut self, proveedor_id: IdProveedor) -> Self {
        self.proveedor_id = Some(proveedor_id);
        self
    }

    pub fn con_approver_id(mut self, approver_id: IdProveedor) -> Self {
        self.approver_id = Some(approver_id);
        self
    }

    pub fn con_total(mut self, total: i64) -> Self {
        self.total = Some(total);
        self
    }

    pub fn construir(self) -> Compra {
        Compra::new(PropsCompra {
            proveedor_id: self.proveedor_id.unwrap_or_else(IdProveedor::generar),
            approver_id: self.approver_id,
            total: self.total.unwrap_or(42),
        })
        .expect("MadreCompra: Compra::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsCompra {
        PropsCompra {
            proveedor_id: self.proveedor_id.unwrap_or_else(IdProveedor::generar),
            approver_id: self.approver_id,
            total: self.total.unwrap_or(42),
        }
    }

    pub fn aleatorio() -> Compra {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Compra> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreCompra {
    fn default() -> Self {
        Self::new()
    }
}

