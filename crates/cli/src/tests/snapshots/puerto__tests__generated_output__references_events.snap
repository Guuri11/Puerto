import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { PurchaseError } from "../../../../domain/purchase/errors";
import { fakePurchaseRepository, PurchaseMother } from "../../../../test-support/purchase";
import { renderScreen } from "../../../../test-support/render";
import { PurchaseListContainer } from "./purchase-list-container";

describe("PurchaseListContainer", () => {
  test("should show a row per purchase when there are some", async () => {
    // Arrange
    const seed = [PurchaseMother.random(), PurchaseMother.random()];
    const purchaseRepository = fakePurchaseRepository(seed);

    // Act
    renderScreen(<PurchaseListContainer />, { purchaseRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => PurchaseMother.random());
    const purchaseRepository = fakePurchaseRepository(seed);
    renderScreen(<PurchaseListContainer />, { purchaseRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => PurchaseMother.random());
    const purchaseRepository = fakePurchaseRepository(seed);
    const path = "/purchases?page=2";

    // Act
    renderScreen(<PurchaseListContainer />, { purchaseRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no purchase", async () => {
    // Arrange
    const purchaseRepository = fakePurchaseRepository();

    // Act
    renderScreen(<PurchaseListContainer />, { purchaseRepository });

    // Assert
    expect(await screen.findByText("No purchases yet.")).toBeTruthy();
  });

  test("should show the error code when the purchases cannot be listed", async () => {
    // Arrange
    const purchaseRepository = {
      ...fakePurchaseRepository(),
      list: () => Promise.reject(new PurchaseError("purchase.repository_error")),
    };

    // Act
    renderScreen(<PurchaseListContainer />, { purchaseRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("purchase.repository_error");
  });
});

=== web/src/presentation/features/purchase/containers/purchase-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { PurchaseListView } from "../views/purchase-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function PurchaseListContainer() {
  const { purchaseRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const purchases = useAsync(
    () => purchaseRepository.list({ limit: PAGE_SIZE, offset }),
    [purchaseRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Purchases</h1>
        <Link href="/purchases/new" className="btn btn-primary">
          New purchase
        </Link>
      </div>
      {purchases.status === "loading" && <span className="loading loading-spinner" />}
      {purchases.status === "error" && <ErrorAlert error={purchases.error} />}
      {purchases.status === "ok" &&
        (purchases.data.total === 0 ? (
          <EmptyState message="No purchases yet." />
        ) : (
          <>
            <PurchaseListView purchases={purchases.data.items} />
            <Pagination {...purchases.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

