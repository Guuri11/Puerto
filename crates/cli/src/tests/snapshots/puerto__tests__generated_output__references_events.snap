import { CompraListContainer } from "../../features/compra/containers/compra-list-container";
import { EntregaDetailContainer } from "../../features/entrega/containers/entrega-detail-container";
import { EntregaFormContainer } from "../../features/entrega/containers/entrega-form-container";
import { EntregaListContainer } from "../../features/entrega/containers/entrega-list-container";
import { ProveedorDetailContainer } from "../../features/proveedor/containers/proveedor-detail-container";
import { ProveedorFormContainer } from "../../features/proveedor/containers/proveedor-form-container";
import { ProveedorListContainer } from "../../features/proveedor/containers/proveedor-list-container";
import { HomePage } from "../../pages/home";
import { NotFoundPage } from "../../pages/not-found";
import type { NavEntry } from "../../shared/ui/layout";
import { customRoutes } from "../routes";

export const navEntries: NavEntry[] = [
  { label: "Compras", href: "/compras" },
  { label: "Entregas", href: "/entregas" },
  { label: "Proveedores", href: "/proveedores" },
];

export function AppRoutes() {
  return (
    <Switch>
      <Route path="/">
        <HomePage entries={navEntries} />
      </Route>
      {customRoutes}
      <Route path="/compras">
        <CompraListContainer />
      </Route>
      <Route path="/compras/new">
        <CompraFormContainer />
      </Route>
      <Route path="/compras/:id/edit">{(params) => <CompraFormContainer id={params.id} />}</Route>
      <Route path="/compras/:id">{(params) => <CompraDetailContainer id={params.id} />}</Route>
      <Route path="/entregas">
        <EntregaListContainer />
      </Route>
      <Route path="/entregas/new">
        <EntregaFormContainer />
      </Route>
      <Route path="/entregas/:id/edit">{(params) => <EntregaFormContainer id={params.id} />}</Route>
      <Route path="/entregas/:id">{(params) => <EntregaDetailContainer id={params.id} />}</Route>
      <Route path="/proveedores">
        <ProveedorListContainer />
      </Route>
      <Route path="/proveedores/new">
        <ProveedorFormContainer />
      </Route>
      <Route path="/proveedores/:id/edit">
        {(params) => <ProveedorFormContainer id={params.id} />}
      </Route>
      <Route path="/proveedores/:id">
        {(params) => <ProveedorDetailContainer id={params.id} />}
      </Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

