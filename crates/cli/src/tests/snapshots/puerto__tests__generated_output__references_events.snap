use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{Entrega, IdEntrega};
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;

/// A qué reduce `buscar_todos` la página: un id por referencia; `None` no filtra.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct FiltroEntrega {
    pub compra_id: Option<IdCompra>,
    pub destinatario_id: Option<IdProveedor>,
}

#[async_trait]
pub trait RepositorioEntrega: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroEntrega,
    ) -> Result<Pagina<Entrega>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdEntrega) -> Result<Option<Entrega>, ErrorRepositorio>;
    // Sin `guardar`: las escrituras pasan por `UnitOfWorkFactoryEntrega`, que registra sus
    // eventos.
}

#[cfg(any(test, feature = "pruebas"))]
