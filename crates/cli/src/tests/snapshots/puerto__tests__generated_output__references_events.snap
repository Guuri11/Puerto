import { describe, expect, test } from "bun:test";
import { DeliveryError } from "../../domain/delivery/errors";
import { DeliveryMother } from "../../test-support/delivery";
import { createApiClient } from "../http/client";
import { deliveryRepositoryHttp } from "./delivery-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: deliveryRepositoryHttp(api), requests };
}

describe("deliveryRepositoryHttp", () => {
  test("should ask for the page and return its deliveries", async () => {
    // Arrange
    const delivery = DeliveryMother.random();
    const page = { items: [delivery], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/deliveries?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating a delivery", async () => {
    // Arrange
    const draft = DeliveryMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the delivery does not exist", async () => {
    // Arrange
    const code = "delivery.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(DeliveryError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the delivery", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/deliveries/42");
  });
});

=== web/src/infrastructure/delivery/delivery-repository-http.ts ===
import { DeliveryError } from "../../domain/delivery/errors";
import type { Delivery, DeliveryDraft } from "../../domain/delivery/model";
import type { DeliveryRepository } from "../../domain/delivery/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type DeliveryDto = components["schemas"]["DeliveryDto"];
type DeliveryRequest = components["schemas"]["CreateDeliveryRequest"];

function toDelivery(dto: DeliveryDto): Delivery {
  return {
    id: dto.id,
    purchaseId: dto.purchaseId,
    carrier: dto.carrier,
  };
}

function toRequest(draft: DeliveryDraft): DeliveryRequest {
  return {
    purchaseId: draft.purchaseId,
    carrier: draft.carrier,
  };
}

/** `DeliveryRepository` over the REST API (`/deliveries`). */
export function deliveryRepositoryHttp(api: ApiClient): DeliveryRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/deliveries", {
        params: { query: page },
      });
      if (data === undefined) throw new DeliveryError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toDelivery) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/deliveries/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new DeliveryError(apiErrorCode(error, response));
      return toDelivery(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/deliveries", { body: toRequest(draft) });
      if (data === undefined) throw new DeliveryError(apiErrorCode(error, response));
      return toDelivery(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/deliveries/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new DeliveryError(apiErrorCode(error, response));
      return toDelivery(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/deliveries/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new DeliveryError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

