use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarProveedores {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarProveedores: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsListarProveedores,
    ) -> Result<Pagina<Proveedor>, ErrorProveedor>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarProveedores {}

        #[async_trait]
        impl ListarProveedores for ListarProveedores {
            async fn ejecutar(&self, params: ParamsListarProveedores) -> Result<Pagina<Proveedor>, ErrorProveedor>;
        }
    }
}

pub struct ListarProveedoresImpl {
    pub repositorio: Arc<dyn RepositorioProveedor>,
}

#[async_trait]
impl ListarProveedores for ListarProveedoresImpl {
    async fn ejecutar(
        &self,
        params: ParamsListarProveedores,
    ) -> Result<Pagina<Proveedor>, ErrorProveedor> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_proveedores: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "listar_proveedores: fallo del repositorio"),
            )
            .map_err(ErrorProveedor::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_proveedor::{
        pruebas::madres::MadreProveedor, repositorio::dobles::MockRepositorioProveedor,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_proveedores() {
        let entidades = MadreProveedor::aleatorios(2);
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarProveedoresImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarProveedores {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_proveedores() {
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarProveedoresImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarProveedores {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarProveedoresImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarProveedores {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

