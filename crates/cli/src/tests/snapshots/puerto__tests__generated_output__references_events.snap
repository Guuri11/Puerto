import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { EntregaError } from "../../../../domain/entrega/errors";
import type { EntregaDraft } from "../../../../domain/entrega/model";
import { CompraMother, fakeCompraRepository } from "../../../../test-support/compra";
import { EntregaMother, fakeEntregaRepository } from "../../../../test-support/entrega";
import { fakeProveedorRepository, ProveedorMother } from "../../../../test-support/proveedor";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { EntregaFormContainer } from "./entrega-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: EntregaDraft) {
  return {
    compraRepository: fakeCompraRepository([CompraMother.random({ id: draft.compraId })]),
    proveedorRepository: fakeProveedorRepository([
      ProveedorMother.random({ id: draft.destinatarioId ?? crypto.randomUUID() }),
    ]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: EntregaDraft) {
  await screen.findByText("Save");
  await choose("Compra", draft.compraId);
  await choose("Destinatario", textOf(draft.destinatarioId));
  type("Carrier", draft.carrier);
}

describe("EntregaFormContainer", () => {
  test("should create the entrega from what was typed and show it", async () => {
    // Arrange
    const draft = EntregaMother.draft();
    const entregaRepository = fakeEntregaRepository();
    const { history } = renderScreen(<EntregaFormContainer />, {
      entregaRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/entregas/"));
    const {
      items: [created],
    } = await entregaRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/entregas/${created?.id}`);
  });

  test("should save the edited entrega when an existing one is submitted", async () => {
    // Arrange
    const seeded = EntregaMother.random();
    const entregaRepository = fakeEntregaRepository([seeded]);
    const { history } = renderScreen(<EntregaFormContainer id={seeded.id} />, {
      entregaRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/entregas/${seeded.id}`));
    expect(await entregaRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "entrega.validacion.invalid";
    const entregaRepository = {
      ...fakeEntregaRepository(),
      create: () => Promise.reject(new EntregaError(code)),
    };
    const draft = EntregaMother.draft();
    renderScreen(<EntregaFormContainer />, {
      entregaRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a entrega with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const entregaRepository = {
      ...fakeEntregaRepository(),
      create: () => Promise.reject(new EntregaError("entrega.duplicado")),
    };
    const draft = EntregaMother.draft();
    renderScreen(<EntregaFormContainer />, {
      entregaRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An entrega with these values already exists",
    );
  });

  test("should offer every compra in the selects that reference one", async () => {
    // Arrange
    const compra = CompraMother.random();

    // Act
    renderScreen(<EntregaFormContainer />, {
      entregaRepository: fakeEntregaRepository(),
      compraRepository: fakeCompraRepository([compra]),
      proveedorRepository: fakeProveedorRepository(),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: compra.id });
    expect(options).toHaveLength(1);
  });

  test("should offer every proveedor in the selects that reference one", async () => {
    // Arrange
    const proveedor = ProveedorMother.random();

    // Act
    renderScreen(<EntregaFormContainer />, {
      entregaRepository: fakeEntregaRepository(),
      compraRepository: fakeCompraRepository(),
      proveedorRepository: fakeProveedorRepository([proveedor]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: proveedor.name });
    expect(options).toHaveLength(1);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const entregaRepository = {
      ...fakeEntregaRepository(),
      create: () => Promise.reject(new EntregaError("entrega.validacion.compra_id_no_encontrado")),
    };
    const draft = EntregaMother.draft();
    renderScreen(<EntregaFormContainer />, {
      entregaRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Compra does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Compra");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/entrega/containers/entrega-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/entrega/messages";
import type { Entrega } from "../../../../domain/entrega/model";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { EntregaFormView, toEntregaDraft, toEntregaForm } from "../views/entrega-form-view";

/** Creates an entrega, or edits the one with `id`. */
export function EntregaFormContainer({ id }: { id?: string }) {
  const { entregaRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : entregaRepository.get(id)),
    [entregaRepository, id],
  );
  const title = id === undefined ? "New entrega" : "Edit entrega";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <EntregaForm existing={existing.data} />}
      <Link href={id === undefined ? "/entregas" : `/entregas/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function EntregaForm({ existing }: { existing: Entrega | null }) {
  const { entregaRepository, compraRepository, proveedorRepository } = useDependencies();
  const compras = useAsync(
    () => compraRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [compraRepository],
  );
  const proveedores = useAsync(
    () => proveedorRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [proveedorRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toEntregaForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toEntregaDraft(values);
      const saved =
        existing === null
          ? await entregaRepository.create(draft)
          : await entregaRepository.update(existing.id, draft);
      navigate(`/entregas/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {compras.status === "error" && <ErrorAlert error={compras.error} />}
        {proveedores.status === "error" && <ErrorAlert error={proveedores.error} />}
        <EntregaFormView
          values={values}
          options={{
            compraId: referenceOptions(compras, (compra) => compra.id),
            destinatarioId: referenceOptions(proveedores, (proveedor) => proveedor.name),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

