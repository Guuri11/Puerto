import { Link } from "wouter";
import type { Proveedor } from "../../../../domain/proveedor/model";

export function ProveedorListView({ proveedores }: { proveedores: Proveedor[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {proveedores.map((proveedor) => (
            <tr key={proveedor.id}>
              <td>{proveedor.name}</td>
              <td>{proveedor.email}</td>
              <td className="text-right">
                <Link href={`/proveedores/${proveedor.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/compra.ts ===
import { CompraError } from "../domain/compra/errors";
import type { Compra, CompraDraft } from "../domain/compra/model";
import type { CompraRepository } from "../domain/compra/repository";

/** Valid compras for tests; pass `overrides` for the fields a test is about. */
export const CompraMother = {
  draft(overrides: Partial<CompraDraft> = {}): CompraDraft {
    return {
      proveedorId: crypto.randomUUID(),
      approverId: crypto.randomUUID(),
      total: 42,
      ...overrides,
    };
  },

  random(overrides: Partial<Compra> = {}): Compra {
    return { id: crypto.randomUUID(), ...CompraMother.draft(), ...overrides };
  },
};

/** An in-memory `CompraRepository`. Override a method to make it fail. */
export function fakeCompraRepository(seed: Compra[] = []): CompraRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new CompraError("compra.no_encontrado");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

