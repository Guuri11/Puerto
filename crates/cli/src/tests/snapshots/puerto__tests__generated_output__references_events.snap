import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionProveedor, MadreProveedor } from "../../../pruebas/proveedor";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorFormularioProveedor } from "./formulario-proveedor";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearProveedor"]) {
  await screen.findByText("Guardar");
  escribir("Name", peticion.name);
  escribir("Email", peticion.email);
}

describe("ContenedorFormularioProveedor", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreProveedor.peticion();
    const guardados = coleccionProveedor();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioProveedor />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/proveedores/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/proveedores/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreProveedor.aleatorio();
    const guardados = coleccionProveedor([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioProveedor id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/proveedores/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreProveedor.peticion();
    const codigo = "proveedor.validacion.invalido";
    const fallos = { "POST /proveedores": codigo };
    const api = apiFalsa([coleccionProveedor()], fallos);
    renderizarPantalla(<ContenedorFormularioProveedor />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreProveedor.peticion();
    const fallos = { "POST /proveedores": "proveedor.duplicado" };
    const api = apiFalsa([coleccionProveedor()], fallos);
    renderizarPantalla(<ContenedorFormularioProveedor />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("Estos valores ya están en uso");
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreProveedor.peticion();
    const fallos = { "POST /proveedores": "proveedor.name_invalido" };
    const api = apiFalsa([coleccionProveedor()], fallos);
    renderizarPantalla(<ContenedorFormularioProveedor />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText("Name: no válido")).toBeTruthy();
    const campo = screen.getByLabelText("Name");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/proveedor/contenedores/formulario-proveedor.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioProveedor,
  aPeticionProveedor,
  VistaFormularioProveedor,
} from "../vistas/formulario-proveedor";

type Proveedor = Esquemas["DtoProveedor"];

/** Crear, o editar con `id`: el formulario de proveedores. */
export function ContenedorFormularioProveedor({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/proveedores/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear proveedor" : "Editar proveedor";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioProveedor existente={existente.datos} />}
      <Link href={id === undefined ? "/proveedores" : `/proveedores/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioProveedor({ existente }: { existente: Proveedor | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioProveedor(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionProveedor(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/proveedores", { body: cuerpo })
          : api.PUT("/proveedores/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/proveedores/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioProveedor
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/proveedor/contenedores/lista-proveedor.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionProveedor, MadreProveedor } from "../../../pruebas/proveedor";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaProveedor } from "./lista-proveedor";

describe("ContenedorListaProveedor", () => {
  test("debería mostrar una fila por cada proveedor", async () => {
    // Preparar
    const semilla = [MadreProveedor.aleatorio(), MadreProveedor.aleatorio()];
    const api = apiFalsa([coleccionProveedor(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaProveedor />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreProveedor.aleatorio());
    const api = apiFalsa([coleccionProveedor(semilla)]);
    renderizarPantalla(<ContenedorListaProveedor />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreProveedor.aleatorio());
    const api = apiFalsa([coleccionProveedor(semilla)]);
    const ruta = "/proveedores?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaProveedor />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay proveedores", async () => {
    // Preparar
    const api = apiFalsa([coleccionProveedor()]);

    // Actuar
    renderizarPantalla(<ContenedorListaProveedor />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay proveedores.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /proveedores": "proveedor.repositorio" };
    const api = apiFalsa([coleccionProveedor()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaProveedor />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("proveedor.repositorio");
  });
});

=== web/src/contextos/proveedor/contenedores/lista-proveedor.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaProveedor } from "../vistas/lista-proveedor";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaProveedor() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const proveedores = useCarga(
    () => desenvolver(api.GET("/proveedores", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Proveedores</h1>
        <Link href="/proveedores/nuevo" className="btn btn-primary">
          Crear proveedor
        </Link>
      </div>
      {proveedores.estado === "cargando" && <span className="loading loading-spinner" />}
      {proveedores.estado === "error" && <AlertaError error={proveedores.error} />}
      {proveedores.estado === "listo" &&
        (proveedores.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay proveedores." />
        ) : (
          <>
            <VistaListaProveedor proveedores={proveedores.datos.elementos} />
            <Paginacion
              total={proveedores.datos.total}
              limite={proveedores.datos.limite}
              desplazamiento={proveedores.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/proveedor/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaProveedor {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "proveedor.name_invalido": "Name: no válido",
  "proveedor.validacion.email_vacio": "Email: obligatorio",
  "proveedor.duplicado": "Estos valores ya están en uso",
  "proveedor.no_encontrado": "Ya no existe",
  "proveedor.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "proveedor.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "proveedor.name_invalido": "name",
  "proveedor.validacion.email_vacio": "email",
};

export function aProblema(codigo: string): ProblemaProveedor {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

