use async_trait::async_trait;
use dominio_compra::modelo::IdCompra;
use dominio_entrega::errores::ErrorEntrega;
use dominio_entrega::modelo::Entrega;
use dominio_entrega::repositorio::{FiltroEntrega, RepositorioEntrega};
use dominio_proveedor::modelo::IdProveedor;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarEntregas {
    pub pagina: PeticionPagina,
    /// Si se indica, solo entregas con este `compra_id`.
    pub compra_id: Option<IdCompra>,
    /// Si se indica, solo entregas con este `destinatario_id`.
    pub destinatario_id: Option<IdProveedor>,
}

#[async_trait]
pub trait ListarEntregas: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarEntregas)
    -> Result<Pagina<Entrega>, ErrorEntrega>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarEntregas {}

        #[async_trait]
        impl ListarEntregas for ListarEntregas {
            async fn ejecutar(&self, params: ParamsListarEntregas) -> Result<Pagina<Entrega>, ErrorEntrega>;
        }
    }
}

pub struct ListarEntregasImpl {
    pub repositorio: Arc<dyn RepositorioEntrega>,
}

#[async_trait]
impl ListarEntregas for ListarEntregasImpl {
    async fn ejecutar(
        &self,
        params: ParamsListarEntregas,
    ) -> Result<Pagina<Entrega>, ErrorEntrega> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_entregas: inicio"
        );
        self.repositorio
            .buscar_todos(
                params.pagina,
                FiltroEntrega {
                    compra_id: params.compra_id,
                    destinatario_id: params.destinatario_id,
                },
            )
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_entregas: fallo del repositorio"))
            .map_err(ErrorEntrega::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_compra::modelo::IdCompra;
    use dominio_entrega::{
        pruebas::madres::MadreEntrega, repositorio::dobles::MockRepositorioEntrega,
    };
    use dominio_proveedor::modelo::IdProveedor;
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_entregas() {
        let entidades = MadreEntrega::aleatorios(2);
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina, _| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarEntregasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEntregas {
                pagina: PeticionPagina::default(),
                compra_id: None,
                destinatario_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_entregas() {
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEntregasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEntregas {
                pagina: PeticionPagina::default(),
                compra_id: None,
                destinatario_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina, _| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEntregasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEntregas {
                pagina: PeticionPagina::new(Some(5), Some(10)),
                compra_id: None,
                destinatario_id: None,
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_al_repositorio() {
        let filtro = FiltroEntrega {
            compra_id: Some(IdCompra::generar()),
            destinatario_id: Some(IdProveedor::generar()),
        };
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(move |_, f| *f == filtro)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEntregasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEntregas {
                pagina: PeticionPagina::default(),
                compra_id: filtro.compra_id,
                destinatario_id: filtro.destinatario_id,
            })
            .await;

        assert!(resultado.is_ok());
    }
}

