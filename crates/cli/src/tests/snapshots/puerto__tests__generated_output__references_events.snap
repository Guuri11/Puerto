import { PurchaseError } from "../../domain/purchase/errors";
import type { Purchase, PurchaseDraft } from "../../domain/purchase/model";
import type { PurchaseRepository } from "../../domain/purchase/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type PurchaseDto = components["schemas"]["PurchaseDto"];
type PurchaseRequest = components["schemas"]["CreatePurchaseRequest"];

function toPurchase(dto: PurchaseDto): Purchase {
  return {
    id: dto.id,
    supplierId: dto.supplierId,
    approverId: dto.approverId ?? null,
    total: dto.total,
  };
}

function toRequest(draft: PurchaseDraft): PurchaseRequest {
  return {
    supplierId: draft.supplierId,
    approverId: draft.approverId ?? undefined,
    total: draft.total,
  };
}

/** `PurchaseRepository` over the REST API (`/purchases`). */
export function purchaseRepositoryHttp(api: ApiClient): PurchaseRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/purchases", {
        params: { query: page },
      });
      if (data === undefined) throw new PurchaseError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toPurchase) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/purchases/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new PurchaseError(apiErrorCode(error, response));
      return toPurchase(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/purchases", { body: toRequest(draft) });
      if (data === undefined) throw new PurchaseError(apiErrorCode(error, response));
      return toPurchase(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/purchases/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new PurchaseError(apiErrorCode(error, response));
      return toPurchase(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/purchases/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new PurchaseError(apiErrorCode(error, response));
    },
  };
}

