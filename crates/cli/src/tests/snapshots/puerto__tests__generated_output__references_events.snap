import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { DeliveryError } from "../../../../domain/delivery/errors";
import { DeliveryMother, fakeDeliveryRepository } from "../../../../test-support/delivery";
import { renderScreen } from "../../../../test-support/render";
import { DeliveryListContainer } from "./delivery-list-container";

describe("DeliveryListContainer", () => {
  test("should show a row per delivery when there are some", async () => {
    // Arrange
    const seed = [DeliveryMother.random(), DeliveryMother.random()];
    const deliveryRepository = fakeDeliveryRepository(seed);

    // Act
    renderScreen(<DeliveryListContainer />, { deliveryRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => DeliveryMother.random());
    const deliveryRepository = fakeDeliveryRepository(seed);
    renderScreen(<DeliveryListContainer />, { deliveryRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => DeliveryMother.random());
    const deliveryRepository = fakeDeliveryRepository(seed);
    const path = "/deliveries?page=2";

    // Act
    renderScreen(<DeliveryListContainer />, { deliveryRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no delivery", async () => {
    // Arrange
    const deliveryRepository = fakeDeliveryRepository();

    // Act
    renderScreen(<DeliveryListContainer />, { deliveryRepository });

    // Assert
    expect(await screen.findByText("No deliveries yet.")).toBeTruthy();
  });

  test("should show the error code when the deliveries cannot be listed", async () => {
    // Arrange
    const deliveryRepository = {
      ...fakeDeliveryRepository(),
      list: () => Promise.reject(new DeliveryError("delivery.repository_error")),
    };

    // Act
    renderScreen(<DeliveryListContainer />, { deliveryRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("delivery.repository_error");
  });
});

=== web/src/presentation/features/delivery/containers/delivery-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { DeliveryListView } from "../views/delivery-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function DeliveryListContainer() {
  const { deliveryRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const deliveries = useAsync(
    () => deliveryRepository.list({ limit: PAGE_SIZE, offset }),
    [deliveryRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Deliveries</h1>
        <Link href="/deliveries/new" className="btn btn-primary">
          New delivery
        </Link>
      </div>
      {deliveries.status === "loading" && <span className="loading loading-spinner" />}
      {deliveries.status === "error" && <ErrorAlert error={deliveries.error} />}
      {deliveries.status === "ok" &&
        (deliveries.data.total === 0 ? (
          <EmptyState message="No deliveries yet." />
        ) : (
          <>
            <DeliveryListView deliveries={deliveries.data.items} />
            <Pagination {...deliveries.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

