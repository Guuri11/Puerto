// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoEntrega, DtoPaginaEntrega};

#[derive(ApiResponse)]
pub enum RespuestaCrearEntrega {
    #[oai(status = 201)]
    Creado(Json<DtoEntrega>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearEntrega {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerEntrega {
    #[oai(status = 200)]
    Ok(Json<DtoEntrega>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerEntrega {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarEntregas {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaEntrega>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarEntregas {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarEntrega {
    #[oai(status = 200)]
    Ok(Json<DtoEntrega>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarEntrega {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarEntrega {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaBorrarEntrega {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

=== contextos/entrega/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_entrega::{
    actualizar_entrega::{ActualizarEntrega, ParamsActualizarEntrega},
    borrar_entrega::{BorrarEntrega, ParamsBorrarEntrega},
    crear_entrega::{CrearEntrega, ParamsCrearEntrega},
    listar_entregas::{ListarEntregas, ParamsListarEntregas},
    obtener_entrega::{ObtenerEntrega, ParamsObtenerEntrega},
};
use dominio_compra::modelo::IdCompra;
use dominio_entrega::modelo::IdEntrega;
use dominio_proveedor::modelo::IdProveedor;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoEntrega, DtoPaginaEntrega, PeticionActualizarEntrega, PeticionCrearEntrega};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarEntrega, RespuestaBorrarEntrega, RespuestaCrearEntrega,
    RespuestaListarEntregas, RespuestaObtenerEntrega,
};

#[derive(Tags)]
enum ApiTags {
    Entrega,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiEntrega {
    pub crear_entrega: Arc<dyn CrearEntrega>,
    pub obtener_entrega: Arc<dyn ObtenerEntrega>,
    pub listar_entregas: Arc<dyn ListarEntregas>,
    pub actualizar_entrega: Arc<dyn ActualizarEntrega>,
    pub borrar_entrega: Arc<dyn BorrarEntrega>,
}

#[OpenApi]
impl ApiEntrega {
    /// Crea: Entrega
    #[oai(path = "/entregas", method = "post", tag = "ApiTags::Entrega")]
    async fn crear(&self, cuerpo: Json<PeticionCrearEntrega>) -> RespuestaCrearEntrega {
        match self
            .crear_entrega
            .ejecutar(ParamsCrearEntrega {
                compra_id: IdCompra::from_uuid(cuerpo.compra_id),
                destinatario_id: cuerpo.destinatario_id.map(IdProveedor::from_uuid),
                carrier: cuerpo.carrier.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearEntrega::Creado(Json(DtoEntrega::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_entrega falló");
                RespuestaCrearEntrega::from_status(status, error)
            }
        }
    }

    /// Obtiene: Entrega por id
    #[oai(path = "/entregas/:id", method = "get", tag = "ApiTags::Entrega")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerEntrega {
        match self
            .obtener_entrega
            .ejecutar(ParamsObtenerEntrega {
                id: IdEntrega::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerEntrega::Ok(Json(DtoEntrega::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_entrega falló");
                RespuestaObtenerEntrega::from_status(status, error)
            }
        }
    }

    /// Lista Entregas, página a página (el dominio acota `limite`)
    #[oai(path = "/entregas", method = "get", tag = "ApiTags::Entrega")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
        #[oai(name = "compraId")] compra_id: Query<Option<Uuid>>,
        #[oai(name = "destinatarioId")] destinatario_id: Query<Option<Uuid>>,
    ) -> RespuestaListarEntregas {
        match self
            .listar_entregas
            .ejecutar(ParamsListarEntregas {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
                compra_id: compra_id.0.map(IdCompra::from_uuid),
                destinatario_id: destinatario_id.0.map(IdProveedor::from_uuid),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarEntregas::Ok(Json(DtoPaginaEntrega::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_entregas falló");
                RespuestaListarEntregas::from_status(status, error)
            }
        }
    }

    /// Actualiza: Entrega
    #[oai(path = "/entregas/:id", method = "put", tag = "ApiTags::Entrega")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarEntrega>,
    ) -> RespuestaActualizarEntrega {
        match self
            .actualizar_entrega
            .ejecutar(ParamsActualizarEntrega {
                id: IdEntrega::from_uuid(id.0),
                compra_id: IdCompra::from_uuid(cuerpo.compra_id),
                destinatario_id: cuerpo.destinatario_id.map(IdProveedor::from_uuid),
                carrier: cuerpo.carrier.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarEntrega::Ok(Json(DtoEntrega::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_entrega falló");
                RespuestaActualizarEntrega::from_status(status, error)
            }
        }
    }

    /// Borra: Entrega
    #[oai(path = "/entregas/:id", method = "delete", tag = "ApiTags::Entrega")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarEntrega {
        match self
            .borrar_entrega
            .ejecutar(ParamsBorrarEntrega {
                id: IdEntrega::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarEntrega::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_entrega falló");
                RespuestaBorrarEntrega::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_entrega::{
        actualizar_entrega::dobles::MockActualizarEntrega,
        borrar_entrega::dobles::MockBorrarEntrega, crear_entrega::dobles::MockCrearEntrega,
        listar_entregas::dobles::MockListarEntregas, obtener_entrega::dobles::MockObtenerEntrega,
    };
    use dominio_entrega::errores::ErrorEntrega;
    use dominio_entrega::pruebas::madres::MadreEntrega;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearEntrega,
        obtener: MockObtenerEntrega,
        listar: MockListarEntregas,
        actualizar: MockActualizarEntrega,
        borrar: MockBorrarEntrega,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiEntrega {
                crear_entrega: Arc::new(self.crear),
                obtener_entrega: Arc::new(self.obtener),
                listar_entregas: Arc::new(self.listar),
                actualizar_entrega: Arc::new(self.actualizar),
                borrar_entrega: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearEntrega {
        PeticionCrearEntrega {
            compra_id: Uuid::new_v4(),
            destinatario_id: None,
            carrier: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarEntrega {
        PeticionActualizarEntrega {
            compra_id: Uuid::new_v4(),
            destinatario_id: None,
            carrier: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/entregas/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_entrega() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreEntrega::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/entregas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_entrega_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorEntrega::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/entregas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_no_existe_la_referencia_de_compra_id() {
        // Preparar: en la base de datos no hay Compra con ese id (ADR-0022 de Puerto).
        let mut dobles = Dobles::default();
        dobles.crear.expect_ejecutar().returning(|_| {
            Err(ErrorEntrega::Validacion(
                "compra_id_no_encontrado".to_string(),
            ))
        });

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/entregas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("entrega.validacion.compra_id_no_encontrado");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_no_existe_la_referencia_de_destinatario_id() {
        // Preparar: en la base de datos no hay Proveedor con ese id (ADR-0022 de Puerto).
        let mut dobles = Dobles::default();
        dobles.crear.expect_ejecutar().returning(|_| {
            Err(ErrorEntrega::Validacion(
                "destinatario_id_no_encontrado".to_string(),
            ))
        });

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/entregas")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("entrega.validacion.destinatario_id_no_encontrado");
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_entrega_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreEntrega::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_entrega_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorEntrega::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_entregas_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreEntrega::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/entregas").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/entregas?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_por_compra_id_al_caso_de_uso() {
        // Preparar
        let compra_id = Uuid::new_v4();
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(move |params| params.compra_id == Some(IdCompra::from_uuid(compra_id)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get(format!("/entregas?compraId={compra_id}"))
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_por_destinatario_id_al_caso_de_uso() {
        // Preparar
        let destinatario_id = Uuid::new_v4();
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(move |params| {
                params.destinatario_id == Some(IdProveedor::from_uuid(destinatario_id))
            })
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get(format!("/entregas?destinatarioId={destinatario_id}"))
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEntrega::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/entregas").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_entrega() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreEntrega::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_entrega_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEntrega::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_entrega() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_entrega_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEntrega::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

