use async_trait::async_trait;
use dominio_proveedor::errores::ErrorProveedor;
use dominio_proveedor::modelo::{IdProveedor, Proveedor};
use dominio_proveedor::repositorio::RepositorioProveedor;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerProveedor {
    pub id: IdProveedor,
}

#[async_trait]
pub trait ObtenerProveedor: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerProveedor) -> Result<Proveedor, ErrorProveedor>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerProveedor {}

        #[async_trait]
        impl ObtenerProveedor for ObtenerProveedor {
            async fn ejecutar(&self, params: ParamsObtenerProveedor) -> Result<Proveedor, ErrorProveedor>;
        }
    }
}

pub struct ObtenerProveedorImpl {
    pub repositorio: Arc<dyn RepositorioProveedor>,
}

#[async_trait]
impl ObtenerProveedor for ObtenerProveedorImpl {
    async fn ejecutar(&self, params: ParamsObtenerProveedor) -> Result<Proveedor, ErrorProveedor> {
        tracing::info!(id = %params.id, "obtener_proveedor: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_proveedor: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorProveedor::NoEncontrado;
            tracing::warn!(error = %err, "obtener_proveedor: rechazado");
            err
        })
    }
}

