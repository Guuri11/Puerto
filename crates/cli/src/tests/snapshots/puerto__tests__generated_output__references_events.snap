pub struct ActualizarProveedorImpl {
    pub repositorio: Arc<dyn RepositorioProveedor>,
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProveedor>,
}

#[async_trait]
impl ActualizarProveedor for ActualizarProveedorImpl {
    async fn ejecutar(
        &self,
        params: ParamsActualizarProveedor,
    ) -> Result<Proveedor, ErrorProveedor> {
        tracing::info!(id = %params.id, "actualizar_proveedor: inicio");
        let fallido = |e: &ErrorRepositorio| tracing::error!(error = %e, "actualizar_proveedor: fallo del repositorio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(fallido)?
            .ok_or_else(|| {
                let err = ErrorProveedor::NoEncontrado;
                tracing::warn!(error = %err, "actualizar_proveedor: rechazado");
                err
            })?;
        if params.email.trim().is_empty() {
            let err = ErrorProveedor::Validacion("email_vacio".into());
            tracing::warn!(error = %err, "actualizar_proveedor: rechazado");
            return Err(err);
        }
        let name = Name::new(params.name)?;
        entidad.name = name;
        entidad.email = params.email;
        entidad.actualizado_en = chrono::Utc::now();
        let mut uow = self.uow_factory.begin().await.inspect_err(fallido)?;
        uow.guardar(&entidad).await.inspect_err(fallido)?;
        uow.registrar(EventoProveedor::Actualizado(
            SnapshotProveedor::from_entidad(&entidad),
        ))
        .await
        .inspect_err(fallido)?;
        uow.commit().await.inspect_err(fallido)?;
        Ok(entidad)
    }
}

