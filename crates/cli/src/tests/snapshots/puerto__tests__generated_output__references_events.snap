use async_trait::async_trait;
use dominio_entrega::errores::ErrorEntrega;
use dominio_entrega::eventos::{EventoEntrega, SnapshotEntrega};
use dominio_entrega::modelo::IdEntrega;
use dominio_entrega::repositorio::RepositorioEntrega;
use dominio_entrega::unit_of_work::UnitOfWorkFactoryEntrega;
use puerto_nucleo::ErrorRepositorio;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarEntrega {
    pub id: IdEntrega,
}

#[async_trait]
pub trait BorrarEntrega: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarEntrega) -> Result<(), ErrorEntrega>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarEntrega {}

        #[async_trait]
        impl BorrarEntrega for BorrarEntrega {
            async fn ejecutar(&self, params: ParamsBorrarEntrega) -> Result<(), ErrorEntrega>;
        }
    }
}

pub struct BorrarEntregaImpl {
    pub repositorio: Arc<dyn RepositorioEntrega>,
    pub uow_factory: Arc<dyn UnitOfWorkFactoryEntrega>,
}

#[async_trait]
impl BorrarEntrega for BorrarEntregaImpl {
    async fn ejecutar(&self, params: ParamsBorrarEntrega) -> Result<(), ErrorEntrega> {
        tracing::info!(id = %params.id, "borrar_entrega: inicio");
        let fallido = |e: &ErrorRepositorio| tracing::error!(error = %e, "borrar_entrega: fallo del repositorio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(fallido)?
            .ok_or_else(|| {
                let err = ErrorEntrega::NoEncontrado;
                tracing::warn!(error = %err, "borrar_entrega: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        let mut uow = self.uow_factory.begin().await.inspect_err(fallido)?;
        uow.guardar(&entidad).await.inspect_err(fallido)?;
        uow.registrar(EventoEntrega::Borrado(SnapshotEntrega::from_entidad(
            &entidad,
        )))
        .await
        .inspect_err(fallido)?;
        uow.commit().await.inspect_err(fallido)?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_compra::modelo::IdCompra;
    use dominio_entrega::{
        modelo::{Entrega, IdEntrega, PropsEntrega},
        repositorio::dobles::MockRepositorioEntrega,
        unit_of_work::dobles::UnitOfWorkFactoryGrabadora,
    };
    use puerto_nucleo::EventoDominio;

    #[tokio::test]
    async fn deberia_registrar_el_evento_entrega_borrado_cuando_el_id_existe() {
        // Preparar
        let entidad = Entrega::new(PropsEntrega {
            compra_id: IdCompra::generar(),
            destinatario_id: None,
            carrier: "example".to_string(),
        })
        .unwrap();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = BorrarEntregaImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarEntrega { id: id_entidad })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert!(grabado.guardados.iter().all(|guardados| guardados.borrado));
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "entrega_borrado");
        assert_eq!(grabado.eventos[0].id_agregado(), id_entidad.valor());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_sin_registrar_nada_cuando_entrega_no_existe() {
        // Preparar
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = BorrarEntregaImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarEntrega {
                id: IdEntrega::generar(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "entrega.no_encontrado");
        assert!(uow_factory.grabado().eventos.is_empty());
    }
}

=== contextos/entrega/aplicacion/src/crear_entrega.rs ===
use async_trait::async_trait;
use dominio_compra::modelo::IdCompra;
use dominio_entrega::errores::ErrorEntrega;
use dominio_entrega::eventos::{EventoEntrega, SnapshotEntrega};
use dominio_entrega::modelo::{Entrega, PropsEntrega};
use dominio_entrega::unit_of_work::UnitOfWorkFactoryEntrega;
use dominio_proveedor::modelo::IdProveedor;
use puerto_nucleo::ErrorRepositorio;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearEntrega {
    pub compra_id: IdCompra,
    pub destinatario_id: Option<IdProveedor>,
    pub carrier: String,
}

#[async_trait]
pub trait CrearEntrega: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearEntrega) -> Result<Entrega, ErrorEntrega>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearEntrega {}

        #[async_trait]
        impl CrearEntrega for CrearEntrega {
            async fn ejecutar(&self, params: ParamsCrearEntrega) -> Result<Entrega, ErrorEntrega>;
        }
    }
}

pub struct CrearEntregaImpl {
    pub uow_factory: Arc<dyn UnitOfWorkFactoryEntrega>,
}

#[async_trait]
impl CrearEntrega for CrearEntregaImpl {
    async fn ejecutar(&self, params: ParamsCrearEntrega) -> Result<Entrega, ErrorEntrega> {
        tracing::info!("crear_entrega: inicio");
        let fallido = |e: &ErrorRepositorio| tracing::error!(error = %e, "crear_entrega: fallo del repositorio");
        let entidad = Entrega::new(PropsEntrega {
            compra_id: params.compra_id,
            destinatario_id: params.destinatario_id,
            carrier: params.carrier,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_entrega: rechazado"))?;
        let mut uow = self.uow_factory.begin().await.inspect_err(fallido)?;
        uow.guardar(&entidad).await.inspect_err(fallido)?;
        uow.registrar(EventoEntrega::Creado(SnapshotEntrega::from_entidad(
            &entidad,
        )))
        .await
        .inspect_err(fallido)?;
        uow.commit().await.inspect_err(fallido)?;
        tracing::info!(id = %entidad.id, "crear_entrega: fin");
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_compra::modelo::IdCompra;
    use dominio_entrega::unit_of_work::dobles::{FallarEn, UnitOfWorkFactoryGrabadora};
    use puerto_nucleo::EventoDominio;

    #[tokio::test]
    async fn deberia_registrar_el_evento_entrega_creado_cuando_los_campos_son_validos() {
        // Preparar
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = CrearEntregaImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEntrega {
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "example".to_string(),
            })
            .await;

        // Comprobar
        let entidad = match resultado {
            Ok(entidad) => entidad,
            Err(e) => panic!("la creación falló: {e}"),
        };
        assert_eq!(entidad.carrier, "example");
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert_eq!(grabado.guardados.len(), 1);
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "entrega_creado");
        assert_eq!(grabado.eventos[0].id_agregado(), entidad.id.valor());
    }

    #[tokio::test]
    async fn no_deberia_hacer_commit_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let uow_factory =
            UnitOfWorkFactoryGrabadora::fallando_en(FallarEn::Guardar, ErrorRepositorio::Duplicado);
        let caso_de_uso = CrearEntregaImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEntrega {
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "example".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "entrega.duplicado");
        let grabado = uow_factory.grabado();
        assert!(!grabado.confirmado);
        assert!(grabado.eventos.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_un_error_de_validacion_cuando_compra_id_no_existe() {
        // Preparar: en el almacén no hay Compra con ese id.
        let uow_factory = UnitOfWorkFactoryGrabadora::fallando_en(
            FallarEn::Guardar,
            ErrorRepositorio::ReferenciaInexistente("compra_id"),
        );
        let caso_de_uso = CrearEntregaImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEntrega {
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "example".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "entrega.validacion.compra_id_no_encontrado"
        );
        assert!(!uow_factory.grabado().confirmado);
    }

    #[tokio::test]
    async fn deberia_devolver_un_error_de_validacion_cuando_destinatario_id_no_existe() {
        // Preparar: en el almacén no hay Proveedor con ese id.
        let uow_factory = UnitOfWorkFactoryGrabadora::fallando_en(
            FallarEn::Guardar,
            ErrorRepositorio::ReferenciaInexistente("destinatario_id"),
        );
        let caso_de_uso = CrearEntregaImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEntrega {
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "example".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "entrega.validacion.destinatario_id_no_encontrado"
        );
        assert!(!uow_factory.grabado().confirmado);
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_falla_el_commit() {
        // Preparar
        let uow_factory = UnitOfWorkFactoryGrabadora::fallando_en(
            FallarEn::Commit,
            ErrorRepositorio::NoDisponible,
        );
        let caso_de_uso = CrearEntregaImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEntrega {
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "example".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "entrega.repositorio");
        assert!(!uow_factory.grabado().confirmado);
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_carrier_es_una_cadena_vacia() {
        // Preparar
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = CrearEntregaImpl {
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEntrega {
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "entrega.validacion.carrier_vacio"
        );
        assert!(uow_factory.grabado().guardados.is_empty());
    }
}

