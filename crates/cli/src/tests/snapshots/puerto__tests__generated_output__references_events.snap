import type { Page, PageRequest } from "../shared/page";
import type { Delivery, DeliveryDraft } from "./model";

/** The port the screens call. Every method rejects with the `DeliveryError` the API answered. */
export interface DeliveryRepository {
  list(page: PageRequest): Promise<Page<Delivery>>;
  get(id: string): Promise<Delivery>;
  create(draft: DeliveryDraft): Promise<Delivery>;
  update(id: string, draft: DeliveryDraft): Promise<Delivery>;
  remove(id: string): Promise<void>;
}

