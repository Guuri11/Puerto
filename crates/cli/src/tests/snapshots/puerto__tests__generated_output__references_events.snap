}

=== contextos/compra/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_compra::{
    actualizar_compra::{ActualizarCompra, ParamsActualizarCompra},
    borrar_compra::{BorrarCompra, ParamsBorrarCompra},
    crear_compra::{CrearCompra, ParamsCrearCompra},
    listar_compras::{ListarCompras, ParamsListarCompras},
    obtener_compra::{ObtenerCompra, ParamsObtenerCompra},
};
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoCompra, DtoPaginaCompra, PeticionActualizarCompra, PeticionCrearCompra};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarCompra, RespuestaBorrarCompra, RespuestaCrearCompra, RespuestaListarCompras,
    RespuestaObtenerCompra,
};

#[derive(Tags)]
enum ApiTags {
    Compra,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiCompra {
    pub crear_compra: Arc<dyn CrearCompra>,
    pub obtener_compra: Arc<dyn ObtenerCompra>,
    pub listar_compras: Arc<dyn ListarCompras>,
    pub actualizar_compra: Arc<dyn ActualizarCompra>,
    pub borrar_compra: Arc<dyn BorrarCompra>,
}

#[OpenApi]
impl ApiCompra {
    /// Crea: Compra
    #[oai(path = "/compras", method = "post", tag = "ApiTags::Compra")]
    async fn crear(&self, cuerpo: Json<PeticionCrearCompra>) -> RespuestaCrearCompra {
        match self
            .crear_compra
            .ejecutar(ParamsCrearCompra {
                proveedor_id: IdProveedor::from_uuid(cuerpo.proveedor_id),
                approver_id: cuerpo.approver_id.map(IdProveedor::from_uuid),
                total: cuerpo.total,
            })
            .await
        {
            Ok(entidad) => RespuestaCrearCompra::Creado(Json(DtoCompra::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_compra falló");
                RespuestaCrearCompra::from_status(status, error)
            }
        }
    }

    /// Obtiene: Compra por id
    #[oai(path = "/compras/:id", method = "get", tag = "ApiTags::Compra")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerCompra {
        match self
            .obtener_compra
            .ejecutar(ParamsObtenerCompra {
                id: IdCompra::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerCompra::Ok(Json(DtoCompra::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_compra falló");
                RespuestaObtenerCompra::from_status(status, error)
            }
        }
    }

    /// Lista Compras, página a página (el dominio acota `limite`)
    #[oai(path = "/compras", method = "get", tag = "ApiTags::Compra")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
        #[oai(name = "proveedorId")] proveedor_id: Query<Option<Uuid>>,
        #[oai(name = "approverId")] approver_id: Query<Option<Uuid>>,
    ) -> RespuestaListarCompras {
        match self
            .listar_compras
            .ejecutar(ParamsListarCompras {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
                proveedor_id: proveedor_id.0.map(IdProveedor::from_uuid),
                approver_id: approver_id.0.map(IdProveedor::from_uuid),
            })
            .await
        {
            Ok(pagina) => RespuestaListarCompras::Ok(Json(DtoPaginaCompra::from_dominio(&pagina))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_compras falló");
                RespuestaListarCompras::from_status(status, error)
            }
        }
    }

    /// Actualiza: Compra
    #[oai(path = "/compras/:id", method = "put", tag = "ApiTags::Compra")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarCompra>,
    ) -> RespuestaActualizarCompra {
        match self
            .actualizar_compra
            .ejecutar(ParamsActualizarCompra {
                id: IdCompra::from_uuid(id.0),
                proveedor_id: IdProveedor::from_uuid(cuerpo.proveedor_id),
                approver_id: cuerpo.approver_id.map(IdProveedor::from_uuid),
                total: cuerpo.total,
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarCompra::Ok(Json(DtoCompra::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_compra falló");
                RespuestaActualizarCompra::from_status(status, error)
            }
        }
    }

    /// Borra: Compra
    #[oai(path = "/compras/:id", method = "delete", tag = "ApiTags::Compra")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarCompra {
        match self
            .borrar_compra
            .ejecutar(ParamsBorrarCompra {
                id: IdCompra::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarCompra::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_compra falló");
                RespuestaBorrarCompra::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_compra::{
        actualizar_compra::dobles::MockActualizarCompra, borrar_compra::dobles::MockBorrarCompra,
        crear_compra::dobles::MockCrearCompra, listar_compras::dobles::MockListarCompras,
        obtener_compra::dobles::MockObtenerCompra,
    };
    use dominio_compra::errores::ErrorCompra;
    use dominio_compra::pruebas::madres::MadreCompra;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearCompra,
        obtener: MockObtenerCompra,
        listar: MockListarCompras,
        actualizar: MockActualizarCompra,
        borrar: MockBorrarCompra,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiCompra {
                crear_compra: Arc::new(self.crear),
                obtener_compra: Arc::new(self.obtener),
                listar_compras: Arc::new(self.listar),
                actualizar_compra: Arc::new(self.actualizar),
                borrar_compra: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearCompra {
        PeticionCrearCompra {
            proveedor_id: Uuid::new_v4(),
            approver_id: None,
            total: 42,
        }
    }

    fn peticion_actualizar() -> PeticionActualizarCompra {
        PeticionActualizarCompra {
            proveedor_id: Uuid::new_v4(),
            approver_id: None,
            total: 42,
        }
    }

    fn ruta_elemento() -> String {
        format!("/compras/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_compra() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreCompra::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/compras")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_compra_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorCompra::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/compras")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_no_existe_la_referencia_de_proveedor_id() {
        // Preparar: en la base de datos no hay Proveedor con ese id (ADR-0022 de Puerto).
        let mut dobles = Dobles::default();
        dobles.crear.expect_ejecutar().returning(|_| {
            Err(ErrorCompra::Validacion(
                "proveedor_id_no_encontrado".to_string(),
            ))
        });

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/compras")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("compra.validacion.proveedor_id_no_encontrado");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_no_existe_la_referencia_de_approver_id() {
        // Preparar: en la base de datos no hay Proveedor con ese id (ADR-0022 de Puerto).
        let mut dobles = Dobles::default();
        dobles.crear.expect_ejecutar().returning(|_| {
            Err(ErrorCompra::Validacion(
                "approver_id_no_encontrado".to_string(),
            ))
        });

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/compras")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("compra.validacion.approver_id_no_encontrado");
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_compra_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreCompra::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_compra_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorCompra::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_compras_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreCompra::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/compras").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/compras?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_por_proveedor_id_al_caso_de_uso() {
        // Preparar
        let proveedor_id = Uuid::new_v4();
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(move |params| params.proveedor_id == Some(IdProveedor::from_uuid(proveedor_id)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get(format!("/compras?proveedorId={proveedor_id}"))
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_por_approver_id_al_caso_de_uso() {
        // Preparar
        let approver_id = Uuid::new_v4();
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(move |params| params.approver_id == Some(IdProveedor::from_uuid(approver_id)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get(format!("/compras?approverId={approver_id}"))
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCompra::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/compras").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_compra() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreCompra::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_compra_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCompra::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_compra() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_compra_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCompra::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

