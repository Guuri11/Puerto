=== presentation/src/api/supplier/routes.rs ===
use std::sync::Arc;

use business::domain::supplier::model::SupplierId;
use business::domain::supplier::use_cases::{
    create_supplier::{CreateSupplierParams, CreateSupplierUseCaseTrait},
    delete_supplier::{DeleteSupplierParams, DeleteSupplierUseCaseTrait},
    get_supplier::{GetSupplierParams, GetSupplierUseCaseTrait},
    list_suppliers::{ListSuppliersParams, ListSuppliersUseCaseTrait},
    update_supplier::{UpdateSupplierParams, UpdateSupplierUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::supplier::dto::{
    CreateSupplierRequest, SupplierDto, SupplierPageDto, UpdateSupplierRequest,
};
use crate::api::supplier::responses::{
    CreateSupplierResponse, DeleteSupplierResponse, GetSupplierResponse, ListSuppliersResponse,
    UpdateSupplierResponse,
};
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct SupplierApi {
    pub create_supplier: Arc<dyn CreateSupplierUseCaseTrait>,
    pub get_supplier: Arc<dyn GetSupplierUseCaseTrait>,
    pub list_suppliers: Arc<dyn ListSuppliersUseCaseTrait>,
    pub update_supplier: Arc<dyn UpdateSupplierUseCaseTrait>,
    pub delete_supplier: Arc<dyn DeleteSupplierUseCaseTrait>,
}

#[OpenApi]
impl SupplierApi {
    /// Create a new Supplier
    #[oai(path = "/suppliers", method = "post", tag = "ApiTags::Supplier")]
    async fn create(&self, body: Json<CreateSupplierRequest>) -> CreateSupplierResponse {
        match self
            .create_supplier
            .execute(CreateSupplierParams {
                name: body.name.clone(),
                email: body.email.clone(),
            })
            .await
        {
            Ok(entity) => CreateSupplierResponse::Created(Json(SupplierDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_supplier failed");
                CreateSupplierResponse::from_status(status, error)
            }
        }
    }

    /// Get a Supplier by ID
    #[oai(path = "/suppliers/:id", method = "get", tag = "ApiTags::Supplier")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetSupplierResponse {
        match self
            .get_supplier
            .execute(GetSupplierParams {
                id: SupplierId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetSupplierResponse::Ok(Json(SupplierDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_supplier failed");
                GetSupplierResponse::from_status(status, error)
            }
        }
    }

    /// List Suppliers, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/suppliers", method = "get", tag = "ApiTags::Supplier")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
    ) -> ListSuppliersResponse {
        match self
            .list_suppliers
            .execute(ListSuppliersParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListSuppliersResponse::Ok(Json(SupplierPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_suppliers failed");
                ListSuppliersResponse::from_status(status, error)
            }
        }
    }

    /// Update a Supplier
    #[oai(path = "/suppliers/:id", method = "put", tag = "ApiTags::Supplier")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdateSupplierRequest>,
    ) -> UpdateSupplierResponse {
        match self
            .update_supplier
            .execute(UpdateSupplierParams {
                id: SupplierId::from_uuid(id.0),
                name: body.name.clone(),
                email: body.email.clone(),
            })
            .await
        {
            Ok(entity) => UpdateSupplierResponse::Ok(Json(SupplierDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_supplier failed");
                UpdateSupplierResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Supplier
    #[oai(path = "/suppliers/:id", method = "delete", tag = "ApiTags::Supplier")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteSupplierResponse {
        match self
            .delete_supplier
            .execute(DeleteSupplierParams {
                id: SupplierId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteSupplierResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_supplier failed");
                DeleteSupplierResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::supplier::errors::SupplierError;
    use business::domain::supplier::use_cases::{
        create_supplier::mocks::MockCreateSupplierUseCase,
        delete_supplier::mocks::MockDeleteSupplierUseCase,
        get_supplier::mocks::MockGetSupplierUseCase,
        list_suppliers::mocks::MockListSuppliersUseCase,
        update_supplier::mocks::MockUpdateSupplierUseCase,
    };
    use business::tests::mothers::supplier_mother::SupplierMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateSupplierUseCase,
        get: MockGetSupplierUseCase,
        list: MockListSuppliersUseCase,
        update: MockUpdateSupplierUseCase,
        delete: MockDeleteSupplierUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = SupplierApi {
                create_supplier: Arc::new(self.create),
                get_supplier: Arc::new(self.get),
                list_suppliers: Arc::new(self.list),
                update_supplier: Arc::new(self.update),
                delete_supplier: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateSupplierRequest {
        CreateSupplierRequest {
            name: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn update_request() -> UpdateSupplierRequest {
        UpdateSupplierRequest {
            name: "example".to_string(),
            email: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/suppliers/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_supplier_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(SupplierMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/suppliers")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_supplier_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(SupplierError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/suppliers")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_supplier_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(SupplierMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_supplier_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(SupplierError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_suppliers_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(SupplierMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/suppliers").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/suppliers?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(SupplierError::RepositoryError));

        // Act
        let response = mocks.client().get("/suppliers").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_supplier_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(SupplierMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_supplier() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(SupplierError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_supplier_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_supplier() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(SupplierError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

