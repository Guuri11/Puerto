        }

        async fn record(&mut self, event: PurchaseEvent) -> Result<(), RepositoryError> {
            lock(&self.factory.recorded).events.push(event);
            Ok(())
        }

        async fn commit(self: Box<Self>) -> Result<(), RepositoryError> {
            self.factory.fail_at(FailAt::Commit)?;
            lock(&self.factory.recorded).committed = true;
            Ok(())
        }
    }

    #[async_trait]
    impl PurchaseUnitOfWorkFactory for RecordingUnitOfWorkFactory {
        async fn begin(&self) -> Result<Box<dyn PurchaseUnitOfWork>, RepositoryError> {
            self.fail_at(FailAt::Begin)?;
            Ok(Box::new(RecordingUnitOfWork {
                factory: self.clone(),
            }))
        }
    }
}

