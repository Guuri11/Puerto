import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCompra, MadreCompra } from "../../../pruebas/compra";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaCompra } from "./lista-compra";

describe("ContenedorListaCompra", () => {
  test("debería mostrar una fila por cada compra", async () => {
    // Preparar
    const semilla = [MadreCompra.aleatorio(), MadreCompra.aleatorio()];
    const api = apiFalsa([coleccionCompra(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaCompra />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreCompra.aleatorio());
    const api = apiFalsa([coleccionCompra(semilla)]);
    renderizarPantalla(<ContenedorListaCompra />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreCompra.aleatorio());
    const api = apiFalsa([coleccionCompra(semilla)]);
    const ruta = "/compras?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaCompra />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay compras", async () => {
    // Preparar
    const api = apiFalsa([coleccionCompra()]);

    // Actuar
    renderizarPantalla(<ContenedorListaCompra />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay compras.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /compras": "compra.repositorio" };
    const api = apiFalsa([coleccionCompra()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaCompra />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("compra.repositorio");
  });
});

=== web/src/contextos/compra/contenedores/lista-compra.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaCompra } from "../vistas/lista-compra";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaCompra() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const compras = useCarga(
    () => desenvolver(api.GET("/compras", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Compras</h1>
        <Link href="/compras/nuevo" className="btn btn-primary">
          Crear compra
        </Link>
      </div>
      {compras.estado === "cargando" && <span className="loading loading-spinner" />}
      {compras.estado === "error" && <AlertaError error={compras.error} />}
      {compras.estado === "listo" &&
        (compras.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay compras." />
        ) : (
          <>
            <VistaListaCompra compras={compras.datos.elementos} />
            <Paginacion
              total={compras.datos.total}
              limite={compras.datos.limite}
              desplazamiento={compras.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/compra/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaCompra {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "compra.validacion.proveedor_id_no_encontrado": "Proveedor: no existe",
  "compra.validacion.approver_id_no_encontrado": "Approver: no existe",
  "compra.duplicado": "Estos valores ya están en uso",
  "compra.no_encontrado": "Ya no existe",
  "compra.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "compra.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "compra.validacion.proveedor_id_no_encontrado": "proveedorId",
  "compra.validacion.approver_id_no_encontrado": "approverId",
};

export function aProblema(codigo: string): ProblemaCompra {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

