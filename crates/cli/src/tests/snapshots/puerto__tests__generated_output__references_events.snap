import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakeProveedorRepository, ProveedorMother } from "../../../../test-support/proveedor";
import { renderScreen } from "../../../../test-support/render";
import { ProveedorDetailContainer } from "./proveedor-detail-container";

describe("ProveedorDetailContainer", () => {
  test("should show the proveedor when it exists", async () => {
    // Arrange
    const seeded = ProveedorMother.random();
    const proveedorRepository = fakeProveedorRepository([seeded]);

    // Act
    renderScreen(<ProveedorDetailContainer id={seeded.id} />, { proveedorRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the proveedor does not exist", async () => {
    // Arrange
    const proveedorRepository = fakeProveedorRepository();

    // Act
    renderScreen(<ProveedorDetailContainer id={crypto.randomUUID()} />, {
      proveedorRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("proveedor.no_encontrado");
  });

  test("should delete the proveedor only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ProveedorMother.random();
    const fake = fakeProveedorRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<ProveedorDetailContainer id={seeded.id} />, {
      proveedorRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/proveedores"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/proveedor/containers/proveedor-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ProveedorDetailView } from "../views/proveedor-detail-view";

export function ProveedorDetailContainer({ id }: { id: string }) {
  const { proveedorRepository } = useDependencies();
  const proveedor = useAsync(() => proveedorRepository.get(id), [proveedorRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await proveedorRepository.remove(id);
      navigate("/proveedores");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Proveedor</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {proveedor.status === "loading" && <span className="loading loading-spinner" />}
      {proveedor.status === "error" && <ErrorAlert error={proveedor.error} />}
      {proveedor.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ProveedorDetailView proveedor={proveedor.data} />
            <div className="card-actions justify-end">
              <Link href={`/proveedores/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/proveedores" className="link">
        Back to proveedores
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this proveedor?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

