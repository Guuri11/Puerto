use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::delivery::{
    errors::DeliveryError,
    model::Delivery,
    repository::{DeliveryFilter, DeliveryRepositoryTrait},
    use_cases::list_deliveries::{ListDeliveriesParams, ListDeliveriesUseCaseTrait},
};

pub struct ListDeliveriesUseCaseImpl {
    pub repository: Arc<dyn DeliveryRepositoryTrait>,
}

#[async_trait]
impl ListDeliveriesUseCaseTrait for ListDeliveriesUseCaseImpl {
    async fn execute(&self, params: ListDeliveriesParams) -> Result<Page<Delivery>, DeliveryError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_deliveries: start"
        );
        self.repository
            .find_all(
                params.page,
                DeliveryFilter {
                    purchase_id: params.purchase_id,
                },
            )
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_deliveries: repository failed"))
            .map_err(DeliveryError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::delivery::{
        model::{Delivery, DeliveryProps},
        repository::mocks::MockDeliveryRepository,
    };
    use crate::domain::purchase::model::PurchaseId;
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_deliveries() {
        let entities = vec![
            Delivery::new(DeliveryProps {
                purchase_id: PurchaseId::generate(),
                carrier: "first".to_string(),
            })
            .unwrap(),
            Delivery::new(DeliveryProps {
                purchase_id: PurchaseId::generate(),
                carrier: "second".to_string(),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockDeliveryRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page, _| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListDeliveriesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListDeliveriesParams {
                page: PageRequest::default(),
                purchase_id: None,
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_deliveries_exist() {
        let mut mock_repo = MockDeliveryRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListDeliveriesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListDeliveriesParams {
                page: PageRequest::default(),
                purchase_id: None,
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockDeliveryRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page, _| page.limit() == 5 && page.offset() == 10)
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListDeliveriesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListDeliveriesParams {
                page: PageRequest::new(Some(5), Some(10)),
                purchase_id: None,
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }

    #[tokio::test]
    async fn should_pass_the_filter_to_the_repository() {
        let filter = DeliveryFilter {
            purchase_id: Some(PurchaseId::generate()),
        };
        let mut mock_repo = MockDeliveryRepository::new();
        mock_repo
            .expect_find_all()
            .withf(move |_, f| *f == filter)
            .returning(|page, _| Ok(Page::new(vec![], 0, page)));
        let use_case = ListDeliveriesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListDeliveriesParams {
                page: PageRequest::default(),
                purchase_id: filter.purchase_id,
            })
            .await;

        assert!(result.is_ok());
    }
}

=== business/src/application/delivery/update_delivery.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::delivery::{
    errors::DeliveryError,
    events::{DeliveryEvent, DeliverySnapshot},
    model::Delivery,
    repository::DeliveryRepositoryTrait,
    unit_of_work::DeliveryUnitOfWorkFactory,
    use_cases::update_delivery::{UpdateDeliveryParams, UpdateDeliveryUseCaseTrait},
};

pub struct UpdateDeliveryUseCaseImpl {
    pub repository: Arc<dyn DeliveryRepositoryTrait>,
    pub uow_factory: Arc<dyn DeliveryUnitOfWorkFactory>,
}

#[async_trait]
impl UpdateDeliveryUseCaseTrait for UpdateDeliveryUseCaseImpl {
    async fn execute(&self, params: UpdateDeliveryParams) -> Result<Delivery, DeliveryError> {
        tracing::info!(id = %params.id, "update_delivery: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "update_delivery: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = DeliveryError::NotFound;
                tracing::warn!(error = %err, "update_delivery: rejected");
                err
            })?;
        if params.carrier.trim().is_empty() {
            let err = DeliveryError::ValidationError("carrier_empty".into());
            tracing::warn!(error = %err, "update_delivery: rejected");
            return Err(err);
        }
        entity.purchase_id = params.purchase_id;
        entity.carrier = params.carrier;
        entity.updated_at = chrono::Utc::now();
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(DeliveryEvent::Updated(DeliverySnapshot::from_entity(
            &entity,
        )))
        .await
        .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(entity)
    }
}

