import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleEntrega } from "../vistas/detalle-entrega";

export function ContenedorDetalleEntrega({ id }: { id: string }) {
  const { api } = useDependencias();
  const entrega = useCarga(
    () => desenvolver(api.GET("/entregas/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/entregas/{id}", { params: { path: { id } } }));
      navegar("/entregas");
    } catch (error) {
      setFallo(error);
    }
  };
  const etiquetaCompra = async (objetivo: string) => {
    const params = { path: { id: objetivo } };
    const encontrado = await desenvolver(api.GET("/compras/{id}", { params }));
    return encontrado.id;
  };
  const etiquetaProveedor = async (objetivo: string) => {
    const params = { path: { id: objetivo } };
    const encontrado = await desenvolver(api.GET("/proveedores/{id}", { params }));
    return encontrado.name;
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Entrega</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {entrega.estado === "cargando" && <span className="loading loading-spinner" />}
      {entrega.estado === "error" && <AlertaError error={entrega.error} />}
      {entrega.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleEntrega
              entrega={entrega.datos}
              etiquetaCompra={etiquetaCompra}
              etiquetaProveedor={etiquetaProveedor}
            />
            <div className="card-actions justify-end">
              <Link href={`/entregas/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/entregas" className="link">
        Volver a entregas
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar entrega?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

