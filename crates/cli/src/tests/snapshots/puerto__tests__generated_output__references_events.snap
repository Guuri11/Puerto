import { EntregaError } from "../../domain/entrega/errors";
import type { Entrega, EntregaDraft } from "../../domain/entrega/model";
import type { EntregaRepository } from "../../domain/entrega/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type EntregaDto = components["schemas"]["DtoEntrega"];
type EntregaRequest = components["schemas"]["PeticionCrearEntrega"];

function toEntrega(dto: EntregaDto): Entrega {
  return {
    id: dto.id,
    compraId: dto.compraId,
    destinatarioId: dto.destinatarioId ?? null,
    carrier: dto.carrier,
  };
}

function toRequest(draft: EntregaDraft): EntregaRequest {
  return {
    compraId: draft.compraId,
    destinatarioId: draft.destinatarioId ?? undefined,
    carrier: draft.carrier,
  };
}

/** `EntregaRepository` over the REST API (`/entregas`). */
export function entregaRepositoryHttp(api: ApiClient): EntregaRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/entregas", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new EntregaError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toEntrega),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/entregas/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new EntregaError(apiErrorCode(error, response));
      return toEntrega(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/entregas", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new EntregaError(apiErrorCode(error, response));
      return toEntrega(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/entregas/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new EntregaError(apiErrorCode(error, response));
      return toEntrega(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/entregas/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new EntregaError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `RespuestaError.codigo` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "codigo" in error) {
    const { codigo } = error;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${response.status}`;
}

