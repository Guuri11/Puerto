import { ProveedorError } from "../../domain/proveedor/errors";
import type { Proveedor, ProveedorDraft } from "../../domain/proveedor/model";
import type { ProveedorRepository } from "../../domain/proveedor/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ProveedorDto = components["schemas"]["DtoProveedor"];
type ProveedorRequest = components["schemas"]["PeticionCrearProveedor"];

function toProveedor(dto: ProveedorDto): Proveedor {
  return {
    id: dto.id,
    name: dto.name,
    email: dto.email,
  };
}

function toRequest(draft: ProveedorDraft): ProveedorRequest {
  return {
    name: draft.name,
    email: draft.email,
  };
}

/** `ProveedorRepository` over the REST API (`/proveedores`). */
export function proveedorRepositoryHttp(api: ApiClient): ProveedorRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/proveedores", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new ProveedorError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toProveedor),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/proveedores/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ProveedorError(apiErrorCode(error, response));
      return toProveedor(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/proveedores", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new ProveedorError(apiErrorCode(error, response));
      return toProveedor(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/proveedores/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ProveedorError(apiErrorCode(error, response));
      return toProveedor(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/proveedores/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ProveedorError(apiErrorCode(error, response));
    },
  };
}

