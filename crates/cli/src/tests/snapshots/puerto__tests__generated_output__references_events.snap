[package]
name = "aplicacion_entrega"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_entrega = { workspace = true }
puerto-nucleo = { workspace = true }
dominio_compra = { workspace = true }
dominio_proveedor = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_entrega/pruebas"]

[dev-dependencies]
dominio_entrega = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/entrega/aplicacion/src/actualizar_entrega.rs ===
use async_trait::async_trait;
use dominio_compra::modelo::IdCompra;
use dominio_entrega::errores::ErrorEntrega;
use dominio_entrega::eventos::{EventoEntrega, SnapshotEntrega};
use dominio_entrega::modelo::{Entrega, IdEntrega};
use dominio_entrega::repositorio::RepositorioEntrega;
use dominio_entrega::unit_of_work::UnitOfWorkFactoryEntrega;
use dominio_proveedor::modelo::IdProveedor;
use puerto_nucleo::ErrorRepositorio;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsActualizarEntrega {
    pub id: IdEntrega,
    pub compra_id: IdCompra,
    pub destinatario_id: Option<IdProveedor>,
    pub carrier: String,
}

#[async_trait]
pub trait ActualizarEntrega: Send + Sync {
    async fn ejecutar(&self, params: ParamsActualizarEntrega) -> Result<Entrega, ErrorEntrega>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarEntrega {}

        #[async_trait]
        impl ActualizarEntrega for ActualizarEntrega {
            async fn ejecutar(&self, params: ParamsActualizarEntrega) -> Result<Entrega, ErrorEntrega>;
        }
    }
}

pub struct ActualizarEntregaImpl {
    pub repositorio: Arc<dyn RepositorioEntrega>,
    pub uow_factory: Arc<dyn UnitOfWorkFactoryEntrega>,
}

#[async_trait]
impl ActualizarEntrega for ActualizarEntregaImpl {
    async fn ejecutar(&self, params: ParamsActualizarEntrega) -> Result<Entrega, ErrorEntrega> {
        tracing::info!(id = %params.id, "actualizar_entrega: inicio");
        let fallido = |e: &ErrorRepositorio| tracing::error!(error = %e, "actualizar_entrega: fallo del repositorio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(fallido)?
            .ok_or_else(|| {
                let err = ErrorEntrega::NoEncontrado;
                tracing::warn!(error = %err, "actualizar_entrega: rechazado");
                err
            })?;
        if params.carrier.trim().is_empty() {
            let err = ErrorEntrega::Validacion("carrier_vacio".into());
            tracing::warn!(error = %err, "actualizar_entrega: rechazado");
            return Err(err);
        }
        entidad.compra_id = params.compra_id;
        entidad.destinatario_id = params.destinatario_id;
        entidad.carrier = params.carrier;
        entidad.actualizado_en = chrono::Utc::now();
        let mut uow = self.uow_factory.begin().await.inspect_err(fallido)?;
        uow.guardar(&entidad).await.inspect_err(fallido)?;
        uow.registrar(EventoEntrega::Actualizado(SnapshotEntrega::from_entidad(
            &entidad,
        )))
        .await
        .inspect_err(fallido)?;
        uow.commit().await.inspect_err(fallido)?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_compra::modelo::IdCompra;
    use dominio_entrega::{
        modelo::{IdEntrega, PropsEntrega},
        repositorio::dobles::MockRepositorioEntrega,
        unit_of_work::dobles::UnitOfWorkFactoryGrabadora,
    };
    use puerto_nucleo::EventoDominio;

    fn repositorio_con(entidad: Entrega) -> MockRepositorioEntrega {
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble
    }

    #[tokio::test]
    async fn deberia_registrar_el_evento_entrega_actualizado_cuando_los_parametros_son_validos() {
        // Preparar
        let entidad = Entrega::new(PropsEntrega {
            compra_id: IdCompra::generar(),
            destinatario_id: None,
            carrier: "original".to_string(),
        })
        .unwrap();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarEntregaImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarEntrega {
                id: id_entidad,
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "updated".to_string(),
            })
            .await;

        // Comprobar
        assert_eq!(resultado.unwrap().carrier, "updated");
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "entrega_actualizado");
        assert_eq!(grabado.eventos[0].id_agregado(), id_entidad.valor());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_sin_registrar_nada_cuando_entrega_no_existe() {
        // Preparar
        let mut repositorio_doble = MockRepositorioEntrega::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarEntregaImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarEntrega {
                id: IdEntrega::generar(),
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "new".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "entrega.no_encontrado");
        let grabado = uow_factory.grabado();
        assert!(grabado.guardados.is_empty());
        assert!(grabado.eventos.is_empty());
    }

    #[tokio::test]
    async fn deberia_devolver_error_sin_registrar_nada_cuando_carrier_es_una_cadena_vacia() {
        // Preparar
        let entidad = Entrega::new(PropsEntrega {
            compra_id: IdCompra::generar(),
            destinatario_id: None,
            carrier: "original".to_string(),
        })
        .unwrap();
        let id_entidad = entidad.id;
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = ActualizarEntregaImpl {
            repositorio: Arc::new(repositorio_con(entidad)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarEntrega {
                id: id_entidad,
                compra_id: IdCompra::generar(),
                destinatario_id: None,
                carrier: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "entrega.validacion.carrier_vacio"
        );
        assert!(uow_factory.grabado().guardados.is_empty());
    }
}

