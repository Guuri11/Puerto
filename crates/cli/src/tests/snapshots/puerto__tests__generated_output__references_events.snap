            .execute(CreateSupplierParams {
                name: "example".to_string(),
                email: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "supplier.validation_error.email_empty"
        );
        assert!(uow_factory.recorded().saved.is_empty());
    }

