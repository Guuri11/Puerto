use crate::errores::ErrorProveedor;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorProveedor> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorProveedor::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

