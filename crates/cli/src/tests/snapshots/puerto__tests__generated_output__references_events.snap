import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCompra, MadreCompra } from "../../../pruebas/compra";
import { coleccionEntrega, MadreEntrega } from "../../../pruebas/entrega";
import { coleccionProveedor, MadreProveedor } from "../../../pruebas/proveedor";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleEntrega } from "./detalle-entrega";

describe("ContenedorDetalleEntrega", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreEntrega.aleatorio();
    const api = apiFalsa([coleccionEntrega([sembrado])]);

    const pantalla = <ContenedorDetalleEntrega id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería enlazar Compra con su página y su etiqueta", async () => {
    // Preparar
    const sembrado = MadreEntrega.aleatorio();
    const objetivo = MadreCompra.aleatorio({ id: sembrado.compraId });
    const api = apiFalsa([coleccionEntrega([sembrado]), coleccionCompra([objetivo])]);
    const pantalla = <ContenedorDetalleEntrega id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/compras/${sembrado.compraId}"]`;
    expect(await screen.findByText(objetivo.id, { selector })).toBeTruthy();
  });

  test("debería enlazar Destinatario con su página y su etiqueta", async () => {
    // Preparar
    const sembrado = MadreEntrega.aleatorio();
    const objetivo = MadreProveedor.aleatorio({
      id: sembrado.destinatarioId ?? crypto.randomUUID(),
    });
    const api = apiFalsa([coleccionEntrega([sembrado]), coleccionProveedor([objetivo])]);
    const pantalla = <ContenedorDetalleEntrega id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/proveedores/${sembrado.destinatarioId}"]`;
    expect(await screen.findByText(objetivo.name, { selector })).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionEntrega()]);
    const pantalla = <ContenedorDetalleEntrega id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("entrega.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreEntrega.aleatorio();
    const guardados = coleccionEntrega([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleEntrega id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/entregas"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

