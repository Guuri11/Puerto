        let use_case = UpdateDeliveryUseCaseImpl {
            repository: Arc::new(repository_holding(entity)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(UpdateDeliveryParams {
                id: entity_id,
                purchase_id: PurchaseId::generate(),
                carrier: "updated".to_string(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().carrier, "updated");
        let recorded = uow_factory.recorded();
        assert!(recorded.committed);
        assert_eq!(recorded.events.len(), 1);
        assert_eq!(recorded.events[0].event_type(), "delivery_updated");
        assert_eq!(recorded.events[0].aggregate_id(), entity_id.value());
    }

    #[tokio::test]
    async fn should_return_not_found_and_record_nothing_when_the_delivery_does_not_exist() {
        // Arrange
        let mut mock_repo = MockDeliveryRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = UpdateDeliveryUseCaseImpl {
            repository: Arc::new(mock_repo),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(UpdateDeliveryParams {
                id: DeliveryId::generate(),
                purchase_id: PurchaseId::generate(),
                carrier: "new".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "delivery.not_found");
        let recorded = uow_factory.recorded();
        assert!(recorded.saved.is_empty());
        assert!(recorded.events.is_empty());
    }

    #[tokio::test]
    async fn should_return_error_and_record_nothing_when_carrier_is_empty() {
        // Arrange
        let entity = Delivery::new(DeliveryProps {
            purchase_id: PurchaseId::generate(),
            carrier: "original".to_string(),
        })
        .unwrap();
        let entity_id = entity.id;
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = UpdateDeliveryUseCaseImpl {
            repository: Arc::new(repository_holding(entity)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(UpdateDeliveryParams {
                id: entity_id,
                purchase_id: PurchaseId::generate(),
                carrier: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "delivery.validation_error.carrier_empty"
        );
        assert!(uow_factory.recorded().saved.is_empty());
    }
}

