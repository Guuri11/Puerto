use dominio_proveedor::modelo::Proveedor;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoProveedor {
    pub id: Uuid,
    pub name: String,
    pub email: String,
}

impl DtoProveedor {
    pub fn from_dominio(entidad: &Proveedor) -> Self {
        Self {
            id: entidad.id.valor(),
            name: entidad.name.valor().to_string(),
            email: entidad.email.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearProveedor {
    pub name: String,
    pub email: String,
}

/// Una página de Proveedores: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaProveedor {
    pub elementos: Vec<DtoProveedor>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaProveedor {
    pub fn from_dominio(pagina: &Pagina<Proveedor>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoProveedor::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarProveedor {
    pub name: String,
    pub email: String,
}

=== contextos/proveedor/rest/src/errores.rs ===
use dominio_proveedor::errores::ErrorProveedor;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de proveedor como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorProveedor) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorProveedor::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorProveedor::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorProveedor::Duplicado => StatusCode::CONFLICT,
        ErrorProveedor::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorProveedor::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorProveedor::NameInvalido => StatusCode::UNPROCESSABLE_ENTITY,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorProveedor::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "proveedor.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorProveedor::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "proveedor.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorProveedor::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "proveedor.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorProveedor::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "proveedor.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorProveedor::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "proveedor.desconocido");
    }

    #[test]
    fn deberia_mapear_name_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorProveedor::NameInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "proveedor.name_invalido");
    }
}

