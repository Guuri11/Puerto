import type { Esquemas } from "../../../api/cliente";
import { EnlaceReferencia } from "../../../compartido/ui/enlace-referencia";

type Compra = Esquemas["DtoCompra"];

/** `compra`, y cómo se cargan las etiquetas de lo que referencia, para sus enlaces. */
export function VistaDetalleCompra({
