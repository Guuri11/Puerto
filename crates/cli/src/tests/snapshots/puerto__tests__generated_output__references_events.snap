import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { CompraError } from "../../../../domain/compra/errors";
import { CompraMother, fakeCompraRepository } from "../../../../test-support/compra";
import { renderScreen } from "../../../../test-support/render";
import { CompraListContainer } from "./compra-list-container";

describe("CompraListContainer", () => {
  test("should show a row per compra when there are some", async () => {
    // Arrange
    const seed = [CompraMother.random(), CompraMother.random()];
    const compraRepository = fakeCompraRepository(seed);

    // Act
    renderScreen(<CompraListContainer />, { compraRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => CompraMother.random());
    const compraRepository = fakeCompraRepository(seed);
    renderScreen(<CompraListContainer />, { compraRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => CompraMother.random());
    const compraRepository = fakeCompraRepository(seed);
    const path = "/compras?page=2";

    // Act
    renderScreen(<CompraListContainer />, { compraRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no compra", async () => {
    // Arrange
    const compraRepository = fakeCompraRepository();

    // Act
    renderScreen(<CompraListContainer />, { compraRepository });

    // Assert
    expect(await screen.findByText("No compras yet.")).toBeTruthy();
  });

  test("should show the error code when the compras cannot be listed", async () => {
    // Arrange
    const compraRepository = {
      ...fakeCompraRepository(),
      list: () => Promise.reject(new CompraError("compra.repositorio")),
    };

    // Act
    renderScreen(<CompraListContainer />, { compraRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("compra.repositorio");
  });
});

=== web/src/presentation/features/compra/containers/compra-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { CompraListView } from "../views/compra-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function CompraListContainer() {
  const { compraRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const compras = useAsync(
    () => compraRepository.list({ limit: PAGE_SIZE, offset }),
    [compraRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Compras</h1>
        <Link href="/compras/new" className="btn btn-primary">
          New compra
        </Link>
      </div>
      {compras.status === "loading" && <span className="loading loading-spinner" />}
      {compras.status === "error" && <ErrorAlert error={compras.error} />}
      {compras.status === "ok" &&
        (compras.data.total === 0 ? (
          <EmptyState message="No compras yet." />
        ) : (
          <>
            <CompraListView compras={compras.data.items} />
            <Pagination {...compras.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

