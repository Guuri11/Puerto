import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/supplier/messages";
import type { Supplier } from "../../../../domain/supplier/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { SupplierFormView, toSupplierDraft, toSupplierForm } from "../views/supplier-form-view";

/** Creates a supplier, or edits the one with `id`. */
export function SupplierFormContainer({ id }: { id?: string }) {
  const { supplierRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : supplierRepository.get(id)),
    [supplierRepository, id],
  );
  const title = id === undefined ? "New supplier" : "Edit supplier";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <SupplierForm existing={existing.data} />}
      <Link href={id === undefined ? "/suppliers" : `/suppliers/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function SupplierForm({ existing }: { existing: Supplier | null }) {
  const { supplierRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toSupplierForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toSupplierDraft(values);
      const saved =
        existing === null
          ? await supplierRepository.create(draft)
          : await supplierRepository.update(existing.id, draft);
      navigate(`/suppliers/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <SupplierFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

