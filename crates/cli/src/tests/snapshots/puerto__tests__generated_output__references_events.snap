use dominio_compra::modelo::Compra;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoCompra {
    pub id: Uuid,
    pub proveedor_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

impl DtoCompra {
    pub fn from_dominio(entidad: &Compra) -> Self {
        Self {
            id: entidad.id.valor(),
            proveedor_id: entidad.proveedor_id.valor(),
            approver_id: entidad.approver_id.map(|v| v.valor()),
            total: entidad.total,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearCompra {
    pub proveedor_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

/// Una página de Compras: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaCompra {
    pub elementos: Vec<DtoCompra>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaCompra {
    pub fn from_dominio(pagina: &Pagina<Compra>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoCompra::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarCompra {
    pub proveedor_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

=== contextos/compra/rest/src/errores.rs ===
use dominio_compra::errores::ErrorCompra;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de compra como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorCompra) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorCompra::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCompra::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorCompra::Duplicado => StatusCode::CONFLICT,
        ErrorCompra::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorCompra::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) =
            a_respuesta_error(ErrorCompra::Validacion("nombre_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "compra.validacion.nombre_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCompra::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "compra.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCompra::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "compra.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCompra::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "compra.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCompra::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "compra.desconocido");
    }
}

