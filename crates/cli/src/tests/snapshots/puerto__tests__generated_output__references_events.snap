import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { renderScreen } from "../../../../test-support/render";
import { fakeSupplierRepository, SupplierMother } from "../../../../test-support/supplier";
import { SupplierDetailContainer } from "./supplier-detail-container";

describe("SupplierDetailContainer", () => {
  test("should show the supplier when it exists", async () => {
    // Arrange
    const seeded = SupplierMother.random();
    const supplierRepository = fakeSupplierRepository([seeded]);

    // Act
    renderScreen(<SupplierDetailContainer id={seeded.id} />, { supplierRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the supplier does not exist", async () => {
    // Arrange
    const supplierRepository = fakeSupplierRepository();

    // Act
    renderScreen(<SupplierDetailContainer id={crypto.randomUUID()} />, { supplierRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("supplier.not_found");
  });

  test("should delete the supplier only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = SupplierMother.random();
    const fake = fakeSupplierRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<SupplierDetailContainer id={seeded.id} />, {
      supplierRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/suppliers"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/supplier/containers/supplier-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { SupplierDetailView } from "../views/supplier-detail-view";

export function SupplierDetailContainer({ id }: { id: string }) {
  const { supplierRepository } = useDependencies();
  const supplier = useAsync(() => supplierRepository.get(id), [supplierRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await supplierRepository.remove(id);
      navigate("/suppliers");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Supplier</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {supplier.status === "loading" && <span className="loading loading-spinner" />}
      {supplier.status === "error" && <ErrorAlert error={supplier.error} />}
      {supplier.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <SupplierDetailView supplier={supplier.data} />
            <div className="card-actions justify-end">
              <Link href={`/suppliers/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/suppliers" className="link">
        Back to suppliers
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this supplier?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

