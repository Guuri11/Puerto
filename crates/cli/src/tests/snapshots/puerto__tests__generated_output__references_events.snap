=== web/src/presentation/features/entrega/views/entrega-form-view.tsx ===
import type { EntregaProblem } from "../../../../domain/entrega/messages";
import type { Entrega, EntregaDraft } from "../../../../domain/entrega/model";
import { type ReferenceOption, textOf, textOrNull } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface EntregaFormValues {
  compraId: string;
  destinatarioId: string;
  carrier: string;
}

/** The inputs for `entrega`, empty when there is none yet. */
export function toEntregaForm(entrega: Entrega | null): EntregaFormValues {
  if (entrega === null) {
    return {
      compraId: "",
      destinatarioId: "",
      carrier: "",
    };
  }
  return {
    compraId: entrega.compraId,
    destinatarioId: textOf(entrega.destinatarioId),
    carrier: entrega.carrier,
  };
}

/** What each reference's select offers. */
export interface EntregaFormOptions {
  compraId: ReferenceOption[];
  destinatarioId: ReferenceOption[];
}

export function toEntregaDraft(values: EntregaFormValues): EntregaDraft {
  return {
    compraId: values.compraId,
    destinatarioId: textOrNull(values.destinatarioId),
    carrier: values.carrier,
  };
}

export function EntregaFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: EntregaFormValues;
  options: EntregaFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: EntregaProblem | null;
  onChange: (values: EntregaFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Compra</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "compraId"}
          required
          value={values.compraId}
          onChange={(event) => onChange({ ...values, compraId: event.target.value })}
        >
          <option value="">Choose a compra</option>
          {options.compraId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="compraId" />
      <label className="fieldset">
        <span className="fieldset-legend">Destinatario</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "destinatarioId"}
          value={values.destinatarioId}
          onChange={(event) => onChange({ ...values, destinatarioId: event.target.value })}
        >
          <option value="">None</option>
          {options.destinatarioId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="destinatarioId" />
      <label className="fieldset">
        <span className="fieldset-legend">Carrier</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "carrier"}
          required
          value={values.carrier}
          onChange={(event) => onChange({ ...values, carrier: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="carrier" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

