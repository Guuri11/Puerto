=== web/src/presentation/features/compra/views/compra-form-view.tsx ===
import type { CompraProblem } from "../../../../domain/compra/messages";
import type { Compra, CompraDraft } from "../../../../domain/compra/model";
import { type ReferenceOption, textOf, textOrNull } from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface CompraFormValues {
  proveedorId: string;
  approverId: string;
  total: string;
}

/** The inputs for `compra`, empty when there is none yet. */
export function toCompraForm(compra: Compra | null): CompraFormValues {
  if (compra === null) {
    return {
      proveedorId: "",
      approverId: "",
      total: "",
    };
  }
  return {
    proveedorId: compra.proveedorId,
    approverId: textOf(compra.approverId),
    total: String(compra.total),
  };
}

/** What each reference's select offers. */
export interface CompraFormOptions {
  proveedorId: ReferenceOption[];
  approverId: ReferenceOption[];
}

export function toCompraDraft(values: CompraFormValues): CompraDraft {
  return {
    proveedorId: values.proveedorId,
    approverId: textOrNull(values.approverId),
    total: Number(values.total),
  };
}

export function CompraFormView({
  values,
  options,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: CompraFormValues;
  options: CompraFormOptions;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: CompraProblem | null;
  onChange: (values: CompraFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Proveedor</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "proveedorId"}
          required
          value={values.proveedorId}
          onChange={(event) => onChange({ ...values, proveedorId: event.target.value })}
        >
          <option value="">Choose a proveedor</option>
          {options.proveedorId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="proveedorId" />
      <label className="fieldset">
        <span className="fieldset-legend">Approver</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "approverId"}
          value={values.approverId}
          onChange={(event) => onChange({ ...values, approverId: event.target.value })}
        >
          <option value="">None</option>
          {options.approverId.map((option) => (
            <option key={option.id} value={option.id}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      <FieldError problem={problem} field="approverId" />
      <label className="fieldset">
        <span className="fieldset-legend">Total</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "total"}
          required
          value={values.total}
          onChange={(event) => onChange({ ...values, total: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="total" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

