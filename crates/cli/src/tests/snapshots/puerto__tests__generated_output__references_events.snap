=== infrastructure/migrations/<version>_outbox.sql ===
-- Puerto migration: outbox
-- Run `make sqlx/prepare` after editing this file.

-- Domain events (ADR-0018): written by puerto. The units of work insert into `outbox` in the same
-- transaction as the entity; the worker relays it and records what it could not deliver.

CREATE TABLE outbox (
    id             UUID        PRIMARY KEY,
    seq            BIGSERIAL   NOT NULL,          -- relay order
    aggregate_type TEXT        NOT NULL,
    aggregate_id   UUID        NOT NULL,
    event_type     TEXT        NOT NULL,
    schema_version INT         NOT NULL,
    payload        JSONB       NOT NULL,
    headers        JSONB       NOT NULL DEFAULT '{}',
    occurred_at    TIMESTAMPTZ NOT NULL,
    published_at   TIMESTAMPTZ
);
CREATE INDEX outbox_unpublished ON outbox (seq) WHERE published_at IS NULL;

CREATE TABLE event_deliveries (                  -- db transport only
    event_id        UUID        NOT NULL REFERENCES outbox (id),
    consumer        TEXT        NOT NULL,
    status          TEXT        NOT NULL DEFAULT 'pending',   -- pending | done | dead
    attempts        INT         NOT NULL DEFAULT 0,
    next_attempt_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    last_error      TEXT,
    PRIMARY KEY (event_id, consumer)
);
CREATE INDEX event_deliveries_due ON event_deliveries (consumer, next_attempt_at) WHERE status = 'pending';

CREATE TABLE dead_letters (                      -- every transport
    id           UUID        PRIMARY KEY,
    event_id     UUID,
    consumer     TEXT        NOT NULL,
    event_type   TEXT,
    attempts     INT         NOT NULL,
    reason       TEXT        NOT NULL,
    detail       TEXT        NOT NULL,
    payload      TEXT        NOT NULL,           -- trimmed to 4000 chars
    recorded_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);
-- One dead letter per event and consumer, so a redelivered failure is not recorded twice. A
-- message that was not an envelope has no event_id: NULLs never conflict.
CREATE UNIQUE INDEX dead_letters_event_consumer ON dead_letters (event_id, consumer);

=== infrastructure/src/db.rs ===
//! The database adapter — pool, migrations at startup, readiness ping, driver-error mapping — is
//! `puerto-sqlx`'s (ADR-0017 of Puerto). Only the migrations are this project's.
pub use puerto_sqlx::*;

/// `infrastructure/migrations/`, embedded at compile time and applied at startup by `bootstrap.rs`.
pub static MIGRATOR: sqlx::migrate::Migrator = sqlx::migrate!("./migrations");

=== infrastructure/src/delivery/entity.rs ===
use business::domain::purchase::model::PurchaseId;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use business::domain::delivery::{
    errors::DeliveryError,
    model::{Delivery, DeliveryId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct DeliveryDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub purchase_id: Uuid,
    pub carrier: String,
}

impl TryFrom<DeliveryDb> for Delivery {
    type Error = DeliveryError;

    fn try_from(row: DeliveryDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Delivery {
            id: DeliveryId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            purchase_id: PurchaseId::from_uuid(row.purchase_id),
            carrier: row.carrier,
        }))
    }
}

impl From<&Delivery> for DeliveryDb {
    fn from(entity: &Delivery) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            purchase_id: entity.purchase_id.value(),
            carrier: entity.carrier.clone(),
        }
    }
}

=== infrastructure/src/delivery/repository.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::delivery::{
    model::{Delivery, DeliveryId},
    repository::{DeliveryFilter, DeliveryRepositoryTrait},
};
use puerto_core::{Page, PageRequest, RepositoryError};

use super::entity::DeliveryDb;
use crate::db::map_sqlx_error;

pub struct PgDeliveryRepository {
    pub pool: PgPool,
}

impl PgDeliveryRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: DeliveryDb) -> Result<Delivery, RepositoryError> {
    Delivery::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid delivery");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl DeliveryRepositoryTrait for PgDeliveryRepository {
    async fn find_all(
        &self,
        page: PageRequest,
        filter: DeliveryFilter,
    ) -> Result<Page<Delivery>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        // One static query whatever the filter: an unset id is NULL and matches every row.
        let purchase_id = filter.purchase_id.map(|id| id.value());
        let rows = sqlx::query_as!(
            DeliveryDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, purchase_id, carrier
             FROM deliveries WHERE deleted = false AND ($3::uuid IS NULL OR purchase_id = $3)
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limit()),
            i64::from(page.offset()),
            purchase_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM deliveries WHERE deleted = false AND ($1::uuid IS NULL OR purchase_id = $1)"#,
            purchase_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            map_sqlx_error(&e)
        })?;

        let items = rows
            .into_iter()
            .map(to_domain)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: DeliveryId) -> Result<Option<Delivery>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            DeliveryDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, purchase_id, carrier
             FROM deliveries WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }
}

/// `pub(crate)`: an entity that references Delivery seeds its rows with this module's `seed`.
#[cfg(test)]
pub(crate) mod integration_tests {
    use super::*;
    use business::domain::delivery::model::DeliveryProps;
    use business::domain::delivery::unit_of_work::DeliveryUnitOfWorkFactory;

    use crate::delivery::unit_of_work::PgDeliveryUnitOfWorkFactory;

    fn test_repo(pool: PgPool) -> PgDeliveryRepository {
        PgDeliveryRepository::new(pool)
    }

    /// The repository only reads: rows are written through the unit of work.
    async fn store(pool: &PgPool, entity: &Delivery) {
        let mut uow = PgDeliveryUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.save(entity).await.unwrap();
        uow.commit().await.unwrap();
    }

    /// A valid delivery, not stored: the rows it references are seeded first.
    async fn build(pool: &PgPool) -> Delivery {
        Delivery::new(DeliveryProps {
            purchase_id: crate::purchase::repository::integration_tests::seed(pool)
                .await
                .id,
            carrier: "example".to_string(),
        })
        .unwrap()
    }

    /// A stored delivery.
    pub(crate) async fn seed(pool: &PgPool) -> Delivery {
        let entity = build(pool).await;
        store(pool, &entity).await;
        entity
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.purchase_id, entity.purchase_id);
        assert_eq!(found.carrier, entity.carrier);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool)
            .find_by_id(DeliveryId::generate())
            .await
            .unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_deliveries_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        store(&pool, &deleted).await;

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::default(), DeliveryFilter::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::new(Some(2), Some(2)),
                DeliveryFilter::default(),
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_only_the_deliveries_of_the_requested_purchase_id(pool: PgPool) {
        // Arrange: one delivery with this purchase_id, one without.
        let target = crate::purchase::repository::integration_tests::seed(&pool).await;
        let mut wanted = build(&pool).await;
        wanted.purchase_id = target.id;
        store(&pool, &wanted).await;
        seed(&pool).await;

        // Act
        let page = test_repo(pool)
            .find_all(
                PageRequest::default(),
                DeliveryFilter {
                    purchase_id: Some(target.id),
                },
            )
            .await
            .unwrap();

        // Assert
        assert_eq!(
            page.items.iter().map(|row| row.id).collect::<Vec<_>>(),
            vec![wanted.id]
        );
        assert_eq!(page.total, 1);
    }
}

=== infrastructure/src/delivery/unit_of_work.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::delivery::{
    events::DeliveryEvent,
    model::Delivery,
    unit_of_work::{DeliveryUnitOfWork, DeliveryUnitOfWorkFactory},
};
use puerto_core::RepositoryError;
use puerto_sqlx::uow::PgTransaction;

use super::entity::DeliveryDb;
use crate::db::{ForeignKey, map_sqlx_error_with};

/// Opens a Postgres transaction per write: the delivery row and its outbox event commit together.
pub struct PgDeliveryUnitOfWorkFactory {
    pub pool: PgPool,
}

impl PgDeliveryUnitOfWorkFactory {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// The foreign keys a write goes through (ADR-0022 of Puerto): the database rejects a reference to
/// a row that does not exist, and the field it names is the caller's error.
const REFERENCES: &[ForeignKey] = &[ForeignKey {
    constraint: "deliveries_purchase_id_fkey",
    field: "purchase_id",
}];

#[async_trait]
impl DeliveryUnitOfWorkFactory for PgDeliveryUnitOfWorkFactory {
    async fn begin(&self) -> Result<Box<dyn DeliveryUnitOfWork>, RepositoryError> {
        let tx = PgTransaction::begin(&self.pool).await?;
        Ok(Box::new(PgDeliveryUnitOfWork { tx }))
    }
}

struct PgDeliveryUnitOfWork {
    tx: PgTransaction,
}

#[async_trait]
impl DeliveryUnitOfWork for PgDeliveryUnitOfWork {
    async fn save(&mut self, entity: &Delivery) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = DeliveryDb::from(entity);
        sqlx::query!(
            "INSERT INTO deliveries (id, created_at, updated_at, deleted, deleted_at, purchase_id, carrier)
             VALUES ($1, $2, $3, $4, $5, $6, $7)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, purchase_id = $6, carrier = $7",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.purchase_id,
            db.carrier,
        )
        .execute(self.tx.tx())
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error_with(&e, REFERENCES)
        })?;
        Ok(())
    }

    async fn record(&mut self, event: DeliveryEvent) -> Result<(), RepositoryError> {
        self.tx.record(&event).await
    }

    async fn commit(self: Box<Self>) -> Result<(), RepositoryError> {
        self.tx.commit().await
    }
}

#[cfg(test)]
mod integration_tests {
    use super::*;
    use business::domain::delivery::{
        events::DeliverySnapshot, model::DeliveryProps, repository::DeliveryRepositoryTrait,
    };

    use crate::delivery::repository::PgDeliveryRepository;
    use business::domain::purchase::model::PurchaseId;

    async fn new_delivery(pool: &PgPool) -> Delivery {
        Delivery::new(DeliveryProps {
            purchase_id: crate::purchase::repository::integration_tests::seed(pool)
                .await
                .id,
            carrier: "example".to_string(),
        })
        .unwrap()
    }

    /// What a create use case does: save, record, commit.
    async fn create(pool: &PgPool, entity: &Delivery) -> Result<(), RepositoryError> {
        let mut uow = PgDeliveryUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await?;
        uow.save(entity).await?;
        uow.record(DeliveryEvent::Created(DeliverySnapshot::from_entity(
            entity,
        )))
        .await?;
        uow.commit().await
    }

    async fn count(pool: &PgPool, sql: &str) -> i64 {
        sqlx::query_scalar(sql).fetch_one(pool).await.unwrap()
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_the_delivery_and_its_event_when_committed(pool: PgPool) {
        // Arrange
        let entity = new_delivery(&pool).await;

        // Act
        create(&pool, &entity).await.unwrap();

        // Assert
        let found = PgDeliveryRepository::new(pool.clone())
            .find_by_id(entity.id)
            .await
            .unwrap();
        assert!(found.is_some());
        let (event_type, aggregate_id): (String, uuid::Uuid) =
            sqlx::query_as("SELECT event_type, aggregate_id FROM outbox")
                .fetch_one(&pool)
                .await
                .unwrap();
        assert_eq!(event_type, "delivery_created");
        assert_eq!(aggregate_id, entity.id.value());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_nothing_when_dropped_without_commit(pool: PgPool) {
        // Arrange
        let entity = new_delivery(&pool).await;

        // Act
        {
            let mut uow = PgDeliveryUnitOfWorkFactory::new(pool.clone())
                .begin()
                .await
                .unwrap();
            uow.save(&entity).await.unwrap();
            uow.record(DeliveryEvent::Created(DeliverySnapshot::from_entity(
                &entity,
            )))
            .await
            .unwrap();
        }

        // Assert
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM deliveries").await, 0);
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_the_delivery_when_saved_again(pool: PgPool) {
        // Arrange
        let mut entity = new_delivery(&pool).await;
        create(&pool, &entity).await.unwrap();
        entity.carrier = "updated".to_string();
        entity.updated_at = chrono::Utc::now();

        // Act
        let mut uow = PgDeliveryUnitOfWorkFactory::new(pool.clone())
            .begin()
            .await
            .unwrap();
        uow.save(&entity).await.unwrap();
        uow.commit().await.unwrap();

        // Assert
        let found = PgDeliveryRepository::new(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(found.carrier, "updated");
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_write_neither_row_nor_event_when_the_purchase_id_is_taken(pool: PgPool) {
        // Arrange
        let first = new_delivery(&pool).await;
        create(&pool, &first).await.unwrap();
        let mut second = new_delivery(&pool).await;
        second.purchase_id = first.purchase_id;

        // Act
        let result = create(&pool, &second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM deliveries").await, 1);
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_missing_purchase_id(pool: PgPool) {
        // Arrange: a purchase_id no row has.
        let mut entity = new_delivery(&pool).await;
        entity.purchase_id = PurchaseId::generate();

        // Act
        let result = create(&pool, &entity).await;

        // Assert
        assert_eq!(
            result.unwrap_err(),
            RepositoryError::MissingReference("purchase_id")
        );
        assert_eq!(count(&pool, "SELECT COUNT(*) FROM outbox").await, 0);
    }
}

