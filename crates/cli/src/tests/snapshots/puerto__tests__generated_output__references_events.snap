=== web/src/infrastructure/compra/compra-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { CompraError } from "../../domain/compra/errors";
import { CompraMother } from "../../test-support/compra";
import { createApiClient } from "../http/client";
import { compraRepositoryHttp } from "./compra-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: compraRepositoryHttp(api), requests };
}

describe("compraRepositoryHttp", () => {
  test("should ask for the page and return its compras", async () => {
    // Arrange
    const compra = CompraMother.random();
    const { repository, requests } = answering(200, {
      elementos: [compra],
      total: 21,
      limite: 20,
      desplazamiento: 20,
    });

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    const url = new URL(requests[0]?.url ?? "");
    expect(url.pathname).toBe("/api/compras");
    expect(url.search).toBe("?limite=20&desplazamiento=20");
    expect(listed).toEqual({ items: [compra], total: 21, limit: 20, offset: 20 });
  });

  test("should send the draft when creating a compra", async () => {
    // Arrange
    const draft = CompraMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the compra does not exist", async () => {
    // Arrange
    const code = "compra.no_encontrado";
    const { repository } = answering(404, { codigo: code, mensaje: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(CompraError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the compra", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/compras/42");
  });
});

=== web/src/infrastructure/compra/compra-repository-http.ts ===
import { CompraError } from "../../domain/compra/errors";
import type { Compra, CompraDraft } from "../../domain/compra/model";
import type { CompraRepository } from "../../domain/compra/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type CompraDto = components["schemas"]["DtoCompra"];
type CompraRequest = components["schemas"]["PeticionCrearCompra"];

function toCompra(dto: CompraDto): Compra {
  return {
    id: dto.id,
    proveedorId: dto.proveedorId,
    approverId: dto.approverId ?? null,
    total: dto.total,
  };
}

function toRequest(draft: CompraDraft): CompraRequest {
  return {
    proveedorId: draft.proveedorId,
    approverId: draft.approverId ?? undefined,
    total: draft.total,
  };
}

/** `CompraRepository` over the REST API (`/compras`). */
export function compraRepositoryHttp(api: ApiClient): CompraRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/compras", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new CompraError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toCompra),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/compras/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new CompraError(apiErrorCode(error, response));
      return toCompra(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/compras", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new CompraError(apiErrorCode(error, response));
      return toCompra(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/compras/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new CompraError(apiErrorCode(error, response));
      return toCompra(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/compras/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new CompraError(apiErrorCode(error, response));
    },
  };
}

