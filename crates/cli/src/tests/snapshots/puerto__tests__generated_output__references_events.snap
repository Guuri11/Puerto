use business::domain::purchase::model::Purchase;
use poem_openapi::Object;
use puerto_core::Page;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PurchaseDto {
    pub id: Uuid,
    pub supplier_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

impl PurchaseDto {
    pub fn from_domain(entity: &Purchase) -> Self {
        Self {
            id: entity.id.value(),
            supplier_id: entity.supplier_id.value(),
            approver_id: entity.approver_id.map(|v| v.value()),
            total: entity.total,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreatePurchaseRequest {
    pub supplier_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

/// One page of Purchases: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PurchasePageDto {
    pub items: Vec<PurchaseDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl PurchasePageDto {
    pub fn from_domain(page: &Page<Purchase>) -> Self {
        Self {
            items: page.items.iter().map(PurchaseDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdatePurchaseRequest {
    pub supplier_id: Uuid,
    pub approver_id: Option<Uuid>,
    pub total: i64,
}

