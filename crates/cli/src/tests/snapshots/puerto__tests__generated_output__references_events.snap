use async_trait::async_trait;
use dominio_compra::errores::ErrorCompra;
use dominio_compra::modelo::Compra;
use dominio_compra::repositorio::{FiltroCompra, RepositorioCompra};
use dominio_proveedor::modelo::IdProveedor;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarCompras {
    pub pagina: PeticionPagina,
    /// Si se indica, solo compras con este `proveedor_id`.
    pub proveedor_id: Option<IdProveedor>,
    /// Si se indica, solo compras con este `approver_id`.
    pub approver_id: Option<IdProveedor>,
}

#[async_trait]
pub trait ListarCompras: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarCompras) -> Result<Pagina<Compra>, ErrorCompra>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarCompras {}

        #[async_trait]
        impl ListarCompras for ListarCompras {
            async fn ejecutar(&self, params: ParamsListarCompras) -> Result<Pagina<Compra>, ErrorCompra>;
        }
    }
}

pub struct ListarComprasImpl {
    pub repositorio: Arc<dyn RepositorioCompra>,
}

#[async_trait]
impl ListarCompras for ListarComprasImpl {
    async fn ejecutar(&self, params: ParamsListarCompras) -> Result<Pagina<Compra>, ErrorCompra> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_compras: inicio"
        );
        self.repositorio
            .buscar_todos(
                params.pagina,
                FiltroCompra {
                    proveedor_id: params.proveedor_id,
                    approver_id: params.approver_id,
                },
            )
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_compras: fallo del repositorio"))
            .map_err(ErrorCompra::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_compra::{
        pruebas::madres::MadreCompra, repositorio::dobles::MockRepositorioCompra,
    };
    use dominio_proveedor::modelo::IdProveedor;
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_compras() {
        let entidades = MadreCompra::aleatorios(2);
        let mut repositorio_doble = MockRepositorioCompra::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina, _| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarComprasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCompras {
                pagina: PeticionPagina::default(),
                proveedor_id: None,
                approver_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_compras() {
        let mut repositorio_doble = MockRepositorioCompra::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarComprasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCompras {
                pagina: PeticionPagina::default(),
                proveedor_id: None,
                approver_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioCompra::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina, _| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarComprasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCompras {
                pagina: PeticionPagina::new(Some(5), Some(10)),
                proveedor_id: None,
                approver_id: None,
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_al_repositorio() {
        let filtro = FiltroCompra {
            proveedor_id: Some(IdProveedor::generar()),
            approver_id: Some(IdProveedor::generar()),
        };
        let mut repositorio_doble = MockRepositorioCompra::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(move |_, f| *f == filtro)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarComprasImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCompras {
                pagina: PeticionPagina::default(),
                proveedor_id: filtro.proveedor_id,
                approver_id: filtro.approver_id,
            })
            .await;

        assert!(resultado.is_ok());
    }
}

