            async fn ejecutar(&self, params: ParamsBorrarProveedor) -> Result<(), ErrorProveedor>;
        }
    }
}

pub struct BorrarProveedorImpl {
    pub repositorio: Arc<dyn RepositorioProveedor>,
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProveedor>,
}

#[async_trait]
impl BorrarProveedor for BorrarProveedorImpl {
    async fn ejecutar(&self, params: ParamsBorrarProveedor) -> Result<(), ErrorProveedor> {
        tracing::info!(id = %params.id, "borrar_proveedor: inicio");
        let fallido = |e: &ErrorRepositorio| tracing::error!(error = %e, "borrar_proveedor: fallo del repositorio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(fallido)?
            .ok_or_else(|| {
                let err = ErrorProveedor::NoEncontrado;
                tracing::warn!(error = %err, "borrar_proveedor: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        let mut uow = self.uow_factory.begin().await.inspect_err(fallido)?;
        uow.guardar(&entidad).await.inspect_err(fallido)?;
        uow.registrar(EventoProveedor::Borrado(SnapshotProveedor::from_entidad(
            &entidad,
        )))
        .await
        .inspect_err(fallido)?;
        uow.commit().await.inspect_err(fallido)?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_proveedor::{
        modelo::IdProveedor, pruebas::madres::MadreProveedor,
        repositorio::dobles::MockRepositorioProveedor,
        unit_of_work::dobles::UnitOfWorkFactoryGrabadora,
    };
    use puerto_nucleo::EventoDominio;

    #[tokio::test]
    async fn deberia_registrar_el_evento_proveedor_borrado_cuando_el_id_existe() {
        // Preparar
        let entidad = MadreProveedor::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProveedor::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let uow_factory = UnitOfWorkFactoryGrabadora::new();
        let caso_de_uso = BorrarProveedorImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarProveedor { id: id_entidad })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let grabado = uow_factory.grabado();
        assert!(grabado.confirmado);
        assert!(grabado.guardados.iter().all(|guardados| guardados.borrado));
        assert_eq!(grabado.eventos.len(), 1);
        assert_eq!(grabado.eventos[0].tipo_evento(), "proveedor_borrado");
        assert_eq!(grabado.eventos[0].id_agregado(), id_entidad.valor());
    }

