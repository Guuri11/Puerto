import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CompraMother, fakeCompraRepository } from "../../../../test-support/compra";
import { renderScreen } from "../../../../test-support/render";
import { CompraDetailContainer } from "./compra-detail-container";

describe("CompraDetailContainer", () => {
  test("should show the compra when it exists", async () => {
    // Arrange
    const seeded = CompraMother.random();
    const compraRepository = fakeCompraRepository([seeded]);

    // Act
    renderScreen(<CompraDetailContainer id={seeded.id} />, { compraRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the proveedor to its page", async () => {
    // Arrange
    const seeded = CompraMother.random();
    const compraRepository = fakeCompraRepository([seeded]);

    // Act
    renderScreen(<CompraDetailContainer id={seeded.id} />, { compraRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.proveedorId });
    expect(link.getAttribute("href")).toBe(`/proveedores/${seeded.proveedorId}`);
  });

  test("should link the approver to its page", async () => {
    // Arrange
    const seeded = CompraMother.random();
    const compraRepository = fakeCompraRepository([seeded]);

    // Act
    renderScreen(<CompraDetailContainer id={seeded.id} />, { compraRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.approverId ?? "" });
    expect(link.getAttribute("href")).toBe(`/proveedores/${seeded.approverId}`);
  });

  test("should show the not-found code when the compra does not exist", async () => {
    // Arrange
    const compraRepository = fakeCompraRepository();

    // Act
    renderScreen(<CompraDetailContainer id={crypto.randomUUID()} />, {
      compraRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("compra.no_encontrado");
  });

  test("should delete the compra only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = CompraMother.random();
    const fake = fakeCompraRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<CompraDetailContainer id={seeded.id} />, {
      compraRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/compras"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/compra/containers/compra-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { CompraDetailView } from "../views/compra-detail-view";

export function CompraDetailContainer({ id }: { id: string }) {
  const { compraRepository } = useDependencies();
  const compra = useAsync(() => compraRepository.get(id), [compraRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await compraRepository.remove(id);
      navigate("/compras");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Compra</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {compra.status === "loading" && <span className="loading loading-spinner" />}
      {compra.status === "error" && <ErrorAlert error={compra.error} />}
      {compra.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <CompraDetailView compra={compra.data} />
            <div className="card-actions justify-end">
              <Link href={`/compras/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/compras" className="link">
        Back to compras
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this compra?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/compra/containers/compra-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CompraError } from "../../../../domain/compra/errors";
import type { CompraDraft } from "../../../../domain/compra/model";
import { CompraMother, fakeCompraRepository } from "../../../../test-support/compra";
import { fakeProveedorRepository, ProveedorMother } from "../../../../test-support/proveedor";
import { renderScreen } from "../../../../test-support/render";
import { textOf } from "../../../shared/forms";
import { CompraFormContainer } from "./compra-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Picks `id` in a reference's select, once its targets have loaded. */
async function choose(label: string, id: string) {
  const select = screen.getByLabelText(label);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** The repositories the selects read, holding what `draft` references. */
function referencedBy(draft: CompraDraft) {
  return {
    proveedorRepository: fakeProveedorRepository([
      ProveedorMother.random({ id: draft.proveedorId }),
      ProveedorMother.random({ id: draft.approverId ?? crypto.randomUUID() }),
    ]),
  };
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: CompraDraft) {
  await screen.findByText("Save");
  await choose("Proveedor", draft.proveedorId);
  await choose("Approver", textOf(draft.approverId));
  type("Total", String(draft.total));
}

describe("CompraFormContainer", () => {
  test("should create the compra from what was typed and show it", async () => {
    // Arrange
    const draft = CompraMother.draft();
    const compraRepository = fakeCompraRepository();
    const { history } = renderScreen(<CompraFormContainer />, {
      compraRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/compras/"));
    const {
      items: [created],
    } = await compraRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/compras/${created?.id}`);
  });

  test("should save the edited compra when an existing one is submitted", async () => {
    // Arrange
    const seeded = CompraMother.random();
    const compraRepository = fakeCompraRepository([seeded]);
    const { history } = renderScreen(<CompraFormContainer id={seeded.id} />, {
      compraRepository,
      ...referencedBy(seeded),
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/compras/${seeded.id}`));
    expect(await compraRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "compra.validacion.invalid";
    const compraRepository = {
      ...fakeCompraRepository(),
      create: () => Promise.reject(new CompraError(code)),
    };
    const draft = CompraMother.draft();
    renderScreen(<CompraFormContainer />, {
      compraRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a compra with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const compraRepository = {
      ...fakeCompraRepository(),
      create: () => Promise.reject(new CompraError("compra.duplicado")),
    };
    const draft = CompraMother.draft();
    renderScreen(<CompraFormContainer />, {
      compraRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A compra with these values already exists",
    );
  });

  test("should offer every proveedor in the selects that reference one", async () => {
    // Arrange
    const proveedor = ProveedorMother.random();

    // Act
    renderScreen(<CompraFormContainer />, {
      compraRepository: fakeCompraRepository(),
      proveedorRepository: fakeProveedorRepository([proveedor]),
    });

    // Assert
    const options = await screen.findAllByRole("option", { name: proveedor.name });
    expect(options).toHaveLength(2);
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const compraRepository = {
      ...fakeCompraRepository(),
      create: () => Promise.reject(new CompraError("compra.validacion.proveedor_id_no_encontrado")),
    };
    const draft = CompraMother.draft();
    renderScreen(<CompraFormContainer />, {
      compraRepository,
      ...referencedBy(draft),
    });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Proveedor does not exist")).toBeTruthy();
    const input = screen.getByLabelText("Proveedor");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/compra/containers/compra-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/compra/messages";
import type { Compra } from "../../../../domain/compra/model";
import { MAX_PAGE_LIMIT } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { referenceOptions } from "../../../shared/forms";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { CompraFormView, toCompraDraft, toCompraForm } from "../views/compra-form-view";

/** Creates a compra, or edits the one with `id`. */
export function CompraFormContainer({ id }: { id?: string }) {
  const { compraRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : compraRepository.get(id)),
    [compraRepository, id],
  );
  const title = id === undefined ? "New compra" : "Edit compra";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <CompraForm existing={existing.data} />}
      <Link href={id === undefined ? "/compras" : `/compras/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function CompraForm({ existing }: { existing: Compra | null }) {
  const { compraRepository, proveedorRepository } = useDependencies();
  const proveedores = useAsync(
    () => proveedorRepository.list({ limit: MAX_PAGE_LIMIT, offset: 0 }),
    [proveedorRepository],
  );
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toCompraForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toCompraDraft(values);
      const saved =
        existing === null
          ? await compraRepository.create(draft)
          : await compraRepository.update(existing.id, draft);
      navigate(`/compras/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        {proveedores.status === "error" && <ErrorAlert error={proveedores.error} />}
        <CompraFormView
          values={values}
          options={{
            proveedorId: referenceOptions(proveedores, (proveedor) => proveedor.name),
            approverId: referenceOptions(proveedores, (proveedor) => proveedor.name),
          }}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

