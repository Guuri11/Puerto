use chrono::{DateTime, Utc};
use dominio_compra::modelo::IdCompra;
use dominio_proveedor::modelo::IdProveedor;
use uuid::Uuid;

use crate::errores::ErrorEntrega;

/// El id de cada `Entrega`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdEntrega(Uuid);

impl IdEntrega {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdEntrega {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsEntrega {
    pub compra_id: IdCompra,
    pub destinatario_id: Option<IdProveedor>,
    pub carrier: String,
}

#[derive(Debug, Clone)]
pub struct Entrega {
    pub id: IdEntrega,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub compra_id: IdCompra,
    pub destinatario_id: Option<IdProveedor>,
    pub carrier: String,
}

impl Entrega {
    pub fn new(props: PropsEntrega) -> Result<Self, ErrorEntrega> {
        if props.carrier.trim().is_empty() {
            return Err(ErrorEntrega::Validacion("carrier_vacio".into()));
        }
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdEntrega::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            compra_id: props.compra_id,
            destinatario_id: props.destinatario_id,
            carrier: props.carrier,
        })
    }

    pub fn from_repositorio(datos: Entrega) -> Self {
        datos
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_crear_entrega_cuando_los_campos_son_validos() {
        let resultado = Entrega::new(PropsEntrega {
            compra_id: IdCompra::generar(),
            destinatario_id: None,
            carrier: "example".to_string(),
        });
        assert_eq!(resultado.unwrap().carrier, "example");
    }

    #[test]
    fn deberia_rechazar_entrega_cuando_carrier_es_una_cadena_vacia() {
        let resultado = Entrega::new(PropsEntrega {
            compra_id: IdCompra::generar(),
            destinatario_id: None,
            carrier: "".into(),
        });
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "entrega.validacion.carrier_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_entrega_cuando_carrier_solo_tiene_espacios() {
        let resultado = Entrega::new(PropsEntrega {
            compra_id: IdCompra::generar(),
            destinatario_id: None,
            carrier: "   ".into(),
        });
        assert!(resultado.is_err());
    }
}

