import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakePurchaseRepository, PurchaseMother } from "../../../../test-support/purchase";
import { renderScreen } from "../../../../test-support/render";
import { PurchaseDetailContainer } from "./purchase-detail-container";

describe("PurchaseDetailContainer", () => {
  test("should show the purchase when it exists", async () => {
    // Arrange
    const seeded = PurchaseMother.random();
    const purchaseRepository = fakePurchaseRepository([seeded]);

    // Act
    renderScreen(<PurchaseDetailContainer id={seeded.id} />, { purchaseRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should link the supplier to its page", async () => {
    // Arrange
    const seeded = PurchaseMother.random();
    const purchaseRepository = fakePurchaseRepository([seeded]);

    // Act
    renderScreen(<PurchaseDetailContainer id={seeded.id} />, { purchaseRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.supplierId });
    expect(link.getAttribute("href")).toBe(`/suppliers/${seeded.supplierId}`);
  });

  test("should link the approver to its page", async () => {
    // Arrange
    const seeded = PurchaseMother.random();
    const purchaseRepository = fakePurchaseRepository([seeded]);

    // Act
    renderScreen(<PurchaseDetailContainer id={seeded.id} />, { purchaseRepository });

    // Assert
    const link = await screen.findByRole("link", { name: seeded.approverId ?? "" });
    expect(link.getAttribute("href")).toBe(`/suppliers/${seeded.approverId}`);
  });

  test("should show the not-found code when the purchase does not exist", async () => {
    // Arrange
    const purchaseRepository = fakePurchaseRepository();

    // Act
    renderScreen(<PurchaseDetailContainer id={crypto.randomUUID()} />, { purchaseRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("purchase.not_found");
  });

  test("should delete the purchase only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = PurchaseMother.random();
    const fake = fakePurchaseRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<PurchaseDetailContainer id={seeded.id} />, {
      purchaseRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/purchases"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

