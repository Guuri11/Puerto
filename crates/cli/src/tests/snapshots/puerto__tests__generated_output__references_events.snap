      </dd>
      <dt className="font-semibold">Approver</dt>
      <dd>
        <EnlaceReferencia ruta="/proveedores" id={compra.approverId} cargar={etiquetaProveedor} />
      </dd>
      <dt className="font-semibold">Total</dt>
      <dd>{compra.total}</dd>
    </dl>
  );
}

=== web/src/contextos/compra/vistas/formulario-compra.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { type OpcionReferencia, textoDe, textoOpcional } from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaCompra } from "../mensajes";

type Compra = Esquemas["DtoCompra"];
type PeticionCompra = Esquemas["PeticionCrearCompra"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioCompra {
  proveedorId: string;
  approverId: string;
  total: string;
}

/** Los inputs de `compra`, vacíos cuando todavía no hay ninguno. */
export function aFormularioCompra(compra: Compra | null): ValoresFormularioCompra {
  if (compra === null) {
    return {
      proveedorId: "",
      approverId: "",
      total: "",
    };
  }
  return {
    proveedorId: compra.proveedorId,
    approverId: textoDe(compra.approverId),
    total: String(compra.total),
  };
}

/** Lo que ofrece el select de cada referencia. */
export interface OpcionesFormularioCompra {
  proveedorId: OpcionReferencia[];
  approverId: OpcionReferencia[];
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionCompra(valores: ValoresFormularioCompra): PeticionCompra {
  return {
    proveedorId: valores.proveedorId,
    approverId: textoOpcional(valores.approverId),
    total: Number(valores.total),
  };
}

export function VistaFormularioCompra({
  valores,
  opciones,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioCompra;
  opciones: OpcionesFormularioCompra;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaCompra | null;
  alCambiar: (valores: ValoresFormularioCompra) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Proveedor</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "proveedorId"}
          required
          value={valores.proveedorId}
          onChange={(event) => alCambiar({ ...valores, proveedorId: event.target.value })}
        >
          <option value="">Elige una opción</option>
          {opciones.proveedorId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="proveedorId" />
      <label className="fieldset">
        <span className="fieldset-legend">Approver</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "approverId"}
          value={valores.approverId}
          onChange={(event) => alCambiar({ ...valores, approverId: event.target.value })}
        >
          <option value="">—</option>
          {opciones.approverId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="approverId" />
      <label className="fieldset">
        <span className="fieldset-legend">Total</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "total"}
          required
          value={valores.total}
          onChange={(event) => alCambiar({ ...valores, total: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="total" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/compra/vistas/lista-compra.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";

type Compra = Esquemas["DtoCompra"];

export function VistaListaCompra({ compras }: { compras: Compra[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Proveedor</th>
            <th>Approver</th>
            <th>Total</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {compras.map((compra) => (
            <tr key={compra.id}>
              <td>{compra.proveedorId}</td>
              <td>{compra.approverId ?? "—"}</td>
              <td>{compra.total}</td>
              <td className="text-right">
                <Link href={`/compras/${compra.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

