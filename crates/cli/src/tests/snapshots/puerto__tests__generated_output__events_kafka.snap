use crate::domain::product::model::Product;
use crate::domain::product::model::ProductProps;
use crate::domain::product::value_objects::Name;
use crate::domain::product::value_objects::Sku;
use crate::domain::product::value_objects::Status;
use chrono::{DateTime, Utc};
use std::collections::HashMap;

pub struct ProductMother {
    name: Option<Name>,
    sku: Option<Sku>,
    price: Option<i64>,
    status: Option<Status>,
    tags: Option<Vec<String>>,
    released_at: Option<DateTime<Utc>>,
    meta: Option<HashMap<String, String>>,
}

impl ProductMother {
    pub fn new() -> Self {
        Self {
            name: None,
            sku: None,
            price: None,
            status: None,
            tags: None,
            released_at: None,
            meta: None,
        }
    }

    pub fn with_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn with_sku(mut self, sku: Sku) -> Self {
        self.sku = Some(sku);
        self
    }

    pub fn with_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn with_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn with_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn with_released_at(mut self, released_at: DateTime<Utc>) -> Self {
        self.released_at = Some(released_at);
        self
    }

    pub fn with_meta(mut self, meta: HashMap<String, String>) -> Self {
        self.meta = Some(meta);
        self
    }

    pub fn build(self) -> Product {
        Product::new(ProductProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
            price: self.price.unwrap_or(42),
            status: self.status.unwrap_or(Status::Draft),
            tags: self.tags.unwrap_or_default(),
            released_at: self.released_at,
            meta: self.meta.unwrap_or_default(),
        })
        .expect("ProductMother: failed to build valid Product")
    }

    pub fn build_props(self) -> ProductProps {
        ProductProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
            price: self.price.unwrap_or(42),
            status: self.status.unwrap_or(Status::Draft),
            tags: self.tags.unwrap_or_default(),
            released_at: self.released_at,
            meta: self.meta.unwrap_or_default(),
        }
    }

    pub fn random() -> Product {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Product> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for ProductMother {
    fn default() -> Self {
        Self::new()
    }
}

=== docker-compose.yml ===
services:
  postgres:
    image: postgres:16
    container_name: snapshot-postgres
    ports:
      - "${DB_HOST_PORT:-5432}:5432"
    environment:
      POSTGRES_USER: devuser
      POSTGRES_PASSWORD: password
      POSTGRES_DB: snapshot
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U devuser -d snapshot"]
      interval: 5s
      timeout: 5s
      retries: 5

  redpanda:
    image: docker.redpanda.com/redpandadata/redpanda:v24.2.7
    container_name: snapshot-redpanda
    command:
      - redpanda
      - start
      - --mode
      - dev-container
      - --smp
      - "1"
      - --kafka-addr
      - PLAINTEXT://0.0.0.0:9092
      - --advertise-kafka-addr
      - PLAINTEXT://localhost:${KAFKA_HOST_PORT:-9092}
    ports:
      - "${KAFKA_HOST_PORT:-9092}:9092"
    volumes:
      - redpanda-data:/var/lib/redpanda/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "rpk cluster health | grep -q 'Healthy:.*true'"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  postgres-data:
  redpanda-data:

