use super::value_objects::Name;
use super::value_objects::Sku;
use super::value_objects::Status;
use chrono::{DateTime, Utc};
use std::collections::HashMap;
use uuid::Uuid;

use super::errors::ProductError;

/// The id of every `Product`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ProductId(Uuid);

impl ProductId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for ProductId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct ProductProps {
    pub name: Name,
    pub sku: Sku,
    pub price: i64,
    pub status: Status,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

#[derive(Debug, Clone)]
pub struct Product {
    pub id: ProductId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: Name,
    pub sku: Sku,
    pub price: i64,
    pub status: Status,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

impl Product {
    pub fn new(props: ProductProps) -> Result<Self, ProductError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: ProductId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
            sku: props.sku,
            price: props.price,
            status: props.status,
            tags: props.tags,
            released_at: props.released_at,
            meta: props.meta,
        })
    }

    pub fn from_repository(data: Product) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_product_when_fields_are_valid() {
        let result = Product::new(ProductProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            price: 42,
            status: Status::Draft,
            tags: vec![],
            released_at: None,
            meta: HashMap::new(),
        });
        assert!(result.is_ok());
    }

    #[test]
    fn should_reject_product_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_name");
    }

    #[test]
    fn should_reject_product_when_sku_is_empty() {
        let result = Sku::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_sku");
    }

    #[test]
    fn should_reject_product_when_status_is_invalid() {
        let result = "InvalidVariant".parse::<Status>();
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_status");
    }
}

