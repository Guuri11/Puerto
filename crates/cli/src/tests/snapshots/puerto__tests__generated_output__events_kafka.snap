=== business/src/application/product/update_product.rs ===
use std::sync::Arc;

use crate::domain::product::value_objects::Name;
use crate::domain::product::value_objects::Sku;
use crate::domain::product::value_objects::Status;
use async_trait::async_trait;
use puerto_core::RepositoryError;

use crate::domain::product::{
    errors::ProductError,
    events::{ProductEvent, ProductSnapshot},
    model::Product,
    repository::ProductRepositoryTrait,
    unit_of_work::ProductUnitOfWorkFactory,
    use_cases::update_product::{UpdateProductParams, UpdateProductUseCaseTrait},
};

pub struct UpdateProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
    pub uow_factory: Arc<dyn ProductUnitOfWorkFactory>,
}

#[async_trait]
impl UpdateProductUseCaseTrait for UpdateProductUseCaseImpl {
    async fn execute(&self, params: UpdateProductParams) -> Result<Product, ProductError> {
        tracing::info!(id = %params.id, "update_product: start");
        let failed =
            |e: &RepositoryError| tracing::error!(error = %e, "update_product: repository failed");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(failed)?
            .ok_or_else(|| {
                let err = ProductError::NotFound;
                tracing::warn!(error = %err, "update_product: rejected");
                err
            })?;
        let name = Name::new(params.name)?;
        let sku = Sku::new(params.sku)?;
        let status = params.status.parse::<Status>()?;
        entity.name = name;
        entity.sku = sku;
        entity.price = params.price;
        entity.status = status;
        entity.tags = params.tags;
        entity.released_at = params.released_at;
        entity.meta = params.meta;
        entity.updated_at = chrono::Utc::now();
        let mut uow = self.uow_factory.begin().await.inspect_err(failed)?;
        uow.save(&entity).await.inspect_err(failed)?;
        uow.record(ProductEvent::Updated(ProductSnapshot::from_entity(&entity)))
            .await
            .inspect_err(failed)?;
        uow.commit().await.inspect_err(failed)?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::value_objects::Name;
    use crate::domain::product::value_objects::Sku;
    use crate::domain::product::value_objects::Status;
    use crate::domain::product::{
        model::{ProductId, ProductProps},
        repository::mocks::MockProductRepository,
        unit_of_work::mocks::RecordingUnitOfWorkFactory,
    };
    use puerto_core::DomainEvent;
    use std::collections::HashMap;

    fn repository_holding(entity: Product) -> MockProductRepository {
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo
    }

    #[tokio::test]
    async fn should_record_product_updated_when_params_are_valid() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: Sku::new("original".to_string()).expect("valid Sku"),
            price: 42,
            status: Status::Draft,
            tags: vec![],
            released_at: None,
            meta: HashMap::new(),
        })
        .unwrap();
        let entity_id = entity.id;
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(repository_holding(entity)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                id: entity_id,
                name: "updated".to_string(),
                sku: "updated".to_string(),
                price: 42,
                status: "Draft".to_string(),
                tags: vec![],
                released_at: None,
                meta: HashMap::new(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().name.value(), "updated");
        let recorded = uow_factory.recorded();
        assert!(recorded.committed);
        assert_eq!(recorded.events.len(), 1);
        assert_eq!(recorded.events[0].event_type(), "product_updated");
        assert_eq!(recorded.events[0].aggregate_id(), entity_id.value());
    }

    #[tokio::test]
    async fn should_return_not_found_and_record_nothing_when_the_product_does_not_exist() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                id: ProductId::generate(),
                name: "new".to_string(),
                sku: "new".to_string(),
                price: 42,
                status: "Draft".to_string(),
                tags: vec![],
                released_at: None,
                meta: HashMap::new(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
        let recorded = uow_factory.recorded();
        assert!(recorded.saved.is_empty());
        assert!(recorded.events.is_empty());
    }

    #[tokio::test]
    async fn should_return_error_and_record_nothing_when_name_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: Sku::new("original".to_string()).expect("valid Sku"),
            price: 42,
            status: Status::Draft,
            tags: vec![],
            released_at: None,
            meta: HashMap::new(),
        })
        .unwrap();
        let entity_id = entity.id;
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(repository_holding(entity)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                id: entity_id,
                name: "".to_string(),
                sku: "updated".to_string(),
                price: 42,
                status: "Draft".to_string(),
                tags: vec![],
                released_at: None,
                meta: HashMap::new(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_name");
        assert!(uow_factory.recorded().saved.is_empty());
    }

    #[tokio::test]
    async fn should_return_error_and_record_nothing_when_sku_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: Sku::new("original".to_string()).expect("valid Sku"),
            price: 42,
            status: Status::Draft,
            tags: vec![],
            released_at: None,
            meta: HashMap::new(),
        })
        .unwrap();
        let entity_id = entity.id;
        let uow_factory = RecordingUnitOfWorkFactory::new();
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(repository_holding(entity)),
            uow_factory: Arc::new(uow_factory.clone()),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                id: entity_id,
                name: "updated".to_string(),
                sku: "".to_string(),
                price: 42,
                status: "Draft".to_string(),
                tags: vec![],
                released_at: None,
                meta: HashMap::new(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_sku");
        assert!(uow_factory.recorded().saved.is_empty());
    }
}

=== business/src/domain/product/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ProductError {
    #[error("product.validation_error.{0}")]
    ValidationError(String),
    #[error("product.not_found")]
    NotFound,
    #[error("product.duplicate")]
    Duplicate,
    #[error("product.repository_error")]
    RepositoryError,
    #[error("product.unknown")]
    Unknown,
    #[error("product.invalid_name")]
    InvalidName,
    #[error("product.invalid_sku")]
    InvalidSku,
    #[error("product.invalid_status")]
    InvalidStatus,
}

impl From<RepositoryError> for ProductError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = ProductError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "product.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = ProductError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "product.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = ProductError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "product.repository_error");
    }
}

=== business/src/domain/product/events.rs ===
// AUTO-GENERATED by puerto from puerto.toml — never hand-edit. The snapshot follows the entity's
// fields; add an event with `puerto generate event Product <name>`.
use chrono::{DateTime, Utc};
use puerto_core::DomainEvent;
use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use uuid::Uuid;

use super::model::Product;

pub const PRODUCT_CREATED: &str = "product_created";
pub const PRODUCT_UPDATED: &str = "product_updated";
pub const PRODUCT_DELETED: &str = "product_deleted";
pub const PRODUCT_PUBLISHED: &str = "product_published";

/// What every product event carries: the product as the API shows it — primitives, value
/// objects unwrapped. A public contract: consumers decode it with
/// `envelope.decode::<ProductSnapshot>()`.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct ProductSnapshot {
    pub id: Uuid,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

impl ProductSnapshot {
    pub fn from_entity(entity: &Product) -> Self {
        Self {
            id: entity.id.value(),
            name: entity.name.value().to_string(),
            sku: entity.sku.value().to_string(),
            price: entity.price,
            status: entity.status.as_str().to_string(),
            tags: entity.tags.clone(),
            released_at: entity.released_at,
            meta: entity.meta.clone(),
        }
    }
}

/// What happened to a product. Its write use cases record one through their unit of work.
#[derive(Debug, Clone, PartialEq)]
pub enum ProductEvent {
    Created(ProductSnapshot),
    Updated(ProductSnapshot),
    Deleted(ProductSnapshot),
    Published(ProductSnapshot),
}

impl ProductEvent {
    pub fn snapshot(&self) -> &ProductSnapshot {
        match self {
            Self::Created(snapshot)
            | Self::Updated(snapshot)
            | Self::Deleted(snapshot)
            | Self::Published(snapshot) => snapshot,
        }
    }
}

impl DomainEvent for ProductEvent {
    fn event_type(&self) -> &'static str {
        match self {
            Self::Created(_) => PRODUCT_CREATED,
            Self::Updated(_) => PRODUCT_UPDATED,
            Self::Deleted(_) => PRODUCT_DELETED,
            Self::Published(_) => PRODUCT_PUBLISHED,
        }
    }

    fn aggregate_type(&self) -> &'static str {
        "product"
    }

    fn aggregate_id(&self) -> Uuid {
        self.snapshot().id
    }

    fn schema_version(&self) -> u16 {
        1
    }

    fn payload(&self) -> serde_json::Value {
        // A snapshot holds primitives only: serialising it cannot fail.
        serde_json::to_value(self.snapshot()).unwrap_or_default()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::tests::mothers::product_mother::ProductMother;

    #[test]
    fn should_describe_every_event_when_one_is_recorded() {
        // Arrange
        let entity = ProductMother::random();
        let snapshot = ProductSnapshot::from_entity(&entity);
        let events = [
            (ProductEvent::Created(snapshot.clone()), "product_created"),
            (ProductEvent::Updated(snapshot.clone()), "product_updated"),
            (ProductEvent::Deleted(snapshot.clone()), "product_deleted"),
            (
                ProductEvent::Published(snapshot.clone()),
                "product_published",
            ),
        ];

        for (event, event_type) in events {
            // Act + Assert
            assert_eq!(event.event_type(), event_type);
            assert_eq!(event.aggregate_type(), "product");
            assert_eq!(event.aggregate_id(), entity.id.value());
            assert_eq!(event.schema_version(), 1);
            assert_eq!(event.snapshot(), &snapshot);
        }
    }

    #[test]
    fn should_keep_the_json_contract_when_the_snapshot_is_serialised() {
        // Arrange
        let snapshot = ProductSnapshot::from_entity(&ProductMother::random());

        // Act
        let payload = ProductEvent::Created(snapshot.clone()).payload();

        // Assert — a renamed or removed key breaks every consumer of these events.
        let mut keys: Vec<&str> = payload
            .as_object()
            .map(|object| object.keys().map(String::as_str).collect())
            .unwrap_or_default();
        keys.sort_unstable();
        assert_eq!(
            keys,
            [
                "id",
                "meta",
                "name",
                "price",
                "releasedAt",
                "sku",
                "status",
                "tags"
            ]
        );
        assert_eq!(
            serde_json::from_value::<ProductSnapshot>(payload).ok(),
            Some(snapshot)
        );
    }
}

