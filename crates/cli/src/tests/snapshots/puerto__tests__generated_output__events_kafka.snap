=== web/src/test-support/product.ts ===
import { ProductError } from "../domain/product/errors";
import type { Product, ProductDraft } from "../domain/product/model";
import type { ProductRepository } from "../domain/product/repository";

/** Valid products for tests; pass `overrides` for the fields a test is about. */
export const ProductMother = {
  draft(overrides: Partial<ProductDraft> = {}): ProductDraft {
    return {
      name: "example",
      sku: "example",
      price: 42,
      status: "Draft",
      tags: ["example"],
      releasedAt: "2026-01-01T10:00:00.000Z",
      meta: { key: "value" },
      ...overrides,
    };
  },

  random(overrides: Partial<Product> = {}): Product {
    return { id: crypto.randomUUID(), ...ProductMother.draft(), ...overrides };
  },
};

/** An in-memory `ProductRepository`. Override a method to make it fail. */
export function fakeProductRepository(seed: Product[] = []): ProductRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new ProductError("product.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

=== worker/AGENTS.md ===
# Worker — AI Agent Notes

The second process of this project (ADR-0018 of Puerto). The API's units of work write every
event to the `outbox` table in the entity's own transaction; this process **relays** the outbox
to the transport and **runs the consumers**. It is a composition root, like `presentation`: no
business logic lives here — a consumer decodes the event and calls a use case.

## Layer Structure

```
worker/src/
├── main.rs                  # `WorkerConfig::from_env()` + `Worker::new(config).try_run(…)` (never changes)
├── generated.rs             # `pub mod registry;`
├── generated/registry.rs    # AUTO-GENERATED: the relay and every `[[consumer]]` — never hand-edit
├── consumers.rs             # `pub mod <consumer>;` — no `mod.rs`
└── consumers/
    └── <consumer>.rs        # Yours: an `EventHandler`, written once by `puerto generate consumer`
```

## Critical Rules

- **Add a consumer with `puerto generate consumer <name> --on <event_type>[,…]`** — it declares
  `[[consumer]]` in `puerto.toml`, writes the handler and its tests, and regenerates
  `generated/registry.rs`. Never wire one by hand.
- **Handlers must be idempotent.** Delivery is at-least-once: the same `event.id` can arrive
  twice. Check whether the work was already done (keyed on `event.id`) before doing it again.
- **Answer honestly**: `Ack` when done; `Retry` for a failure that may pass (redelivered with a
  1 s → 300 s backoff, `MAX_DELIVERIES` times); `HandlerOutcome::dead_letter(reason, detail)` for
  one that never will. A payload that does not decode is `REASON_PAYLOAD_INVALID`. Nothing is
  dropped without a row in `dead_letters` (`make events/dead-letters`).
- **Decode the snapshot, never the domain model**: `event.decode::<ProductSnapshot>()`. The
  snapshot is the event's public contract.

## Kafka transport

- The relay publishes each event to its aggregate's topic, `<KAFKA_TOPIC_PREFIX>.<aggregate>`,
  keyed by the aggregate id: the events of one aggregate are consumed in the order they happened.
- A consumer is the consumer group `<KAFKA_TOPIC_PREFIX>.<consumer>`. Its offset is committed
  once the outcome is settled. A `Retry` holds back the records behind it in its partition until
  it is acked or dead-lettered; after a restart its attempts start over.
- `make docker-compose/up` starts Redpanda next to Postgres; the topics are created when the
  worker starts. Dead letters stay in Postgres.

## Health and shutdown

Served by the Puerto runtime, `puerto-events`, on `WORKER_PORT` (8081).

- `GET /health` — liveness: the process answers.
- `GET /health/ready` — readiness: `503` until the relay and every consumer have finished a pass
  that did not fail recently (a database that is down shows up here).
- On SIGTERM / Ctrl-C each loop finishes the batch it is handling, for up to 8 s.

## Configuration

`WORKER_PORT` (8081), `RELAY_BATCH_SIZE` (100), `RELAY_POLL_INTERVAL_MS` (500),
`CONSUMER_POLL_INTERVAL_MS` (500), `MAX_DELIVERIES` (5), `RETRY_MAX_DELAY_MS` (unset: the backoff
above), plus `DATABASE_URL`. A value that is set but invalid stops the worker at startup.
Kafka: `KAFKA_BROKERS` (`localhost:9092`) and `KAFKA_TOPIC_PREFIX` (the project name).

=== worker/Cargo.toml ===
[package]
name = "worker"
version = "0.1.0"
edition = "2024"

[dependencies]
business = { path = "../business" }
infrastructure = { path = "../infrastructure" }
puerto-core = { workspace = true }
# The relay, the consume loops, health probes and graceful shutdown (`main.rs`, `generated/registry.rs`).
puerto-events = { workspace = true }
# The Kafka transport: the publisher and the subscriptions `generated/registry.rs` wires.
puerto-kafka = { workspace = true }
async-trait = "0.1"
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
tracing = "0.1"

[dev-dependencies]
# Consumer tests build envelopes from the Object Mothers, which business exports behind `test-utils`.
business = { path = "../business", features = ["test-utils"] }
serde_json = "1"

=== worker/src/consumers.rs ===
//! One module per `[[consumer]]` of puerto.toml — `puerto generate consumer` adds them.
pub mod notify_new_product;

=== worker/src/consumers/notify_new_product.rs ===
//! `notify_new_product`: reacts to `product_created`, `product_published`. Written once by
//! `puerto generate consumer`; it is yours now.
//!
//! Delivery is at-least-once: the same event (the same `event.id`) can arrive twice — after a
//! crash, a timeout or a redeploy. Whatever this does must be **idempotent**: check whether it
//! already happened (keyed on `event.id`) before doing it again.
//!
//! `Ack` when done; `Retry` for a failure that may pass (the worker redelivers with a growing
//! backoff, then dead-letters); `HandlerOutcome::dead_letter(…)` for one that never will.

use async_trait::async_trait;
use business::domain::product::events::{PRODUCT_CREATED, PRODUCT_PUBLISHED, ProductSnapshot};
use puerto_core::events::{EventEnvelope, EventHandler, HandlerOutcome, REASON_PAYLOAD_INVALID};

pub struct NotifyNewProduct;

#[async_trait]
impl EventHandler for NotifyNewProduct {
    async fn handle(&self, event: &EventEnvelope) -> HandlerOutcome {
        match event.event_type.as_str() {
            PRODUCT_CREATED => match event.decode::<ProductSnapshot>() {
                Ok(product) => {
                    tracing::info!(
                        event_id = %event.id,
                        product_id = %product.id,
                        "notify_new_product: product_created"
                    );
                    HandlerOutcome::Ack
                }
                Err(err) => HandlerOutcome::dead_letter(REASON_PAYLOAD_INVALID, err.detail),
            },
            PRODUCT_PUBLISHED => match event.decode::<ProductSnapshot>() {
                Ok(product) => {
                    tracing::info!(
                        event_id = %event.id,
                        product_id = %product.id,
                        "notify_new_product: product_published"
                    );
                    HandlerOutcome::Ack
                }
                Err(err) => HandlerOutcome::dead_letter(REASON_PAYLOAD_INVALID, err.detail),
            },
            // Not subscribed (puerto.toml `[[consumer]] events`): nothing to do.
            _ => HandlerOutcome::Ack,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::product::events::ProductEvent;
    use business::tests::mothers::product_mother::ProductMother;

    fn product_created() -> EventEnvelope {
        let snapshot = ProductSnapshot::from_entity(&ProductMother::random());
        EventEnvelope::new(&ProductEvent::Created(snapshot))
    }

    #[tokio::test]
    async fn should_ack_when_a_product_created_event_is_valid() {
        // Arrange
        let event = product_created();

        // Act
        let outcome = NotifyNewProduct.handle(&event).await;

        // Assert
        assert_eq!(outcome, HandlerOutcome::Ack);
    }

    #[tokio::test]
    async fn should_ack_again_when_the_same_event_is_delivered_twice() {
        // Arrange
        let event = product_created();

        // Act
        let first = NotifyNewProduct.handle(&event).await;
        let second = NotifyNewProduct.handle(&event).await;

        // Assert
        assert_eq!((first, second), (HandlerOutcome::Ack, HandlerOutcome::Ack));
    }

    #[tokio::test]
    async fn should_dead_letter_when_the_payload_is_malformed() {
        // Arrange
        let mut event = product_created();
        event.payload = serde_json::json!({ "unexpected": true });

        // Act
        let outcome = NotifyNewProduct.handle(&event).await;

        // Assert
        assert!(
            matches!(
                outcome,
                HandlerOutcome::DeadLetter {
                    reason: REASON_PAYLOAD_INVALID,
                    ..
                }
            ),
            "{outcome:?}"
        );
    }
}

=== worker/src/generated.rs ===
pub mod registry;

=== worker/src/generated/registry.rs ===
// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`; add a
// consumer with `puerto generate consumer <name> --on <event_type>`.
use std::sync::Arc;

use business::domain::product::events::{PRODUCT_CREATED, PRODUCT_PUBLISHED};
use infrastructure::db::events::{PgDeadLetters, PgOutbox};
use puerto_events::{Loops, WorkerConfig};
use puerto_kafka::{KafkaConfig, KafkaPublisher, KafkaSubscription};

use crate::consumers::notify_new_product::NotifyNewProduct;

/// The relay and one consumer per `[[consumer]]`, on the `kafka` transport: the relay publishes
/// each event to its aggregate's topic, `<KAFKA_TOPIC_PREFIX>.<aggregate>`, and each consumer is a
/// consumer group on the topics of its events. Dead letters stay in Postgres.
pub async fn build_worker(config: WorkerConfig) -> Result<Loops, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL is not set — set it in .env (.env.example has one)".to_string()
    })?;
    let pool = infrastructure::db::create_postgres_pool(&database_url)
        .await
        .map_err(|e| format!("{e} — is the database up? `make docker-compose/up`"))?;
    infrastructure::db::run_migrations(&pool, &infrastructure::db::MIGRATOR)
        .await
        .map_err(|e| e.to_string())?;
    let kafka = KafkaConfig::from_env("snapshot").map_err(|e| e.to_string())?;
    kafka.ensure_topics(&["product"]).await.map_err(|e| {
        format!("cannot create the Kafka topics: {e} — is the broker up? `make docker-compose/up`")
    })?;
    let publisher = KafkaPublisher::new(&kafka)
        .map_err(|e| format!("cannot create the Kafka producer: {e}"))?;
    let dead_letters = Arc::new(PgDeadLetters::new(pool.clone()));

    Ok(Loops::new(&config)
        .relay(PgOutbox::new(pool), publisher)
        .consumer(
            KafkaSubscription::new(
                &kafka,
                "notify_new_product",
                &["product"],
                &[PRODUCT_CREATED, PRODUCT_PUBLISHED],
                dead_letters.clone(),
            )
            .map_err(|e| format!("cannot subscribe notify_new_product to Kafka: {e}"))?,
            NotifyNewProduct,
            dead_letters,
        ))
}

=== worker/src/main.rs ===
mod consumers;
mod generated;

/// The second process of this project (ADR-0018 of Puerto): it relays the outbox the API writes
/// and runs the consumers. The loops, health probes and graceful shutdown come from the Puerto
/// runtime, `puerto-events`; the wiring is in `generated/registry.rs`, the consumers in
/// `consumers/`.
#[tokio::main]
async fn main() -> Result<(), puerto_events::Error> {
    let config = puerto_events::WorkerConfig::from_env()?;
    puerto_events::Worker::new(config)
        .try_run(generated::registry::build_worker)
        .await
}
