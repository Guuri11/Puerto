-- Puerto migration: create_product_table
-- Run `make sqlx/prepare` after editing this file.

CREATE TABLE products (
    id UUID PRIMARY KEY,
    name TEXT NOT NULL,
    sku TEXT NOT NULL,
    price BIGINT NOT NULL,
    status TEXT NOT NULL,
    tags TEXT[] NOT NULL DEFAULT '{}',
    released_at TIMESTAMPTZ,
    meta JSONB NOT NULL DEFAULT '{}',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    deleted BOOLEAN NOT NULL DEFAULT FALSE,
    deleted_at TIMESTAMPTZ
);

CREATE UNIQUE INDEX products_sku_key ON products (sku) WHERE deleted = false;

=== infrastructure/migrations/<version>_outbox.sql ===
-- Puerto migration: outbox
-- Run `make sqlx/prepare` after editing this file.

-- Domain events (ADR-0018): written by puerto. The units of work insert into `outbox` in the same
-- transaction as the entity; the worker relays it and records what it could not deliver.

CREATE TABLE outbox (
    id             UUID        PRIMARY KEY,
    seq            BIGSERIAL   NOT NULL,          -- relay order
    aggregate_type TEXT        NOT NULL,
    aggregate_id   UUID        NOT NULL,
    event_type     TEXT        NOT NULL,
    schema_version INT         NOT NULL,
    payload        JSONB       NOT NULL,
    headers        JSONB       NOT NULL DEFAULT '{}',
    occurred_at    TIMESTAMPTZ NOT NULL,
    published_at   TIMESTAMPTZ
);
CREATE INDEX outbox_unpublished ON outbox (seq) WHERE published_at IS NULL;

CREATE TABLE dead_letters (                      -- every transport
    id           UUID        PRIMARY KEY,
    event_id     UUID,
    consumer     TEXT        NOT NULL,
    event_type   TEXT,
    attempts     INT         NOT NULL,
    reason       TEXT        NOT NULL,
    detail       TEXT        NOT NULL,
    payload      TEXT        NOT NULL,           -- trimmed to 4000 chars
    recorded_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);
-- One dead letter per event and consumer, so a redelivered failure is not recorded twice. A
-- message that was not an envelope has no event_id: NULLs never conflict.
CREATE UNIQUE INDEX dead_letters_event_consumer ON dead_letters (event_id, consumer);

=== infrastructure/src/db.rs ===
//! The database adapter — pool, migrations at startup, readiness ping, driver-error mapping — is
//! `puerto-sqlx`'s (ADR-0017 of Puerto). Only the migrations are this project's.
pub use puerto_sqlx::*;

/// `infrastructure/migrations/`, embedded at compile time and applied at startup by `bootstrap.rs`.
pub static MIGRATOR: sqlx::migrate::Migrator = sqlx::migrate!("./migrations");

