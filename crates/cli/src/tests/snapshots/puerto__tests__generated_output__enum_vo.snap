            reference: "first".to_string(),
            status: Status::Pending,
        }).unwrap(),
            Order::new(OrderProps {
            reference: "second".to_string(),
            status: Status::Pending,
        }).unwrap(),
        ];
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListOrdersParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_orders_exist() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListOrdersParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

