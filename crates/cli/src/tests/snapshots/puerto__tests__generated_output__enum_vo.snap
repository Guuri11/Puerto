import type { Esquemas } from "../../../api/cliente";

type Pedido = Esquemas["DtoPedido"];

/** Lo que se lee de cada variante de `status`. */
const TEXTOS_STATUS: Record<string, string> = {
  Pending: "Pending",
  Confirmed: "Confirmed",
  Cancelled: "Cancelled",
};

export function VistaDetallePedido({ pedido }: { pedido: Pedido }) {
