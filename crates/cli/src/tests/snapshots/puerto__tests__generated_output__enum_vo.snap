=== web/src/api/cliente.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { components, paths } from "./esquema";

/** El cliente tipado de la API. `paths` sale de la especificación del backend (`make web/sync`). */
export type ClienteApi = Client<paths>;

/** Los DTO de la API por nombre: `Esquemas["DtoProducto"]`, `Esquemas["PeticionCrearProducto"]`. */
export type Esquemas = components["schemas"];

/** `/api` es el backend: en desarrollo, Vite lo pasa a `:8080`. */
export function crearClienteApi(opciones: ClientOptions = {}): ClienteApi {
  return createClient<paths>({ baseUrl: "/api", ...opciones });
}

=== web/src/contextos/pedido/contenedores/detalle-pedido.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionPedido, MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetallePedido } from "./detalle-pedido";

describe("ContenedorDetallePedido", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadrePedido.aleatorio();
    const api = apiFalsa([coleccionPedido([sembrado])]);

    const pantalla = <ContenedorDetallePedido id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionPedido()]);
    const pantalla = <ContenedorDetallePedido id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("pedido.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadrePedido.aleatorio();
    const guardados = coleccionPedido([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetallePedido id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/pedidos"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/pedido/contenedores/detalle-pedido.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetallePedido } from "../vistas/detalle-pedido";

export function ContenedorDetallePedido({ id }: { id: string }) {
  const { api } = useDependencias();
  const pedido = useCarga(
    () => desenvolver(api.GET("/pedidos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/pedidos/{id}", { params: { path: { id } } }));
      navegar("/pedidos");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Pedido</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {pedido.estado === "cargando" && <span className="loading loading-spinner" />}
      {pedido.estado === "error" && <AlertaError error={pedido.error} />}
      {pedido.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetallePedido pedido={pedido.datos} />
            <div className="card-actions justify-end">
              <Link href={`/pedidos/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/pedidos" className="link">
        Volver a pedidos
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar pedido?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/pedido/contenedores/formulario-pedido.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionPedido, MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioPedido } from "./formulario-pedido";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearPedido"]) {
  await screen.findByText("Guardar");
  escribir("Reference", peticion.reference);
  escribir("Status", peticion.status);
}

describe("ContenedorFormularioPedido", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadrePedido.peticion();
    const guardados = coleccionPedido();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioPedido />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/pedidos/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/pedidos/${creado?.id}`);
  });

  test("debería traer elegida la primera variante de Status", async () => {
    // Preparar
    const api = apiFalsa([coleccionPedido()]);

    // Actuar
    renderizarPantalla(<ContenedorFormularioPedido />, { api });

    // Comprobar
    await screen.findByText("Guardar");
    const select = screen.getByLabelText("Status") as HTMLSelectElement;
    expect(select.value).toBe("Pending");
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadrePedido.aleatorio();
    const guardados = coleccionPedido([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioPedido id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/pedidos/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadrePedido.peticion();
    const codigo = "pedido.validacion.invalido";
    const fallos = { "POST /pedidos": codigo };
    const api = apiFalsa([coleccionPedido()], fallos);
    renderizarPantalla(<ContenedorFormularioPedido />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadrePedido.peticion();
    const codigo = "pedido.duplicado";
    const fallos = { "POST /pedidos": codigo };
    const api = apiFalsa([coleccionPedido()], fallos);
    renderizarPantalla(<ContenedorFormularioPedido />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadrePedido.peticion();
    const codigo = "pedido.validacion.reference_vacio";
    const fallos = { "POST /pedidos": codigo };
    const api = apiFalsa([coleccionPedido()], fallos);
    renderizarPantalla(<ContenedorFormularioPedido />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Reference");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/pedido/contenedores/formulario-pedido.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioPedido,
  aPeticionPedido,
  VistaFormularioPedido,
} from "../vistas/formulario-pedido";

type Pedido = Esquemas["DtoPedido"];

/** Crear, o editar con `id`: el formulario de pedidos. */
export function ContenedorFormularioPedido({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/pedidos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear pedido" : "Editar pedido";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioPedido existente={existente.datos} />}
      <Link href={id === undefined ? "/pedidos" : `/pedidos/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioPedido({ existente }: { existente: Pedido | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioPedido(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionPedido(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/pedidos", { body: cuerpo })
          : api.PUT("/pedidos/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/pedidos/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioPedido
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/pedido/contenedores/lista-pedido.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionPedido, MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaPedido } from "./lista-pedido";

describe("ContenedorListaPedido", () => {
  test("debería mostrar una fila por cada pedido", async () => {
    // Preparar
    const semilla = [MadrePedido.aleatorio(), MadrePedido.aleatorio()];
    const api = apiFalsa([coleccionPedido(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadrePedido.aleatorio());
    const api = apiFalsa([coleccionPedido(semilla)]);
    renderizarPantalla(<ContenedorListaPedido />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadrePedido.aleatorio());
    const api = apiFalsa([coleccionPedido(semilla)]);
    const ruta = "/pedidos?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay pedidos", async () => {
    // Preparar
    const api = apiFalsa([coleccionPedido()]);

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay pedidos.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /pedidos": "pedido.repositorio" };
    const api = apiFalsa([coleccionPedido()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("pedido.repositorio");
  });
});

=== web/src/contextos/pedido/contenedores/lista-pedido.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaPedido } from "../vistas/lista-pedido";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaPedido() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const pedidos = useCarga(
    () => desenvolver(api.GET("/pedidos", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Pedidos</h1>
        <Link href="/pedidos/nuevo" className="btn btn-primary">
          Crear pedido
        </Link>
      </div>
      {pedidos.estado === "cargando" && <span className="loading loading-spinner" />}
      {pedidos.estado === "error" && <AlertaError error={pedidos.error} />}
      {pedidos.estado === "listo" &&
        (pedidos.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay pedidos." />
        ) : (
          <>
            <VistaListaPedido pedidos={pedidos.datos.elementos} />
            <Paginacion
              total={pedidos.datos.total}
              limite={pedidos.datos.limite}
              desplazamiento={pedidos.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/pedido/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaPedido {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "pedido.validacion.reference_vacio": "Reference: campo obligatorio",
  "pedido.status_invalido": "Status: no válido",
  "pedido.duplicado": "Estos valores ya están en uso",
  "pedido.no_encontrado": "Ya no existe",
  "pedido.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "pedido.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "pedido.validacion.reference_vacio": "reference",
  "pedido.status_invalido": "status",
};

export function aProblema(codigo: string): ProblemaPedido {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

