    }
}

=== business/src/domain/order/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum OrderError {
    #[error("order.validation_error.{0}")]
    ValidationError(String),
    #[error("order.not_found")]
    NotFound,
    #[error("order.duplicate")]
    Duplicate,
    #[error("order.repository_error")]
    RepositoryError,
    #[error("order.unknown")]
    Unknown,
    #[error("order.invalid_status")]
    InvalidStatus,
}

impl From<RepositoryError> for OrderError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = OrderError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "order.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = OrderError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "order.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = OrderError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "order.repository_error");
    }
}

=== business/src/domain/order/model.rs ===
use super::value_objects::Status;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::OrderError;

/// The id of every `Order`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct OrderId(Uuid);

impl OrderId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for OrderId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct OrderProps {
    pub reference: String,
    pub status: Status,
}

#[derive(Debug, Clone)]
pub struct Order {
    pub id: OrderId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub reference: String,
    pub status: Status,
}

impl Order {
    pub fn new(props: OrderProps) -> Result<Self, OrderError> {
        if props.reference.trim().is_empty() {
            return Err(OrderError::ValidationError("reference_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: OrderId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            reference: props.reference,
            status: props.status,
        })
    }

    pub fn from_repository(data: Order) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_order_when_fields_are_valid() {
        let result = Order::new(OrderProps {
            reference: "example".to_string(),
            status: Status::Pending,
        });
        assert_eq!(result.unwrap().reference, "example");
    }

    #[test]
    fn should_reject_order_when_reference_is_empty() {
        let result = Order::new(OrderProps {
            reference: "".into(),
            status: Status::Pending,
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "order.validation_error.reference_empty"
        );
    }

    #[test]
    fn should_reject_order_when_reference_is_only_whitespace() {
        let result = Order::new(OrderProps {
            reference: "   ".into(),
            status: Status::Pending,
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_order_when_status_is_invalid() {
        let result = "InvalidVariant".parse::<Status>();
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "order.invalid_status");
    }
}

