      <Route path="/">
        <HomePage entries={navEntries} />
      </Route>
      {customRoutes}
      <Route path="/orders">
        <OrderListContainer />
      </Route>
      <Route path="/orders/new">
        <OrderFormContainer />
      </Route>
      <Route path="/orders/:id/edit">{(params) => <OrderFormContainer id={params.id} />}</Route>
      <Route path="/orders/:id">{(params) => <OrderDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

