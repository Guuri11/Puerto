    </dl>
  );
}

=== web/src/contextos/pedido/vistas/formulario-pedido.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaPedido } from "../mensajes";

type Pedido = Esquemas["DtoPedido"];
type PeticionPedido = Esquemas["PeticionCrearPedido"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioPedido {
  reference: string;
  status: string;
}

/** Los inputs de `pedido`, vacíos cuando todavía no hay ninguno. */
export function aFormularioPedido(pedido: Pedido | null): ValoresFormularioPedido {
  if (pedido === null) {
    return {
      reference: "",
      status: "Pending",
    };
  }
  return {
    reference: pedido.reference,
    status: pedido.status,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionPedido(valores: ValoresFormularioPedido): PeticionPedido {
  return {
    reference: valores.reference,
    status: valores.status,
  };
}

export function VistaFormularioPedido({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioPedido;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaPedido | null;
  alCambiar: (valores: ValoresFormularioPedido) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Reference</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "reference"}
          required
          value={valores.reference}
          onChange={(event) => alCambiar({ ...valores, reference: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="reference" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "status"}
          required
          value={valores.status}
          onChange={(event) => alCambiar({ ...valores, status: event.target.value })}
        >
          <option value="Pending">Pending</option>
          <option value="Confirmed">Confirmed</option>
          <option value="Cancelled">Cancelled</option>
        </select>
      </label>
      <ErrorCampo problema={problema} campo="status" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/pedido/vistas/lista-pedido.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";

type Pedido = Esquemas["DtoPedido"];

/** Lo que se lee de cada variante de `status`. */
const TEXTOS_STATUS: Record<string, string> = {
  Pending: "Pending",
  Confirmed: "Confirmed",
  Cancelled: "Cancelled",
};

export function VistaListaPedido({ pedidos }: { pedidos: Pedido[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Reference</th>
            <th>Status</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {pedidos.map((pedido) => (
            <tr key={pedido.id}>
              <td>{pedido.reference}</td>
              <td>{TEXTOS_STATUS[pedido.status] ?? pedido.status}</td>
              <td className="text-right">
                <Link href={`/pedidos/${pedido.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/generado/dependencias.ts ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//
// La raíz de composición: el único módulo que construye el cliente de la API. Las pantallas llegan
// a él con `useDependencias()`, así un test les da un falso.

import { type ClienteApi, crearClienteApi } from "../api/cliente";

export interface Dependencias {
  api: ClienteApi;
}

export function crearDependencias(): Dependencias {
  const api = crearClienteApi();
  return { api };
}

