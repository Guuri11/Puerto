import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakeOrderRepository, OrderMother } from "../../../../test-support/order";
import { renderScreen } from "../../../../test-support/render";
import { OrderDetailContainer } from "./order-detail-container";

describe("OrderDetailContainer", () => {
  test("should show the order when it exists", async () => {
    // Arrange
    const seeded = OrderMother.random();
    const orderRepository = fakeOrderRepository([seeded]);

    // Act
    renderScreen(<OrderDetailContainer id={seeded.id} />, { orderRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the order does not exist", async () => {
    // Arrange
    const orderRepository = fakeOrderRepository();

    // Act
    renderScreen(<OrderDetailContainer id={crypto.randomUUID()} />, { orderRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("order.not_found");
  });

  test("should delete the order only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = OrderMother.random();
    const fake = fakeOrderRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<OrderDetailContainer id={seeded.id} />, {
      orderRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/orders"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/order/containers/order-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { OrderDetailView } from "../views/order-detail-view";

export function OrderDetailContainer({ id }: { id: string }) {
  const { orderRepository } = useDependencies();
  const order = useAsync(() => orderRepository.get(id), [orderRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await orderRepository.remove(id);
      navigate("/orders");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Order</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {order.status === "loading" && <span className="loading loading-spinner" />}
      {order.status === "error" && <ErrorAlert error={order.error} />}
      {order.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <OrderDetailView order={order.data} />
            <div className="card-actions justify-end">
              <Link href={`/orders/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/orders" className="link">
        Back to orders
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this order?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

