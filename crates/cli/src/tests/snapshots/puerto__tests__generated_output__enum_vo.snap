=== contextos/pedido/dominio/src/modelo.rs ===
use crate::valores::Status;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorPedido;

/// El id de cada `Pedido`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdPedido(Uuid);

impl IdPedido {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdPedido {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsPedido {
    pub reference: String,
    pub status: Status,
}

#[derive(Debug, Clone)]
pub struct Pedido {
    pub id: IdPedido,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub reference: String,
    pub status: Status,
}

impl Pedido {
    pub fn new(props: PropsPedido) -> Result<Self, ErrorPedido> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdPedido::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            reference: props.reference,
            status: props.status,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsPedido) -> Result<(), ErrorPedido> {
        Self::validar(&props)?;
        self.reference = props.reference;
        self.status = props.status;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Pedido) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsPedido) -> Result<(), ErrorPedido> {
        if props.reference.trim().is_empty() {
            return Err(ErrorPedido::Validacion("reference_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadrePedido;

    #[test]
    fn deberia_crear_pedido_cuando_los_campos_son_validos() {
        let resultado = Pedido::new(MadrePedido::new().construir_props());
        assert_eq!(
            resultado.unwrap().reference,
            MadrePedido::new().construir_props().reference
        );
    }

    #[test]
    fn deberia_rechazar_pedido_cuando_reference_es_una_cadena_vacia() {
        let resultado = Pedido::new(MadrePedido::new().con_reference_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "pedido.validacion.reference_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_pedido_cuando_reference_solo_tiene_espacios() {
        let resultado = Pedido::new(MadrePedido::new().con_reference("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_pedido_cuando_reference_es_una_cadena_vacia() {
        let mut entidad = MadrePedido::aleatorio();
        let resultado =
            entidad.actualizar(MadrePedido::new().con_reference_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "pedido.validacion.reference_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_pedido_cuando_status_no_es_una_variante_conocida() {
        let resultado = "VarianteInvalida".parse::<Status>();
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "pedido.status_invalido");
    }

    #[test]
    fn deberia_marcar_pedido_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadrePedido::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

=== contextos/pedido/dominio/src/pruebas/madres.rs ===
use crate::modelo::Pedido;
use crate::modelo::PropsPedido;
use crate::valores::Status;

pub struct MadrePedido {
    reference: Option<String>,
    status: Option<Status>,
}

impl MadrePedido {
    pub fn new() -> Self {
        Self {
            reference: None,
            status: None,
        }
    }

    pub fn con_reference(mut self, reference: &str) -> Self {
        self.reference = Some(reference.to_string());
        self
    }

    pub fn con_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn con_reference_vacio(mut self) -> Self {
        self.reference = Some(String::new());
        self
    }

    pub fn construir(self) -> Pedido {
        Pedido::new(PropsPedido {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            status: self.status.unwrap_or(Status::Pending),
        })
        .expect("MadrePedido: Pedido::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsPedido {
        PropsPedido {
            reference: self.reference.unwrap_or_else(|| "example".to_string()),
            status: self.status.unwrap_or(Status::Pending),
        }
    }

    pub fn aleatorio() -> Pedido {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Pedido> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadrePedido {
    fn default() -> Self {
        Self::new()
    }
}

