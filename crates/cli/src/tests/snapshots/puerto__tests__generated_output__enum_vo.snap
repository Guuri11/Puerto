import type { Page, PageRequest } from "../shared/page";
import type { Order, OrderDraft } from "./model";

/** The port the screens call. Every method rejects with the `OrderError` the API answered. */
export interface OrderRepository {
  list(page: PageRequest): Promise<Page<Order>>;
  get(id: string): Promise<Order>;
  create(draft: OrderDraft): Promise<Order>;
  update(id: string, draft: OrderDraft): Promise<Order>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/order/order-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { OrderError } from "../../domain/order/errors";
import { OrderMother } from "../../test-support/order";
import { createApiClient } from "../http/client";
import { orderRepositoryHttp } from "./order-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: orderRepositoryHttp(api), requests };
}

describe("orderRepositoryHttp", () => {
  test("should ask for the page and return its orders", async () => {
    // Arrange
    const order = OrderMother.random();
    const page = { items: [order], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/orders?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating an order", async () => {
    // Arrange
    const draft = OrderMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the order does not exist", async () => {
    // Arrange
    const code = "order.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(OrderError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the order", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/orders/42");
  });
});

=== web/src/infrastructure/order/order-repository-http.ts ===
import { OrderError } from "../../domain/order/errors";
import { type Order, type OrderDraft, parseStatus } from "../../domain/order/model";
import type { OrderRepository } from "../../domain/order/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type OrderDto = components["schemas"]["OrderDto"];
type OrderRequest = components["schemas"]["CreateOrderRequest"];

function toOrder(dto: OrderDto): Order {
  return {
    id: dto.id,
    reference: dto.reference,
    status: parseStatus(dto.status),
  };
}

function toRequest(draft: OrderDraft): OrderRequest {
  return {
    reference: draft.reference,
    status: draft.status,
  };
}

/** `OrderRepository` over the REST API (`/orders`). */
export function orderRepositoryHttp(api: ApiClient): OrderRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/orders", {
        params: { query: page },
      });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toOrder) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/orders/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return toOrder(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/orders", { body: toRequest(draft) });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return toOrder(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/orders/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return toOrder(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/orders/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new OrderError(apiErrorCode(error, response));
    },
  };
}

