use business::domain::customer::errors::CustomerError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;

use crate::api::error::{ErrorResponse, IntoErrorResponse};

impl IntoErrorResponse for CustomerError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            CustomerError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::NotFound => StatusCode::NOT_FOUND,
            CustomerError::Duplicate => StatusCode::CONFLICT,
            CustomerError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            CustomerError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            CustomerError::InvalidEmail => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::InvalidCode => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::InvalidAge => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::InvalidJoined => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::InvalidMiddleName => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::InvalidLabel => StatusCode::UNPROCESSABLE_ENTITY,
            CustomerError::InvalidStatus => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
