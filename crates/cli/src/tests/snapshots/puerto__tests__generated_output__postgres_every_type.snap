import { BilleteError } from "../domain/billete/errors";
import type { Billete, BilleteDraft } from "../domain/billete/model";
import type { BilleteRepository } from "../domain/billete/repository";

/** Valid billetes for tests; pass `overrides` for the fields a test is about. */
export const BilleteMother = {
  draft(overrides: Partial<BilleteDraft> = {}): BilleteDraft {
    return {
      state: "Open",
      ...overrides,
    };
  },

  random(overrides: Partial<Billete> = {}): Billete {
    return { id: crypto.randomUUID(), ...BilleteMother.draft(), ...overrides };
  },
};

/** An in-memory `BilleteRepository`. Override a method to make it fail. */
export function fakeBilleteRepository(seed: Billete[] = []): BilleteRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new BilleteError("billete.no_encontrado");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

