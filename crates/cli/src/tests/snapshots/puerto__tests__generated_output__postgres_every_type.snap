[package]
name = "aplicacion_producto"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_producto = { workspace = true }
puerto-nucleo = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_producto/pruebas"]

[dev-dependencies]
dominio_producto = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/producto/aplicacion/src/actualizar_producto.rs ===
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_producto::errores::ErrorProducto;
use dominio_producto::modelo::{IdProducto, Producto, PropsProducto};
use dominio_producto::repositorio::RepositorioProducto;
use std::collections::HashMap;
use std::sync::Arc;
use uuid::Uuid;

#[derive(Debug, Clone)]
pub struct ParamsActualizarProducto {
    pub id: IdProducto,
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
}

#[async_trait]
pub trait ActualizarProducto: Send + Sync {
    async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarProducto {}

        #[async_trait]
        impl ActualizarProducto for ActualizarProducto {
            async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto>;
        }
    }
}

pub struct ActualizarProductoImpl {
    pub repositorio: Arc<dyn RepositorioProducto>,
}

#[async_trait]
impl ActualizarProducto for ActualizarProductoImpl {
    async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto> {
        tracing::info!(id = %params.id, "actualizar_producto: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "actualizar_producto: fallo del repositorio"),
            )?
            .ok_or_else(|| {
                let err = ErrorProducto::NoEncontrado;
                tracing::warn!(error = %err, "actualizar_producto: rechazado");
                err
            })?;
        entidad
            .actualizar(PropsProducto {
                title: params.title,
                sku: params.sku,
                price: params.price,
                rating: params.rating,
                active: params.active,
                ref_id: params.ref_id,
                published_at: params.published_at,
                summary: params.summary,
                views: params.views,
                expires_at: params.expires_at,
                tags: params.tags,
                scores: params.scores,
                meta: params.meta,
            })
            .inspect_err(|e| tracing::warn!(error = %e, "actualizar_producto: rechazado"))?;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "actualizar_producto: fallo del repositorio"),
        )?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::{
        modelo::IdProducto, pruebas::madres::MadreProducto,
        repositorio::dobles::MockRepositorioProducto,
    };

    #[tokio::test]
    async fn deberia_actualizar_producto_cuando_los_parametros_son_validos() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let mut entidad = MadreProducto::aleatorio();
        // Lo que estaba guardado, distinto de lo que trae la actualización.
        entidad.title = "original".to_string();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: id_entidad,
                title: props.title,
                sku: props.sku,
                price: props.price,
                rating: props.rating,
                active: props.active,
                ref_id: props.ref_id,
                published_at: props.published_at,
                summary: props.summary,
                views: props.views,
                expires_at: props.expires_at,
                tags: props.tags,
                scores: props.scores,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert_eq!(
            resultado.unwrap().title,
            MadreProducto::new().construir_props().title
        );
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_producto_no_existe() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: IdProducto::generar(),
                title: props.title,
                sku: props.sku,
                price: props.price,
                rating: props.rating,
                active: props.active,
                ref_id: props.ref_id,
                published_at: props.published_at,
                summary: props.summary,
                views: props.views,
                expires_at: props.expires_at,
                tags: props.tags,
                scores: props.scores,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_title_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: id_entidad,
                title: "".to_string(),
                sku: props.sku,
                price: props.price,
                rating: props.rating,
                active: props.active,
                ref_id: props.ref_id,
                published_at: props.published_at,
                summary: props.summary,
                views: props.views,
                expires_at: props.expires_at,
                tags: props.tags,
                scores: props.scores,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.title_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_sku_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                id: id_entidad,
                title: props.title,
                sku: "".to_string(),
                price: props.price,
                rating: props.rating,
                active: props.active,
                ref_id: props.ref_id,
                published_at: props.published_at,
                summary: props.summary,
                views: props.views,
                expires_at: props.expires_at,
                tags: props.tags,
                scores: props.scores,
                meta: props.meta,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.sku_vacio"
        );
    }
}

