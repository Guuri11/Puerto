=== presentacion/api/src/generado/bootstrap.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
use poem::Endpoint;
use poem_openapi::OpenApiService;
use rest_billete::rutas::ApiBillete;
use rest_cliente::rutas::ApiCliente;
use rest_producto::rutas::ApiProducto;
use rest_saludo::rutas::ApiSaludo;

/// Las rutas, cableadas. Un error es lo que paró el arranque: `main` lo muestra y sale con 1.
pub async fn construir_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL no está definida — defínela en .env (.env.example trae una)".to_string()
    })?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — ¿está arrancada la base de datos? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;

    let casos_saludo = cableado::saludo::construir();
    let api_saludo = ApiSaludo {
        obtener_saludo: casos_saludo.obtener_saludo,
    };

    let casos_producto = cableado::producto::construir(&pool);
    let api_producto = ApiProducto {
        crear_producto: casos_producto.crear_producto,
        obtener_producto: casos_producto.obtener_producto,
        listar_productos: casos_producto.listar_productos,
        actualizar_producto: casos_producto.actualizar_producto,
        borrar_producto: casos_producto.borrar_producto,
        archive_producto: casos_producto.archive_producto,
    };

    let casos_cliente = cableado::cliente::construir(&pool);
    let api_cliente = ApiCliente {
        crear_cliente: casos_cliente.crear_cliente,
        obtener_cliente: casos_cliente.obtener_cliente,
        listar_clientes: casos_cliente.listar_clientes,
        actualizar_cliente: casos_cliente.actualizar_cliente,
        borrar_cliente: casos_cliente.borrar_cliente,
    };

    let casos_billete = cableado::billete::construir(&pool);
    let api_billete = ApiBillete {
        crear_billete: casos_billete.crear_billete,
        obtener_billete: casos_billete.obtener_billete,
        listar_billetes: casos_billete.listar_billetes,
        actualizar_billete: casos_billete.actualizar_billete,
        borrar_billete: casos_billete.borrar_billete,
    };

    let disponible = puerto_web::health::sondear(move || {
        let pool = pool.clone();
        async move { puerto_sqlx::ping(&pool).await }
    });

    // `app.rs` es del proyecto: el middleware y las rutas que se añadan allí envuelven todo esto.
    Ok(crate::app::configurar(puerto_web::rutas(
        servicio_openapi((api_saludo, api_producto, api_cliente, api_billete)),
        &config,
        disponible,
    )))
}

/// El servicio de la API, construido en un solo sitio: cualquier otro que lea su spec (el test de
/// exportación de un proyecto con `web/`) ve la API que responde el servidor.
fn servicio_openapi<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::sync::Arc;

    use aplicacion_billete::actualizar_billete::dobles::MockActualizarBillete;
    use aplicacion_billete::borrar_billete::dobles::MockBorrarBillete;
    use aplicacion_billete::crear_billete::dobles::MockCrearBillete;
    use aplicacion_billete::listar_billetes::dobles::MockListarBilletes;
    use aplicacion_billete::obtener_billete::dobles::MockObtenerBillete;
    use aplicacion_cliente::actualizar_cliente::dobles::MockActualizarCliente;
    use aplicacion_cliente::borrar_cliente::dobles::MockBorrarCliente;
    use aplicacion_cliente::crear_cliente::dobles::MockCrearCliente;
    use aplicacion_cliente::listar_clientes::dobles::MockListarClientes;
    use aplicacion_cliente::obtener_cliente::dobles::MockObtenerCliente;
    use aplicacion_producto::actualizar_producto::dobles::MockActualizarProducto;
    use aplicacion_producto::archive_producto::dobles::MockArchiveProducto;
    use aplicacion_producto::borrar_producto::dobles::MockBorrarProducto;
    use aplicacion_producto::crear_producto::dobles::MockCrearProducto;
    use aplicacion_producto::listar_productos::dobles::MockListarProductos;
    use aplicacion_producto::obtener_producto::dobles::MockObtenerProducto;
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;

    /// El contrato de la API del que se generan los tipos del frontend (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../../docs/api/openapi.json");

    /// Se construye con casos de uso dobles: sin servidor ni base de datos. Si falta el fichero,
    /// se escribe; si es distinto, falla: ejecuta `make web/sync` (pone `UPDATE_OPENAPI=1`) y haz
    /// commit del diff.
    #[test]
    fn la_spec_openapi_coincide_con_docs_api_openapi_json() {
        let api_saludo = ApiSaludo {
            obtener_saludo: Arc::new(MockObtenerSaludo::new()),
        };
        let api_producto = ApiProducto {
            crear_producto: Arc::new(MockCrearProducto::new()),
            obtener_producto: Arc::new(MockObtenerProducto::new()),
            listar_productos: Arc::new(MockListarProductos::new()),
            actualizar_producto: Arc::new(MockActualizarProducto::new()),
            borrar_producto: Arc::new(MockBorrarProducto::new()),
            archive_producto: Arc::new(MockArchiveProducto::new()),
        };
        let api_cliente = ApiCliente {
            crear_cliente: Arc::new(MockCrearCliente::new()),
            obtener_cliente: Arc::new(MockObtenerCliente::new()),
            listar_clientes: Arc::new(MockListarClientes::new()),
            actualizar_cliente: Arc::new(MockActualizarCliente::new()),
            borrar_cliente: Arc::new(MockBorrarCliente::new()),
        };
        let api_billete = ApiBillete {
            crear_billete: Arc::new(MockCrearBillete::new()),
            obtener_billete: Arc::new(MockObtenerBillete::new()),
            listar_billetes: Arc::new(MockListarBilletes::new()),
            actualizar_billete: Arc::new(MockActualizarBillete::new()),
            borrar_billete: Arc::new(MockBorrarBillete::new()),
        };
        let spec = servicio_openapi((api_saludo, api_producto, api_cliente, api_billete)).spec();

        let ruta = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !ruta.exists() {
            let directorio = ruta
                .parent()
                .expect("docs/api/openapi.json tiene directorio padre");
            std::fs::create_dir_all(directorio).expect("crear docs/api");
            std::fs::write(ruta, &spec).expect("escribir docs/api/openapi.json");
            return;
        }
        let en_disco = std::fs::read_to_string(ruta).expect("leer docs/api/openapi.json");
        assert!(
            en_disco == spec,
            "docs/api/openapi.json no es la API que sirve este código: ejecuta `make web/sync`"
        );
    }
}

