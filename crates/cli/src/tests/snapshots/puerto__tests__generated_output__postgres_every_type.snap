import { TicketError } from "../domain/ticket/errors";
import type { Ticket, TicketDraft } from "../domain/ticket/model";
import type { TicketRepository } from "../domain/ticket/repository";

/** Valid tickets for tests; pass `overrides` for the fields a test is about. */
export const TicketMother = {
  draft(overrides: Partial<TicketDraft> = {}): TicketDraft {
    return {
      state: "Open",
      ...overrides,
    };
  },

  random(overrides: Partial<Ticket> = {}): Ticket {
    return { id: crypto.randomUUID(), ...TicketMother.draft(), ...overrides };
  },
};

/** An in-memory `TicketRepository`. Override a method to make it fail. */
export function fakeTicketRepository(seed: Ticket[] = []): TicketRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new TicketError("ticket.not_found");
    return found;
  };
  return {
    list: async () => [...store.values()],
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
