#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoCliente {
    pub id: Uuid,
    pub email: String,
    pub name: String,
    pub code: String,
    pub age: i64,
    pub joined: DateTime<Utc>,
    pub middle: Option<String>,
    pub labels: Vec<String>,
    pub status: String,
}

impl DtoCliente {
    pub fn from_dominio(entidad: &Cliente) -> Self {
        Self {
            id: entidad.id.valor(),
            email: entidad.email.valor().to_string(),
            name: entidad.name.valor().to_string(),
            code: entidad.code.valor().to_string(),
            age: entidad.age.valor(),
            joined: entidad.joined.valor(),
            middle: entidad.middle.as_ref().map(|v| v.valor().to_string()),
            labels: entidad
                .labels
                .iter()
                .map(|v| v.valor().to_string())
                .collect::<Vec<_>>(),
            status: entidad.status.as_str().to_string(),
        }
    }
}

