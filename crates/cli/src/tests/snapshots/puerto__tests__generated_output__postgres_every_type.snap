=== contextos/cliente/dominio/src/modelo.rs ===
use crate::valores::Age;
use crate::valores::Code;
use crate::valores::Joined;
use crate::valores::Label;
use crate::valores::MiddleName;
use crate::valores::Name;
use crate::valores::Status;
use chrono::{DateTime, Utc};
use nucleo::valores::Email;
use uuid::Uuid;

use crate::errores::ErrorCliente;

/// El id de cada `Cliente`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdCliente(Uuid);

impl IdCliente {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdCliente {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsCliente {
    pub email: Email,
    pub name: Name,
    pub code: Code,
    pub age: Age,
    pub joined: Joined,
    pub middle: Option<MiddleName>,
    pub labels: Vec<Label>,
    pub status: Status,
}

#[derive(Debug, Clone)]
pub struct Cliente {
    pub id: IdCliente,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub email: Email,
    pub name: Name,
    pub code: Code,
    pub age: Age,
    pub joined: Joined,
    pub middle: Option<MiddleName>,
    pub labels: Vec<Label>,
    pub status: Status,
}

impl Cliente {
    pub fn new(props: PropsCliente) -> Result<Self, ErrorCliente> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdCliente::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            email: props.email,
            name: props.name,
            code: props.code,
            age: props.age,
            joined: props.joined,
            middle: props.middle,
            labels: props.labels,
            status: props.status,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsCliente) -> Result<(), ErrorCliente> {
        Self::validar(&props)?;
        self.email = props.email;
        self.name = props.name;
        self.code = props.code;
        self.age = props.age;
        self.joined = props.joined;
        self.middle = props.middle;
        self.labels = props.labels;
        self.status = props.status;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Cliente) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(_props: &PropsCliente) -> Result<(), ErrorCliente> {
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreCliente;

    #[test]
    fn deberia_crear_cliente_cuando_los_campos_son_validos() {
        let resultado = Cliente::new(MadreCliente::new().construir_props());
        assert!(resultado.is_ok());
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_email_es_una_cadena_vacia() {
        let resultado = Email::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "nucleo.email_invalido");
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_name_es_una_cadena_vacia() {
        let resultado = Name::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cliente.name_invalido");
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_code_es_una_cadena_vacia() {
        let resultado = Code::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cliente.code_invalido");
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_status_no_es_una_variante_conocida() {
        let resultado = "VarianteInvalida".parse::<Status>();
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cliente.status_invalido"
        );
    }

    #[test]
    fn deberia_marcar_cliente_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreCliente::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

=== contextos/cliente/dominio/src/pruebas/madres.rs ===
use crate::modelo::Cliente;
use crate::modelo::PropsCliente;
use crate::valores::Age;
use crate::valores::Code;
use crate::valores::Joined;
use crate::valores::Label;
use crate::valores::MiddleName;
use crate::valores::Name;
use crate::valores::Status;
use chrono::Utc;
use nucleo::valores::Email;

pub struct MadreCliente {
    email: Option<Email>,
    name: Option<Name>,
    code: Option<Code>,
    age: Option<Age>,
    joined: Option<Joined>,
    middle: Option<MiddleName>,
    labels: Option<Vec<Label>>,
    status: Option<Status>,
}

impl MadreCliente {
    pub fn new() -> Self {
        Self {
            email: None,
            name: None,
            code: None,
            age: None,
            joined: None,
            middle: None,
            labels: None,
            status: None,
        }
    }

    pub fn con_email(mut self, email: Email) -> Self {
        self.email = Some(email);
        self
    }

    pub fn con_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn con_code(mut self, code: Code) -> Self {
        self.code = Some(code);
        self
    }

    pub fn con_age(mut self, age: Age) -> Self {
        self.age = Some(age);
        self
    }

    pub fn con_joined(mut self, joined: Joined) -> Self {
        self.joined = Some(joined);
        self
    }

    pub fn con_middle(mut self, middle: MiddleName) -> Self {
        self.middle = Some(middle);
        self
    }

    pub fn con_labels(mut self, labels: Vec<Label>) -> Self {
        self.labels = Some(labels);
        self
    }

    pub fn con_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn construir(self) -> Cliente {
        Cliente::new(PropsCliente {
            email: self.email.unwrap_or_else(|| {
                Email::new("example".to_string()).expect("Email::new rechazó el valor de ejemplo")
            }),
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            code: self.code.unwrap_or_else(|| {
                Code::new("example".to_string()).expect("Code::new rechazó el valor de ejemplo")
            }),
            age: self
                .age
                .unwrap_or_else(|| Age::new(42).expect("Age::new rechazó el valor de ejemplo")),
            joined: self.joined.unwrap_or_else(|| {
                Joined::new(Utc::now()).expect("Joined::new rechazó el valor de ejemplo")
            }),
            middle: self.middle,
            labels: self.labels.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
        })
        .expect("MadreCliente: Cliente::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsCliente {
        PropsCliente {
            email: self.email.unwrap_or_else(|| {
                Email::new("example".to_string()).expect("Email::new rechazó el valor de ejemplo")
            }),
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            code: self.code.unwrap_or_else(|| {
                Code::new("example".to_string()).expect("Code::new rechazó el valor de ejemplo")
            }),
            age: self
                .age
                .unwrap_or_else(|| Age::new(42).expect("Age::new rechazó el valor de ejemplo")),
            joined: self.joined.unwrap_or_else(|| {
                Joined::new(Utc::now()).expect("Joined::new rechazó el valor de ejemplo")
            }),
            middle: self.middle,
            labels: self.labels.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
        }
    }

    pub fn aleatorio() -> Cliente {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Cliente> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }

    /// Un `code` distinto en cada llamada, para las filas que guardan los tests de los
    /// repositorios (es único). Si una regla del dominio lo rechaza, cámbialo aquí.
    pub fn code_unico() -> String {
        uuid::Uuid::new_v4().simple().to_string()[..12].to_string()
    }
}

impl Default for MadreCliente {
    fn default() -> Self {
        Self::new()
    }
}

