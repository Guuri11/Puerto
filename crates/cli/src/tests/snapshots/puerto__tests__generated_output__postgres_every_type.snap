use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use sqlx::types::Json;
use std::collections::HashMap;
use uuid::Uuid;

use dominio_producto::{
    errores::ErrorProducto,
    modelo::{IdProducto, Producto},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaProducto {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: Json<HashMap<String, String>>,
}

impl TryFrom<FilaProducto> for Producto {
    type Error = ErrorProducto;

    fn try_from(fila: FilaProducto) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Producto {
            id: IdProducto::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            title: fila.title,
            sku: fila.sku,
            price: fila.price,
            rating: fila.rating,
            active: fila.active,
            ref_id: fila.ref_id,
            published_at: fila.published_at,
            summary: fila.summary,
            views: fila.views,
            expires_at: fila.expires_at,
            tags: fila.tags,
            scores: fila.scores,
            meta: fila.meta.0,
        }))
    }
}

impl From<&Producto> for FilaProducto {
    fn from(entidad: &Producto) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            title: entidad.title.clone(),
            sku: entidad.sku.clone(),
            price: entidad.price,
            rating: entidad.rating,
            active: entidad.active,
            ref_id: entidad.ref_id,
            published_at: entidad.published_at,
            summary: entidad.summary.clone(),
            views: entidad.views,
            expires_at: entidad.expires_at,
            tags: entidad.tags.clone(),
            scores: entidad.scores.clone(),
            meta: Json(entidad.meta.clone()),
        }
    }
}

