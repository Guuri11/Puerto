        let caso_de_uso = CrearClienteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearCliente {
                email: props.email.valor().to_string(),
                name: props.name.valor().to_string(),
                code: "".to_string(),
                age: props.age.valor(),
                joined: props.joined.valor(),
                middle: props.middle.as_ref().map(|v| v.valor().to_string()),
                labels: props
                    .labels
                    .iter()
                    .map(|v| v.valor().to_string())
                    .collect::<Vec<_>>(),
                status: props.status.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cliente.code_invalido");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_status_es_una_cadena_vacia() {
        // Preparar
        let props = MadreCliente::new().construir_props();
        let repositorio_doble = MockRepositorioCliente::new();
        let caso_de_uso = CrearClienteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearCliente {
                email: props.email.valor().to_string(),
                name: props.name.valor().to_string(),
                code: props.code.valor().to_string(),
                age: props.age.valor(),
                joined: props.joined.valor(),
                middle: props.middle.as_ref().map(|v| v.valor().to_string()),
                labels: props
                    .labels
                    .iter()
                    .map(|v| v.valor().to_string())
                    .collect::<Vec<_>>(),
                status: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cliente.status_invalido"
        );
    }
}

