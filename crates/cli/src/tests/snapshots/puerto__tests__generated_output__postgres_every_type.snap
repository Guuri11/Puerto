import { ClienteError } from "./errors";

export interface Cliente {
  id: string;
  email: string;
  name: string;
  code: string;
  age: number;
  joined: string;
  middle: string | null;
  labels: string[];
  status: Status;
}

/** What a create or an update sends: a cliente without its id. */
export type ClienteDraft = Omit<Cliente, "id">;

export const statusValues = ["Active", "Inactive"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `cliente.status_invalido`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new ClienteError("cliente.status_invalido");
  return found;
}

