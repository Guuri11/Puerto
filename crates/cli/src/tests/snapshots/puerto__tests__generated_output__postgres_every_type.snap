=== web/src/presentation/features/ticket/views/ticket-form-view.tsx ===
import { parseState, type Ticket, type TicketDraft } from "../../../../domain/ticket/model";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface TicketFormValues {
  state: string;
}

/** The inputs for `ticket`, empty when there is none yet. */
export function toTicketForm(ticket: Ticket | null): TicketFormValues {
  if (ticket === null) {
    return {
      state: "",
    };
  }
  return {
    state: ticket.state,
  };
}

export function toTicketDraft(values: TicketFormValues): TicketDraft {
  return {
    state: parseState(values.state),
  };
}

export function TicketFormView({
  values,
  saving,
  onChange,
  onSubmit,
}: {
  values: TicketFormValues;
  saving: boolean;
  onChange: (values: TicketFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">State</span>
        <select
          className="select w-full"
          required
          value={values.state}
          onChange={(event) => onChange({ ...values, state: event.target.value })}
        >
          <option value="">Choose…</option>
          <option value="Open">Open</option>
          <option value="Closed">Closed</option>
        </select>
      </label>
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

