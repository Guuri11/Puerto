use std::sync::Arc;

use business::{
    application::ticket::{
        create_ticket::CreateTicketUseCaseImpl,
        delete_ticket::DeleteTicketUseCaseImpl,
        get_ticket::GetTicketUseCaseImpl,
        list_ticket::ListTicketUseCaseImpl,
        update_ticket::UpdateTicketUseCaseImpl,
    },
    domain::ticket::use_cases::{
        create_ticket::{CreateTicketParams, CreateTicketUseCaseTrait},
        delete_ticket::{DeleteTicketParams, DeleteTicketUseCaseTrait},
        get_ticket::{GetTicketParams, GetTicketUseCaseTrait},
        list_ticket::{ListTicketParams, ListTicketUseCaseTrait},
        update_ticket::{UpdateTicketParams, UpdateTicketUseCaseTrait},
    },
};
use poem_openapi::{OpenApi, param::Path, payload::Json};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::ticket::dto::{CreateTicketRequest, UpdateTicketRequest, TicketDto};
use crate::api::ticket::responses::{
    CreateTicketResponse, DeleteTicketResponse, GetTicketResponse, ListTicketResponse,
    UpdateTicketResponse,
};

pub struct TicketApi {
    pub create_ticket: Arc<CreateTicketUseCaseImpl>,
    pub get_ticket: Arc<GetTicketUseCaseImpl>,
    pub list_ticket: Arc<ListTicketUseCaseImpl>,
    pub update_ticket: Arc<UpdateTicketUseCaseImpl>,
    pub delete_ticket: Arc<DeleteTicketUseCaseImpl>,
}

#[OpenApi]
impl TicketApi {
    /// Create a new Ticket
    #[oai(path = "/tickets", method = "post", tag = "ApiTags::Ticket")]
    async fn create(&self, body: Json<CreateTicketRequest>) -> CreateTicketResponse {
        match self
            .create_ticket
            .execute(CreateTicketParams {
                state: body.state.clone(),
            })
            .await
        {
            Ok(entity) => CreateTicketResponse::Created(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_ticket failed");
                CreateTicketResponse::from_status(status, error)
            }
        }
    }

    /// Get a Ticket by ID
    #[oai(path = "/tickets/:id", method = "get", tag = "ApiTags::Ticket")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetTicketResponse {
        match self
            .get_ticket
            .execute(GetTicketParams { id: id.0 })
            .await
        {
            Ok(entity) => GetTicketResponse::Ok(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_ticket failed");
                GetTicketResponse::from_status(status, error)
            }
        }
    }

    /// List all Tickets
    #[oai(path = "/tickets", method = "get", tag = "ApiTags::Ticket")]
    async fn list(&self) -> ListTicketResponse {
        match self.list_ticket.execute(ListTicketParams).await {
            Ok(entities) => {
                ListTicketResponse::Ok(Json(entities.iter().map(TicketDto::from_domain).collect()))
            }
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_ticket failed");
                ListTicketResponse::from_status(status, error)
            }
        }
    }

    /// Update a Ticket
    #[oai(path = "/tickets/:id", method = "put", tag = "ApiTags::Ticket")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateTicketRequest>) -> UpdateTicketResponse {
        match self
            .update_ticket
            .execute(UpdateTicketParams {
                id: id.0,
                state: body.state.clone(),
            })
            .await
        {
            Ok(entity) => UpdateTicketResponse::Ok(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_ticket failed");
                UpdateTicketResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Ticket
    #[oai(path = "/tickets/:id", method = "delete", tag = "ApiTags::Ticket")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteTicketResponse {
        match self
            .delete_ticket
            .execute(DeleteTicketParams { id: id.0 })
            .await
        {
            Ok(()) => DeleteTicketResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_ticket failed");
                DeleteTicketResponse::from_status(status, error)
            }
        }
    }
}

=== presentation/src/generated/bootstrap.rs ===
// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;
use business::application::product::create_product::CreateProductUseCaseImpl;
use business::application::product::get_product::GetProductUseCaseImpl;
use business::application::product::list_product::ListProductUseCaseImpl;
use business::application::product::update_product::UpdateProductUseCaseImpl;
use business::application::product::delete_product::DeleteProductUseCaseImpl;
use business::application::product::archive_product::ArchiveProductUseCaseImpl;
use business::application::customer::create_customer::CreateCustomerUseCaseImpl;
use business::application::customer::get_customer::GetCustomerUseCaseImpl;
use business::application::customer::list_customer::ListCustomerUseCaseImpl;
use business::application::customer::update_customer::UpdateCustomerUseCaseImpl;
use business::application::customer::delete_customer::DeleteCustomerUseCaseImpl;
use business::application::ticket::create_ticket::CreateTicketUseCaseImpl;
use business::application::ticket::get_ticket::GetTicketUseCaseImpl;
use business::application::ticket::list_ticket::ListTicketUseCaseImpl;
use business::application::ticket::update_ticket::UpdateTicketUseCaseImpl;
use business::application::ticket::delete_ticket::DeleteTicketUseCaseImpl;

use business::domain::greeting::repository::GreetingRepositoryTrait;
use infrastructure::greeting::repository::InMemoryGreetingRepository;
use business::domain::product::repository::ProductRepositoryTrait;
use infrastructure::product::repository::PgProductRepository;
use business::domain::customer::repository::CustomerRepositoryTrait;
use infrastructure::customer::repository::PgCustomerRepository;
use business::domain::ticket::repository::TicketRepositoryTrait;
use infrastructure::ticket::repository::PgTicketRepository;

use poem::{EndpointExt, Route, get, middleware::{Cors, Tracing}};
use poem_openapi::OpenApiService;

use crate::api::greeting::routes::GreetingApi;
use crate::api::product::routes::ProductApi;
use crate::api::customer::routes::CustomerApi;
use crate::api::ticket::routes::TicketApi;

pub async fn build_app() -> impl poem::Endpoint {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let pool = infrastructure::db::create_postgres_pool(&database_url)
        .await
        .expect("Failed to connect to database");
    infrastructure::db::run_migrations(&pool)
        .await
        .expect("Failed to run migrations");

    let get_greeting = Arc::new(GetGreetingUseCaseImpl { repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait> });
    let greeting_api = GreetingApi { get_greeting };

    let product_repo: Arc<dyn ProductRepositoryTrait> = Arc::new(PgProductRepository::new(pool.clone()));
    let create_product = Arc::new(CreateProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let get_product = Arc::new(GetProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let list_product = Arc::new(ListProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let update_product = Arc::new(UpdateProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let delete_product = Arc::new(DeleteProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let archive_product = Arc::new(ArchiveProductUseCaseImpl { repository: product_repo });
    let product_api = ProductApi { create_product, get_product, list_product, update_product, delete_product, archive_product };

    let customer_repo: Arc<dyn CustomerRepositoryTrait> = Arc::new(PgCustomerRepository::new(pool.clone()));
    let create_customer = Arc::new(CreateCustomerUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let get_customer = Arc::new(GetCustomerUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let list_customer = Arc::new(ListCustomerUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let update_customer = Arc::new(UpdateCustomerUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let delete_customer = Arc::new(DeleteCustomerUseCaseImpl { repository: customer_repo });
    let customer_api = CustomerApi { create_customer, get_customer, list_customer, update_customer, delete_customer };

    let ticket_repo: Arc<dyn TicketRepositoryTrait> = Arc::new(PgTicketRepository::new(pool.clone()));
    let create_ticket = Arc::new(CreateTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let get_ticket = Arc::new(GetTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let list_ticket = Arc::new(ListTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let update_ticket = Arc::new(UpdateTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let delete_ticket = Arc::new(DeleteTicketUseCaseImpl { repository: ticket_repo });
    let ticket_api = TicketApi { create_ticket, get_ticket, list_ticket, update_ticket, delete_ticket };

    let port = std::env::var("SERVICE_PORT").unwrap_or_else(|_| "8080".to_string());
    let api_service = OpenApiService::new(
        (greeting_api, product_api, customer_api, ticket_api),
        env!("CARGO_PKG_NAME"),
        env!("CARGO_PKG_VERSION"),
    )
    .server(format!("http://localhost:{port}/api"));
    let ui = api_service.swagger_ui();

    let cors_origins = std::env::var("CORS_ALLOWED_ORIGINS").unwrap_or_default();
    let mut cors = Cors::new();
    for origin in cors_origins.split(',').map(str::trim).filter(|s| !s.is_empty()) {
        cors = cors.allow_origin(origin);
    }

    Route::new()
        .at("/health", get(crate::health::liveness))
        .at(
            "/health/ready",
            get(poem::endpoint::make(move |_| {
                let pool = pool.clone();
                async move { crate::health::readiness(infrastructure::db::ping(&pool).await) }
            })),
        )
        .nest("/api", api_service)
        .nest("/", ui)
        .with(Tracing)
        .with(cors)
}

