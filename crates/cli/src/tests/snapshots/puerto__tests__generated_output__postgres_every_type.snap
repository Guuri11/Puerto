        .inspect_err(|e| tracing::warn!(error = %e, "crear_producto: rechazado"))?;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "crear_producto: fallo del repositorio"),
        )?;
        tracing::info!(id = %entidad.id, "crear_producto: fin");
        Ok(entidad)
    }
