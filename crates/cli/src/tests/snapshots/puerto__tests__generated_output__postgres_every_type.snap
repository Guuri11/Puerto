import { Link } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { TicketListView } from "../views/ticket-list-view";

export function TicketListContainer() {
  const { ticketRepository } = useDependencies();
  const tickets = useAsync(() => ticketRepository.list(), [ticketRepository]);

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Tickets</h1>
        <Link href="/tickets/new" className="btn btn-primary">
          New ticket
        </Link>
      </div>
      {tickets.status === "loading" && <span className="loading loading-spinner" />}
      {tickets.status === "error" && <ErrorAlert error={tickets.error} />}
      {tickets.status === "ok" &&
        (tickets.data.length === 0 ? (
          <EmptyState message="No tickets yet." />
        ) : (
          <TicketListView tickets={tickets.data} />
        ))}
    </section>
  );
}

