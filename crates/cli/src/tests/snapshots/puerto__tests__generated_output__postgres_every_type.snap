use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::customer::{
    errors::CustomerError,
    model::Customer,
    repository::CustomerRepositoryTrait,
    use_cases::list_customer::{ListCustomerParams, ListCustomerUseCaseTrait},
};

pub struct ListCustomerUseCaseImpl {
    pub repository: Arc<dyn CustomerRepositoryTrait>,
}

#[async_trait]
impl ListCustomerUseCaseTrait for ListCustomerUseCaseImpl {
    async fn execute(&self, _params: ListCustomerParams) -> Result<Vec<Customer>, CustomerError> {
        tracing::info!("list_customer: start");
        self.repository.find_all().await.inspect_err(|e| tracing::error!(error = %e, "list_customer: repository failed"))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::customer::{
        model::{Customer, CustomerProps},
        repository::mocks::MockCustomerRepository,
    };
    use chrono::Utc;
    use crate::domain::shared::value_objects::Email;
    use crate::domain::customer::value_objects::Name;
    use crate::domain::customer::value_objects::Code;
    use crate::domain::customer::value_objects::Age;
    use crate::domain::customer::value_objects::Joined;
    use crate::domain::customer::value_objects::Status;


    #[tokio::test]
    async fn should_return_all_customers() {
        let entities = vec![
            Customer::new(CustomerProps {
            email: Email::new("first".to_string()).expect("valid Email"),
            name: Name::new("first".to_string()).expect("valid Name"),
            code: Code::new("first".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        }).unwrap(),
            Customer::new(CustomerProps {
            email: Email::new("second".to_string()).expect("valid Email"),
            name: Name::new("second".to_string()).expect("valid Name"),
            code: Code::new("second".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        }).unwrap(),
        ];
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListCustomerParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_customers_exist() {
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListCustomerParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

=== business/src/application/customer/update_customer.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use crate::domain::shared::value_objects::Email;
use crate::domain::customer::value_objects::Name;
use crate::domain::customer::value_objects::Code;
use crate::domain::customer::value_objects::Age;
use crate::domain::customer::value_objects::Joined;
use crate::domain::customer::value_objects::MiddleName;
use crate::domain::customer::value_objects::Label;
use crate::domain::customer::value_objects::Status;

use crate::domain::customer::{
    errors::CustomerError,
    model::Customer,
    repository::CustomerRepositoryTrait,
    use_cases::update_customer::{UpdateCustomerParams, UpdateCustomerUseCaseTrait},
};

pub struct UpdateCustomerUseCaseImpl {
    pub repository: Arc<dyn CustomerRepositoryTrait>,
}

#[async_trait]
impl UpdateCustomerUseCaseTrait for UpdateCustomerUseCaseImpl {
    async fn execute(&self, params: UpdateCustomerParams) -> Result<Customer, CustomerError> {
        tracing::info!(id = %params.id, "update_customer: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_customer: repository failed"))?
            .ok_or_else(|| {
                let err = CustomerError::NotFound;
                tracing::warn!(error = %err, "update_customer: rejected");
                err
            })?;
let email = Email::new(params.email).map_err(|_| CustomerError::InvalidEmail)?;
let name = Name::new(params.name)?;
let code = Code::new(params.code)?;
let age = Age::new(params.age)?;
let joined = Joined::new(params.joined)?;
let middle = params.middle.map(MiddleName::new).transpose()?;
let labels: Vec<Label> = params.labels.into_iter().map(Label::new).collect::<Result<Vec<_>,_>>()?;
let status = params.status.parse::<Status>()?;
        entity.email = email;
        entity.name = name;
        entity.code = code;
        entity.age = age;
        entity.joined = joined;
        entity.middle = middle;
        entity.labels = labels;
        entity.status = status;
        entity.updated_at = chrono::Utc::now();
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "update_customer: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::customer::{
        model::{Customer, CustomerProps},
        repository::mocks::MockCustomerRepository,
    };
    use uuid::Uuid;
    use chrono::Utc;
    use crate::domain::shared::value_objects::Email;
    use crate::domain::customer::value_objects::Name;
    use crate::domain::customer::value_objects::Code;
    use crate::domain::customer::value_objects::Age;
    use crate::domain::customer::value_objects::Joined;
    use crate::domain::customer::value_objects::Status;


    #[tokio::test]
    async fn should_update_customer_when_params_are_valid() {
        // Arrange
        let entity = Customer::new(CustomerProps {
            email: Email::new("original".to_string()).expect("valid Email"),
