    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>State</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {tickets.map((ticket) => (
            <tr key={ticket.id}>
              <td>{ticket.state}</td>
              <td className="text-right">
                <Link href={`/tickets/${ticket.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/customer.ts ===
import { CustomerError } from "../domain/customer/errors";
import type { Customer, CustomerDraft } from "../domain/customer/model";
import type { CustomerRepository } from "../domain/customer/repository";

/** Valid customers for tests; pass `overrides` for the fields a test is about. */
export const CustomerMother = {
  draft(overrides: Partial<CustomerDraft> = {}): CustomerDraft {
    return {
      email: "example",
      name: "example",
      code: "example",
      age: 42,
      joined: "2026-01-01T10:00:00.000Z",
      middle: "example",
      labels: ["example"],
      status: "Active",
      ...overrides,
    };
  },

  random(overrides: Partial<Customer> = {}): Customer {
    return { id: crypto.randomUUID(), ...CustomerMother.draft(), ...overrides };
  },
};

/** An in-memory `CustomerRepository`. Override a method to make it fail. */
export function fakeCustomerRepository(seed: Customer[] = []): CustomerRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new CustomerError("customer.not_found");
    return found;
  };
  return {
    list: async () => [...store.values()],
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

