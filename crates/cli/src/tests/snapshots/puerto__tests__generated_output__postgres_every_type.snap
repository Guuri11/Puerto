[package]
name = "aplicacion_cliente"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_cliente = { workspace = true }
puerto-nucleo = { workspace = true }
nucleo = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_cliente/pruebas"]

[dev-dependencies]
dominio_cliente = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/cliente/aplicacion/src/actualizar_cliente.rs ===
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_cliente::errores::ErrorCliente;
use dominio_cliente::modelo::{Cliente, IdCliente, PropsCliente};
use dominio_cliente::repositorio::RepositorioCliente;
use dominio_cliente::valores::{Age, Code, Joined, Label, MiddleName, Name, Status};
use nucleo::valores::Email;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsActualizarCliente {
    pub id: IdCliente,
    pub email: String,
    pub name: String,
    pub code: String,
    pub age: i64,
    pub joined: DateTime<Utc>,
    pub middle: Option<String>,
    pub labels: Vec<String>,
    pub status: String,
}

#[async_trait]
pub trait ActualizarCliente: Send + Sync {
    async fn ejecutar(&self, params: ParamsActualizarCliente) -> Result<Cliente, ErrorCliente>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarCliente {}

        #[async_trait]
        impl ActualizarCliente for ActualizarCliente {
            async fn ejecutar(&self, params: ParamsActualizarCliente) -> Result<Cliente, ErrorCliente>;
        }
    }
}

pub struct ActualizarClienteImpl {
    pub repositorio: Arc<dyn RepositorioCliente>,
}

#[async_trait]
impl ActualizarCliente for ActualizarClienteImpl {
    async fn ejecutar(&self, params: ParamsActualizarCliente) -> Result<Cliente, ErrorCliente> {
        tracing::info!(id = %params.id, "actualizar_cliente: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "actualizar_cliente: fallo del repositorio"),
            )?
            .ok_or_else(|| {
                let err = ErrorCliente::NoEncontrado;
                tracing::warn!(error = %err, "actualizar_cliente: rechazado");
                err
            })?;
        let email = Email::new(params.email).map_err(|_| ErrorCliente::EmailInvalido)?;
        let name = Name::new(params.name)?;
        let code = Code::new(params.code)?;
        let age = Age::new(params.age)?;
        let joined = Joined::new(params.joined)?;
        let middle = params.middle.map(MiddleName::new).transpose()?;
        let labels: Vec<Label> = params
            .labels
            .into_iter()
            .map(Label::new)
            .collect::<Result<Vec<_>, _>>()?;
        let status = params.status.parse::<Status>()?;
        entidad
            .actualizar(PropsCliente {
                email,
                name,
                code,
                age,
                joined,
                middle,
                labels,
                status,
            })
            .inspect_err(|e| tracing::warn!(error = %e, "actualizar_cliente: rechazado"))?;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "actualizar_cliente: fallo del repositorio"),
        )?;
        Ok(entidad)
    }
}

