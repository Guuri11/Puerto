use std::sync::Arc;

use business::domain::ticket::model::TicketId;
use business::domain::ticket::use_cases::{
    create_ticket::{CreateTicketParams, CreateTicketUseCaseTrait},
    delete_ticket::{DeleteTicketParams, DeleteTicketUseCaseTrait},
    get_ticket::{GetTicketParams, GetTicketUseCaseTrait},
    list_tickets::{ListTicketsParams, ListTicketsUseCaseTrait},
    update_ticket::{UpdateTicketParams, UpdateTicketUseCaseTrait},
};
use poem_openapi::{OpenApi, param::Path, payload::Json};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::ticket::dto::{CreateTicketRequest, UpdateTicketRequest, TicketDto};
use crate::api::ticket::responses::{
    CreateTicketResponse, DeleteTicketResponse, GetTicketResponse, ListTicketsResponse,
    UpdateTicketResponse,
};

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct TicketApi {
    pub create_ticket: Arc<dyn CreateTicketUseCaseTrait>,
    pub get_ticket: Arc<dyn GetTicketUseCaseTrait>,
    pub list_tickets: Arc<dyn ListTicketsUseCaseTrait>,
    pub update_ticket: Arc<dyn UpdateTicketUseCaseTrait>,
    pub delete_ticket: Arc<dyn DeleteTicketUseCaseTrait>,
}

#[OpenApi]
impl TicketApi {
    /// Create a new Ticket
    #[oai(path = "/tickets", method = "post", tag = "ApiTags::Ticket")]
    async fn create(&self, body: Json<CreateTicketRequest>) -> CreateTicketResponse {
        match self
            .create_ticket
            .execute(CreateTicketParams {
                state: body.state.clone(),
            })
            .await
        {
            Ok(entity) => CreateTicketResponse::Created(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_ticket failed");
                CreateTicketResponse::from_status(status, error)
            }
        }
    }

    /// Get a Ticket by ID
    #[oai(path = "/tickets/:id", method = "get", tag = "ApiTags::Ticket")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetTicketResponse {
        match self
            .get_ticket
            .execute(GetTicketParams { id: TicketId::from_uuid(id.0) })
            .await
        {
            Ok(entity) => GetTicketResponse::Ok(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_ticket failed");
                GetTicketResponse::from_status(status, error)
            }
        }
    }

    /// List all Tickets
    #[oai(path = "/tickets", method = "get", tag = "ApiTags::Ticket")]
    async fn list(&self) -> ListTicketsResponse {
        match self.list_tickets.execute(ListTicketsParams).await {
            Ok(entities) => {
                ListTicketsResponse::Ok(Json(entities.iter().map(TicketDto::from_domain).collect()))
            }
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_tickets failed");
                ListTicketsResponse::from_status(status, error)
            }
        }
    }

    /// Update a Ticket
    #[oai(path = "/tickets/:id", method = "put", tag = "ApiTags::Ticket")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateTicketRequest>) -> UpdateTicketResponse {
        match self
            .update_ticket
            .execute(UpdateTicketParams {
                id: TicketId::from_uuid(id.0),
                state: body.state.clone(),
            })
            .await
        {
            Ok(entity) => UpdateTicketResponse::Ok(Json(TicketDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_ticket failed");
                UpdateTicketResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Ticket
    #[oai(path = "/tickets/:id", method = "delete", tag = "ApiTags::Ticket")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteTicketResponse {
        match self
            .delete_ticket
            .execute(DeleteTicketParams { id: TicketId::from_uuid(id.0) })
            .await
        {
            Ok(()) => DeleteTicketResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_ticket failed");
                DeleteTicketResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::ticket::errors::TicketError;
    use business::domain::ticket::use_cases::{
        create_ticket::mocks::MockCreateTicketUseCase, delete_ticket::mocks::MockDeleteTicketUseCase,
        get_ticket::mocks::MockGetTicketUseCase, list_tickets::mocks::MockListTicketsUseCase,
        update_ticket::mocks::MockUpdateTicketUseCase,
    };
    use business::tests::mothers::ticket_mother::TicketMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateTicketUseCase,
        get: MockGetTicketUseCase,
        list: MockListTicketsUseCase,
        update: MockUpdateTicketUseCase,
        delete: MockDeleteTicketUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = TicketApi {
                create_ticket: Arc::new(self.create),
                get_ticket: Arc::new(self.get),
                list_tickets: Arc::new(self.list),
                update_ticket: Arc::new(self.update),
                delete_ticket: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateTicketRequest {
        CreateTicketRequest {
            state: "example".to_string(),
        }
    }

    fn update_request() -> UpdateTicketRequest {
        UpdateTicketRequest {
            state: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/tickets/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_ticket_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| Ok(TicketMother::random()));

