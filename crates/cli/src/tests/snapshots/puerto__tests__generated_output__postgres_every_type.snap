import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaCliente } from "../vistas/lista-cliente";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaCliente() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const clientes = useCarga(
    () => desenvolver(api.GET("/clientes", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Clientes</h1>
        <Link href="/clientes/nuevo" className="btn btn-primary">
          Crear cliente
        </Link>
      </div>
      {clientes.estado === "cargando" && <span className="loading loading-spinner" />}
      {clientes.estado === "error" && <AlertaError error={clientes.error} />}
      {clientes.estado === "listo" &&
        (clientes.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay clientes." />
        ) : (
          <>
            <VistaListaCliente clientes={clientes.datos.elementos} />
            <Paginacion
              total={clientes.datos.total}
              limite={clientes.datos.limite}
              desplazamiento={clientes.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/cliente/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaCliente {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "cliente.email_invalido": "Email: no válido",
  "cliente.name_invalido": "Name: no válido",
  "cliente.code_invalido": "Code: no válido",
  "cliente.age_invalido": "Age: no válido",
  "cliente.joined_invalido": "Joined: no válido",
  "cliente.middle_name_invalido": "Middle: no válido",
  "cliente.label_invalido": "Labels: no válido",
  "cliente.status_invalido": "Status: no válido",
  "cliente.duplicado": "Estos valores ya están en uso",
  "cliente.no_encontrado": "Ya no existe",
  "cliente.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "cliente.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "cliente.email_invalido": "email",
  "cliente.name_invalido": "name",
  "cliente.code_invalido": "code",
  "cliente.age_invalido": "age",
  "cliente.joined_invalido": "joined",
  "cliente.middle_name_invalido": "middle",
  "cliente.label_invalido": "labels",
  "cliente.status_invalido": "status",
};

export function aProblema(codigo: string): ProblemaCliente {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

