use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;
use business::domain::ticket::value_objects::State;

use business::domain::ticket::{errors::TicketError, model::Ticket};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct TicketDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub state: String,
}

impl TryFrom<TicketDb> for Ticket {
    type Error = TicketError;

    fn try_from(row: TicketDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Ticket {
            id: row.id,
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            state: row.state.parse::<State>()?,
        }))
    }
}

impl From<&Ticket> for TicketDb {
    fn from(entity: &Ticket) -> Self {
        Self {
            id: entity.id,
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            state: entity.state.as_str().to_string(),
        }
    }
}

=== infrastructure/src/ticket/repository.rs ===
use async_trait::async_trait;
use sqlx::PgPool;
use uuid::Uuid;

use business::domain::ticket::{
    errors::TicketError,
    model::Ticket,
    repository::TicketRepositoryTrait,
};

use super::entity::TicketDb;

pub struct PgTicketRepository {
    pub pool: PgPool,
}

impl PgTicketRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl TicketRepositoryTrait for PgTicketRepository {
    async fn find_all(&self) -> Result<Vec<Ticket>, TicketError> {
        tracing::debug!("find_all");
        let rows = sqlx::query_as!(
            TicketDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, state
             FROM tickets WHERE deleted = false ORDER BY created_at DESC"
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            TicketError::RepositoryError
        })?;

        rows.into_iter().map(|r| r.try_into()).collect()
    }

    async fn find_by_id(&self, id: Uuid) -> Result<Option<Ticket>, TicketError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            TicketDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, state
             FROM tickets WHERE id = $1 AND deleted = false",
            id
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            TicketError::RepositoryError
        })?;

        row.map(|r| r.try_into()).transpose()
    }

    async fn save(&self, entity: &Ticket) -> Result<(), TicketError> {
        tracing::debug!(id = %entity.id, "save");
        let db = TicketDb::from(entity);
        sqlx::query!(
            "INSERT INTO tickets (id, created_at, updated_at, deleted, deleted_at, state)
             VALUES ($1, $2, $3, $4, $5, $6)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, state = $6",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.state,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            // 23505 = unique_violation: a `unique` field already taken.
            if let Some(db_err) = e.as_database_error()
                && db_err.code().is_some_and(|c| c == "23505")
            {
                return TicketError::Duplicate;
            }
            tracing::error!(error = %e, "save failed");
            TicketError::RepositoryError
        })?;
        Ok(())
    }
}

