use async_trait::async_trait;
use dominio_billete::errores::ErrorBillete;
use dominio_billete::modelo::IdBillete;
use dominio_billete::repositorio::RepositorioBillete;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarBillete {
    pub id: IdBillete,
}

#[async_trait]
pub trait BorrarBillete: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarBillete) -> Result<(), ErrorBillete>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarBillete {}

        #[async_trait]
        impl BorrarBillete for BorrarBillete {
            async fn ejecutar(&self, params: ParamsBorrarBillete) -> Result<(), ErrorBillete>;
        }
    }
}

pub struct BorrarBilleteImpl {
    pub repositorio: Arc<dyn RepositorioBillete>,
}

#[async_trait]
impl BorrarBillete for BorrarBilleteImpl {
    #[tracing::instrument(name = "borrar_billete", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsBorrarBillete) -> Result<(), ErrorBillete> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorBillete::NoEncontrado)?;
        entidad.borrar();
        self.repositorio.guardar(&entidad).await?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_billete::{
        modelo::IdBillete, pruebas::madres::MadreBillete,
        repositorio::dobles::MockRepositorioBillete,
    };

    #[tokio::test]
    async fn deberia_hacer_borrado_logico_de_billete_cuando_el_id_existe() {
        let entidad = MadreBillete::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = BorrarBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarBillete { id: id_entidad })
            .await;

        assert!(resultado.is_ok());
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_billete_no_existe() {
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = BorrarBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsBorrarBillete {
                id: IdBillete::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.no_encontrado");
    }
}

=== contextos/billete/aplicacion/src/crear_billete.rs ===
use async_trait::async_trait;
use dominio_billete::errores::ErrorBillete;
use dominio_billete::modelo::{Billete, PropsBillete};
use dominio_billete::repositorio::RepositorioBillete;
use dominio_billete::valores::State;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearBillete {
    pub state: String,
}

#[async_trait]
pub trait CrearBillete: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearBillete) -> Result<Billete, ErrorBillete>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearBillete {}

        #[async_trait]
        impl CrearBillete for CrearBillete {
            async fn ejecutar(&self, params: ParamsCrearBillete) -> Result<Billete, ErrorBillete>;
        }
    }
}

pub struct CrearBilleteImpl {
    pub repositorio: Arc<dyn RepositorioBillete>,
}

#[async_trait]
impl CrearBillete for CrearBilleteImpl {
    #[tracing::instrument(name = "crear_billete", skip_all, err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsCrearBillete) -> Result<Billete, ErrorBillete> {
        let state = params.state.parse::<State>()?;
        let entidad = Billete::new(PropsBillete { state })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_billete::pruebas::madres::MadreBillete;
    use dominio_billete::repositorio::dobles::MockRepositorioBillete;
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_crear_billete_cuando_los_campos_son_validos() {
        // Preparar
        let props = MadreBillete::new().construir_props();
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = CrearBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearBillete {
                state: props.state.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(
            resultado.unwrap().state,
            MadreBillete::new().construir_props().state
        );
    }

    #[tokio::test]
    async fn deberia_devolver_duplicado_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let props = MadreBillete::new().construir_props();
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::Duplicado));
        let caso_de_uso = CrearBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearBillete {
                state: props.state.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.duplicado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_state_es_una_cadena_vacia() {
        // Preparar
        let repositorio_doble = MockRepositorioBillete::new();
        let caso_de_uso = CrearBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearBillete {
                state: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.state_invalido");
    }
}

