/**
 * A request about a customer that the API refused. `code` is the API's `ErrorResponse.name`:
 * `customer.not_found`, `customer.validation_error.<field>_empty`.
 */
export class CustomerError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "CustomerError";
    this.code = code;
  }
}

=== web/src/domain/customer/model.ts ===
import { CustomerError } from "./errors";

export interface Customer {
  id: string;
  email: string;
  name: string;
  code: string;
  age: number;
  joined: string;
  middle: string | null;
  labels: string[];
  status: Status;
}

/** What a create or an update sends: a customer without its id. */
export type CustomerDraft = Omit<Customer, "id">;

export const statusValues = ["Active", "Inactive"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `customer.invalid_status`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new CustomerError("customer.invalid_status");
  return found;
}

