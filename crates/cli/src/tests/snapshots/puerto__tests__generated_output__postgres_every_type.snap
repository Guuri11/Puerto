mod tests {
    use super::*;
    use crate::domain::ticket::{
        model::{Ticket, TicketProps},
        repository::mocks::MockTicketRepository,
    };
    use crate::domain::ticket::value_objects::State;


    #[tokio::test]
    async fn should_return_all_tickets() {
        let entities = vec![
            Ticket::new(TicketProps {
            state: State::Open,
        }).unwrap(),
            Ticket::new(TicketProps {
            state: State::Open,
        }).unwrap(),
        ];
        let mut mock_repo = MockTicketRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListTicketParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_tickets_exist() {
        let mut mock_repo = MockTicketRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListTicketParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

