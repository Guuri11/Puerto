import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { BilleteError } from "../../../../domain/billete/errors";
import type { BilleteDraft } from "../../../../domain/billete/model";
import { BilleteMother, fakeBilleteRepository } from "../../../../test-support/billete";
import { renderScreen } from "../../../../test-support/render";
import { BilleteFormContainer } from "./billete-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: BilleteDraft) {
  await screen.findByText("Save");
  type("State", draft.state);
}

describe("BilleteFormContainer", () => {
  test("should create the billete from what was typed and show it", async () => {
    // Arrange
    const draft = BilleteMother.draft();
    const billeteRepository = fakeBilleteRepository();
    const { history } = renderScreen(<BilleteFormContainer />, { billeteRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/billetes/"));
    const {
      items: [created],
    } = await billeteRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/billetes/${created?.id}`);
  });

  test("should save the edited billete when an existing one is submitted", async () => {
    // Arrange
    const seeded = BilleteMother.random();
    const billeteRepository = fakeBilleteRepository([seeded]);
    const { history } = renderScreen(<BilleteFormContainer id={seeded.id} />, {
      billeteRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/billetes/${seeded.id}`));
    expect(await billeteRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "billete.validacion.invalid";
    const billeteRepository = {
      ...fakeBilleteRepository(),
      create: () => Promise.reject(new BilleteError(code)),
    };
    renderScreen(<BilleteFormContainer />, { billeteRepository });
    await fillIn(BilleteMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a billete with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const billeteRepository = {
      ...fakeBilleteRepository(),
      create: () => Promise.reject(new BilleteError("billete.duplicado")),
    };
    renderScreen(<BilleteFormContainer />, { billeteRepository });
    await fillIn(BilleteMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A billete with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const billeteRepository = {
      ...fakeBilleteRepository(),
      create: () => Promise.reject(new BilleteError("billete.state_invalido")),
    };
    renderScreen(<BilleteFormContainer />, { billeteRepository });
    await fillIn(BilleteMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("State is not valid")).toBeTruthy();
    const input = screen.getByLabelText("State");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/billete/containers/billete-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/billete/messages";
import type { Billete } from "../../../../domain/billete/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { BilleteFormView, toBilleteDraft, toBilleteForm } from "../views/billete-form-view";

/** Creates a billete, or edits the one with `id`. */
export function BilleteFormContainer({ id }: { id?: string }) {
  const { billeteRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : billeteRepository.get(id)),
    [billeteRepository, id],
  );
  const title = id === undefined ? "New billete" : "Edit billete";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <BilleteForm existing={existing.data} />}
      <Link href={id === undefined ? "/billetes" : `/billetes/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function BilleteForm({ existing }: { existing: Billete | null }) {
  const { billeteRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toBilleteForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toBilleteDraft(values);
      const saved =
        existing === null
          ? await billeteRepository.create(draft)
          : await billeteRepository.update(existing.id, draft);
      navigate(`/billetes/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <BilleteFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

