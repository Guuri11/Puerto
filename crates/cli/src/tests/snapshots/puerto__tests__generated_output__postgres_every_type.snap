use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::ticket::{
    errors::TicketError,
    repository::TicketRepositoryTrait,
    use_cases::delete_ticket::{DeleteTicketParams, DeleteTicketUseCaseTrait},
};

pub struct DeleteTicketUseCaseImpl {
    pub repository: Arc<dyn TicketRepositoryTrait>,
}

#[async_trait]
impl DeleteTicketUseCaseTrait for DeleteTicketUseCaseImpl {
    async fn execute(&self, params: DeleteTicketParams) -> Result<(), TicketError> {
        tracing::info!(id = %params.id, "delete_ticket: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_ticket: repository failed"))?
            .ok_or_else(|| {
                let err = TicketError::NotFound;
                tracing::warn!(error = %err, "delete_ticket: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "delete_ticket: repository failed"))?;
        Ok(())
    }
}

