use super::errors::CustomerError;
use chrono::{DateTime, Utc};

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    value: String,
}

impl Name {
    pub fn new(value: String) -> Result<Self, CustomerError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(CustomerError::InvalidName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Code {
    value: String,
}

impl Code {
    pub fn new(value: String) -> Result<Self, CustomerError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(CustomerError::InvalidCode);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Age(i64);

impl Age {
    pub fn new(value: i64) -> Result<Self, CustomerError> {
        Ok(Self(value))
    }

    pub fn value(&self) -> i64 {
        self.0
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Joined(DateTime<Utc>);

impl Joined {
    pub fn new(value: DateTime<Utc>) -> Result<Self, CustomerError> {
        Ok(Self(value))
    }

    pub fn value(&self) -> DateTime<Utc> {
        self.0
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    value: String,
}

impl MiddleName {
    pub fn new(value: String) -> Result<Self, CustomerError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(CustomerError::InvalidMiddleName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Label {
    value: String,
}

impl Label {
    pub fn new(value: String) -> Result<Self, CustomerError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(CustomerError::InvalidLabel);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Active,
    Inactive,
}

impl std::str::FromStr for Status {
    type Err = CustomerError;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Active" => Ok(Self::Active),
            "Inactive" => Ok(Self::Inactive),
            _ => Err(CustomerError::InvalidStatus),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Active => "Active",
            Self::Inactive => "Inactive",
        }
    }
}

=== business/src/domain/product/errors.rs ===
use thiserror::Error;

use crate::domain::shared::repository_error::RepositoryError;

#[derive(Debug, Error)]
pub enum ProductError {
    #[error("product.validation_error.{0}")]
    ValidationError(String),
    #[error("product.not_found")]
    NotFound,
    #[error("product.duplicate")]
    Duplicate,
    #[error("product.repository_error")]
    RepositoryError,
    #[error("product.unknown")]
    Unknown,
}

impl From<RepositoryError> for ProductError {
    /// Exhaustive on purpose: a new repository failure does not compile until it has a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = ProductError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "product.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = ProductError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "product.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = ProductError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "product.repository_error");
    }
}

=== business/src/domain/product/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;
use std::collections::HashMap;

use super::errors::ProductError;

/// The id of every `Product`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ProductId(Uuid);

impl ProductId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for ProductId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct ProductProps {
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
}

#[derive(Debug, Clone)]
pub struct Product {
    pub id: ProductId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
}

impl Product {
    pub fn new(props: ProductProps) -> Result<Self, ProductError> {
        if props.title.trim().is_empty() {
            return Err(ProductError::ValidationError("title_empty".into()));
        }
        if props.sku.trim().is_empty() {
            return Err(ProductError::ValidationError("sku_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: ProductId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            sku: props.sku,
            price: props.price,
            rating: props.rating,
            active: props.active,
            ref_id: props.ref_id,
            published_at: props.published_at,
            summary: props.summary,
            views: props.views,
            expires_at: props.expires_at,
            tags: props.tags,
            scores: props.scores,
            meta: props.meta,
        })
    }

    pub fn from_repository(data: Product) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_product_when_fields_are_valid() {
        let result = Product::new(ProductProps {
            title: "example".to_string(),
            sku: "example".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert_eq!(result.unwrap().title, "example");
    }


    #[test]
    fn should_reject_product_when_title_is_empty() {
        let result = Product::new(ProductProps {
            title: "".into(),
            sku: "example".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_product_when_title_is_only_whitespace() {
        let result = Product::new(ProductProps {
            title: "   ".into(),
            sku: "example".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_product_when_sku_is_empty() {
        let result = Product::new(ProductProps {
            title: "example".to_string(),
            sku: "".into(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.sku_empty"
        );
    }

    #[test]
    fn should_reject_product_when_sku_is_only_whitespace() {
        let result = Product::new(ProductProps {
            title: "example".to_string(),
            sku: "   ".into(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
    }
}

