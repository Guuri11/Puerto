use crate::domain::customer::model::Customer;
use crate::domain::customer::model::CustomerProps;
use chrono::Utc;
use crate::domain::shared::value_objects::Email;
use crate::domain::customer::value_objects::Name;
use crate::domain::customer::value_objects::Code;
use crate::domain::customer::value_objects::Age;
use crate::domain::customer::value_objects::Joined;
use crate::domain::customer::value_objects::MiddleName;
use crate::domain::customer::value_objects::Label;
use crate::domain::customer::value_objects::Status;

pub struct CustomerMother {
    email: Option<Email>,
    name: Option<Name>,
    code: Option<Code>,
    age: Option<Age>,
    joined: Option<Joined>,
    middle: Option<MiddleName>,
    labels: Option<Vec<Label>>,
    status: Option<Status>,
}

impl CustomerMother {
    pub fn new() -> Self {
        Self { email: None, name: None, code: None, age: None, joined: None, middle: None, labels: None, status: None }
    }

    pub fn with_email(mut self, email: Email) -> Self {
        self.email = Some(email);
        self
    }

    pub fn with_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn with_code(mut self, code: Code) -> Self {
        self.code = Some(code);
        self
    }

    pub fn with_age(mut self, age: Age) -> Self {
        self.age = Some(age);
        self
    }

    pub fn with_joined(mut self, joined: Joined) -> Self {
        self.joined = Some(joined);
        self
    }

    pub fn with_middle(mut self, middle: MiddleName) -> Self {
        self.middle = Some(middle);
        self
    }

    pub fn with_labels(mut self, labels: Vec<Label>) -> Self {
        self.labels = Some(labels);
        self
    }

    pub fn with_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn build(self) -> Customer {
        Customer::new(CustomerProps {
            email: self.email.unwrap_or_else(|| Email::new("example".to_string()).expect("valid Email")),
            name: self.name.unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            code: self.code.unwrap_or_else(|| Code::new("example".to_string()).expect("valid Code")),
            age: self.age.unwrap_or_else(|| Age::new(42).expect("valid Age")),
            joined: self.joined.unwrap_or_else(|| Joined::new(Utc::now()).expect("valid Joined")),
            middle: self.middle,
            labels: self.labels.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
        })
        .expect("CustomerMother: failed to build valid Customer")
    }

    pub fn build_props(self) -> CustomerProps {
        CustomerProps {
            email: self.email.unwrap_or_else(|| Email::new("example".to_string()).expect("valid Email")),
            name: self.name.unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            code: self.code.unwrap_or_else(|| Code::new("example".to_string()).expect("valid Code")),
            age: self.age.unwrap_or_else(|| Age::new(42).expect("valid Age")),
            joined: self.joined.unwrap_or_else(|| Joined::new(Utc::now()).expect("valid Joined")),
            middle: self.middle,
            labels: self.labels.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Active),
        }
    }

    pub fn random() -> Customer {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Customer> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for CustomerMother {
    fn default() -> Self {
        Self::new()
    }
}

