use business::domain::ticket::errors::TicketError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;

use crate::api::error::{ErrorResponse, IntoErrorResponse};

impl IntoErrorResponse for TicketError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            TicketError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            TicketError::NotFound => StatusCode::NOT_FOUND,
            TicketError::Duplicate => StatusCode::CONFLICT,
            TicketError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            TicketError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            TicketError::InvalidState => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
