use crate::domain::ticket::model::Ticket;
use crate::domain::ticket::model::TicketProps;
use crate::domain::ticket::value_objects::State;

pub struct TicketMother {
    state: Option<State>,
}

impl TicketMother {
    pub fn new() -> Self {
        Self { state: None }
    }

    pub fn with_state(mut self, state: State) -> Self {
        self.state = Some(state);
        self
    }

    pub fn build(self) -> Ticket {
        Ticket::new(TicketProps {
            state: self.state.unwrap_or(State::Open),
        })
        .expect("TicketMother: failed to build valid Ticket")
    }

    pub fn build_props(self) -> TicketProps {
        TicketProps {
            state: self.state.unwrap_or(State::Open),
        }
    }

    pub fn random() -> Ticket {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Ticket> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for TicketMother {
    fn default() -> Self {
        Self::new()
    }
}

=== docker-compose.yml ===
services:
  postgres:
    image: postgres:16
    container_name: snapshot-postgres
    ports:
      - "${DB_HOST_PORT:-5432}:5432"
    environment:
      POSTGRES_USER: devuser
      POSTGRES_PASSWORD: password
      POSTGRES_DB: snapshot
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U devuser -d snapshot"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  postgres-data:

