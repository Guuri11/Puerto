}

=== contextos/billete/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_billete::{
    actualizar_billete::{ActualizarBillete, ParamsActualizarBillete},
    borrar_billete::{BorrarBillete, ParamsBorrarBillete},
    crear_billete::{CrearBillete, ParamsCrearBillete},
    listar_billetes::{ListarBilletes, ParamsListarBilletes},
    obtener_billete::{ObtenerBillete, ParamsObtenerBillete},
};
use dominio_billete::modelo::IdBillete;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoBillete, DtoPaginaBillete, PeticionActualizarBillete, PeticionCrearBillete};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarBillete, RespuestaBorrarBillete, RespuestaCrearBillete,
    RespuestaListarBilletes, RespuestaObtenerBillete,
};

#[derive(Tags)]
enum ApiTags {
    Billete,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiBillete {
    pub crear_billete: Arc<dyn CrearBillete>,
    pub obtener_billete: Arc<dyn ObtenerBillete>,
    pub listar_billetes: Arc<dyn ListarBilletes>,
    pub actualizar_billete: Arc<dyn ActualizarBillete>,
    pub borrar_billete: Arc<dyn BorrarBillete>,
}

#[OpenApi]
impl ApiBillete {
    /// Crea: Billete
    #[oai(path = "/billetes", method = "post", tag = "ApiTags::Billete")]
    async fn crear(&self, cuerpo: Json<PeticionCrearBillete>) -> RespuestaCrearBillete {
        match self
            .crear_billete
            .ejecutar(ParamsCrearBillete {
                state: cuerpo.state.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearBillete::Creado(Json(DtoBillete::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_billete falló");
                RespuestaCrearBillete::from_status(status, error)
            }
        }
    }

    /// Obtiene: Billete por id
    #[oai(path = "/billetes/:id", method = "get", tag = "ApiTags::Billete")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerBillete {
        match self
            .obtener_billete
            .ejecutar(ParamsObtenerBillete {
                id: IdBillete::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerBillete::Ok(Json(DtoBillete::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_billete falló");
                RespuestaObtenerBillete::from_status(status, error)
            }
        }
    }

    /// Lista Billetes, página a página (el dominio acota `limite`)
    #[oai(path = "/billetes", method = "get", tag = "ApiTags::Billete")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarBilletes {
        match self
            .listar_billetes
            .ejecutar(ParamsListarBilletes {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarBilletes::Ok(Json(DtoPaginaBillete::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_billetes falló");
                RespuestaListarBilletes::from_status(status, error)
            }
        }
    }

    /// Actualiza: Billete
    #[oai(path = "/billetes/:id", method = "put", tag = "ApiTags::Billete")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarBillete>,
    ) -> RespuestaActualizarBillete {
        match self
            .actualizar_billete
            .ejecutar(ParamsActualizarBillete {
                id: IdBillete::from_uuid(id.0),
                state: cuerpo.state.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarBillete::Ok(Json(DtoBillete::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_billete falló");
                RespuestaActualizarBillete::from_status(status, error)
            }
        }
    }

    /// Borra: Billete
    #[oai(path = "/billetes/:id", method = "delete", tag = "ApiTags::Billete")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarBillete {
        match self
            .borrar_billete
            .ejecutar(ParamsBorrarBillete {
                id: IdBillete::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarBillete::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_billete falló");
                RespuestaBorrarBillete::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_billete::{
        actualizar_billete::dobles::MockActualizarBillete,
        borrar_billete::dobles::MockBorrarBillete, crear_billete::dobles::MockCrearBillete,
        listar_billetes::dobles::MockListarBilletes, obtener_billete::dobles::MockObtenerBillete,
    };
    use dominio_billete::errores::ErrorBillete;
    use dominio_billete::pruebas::madres::MadreBillete;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearBillete,
        obtener: MockObtenerBillete,
        listar: MockListarBilletes,
        actualizar: MockActualizarBillete,
        borrar: MockBorrarBillete,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiBillete {
                crear_billete: Arc::new(self.crear),
                obtener_billete: Arc::new(self.obtener),
                listar_billetes: Arc::new(self.listar),
                actualizar_billete: Arc::new(self.actualizar),
                borrar_billete: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearBillete {
        PeticionCrearBillete {
            state: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarBillete {
        PeticionActualizarBillete {
            state: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/billetes/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_billete() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreBillete::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/billetes")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_billete_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorBillete::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/billetes")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_billete_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreBillete::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_billete_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorBillete::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_billetes_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreBillete::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/billetes").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/billetes?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorBillete::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/billetes").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_billete() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreBillete::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_billete_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorBillete::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_billete() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_billete_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorBillete::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

