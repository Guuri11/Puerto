import type { Page, PageRequest } from "../shared/page";
import type { Billete, BilleteDraft } from "./model";

/** The port the screens call. Every method rejects with the `BilleteError` the API answered. */
export interface BilleteRepository {
  list(page: PageRequest): Promise<Page<Billete>>;
  get(id: string): Promise<Billete>;
  create(draft: BilleteDraft): Promise<Billete>;
  update(id: string, draft: BilleteDraft): Promise<Billete>;
  remove(id: string): Promise<void>;
}

