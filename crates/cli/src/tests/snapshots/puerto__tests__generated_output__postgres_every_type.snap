=== presentation/src/api/customer/routes.rs ===
use std::sync::Arc;

use business::domain::customer::model::CustomerId;
use business::domain::customer::use_cases::{
    create_customer::{CreateCustomerParams, CreateCustomerUseCaseTrait},
    delete_customer::{DeleteCustomerParams, DeleteCustomerUseCaseTrait},
    get_customer::{GetCustomerParams, GetCustomerUseCaseTrait},
    list_customers::{ListCustomersParams, ListCustomersUseCaseTrait},
    update_customer::{UpdateCustomerParams, UpdateCustomerUseCaseTrait},
};
use poem_openapi::{OpenApi, param::Path, payload::Json};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::customer::dto::{CreateCustomerRequest, UpdateCustomerRequest, CustomerDto};
use crate::api::customer::responses::{
    CreateCustomerResponse, DeleteCustomerResponse, GetCustomerResponse, ListCustomersResponse,
    UpdateCustomerResponse,
};

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct CustomerApi {
    pub create_customer: Arc<dyn CreateCustomerUseCaseTrait>,
    pub get_customer: Arc<dyn GetCustomerUseCaseTrait>,
    pub list_customers: Arc<dyn ListCustomersUseCaseTrait>,
    pub update_customer: Arc<dyn UpdateCustomerUseCaseTrait>,
    pub delete_customer: Arc<dyn DeleteCustomerUseCaseTrait>,
}

#[OpenApi]
impl CustomerApi {
    /// Create a new Customer
    #[oai(path = "/customers", method = "post", tag = "ApiTags::Customer")]
    async fn create(&self, body: Json<CreateCustomerRequest>) -> CreateCustomerResponse {
        match self
            .create_customer
            .execute(CreateCustomerParams {
                email: body.email.clone(),
                name: body.name.clone(),
                code: body.code.clone(),
                age: body.age,
                joined: body.joined,
                middle: body.middle.clone(),
                labels: body.labels.clone(),
                status: body.status.clone(),
            })
            .await
        {
            Ok(entity) => CreateCustomerResponse::Created(Json(CustomerDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_customer failed");
                CreateCustomerResponse::from_status(status, error)
            }
        }
    }

    /// Get a Customer by ID
    #[oai(path = "/customers/:id", method = "get", tag = "ApiTags::Customer")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetCustomerResponse {
        match self
            .get_customer
            .execute(GetCustomerParams { id: CustomerId::from_uuid(id.0) })
            .await
        {
            Ok(entity) => GetCustomerResponse::Ok(Json(CustomerDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_customer failed");
                GetCustomerResponse::from_status(status, error)
            }
        }
    }

    /// List all Customers
    #[oai(path = "/customers", method = "get", tag = "ApiTags::Customer")]
    async fn list(&self) -> ListCustomersResponse {
        match self.list_customers.execute(ListCustomersParams).await {
            Ok(entities) => {
                ListCustomersResponse::Ok(Json(entities.iter().map(CustomerDto::from_domain).collect()))
            }
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_customers failed");
                ListCustomersResponse::from_status(status, error)
            }
        }
    }

    /// Update a Customer
    #[oai(path = "/customers/:id", method = "put", tag = "ApiTags::Customer")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateCustomerRequest>) -> UpdateCustomerResponse {
        match self
            .update_customer
            .execute(UpdateCustomerParams {
                id: CustomerId::from_uuid(id.0),
                email: body.email.clone(),
                name: body.name.clone(),
                code: body.code.clone(),
                age: body.age,
                joined: body.joined,
                middle: body.middle.clone(),
                labels: body.labels.clone(),
                status: body.status.clone(),
            })
            .await
        {
            Ok(entity) => UpdateCustomerResponse::Ok(Json(CustomerDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_customer failed");
                UpdateCustomerResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Customer
    #[oai(path = "/customers/:id", method = "delete", tag = "ApiTags::Customer")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteCustomerResponse {
        match self
            .delete_customer
            .execute(DeleteCustomerParams { id: CustomerId::from_uuid(id.0) })
            .await
        {
            Ok(()) => DeleteCustomerResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_customer failed");
                DeleteCustomerResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::customer::errors::CustomerError;
    use business::domain::customer::use_cases::{
        create_customer::mocks::MockCreateCustomerUseCase, delete_customer::mocks::MockDeleteCustomerUseCase,
        get_customer::mocks::MockGetCustomerUseCase, list_customers::mocks::MockListCustomersUseCase,
        update_customer::mocks::MockUpdateCustomerUseCase,
    };
    use business::tests::mothers::customer_mother::CustomerMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use chrono::Utc;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateCustomerUseCase,
        get: MockGetCustomerUseCase,
        list: MockListCustomersUseCase,
        update: MockUpdateCustomerUseCase,
        delete: MockDeleteCustomerUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = CustomerApi {
                create_customer: Arc::new(self.create),
                get_customer: Arc::new(self.get),
                list_customers: Arc::new(self.list),
                update_customer: Arc::new(self.update),
                delete_customer: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateCustomerRequest {
        CreateCustomerRequest {
            email: "example".to_string(),
            name: "example".to_string(),
            code: "example".to_string(),
            age: 42,
            joined: Utc::now(),
            middle: None,
            labels: vec![],
            status: "example".to_string(),
        }
    }

    fn update_request() -> UpdateCustomerRequest {
        UpdateCustomerRequest {
            email: "example".to_string(),
            name: "example".to_string(),
            code: "example".to_string(),
            age: 42,
            joined: Utc::now(),
            middle: None,
            labels: vec![],
            status: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/customers/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_customer_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| Ok(CustomerMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/customers")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_customer_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(CustomerError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/customers")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_customer_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Ok(CustomerMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_customer_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Err(CustomerError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_every_customer_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Ok(CustomerMother::random_vec(2)));

        // Act
        let response = mocks.client().get("/customers").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        response.json().await.value().array().assert_len(2);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Err(CustomerError::RepositoryError));

        // Act
        let response = mocks.client().get("/customers").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_customer_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Ok(CustomerMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_customer() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Err(CustomerError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_customer_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_customer() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Err(CustomerError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

