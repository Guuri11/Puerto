import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CustomerError } from "../../../../domain/customer/errors";
import type { CustomerDraft } from "../../../../domain/customer/model";
import { CustomerMother, fakeCustomerRepository } from "../../../../test-support/customer";
import { renderScreen } from "../../../../test-support/render";
import { textOf, toDateTimeLocal } from "../../../shared/forms";
import { CustomerFormContainer } from "./customer-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: CustomerDraft) {
  await screen.findByText("Save");
  type("Email", draft.email);
  type("Name", draft.name);
  type("Code", draft.code);
  type("Age", String(draft.age));
  type("Joined", toDateTimeLocal(draft.joined));
  type("Middle", textOf(draft.middle));
  type("Labels", draft.labels.join(", "));
  type("Status", draft.status);
}

describe("CustomerFormContainer", () => {
  test("should create the customer from what was typed and show it", async () => {
    // Arrange
    const draft = CustomerMother.draft();
    const customerRepository = fakeCustomerRepository();
    const { history } = renderScreen(<CustomerFormContainer />, { customerRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/customers/"));
    const [created] = await customerRepository.list();
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/customers/${created?.id}`);
  });

  test("should save the edited customer when an existing one is submitted", async () => {
    // Arrange
    const seeded = CustomerMother.random();
    const customerRepository = fakeCustomerRepository([seeded]);
    const { history } = renderScreen(<CustomerFormContainer id={seeded.id} />, {
      customerRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/customers/${seeded.id}`));
    expect(await customerRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the validation code when the API rejects the customer", async () => {
    // Arrange
    const code = "customer.validation_error.invalid";
    const customerRepository = {
      ...fakeCustomerRepository(),
      create: () => Promise.reject(new CustomerError(code)),
    };
    renderScreen(<CustomerFormContainer />, { customerRepository });
    await fillIn(CustomerMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });
});

=== web/src/presentation/features/customer/containers/customer-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Customer } from "../../../../domain/customer/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { CustomerFormView, toCustomerDraft, toCustomerForm } from "../views/customer-form-view";

/** Creates a customer, or edits the one with `id`. */
export function CustomerFormContainer({ id }: { id?: string }) {
  const { customerRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : customerRepository.get(id)),
    [customerRepository, id],
  );
  const title = id === undefined ? "New customer" : "Edit customer";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <CustomerForm existing={existing.data} />}
      <Link href={id === undefined ? "/customers" : `/customers/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function CustomerForm({ existing }: { existing: Customer | null }) {
  const { customerRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toCustomerForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toCustomerDraft(values);
      const saved =
        existing === null
          ? await customerRepository.create(draft)
          : await customerRepository.update(existing.id, draft);
      navigate(`/customers/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {failure !== null && <ErrorAlert error={failure} />}
        <CustomerFormView values={values} saving={saving} onChange={setValues} onSubmit={save} />
      </div>
    </div>
  );
}

