      price: 42,
      rating: 1.5,
      active: true,
      refId: crypto.randomUUID(),
      publishedAt: "2026-01-01T10:00:00.000Z",
      summary: "example",
      views: 42,
      expiresAt: "2026-01-01T10:00:00.000Z",
      tags: ["example"],
      scores: [42],
      meta: { key: "value" },
      ...overrides,
    };
  },

