      ...fakeBilleteRepository(),
      list: () => Promise.reject(new BilleteError("billete.repositorio")),
    };

    // Act
    renderScreen(<BilleteListContainer />, { billeteRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("billete.repositorio");
  });
});

=== web/src/presentation/features/billete/containers/billete-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { BilleteListView } from "../views/billete-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function BilleteListContainer() {
  const { billeteRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const billetes = useAsync(
    () => billeteRepository.list({ limit: PAGE_SIZE, offset }),
    [billeteRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Billetes</h1>
        <Link href="/billetes/new" className="btn btn-primary">
          New billete
        </Link>
      </div>
      {billetes.status === "loading" && <span className="loading loading-spinner" />}
      {billetes.status === "error" && <ErrorAlert error={billetes.error} />}
      {billetes.status === "ok" &&
        (billetes.data.total === 0 ? (
          <EmptyState message="No billetes yet." />
        ) : (
          <>
            <BilleteListView billetes={billetes.data.items} />
            <Pagination {...billetes.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

