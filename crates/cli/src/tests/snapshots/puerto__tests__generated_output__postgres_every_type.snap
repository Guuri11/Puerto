    </dl>
  );
}

=== web/src/contextos/cliente/vistas/formulario-cliente.tsx ===
import type { Esquemas } from "../../../api/cliente";
import {
  aFechaHoraLocal,
  deFechaHoraLocal,
  separarLista,
  textoDe,
  textoOpcional,
} from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaCliente } from "../mensajes";

type Cliente = Esquemas["DtoCliente"];
type PeticionCliente = Esquemas["PeticionCrearCliente"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioCliente {
  email: string;
  name: string;
  code: string;
  age: string;
  joined: string;
  middle: string;
  labels: string;
  status: string;
}

/** Los inputs de `cliente`, vacíos cuando todavía no hay ninguno. */
export function aFormularioCliente(cliente: Cliente | null): ValoresFormularioCliente {
  if (cliente === null) {
    return {
      email: "",
      name: "",
      code: "",
      age: "",
      joined: "",
      middle: "",
      labels: "",
      status: "",
    };
  }
  return {
    email: cliente.email,
    name: cliente.name,
    code: cliente.code,
    age: String(cliente.age),
    joined: aFechaHoraLocal(cliente.joined),
    middle: textoDe(cliente.middle),
    labels: cliente.labels.join(", "),
    status: cliente.status,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionCliente(valores: ValoresFormularioCliente): PeticionCliente {
  return {
    email: valores.email,
    name: valores.name,
    code: valores.code,
    age: Number(valores.age),
    joined: deFechaHoraLocal(valores.joined),
    middle: textoOpcional(valores.middle),
    labels: separarLista(valores.labels),
    status: valores.status,
  };
}

export function VistaFormularioCliente({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioCliente;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaCliente | null;
  alCambiar: (valores: ValoresFormularioCliente) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "email"}
          required
          value={valores.email}
          onChange={(event) => alCambiar({ ...valores, email: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="email" />
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "name"}
          required
          value={valores.name}
          onChange={(event) => alCambiar({ ...valores, name: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Code</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "code"}
          required
          value={valores.code}
          onChange={(event) => alCambiar({ ...valores, code: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="code" />
      <label className="fieldset">
        <span className="fieldset-legend">Age</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "age"}
          required
          value={valores.age}
          onChange={(event) => alCambiar({ ...valores, age: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="age" />
      <label className="fieldset">
        <span className="fieldset-legend">Joined</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problema?.campo === "joined"}
          required
          value={valores.joined}
          onChange={(event) => alCambiar({ ...valores, joined: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="joined" />
      <label className="fieldset">
        <span className="fieldset-legend">Middle</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "middle"}
          value={valores.middle}
          onChange={(event) => alCambiar({ ...valores, middle: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="middle" />
      <label className="fieldset">
        <span className="fieldset-legend">Labels</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "labels"}
          value={valores.labels}
          onChange={(event) => alCambiar({ ...valores, labels: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="labels" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "status"}
          required
          value={valores.status}
          onChange={(event) => alCambiar({ ...valores, status: event.target.value })}
        >
          <option value="">Elige una opción</option>
          <option value="Active">Active</option>
          <option value="Inactive">Inactive</option>
        </select>
      </label>
      <ErrorCampo problema={problema} campo="status" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

