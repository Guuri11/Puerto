=== web/src/presentation/features/producto/views/producto-form-view.tsx ===
import type { ProductoProblem } from "../../../../domain/producto/messages";
import type { Producto, ProductoDraft } from "../../../../domain/producto/model";
import {
  dateTimeOrNull,
  formatEntries,
  fromDateTimeLocal,
  numberOrNull,
  parseEntries,
  splitList,
  splitNumbers,
  textOf,
  textOrNull,
  toDateTimeLocal,
} from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ProductoFormValues {
  title: string;
  sku: string;
  price: string;
  rating: string;
  active: boolean;
  refId: string;
  publishedAt: string;
  summary: string;
  views: string;
  expiresAt: string;
  tags: string;
  scores: string;
  meta: string;
}

/** The inputs for `producto`, empty when there is none yet. */
export function toProductoForm(producto: Producto | null): ProductoFormValues {
  if (producto === null) {
    return {
      title: "",
      sku: "",
      price: "",
      rating: "",
      active: false,
      refId: "",
      publishedAt: "",
      summary: "",
      views: "",
      expiresAt: "",
      tags: "",
      scores: "",
      meta: "",
    };
  }
  return {
    title: producto.title,
    sku: producto.sku,
    price: String(producto.price),
    rating: String(producto.rating),
    active: producto.active,
    refId: producto.refId,
    publishedAt: toDateTimeLocal(producto.publishedAt),
    summary: textOf(producto.summary),
    views: textOf(producto.views),
    expiresAt: toDateTimeLocal(producto.expiresAt),
    tags: producto.tags.join(", "),
    scores: producto.scores.join(", "),
    meta: formatEntries(producto.meta),
  };
}

export function toProductoDraft(values: ProductoFormValues): ProductoDraft {
  return {
    title: values.title,
    sku: values.sku,
    price: Number(values.price),
    rating: Number(values.rating),
    active: values.active,
    refId: values.refId,
    publishedAt: fromDateTimeLocal(values.publishedAt),
    summary: textOrNull(values.summary),
    views: numberOrNull(values.views),
    expiresAt: dateTimeOrNull(values.expiresAt),
    tags: splitList(values.tags),
    scores: splitNumbers(values.scores),
    meta: parseEntries(values.meta),
  };
}

export function ProductoFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: ProductoFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: ProductoProblem | null;
  onChange: (values: ProductoFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "title"}
          required
          value={values.title}
          onChange={(event) => onChange({ ...values, title: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "sku"}
          required
          value={values.sku}
          onChange={(event) => onChange({ ...values, sku: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="sku" />
      <label className="fieldset">
        <span className="fieldset-legend">Price</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "price"}
          required
          value={values.price}
          onChange={(event) => onChange({ ...values, price: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="price" />
      <label className="fieldset">
        <span className="fieldset-legend">Rating</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "rating"}
          step="any"
          required
          value={values.rating}
          onChange={(event) => onChange({ ...values, rating: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="rating" />
      <label className="label">
        <input
          className="checkbox"
          type="checkbox"
          checked={values.active}
          onChange={(event) => onChange({ ...values, active: event.target.checked })}
        />
        Active
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Ref id</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "refId"}
          required
          value={values.refId}
          onChange={(event) => onChange({ ...values, refId: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="refId" />
      <label className="fieldset">
        <span className="fieldset-legend">Published at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problem?.field === "publishedAt"}
          required
          value={values.publishedAt}
          onChange={(event) => onChange({ ...values, publishedAt: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="publishedAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Summary</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "summary"}
          value={values.summary}
          onChange={(event) => onChange({ ...values, summary: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="summary" />
      <label className="fieldset">
        <span className="fieldset-legend">Views</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "views"}
          value={values.views}
          onChange={(event) => onChange({ ...values, views: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="views" />
      <label className="fieldset">
        <span className="fieldset-legend">Expires at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problem?.field === "expiresAt"}
          value={values.expiresAt}
          onChange={(event) => onChange({ ...values, expiresAt: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="expiresAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "tags"}
          value={values.tags}
          onChange={(event) => onChange({ ...values, tags: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Scores</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "scores"}
          value={values.scores}
          onChange={(event) => onChange({ ...values, scores: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="scores" />
      <label className="fieldset">
        <span className="fieldset-legend">Meta</span>
        <textarea
          className="textarea w-full"
          aria-invalid={problem?.field === "meta"}
          placeholder="key=value, one per line"
          value={values.meta}
          onChange={(event) => onChange({ ...values, meta: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="meta" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

=== web/src/presentation/features/producto/views/producto-list-view.tsx ===
import { Link } from "wouter";
import type { Producto } from "../../../../domain/producto/model";
import { formatDateTime, formatEntries } from "../../../shared/forms";

export function ProductoListView({ productos }: { productos: Producto[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Sku</th>
            <th>Price</th>
            <th>Rating</th>
            <th>Active</th>
            <th>Ref id</th>
            <th>Published at</th>
            <th>Summary</th>
            <th>Views</th>
            <th>Expires at</th>
            <th>Tags</th>
            <th>Scores</th>
            <th>Meta</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {productos.map((producto) => (
            <tr key={producto.id}>
              <td>{producto.title}</td>
              <td>{producto.sku}</td>
              <td>{producto.price}</td>
              <td>{producto.rating}</td>
              <td>{producto.active ? "Yes" : "No"}</td>
              <td>{producto.refId}</td>
              <td>{formatDateTime(producto.publishedAt)}</td>
              <td>{producto.summary ?? "—"}</td>
              <td>{producto.views ?? "—"}</td>
              <td>{producto.expiresAt === null ? "—" : formatDateTime(producto.expiresAt)}</td>
              <td>{producto.tags.join(", ")}</td>
              <td>{producto.scores.join(", ")}</td>
              <td>{formatEntries(producto.meta, ", ")}</td>
              <td className="text-right">
                <Link href={`/productos/${producto.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

