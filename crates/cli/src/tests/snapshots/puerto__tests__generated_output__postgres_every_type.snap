use chrono::{DateTime, Utc};
use dominio_cliente::valores::Age;
use dominio_cliente::valores::Code;
use dominio_cliente::valores::Joined;
use dominio_cliente::valores::Label;
use dominio_cliente::valores::MiddleName;
use dominio_cliente::valores::Name;
use dominio_cliente::valores::Status;
use nucleo::valores::Email;
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_cliente::{
    errores::ErrorCliente,
    modelo::{Cliente, IdCliente},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaCliente {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub email: String,
    pub name: String,
    pub code: String,
    pub age: i64,
    pub joined: DateTime<Utc>,
    pub middle: Option<String>,
    pub labels: Vec<String>,
    pub status: String,
}

impl TryFrom<FilaCliente> for Cliente {
    type Error = ErrorCliente;

    fn try_from(fila: FilaCliente) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Cliente {
            id: IdCliente::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            email: Email::new(fila.email).map_err(|_| ErrorCliente::EmailInvalido)?,
            name: Name::new(fila.name)?,
            code: Code::new(fila.code)?,
            age: Age::new(fila.age)?,
            joined: Joined::new(fila.joined)?,
            middle: fila.middle.map(MiddleName::new).transpose()?,
            labels: fila
                .labels
                .into_iter()
                .map(Label::new)
                .collect::<Result<Vec<_>, _>>()?,
            status: fila.status.parse::<Status>()?,
        }))
    }
}

impl From<&Cliente> for FilaCliente {
    fn from(entidad: &Cliente) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            email: entidad.email.valor().to_string(),
            name: entidad.name.valor().to_string(),
            code: entidad.code.valor().to_string(),
            age: entidad.age.valor(),
            joined: entidad.joined.valor(),
            middle: entidad.middle.as_ref().map(|v| v.valor().to_string()),
            labels: entidad
                .labels
                .iter()
                .map(|v| v.valor().to_string())
                .collect::<Vec<_>>(),
            status: entidad.status.as_str().to_string(),
        }
    }
}

