=== web/src/contextos/billete/vistas/formulario-billete.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaBillete } from "../mensajes";

type Billete = Esquemas["DtoBillete"];
type PeticionBillete = Esquemas["PeticionCrearBillete"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioBillete {
  state: string;
}

/** Los inputs de `billete`, vacíos cuando todavía no hay ninguno. */
export function aFormularioBillete(billete: Billete | null): ValoresFormularioBillete {
  if (billete === null) {
    return {
      state: "",
    };
  }
  return {
    state: billete.state,
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionBillete(valores: ValoresFormularioBillete): PeticionBillete {
  return {
    state: valores.state,
  };
}

export function VistaFormularioBillete({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioBillete;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaBillete | null;
  alCambiar: (valores: ValoresFormularioBillete) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">State</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "state"}
          required
          value={valores.state}
          onChange={(event) => alCambiar({ ...valores, state: event.target.value })}
        >
          <option value="">Elige una opción</option>
          <option value="Open">Open</option>
          <option value="Closed">Closed</option>
        </select>
      </label>
      <ErrorCampo problema={problema} campo="state" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

