=== web/src/presentation/features/cliente/views/cliente-form-view.tsx ===
import type { ClienteProblem } from "../../../../domain/cliente/messages";
import { type Cliente, type ClienteDraft, parseStatus } from "../../../../domain/cliente/model";
import {
  fromDateTimeLocal,
  splitList,
  textOf,
  textOrNull,
  toDateTimeLocal,
} from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ClienteFormValues {
  email: string;
  name: string;
  code: string;
  age: string;
  joined: string;
  middle: string;
  labels: string;
  status: string;
}

/** The inputs for `cliente`, empty when there is none yet. */
export function toClienteForm(cliente: Cliente | null): ClienteFormValues {
  if (cliente === null) {
    return {
      email: "",
      name: "",
      code: "",
      age: "",
      joined: "",
      middle: "",
      labels: "",
      status: "",
    };
  }
  return {
    email: cliente.email,
    name: cliente.name,
    code: cliente.code,
    age: String(cliente.age),
    joined: toDateTimeLocal(cliente.joined),
    middle: textOf(cliente.middle),
    labels: cliente.labels.join(", "),
    status: cliente.status,
  };
}

export function toClienteDraft(values: ClienteFormValues): ClienteDraft {
  return {
    email: values.email,
    name: values.name,
    code: values.code,
    age: Number(values.age),
    joined: fromDateTimeLocal(values.joined),
    middle: textOrNull(values.middle),
    labels: splitList(values.labels),
    status: parseStatus(values.status),
  };
}

export function ClienteFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: ClienteFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: ClienteProblem | null;
  onChange: (values: ClienteFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "email"}
          required
          value={values.email}
          onChange={(event) => onChange({ ...values, email: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="email" />
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "name"}
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Code</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "code"}
          required
          value={values.code}
          onChange={(event) => onChange({ ...values, code: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="code" />
      <label className="fieldset">
        <span className="fieldset-legend">Age</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "age"}
          required
          value={values.age}
          onChange={(event) => onChange({ ...values, age: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="age" />
      <label className="fieldset">
        <span className="fieldset-legend">Joined</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problem?.field === "joined"}
          required
          value={values.joined}
          onChange={(event) => onChange({ ...values, joined: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="joined" />
      <label className="fieldset">
        <span className="fieldset-legend">Middle</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "middle"}
          value={values.middle}
          onChange={(event) => onChange({ ...values, middle: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="middle" />
      <label className="fieldset">
        <span className="fieldset-legend">Labels</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "labels"}
          value={values.labels}
          onChange={(event) => onChange({ ...values, labels: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="labels" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "status"}
          required
          value={values.status}
          onChange={(event) => onChange({ ...values, status: event.target.value })}
        >
          <option value="">Choose…</option>
          <option value="Active">Active</option>
          <option value="Inactive">Inactive</option>
        </select>
      </label>
      <FieldError problem={problem} field="status" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

