use thiserror::Error;

#[derive(Debug, Error)]
pub enum CustomerError {
    #[error("customer.validation_error.{0}")]
    ValidationError(String),
    #[error("customer.not_found")]
    NotFound,
    #[error("customer.duplicate")]
    Duplicate,
    #[error("customer.repository_error")]
    RepositoryError,
    #[error("customer.unknown")]
    Unknown,
    #[error("customer.invalid_email")]
    InvalidEmail,
    #[error("customer.invalid_name")]
    InvalidName,
    #[error("customer.invalid_code")]
    InvalidCode,
    #[error("customer.invalid_age")]
    InvalidAge,
    #[error("customer.invalid_joined")]
    InvalidJoined,
    #[error("customer.invalid_middle_name")]
    InvalidMiddleName,
    #[error("customer.invalid_label")]
    InvalidLabel,
    #[error("customer.invalid_status")]
    InvalidStatus,
}

=== business/src/domain/customer/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;
use crate::domain::shared::value_objects::Email;
use super::value_objects::Name;
use super::value_objects::Code;
use super::value_objects::Age;
use super::value_objects::Joined;
use super::value_objects::MiddleName;
use super::value_objects::Label;
use super::value_objects::Status;

use super::errors::CustomerError;

#[derive(Debug, Clone)]
pub struct CustomerProps {
    pub email: Email,
    pub name: Name,
    pub code: Code,
    pub age: Age,
    pub joined: Joined,
    pub middle: Option<MiddleName>,
    pub labels: Vec<Label>,
    pub status: Status,
}

#[derive(Debug, Clone)]
pub struct Customer {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub email: Email,
    pub name: Name,
    pub code: Code,
    pub age: Age,
    pub joined: Joined,
    pub middle: Option<MiddleName>,
    pub labels: Vec<Label>,
    pub status: Status,
}

impl Customer {
    pub fn new(props: CustomerProps) -> Result<Self, CustomerError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            email: props.email,
            name: props.name,
            code: props.code,
            age: props.age,
            joined: props.joined,
            middle: props.middle,
            labels: props.labels,
            status: props.status,
        })
    }

    pub fn from_repository(data: Customer) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_customer_when_fields_are_valid() {
        let result = Customer::new(CustomerProps {
            email: Email::new("example".to_string()).expect("valid Email"),
            name: Name::new("example".to_string()).expect("valid Name"),
            code: Code::new("example".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        });
        assert!(result.is_ok());
    }


    #[test]
    fn should_reject_customer_when_email_is_empty() {
        let result = Email::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shared.value_object.email.invalid"
        );
    }

    #[test]
    fn should_reject_customer_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.invalid_name"
        );
    }

    #[test]
    fn should_reject_customer_when_code_is_empty() {
        let result = Code::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.invalid_code"
        );
    }

    #[test]
    fn should_reject_customer_when_status_is_invalid() {
        let result = "InvalidVariant".parse::<Status>();
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.invalid_status"
        );
    }
}

