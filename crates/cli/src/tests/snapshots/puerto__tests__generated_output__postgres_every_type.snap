=== contextos/billete/aplicacion/src/crear_billete.rs ===
use async_trait::async_trait;
use dominio_billete::errores::ErrorBillete;
use dominio_billete::modelo::{Billete, PropsBillete};
use dominio_billete::repositorio::RepositorioBillete;
use dominio_billete::valores::State;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearBillete {
    pub state: String,
}

#[async_trait]
pub trait CrearBillete: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearBillete) -> Result<Billete, ErrorBillete>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearBillete {}

        #[async_trait]
        impl CrearBillete for CrearBillete {
            async fn ejecutar(&self, params: ParamsCrearBillete) -> Result<Billete, ErrorBillete>;
        }
    }
}

pub struct CrearBilleteImpl {
    pub repositorio: Arc<dyn RepositorioBillete>,
}

#[async_trait]
impl CrearBillete for CrearBilleteImpl {
    async fn ejecutar(&self, params: ParamsCrearBillete) -> Result<Billete, ErrorBillete> {
        tracing::info!("crear_billete: inicio");
        let state = params.state.parse::<State>()?;
        let entidad = Billete::new(PropsBillete { state })
            .inspect_err(|e| tracing::warn!(error = %e, "crear_billete: rechazado"))?;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "crear_billete: fallo del repositorio"))?;
        tracing::info!(id = %entidad.id, "crear_billete: fin");
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_billete::pruebas::madres::MadreBillete;
    use dominio_billete::repositorio::dobles::MockRepositorioBillete;
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_crear_billete_cuando_los_campos_son_validos() {
        // Preparar
        let props = MadreBillete::new().construir_props();
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = CrearBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearBillete {
                state: props.state.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(
            resultado.unwrap().state,
            MadreBillete::new().construir_props().state
        );
    }

    #[tokio::test]
    async fn deberia_devolver_duplicado_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
        let props = MadreBillete::new().construir_props();
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_guardar()
            .returning(|_| Err(ErrorRepositorio::Duplicado));
        let caso_de_uso = CrearBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearBillete {
                state: props.state.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.duplicado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_state_es_una_cadena_vacia() {
        // Preparar
        let repositorio_doble = MockRepositorioBillete::new();
        let caso_de_uso = CrearBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearBillete {
                state: "".to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.state_invalido");
    }
}

