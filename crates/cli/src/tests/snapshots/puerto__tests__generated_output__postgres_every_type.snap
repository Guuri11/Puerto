use std::sync::Arc;

use async_trait::async_trait;
use crate::domain::ticket::value_objects::State;

use crate::domain::ticket::{
    errors::TicketError,
    model::{Ticket, TicketProps},
    repository::TicketRepositoryTrait,
    use_cases::create_ticket::{CreateTicketParams, CreateTicketUseCaseTrait},
};

pub struct CreateTicketUseCaseImpl {
    pub repository: Arc<dyn TicketRepositoryTrait>,
}

#[async_trait]
impl CreateTicketUseCaseTrait for CreateTicketUseCaseImpl {
    async fn execute(&self, params: CreateTicketParams) -> Result<Ticket, TicketError> {
        tracing::info!("create_ticket: start");
let state = params.state.parse::<State>()?;
        let entity = Ticket::new(TicketProps {
            state,
        }).inspect_err(|e| tracing::warn!(error = %e, "create_ticket: rejected"))?;
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "create_ticket: repository failed"))?;
        tracing::info!(id = %entity.id, "create_ticket: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::ticket::repository::mocks::MockTicketRepository;


    #[tokio::test]
    async fn should_create_ticket_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockTicketRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateTicketParams {
            state: "Open".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().state.as_str(), "Open");
    }

    #[tokio::test]
    async fn should_return_error_when_state_is_empty() {
        // Arrange
        let mock_repo = MockTicketRepository::new();
        let use_case = CreateTicketUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateTicketParams {
            state: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "ticket.invalid_state"
        );
    }
}

