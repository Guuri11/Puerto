import { Link } from "wouter";
import type { Billete } from "../../../../domain/billete/model";

export function BilleteListView({ billetes }: { billetes: Billete[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>State</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {billetes.map((billete) => (
            <tr key={billete.id}>
              <td>{billete.state}</td>
              <td className="text-right">
                <Link href={`/billetes/${billete.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

