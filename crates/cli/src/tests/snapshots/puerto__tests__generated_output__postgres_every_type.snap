import { ClienteError } from "../../domain/cliente/errors";
import { type Cliente, type ClienteDraft, parseStatus } from "../../domain/cliente/model";
import type { ClienteRepository } from "../../domain/cliente/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ClienteDto = components["schemas"]["DtoCliente"];
type ClienteRequest = components["schemas"]["PeticionCrearCliente"];

function toCliente(dto: ClienteDto): Cliente {
  return {
    id: dto.id,
    email: dto.email,
    name: dto.name,
    code: dto.code,
    age: dto.age,
    joined: dto.joined,
    middle: dto.middle ?? null,
    labels: dto.labels,
    status: parseStatus(dto.status),
  };
}

function toRequest(draft: ClienteDraft): ClienteRequest {
  return {
    email: draft.email,
    name: draft.name,
    code: draft.code,
    age: draft.age,
    joined: draft.joined,
    middle: draft.middle ?? undefined,
    labels: draft.labels,
    status: draft.status,
  };
}

/** `ClienteRepository` over the REST API (`/clientes`). */
export function clienteRepositoryHttp(api: ApiClient): ClienteRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/clientes", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toCliente),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/clientes/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return toCliente(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/clientes", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return toCliente(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/clientes/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ClienteError(apiErrorCode(error, response));
      return toCliente(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/clientes/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ClienteError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `RespuestaError.codigo` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "codigo" in error) {
    const { codigo } = error;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${response.status}`;
}

