=== web/src/presentation/features/customer/views/customer-form-view.tsx ===
import { type Customer, type CustomerDraft, parseStatus } from "../../../../domain/customer/model";
import {
  fromDateTimeLocal,
  splitList,
  textOf,
  textOrNull,
  toDateTimeLocal,
} from "../../../shared/forms";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface CustomerFormValues {
  email: string;
  name: string;
  code: string;
  age: string;
  joined: string;
  middle: string;
  labels: string;
  status: string;
}

/** The inputs for `customer`, empty when there is none yet. */
export function toCustomerForm(customer: Customer | null): CustomerFormValues {
  if (customer === null) {
    return {
      email: "",
      name: "",
      code: "",
      age: "",
      joined: "",
      middle: "",
      labels: "",
      status: "",
    };
  }
  return {
    email: customer.email,
    name: customer.name,
    code: customer.code,
    age: String(customer.age),
    joined: toDateTimeLocal(customer.joined),
    middle: textOf(customer.middle),
    labels: customer.labels.join(", "),
    status: customer.status,
  };
}

export function toCustomerDraft(values: CustomerFormValues): CustomerDraft {
  return {
    email: values.email,
    name: values.name,
    code: values.code,
    age: Number(values.age),
    joined: fromDateTimeLocal(values.joined),
    middle: textOrNull(values.middle),
    labels: splitList(values.labels),
    status: parseStatus(values.status),
  };
}

export function CustomerFormView({
  values,
  saving,
  onChange,
  onSubmit,
}: {
  values: CustomerFormValues;
  saving: boolean;
  onChange: (values: CustomerFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Email</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.email}
          onChange={(event) => onChange({ ...values, email: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Code</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.code}
          onChange={(event) => onChange({ ...values, code: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Age</span>
        <input
          className="input w-full"
          type="number"
          required
          value={values.age}
          onChange={(event) => onChange({ ...values, age: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Joined</span>
        <input
          className="input w-full"
          type="datetime-local"
          required
          value={values.joined}
          onChange={(event) => onChange({ ...values, joined: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Middle</span>
        <input
          className="input w-full"
          type="text"
          value={values.middle}
          onChange={(event) => onChange({ ...values, middle: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Labels</span>
        <input
          className="input w-full"
          type="text"
          value={values.labels}
          onChange={(event) => onChange({ ...values, labels: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          required
          value={values.status}
          onChange={(event) => onChange({ ...values, status: event.target.value })}
        >
          <option value="">Choose…</option>
          <option value="Active">Active</option>
          <option value="Inactive">Inactive</option>
        </select>
      </label>
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

