=== web/src/presentation/features/product/views/product-form-view.tsx ===
import type { Product, ProductDraft } from "../../../../domain/product/model";
import {
  dateTimeOrNull,
  formatEntries,
  fromDateTimeLocal,
  numberOrNull,
  parseEntries,
  splitList,
  splitNumbers,
  textOf,
  textOrNull,
  toDateTimeLocal,
} from "../../../shared/forms";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ProductFormValues {
  title: string;
  sku: string;
  price: string;
  rating: string;
  active: boolean;
  refId: string;
  publishedAt: string;
  summary: string;
  views: string;
  expiresAt: string;
  tags: string;
  scores: string;
  meta: string;
}

/** The inputs for `product`, empty when there is none yet. */
export function toProductForm(product: Product | null): ProductFormValues {
  if (product === null) {
    return {
      title: "",
      sku: "",
      price: "",
      rating: "",
      active: false,
      refId: "",
      publishedAt: "",
      summary: "",
      views: "",
      expiresAt: "",
      tags: "",
      scores: "",
      meta: "",
    };
  }
  return {
    title: product.title,
    sku: product.sku,
    price: String(product.price),
    rating: String(product.rating),
    active: product.active,
    refId: product.refId,
    publishedAt: toDateTimeLocal(product.publishedAt),
    summary: textOf(product.summary),
    views: textOf(product.views),
    expiresAt: toDateTimeLocal(product.expiresAt),
    tags: product.tags.join(", "),
    scores: product.scores.join(", "),
    meta: formatEntries(product.meta),
  };
}

export function toProductDraft(values: ProductFormValues): ProductDraft {
  return {
    title: values.title,
    sku: values.sku,
    price: Number(values.price),
    rating: Number(values.rating),
    active: values.active,
    refId: values.refId,
    publishedAt: fromDateTimeLocal(values.publishedAt),
    summary: textOrNull(values.summary),
    views: numberOrNull(values.views),
    expiresAt: dateTimeOrNull(values.expiresAt),
    tags: splitList(values.tags),
    scores: splitNumbers(values.scores),
    meta: parseEntries(values.meta),
  };
}

export function ProductFormView({
  values,
  saving,
  onChange,
  onSubmit,
}: {
  values: ProductFormValues;
  saving: boolean;
  onChange: (values: ProductFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.title}
          onChange={(event) => onChange({ ...values, title: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.sku}
          onChange={(event) => onChange({ ...values, sku: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Price</span>
        <input
          className="input w-full"
          type="number"
          required
          value={values.price}
          onChange={(event) => onChange({ ...values, price: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Rating</span>
        <input
          className="input w-full"
          type="number"
          step="any"
          required
          value={values.rating}
          onChange={(event) => onChange({ ...values, rating: event.target.value })}
        />
      </label>
      <label className="label">
        <input
          className="checkbox"
          type="checkbox"
          checked={values.active}
          onChange={(event) => onChange({ ...values, active: event.target.checked })}
        />
        Active
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Ref id</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.refId}
          onChange={(event) => onChange({ ...values, refId: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Published at</span>
        <input
          className="input w-full"
          type="datetime-local"
          required
          value={values.publishedAt}
          onChange={(event) => onChange({ ...values, publishedAt: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Summary</span>
        <input
          className="input w-full"
          type="text"
          value={values.summary}
          onChange={(event) => onChange({ ...values, summary: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Views</span>
        <input
          className="input w-full"
          type="number"
          value={values.views}
          onChange={(event) => onChange({ ...values, views: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Expires at</span>
        <input
          className="input w-full"
          type="datetime-local"
          value={values.expiresAt}
          onChange={(event) => onChange({ ...values, expiresAt: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          value={values.tags}
          onChange={(event) => onChange({ ...values, tags: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Scores</span>
        <input
          className="input w-full"
          type="text"
          value={values.scores}
          onChange={(event) => onChange({ ...values, scores: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Meta</span>
        <textarea
          className="textarea w-full"
          placeholder="key=value, one per line"
          value={values.meta}
          onChange={(event) => onChange({ ...values, meta: event.target.value })}
        />
      </label>
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

