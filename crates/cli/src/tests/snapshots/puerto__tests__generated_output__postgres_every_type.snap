import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleCliente } from "../vistas/detalle-cliente";

export function ContenedorDetalleCliente({ id }: { id: string }) {
  const { api } = useDependencias();
  const cliente = useCarga(
    () => desenvolver(api.GET("/clientes/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/clientes/{id}", { params: { path: { id } } }));
      navegar("/clientes");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Cliente</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {cliente.estado === "cargando" && <span className="loading loading-spinner" />}
      {cliente.estado === "error" && <AlertaError error={cliente.error} />}
      {cliente.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleCliente cliente={cliente.datos} />
            <div className="card-actions justify-end">
              <Link href={`/clientes/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/clientes" className="link">
        Volver a clientes
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar cliente?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/cliente/contenedores/formulario-cliente.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { aFechaHoraLocal, textoDe } from "../../../compartido/formularios";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCliente, MadreCliente } from "../../../pruebas/cliente";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioCliente } from "./formulario-cliente";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearCliente"]) {
  await screen.findByText("Guardar");
  escribir("Email", peticion.email);
  escribir("Name", peticion.name);
  escribir("Code", peticion.code);
  escribir("Age", String(peticion.age));
  escribir("Joined", aFechaHoraLocal(peticion.joined));
  escribir("Middle", textoDe(peticion.middle));
  escribir("Labels", peticion.labels.join(", "));
  escribir("Status", peticion.status);
}

describe("ContenedorFormularioCliente", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreCliente.peticion();
    const guardados = coleccionCliente();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioCliente />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/clientes/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/clientes/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreCliente.aleatorio();
    const guardados = coleccionCliente([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioCliente id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/clientes/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreCliente.peticion();
    const codigo = "cliente.validacion.invalido";
    const fallos = { "POST /clientes": codigo };
    const api = apiFalsa([coleccionCliente()], fallos);
    renderizarPantalla(<ContenedorFormularioCliente />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreCliente.peticion();
    const codigo = "cliente.duplicado";
    const fallos = { "POST /clientes": codigo };
    const api = apiFalsa([coleccionCliente()], fallos);
    renderizarPantalla(<ContenedorFormularioCliente />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreCliente.peticion();
    const codigo = "cliente.email_invalido";
    const fallos = { "POST /clientes": codigo };
    const api = apiFalsa([coleccionCliente()], fallos);
    renderizarPantalla(<ContenedorFormularioCliente />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Email");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/cliente/contenedores/formulario-cliente.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioCliente,
  aPeticionCliente,
  VistaFormularioCliente,
} from "../vistas/formulario-cliente";

type Cliente = Esquemas["DtoCliente"];

/** Crear, o editar con `id`: el formulario de clientes. */
export function ContenedorFormularioCliente({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/clientes/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear cliente" : "Editar cliente";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioCliente existente={existente.datos} />}
      <Link href={id === undefined ? "/clientes" : `/clientes/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioCliente({ existente }: { existente: Cliente | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioCliente(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionCliente(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/clientes", { body: cuerpo })
          : api.PUT("/clientes/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/clientes/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioCliente
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

