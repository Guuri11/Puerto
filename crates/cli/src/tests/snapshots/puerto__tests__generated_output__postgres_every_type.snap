import { describe, expect, test } from "bun:test";
import { screen } from "@testing-library/react";
import { TicketError } from "../../../../domain/ticket/errors";
import { renderScreen } from "../../../../test-support/render";
import { fakeTicketRepository, TicketMother } from "../../../../test-support/ticket";
import { TicketListContainer } from "./ticket-list-container";

describe("TicketListContainer", () => {
  test("should show a row per ticket when there are some", async () => {
    // Arrange
    const seed = [TicketMother.random(), TicketMother.random()];
    const ticketRepository = fakeTicketRepository(seed);

    // Act
    renderScreen(<TicketListContainer />, { ticketRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should say so when there is no ticket", async () => {
    // Arrange
    const ticketRepository = fakeTicketRepository();

    // Act
    renderScreen(<TicketListContainer />, { ticketRepository });

    // Assert
    expect(await screen.findByText("No tickets yet.")).toBeTruthy();
  });

  test("should show the error code when the tickets cannot be listed", async () => {
    // Arrange
    const ticketRepository = {
      ...fakeTicketRepository(),
      list: () => Promise.reject(new TicketError("ticket.repository_error")),
    };

    // Act
    renderScreen(<TicketListContainer />, { ticketRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("ticket.repository_error");
  });
});

