import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { BilleteMother, fakeBilleteRepository } from "../../../../test-support/billete";
import { renderScreen } from "../../../../test-support/render";
import { BilleteDetailContainer } from "./billete-detail-container";

describe("BilleteDetailContainer", () => {
  test("should show the billete when it exists", async () => {
    // Arrange
    const seeded = BilleteMother.random();
    const billeteRepository = fakeBilleteRepository([seeded]);

    // Act
    renderScreen(<BilleteDetailContainer id={seeded.id} />, { billeteRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the billete does not exist", async () => {
    // Arrange
    const billeteRepository = fakeBilleteRepository();

    // Act
    renderScreen(<BilleteDetailContainer id={crypto.randomUUID()} />, {
      billeteRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("billete.no_encontrado");
  });

  test("should delete the billete only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = BilleteMother.random();
    const fake = fakeBilleteRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<BilleteDetailContainer id={seeded.id} />, {
      billeteRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/billetes"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/billete/containers/billete-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { BilleteDetailView } from "../views/billete-detail-view";

export function BilleteDetailContainer({ id }: { id: string }) {
  const { billeteRepository } = useDependencies();
  const billete = useAsync(() => billeteRepository.get(id), [billeteRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await billeteRepository.remove(id);
      navigate("/billetes");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Billete</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {billete.status === "loading" && <span className="loading loading-spinner" />}
      {billete.status === "error" && <ErrorAlert error={billete.error} />}
      {billete.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <BilleteDetailView billete={billete.data} />
            <div className="card-actions justify-end">
              <Link href={`/billetes/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/billetes" className="link">
        Back to billetes
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this billete?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

