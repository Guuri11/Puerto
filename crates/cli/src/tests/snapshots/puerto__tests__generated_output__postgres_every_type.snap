=== contextos/billete/dominio/src/valores.rs ===
use crate::errores::ErrorBillete;

#[derive(Debug, Clone, PartialEq)]
pub enum State {
    Open,
    Closed,
}

impl std::str::FromStr for State {
    type Err = ErrorBillete;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Open" => Ok(Self::Open),
            "Closed" => Ok(Self::Closed),
            _ => Err(ErrorBillete::StateInvalido),
        }
    }
}

impl State {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Open => "Open",
            Self::Closed => "Closed",
        }
    }
}

