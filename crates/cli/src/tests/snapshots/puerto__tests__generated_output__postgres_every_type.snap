use async_trait::async_trait;
use dominio_billete::errores::ErrorBillete;
use dominio_billete::modelo::{Billete, IdBillete};
use dominio_billete::repositorio::RepositorioBillete;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerBillete {
    pub id: IdBillete,
}

#[async_trait]
pub trait ObtenerBillete: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerBillete) -> Result<Billete, ErrorBillete>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerBillete {}

        #[async_trait]
        impl ObtenerBillete for ObtenerBillete {
            async fn ejecutar(&self, params: ParamsObtenerBillete) -> Result<Billete, ErrorBillete>;
        }
    }
}

pub struct ObtenerBilleteImpl {
    pub repositorio: Arc<dyn RepositorioBillete>,
}

#[async_trait]
impl ObtenerBillete for ObtenerBilleteImpl {
    #[tracing::instrument(name = "obtener_billete", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsObtenerBillete) -> Result<Billete, ErrorBillete> {
        self.repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorBillete::NoEncontrado)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_billete::{
        modelo::IdBillete, pruebas::madres::MadreBillete,
        repositorio::dobles::MockRepositorioBillete,
    };
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_devolver_billete_cuando_el_id_existe() {
        let entidad = MadreBillete::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ObtenerBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerBillete { id: id_entidad })
            .await;

        assert_eq!(resultado.unwrap().id, id_entidad);
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_el_id_no_existe() {
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ObtenerBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerBillete {
                id: IdBillete::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_de_repositorio_cuando_el_almacen_no_esta_disponible() {
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Err(ErrorRepositorio::NoDisponible));
        let caso_de_uso = ObtenerBilleteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerBillete {
                id: IdBillete::generar(),
            })
            .await;

        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "billete.repositorio");
    }
}

