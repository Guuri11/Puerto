            active: true,
            ref_id: Uuid::new_v4(),
            published_at: chrono::DateTime::from_timestamp(1_700_000_000, 0).unwrap(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: std::collections::HashMap::new(),
        }).unwrap();
        second.sku = first.sku.clone();

        // Act
        let result = test_repo(pool).save(&second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
    }
}

=== infrastructure/src/ticket/entity.rs ===
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;
use business::domain::ticket::value_objects::State;

use business::domain::ticket::{
    errors::TicketError,
    model::{Ticket, TicketId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct TicketDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub state: String,
}

impl TryFrom<TicketDb> for Ticket {
    type Error = TicketError;

    fn try_from(row: TicketDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Ticket {
            id: TicketId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            state: row.state.parse::<State>()?,
        }))
    }
}

impl From<&Ticket> for TicketDb {
    fn from(entity: &Ticket) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            state: entity.state.as_str().to_string(),
        }
    }
}

=== infrastructure/src/ticket/repository.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::shared::repository_error::RepositoryError;
use business::domain::ticket::{
    model::{Ticket, TicketId},
    repository::TicketRepositoryTrait,
};

use super::entity::TicketDb;
use crate::db::map_sqlx_error;

pub struct PgTicketRepository {
    pub pool: PgPool,
}

impl PgTicketRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: TicketDb) -> Result<Ticket, RepositoryError> {
    Ticket::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid ticket");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl TicketRepositoryTrait for PgTicketRepository {
    async fn find_all(&self) -> Result<Vec<Ticket>, RepositoryError> {
        tracing::debug!("find_all");
        let rows = sqlx::query_as!(
            TicketDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, state
             FROM tickets WHERE deleted = false ORDER BY created_at DESC"
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;

        rows.into_iter().map(to_domain).collect()
    }

    async fn find_by_id(&self, id: TicketId) -> Result<Option<Ticket>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            TicketDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, state
             FROM tickets WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }

    async fn save(&self, entity: &Ticket) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = TicketDb::from(entity);
        sqlx::query!(
            "INSERT INTO tickets (id, created_at, updated_at, deleted, deleted_at, state)
             VALUES ($1, $2, $3, $4, $5, $6)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, state = $6",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.state,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error(&e)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod integration_tests {
    use super::*;
    use business::domain::ticket::model::TicketProps;

    use business::domain::ticket::value_objects::State;

    fn test_repo(pool: PgPool) -> PgTicketRepository {
        PgTicketRepository::new(pool)
    }

    async fn seed(pool: &PgPool) -> Ticket {
        let entity = Ticket::new(TicketProps {
            state: State::Open,
        }).unwrap();
        test_repo(pool.clone()).save(&entity).await.unwrap();
        entity
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool).find_by_id(entity.id).await.unwrap().unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.state, entity.state);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool).find_by_id(TicketId::generate()).await.unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_entity_on_save_conflict(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        test_repo(pool.clone()).save(&entity).await.unwrap();

        // Assert
        let found = test_repo(pool).find_by_id(entity.id).await.unwrap();
        assert!(found.is_some());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_tickets_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        seed(&pool).await;

        // Act
        let results = test_repo(pool).find_all().await.unwrap();

        // Assert
        assert_eq!(results.len(), 2);
    }
}

