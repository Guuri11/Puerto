use chrono::{DateTime, Utc};
use dominio_billete::valores::State;
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_billete::{
    errores::ErrorBillete,
    modelo::{Billete, IdBillete},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaBillete {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub state: String,
}

impl TryFrom<FilaBillete> for Billete {
    type Error = ErrorBillete;

    fn try_from(fila: FilaBillete) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Billete {
            id: IdBillete::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            state: fila.state.parse::<State>()?,
        }))
    }
}

impl From<&Billete> for FilaBillete {
    fn from(entidad: &Billete) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            state: entidad.state.as_str().to_string(),
        }
    }
}

