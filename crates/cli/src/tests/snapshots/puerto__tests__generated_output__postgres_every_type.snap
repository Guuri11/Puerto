=== contextos/billete/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorBillete {
    #[error("billete.validacion.{0}")]
    Validacion(String),
    #[error("billete.no_encontrado")]
    NoEncontrado,
    #[error("billete.duplicado")]
    Duplicado,
    #[error("billete.repositorio")]
    Repositorio,
    #[error("billete.desconocido")]
    Desconocido,
    #[error("billete.state_invalido")]
    StateInvalido,
}

impl From<ErrorRepositorio> for ErrorBillete {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorBillete::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "billete.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorBillete::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "billete.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorBillete::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "billete.repositorio");
    }
}

