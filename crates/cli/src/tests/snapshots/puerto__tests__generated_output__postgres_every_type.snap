import { Link } from "wouter";
import type { Cliente } from "../../../../domain/cliente/model";
import { formatDateTime } from "../../../shared/forms";

export function ClienteListView({ clientes }: { clientes: Cliente[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Code</th>
            <th>Age</th>
            <th>Joined</th>
            <th>Middle</th>
            <th>Labels</th>
            <th>Status</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {clientes.map((cliente) => (
            <tr key={cliente.id}>
              <td>{cliente.email}</td>
              <td>{cliente.name}</td>
              <td>{cliente.code}</td>
              <td>{cliente.age}</td>
              <td>{formatDateTime(cliente.joined)}</td>
              <td>{cliente.middle ?? "—"}</td>
              <td>{cliente.labels.join(", ")}</td>
              <td>{cliente.status}</td>
              <td className="text-right">
                <Link href={`/clientes/${cliente.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

