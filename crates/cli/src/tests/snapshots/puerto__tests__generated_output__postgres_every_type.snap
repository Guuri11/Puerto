/**
 * A request about a billete that the API refused. `code` is the API's `RespuestaError.codigo`:
 * `billete.no_encontrado`, `billete.validacion.<field>_vacio`.
 */
export class BilleteError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "BilleteError";
    this.code = code;
  }
}

=== web/src/domain/billete/messages.ts ===
import type { BilleteDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface BilleteProblem {
  field: keyof BilleteDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "billete.state_invalido": "State is not valid",
  "billete.duplicado": "A billete with these values already exists",
  "billete.no_encontrado": "This billete no longer exists",
  "billete.repositorio": "The billete could not be saved, try again later",
  "billete.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof BilleteDraft> = {
  "billete.state_invalido": "state",
};

export function toProblem(code: string): BilleteProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/domain/billete/model.ts ===
import { BilleteError } from "./errors";

export interface Billete {
  id: string;
  state: State;
}

/** What a create or an update sends: a billete without its id. */
export type BilleteDraft = Omit<Billete, "id">;

export const stateValues = ["Open", "Closed"] as const;

export type State = (typeof stateValues)[number];

/** Narrows the API's `string` to a `State`, rejecting with `billete.state_invalido`. */
export function parseState(value: string): State {
  const found = stateValues.find((candidate) => candidate === value);
  if (found === undefined) throw new BilleteError("billete.state_invalido");
  return found;
}

