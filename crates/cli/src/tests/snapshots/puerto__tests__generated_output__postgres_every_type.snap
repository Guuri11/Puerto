use crate::errores::ErrorCliente;
use chrono::{DateTime, Utc};

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorCliente> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCliente::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Code {
    valor: String,
}

impl Code {
    pub fn new(valor: String) -> Result<Self, ErrorCliente> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCliente::CodeInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Age(i64);

impl Age {
    pub fn new(valor: i64) -> Result<Self, ErrorCliente> {
        Ok(Self(valor))
    }

    pub fn valor(&self) -> i64 {
        self.0
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Joined(DateTime<Utc>);

impl Joined {
    pub fn new(valor: DateTime<Utc>) -> Result<Self, ErrorCliente> {
        Ok(Self(valor))
    }

    pub fn valor(&self) -> DateTime<Utc> {
        self.0
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    valor: String,
}

impl MiddleName {
    pub fn new(valor: String) -> Result<Self, ErrorCliente> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCliente::MiddleNameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Label {
    valor: String,
}

impl Label {
    pub fn new(valor: String) -> Result<Self, ErrorCliente> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCliente::LabelInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Active,
    Inactive,
}

impl std::str::FromStr for Status {
    type Err = ErrorCliente;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Active" => Ok(Self::Active),
            "Inactive" => Ok(Self::Inactive),
            _ => Err(ErrorCliente::StatusInvalido),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Active => "Active",
            Self::Inactive => "Inactive",
        }
    }
}

