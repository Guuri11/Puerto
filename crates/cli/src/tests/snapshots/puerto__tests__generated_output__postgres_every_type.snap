=== contextos/billete/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad billete válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_billete::modelo::Billete;
use dominio_billete::pruebas::madres::MadreBillete;
use dominio_billete::repositorio::RepositorioBillete;
use sqlx::PgPool;

use crate::repositorio::RepositorioBilletePostgres;

/// Una entidad billete válida, sin guardar, con los valores de la madre.
pub fn construir() -> Billete {
    MadreBillete::aleatorio()
}

/// Una entidad billete guardada.
pub async fn sembrar(pool: &PgPool) -> Billete {
    let entidad = construir();
    RepositorioBilletePostgres::new(pool.clone())
        .guardar(&entidad)
        .await
        .unwrap();
    entidad
}

=== contextos/billete/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_billete::{
    modelo::{Billete, IdBillete},
    repositorio::RepositorioBillete,
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::mapear_error_sqlx;

use crate::fila::FilaBillete;

pub struct RepositorioBilletePostgres {
    pub pool: PgPool,
}

impl RepositorioBilletePostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaBillete) -> Result<Billete, ErrorRepositorio> {
    Billete::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad billete válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioBillete for RepositorioBilletePostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Billete>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        let filas = sqlx::query_as!(
            FilaBillete,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, state
             FROM billetes WHERE borrado = false
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento())
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM billetes WHERE borrado = false"#
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdBillete) -> Result<Option<Billete>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaBillete,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, state
             FROM billetes WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }

    async fn guardar(&self, entidad: &Billete) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaBillete::from(entidad);
        sqlx::query!(
            "INSERT INTO billetes (id, creado_en, actualizado_en, borrado, borrado_en, state)
             VALUES ($1, $2, $3, $4, $5, $6)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, state = $6",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.state,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx(&e)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::sembrar;

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioBilletePostgres {
        RepositorioBilletePostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.state, entidad.state);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdBillete::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_la_entidad_al_guardar_un_id_existente(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        repositorio_de_prueba(pool.clone())
            .guardar(&entidad)
            .await
            .unwrap();

        // Comprobar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap();
        assert!(encontrado.is_some());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_billetes_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        repositorio_de_prueba(pool.clone())
            .guardar(&borrado)
            .await
            .unwrap();

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }
}

