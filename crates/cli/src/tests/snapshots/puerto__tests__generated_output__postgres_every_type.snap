use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::customer::{
    errors::CustomerError,
    model::Customer,
    repository::CustomerRepositoryTrait,
    use_cases::get_customer::{GetCustomerParams, GetCustomerUseCaseTrait},
};

pub struct GetCustomerUseCaseImpl {
    pub repository: Arc<dyn CustomerRepositoryTrait>,
}

#[async_trait]
impl GetCustomerUseCaseTrait for GetCustomerUseCaseImpl {
    async fn execute(&self, params: GetCustomerParams) -> Result<Customer, CustomerError> {
        tracing::info!(id = %params.id, "get_customer: start");
        let result = self.repository.find_by_id(params.id).await.inspect_err(|e| tracing::error!(error = %e, "get_customer: repository failed"))?;
        result.ok_or_else(|| {
            let err = CustomerError::NotFound;
            tracing::warn!(error = %err, "get_customer: rejected");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::customer::{
        model::{Customer, CustomerId, CustomerProps},
        repository::mocks::MockCustomerRepository,
    };
    use crate::domain::shared::repository_error::RepositoryError;
    use chrono::Utc;
    use crate::domain::shared::value_objects::Email;
    use crate::domain::customer::value_objects::Name;
    use crate::domain::customer::value_objects::Code;
    use crate::domain::customer::value_objects::Age;
    use crate::domain::customer::value_objects::Joined;
    use crate::domain::customer::value_objects::Status;


    #[tokio::test]
    async fn should_return_customer_when_id_exists() {
        let entity = Customer::new(CustomerProps {
            email: Email::new("example".to_string()).expect("valid Email"),
            name: Name::new("example".to_string()).expect("valid Name"),
            code: Code::new("example".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = GetCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(GetCustomerParams { id: entity_id }).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().email.value(), "example");
    }

    #[tokio::test]
    async fn should_return_not_found_when_id_does_not_exist() {
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = GetCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetCustomerParams { id: CustomerId::generate() })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "customer.not_found");
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_store_is_unavailable() {
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(|_| Err(RepositoryError::Unavailable));
        let use_case = GetCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetCustomerParams { id: CustomerId::generate() })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "customer.repository_error");
    }
}

=== business/src/application/customer/list_customers.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::customer::{
    errors::CustomerError,
    model::Customer,
    repository::CustomerRepositoryTrait,
    use_cases::list_customers::{ListCustomersParams, ListCustomersUseCaseTrait},
};

pub struct ListCustomersUseCaseImpl {
    pub repository: Arc<dyn CustomerRepositoryTrait>,
}

#[async_trait]
impl ListCustomersUseCaseTrait for ListCustomersUseCaseImpl {
    async fn execute(&self, _params: ListCustomersParams) -> Result<Vec<Customer>, CustomerError> {
        tracing::info!("list_customers: start");
        self.repository
            .find_all()
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_customers: repository failed"))
            .map_err(CustomerError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::customer::{
        model::{Customer, CustomerProps},
        repository::mocks::MockCustomerRepository,
    };
    use chrono::Utc;
    use crate::domain::shared::value_objects::Email;
    use crate::domain::customer::value_objects::Name;
    use crate::domain::customer::value_objects::Code;
    use crate::domain::customer::value_objects::Age;
    use crate::domain::customer::value_objects::Joined;
    use crate::domain::customer::value_objects::Status;


    #[tokio::test]
    async fn should_return_all_customers() {
        let entities = vec![
            Customer::new(CustomerProps {
            email: Email::new("first".to_string()).expect("valid Email"),
            name: Name::new("first".to_string()).expect("valid Name"),
            code: Code::new("first".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        }).unwrap(),
            Customer::new(CustomerProps {
            email: Email::new("second".to_string()).expect("valid Email"),
            name: Name::new("second".to_string()).expect("valid Name"),
            code: Code::new("second".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        }).unwrap(),
        ];
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListCustomersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListCustomersParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_customers_exist() {
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListCustomersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListCustomersParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

=== business/src/application/customer/update_customer.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use crate::domain::shared::value_objects::Email;
use crate::domain::customer::value_objects::Name;
use crate::domain::customer::value_objects::Code;
use crate::domain::customer::value_objects::Age;
use crate::domain::customer::value_objects::Joined;
use crate::domain::customer::value_objects::MiddleName;
use crate::domain::customer::value_objects::Label;
use crate::domain::customer::value_objects::Status;

use crate::domain::customer::{
    errors::CustomerError,
    model::Customer,
    repository::CustomerRepositoryTrait,
    use_cases::update_customer::{UpdateCustomerParams, UpdateCustomerUseCaseTrait},
};

pub struct UpdateCustomerUseCaseImpl {
    pub repository: Arc<dyn CustomerRepositoryTrait>,
}

#[async_trait]
impl UpdateCustomerUseCaseTrait for UpdateCustomerUseCaseImpl {
    async fn execute(&self, params: UpdateCustomerParams) -> Result<Customer, CustomerError> {
        tracing::info!(id = %params.id, "update_customer: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_customer: repository failed"))?
            .ok_or_else(|| {
                let err = CustomerError::NotFound;
                tracing::warn!(error = %err, "update_customer: rejected");
                err
            })?;
let email = Email::new(params.email).map_err(|_| CustomerError::InvalidEmail)?;
let name = Name::new(params.name)?;
let code = Code::new(params.code)?;
let age = Age::new(params.age)?;
let joined = Joined::new(params.joined)?;
let middle = params.middle.map(MiddleName::new).transpose()?;
let labels: Vec<Label> = params.labels.into_iter().map(Label::new).collect::<Result<Vec<_>,_>>()?;
let status = params.status.parse::<Status>()?;
        entity.email = email;
        entity.name = name;
        entity.code = code;
        entity.age = age;
        entity.joined = joined;
        entity.middle = middle;
        entity.labels = labels;
        entity.status = status;
        entity.updated_at = chrono::Utc::now();
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "update_customer: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::customer::{
        model::{Customer, CustomerId, CustomerProps},
        repository::mocks::MockCustomerRepository,
    };
    use chrono::Utc;
    use crate::domain::shared::value_objects::Email;
    use crate::domain::customer::value_objects::Name;
    use crate::domain::customer::value_objects::Code;
    use crate::domain::customer::value_objects::Age;
    use crate::domain::customer::value_objects::Joined;
    use crate::domain::customer::value_objects::Status;


    #[tokio::test]
    async fn should_update_customer_when_params_are_valid() {
        // Arrange
        let entity = Customer::new(CustomerProps {
            email: Email::new("original".to_string()).expect("valid Email"),
            name: Name::new("original".to_string()).expect("valid Name"),
            code: Code::new("original".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCustomerParams {
            id: entity_id,
            email: "updated".to_string(),
            name: "updated".to_string(),
            code: "updated".to_string(),
            age: 42,
            joined: Utc::now(),
            middle: None,
            labels: vec![],
            status: "Active".to_string(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().email.value(), "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_customer_does_not_exist() {
        // Arrange
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCustomerParams {
            id: CustomerId::generate(),
            email: "new".to_string(),
            name: "new".to_string(),
            code: "new".to_string(),
            age: 42,
            joined: Utc::now(),
            middle: None,
            labels: vec![],
            status: "Active".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "customer.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_email_is_empty() {
        // Arrange
        let entity = Customer::new(CustomerProps {
