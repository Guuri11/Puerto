=== contextos/billete/aplicacion/src/listar_billetes.rs ===
use async_trait::async_trait;
use dominio_billete::errores::ErrorBillete;
use dominio_billete::modelo::Billete;
use dominio_billete::repositorio::RepositorioBillete;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarBilletes {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarBilletes: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarBilletes)
    -> Result<Pagina<Billete>, ErrorBillete>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarBilletes {}

        #[async_trait]
        impl ListarBilletes for ListarBilletes {
            async fn ejecutar(&self, params: ParamsListarBilletes) -> Result<Pagina<Billete>, ErrorBillete>;
        }
    }
}

pub struct ListarBilletesImpl {
    pub repositorio: Arc<dyn RepositorioBillete>,
}

#[async_trait]
impl ListarBilletes for ListarBilletesImpl {
    async fn ejecutar(
        &self,
        params: ParamsListarBilletes,
    ) -> Result<Pagina<Billete>, ErrorBillete> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_billetes: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_billetes: fallo del repositorio"))
            .map_err(ErrorBillete::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_billete::{
        pruebas::madres::MadreBillete, repositorio::dobles::MockRepositorioBillete,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_billetes() {
        let entidades = MadreBillete::aleatorios(2);
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarBilletesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarBilletes {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_billetes() {
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarBilletesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarBilletes {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioBillete::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarBilletesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarBilletes {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

