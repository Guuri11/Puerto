use std::sync::Arc;

use business::{
    application::customer::{
        create_customer::CreateCustomerUseCaseImpl,
        delete_customer::DeleteCustomerUseCaseImpl,
        get_customer::GetCustomerUseCaseImpl,
        list_customer::ListCustomerUseCaseImpl,
        update_customer::UpdateCustomerUseCaseImpl,
    },
    domain::customer::use_cases::{
        create_customer::{CreateCustomerParams, CreateCustomerUseCaseTrait},
        delete_customer::{DeleteCustomerParams, DeleteCustomerUseCaseTrait},
        get_customer::{GetCustomerParams, GetCustomerUseCaseTrait},
        list_customer::{ListCustomerParams, ListCustomerUseCaseTrait},
        update_customer::{UpdateCustomerParams, UpdateCustomerUseCaseTrait},
    },
};
use poem_openapi::{OpenApi, param::Path, payload::Json};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::customer::dto::{CreateCustomerRequest, UpdateCustomerRequest, CustomerDto};
use crate::api::customer::responses::{
    CreateCustomerResponse, DeleteCustomerResponse, GetCustomerResponse, ListCustomerResponse,
    UpdateCustomerResponse,
};

pub struct CustomerApi {
    pub create_customer: Arc<CreateCustomerUseCaseImpl>,
    pub get_customer: Arc<GetCustomerUseCaseImpl>,
    pub list_customer: Arc<ListCustomerUseCaseImpl>,
    pub update_customer: Arc<UpdateCustomerUseCaseImpl>,
    pub delete_customer: Arc<DeleteCustomerUseCaseImpl>,
}

#[OpenApi]
impl CustomerApi {
    /// Create a new Customer
    #[oai(path = "/customers", method = "post", tag = "ApiTags::Customer")]
    async fn create(&self, body: Json<CreateCustomerRequest>) -> CreateCustomerResponse {
        match self
