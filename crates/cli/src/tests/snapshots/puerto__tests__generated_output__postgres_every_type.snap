use chrono::{DateTime, Utc};
use uuid::Uuid;
use std::collections::HashMap;

use super::errors::ProductError;

#[derive(Debug, Clone)]
pub struct ProductProps {
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
}

#[derive(Debug, Clone)]
pub struct Product {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
}

impl Product {
    pub fn new(props: ProductProps) -> Result<Self, ProductError> {
        if props.title.trim().is_empty() {
            return Err(ProductError::ValidationError("title_empty".into()));
        }
        if props.sku.trim().is_empty() {
            return Err(ProductError::ValidationError("sku_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            sku: props.sku,
            price: props.price,
            rating: props.rating,
            active: props.active,
            ref_id: props.ref_id,
            published_at: props.published_at,
            summary: props.summary,
            views: props.views,
            expires_at: props.expires_at,
            tags: props.tags,
            scores: props.scores,
            meta: props.meta,
        })
    }

    pub fn from_repository(data: Product) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_product_when_fields_are_valid() {
        let result = Product::new(ProductProps {
            title: "example".to_string(),
            sku: "example".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert_eq!(result.unwrap().title, "example");
    }


    #[test]
    fn should_reject_product_when_title_is_empty() {
        let result = Product::new(ProductProps {
            title: "".into(),
            sku: "example".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_product_when_title_is_only_whitespace() {
        let result = Product::new(ProductProps {
            title: "   ".into(),
            sku: "example".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_product_when_sku_is_empty() {
        let result = Product::new(ProductProps {
            title: "example".to_string(),
            sku: "".into(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.sku_empty"
        );
    }

    #[test]
    fn should_reject_product_when_sku_is_only_whitespace() {
        let result = Product::new(ProductProps {
            title: "example".to_string(),
            sku: "   ".into(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        });
        assert!(result.is_err());
    }
}

