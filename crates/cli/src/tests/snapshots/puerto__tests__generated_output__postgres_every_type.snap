=== business/src/domain/customer/errors.rs ===
use thiserror::Error;

use crate::domain::shared::repository_error::RepositoryError;

#[derive(Debug, Error)]
pub enum CustomerError {
    #[error("customer.validation_error.{0}")]
    ValidationError(String),
    #[error("customer.not_found")]
    NotFound,
    #[error("customer.duplicate")]
    Duplicate,
    #[error("customer.repository_error")]
    RepositoryError,
    #[error("customer.unknown")]
    Unknown,
    #[error("customer.invalid_email")]
    InvalidEmail,
    #[error("customer.invalid_name")]
    InvalidName,
    #[error("customer.invalid_code")]
    InvalidCode,
    #[error("customer.invalid_age")]
    InvalidAge,
    #[error("customer.invalid_joined")]
    InvalidJoined,
    #[error("customer.invalid_middle_name")]
    InvalidMiddleName,
    #[error("customer.invalid_label")]
    InvalidLabel,
    #[error("customer.invalid_status")]
    InvalidStatus,
}

impl From<RepositoryError> for CustomerError {
    /// Exhaustive on purpose: a new repository failure does not compile until it has a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = CustomerError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "customer.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = CustomerError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "customer.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = CustomerError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "customer.repository_error");
    }
}

=== business/src/domain/customer/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;
use crate::domain::shared::value_objects::Email;
use super::value_objects::Name;
use super::value_objects::Code;
use super::value_objects::Age;
use super::value_objects::Joined;
use super::value_objects::MiddleName;
use super::value_objects::Label;
use super::value_objects::Status;

use super::errors::CustomerError;

/// The id of every `Customer`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct CustomerId(Uuid);

impl CustomerId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for CustomerId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct CustomerProps {
    pub email: Email,
    pub name: Name,
    pub code: Code,
    pub age: Age,
    pub joined: Joined,
    pub middle: Option<MiddleName>,
    pub labels: Vec<Label>,
    pub status: Status,
}

#[derive(Debug, Clone)]
pub struct Customer {
    pub id: CustomerId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub email: Email,
    pub name: Name,
    pub code: Code,
    pub age: Age,
    pub joined: Joined,
    pub middle: Option<MiddleName>,
    pub labels: Vec<Label>,
    pub status: Status,
}

impl Customer {
    pub fn new(props: CustomerProps) -> Result<Self, CustomerError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: CustomerId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            email: props.email,
            name: props.name,
            code: props.code,
            age: props.age,
            joined: props.joined,
            middle: props.middle,
            labels: props.labels,
            status: props.status,
        })
    }

    pub fn from_repository(data: Customer) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_customer_when_fields_are_valid() {
        let result = Customer::new(CustomerProps {
            email: Email::new("example".to_string()).expect("valid Email"),
            name: Name::new("example".to_string()).expect("valid Name"),
            code: Code::new("example".to_string()).expect("valid Code"),
            age: Age::new(42).expect("valid Age"),
            joined: Joined::new(Utc::now()).expect("valid Joined"),
            middle: None,
            labels: vec![],
            status: Status::Active,
        });
        assert!(result.is_ok());
    }


    #[test]
    fn should_reject_customer_when_email_is_empty() {
        let result = Email::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shared.value_object.email.invalid"
        );
    }

    #[test]
    fn should_reject_customer_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.invalid_name"
        );
    }

    #[test]
    fn should_reject_customer_when_code_is_empty() {
        let result = Code::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.invalid_code"
        );
    }

    #[test]
    fn should_reject_customer_when_status_is_invalid() {
        let result = "InvalidVariant".parse::<Status>();
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.invalid_status"
        );
    }
}

