export interface Ticket {
  id: string;
  state: State;
}

/** What a create or an update sends: a ticket without its id. */
export type TicketDraft = Omit<Ticket, "id">;

export const stateValues = ["Open", "Closed"] as const;

export type State = (typeof stateValues)[number];

/** Narrows the API's `string` to a `State`, rejecting with `ticket.invalid_state`. */
export function parseState(value: string): State {
  const found = stateValues.find((candidate) => candidate === value);
  if (found === undefined) throw new TicketError("ticket.invalid_state");
  return found;
}

