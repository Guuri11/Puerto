use crate::domain::product::model::Product;
use crate::domain::product::model::ProductProps;
use uuid::Uuid;
use chrono::{DateTime, Utc};
use std::collections::HashMap;

pub struct ProductMother {
    title: Option<String>,
    sku: Option<String>,
    price: Option<i64>,
    rating: Option<f64>,
    active: Option<bool>,
    ref_id: Option<Uuid>,
    published_at: Option<DateTime<Utc>>,
    summary: Option<String>,
    views: Option<i64>,
    expires_at: Option<DateTime<Utc>>,
    tags: Option<Vec<String>>,
    scores: Option<Vec<i64>>,
    meta: Option<HashMap<String, String>>,
}

impl ProductMother {
    pub fn new() -> Self {
        Self { title: None, sku: None, price: None, rating: None, active: None, ref_id: None, published_at: None, summary: None, views: None, expires_at: None, tags: None, scores: None, meta: None }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_sku(mut self, sku: &str) -> Self {
        self.sku = Some(sku.to_string());
        self
    }

    pub fn with_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn with_rating(mut self, rating: f64) -> Self {
        self.rating = Some(rating);
        self
    }

    pub fn with_active(mut self, active: bool) -> Self {
        self.active = Some(active);
        self
    }

    pub fn with_ref_id(mut self, ref_id: Uuid) -> Self {
        self.ref_id = Some(ref_id);
        self
    }

    pub fn with_published_at(mut self, published_at: DateTime<Utc>) -> Self {
        self.published_at = Some(published_at);
        self
    }

    pub fn with_summary(mut self, summary: &str) -> Self {
        self.summary = Some(summary.to_string());
        self
    }

    pub fn with_views(mut self, views: i64) -> Self {
        self.views = Some(views);
        self
    }

    pub fn with_expires_at(mut self, expires_at: DateTime<Utc>) -> Self {
        self.expires_at = Some(expires_at);
        self
    }

    pub fn with_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn with_scores(mut self, scores: Vec<i64>) -> Self {
        self.scores = Some(scores);
        self
    }

    pub fn with_meta(mut self, meta: HashMap<String, String>) -> Self {
        self.meta = Some(meta);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn with_empty_sku(mut self) -> Self {
        self.sku = Some(String::new());
        self
    }

    pub fn build(self) -> Product {
        Product::new(ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            sku: self.sku.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            rating: self.rating.unwrap_or(1.5),
            active: self.active.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            published_at: self.published_at.unwrap_or_else(Utc::now),
            summary: self.summary,
            views: self.views,
            expires_at: self.expires_at,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
        })
        .expect("ProductMother: failed to build valid Product")
    }

    pub fn build_props(self) -> ProductProps {
        ProductProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            sku: self.sku.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            rating: self.rating.unwrap_or(1.5),
            active: self.active.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            published_at: self.published_at.unwrap_or_else(Utc::now),
            summary: self.summary,
            views: self.views,
            expires_at: self.expires_at,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
        }
    }

    pub fn random() -> Product {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Product> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for ProductMother {
    fn default() -> Self {
        Self::new()
    }
}

