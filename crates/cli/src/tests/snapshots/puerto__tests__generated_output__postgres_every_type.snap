    };

    #[tokio::test]
    async fn deberia_actualizar_cliente_cuando_los_parametros_son_validos() {
        // Preparar
        let props = MadreCliente::new().construir_props();
        let entidad = MadreCliente::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioCliente::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = ActualizarClienteImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarCliente {
                id: id_entidad,
                email: props.email.valor().to_string(),
                name: props.name.valor().to_string(),
                code: props.code.valor().to_string(),
                age: props.age.valor(),
                joined: props.joined.valor(),
                middle: props.middle.as_ref().map(|v| v.valor().to_string()),
                labels: props
                    .labels
                    .iter()
                    .map(|v| v.valor().to_string())
                    .collect::<Vec<_>>(),
                status: props.status.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
    }

