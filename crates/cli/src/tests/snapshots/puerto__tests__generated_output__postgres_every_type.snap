use chrono::{DateTime, Utc};
use std::collections::HashMap;
use uuid::Uuid;

use crate::errores::ErrorProducto;

/// El id de cada `Producto`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdProducto(Uuid);

impl IdProducto {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdProducto {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsProducto {
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
}

#[derive(Debug, Clone)]
pub struct Producto {
    pub id: IdProducto,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
    pub published_at: DateTime<Utc>,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub expires_at: Option<DateTime<Utc>>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
}

impl Producto {
    pub fn new(props: PropsProducto) -> Result<Self, ErrorProducto> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdProducto::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            title: props.title,
            sku: props.sku,
            price: props.price,
            rating: props.rating,
            active: props.active,
            ref_id: props.ref_id,
            published_at: props.published_at,
            summary: props.summary,
            views: props.views,
            expires_at: props.expires_at,
            tags: props.tags,
            scores: props.scores,
            meta: props.meta,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsProducto) -> Result<(), ErrorProducto> {
        Self::validar(&props)?;
        self.title = props.title;
        self.sku = props.sku;
        self.price = props.price;
        self.rating = props.rating;
        self.active = props.active;
        self.ref_id = props.ref_id;
        self.published_at = props.published_at;
        self.summary = props.summary;
        self.views = props.views;
        self.expires_at = props.expires_at;
        self.tags = props.tags;
        self.scores = props.scores;
        self.meta = props.meta;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Producto) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsProducto) -> Result<(), ErrorProducto> {
        if props.title.trim().is_empty() {
            return Err(ErrorProducto::Validacion("title_vacio".into()));
        }
        if props.sku.trim().is_empty() {
            return Err(ErrorProducto::Validacion("sku_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreProducto;

    #[test]
    fn deberia_crear_producto_cuando_los_campos_son_validos() {
        let resultado = Producto::new(MadreProducto::new().construir_props());
        assert_eq!(
            resultado.unwrap().title,
            MadreProducto::new().construir_props().title
        );
    }

    #[test]
    fn deberia_rechazar_producto_cuando_title_es_una_cadena_vacia() {
        let resultado = Producto::new(MadreProducto::new().con_title_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_producto_cuando_title_solo_tiene_espacios() {
        let resultado = Producto::new(MadreProducto::new().con_title("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_producto_cuando_sku_es_una_cadena_vacia() {
        let resultado = Producto::new(MadreProducto::new().con_sku_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.sku_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_producto_cuando_sku_solo_tiene_espacios() {
        let resultado = Producto::new(MadreProducto::new().con_sku("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_producto_cuando_title_es_una_cadena_vacia() {
        let mut entidad = MadreProducto::aleatorio();
        let resultado =
            entidad.actualizar(MadreProducto::new().con_title_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_marcar_producto_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreProducto::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

=== contextos/producto/dominio/src/pruebas/madres.rs ===
use crate::modelo::Producto;
use crate::modelo::PropsProducto;
use chrono::{DateTime, Utc};
use std::collections::HashMap;
use uuid::Uuid;

pub struct MadreProducto {
    title: Option<String>,
    sku: Option<String>,
    price: Option<i64>,
    rating: Option<f64>,
    active: Option<bool>,
    ref_id: Option<Uuid>,
    published_at: Option<DateTime<Utc>>,
    summary: Option<String>,
    views: Option<i64>,
    expires_at: Option<DateTime<Utc>>,
    tags: Option<Vec<String>>,
    scores: Option<Vec<i64>>,
    meta: Option<HashMap<String, String>>,
}

impl MadreProducto {
    pub fn new() -> Self {
        Self {
            title: None,
            sku: None,
            price: None,
            rating: None,
            active: None,
            ref_id: None,
            published_at: None,
            summary: None,
            views: None,
            expires_at: None,
            tags: None,
            scores: None,
            meta: None,
        }
    }

    pub fn con_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn con_sku(mut self, sku: &str) -> Self {
        self.sku = Some(sku.to_string());
        self
    }

    pub fn con_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn con_rating(mut self, rating: f64) -> Self {
        self.rating = Some(rating);
        self
    }

    pub fn con_active(mut self, active: bool) -> Self {
        self.active = Some(active);
        self
    }

    pub fn con_ref_id(mut self, ref_id: Uuid) -> Self {
        self.ref_id = Some(ref_id);
        self
    }

    pub fn con_published_at(mut self, published_at: DateTime<Utc>) -> Self {
        self.published_at = Some(published_at);
        self
    }

    pub fn con_summary(mut self, summary: &str) -> Self {
        self.summary = Some(summary.to_string());
        self
    }

    pub fn con_views(mut self, views: i64) -> Self {
        self.views = Some(views);
        self
    }

    pub fn con_expires_at(mut self, expires_at: DateTime<Utc>) -> Self {
        self.expires_at = Some(expires_at);
        self
    }

    pub fn con_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn con_scores(mut self, scores: Vec<i64>) -> Self {
        self.scores = Some(scores);
        self
    }

    pub fn con_meta(mut self, meta: HashMap<String, String>) -> Self {
        self.meta = Some(meta);
        self
    }

    pub fn con_title_vacio(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn con_sku_vacio(mut self) -> Self {
        self.sku = Some(String::new());
        self
    }

    pub fn construir(self) -> Producto {
        Producto::new(PropsProducto {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            sku: self.sku.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            rating: self.rating.unwrap_or(1.5),
            active: self.active.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            published_at: self.published_at.unwrap_or_else(Utc::now),
            summary: self.summary,
            views: self.views,
            expires_at: self.expires_at,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
        })
        .expect("MadreProducto: Producto::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsProducto {
        PropsProducto {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            sku: self.sku.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            rating: self.rating.unwrap_or(1.5),
            active: self.active.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            published_at: self.published_at.unwrap_or_else(Utc::now),
            summary: self.summary,
            views: self.views,
            expires_at: self.expires_at,
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
        }
    }

    pub fn aleatorio() -> Producto {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Producto> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }

    /// Un `sku` distinto en cada llamada, para las filas que guardan los tests de los
    /// repositorios (es único). Si una regla del dominio lo rechaza, cámbialo aquí.
    pub fn sku_unico() -> String {
        uuid::Uuid::new_v4().simple().to_string()[..12].to_string()
    }

    /// Un `price` distinto en cada llamada, para las filas que guardan los tests de los
    /// repositorios (es único). Si una regla del dominio lo rechaza, cámbialo aquí.
    pub fn price_unico() -> i64 {
        (uuid::Uuid::new_v4().as_u128() >> 65) as i64
    }
}

impl Default for MadreProducto {
    fn default() -> Self {
        Self::new()
    }
}

