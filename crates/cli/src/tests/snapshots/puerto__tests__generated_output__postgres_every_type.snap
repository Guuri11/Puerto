=== web/src/presentation/features/billete/views/billete-form-view.tsx ===
import type { BilleteProblem } from "../../../../domain/billete/messages";
import { type Billete, type BilleteDraft, parseState } from "../../../../domain/billete/model";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface BilleteFormValues {
  state: string;
}

/** The inputs for `billete`, empty when there is none yet. */
export function toBilleteForm(billete: Billete | null): BilleteFormValues {
  if (billete === null) {
    return {
      state: "",
    };
  }
  return {
    state: billete.state,
  };
}

export function toBilleteDraft(values: BilleteFormValues): BilleteDraft {
  return {
    state: parseState(values.state),
  };
}

export function BilleteFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: BilleteFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: BilleteProblem | null;
  onChange: (values: BilleteFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">State</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "state"}
          required
          value={values.state}
          onChange={(event) => onChange({ ...values, state: event.target.value })}
        >
          <option value="">Choose…</option>
          <option value="Open">Open</option>
          <option value="Closed">Closed</option>
        </select>
      </label>
      <FieldError problem={problem} field="state" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

