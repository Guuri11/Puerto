=== web/src/infrastructure/product/product-repository-http.ts ===
import { ProductError } from "../../domain/product/errors";
import type { Product, ProductDraft } from "../../domain/product/model";
import type { ProductRepository } from "../../domain/product/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ProductDto = components["schemas"]["ProductDto"];
type ProductRequest = components["schemas"]["CreateProductRequest"];

function toProduct(dto: ProductDto): Product {
  return {
    id: dto.id,
    title: dto.title,
    sku: dto.sku,
    price: dto.price,
    rating: dto.rating,
    active: dto.active,
    refId: dto.refId,
    publishedAt: dto.publishedAt,
    summary: dto.summary ?? null,
    views: dto.views ?? null,
    expiresAt: dto.expiresAt ?? null,
    tags: dto.tags,
    scores: dto.scores,
    meta: dto.meta,
  };
}

function toRequest(draft: ProductDraft): ProductRequest {
  return {
    title: draft.title,
    sku: draft.sku,
    price: draft.price,
    rating: draft.rating,
    active: draft.active,
    refId: draft.refId,
    publishedAt: draft.publishedAt,
    summary: draft.summary ?? undefined,
    views: draft.views ?? undefined,
    expiresAt: draft.expiresAt ?? undefined,
    tags: draft.tags,
    scores: draft.scores,
    meta: draft.meta,
  };
}

/** `ProductRepository` over the REST API (`/products`). */
export function productRepositoryHttp(api: ApiClient): ProductRepository {
  return {
    async list() {
      const { data, error, response } = await api.GET("/products");
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return data.map(toProduct);
    },
    async get(id) {
      const { data, error, response } = await api.GET("/products/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return toProduct(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/products", { body: toRequest(draft) });
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return toProduct(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/products/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return toProduct(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/products/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ProductError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/ticket/ticket-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { TicketError } from "../../domain/ticket/errors";
import { TicketMother } from "../../test-support/ticket";
import { createApiClient } from "../http/client";
import { ticketRepositoryHttp } from "./ticket-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: ticketRepositoryHttp(api), requests };
}

describe("ticketRepositoryHttp", () => {
  test("should return every ticket when the API lists them", async () => {
    // Arrange
    const ticket = TicketMother.random();
    const { repository } = answering(200, [ticket]);

    // Act
    const listed = await repository.list();

    // Assert
    expect(listed).toEqual([ticket]);
  });

  test("should send the draft when creating a ticket", async () => {
    // Arrange
    const draft = TicketMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the ticket does not exist", async () => {
    // Arrange
    const code = "ticket.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(TicketError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the ticket", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/tickets/42");
  });
});

=== web/src/infrastructure/ticket/ticket-repository-http.ts ===
import { TicketError } from "../../domain/ticket/errors";
import { parseState, type Ticket, type TicketDraft } from "../../domain/ticket/model";
import type { TicketRepository } from "../../domain/ticket/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type TicketDto = components["schemas"]["TicketDto"];
type TicketRequest = components["schemas"]["CreateTicketRequest"];

function toTicket(dto: TicketDto): Ticket {
  return {
    id: dto.id,
    state: parseState(dto.state),
  };
}

function toRequest(draft: TicketDraft): TicketRequest {
  return {
    state: draft.state,
  };
}

/** `TicketRepository` over the REST API (`/tickets`). */
export function ticketRepositoryHttp(api: ApiClient): TicketRepository {
  return {
    async list() {
      const { data, error, response } = await api.GET("/tickets");
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return data.map(toTicket);
    },
    async get(id) {
      const { data, error, response } = await api.GET("/tickets/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return toTicket(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/tickets", { body: toRequest(draft) });
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return toTicket(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/tickets/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new TicketError(apiErrorCode(error, response));
      return toTicket(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/tickets/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new TicketError(apiErrorCode(error, response));
    },
  };
}

