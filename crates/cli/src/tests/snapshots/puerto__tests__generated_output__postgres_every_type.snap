                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/contextos/producto/contenedores/detalle-producto.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionProducto, MadreProducto } from "../../../pruebas/producto";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleProducto } from "./detalle-producto";

describe("ContenedorDetalleProducto", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const api = apiFalsa([coleccionProducto([sembrado])]);

    const pantalla = <ContenedorDetalleProducto id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionProducto()]);
    const pantalla = <ContenedorDetalleProducto id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("producto.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const guardados = coleccionProducto([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleProducto id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/productos"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/producto/contenedores/detalle-producto.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleProducto } from "../vistas/detalle-producto";

export function ContenedorDetalleProducto({ id }: { id: string }) {
  const { api } = useDependencias();
  const producto = useCarga(
    () => desenvolver(api.GET("/productos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/productos/{id}", { params: { path: { id } } }));
      navegar("/productos");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Producto</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {producto.estado === "cargando" && <span className="loading loading-spinner" />}
      {producto.estado === "error" && <AlertaError error={producto.error} />}
      {producto.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleProducto producto={producto.datos} />
            <div className="card-actions justify-end">
              <Link href={`/productos/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/productos" className="link">
        Volver a productos
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar producto?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/producto/contenedores/formulario-producto.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { aFechaHoraLocal, formatearEntradas, textoDe } from "../../../compartido/formularios";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionProducto, MadreProducto } from "../../../pruebas/producto";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioProducto } from "./formulario-producto";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearProducto"]) {
  await screen.findByText("Guardar");
  escribir("Title", peticion.title);
  escribir("Sku", peticion.sku);
  escribir("Price", String(peticion.price));
  escribir("Rating", String(peticion.rating));
  if (peticion.active) fireEvent.click(screen.getByLabelText("Active"));
  escribir("Ref id", peticion.refId);
  escribir("Published at", aFechaHoraLocal(peticion.publishedAt));
  escribir("Summary", textoDe(peticion.summary));
  escribir("Views", textoDe(peticion.views));
  escribir("Expires at", aFechaHoraLocal(peticion.expiresAt));
  escribir("Tags", peticion.tags.join(", "));
  escribir("Scores", peticion.scores.join(", "));
  escribir("Meta", formatearEntradas(peticion.meta));
}

describe("ContenedorFormularioProducto", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const guardados = coleccionProducto();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioProducto />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/productos/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/productos/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const guardados = coleccionProducto([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioProducto id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/productos/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const codigo = "producto.validacion.invalido";
    const fallos = { "POST /productos": codigo };
    const api = apiFalsa([coleccionProducto()], fallos);
    renderizarPantalla(<ContenedorFormularioProducto />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const codigo = "producto.duplicado";
    const fallos = { "POST /productos": codigo };
    const api = apiFalsa([coleccionProducto()], fallos);
    renderizarPantalla(<ContenedorFormularioProducto />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const codigo = "producto.validacion.title_vacio";
    const fallos = { "POST /productos": codigo };
    const api = apiFalsa([coleccionProducto()], fallos);
    renderizarPantalla(<ContenedorFormularioProducto />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Title");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/producto/contenedores/formulario-producto.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioProducto,
  aPeticionProducto,
  VistaFormularioProducto,
} from "../vistas/formulario-producto";

type Producto = Esquemas["DtoProducto"];

/** Crear, o editar con `id`: el formulario de productos. */
export function ContenedorFormularioProducto({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/productos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear producto" : "Editar producto";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioProducto existente={existente.datos} />}
      <Link href={id === undefined ? "/productos" : `/productos/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioProducto({ existente }: { existente: Producto | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioProducto(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionProducto(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/productos", { body: cuerpo })
          : api.PUT("/productos/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/productos/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioProducto
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/producto/contenedores/lista-producto.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionProducto, MadreProducto } from "../../../pruebas/producto";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaProducto } from "./lista-producto";

describe("ContenedorListaProducto", () => {
  test("debería mostrar una fila por cada producto", async () => {
    // Preparar
    const semilla = [MadreProducto.aleatorio(), MadreProducto.aleatorio()];
    const api = apiFalsa([coleccionProducto(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaProducto />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreProducto.aleatorio());
    const api = apiFalsa([coleccionProducto(semilla)]);
    renderizarPantalla(<ContenedorListaProducto />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreProducto.aleatorio());
    const api = apiFalsa([coleccionProducto(semilla)]);
    const ruta = "/productos?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaProducto />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay productos", async () => {
    // Preparar
    const api = apiFalsa([coleccionProducto()]);

    // Actuar
    renderizarPantalla(<ContenedorListaProducto />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay productos.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /productos": "producto.repositorio" };
    const api = apiFalsa([coleccionProducto()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaProducto />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("producto.repositorio");
  });
});

=== web/src/contextos/producto/contenedores/lista-producto.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaProducto } from "../vistas/lista-producto";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaProducto() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const productos = useCarga(
    () => desenvolver(api.GET("/productos", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Productos</h1>
        <Link href="/productos/nuevo" className="btn btn-primary">
          Crear producto
        </Link>
      </div>
      {productos.estado === "cargando" && <span className="loading loading-spinner" />}
      {productos.estado === "error" && <AlertaError error={productos.error} />}
      {productos.estado === "listo" &&
        (productos.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay productos." />
        ) : (
          <>
            <VistaListaProducto productos={productos.datos.elementos} />
            <Paginacion
              total={productos.datos.total}
              limite={productos.datos.limite}
              desplazamiento={productos.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/producto/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaProducto {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "producto.validacion.title_vacio": "Title: obligatorio",
  "producto.validacion.sku_vacio": "Sku: obligatorio",
  "producto.duplicado": "Estos valores ya están en uso",
  "producto.no_encontrado": "Ya no existe",
  "producto.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "producto.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "producto.validacion.title_vacio": "title",
  "producto.validacion.sku_vacio": "sku",
};

export function aProblema(codigo: string): ProblemaProducto {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

=== web/src/contextos/producto/vistas/detalle-producto.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { formatearEntradas, formatearFechaHora } from "../../../compartido/formularios";

type Producto = Esquemas["DtoProducto"];

export function VistaDetalleProducto({ producto }: { producto: Producto }) {
  return (
    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
      <dt className="font-semibold">Title</dt>
      <dd>{producto.title}</dd>
      <dt className="font-semibold">Sku</dt>
      <dd>{producto.sku}</dd>
      <dt className="font-semibold">Price</dt>
      <dd>{producto.price}</dd>
      <dt className="font-semibold">Rating</dt>
      <dd>{producto.rating}</dd>
      <dt className="font-semibold">Active</dt>
      <dd>{producto.active ? "Sí" : "No"}</dd>
      <dt className="font-semibold">Ref id</dt>
      <dd>{producto.refId}</dd>
      <dt className="font-semibold">Published at</dt>
      <dd>{formatearFechaHora(producto.publishedAt)}</dd>
      <dt className="font-semibold">Summary</dt>
      <dd>{producto.summary ?? "—"}</dd>
      <dt className="font-semibold">Views</dt>
      <dd>{producto.views ?? "—"}</dd>
      <dt className="font-semibold">Expires at</dt>
      <dd>{producto.expiresAt == null ? "—" : formatearFechaHora(producto.expiresAt)}</dd>
      <dt className="font-semibold">Tags</dt>
      <dd>{producto.tags.join(", ")}</dd>
      <dt className="font-semibold">Scores</dt>
      <dd>{producto.scores.join(", ")}</dd>
      <dt className="font-semibold">Meta</dt>
      <dd>{formatearEntradas(producto.meta, ", ")}</dd>
    </dl>
  );
}

=== web/src/contextos/producto/vistas/formulario-producto.tsx ===
import type { Esquemas } from "../../../api/cliente";
import {
  aFechaHoraLocal,
  deFechaHoraLocal,
  fechaHoraOpcional,
  formatearEntradas,
  leerEntradas,
  numeroOpcional,
  separarLista,
  separarNumeros,
  textoDe,
  textoOpcional,
} from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaProducto } from "../mensajes";

type Producto = Esquemas["DtoProducto"];
type PeticionProducto = Esquemas["PeticionCrearProducto"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioProducto {
  title: string;
  sku: string;
  price: string;
  rating: string;
  active: boolean;
  refId: string;
  publishedAt: string;
  summary: string;
  views: string;
  expiresAt: string;
  tags: string;
  scores: string;
  meta: string;
}

/** Los inputs de `producto`, vacíos cuando todavía no hay ninguno. */
export function aFormularioProducto(producto: Producto | null): ValoresFormularioProducto {
  if (producto === null) {
    return {
      title: "",
      sku: "",
      price: "",
      rating: "",
      active: false,
      refId: "",
      publishedAt: "",
      summary: "",
      views: "",
      expiresAt: "",
      tags: "",
      scores: "",
      meta: "",
    };
  }
  return {
    title: producto.title,
    sku: producto.sku,
    price: String(producto.price),
    rating: String(producto.rating),
    active: producto.active,
    refId: producto.refId,
    publishedAt: aFechaHoraLocal(producto.publishedAt),
    summary: textoDe(producto.summary),
    views: textoDe(producto.views),
    expiresAt: aFechaHoraLocal(producto.expiresAt),
    tags: producto.tags.join(", "),
    scores: producto.scores.join(", "),
    meta: formatearEntradas(producto.meta),
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionProducto(valores: ValoresFormularioProducto): PeticionProducto {
  return {
    title: valores.title,
    sku: valores.sku,
    price: Number(valores.price),
    rating: Number(valores.rating),
    active: valores.active,
    refId: valores.refId,
    publishedAt: deFechaHoraLocal(valores.publishedAt),
    summary: textoOpcional(valores.summary),
    views: numeroOpcional(valores.views),
    expiresAt: fechaHoraOpcional(valores.expiresAt),
    tags: separarLista(valores.tags),
    scores: separarNumeros(valores.scores),
    meta: leerEntradas(valores.meta),
  };
}

export function VistaFormularioProducto({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioProducto;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaProducto | null;
  alCambiar: (valores: ValoresFormularioProducto) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "title"}
          required
          value={valores.title}
          onChange={(event) => alCambiar({ ...valores, title: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "sku"}
          required
          value={valores.sku}
          onChange={(event) => alCambiar({ ...valores, sku: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="sku" />
      <label className="fieldset">
        <span className="fieldset-legend">Price</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "price"}
          required
          value={valores.price}
          onChange={(event) => alCambiar({ ...valores, price: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="price" />
      <label className="fieldset">
        <span className="fieldset-legend">Rating</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "rating"}
          step="any"
          required
          value={valores.rating}
          onChange={(event) => alCambiar({ ...valores, rating: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="rating" />
      <label className="label">
        <input
          className="checkbox"
          type="checkbox"
          checked={valores.active}
          onChange={(event) => alCambiar({ ...valores, active: event.target.checked })}
        />
        Active
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Ref id</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "refId"}
          required
          value={valores.refId}
          onChange={(event) => alCambiar({ ...valores, refId: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="refId" />
      <label className="fieldset">
        <span className="fieldset-legend">Published at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problema?.campo === "publishedAt"}
          required
          value={valores.publishedAt}
          onChange={(event) => alCambiar({ ...valores, publishedAt: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="publishedAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Summary</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "summary"}
          value={valores.summary}
          onChange={(event) => alCambiar({ ...valores, summary: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="summary" />
      <label className="fieldset">
        <span className="fieldset-legend">Views</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "views"}
          value={valores.views}
          onChange={(event) => alCambiar({ ...valores, views: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="views" />
      <label className="fieldset">
        <span className="fieldset-legend">Expires at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problema?.campo === "expiresAt"}
          value={valores.expiresAt}
          onChange={(event) => alCambiar({ ...valores, expiresAt: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="expiresAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "tags"}
          value={valores.tags}
          onChange={(event) => alCambiar({ ...valores, tags: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Scores</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "scores"}
          value={valores.scores}
          onChange={(event) => alCambiar({ ...valores, scores: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="scores" />
      <label className="fieldset">
        <span className="fieldset-legend">Meta</span>
        <textarea
          className="textarea w-full"
          aria-invalid={problema?.campo === "meta"}
          placeholder="clave=valor, una por línea"
          value={valores.meta}
          onChange={(event) => alCambiar({ ...valores, meta: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="meta" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

