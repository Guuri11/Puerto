=== web/src/infrastructure/billete/billete-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { BilleteError } from "../../domain/billete/errors";
import { BilleteMother } from "../../test-support/billete";
import { createApiClient } from "../http/client";
import { billeteRepositoryHttp } from "./billete-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: billeteRepositoryHttp(api), requests };
}

describe("billeteRepositoryHttp", () => {
  test("should ask for the page and return its billetes", async () => {
    // Arrange
    const billete = BilleteMother.random();
    const { repository, requests } = answering(200, {
      elementos: [billete],
      total: 21,
      limite: 20,
      desplazamiento: 20,
    });

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    const url = new URL(requests[0]?.url ?? "");
    expect(url.pathname).toBe("/api/billetes");
    expect(url.search).toBe("?limite=20&desplazamiento=20");
    expect(listed).toEqual({ items: [billete], total: 21, limit: 20, offset: 20 });
  });

  test("should send the draft when creating a billete", async () => {
    // Arrange
    const draft = BilleteMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the billete does not exist", async () => {
    // Arrange
    const code = "billete.no_encontrado";
    const { repository } = answering(404, { codigo: code, mensaje: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(BilleteError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the billete", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/billetes/42");
  });
});

=== web/src/infrastructure/billete/billete-repository-http.ts ===
import { BilleteError } from "../../domain/billete/errors";
import { type Billete, type BilleteDraft, parseState } from "../../domain/billete/model";
import type { BilleteRepository } from "../../domain/billete/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type BilleteDto = components["schemas"]["DtoBillete"];
type BilleteRequest = components["schemas"]["PeticionCrearBillete"];

function toBillete(dto: BilleteDto): Billete {
  return {
    id: dto.id,
    state: parseState(dto.state),
  };
}

function toRequest(draft: BilleteDraft): BilleteRequest {
  return {
    state: draft.state,
  };
}

/** `BilleteRepository` over the REST API (`/billetes`). */
export function billeteRepositoryHttp(api: ApiClient): BilleteRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/billetes", {
        params: { query: { limite: page.limit, desplazamiento: page.offset } },
      });
      if (data === undefined) throw new BilleteError(apiErrorCode(error, response));
      return {
        items: data.elementos.map(toBillete),
        total: data.total,
        limit: data.limite,
        offset: data.desplazamiento,
      };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/billetes/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new BilleteError(apiErrorCode(error, response));
      return toBillete(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/billetes", {
        body: toRequest(draft),
      });
      if (data === undefined) throw new BilleteError(apiErrorCode(error, response));
      return toBillete(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/billetes/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new BilleteError(apiErrorCode(error, response));
      return toBillete(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/billetes/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new BilleteError(apiErrorCode(error, response));
    },
  };
}

