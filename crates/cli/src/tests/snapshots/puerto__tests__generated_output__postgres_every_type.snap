#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoProducto {
    pub id: Uuid,
    pub title: String,
    pub sku: String,
    pub price: i64,
    pub rating: f64,
    pub active: bool,
    pub ref_id: Uuid,
