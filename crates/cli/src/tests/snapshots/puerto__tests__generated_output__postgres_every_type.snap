import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionBillete, MadreBillete } from "../../../pruebas/billete";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaBillete } from "./lista-billete";

describe("ContenedorListaBillete", () => {
  test("debería mostrar una fila por cada billete", async () => {
    // Preparar
    const semilla = [MadreBillete.aleatorio(), MadreBillete.aleatorio()];
    const api = apiFalsa([coleccionBillete(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaBillete />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreBillete.aleatorio());
    const api = apiFalsa([coleccionBillete(semilla)]);
    renderizarPantalla(<ContenedorListaBillete />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreBillete.aleatorio());
    const api = apiFalsa([coleccionBillete(semilla)]);
    const ruta = "/billetes?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaBillete />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay billetes", async () => {
    // Preparar
    const api = apiFalsa([coleccionBillete()]);

    // Actuar
    renderizarPantalla(<ContenedorListaBillete />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay billetes.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /billetes": "billete.repositorio" };
    const api = apiFalsa([coleccionBillete()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaBillete />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("billete.repositorio");
  });
});

=== web/src/contextos/billete/contenedores/lista-billete.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaBillete } from "../vistas/lista-billete";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaBillete() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const billetes = useCarga(
    () => desenvolver(api.GET("/billetes", { params: { query: consulta } })),
    [api, desplazamiento],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Billetes</h1>
        <Link href="/billetes/nuevo" className="btn btn-primary">
          Crear billete
        </Link>
      </div>
      {billetes.estado === "cargando" && <span className="loading loading-spinner" />}
      {billetes.estado === "error" && <AlertaError error={billetes.error} />}
      {billetes.estado === "listo" &&
        (billetes.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay billetes." />
        ) : (
          <>
            <VistaListaBillete billetes={billetes.datos.elementos} />
            <Paginacion
              total={billetes.datos.total}
              limite={billetes.datos.limite}
              desplazamiento={billetes.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/billete/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaBillete {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "billete.state_invalido": "State: no válido",
  "billete.duplicado": "Estos valores ya están en uso",
  "billete.no_encontrado": "Ya no existe",
  "billete.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "billete.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "billete.state_invalido": "state",
};

export function aProblema(codigo: string): ProblemaBillete {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

