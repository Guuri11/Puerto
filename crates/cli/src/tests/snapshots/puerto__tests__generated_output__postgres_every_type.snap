use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    model::Product,
    repository::ProductRepositoryTrait,
    use_cases::list_products::{ListProductsParams, ListProductsUseCaseTrait},
};

pub struct ListProductsUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl ListProductsUseCaseTrait for ListProductsUseCaseImpl {
    async fn execute(&self, _params: ListProductsParams) -> Result<Vec<Product>, ProductError> {
        tracing::info!("list_products: start");
        self.repository
            .find_all()
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_products: repository failed"))
            .map_err(ProductError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::{
        model::{Product, ProductProps},
        repository::mocks::MockProductRepository,
    };
    use uuid::Uuid;
    use chrono::Utc;
    use std::collections::HashMap;


    #[tokio::test]
    async fn should_return_all_products() {
        let entities = vec![
            Product::new(ProductProps {
            title: "first".to_string(),
            sku: "first".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        }).unwrap(),
            Product::new(ProductProps {
            title: "second".to_string(),
            sku: "second".to_string(),
            price: 42,
            rating: 1.5,
            active: true,
            ref_id: Uuid::new_v4(),
            published_at: Utc::now(),
            summary: None,
            views: None,
            expires_at: None,
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
        }).unwrap(),
        ];
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListProductsParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_products_exist() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListProductsParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

