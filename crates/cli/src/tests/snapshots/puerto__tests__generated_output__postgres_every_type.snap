pub async fn build_app() -> impl poem::Endpoint {
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let pool = infrastructure::db::create_postgres_pool(&database_url)
        .await
        .expect("Failed to connect to database");
    infrastructure::db::run_migrations(&pool)
        .await
        .expect("Failed to run migrations");

    let get_greeting = Arc::new(GetGreetingUseCaseImpl { repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait> });
    let greeting_api = GreetingApi { get_greeting };

    let product_repo: Arc<dyn ProductRepositoryTrait> = Arc::new(PgProductRepository::new(pool.clone()));
    let create_product = Arc::new(CreateProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let get_product = Arc::new(GetProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let list_products = Arc::new(ListProductsUseCaseImpl { repository: Arc::clone(&product_repo) });
    let update_product = Arc::new(UpdateProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let delete_product = Arc::new(DeleteProductUseCaseImpl { repository: Arc::clone(&product_repo) });
    let archive_product = Arc::new(ArchiveProductUseCaseImpl { repository: product_repo });
    let product_api = ProductApi { create_product, get_product, list_products, update_product, delete_product, archive_product };

    let customer_repo: Arc<dyn CustomerRepositoryTrait> = Arc::new(PgCustomerRepository::new(pool.clone()));
    let create_customer = Arc::new(CreateCustomerUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let get_customer = Arc::new(GetCustomerUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let list_customers = Arc::new(ListCustomersUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let update_customer = Arc::new(UpdateCustomerUseCaseImpl { repository: Arc::clone(&customer_repo) });
    let delete_customer = Arc::new(DeleteCustomerUseCaseImpl { repository: customer_repo });
    let customer_api = CustomerApi { create_customer, get_customer, list_customers, update_customer, delete_customer };

    let ticket_repo: Arc<dyn TicketRepositoryTrait> = Arc::new(PgTicketRepository::new(pool.clone()));
    let create_ticket = Arc::new(CreateTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let get_ticket = Arc::new(GetTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let list_tickets = Arc::new(ListTicketsUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let update_ticket = Arc::new(UpdateTicketUseCaseImpl { repository: Arc::clone(&ticket_repo) });
    let delete_ticket = Arc::new(DeleteTicketUseCaseImpl { repository: ticket_repo });
    let ticket_api = TicketApi { create_ticket, get_ticket, list_tickets, update_ticket, delete_ticket };

    let port = std::env::var("SERVICE_PORT").unwrap_or_else(|_| "8080".to_string());
    let api_service =
        openapi_service((greeting_api, product_api, customer_api, ticket_api)).server(format!("http://localhost:{port}/api"));
    let ui = api_service.swagger_ui();

    let cors_origins = std::env::var("CORS_ALLOWED_ORIGINS").unwrap_or_default();
    let mut cors = Cors::new();
    for origin in cors_origins.split(',').map(str::trim).filter(|s| !s.is_empty()) {
        cors = cors.allow_origin(origin);
    }

    Route::new()
        .at("/health", get(crate::health::liveness))
        .at(
            "/health/ready",
            get(poem::endpoint::make(move |_| {
                let pool = pool.clone();
                async move { crate::health::readiness(infrastructure::db::ping(&pool).await) }
            })),
        )
        .nest("/api", api_service)
        .nest("/", ui)
        .with(Tracing)
        .with(cors)
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;

    use business::domain::greeting::use_cases::get_greeting::mocks::MockGetGreetingUseCase;
    use business::domain::product::use_cases::create_product::mocks::MockCreateProductUseCase;
    use business::domain::product::use_cases::get_product::mocks::MockGetProductUseCase;
    use business::domain::product::use_cases::list_products::mocks::MockListProductsUseCase;
    use business::domain::product::use_cases::update_product::mocks::MockUpdateProductUseCase;
    use business::domain::product::use_cases::delete_product::mocks::MockDeleteProductUseCase;
    use business::domain::product::use_cases::archive_product::mocks::MockArchiveProductUseCase;
    use business::domain::customer::use_cases::create_customer::mocks::MockCreateCustomerUseCase;
    use business::domain::customer::use_cases::get_customer::mocks::MockGetCustomerUseCase;
    use business::domain::customer::use_cases::list_customers::mocks::MockListCustomersUseCase;
    use business::domain::customer::use_cases::update_customer::mocks::MockUpdateCustomerUseCase;
    use business::domain::customer::use_cases::delete_customer::mocks::MockDeleteCustomerUseCase;
    use business::domain::ticket::use_cases::create_ticket::mocks::MockCreateTicketUseCase;
    use business::domain::ticket::use_cases::get_ticket::mocks::MockGetTicketUseCase;
    use business::domain::ticket::use_cases::list_tickets::mocks::MockListTicketsUseCase;
    use business::domain::ticket::use_cases::update_ticket::mocks::MockUpdateTicketUseCase;
    use business::domain::ticket::use_cases::delete_ticket::mocks::MockDeleteTicketUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let greeting_api = GreetingApi { get_greeting: Arc::new(MockGetGreetingUseCase::new()) };
        let product_api = ProductApi { create_product: Arc::new(MockCreateProductUseCase::new()), get_product: Arc::new(MockGetProductUseCase::new()), list_products: Arc::new(MockListProductsUseCase::new()), update_product: Arc::new(MockUpdateProductUseCase::new()), delete_product: Arc::new(MockDeleteProductUseCase::new()), archive_product: Arc::new(MockArchiveProductUseCase::new()) };
        let customer_api = CustomerApi { create_customer: Arc::new(MockCreateCustomerUseCase::new()), get_customer: Arc::new(MockGetCustomerUseCase::new()), list_customers: Arc::new(MockListCustomersUseCase::new()), update_customer: Arc::new(MockUpdateCustomerUseCase::new()), delete_customer: Arc::new(MockDeleteCustomerUseCase::new()) };
        let ticket_api = TicketApi { create_ticket: Arc::new(MockCreateTicketUseCase::new()), get_ticket: Arc::new(MockGetTicketUseCase::new()), list_tickets: Arc::new(MockListTicketsUseCase::new()), update_ticket: Arc::new(MockUpdateTicketUseCase::new()), delete_ticket: Arc::new(MockDeleteTicketUseCase::new()) };
        let spec = openapi_service((greeting_api, product_api, customer_api, ticket_api)).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

