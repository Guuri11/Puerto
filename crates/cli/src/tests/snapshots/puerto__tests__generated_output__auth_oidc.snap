import { PedidoError } from "../domain/pedido/errors";
import type { Pedido, PedidoDraft } from "../domain/pedido/model";
import type { PedidoRepository } from "../domain/pedido/repository";

/** Valid pedidos for tests; pass `overrides` for the fields a test is about. */
export const PedidoMother = {
  draft(overrides: Partial<PedidoDraft> = {}): PedidoDraft {
    return {
      total: 42,
      ...overrides,
    };
  },

  random(overrides: Partial<Pedido> = {}): Pedido {
    return { id: crypto.randomUUID(), ...PedidoMother.draft(), ...overrides };
  },
};

/** An in-memory `PedidoRepository`. Override a method to make it fail. */
export function fakePedidoRepository(seed: Pedido[] = []): PedidoRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new PedidoError("pedido.no_encontrado");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

