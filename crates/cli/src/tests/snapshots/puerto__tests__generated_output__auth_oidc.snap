import { useAuth } from "../../core/auth";

/** Who is signed in, and the button to sign in or out. */
export function UserMenu() {
  const { user, login, logout } = useAuth();
  if (user === null) {
    return (
      <button type="button" className="btn btn-ghost" onClick={() => void login()}>
        Sign in
      </button>
    );
  }
  return (
    <div className="flex items-center gap-2">
      <span className="text-sm">{user.name ?? user.email ?? "Signed in"}</span>
      <button type="button" className="btn btn-ghost btn-sm" onClick={() => void logout()}>
        Sign out
      </button>
    </div>
  );
}

=== web/src/test-support/auth.ts ===
import type { AuthGateway, CurrentUser } from "../domain/auth/session";
import { ROLES } from "../presentation/core/generated/roles";

/** Signed-in users for tests; pass `overrides` for what a test is about. */
export const CurrentUserMother = {
  random(overrides: Partial<CurrentUser> = {}): CurrentUser {
    const id = crypto.randomUUID();
    return { id, email: `ada-${id.slice(0, 8)}@example.com`, name: "Ada", roles: [], ...overrides };
  },

  /** Holds every role a generated screen checks: what `renderScreen` signs in by default. */
  caller(): CurrentUser {
    return CurrentUserMother.random({ roles: [...ROLES] });
  },
};

/** An `AuthGateway` with `user` signed in (`null`: nobody). `logins` records each `login` call. */
export function fakeAuthGateway({ user = null }: { user?: CurrentUser | null } = {}) {
  const logins: string[] = [];
  const gateway: AuthGateway = {
    currentUser: async () => user,
    accessToken: async () => (user === null ? null : `token-of-${user.id}`),
    login: async (returnTo) => {
      logins.push(returnTo);
    },
    completeLogin: async () => "/",
    logout: async () => {},
  };
  return { ...gateway, logins };
}

=== web/src/test-support/order.ts ===
import { OrderError } from "../domain/order/errors";
import type { Order, OrderDraft } from "../domain/order/model";
import type { OrderRepository } from "../domain/order/repository";

/** Valid orders for tests; pass `overrides` for the fields a test is about. */
export const OrderMother = {
  draft(overrides: Partial<OrderDraft> = {}): OrderDraft {
    return {
      total: 42,
      ...overrides,
    };
  },

  random(overrides: Partial<Order> = {}): Order {
    return { id: crypto.randomUUID(), ...OrderMother.draft(), ...overrides };
  },
};

/** An in-memory `OrderRepository`. Override a method to make it fail. */
export function fakeOrderRepository(seed: Order[] = []): OrderRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new OrderError("order.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

