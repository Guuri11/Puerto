if (root === null) {
  throw new Error("index.html has no #root element");
}

createRoot(root).render(
  <StrictMode>
    <DependenciesProvider value={createDependencies()}>
      <AuthProvider>
        <Layout title={document.title} nav={navEntries}>
          <AppRoutes />
        </Layout>
      </AuthProvider>
    </DependenciesProvider>
  </StrictMode>,
);

