=== infrastructure/src/order/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::order::{
    model::{Order, OrderId},
    repository::OrderRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// Keeps the orders it is given in process memory: they are lost when the process stops.
/// Like the Postgres adapter, it hides deleted rows and lists newest first.
/// It stands in until there is a database (`puerto new --db` generates Postgres repositories).
#[derive(Default)]
pub struct InMemoryOrderRepository {
    rows: RwLock<HashMap<OrderId, Order>>,
}

impl InMemoryOrderRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<OrderId, Order>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<OrderId, Order>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl OrderRepositoryTrait for InMemoryOrderRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Order>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = self.read();
        let mut live: Vec<&Order> = rows.values().filter(|row| !row.deleted).collect();
        live.sort_by(|a, b| {
            b.created_at
                .cmp(&a.created_at)
                .then_with(|| a.id.value().cmp(&b.id.value()))
        });
        let total = live.len() as u64;
        let items = live
            .into_iter()
            .skip(page.offset() as usize)
            .take(page.limit() as usize)
            .cloned()
            .collect();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: OrderId) -> Result<Option<Order>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(self.read().get(&id).filter(|row| !row.deleted).cloned())
    }

    async fn save(&self, entity: &Order) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let mut rows = self.write();
        rows.insert(entity.id, entity.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::order::model::OrderProps;

    fn new_order() -> Order {
        Order::new(OrderProps { total: 42 }).unwrap()
    }

    #[tokio::test]
    async fn should_find_a_saved_order_by_id() {
        // Arrange
        let repo = InMemoryOrderRepository::new();
        let entity = new_order();
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();

        // Assert
        assert_eq!(found.map(|row| row.id), Some(entity.id));
    }

    #[tokio::test]
    async fn should_update_the_row_when_saved_again() {
        // Arrange
        let repo = InMemoryOrderRepository::new();
        let mut entity = new_order();
        repo.save(&entity).await.unwrap();
        entity.updated_at = chrono::Utc::now();

        // Act
        repo.save(&entity).await.unwrap();

        // Assert
        let page = repo.find_all(PageRequest::default()).await.unwrap();
        assert_eq!(page.total, 1);
        assert_eq!(page.items[0].updated_at, entity.updated_at);
    }

    #[tokio::test]
    async fn should_not_find_a_deleted_order() {
        // Arrange
        let repo = InMemoryOrderRepository::new();
        let mut entity = new_order();
        entity.deleted = true;
        entity.deleted_at = Some(entity.updated_at);
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();
        let page = repo.find_all(PageRequest::default()).await.unwrap();

        // Assert
        assert!(found.is_none());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_return_the_requested_page_of_a_larger_list() {
        // Arrange
        let repo = InMemoryOrderRepository::new();
        for _ in 0..3 {
            repo.save(&new_order()).await.unwrap();
        }

        // Act
        let page = repo
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }
}

=== infrastructure/src/product/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::product::{
    model::{Product, ProductId},
    repository::ProductRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// Keeps the products it is given in process memory: they are lost when the process stops.
/// Like the Postgres adapter, it hides deleted rows and lists newest first;
/// a unique value another live row holds is `Duplicate`.
/// It stands in until there is a database (`puerto new --db` generates Postgres repositories).
#[derive(Default)]
pub struct InMemoryProductRepository {
    rows: RwLock<HashMap<ProductId, Product>>,
}

impl InMemoryProductRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<ProductId, Product>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<ProductId, Product>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl ProductRepositoryTrait for InMemoryProductRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Product>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = self.read();
        let mut live: Vec<&Product> = rows.values().filter(|row| !row.deleted).collect();
        live.sort_by(|a, b| {
            b.created_at
                .cmp(&a.created_at)
                .then_with(|| a.id.value().cmp(&b.id.value()))
        });
        let total = live.len() as u64;
        let items = live
            .into_iter()
            .skip(page.offset() as usize)
            .take(page.limit() as usize)
            .cloned()
            .collect();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: ProductId) -> Result<Option<Product>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(self.read().get(&id).filter(|row| !row.deleted).cloned())
    }

    async fn save(&self, entity: &Product) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let mut rows = self.write();
        // Like the partial unique indexes: only live rows hold their values.
        let taken = !entity.deleted
            && rows
                .values()
                .any(|row| row.id != entity.id && !row.deleted && row.sku == entity.sku);
        if taken {
            tracing::warn!(id = %entity.id, "save rejected: a unique value is taken");
            return Err(RepositoryError::Duplicate);
        }
        rows.insert(entity.id, entity.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::product::model::ProductProps;
    use business::domain::product::value_objects::Name;
    use business::domain::product::value_objects::Status;
    use uuid::Uuid;

    fn new_product() -> Product {
        Product::new(ProductProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Uuid::new_v4().to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap()
    }

    #[tokio::test]
    async fn should_find_a_saved_product_by_id() {
        // Arrange
        let repo = InMemoryProductRepository::new();
        let entity = new_product();
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();

        // Assert
        assert_eq!(found.map(|row| row.id), Some(entity.id));
    }

    #[tokio::test]
    async fn should_update_the_row_when_saved_again() {
        // Arrange
        let repo = InMemoryProductRepository::new();
        let mut entity = new_product();
        repo.save(&entity).await.unwrap();
        entity.updated_at = chrono::Utc::now();

        // Act
        repo.save(&entity).await.unwrap();

        // Assert
        let page = repo.find_all(PageRequest::default()).await.unwrap();
        assert_eq!(page.total, 1);
        assert_eq!(page.items[0].updated_at, entity.updated_at);
    }

    #[tokio::test]
    async fn should_not_find_a_deleted_product() {
        // Arrange
        let repo = InMemoryProductRepository::new();
        let mut entity = new_product();
        entity.deleted = true;
        entity.deleted_at = Some(entity.updated_at);
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();
        let page = repo.find_all(PageRequest::default()).await.unwrap();

        // Assert
        assert!(found.is_none());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_return_the_requested_page_of_a_larger_list() {
        // Arrange
        let repo = InMemoryProductRepository::new();
        for _ in 0..3 {
            repo.save(&new_product()).await.unwrap();
        }

        // Act
        let page = repo
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[tokio::test]
    async fn should_reject_a_duplicate_sku() {
        // Arrange
        let repo = InMemoryProductRepository::new();
        let first = new_product();
        repo.save(&first).await.unwrap();
        let mut second = new_product();
        second.sku = first.sku.clone();

        // Act
        let result = repo.save(&second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
    }
}

=== infrastructure/src/user/provisioning.rs ===
//! Yours: `puerto new --auth oidc` writes this file once. Every caller the provider vouches for
//! becomes a `User` row on their first request (ADR-0021 § 3 of Puerto).

use std::collections::HashMap;
use std::sync::{Arc, Mutex, PoisonError};
use std::time::{Duration, Instant};

use async_trait::async_trait;
use business::domain::user::{
    model::{User, UserId},
    repository::UserRepositoryTrait,
};
use puerto_core::RepositoryError;
use puerto_core::auth::{AuthError, Authenticator, Principal};

/// How long a caller's user id is remembered: within it, a request costs no lookup.
pub const CACHE_TTL: Duration = Duration::from_secs(60);

/// The project's [`Authenticator`]: asks `inner` (the provider) who the caller is, then finds or
/// creates their `User` and hands the routes a [`Principal`] carrying its id. The roles stay the
/// token's.
pub struct ProvisioningAuthenticator {
    inner: Arc<dyn Authenticator>,
    users: Arc<dyn UserRepositoryTrait>,
    issuer: String,
    /// The user id of each subject seen in the last [`CACHE_TTL`].
    cache: Mutex<HashMap<String, (UserId, Instant)>>,
}

impl ProvisioningAuthenticator {
    /// `issuer`: `AUTH_ISSUER` — with the token's subject, what identifies a user.
    pub fn new(
        inner: Arc<dyn Authenticator>,
        users: Arc<dyn UserRepositoryTrait>,
        issuer: impl Into<String>,
    ) -> Self {
        Self {
            inner,
            users,
            issuer: issuer.into(),
            cache: Mutex::new(HashMap::new()),
        }
    }

    fn cached(&self, subject: &str) -> Option<UserId> {
        let cache = self.cache.lock().unwrap_or_else(PoisonError::into_inner);
        cache
            .get(subject)
            .filter(|(_, at)| at.elapsed() < CACHE_TTL)
            .map(|(id, _)| *id)
    }

    fn remember(&self, subject: &str, id: UserId) {
        let mut cache = self.cache.lock().unwrap_or_else(PoisonError::into_inner);
        cache.retain(|_, (_, at)| at.elapsed() < CACHE_TTL);
        cache.insert(subject.to_string(), (id, Instant::now()));
    }

    /// The caller's user, created on their first request.
    async fn user_id(&self, principal: &Principal) -> Result<UserId, RepositoryError> {
        if let Some(user) = self
            .users
            .find_by_subject(&self.issuer, &principal.subject)
            .await?
        {
            return Ok(user.id);
        }
        let user = User::provision(
            &self.issuer,
            &principal.subject,
            principal.email.clone(),
            principal.name.clone(),
        );
        match self.users.save(&user).await {
            Ok(()) => {
                tracing::info!(id = %user.id, "user provisioned");
                Ok(user.id)
            }
            // Two first requests at once: the other one created it.
            Err(RepositoryError::Duplicate) => self
                .users
                .find_by_subject(&self.issuer, &principal.subject)
                .await?
                .map(|user| user.id)
                .ok_or(RepositoryError::Unavailable),
            Err(err) => Err(err),
        }
    }
}

#[async_trait]
impl Authenticator for ProvisioningAuthenticator {
    async fn authenticate(&self, token: &str) -> Result<Principal, AuthError> {
        let principal = self.inner.authenticate(token).await?;
        let id = match self.cached(&principal.subject) {
            Some(id) => id,
            None => {
                let id = self.user_id(&principal).await.map_err(|err| {
                    tracing::error!(error = %err, "could not provision the caller");
                    AuthError::Unavailable
                })?;
                self.remember(&principal.subject, id);
                id
            }
        };
        Ok(principal.with_user_id(id.value()))
    }
}

#[cfg(test)]
mod tests {
    use business::domain::user::repository::mocks::MockUserRepository;
    use puerto_core::auth::mocks::MockAuthenticator;
    use uuid::Uuid;

    use super::*;

    const ISSUER: &str = "http://localhost:8180/realms/test";

    /// The provider accepts `good` as Ada and rejects anything else as expired.
    fn provider() -> Arc<dyn Authenticator> {
        let mut provider = MockAuthenticator::new();
        provider
            .expect_authenticate()
            .returning(|token| match token {
                "good" => Ok(Principal::new(Uuid::nil(), "ada")
                    .with_email("ada@example.com")
                    .with_roles(["admin"])),
                _ => Err(AuthError::Expired),
            });
        Arc::new(provider)
    }

    fn authenticator(users: MockUserRepository) -> ProvisioningAuthenticator {
        ProvisioningAuthenticator::new(provider(), Arc::new(users), ISSUER)
    }

    #[tokio::test]
    async fn should_create_the_user_when_the_caller_is_new() {
        // Arrange
        let mut users = MockUserRepository::new();
        users.expect_find_by_subject().returning(|_, _| Ok(None));
        users
            .expect_save()
            .withf(|user| {
                user.issuer == ISSUER
                    && user.subject == "ada"
                    && user.email.as_deref() == Some("ada@example.com")
            })
            .times(1)
            .returning(|_| Ok(()));

        // Act
        let principal = authenticator(users).authenticate("good").await;

        // Assert
        let principal = principal.expect("authenticated");
        assert_ne!(principal.user_id, Uuid::nil());
        assert_eq!(principal.roles, vec!["admin"]);
    }

    #[tokio::test]
    async fn should_carry_the_existing_user_id_when_the_caller_is_known() {
        // Arrange
        let known = User::provision(ISSUER, "ada", None, None);
        let id = known.id;
        let mut users = MockUserRepository::new();
        users
            .expect_find_by_subject()
            .returning(move |_, _| Ok(Some(known.clone())));
        users.expect_save().times(0);

        // Act
        let principal = authenticator(users).authenticate("good").await;

        // Assert
        assert_eq!(principal.map(|p| p.user_id), Ok(id.value()));
    }

    #[tokio::test]
    async fn should_not_ask_the_repository_again_when_the_caller_is_cached() {
        // Arrange
        let mut users = MockUserRepository::new();
        users
            .expect_find_by_subject()
            .times(1)
            .returning(|_, _| Ok(None));
        users.expect_save().times(1).returning(|_| Ok(()));
        let authenticator = authenticator(users);
        let first = authenticator.authenticate("good").await.expect("first");

        // Act
        let second = authenticator.authenticate("good").await.expect("second");

        // Assert
        assert_eq!(first.user_id, second.user_id);
    }

    #[tokio::test]
    async fn should_use_the_other_requests_user_when_both_created_it_at_once() {
        // Arrange
        let winner = User::provision(ISSUER, "ada", None, None);
        let id = winner.id;
        let mut users = MockUserRepository::new();
        let mut lookups = 0;
        users.expect_find_by_subject().returning(move |_, _| {
            lookups += 1;
            Ok((lookups > 1).then(|| winner.clone()))
        });
        users
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));

        // Act
        let principal = authenticator(users).authenticate("good").await;

        // Assert
        assert_eq!(principal.map(|p| p.user_id), Ok(id.value()));
    }

    #[tokio::test]
    async fn should_answer_unavailable_when_the_users_cannot_be_read() {
        // Arrange
        let mut users = MockUserRepository::new();
        users
            .expect_find_by_subject()
            .returning(|_, _| Err(RepositoryError::Unavailable));

        // Act
        let result = authenticator(users).authenticate("good").await;

        // Assert
        assert_eq!(result, Err(AuthError::Unavailable));
    }

    #[tokio::test]
    async fn should_pass_the_providers_answer_on_when_it_rejects_the_token() {
        // Arrange
        let mut users = MockUserRepository::new();
        users.expect_find_by_subject().times(0);

        // Act
        let result = authenticator(users).authenticate("old").await;

        // Assert
        assert_eq!(result, Err(AuthError::Expired));
    }
}

=== infrastructure/src/user/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::user::{
    model::{User, UserId},
    repository::UserRepositoryTrait,
};
use puerto_core::RepositoryError;

/// Keeps the users in process memory: they are lost when the process stops, and provisioned again
/// on their next request. It stands in until there is a database (`puerto new --db`).
#[derive(Default)]
pub struct InMemoryUserRepository {
    rows: RwLock<HashMap<UserId, User>>,
}

impl InMemoryUserRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<UserId, User>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<UserId, User>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl UserRepositoryTrait for InMemoryUserRepository {
    async fn find_by_subject(
        &self,
        issuer: &str,
        subject: &str,
    ) -> Result<Option<User>, RepositoryError> {
        Ok(self
            .read()
            .values()
            .find(|user| user.issuer == issuer && user.subject == subject)
            .cloned())
    }

    async fn find_by_id(&self, id: UserId) -> Result<Option<User>, RepositoryError> {
        Ok(self.read().get(&id).cloned())
    }

    async fn save(&self, user: &User) -> Result<(), RepositoryError> {
        let mut rows = self.write();
        let taken = rows.values().any(|other| {
            other.id != user.id && other.issuer == user.issuer && other.subject == user.subject
        });
        if taken {
            return Err(RepositoryError::Duplicate);
        }
        rows.insert(user.id, user.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn ada() -> User {
        User::provision("issuer", "ada", Some("ada@example.com".into()), None)
    }

    #[tokio::test]
    async fn should_find_a_saved_user_when_looked_up_by_subject_or_id() {
        // Arrange
        let repository = InMemoryUserRepository::new();
        let user = ada();
        repository.save(&user).await.expect("saved");

        // Act
        let by_subject = repository.find_by_subject("issuer", "ada").await;
        let by_id = repository.find_by_id(user.id).await;

        // Assert
        assert_eq!(by_subject, Ok(Some(user.clone())));
        assert_eq!(by_id, Ok(Some(user)));
    }

    #[tokio::test]
    async fn should_find_nobody_when_the_subject_is_another_issuers() {
        // Arrange
        let repository = InMemoryUserRepository::new();
        repository.save(&ada()).await.expect("saved");

        // Act
        let found = repository.find_by_subject("other-issuer", "ada").await;

        // Assert
        assert_eq!(found, Ok(None));
    }

    #[tokio::test]
    async fn should_reject_a_second_user_when_the_subject_is_taken() {
        // Arrange
        let repository = InMemoryUserRepository::new();
        repository.save(&ada()).await.expect("saved");

        // Act
        let result = repository.save(&ada()).await;

        // Assert
        assert_eq!(result, Err(RepositoryError::Duplicate));
    }
}

=== presentation/Cargo.toml ===
[package]
name = "presentation"
version = "0.1.0"
edition = "2024"

[[bin]]
name = "snapshot"
path = "src/main.rs"

[dependencies]
business = { path = "../business" }
infrastructure = { path = "../infrastructure" }
puerto-core = { workspace = true }
# The OIDC adapter `bootstrap.rs` builds (ADR-0021).
puerto-auth = { workspace = true, features = ["oidc"] }
# The server, health probes, configuration and error body (`main.rs`, `generated/bootstrap.rs`).
puerto-web = { workspace = true }
poem = "3"
# `chrono` feature: without it poem-openapi has no `Type` impl for DateTime<Utc>, so any entity
# with a date field fails to derive `Object`.
poem-openapi = { version = "5", features = ["swagger-ui", "uuid", "chrono"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
tracing = "0.1"
uuid = { version = "1", features = ["v4"] }
# DTOs mirror the domain's field types, so any entity with a DateTime<Utc> field needs chrono here.
chrono = { version = "0.4", features = ["serde"] }

[dev-dependencies]
# Route tests: use case mocks and Object Mothers come from business behind `test-utils`, and
# `poem::test::TestClient` drives the real OpenApiService.
business = { path = "../business", features = ["test-utils"] }
# `MockAuthenticator`, for the routes that take `BearerAuth`.
puerto-core = { workspace = true, features = ["test-utils"] }
poem = { version = "3", features = ["test"] }

