=== web/src/presentation/pages/auth-callback.test.tsx ===
import { describe, expect, test } from "bun:test";
import { screen, waitFor } from "@testing-library/react";
import { CurrentUserMother, fakeAuthGateway } from "../../test-support/auth";
import { renderScreen } from "../../test-support/render";
import { AuthCallbackPage } from "./auth-callback";

describe("AuthCallbackPage", () => {
  test("should go back to the page the sign-in started on", async () => {
    // Arrange
    const auth = { ...fakeAuthGateway(), completeLogin: async () => "/orders?page=2" };

    // Act
    const { history } = renderScreen(<AuthCallbackPage />, { auth }, "/auth/callback");

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/orders?page=2"));
  });

  test("should show why when the provider's answer is refused", async () => {
    // Arrange
    const auth = {
      ...fakeAuthGateway({ user: CurrentUserMother.random() }),
      completeLogin: () => Promise.reject(new Error("No matching state found in storage")),
    };

    // Act
    renderScreen(<AuthCallbackPage />, { auth }, "/auth/callback");

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "No matching state found in storage",
    );
  });
});

=== web/src/presentation/pages/auth-callback.tsx ===
import { useEffect, useRef, useState } from "react";
import { useLocation } from "wouter";
import { useAuth } from "../core/auth";
import { ErrorAlert } from "../shared/ui/error-alert";

/** Where the provider sends the user back after signing in (`redirect_uri`). */
export function AuthCallbackPage() {
  const { completeLogin } = useAuth();
  const [, navigate] = useLocation();
  const [failure, setFailure] = useState<unknown>(null);
  const started = useRef(false);

  useEffect(() => {
    // Once: StrictMode runs effects twice, and the provider's answer can be redeemed only once.
    if (started.current) return;
    started.current = true;
    completeLogin().then((back) => navigate(back, { replace: true }), setFailure);
  }, [completeLogin, navigate]);

  return failure === null ? (
    <span className="loading loading-spinner" />
  ) : (
    <ErrorAlert error={failure} />
  );
}

