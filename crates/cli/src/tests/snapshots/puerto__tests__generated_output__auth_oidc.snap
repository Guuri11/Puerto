    };
    use crate::tests::mothers::principal_mother::PrincipalMother;

    #[tokio::test]
    async fn should_update_product_when_params_are_valid() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: "original".to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: PrincipalMother::random(),
                id: entity_id,
                name: "updated".to_string(),
                sku: "updated".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().sku, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_product_does_not_exist() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: PrincipalMother::random(),
                id: ProductId::generate(),
                name: "new".to_string(),
                sku: "new".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_sku_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: "original".to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: PrincipalMother::random(),
                id: entity_id,
                name: "updated".to_string(),
                sku: "".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.sku_empty"
        );
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: "original".to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: PrincipalMother::random(),
                id: entity_id,
                name: "".to_string(),
                sku: "updated".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_name");
    }
}

=== business/src/domain/order/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum OrderError {
    #[error("order.validation_error.{0}")]
    ValidationError(String),
    #[error("order.not_found")]
    NotFound,
    #[error("order.duplicate")]
    Duplicate,
    #[error("order.repository_error")]
    RepositoryError,
    #[error("order.unknown")]
    Unknown,
    /// The caller may not do this with this data: a rule of the use case, on its `actor`.
    #[error("order.forbidden")]
    Forbidden,
}

impl From<RepositoryError> for OrderError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = OrderError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "order.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = OrderError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "order.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = OrderError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "order.repository_error");
    }
}

