=== web/src/domain/producto/model.ts ===
import { ProductoError } from "./errors";

export interface Producto {
  id: string;
  name: string;
  sku: string;
  price: number;
  status: Status;
}

/** What a create or an update sends: a producto without its id. */
export type ProductoDraft = Omit<Producto, "id">;

export const statusValues = ["Draft", "Live"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `producto.status_invalido`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new ProductoError("producto.status_invalido");
  return found;
}

