import { Route, Switch } from "wouter";
import { PedidoDetailContainer } from "../../features/pedido/containers/pedido-detail-container";
import { PedidoFormContainer } from "../../features/pedido/containers/pedido-form-container";
import { PedidoListContainer } from "../../features/pedido/containers/pedido-list-container";
import { ProductoDetailContainer } from "../../features/producto/containers/producto-detail-container";
import { ProductoFormContainer } from "../../features/producto/containers/producto-form-container";
import { ProductoListContainer } from "../../features/producto/containers/producto-list-container";
import { AuthCallbackPage } from "../../pages/auth-callback";
import { HomePage } from "../../pages/home";
import { NotFoundPage } from "../../pages/not-found";
import type { NavEntry } from "../../shared/ui/layout";
import { RequireAuth } from "../auth";
import { customRoutes } from "../routes";

export const navEntries: NavEntry[] = [
  { label: "Pedidos", href: "/pedidos" },
  { label: "Productos", href: "/productos" },
];

export function AppRoutes() {
  return (
    <Switch>
      <Route path="/">
        <HomePage entries={navEntries} />
      </Route>
      <Route path="/auth/callback">
        <AuthCallbackPage />
      </Route>
      {customRoutes}
      <Route path="/pedidos">
        <RequireAuth>
          <PedidoListContainer />
        </RequireAuth>
      </Route>
      <Route path="/pedidos/new">
        <RequireAuth>
          <PedidoFormContainer />
        </RequireAuth>
      </Route>
      <Route path="/pedidos/:id/edit">
        {(params) => (
          <RequireAuth>
            <PedidoFormContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/pedidos/:id">
        {(params) => (
          <RequireAuth>
            <PedidoDetailContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/productos">
        <ProductoListContainer />
      </Route>
      <Route path="/productos/new">
        <RequireAuth>
          <ProductoFormContainer />
        </RequireAuth>
      </Route>
      <Route path="/productos/:id/edit">
        {(params) => (
          <RequireAuth>
            <ProductoFormContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/productos/:id">{(params) => <ProductoDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

