use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{IdProducto, Producto};

#[async_trait]
pub trait RepositorioProducto: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Producto>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdProducto) -> Result<Option<Producto>, ErrorRepositorio>;
    async fn guardar(&self, entidad: &Producto) -> Result<(), ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub RepositorioProducto {}

        #[async_trait]
        impl RepositorioProducto for RepositorioProducto {
            async fn buscar_todos(&self, pagina: PeticionPagina) -> Result<Pagina<Producto>, ErrorRepositorio>;
            async fn buscar_por_id(&self, id: IdProducto) -> Result<Option<Producto>, ErrorRepositorio>;
            async fn guardar(&self, entidad: &Producto) -> Result<(), ErrorRepositorio>;
        }
    }
}

=== contextos/producto/dominio/src/valores.rs ===
use crate::errores::ErrorProducto;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorProducto> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorProducto::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Draft,
    Live,
}

impl std::str::FromStr for Status {
    type Err = ErrorProducto;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Draft" => Ok(Self::Draft),
            "Live" => Ok(Self::Live),
            _ => Err(ErrorProducto::StatusInvalido),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Draft => "Draft",
            Self::Live => "Live",
        }
    }
}

