import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { OrderError } from "../../../../domain/order/errors";
import { fakeOrderRepository, OrderMother } from "../../../../test-support/order";
import { renderScreen } from "../../../../test-support/render";
import { OrderListContainer } from "./order-list-container";

describe("OrderListContainer", () => {
  test("should show a row per order when there are some", async () => {
    // Arrange
    const seed = [OrderMother.random(), OrderMother.random()];
    const orderRepository = fakeOrderRepository(seed);

    // Act
    renderScreen(<OrderListContainer />, { orderRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => OrderMother.random());
    const orderRepository = fakeOrderRepository(seed);
    renderScreen(<OrderListContainer />, { orderRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => OrderMother.random());
    const orderRepository = fakeOrderRepository(seed);
    const path = "/orders?page=2";

    // Act
    renderScreen(<OrderListContainer />, { orderRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no order", async () => {
    // Arrange
    const orderRepository = fakeOrderRepository();

    // Act
    renderScreen(<OrderListContainer />, { orderRepository });

    // Assert
    expect(await screen.findByText("No orders yet.")).toBeTruthy();
  });

  test("should show the error code when the orders cannot be listed", async () => {
    // Arrange
    const orderRepository = {
      ...fakeOrderRepository(),
      list: () => Promise.reject(new OrderError("order.repository_error")),
    };

    // Act
    renderScreen(<OrderListContainer />, { orderRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("order.repository_error");
  });
});

=== web/src/presentation/features/order/containers/order-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { OrderListView } from "../views/order-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function OrderListContainer() {
  const { orderRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const orders = useAsync(
    () => orderRepository.list({ limit: PAGE_SIZE, offset }),
    [orderRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Orders</h1>
        <Link href="/orders/new" className="btn btn-primary">
          New order
        </Link>
      </div>
      {orders.status === "loading" && <span className="loading loading-spinner" />}
      {orders.status === "error" && <ErrorAlert error={orders.error} />}
      {orders.status === "ok" &&
        (orders.data.total === 0 ? (
          <EmptyState message="No orders yet." />
        ) : (
          <>
            <OrderListView orders={orders.data.items} />
            <Pagination {...orders.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

