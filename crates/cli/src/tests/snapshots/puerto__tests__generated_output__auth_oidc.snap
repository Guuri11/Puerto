import { describe, expect, test } from "bun:test";
import { screen, waitFor } from "@testing-library/react";
import { CurrentUserMother, fakeAuthGateway } from "../../test-support/auth";
import { renderScreen } from "../../test-support/render";
import { RequireAuth, useAuth } from "./auth";

function Secret() {
  const { can } = useAuth();
  return <p>{can("admin") ? "admin area" : "member area"}</p>;
}

describe("RequireAuth", () => {
  test("should start a sign-in that comes back here when nobody is signed in", async () => {
    // Arrange
    const auth = fakeAuthGateway({ user: null });

    // Act
    renderScreen(
      <RequireAuth>
        <Secret />
      </RequireAuth>,
      { auth },
      "/orders?page=2",
    );

    // Assert
    await waitFor(() => expect(auth.logins).toEqual(["/orders?page=2"]));
    expect(screen.queryByText("member area")).toBeNull();
  });

  test("should show the page to a signed-in user without signing in again", async () => {
    // Arrange
    const auth = fakeAuthGateway({ user: CurrentUserMother.random() });

    // Act
    renderScreen(
      <RequireAuth>
        <Secret />
      </RequireAuth>,
      { auth },
    );

    // Assert
    expect(await screen.findByText("member area")).toBeTruthy();
    expect(auth.logins).toEqual([]);
  });
});

describe("useAuth", () => {
  test("should allow a role only when the user holds it", async () => {
    // Arrange
    const user = CurrentUserMother.random({ roles: ["admin"] });

    // Act
    renderScreen(<Secret />, {}, "/", { user });

    // Assert
    expect(await screen.findByText("admin area")).toBeTruthy();
  });
});

describe("AuthProvider", () => {
  test("should show the error code when the API does not accept the session", async () => {
    // Arrange
    const auth = {
      ...fakeAuthGateway(),
      currentUser: () => Promise.reject(new Error("auth.unauthenticated")),
    };

    // Act
    renderScreen(<Secret />, { auth });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("auth.unauthenticated");
  });
});

=== web/src/presentation/core/auth.tsx ===
import {
  createContext,
  type ReactNode,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import { useLocation, useSearch } from "wouter";
import type { CurrentUser } from "../../domain/auth/session";
import { ErrorAlert } from "../shared/ui/error-alert";
import { useDependencies } from "./dependencies";

export interface Auth {
  /** The signed-in user, `null` when nobody is. */
  user: CurrentUser | null;
  /** Whether the user holds `role`. Screens hide what the API would refuse; the API still decides. */
  can(role: string): boolean;
  /** Signs in, then comes back to the current page. */
  login(): Promise<void>;
  logout(): Promise<void>;
  /** Asks the gateway again who is signed in: after a sign-in that did not leave the app. */
  refresh(): Promise<void>;
  /** Finishes a sign-in (`/auth/callback`): answers the page to go back to. */
  completeLogin(): Promise<string>;
}

type State =
  | { status: "loading" }
  | { status: "ready"; user: CurrentUser | null }
  | { status: "error"; error: unknown };

const AuthContext = createContext<Auth | null>(null);

/** Asks the gateway who is signed in once, before rendering the app: no screen flickers. */
export function AuthProvider({ children }: { children: ReactNode }) {
  const { auth } = useDependencies();
  const [location] = useLocation();
  const search = useSearch();
  const [state, setState] = useState<State>({ status: "loading" });

  useEffect(() => {
    auth.currentUser().then(
      (user) => setState({ status: "ready", user }),
      (error: unknown) => setState({ status: "error", error }),
    );
  }, [auth]);

  const here = search === "" ? location : `${location}?${search}`;
  const login = useCallback(() => auth.login(here), [auth, here]);
  const refresh = useCallback(async () => {
    setState({ status: "ready", user: await auth.currentUser() });
  }, [auth]);
  const completeLogin = useCallback(async () => {
    const back = await auth.completeLogin();
    await refresh();
    return back;
  }, [auth, refresh]);
  const logout = useCallback(async () => {
    await auth.logout();
    setState({ status: "ready", user: null });
  }, [auth]);
  const user = state.status === "ready" ? state.user : null;
  const value = useMemo<Auth>(
    () => ({
      user,
      can: (role) => user?.roles.includes(role) ?? false,
      login,
      logout,
      refresh,
      completeLogin,
    }),
    [user, login, logout, refresh, completeLogin],
  );

  if (state.status === "loading") return <span className="loading loading-spinner" />;
  if (state.status === "error") return <ErrorAlert error={state.error} />;
  return <AuthContext value={value}>{children}</AuthContext>;
}

export function useAuth(): Auth {
  const auth = useContext(AuthContext);
  if (auth === null) {
    throw new Error("useAuth() called outside <AuthProvider>");
  }
  return auth;
}

/** Renders `children` for a signed-in user; anyone else is sent to sign in, and back here. */
export function RequireAuth({ children }: { children: ReactNode }) {
  const { user, login } = useAuth();
  const started = useRef(false);

  useEffect(() => {
    // Once: StrictMode runs effects twice.
    if (user !== null || started.current) return;
    started.current = true;
    void login();
  }, [user, login]);

  return user === null ? <span className="loading loading-spinner" /> : children;
}

