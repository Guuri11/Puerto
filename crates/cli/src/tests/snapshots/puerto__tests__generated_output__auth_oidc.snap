// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.

import { Route, Switch } from "wouter";
import { OrderDetailContainer } from "../../features/order/containers/order-detail-container";
import { OrderFormContainer } from "../../features/order/containers/order-form-container";
import { OrderListContainer } from "../../features/order/containers/order-list-container";
import { ProductDetailContainer } from "../../features/product/containers/product-detail-container";
import { ProductFormContainer } from "../../features/product/containers/product-form-container";
import { ProductListContainer } from "../../features/product/containers/product-list-container";
import { AuthCallbackPage } from "../../pages/auth-callback";
import { HomePage } from "../../pages/home";
import { NotFoundPage } from "../../pages/not-found";
import type { NavEntry } from "../../shared/ui/layout";
import { RequireAuth } from "../auth";
import { customRoutes } from "../routes";

export const navEntries: NavEntry[] = [
  { label: "Orders", href: "/orders" },
  { label: "Products", href: "/products" },
];

export function AppRoutes() {
  return (
    <Switch>
      <Route path="/">
        <HomePage entries={navEntries} />
      </Route>
      <Route path="/auth/callback">
        <AuthCallbackPage />
      </Route>
      {customRoutes}
      <Route path="/orders">
        <RequireAuth>
          <OrderListContainer />
        </RequireAuth>
      </Route>
      <Route path="/orders/new">
        <RequireAuth>
          <OrderFormContainer />
        </RequireAuth>
      </Route>
      <Route path="/orders/:id/edit">
        {(params) => (
          <RequireAuth>
            <OrderFormContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/orders/:id">
        {(params) => (
          <RequireAuth>
            <OrderDetailContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/products">
        <ProductListContainer />
      </Route>
      <Route path="/products/new">
        <RequireAuth>
          <ProductFormContainer />
        </RequireAuth>
      </Route>
      <Route path="/products/:id/edit">
        {(params) => (
          <RequireAuth>
            <ProductFormContainer id={params.id} />
          </RequireAuth>
        )}
      </Route>
      <Route path="/products/:id">{(params) => <ProductDetailContainer id={params.id} />}</Route>
      <Route>
        <NotFoundPage />
      </Route>
    </Switch>
  );
}

