import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ProductError } from "../../../../domain/product/errors";
import type { ProductDraft } from "../../../../domain/product/model";
import { fakeProductRepository, ProductMother } from "../../../../test-support/product";
import { renderScreen } from "../../../../test-support/render";
import { ProductFormContainer } from "./product-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ProductDraft) {
  await screen.findByText("Save");
  type("Title", draft.title);
  type("Price", String(draft.price));
}

describe("ProductFormContainer", () => {
  test("should create the product from what was typed and show it", async () => {
    // Arrange
    const draft = ProductMother.draft();
    const productRepository = fakeProductRepository();
    const { history } = renderScreen(<ProductFormContainer />, { productRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/products/"));
    const {
      items: [created],
    } = await productRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/products/${created?.id}`);
  });

  test("should save the edited product when an existing one is submitted", async () => {
    // Arrange
    const seeded = ProductMother.random();
    const productRepository = fakeProductRepository([seeded]);
    const { history } = renderScreen(<ProductFormContainer id={seeded.id} />, {
      productRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/products/${seeded.id}`));
    expect(await productRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the validation code when the API rejects the product", async () => {
    // Arrange
    const code = "product.validation_error.invalid";
    const productRepository = {
      ...fakeProductRepository(),
      create: () => Promise.reject(new ProductError(code)),
    };
    renderScreen(<ProductFormContainer />, { productRepository });
    await fillIn(ProductMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });
});

=== web/src/presentation/features/product/containers/product-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Product } from "../../../../domain/product/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ProductFormView, toProductDraft, toProductForm } from "../views/product-form-view";

/** Creates a product, or edits the one with `id`. */
export function ProductFormContainer({ id }: { id?: string }) {
  const { productRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : productRepository.get(id)),
    [productRepository, id],
  );
  const title = id === undefined ? "New product" : "Edit product";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ProductForm existing={existing.data} />}
      <Link href={id === undefined ? "/products" : `/products/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ProductForm({ existing }: { existing: Product | null }) {
  const { productRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toProductForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toProductDraft(values);
      const saved =
        existing === null
          ? await productRepository.create(draft)
          : await productRepository.update(existing.id, draft);
      navigate(`/products/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {failure !== null && <ErrorAlert error={failure} />}
        <ProductFormView values={values} saving={saving} onChange={setValues} onSubmit={save} />
      </div>
    </div>
  );
}

