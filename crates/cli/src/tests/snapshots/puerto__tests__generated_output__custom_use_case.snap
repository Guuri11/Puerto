=== business/src/application/product/create_product.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    model::{Product, ProductProps},
    repository::ProductRepositoryTrait,
    use_cases::create_product::{CreateProductParams, CreateProductUseCaseTrait},
};

pub struct CreateProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl CreateProductUseCaseTrait for CreateProductUseCaseImpl {
    async fn execute(&self, params: CreateProductParams) -> Result<Product, ProductError> {
        tracing::info!("create_product: start");
        let entity = Product::new(ProductProps {
            title: params.title,
            price: params.price,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_product: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_product: repository failed"))?;
        tracing::info!(id = %entity.id, "create_product: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::repository::mocks::MockProductRepository;
    use puerto_core::RepositoryError;

    #[tokio::test]
    async fn should_create_product_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                title: "example".to_string(),
                price: 42,
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                title: "example".to_string(),
                price: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.duplicate");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let mock_repo = MockProductRepository::new();
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                title: "".to_string(),
                price: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.title_empty"
        );
    }
}

=== business/src/application/product/delete_product.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    repository::ProductRepositoryTrait,
    use_cases::delete_product::{DeleteProductParams, DeleteProductUseCaseTrait},
};

pub struct DeleteProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl DeleteProductUseCaseTrait for DeleteProductUseCaseImpl {
    async fn execute(&self, params: DeleteProductParams) -> Result<(), ProductError> {
        tracing::info!(id = %params.id, "delete_product: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_product: repository failed"))?
            .ok_or_else(|| {
                let err = ProductError::NotFound;
                tracing::warn!(error = %err, "delete_product: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_product: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::{
        model::{Product, ProductId, ProductProps},
        repository::mocks::MockProductRepository,
    };

    #[tokio::test]
    async fn should_soft_delete_product_when_id_exists() {
        let entity = Product::new(ProductProps {
            title: "example".to_string(),
            price: 42,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteProductParams { id: entity_id })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_product_does_not_exist() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteProductParams {
                id: ProductId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
    }
}

=== business/src/application/product/get_product.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    model::Product,
    repository::ProductRepositoryTrait,
    use_cases::get_product::{GetProductParams, GetProductUseCaseTrait},
};

pub struct GetProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl GetProductUseCaseTrait for GetProductUseCaseImpl {
    async fn execute(&self, params: GetProductParams) -> Result<Product, ProductError> {
        tracing::info!(id = %params.id, "get_product: start");
        let result = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "get_product: repository failed"))?;
        result.ok_or_else(|| {
            let err = ProductError::NotFound;
            tracing::warn!(error = %err, "get_product: rejected");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::{
        model::{Product, ProductId, ProductProps},
        repository::mocks::MockProductRepository,
    };
    use puerto_core::RepositoryError;

    #[tokio::test]
    async fn should_return_product_when_id_exists() {
        let entity = Product::new(ProductProps {
            title: "example".to_string(),
            price: 42,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = GetProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(GetProductParams { id: entity_id }).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_not_found_when_id_does_not_exist() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = GetProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetProductParams {
                id: ProductId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_store_is_unavailable() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(|_| Err(RepositoryError::Unavailable));
        let use_case = GetProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetProductParams {
                id: ProductId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.repository_error");
    }
}

=== business/src/application/product/list_products.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::product::{
    errors::ProductError,
    model::Product,
    repository::ProductRepositoryTrait,
    use_cases::list_products::{ListProductsParams, ListProductsUseCaseTrait},
};

pub struct ListProductsUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl ListProductsUseCaseTrait for ListProductsUseCaseImpl {
    async fn execute(&self, params: ListProductsParams) -> Result<Page<Product>, ProductError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_products: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_products: repository failed"))
            .map_err(ProductError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::{
        model::{Product, ProductProps},
        repository::mocks::MockProductRepository,
    };
    use puerto_core::PageRequest;

    #[tokio::test]
    async fn should_return_the_page_of_products() {
        let entities = vec![
            Product::new(ProductProps {
                title: "first".to_string(),
                price: 42,
            })
            .unwrap(),
            Product::new(ProductProps {
                title: "second".to_string(),
                price: 42,
            })
            .unwrap(),
        ];
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListProductsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_products_exist() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListProductsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListProductsParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

=== business/src/application/product/update_product.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::product::{
    errors::ProductError,
    model::Product,
    repository::ProductRepositoryTrait,
    use_cases::update_product::{UpdateProductParams, UpdateProductUseCaseTrait},
};

pub struct UpdateProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl UpdateProductUseCaseTrait for UpdateProductUseCaseImpl {
    async fn execute(&self, params: UpdateProductParams) -> Result<Product, ProductError> {
        tracing::info!(id = %params.id, "update_product: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_product: repository failed"))?
            .ok_or_else(|| {
                let err = ProductError::NotFound;
                tracing::warn!(error = %err, "update_product: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = ProductError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_product: rejected");
            return Err(err);
        }
        entity.title = params.title;
        entity.price = params.price;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_product: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::product::{
        model::{Product, ProductId, ProductProps},
        repository::mocks::MockProductRepository,
    };

    #[tokio::test]
    async fn should_update_product_when_params_are_valid() {
        // Arrange
        let entity = Product::new(ProductProps {
            title: "original".to_string(),
            price: 42,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                id: entity_id,
                title: "updated".to_string(),
                price: 42,
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().title, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_product_does_not_exist() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                id: ProductId::generate(),
                title: "new".to_string(),
                price: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            title: "original".to_string(),
            price: 42,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                id: entity_id,
                title: "".to_string(),
                price: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.title_empty"
        );
    }
}

=== business/src/domain/product/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ProductError {
    #[error("product.validation_error.{0}")]
    ValidationError(String),
    #[error("product.not_found")]
    NotFound,
    #[error("product.duplicate")]
    Duplicate,
    #[error("product.repository_error")]
    RepositoryError,
    #[error("product.unknown")]
    Unknown,
}

impl From<RepositoryError> for ProductError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = ProductError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "product.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = ProductError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "product.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = ProductError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "product.repository_error");
    }
}

=== business/src/domain/product/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::ProductError;

/// The id of every `Product`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ProductId(Uuid);

impl ProductId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for ProductId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct ProductProps {
    pub title: String,
    pub price: i64,
}

#[derive(Debug, Clone)]
pub struct Product {
    pub id: ProductId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub price: i64,
}

impl Product {
    pub fn new(props: ProductProps) -> Result<Self, ProductError> {
        if props.title.trim().is_empty() {
            return Err(ProductError::ValidationError("title_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: ProductId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            price: props.price,
        })
    }

    pub fn from_repository(data: Product) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_product_when_fields_are_valid() {
        let result = Product::new(ProductProps {
            title: "example".to_string(),
            price: 42,
        });
        assert_eq!(result.unwrap().title, "example");
    }

    #[test]
    fn should_reject_product_when_title_is_empty() {
        let result = Product::new(ProductProps {
            title: "".into(),
            price: 42,
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_product_when_title_is_only_whitespace() {
        let result = Product::new(ProductProps {
            title: "   ".into(),
            price: 42,
        });
        assert!(result.is_err());
    }
}

