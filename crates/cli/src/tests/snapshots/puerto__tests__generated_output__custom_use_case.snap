export interface Product {
  id: string;
  title: string;
  price: number;
}

/** What a create or an update sends: a product without its id. */
export type ProductDraft = Omit<Product, "id">;

=== web/src/domain/product/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Product, ProductDraft } from "./model";

/** The port the screens call. Every method rejects with the `ProductError` the API answered. */
export interface ProductRepository {
  list(page: PageRequest): Promise<Page<Product>>;
  get(id: string): Promise<Product>;
  create(draft: ProductDraft): Promise<Product>;
  update(id: string, draft: ProductDraft): Promise<Product>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/product/product-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { ProductError } from "../../domain/product/errors";
import { ProductMother } from "../../test-support/product";
import { createApiClient } from "../http/client";
import { productRepositoryHttp } from "./product-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: productRepositoryHttp(api), requests };
}

describe("productRepositoryHttp", () => {
  test("should ask for the page and return its products", async () => {
    // Arrange
    const product = ProductMother.random();
    const page = { items: [product], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/products?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating a product", async () => {
    // Arrange
    const draft = ProductMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the product does not exist", async () => {
    // Arrange
    const code = "product.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(ProductError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the product", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/products/42");
  });
});

=== web/src/infrastructure/product/product-repository-http.ts ===
import { ProductError } from "../../domain/product/errors";
import type { Product, ProductDraft } from "../../domain/product/model";
import type { ProductRepository } from "../../domain/product/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ProductDto = components["schemas"]["ProductDto"];
type ProductRequest = components["schemas"]["CreateProductRequest"];

function toProduct(dto: ProductDto): Product {
  return {
    id: dto.id,
    title: dto.title,
    price: dto.price,
  };
}

function toRequest(draft: ProductDraft): ProductRequest {
  return {
    title: draft.title,
    price: draft.price,
  };
}

/** `ProductRepository` over the REST API (`/products`). */
export function productRepositoryHttp(api: ApiClient): ProductRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/products", {
        params: { query: page },
      });
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toProduct) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/products/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return toProduct(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/products", { body: toRequest(draft) });
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return toProduct(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/products/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ProductError(apiErrorCode(error, response));
      return toProduct(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/products/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ProductError(apiErrorCode(error, response));
    },
  };
}

