use async_trait::async_trait;
use dominio_order_item::errores::OrderItemError;
use dominio_order_item::modelo::OrderItem;
use dominio_order_item::repositorio::OrderItemRepositoryTrait;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ListOrderItemsParams {
    pub page: PeticionPagina,
}

#[async_trait]
pub trait ListOrderItemsUseCaseTrait: Send + Sync {
    async fn execute(
        &self,
        params: ListOrderItemsParams,
    ) -> Result<Pagina<OrderItem>, OrderItemError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListOrderItemsUseCase {}

        #[async_trait]
        impl ListOrderItemsUseCaseTrait for ListOrderItemsUseCase {
            async fn execute(&self, params: ListOrderItemsParams) -> Result<Pagina<OrderItem>, OrderItemError>;
        }
    }
}

pub struct ListOrderItemsUseCaseImpl {
    pub repository: Arc<dyn OrderItemRepositoryTrait>,
}

#[async_trait]
impl ListOrderItemsUseCaseTrait for ListOrderItemsUseCaseImpl {
    async fn execute(
        &self,
        params: ListOrderItemsParams,
    ) -> Result<Pagina<OrderItem>, OrderItemError> {
        tracing::info!(
            limit = params.page.limite(),
            offset = params.page.desplazamiento(),
            "list_order_items: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_order_items: repository failed"))
            .map_err(OrderItemError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_order_item::valores::Sku;
    use dominio_order_item::{
        modelo::{OrderItem, OrderItemProps},
        repositorio::mocks::MockOrderItemRepository,
    };
    use puerto_nucleo::PeticionPagina;
    use uuid::Uuid;

    #[tokio::test]
    async fn should_return_the_page_of_order_items() {
        let entities = vec![
            OrderItem::new(OrderItemProps {
                title: "first".to_string(),
                quantity: 42,
                rate: 1.5,
                in_stock: true,
                ref_id: Uuid::new_v4(),
                sku: Sku::new("first".to_string()).expect("valid Sku"),
            })
            .unwrap(),
            OrderItem::new(OrderItemProps {
                title: "second".to_string(),
                quantity: 42,
                rate: 1.5,
                in_stock: true,
                ref_id: Uuid::new_v4(),
                sku: Sku::new("second".to_string()).expect("valid Sku"),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockOrderItemRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Pagina::new(entities.clone(), 2, page)));
        let use_case = ListOrderItemsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrderItemsParams {
                page: PeticionPagina::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.elementos.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_order_items_exist() {
        let mut mock_repo = MockOrderItemRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Pagina::new(vec![], 0, page)));
        let use_case = ListOrderItemsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrderItemsParams {
                page: PeticionPagina::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.elementos.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockOrderItemRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limite() == 5 && page.desplazamiento() == 10)
            .returning(|page| Ok(Pagina::new(vec![], 0, page)));
        let use_case = ListOrderItemsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrderItemsParams {
                page: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().desplazamiento, 10);
    }
}

