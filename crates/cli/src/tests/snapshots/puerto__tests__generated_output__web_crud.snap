=== presentation/src/api/order_item/error_mapper.rs ===
use business::domain::order_item::errors::OrderItemError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::ErrorResponse;

use crate::api::error::IntoErrorResponse;

impl IntoErrorResponse for OrderItemError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            OrderItemError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            OrderItemError::NotFound => StatusCode::NOT_FOUND,
            OrderItemError::Duplicate => StatusCode::CONFLICT,
            OrderItemError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            OrderItemError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            OrderItemError::InvalidSku => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            OrderItemError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "order_item.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = OrderItemError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "order_item.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = OrderItemError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "order_item.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = OrderItemError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "order_item.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = OrderItemError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "order_item.unknown");
    }

    #[test]
    fn should_map_invalid_sku_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = OrderItemError::InvalidSku.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "order_item.invalid_sku");
    }
}

=== presentation/src/api/order_item/responses.rs ===
// A success variant carries the whole DTO, so it outgrows the error variants as the entity gains
// fields. A response is built once per request and returned: boxing the DTO would only add an
// allocation.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::ErrorResponse;

use crate::api::order_item::dto::{OrderItemDto, OrderItemPageDto};

#[derive(ApiResponse)]
pub enum CreateOrderItemResponse {
    #[oai(status = 201)]
    Created(Json<OrderItemDto>),
    #[oai(status = 422)]
    UnprocessableEntity(Json<ErrorResponse>),
    #[oai(status = 401)]
    Unauthorized(Json<ErrorResponse>),
    #[oai(status = 403)]
    Forbidden(Json<ErrorResponse>),
    #[oai(status = 409)]
    Conflict(Json<ErrorResponse>),
    #[oai(status = 500)]
    InternalError(Json<ErrorResponse>),
}

impl CreateOrderItemResponse {
    pub fn from_status(status: StatusCode, error: Json<ErrorResponse>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::UnprocessableEntity(error),
            StatusCode::UNAUTHORIZED => Self::Unauthorized(error),
            StatusCode::FORBIDDEN => Self::Forbidden(error),
            StatusCode::CONFLICT => Self::Conflict(error),
            _ => Self::InternalError(error),
        }
    }
}

