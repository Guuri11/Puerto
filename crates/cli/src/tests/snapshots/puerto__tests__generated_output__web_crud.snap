}

/// One page of OrderItems: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct OrderItemPageDto {
    pub items: Vec<OrderItemDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl OrderItemPageDto {
    pub fn from_domain(page: &Page<OrderItem>) -> Self {
        Self {
            items: page.items.iter().map(OrderItemDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

