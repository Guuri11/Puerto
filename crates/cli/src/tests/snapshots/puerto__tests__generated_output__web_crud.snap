use super::errors::OrderItemError;

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    value: String,
}

impl Sku {
    pub fn new(value: String) -> Result<Self, OrderItemError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(OrderItemError::InvalidSku);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

