use std::sync::Arc;

use crate::domain::order_item::value_objects::Sku;
use async_trait::async_trait;

use crate::domain::order_item::{
    errors::OrderItemError,
    model::OrderItem,
    repository::OrderItemRepositoryTrait,
    use_cases::update_order_item::{UpdateOrderItemParams, UpdateOrderItemUseCaseTrait},
};

pub struct UpdateOrderItemUseCaseImpl {
    pub repository: Arc<dyn OrderItemRepositoryTrait>,
}

#[async_trait]
impl UpdateOrderItemUseCaseTrait for UpdateOrderItemUseCaseImpl {
    async fn execute(&self, params: UpdateOrderItemParams) -> Result<OrderItem, OrderItemError> {
        tracing::info!(id = %params.id, "update_order_item: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_order_item: repository failed"))?
            .ok_or_else(|| {
                let err = OrderItemError::NotFound;
                tracing::warn!(error = %err, "update_order_item: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = OrderItemError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_order_item: rejected");
            return Err(err);
        }
        let sku = Sku::new(params.sku)?;
        entity.title = params.title;
        entity.quantity = params.quantity;
        entity.rate = params.rate;
        entity.in_stock = params.in_stock;
        entity.ref_id = params.ref_id;
        entity.sku = sku;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_order_item: repository failed"))?;
        Ok(entity)
    }
}

