use std::sync::Arc;

use business::domain::order_item::model::OrderItemId;
use business::domain::order_item::use_cases::{
    create_order_item::{CreateOrderItemParams, CreateOrderItemUseCaseTrait},
    delete_order_item::{DeleteOrderItemParams, DeleteOrderItemUseCaseTrait},
    get_order_item::{GetOrderItemParams, GetOrderItemUseCaseTrait},
    list_order_items::{ListOrderItemsParams, ListOrderItemsUseCaseTrait},
    update_order_item::{UpdateOrderItemParams, UpdateOrderItemUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::order_item::dto::{
    CreateOrderItemRequest, OrderItemDto, OrderItemPageDto, UpdateOrderItemRequest,
};
use crate::api::order_item::responses::{
    CreateOrderItemResponse, DeleteOrderItemResponse, GetOrderItemResponse, ListOrderItemsResponse,
    UpdateOrderItemResponse,
};
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct OrderItemApi {
    pub create_order_item: Arc<dyn CreateOrderItemUseCaseTrait>,
    pub get_order_item: Arc<dyn GetOrderItemUseCaseTrait>,
    pub list_order_items: Arc<dyn ListOrderItemsUseCaseTrait>,
    pub update_order_item: Arc<dyn UpdateOrderItemUseCaseTrait>,
    pub delete_order_item: Arc<dyn DeleteOrderItemUseCaseTrait>,
}

#[OpenApi]
impl OrderItemApi {
    /// Create a new OrderItem
    #[oai(path = "/order_items", method = "post", tag = "ApiTags::OrderItem")]
    async fn create(&self, body: Json<CreateOrderItemRequest>) -> CreateOrderItemResponse {
        match self
            .create_order_item
            .execute(CreateOrderItemParams {
                title: body.title.clone(),
                quantity: body.quantity,
                rate: body.rate,
                in_stock: body.in_stock,
                ref_id: body.ref_id,
                sku: body.sku.clone(),
            })
            .await
        {
            Ok(entity) => {
                CreateOrderItemResponse::Created(Json(OrderItemDto::from_domain(&entity)))
            }
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_order_item failed");
                CreateOrderItemResponse::from_status(status, error)
            }
        }
    }

    /// Get a OrderItem by ID
    #[oai(path = "/order_items/:id", method = "get", tag = "ApiTags::OrderItem")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetOrderItemResponse {
        match self
            .get_order_item
            .execute(GetOrderItemParams {
                id: OrderItemId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetOrderItemResponse::Ok(Json(OrderItemDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_order_item failed");
                GetOrderItemResponse::from_status(status, error)
            }
        }
    }

    /// List OrderItems, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/order_items", method = "get", tag = "ApiTags::OrderItem")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
    ) -> ListOrderItemsResponse {
        match self
            .list_order_items
            .execute(ListOrderItemsParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListOrderItemsResponse::Ok(Json(OrderItemPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_order_items failed");
                ListOrderItemsResponse::from_status(status, error)
            }
        }
    }

    /// Update a OrderItem
    #[oai(path = "/order_items/:id", method = "put", tag = "ApiTags::OrderItem")]
    async fn update(
        &self,
        id: Path<Uuid>,
        body: Json<UpdateOrderItemRequest>,
    ) -> UpdateOrderItemResponse {
        match self
            .update_order_item
            .execute(UpdateOrderItemParams {
                id: OrderItemId::from_uuid(id.0),
                title: body.title.clone(),
                quantity: body.quantity,
                rate: body.rate,
                in_stock: body.in_stock,
                ref_id: body.ref_id,
                sku: body.sku.clone(),
            })
            .await
        {
            Ok(entity) => UpdateOrderItemResponse::Ok(Json(OrderItemDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_order_item failed");
                UpdateOrderItemResponse::from_status(status, error)
            }
        }
    }

    /// Delete a OrderItem
    #[oai(
        path = "/order_items/:id",
        method = "delete",
        tag = "ApiTags::OrderItem"
    )]
    async fn delete(&self, id: Path<Uuid>) -> DeleteOrderItemResponse {
        match self
            .delete_order_item
            .execute(DeleteOrderItemParams {
                id: OrderItemId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteOrderItemResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_order_item failed");
                DeleteOrderItemResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::order_item::errors::OrderItemError;
    use business::domain::order_item::use_cases::{
        create_order_item::mocks::MockCreateOrderItemUseCase,
        delete_order_item::mocks::MockDeleteOrderItemUseCase,
        get_order_item::mocks::MockGetOrderItemUseCase,
        list_order_items::mocks::MockListOrderItemsUseCase,
        update_order_item::mocks::MockUpdateOrderItemUseCase,
    };
    use business::tests::mothers::order_item_mother::OrderItemMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateOrderItemUseCase,
        get: MockGetOrderItemUseCase,
        list: MockListOrderItemsUseCase,
        update: MockUpdateOrderItemUseCase,
        delete: MockDeleteOrderItemUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = OrderItemApi {
                create_order_item: Arc::new(self.create),
                get_order_item: Arc::new(self.get),
                list_order_items: Arc::new(self.list),
                update_order_item: Arc::new(self.update),
                delete_order_item: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateOrderItemRequest {
        CreateOrderItemRequest {
            title: "example".to_string(),
            quantity: 42,
            rate: 1.5,
            in_stock: true,
            ref_id: Uuid::new_v4(),
            sku: "example".to_string(),
        }
    }

    fn update_request() -> UpdateOrderItemRequest {
        UpdateOrderItemRequest {
            title: "example".to_string(),
            quantity: 42,
            rate: 1.5,
            in_stock: true,
            ref_id: Uuid::new_v4(),
            sku: "example".to_string(),
        }
    }

    fn item_path() -> String {
        format!("/order_items/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_order_item_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(OrderItemMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/order_items")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_order_item_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(OrderItemError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/order_items")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_order_item_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(OrderItemMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_order_item_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(OrderItemError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_order_items_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(OrderItemMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/order_items").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks
            .client()
            .get("/order_items?limit=5&offset=10")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(OrderItemError::RepositoryError));

        // Act
        let response = mocks.client().get("/order_items").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_order_item_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(OrderItemMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_order_item() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(OrderItemError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_order_item_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_order_item() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(OrderItemError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

