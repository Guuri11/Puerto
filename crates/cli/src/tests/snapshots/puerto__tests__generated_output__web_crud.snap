use async_trait::async_trait;
use dominio_order_item::errores::OrderItemError;
use dominio_order_item::modelo::{OrderItem, OrderItemId};
use dominio_order_item::repositorio::OrderItemRepositoryTrait;
use dominio_order_item::valores::Sku;
use std::sync::Arc;
use uuid::Uuid;

#[derive(Debug, Clone)]
pub struct UpdateOrderItemParams {
    pub id: OrderItemId,
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: String,
}

#[async_trait]
pub trait UpdateOrderItemUseCaseTrait: Send + Sync {
    async fn execute(&self, params: UpdateOrderItemParams) -> Result<OrderItem, OrderItemError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub UpdateOrderItemUseCase {}

        #[async_trait]
        impl UpdateOrderItemUseCaseTrait for UpdateOrderItemUseCase {
            async fn execute(&self, params: UpdateOrderItemParams) -> Result<OrderItem, OrderItemError>;
        }
    }
}

pub struct UpdateOrderItemUseCaseImpl {
    pub repository: Arc<dyn OrderItemRepositoryTrait>,
}

#[async_trait]
impl UpdateOrderItemUseCaseTrait for UpdateOrderItemUseCaseImpl {
    async fn execute(&self, params: UpdateOrderItemParams) -> Result<OrderItem, OrderItemError> {
        tracing::info!(id = %params.id, "update_order_item: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_order_item: repository failed"))?
            .ok_or_else(|| {
                let err = OrderItemError::NotFound;
                tracing::warn!(error = %err, "update_order_item: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = OrderItemError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_order_item: rejected");
            return Err(err);
        }
        let sku = Sku::new(params.sku)?;
        entity.title = params.title;
        entity.quantity = params.quantity;
        entity.rate = params.rate;
        entity.in_stock = params.in_stock;
        entity.ref_id = params.ref_id;
        entity.sku = sku;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_order_item: repository failed"))?;
        Ok(entity)
    }
}

