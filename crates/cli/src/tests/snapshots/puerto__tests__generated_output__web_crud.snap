=== web/src/presentation/features/order-item/views/order-item-form-view.tsx ===
import type { OrderItemProblem } from "../../../../domain/order-item/messages";
import type { OrderItem, OrderItemDraft } from "../../../../domain/order-item/model";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface OrderItemFormValues {
  title: string;
  quantity: string;
  rate: string;
  inStock: boolean;
  refId: string;
  sku: string;
}

/** The inputs for `orderItem`, empty when there is none yet. */
export function toOrderItemForm(orderItem: OrderItem | null): OrderItemFormValues {
  if (orderItem === null) {
    return {
      title: "",
      quantity: "",
      rate: "",
      inStock: false,
      refId: "",
      sku: "",
    };
  }
  return {
    title: orderItem.title,
    quantity: String(orderItem.quantity),
    rate: String(orderItem.rate),
    inStock: orderItem.inStock,
    refId: orderItem.refId,
    sku: orderItem.sku,
  };
}

export function toOrderItemDraft(values: OrderItemFormValues): OrderItemDraft {
  return {
    title: values.title,
    quantity: Number(values.quantity),
    rate: Number(values.rate),
    inStock: values.inStock,
    refId: values.refId,
    sku: values.sku,
  };
}

export function OrderItemFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: OrderItemFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: OrderItemProblem | null;
  onChange: (values: OrderItemFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "title"}
          required
          value={values.title}
          onChange={(event) => onChange({ ...values, title: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Quantity</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "quantity"}
          required
          value={values.quantity}
          onChange={(event) => onChange({ ...values, quantity: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="quantity" />
      <label className="fieldset">
        <span className="fieldset-legend">Rate</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "rate"}
          step="any"
          required
          value={values.rate}
          onChange={(event) => onChange({ ...values, rate: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="rate" />
      <label className="label">
        <input
          className="checkbox"
          type="checkbox"
          checked={values.inStock}
          onChange={(event) => onChange({ ...values, inStock: event.target.checked })}
        />
        In stock
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Ref id</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "refId"}
          required
          value={values.refId}
          onChange={(event) => onChange({ ...values, refId: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="refId" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "sku"}
          required
          value={values.sku}
          onChange={(event) => onChange({ ...values, sku: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="sku" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

