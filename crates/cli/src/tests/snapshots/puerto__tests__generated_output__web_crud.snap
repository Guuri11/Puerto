=== web/src/domain/order-item/errors.ts ===
/**
 * A request about an order item that the API refused. `code` is the API's `ErrorResponse.name`:
 * `order_item.not_found`, `order_item.validation_error.<field>_empty`.
 */
export class OrderItemError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "OrderItemError";
    this.code = code;
  }
}

=== web/src/domain/order-item/messages.ts ===
import type { OrderItemDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface OrderItemProblem {
  field: keyof OrderItemDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "order_item.validation_error.title_empty": "Title is required",
  "order_item.invalid_sku": "Sku is not valid",
  "order_item.duplicate": "An order item with these values already exists",
  "order_item.not_found": "This order item no longer exists",
  "order_item.repository_error": "The order item could not be saved, try again later",
  "order_item.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof OrderItemDraft> = {
  "order_item.validation_error.title_empty": "title",
  "order_item.invalid_sku": "sku",
};

export function toProblem(code: string): OrderItemProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

