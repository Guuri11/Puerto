    use_cases::get_order_item::{GetOrderItemParams, GetOrderItemUseCaseTrait},
};

pub struct GetOrderItemUseCaseImpl {
    pub repository: Arc<dyn OrderItemRepositoryTrait>,
}

#[async_trait]
impl GetOrderItemUseCaseTrait for GetOrderItemUseCaseImpl {
    async fn execute(&self, params: GetOrderItemParams) -> Result<OrderItem, OrderItemError> {
        tracing::info!(id = %params.id, "get_order_item: start");
        let result =
            self.repository.find_by_id(params.id).await.inspect_err(
                |e| tracing::error!(error = %e, "get_order_item: repository failed"),
            )?;
        result.ok_or_else(|| {
            let err = OrderItemError::NotFound;
            tracing::warn!(error = %err, "get_order_item: rejected");
            err
        })
    }
}

