}

impl OrderItemDto {
    pub fn from_domain(entity: &OrderItem) -> Self {
        Self {
            id: entity.id.value(),
            title: entity.title.clone(),
            quantity: entity.quantity,
            rate: entity.rate,
            in_stock: entity.in_stock,
            ref_id: entity.ref_id,
            sku: entity.sku.value().to_string(),
        }
    }
}

