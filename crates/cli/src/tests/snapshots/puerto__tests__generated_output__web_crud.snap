import { Link } from "wouter";
import type { OrderItem } from "../../../../domain/order-item/model";

export function OrderItemListView({ orderItems }: { orderItems: OrderItem[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Quantity</th>
            <th>Rate</th>
            <th>In stock</th>
            <th>Ref id</th>
            <th>Sku</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {orderItems.map((orderItem) => (
            <tr key={orderItem.id}>
              <td>{orderItem.title}</td>
              <td>{orderItem.quantity}</td>
              <td>{orderItem.rate}</td>
              <td>{orderItem.inStock ? "Yes" : "No"}</td>
              <td>{orderItem.refId}</td>
              <td>{orderItem.sku}</td>
              <td className="text-right">
                <Link href={`/order_items/${orderItem.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

