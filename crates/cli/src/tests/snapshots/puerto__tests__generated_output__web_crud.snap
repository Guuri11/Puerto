    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: String,
}

impl OrderItemDto {
    pub fn from_domain(entity: &OrderItem) -> Self {
        Self {
            id: entity.id.value(),
            title: entity.title.clone(),
            quantity: entity.quantity,
            rate: entity.rate,
            in_stock: entity.in_stock,
            ref_id: entity.ref_id,
            sku: entity.sku.value().to_string(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateOrderItemRequest {
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: String,
}

/// One page of OrderItems: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct OrderItemPageDto {
    pub items: Vec<OrderItemDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl OrderItemPageDto {
    pub fn from_domain(page: &Pagina<OrderItem>) -> Self {
        Self {
            items: page
                .elementos
                .iter()
                .map(OrderItemDto::from_domain)
                .collect(),
            total: page.total,
            limit: page.limite,
            offset: page.desplazamiento,
        }
    }
}

