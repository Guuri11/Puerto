use crate::domain::order_item::model::OrderItem;
use crate::domain::order_item::model::OrderItemProps;
use crate::domain::order_item::value_objects::Sku;
use uuid::Uuid;

pub struct OrderItemMother {
    title: Option<String>,
    quantity: Option<i64>,
    rate: Option<f64>,
    in_stock: Option<bool>,
    ref_id: Option<Uuid>,
    sku: Option<Sku>,
}

impl OrderItemMother {
    pub fn new() -> Self {
        Self {
            title: None,
            quantity: None,
            rate: None,
            in_stock: None,
            ref_id: None,
            sku: None,
        }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_quantity(mut self, quantity: i64) -> Self {
        self.quantity = Some(quantity);
        self
    }

    pub fn with_rate(mut self, rate: f64) -> Self {
        self.rate = Some(rate);
        self
    }

    pub fn with_in_stock(mut self, in_stock: bool) -> Self {
        self.in_stock = Some(in_stock);
        self
    }

    pub fn with_ref_id(mut self, ref_id: Uuid) -> Self {
        self.ref_id = Some(ref_id);
        self
    }

    pub fn with_sku(mut self, sku: Sku) -> Self {
        self.sku = Some(sku);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn build(self) -> OrderItem {
        OrderItem::new(OrderItemProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            quantity: self.quantity.unwrap_or(42),
            rate: self.rate.unwrap_or(1.5),
            in_stock: self.in_stock.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
        })
        .expect("OrderItemMother: failed to build valid OrderItem")
    }

    pub fn build_props(self) -> OrderItemProps {
        OrderItemProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            quantity: self.quantity.unwrap_or(42),
            rate: self.rate.unwrap_or(1.5),
            in_stock: self.in_stock.unwrap_or(true),
            ref_id: self.ref_id.unwrap_or_else(Uuid::new_v4),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
        }
    }

    pub fn random() -> OrderItem {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<OrderItem> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for OrderItemMother {
    fn default() -> Self {
        Self::new()
    }
}

