=== contextos/order_item/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum OrderItemError {
    #[error("order_item.validation_error.{0}")]
    ValidationError(String),
    #[error("order_item.not_found")]
    NotFound,
    #[error("order_item.duplicate")]
    Duplicate,
    #[error("order_item.repository_error")]
    RepositoryError,
    #[error("order_item.unknown")]
    Unknown,
    #[error("order_item.invalid_sku")]
    InvalidSku,
}

impl From<ErrorRepositorio> for OrderItemError {
    /// Every failure `puerto-nucleo` names has its arm. `ErrorRepositorio` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicate,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => {
                Self::RepositoryError
            }
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = OrderItemError::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "order_item.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = OrderItemError::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "order_item.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = OrderItemError::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "order_item.repository_error");
    }
}

