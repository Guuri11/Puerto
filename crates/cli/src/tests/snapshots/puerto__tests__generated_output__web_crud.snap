import { OrderItemError } from "../domain/order-item/errors";
import type { OrderItem, OrderItemDraft } from "../domain/order-item/model";
import type { OrderItemRepository } from "../domain/order-item/repository";

/** Valid order items for tests; pass `overrides` for the fields a test is about. */
export const OrderItemMother = {
  draft(overrides: Partial<OrderItemDraft> = {}): OrderItemDraft {
    return {
      title: "example",
      quantity: 42,
      rate: 1.5,
      inStock: true,
      refId: crypto.randomUUID(),
      sku: "example",
      ...overrides,
    };
  },

  random(overrides: Partial<OrderItem> = {}): OrderItem {
    return { id: crypto.randomUUID(), ...OrderItemMother.draft(), ...overrides };
  },
};

/** An in-memory `OrderItemRepository`. Override a method to make it fail. */
export function fakeOrderItemRepository(seed: OrderItem[] = []): OrderItemRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new OrderItemError("order_item.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
