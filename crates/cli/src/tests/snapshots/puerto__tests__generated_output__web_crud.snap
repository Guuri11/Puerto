import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakeOrderItemRepository, OrderItemMother } from "../../../../test-support/order-item";
import { renderScreen } from "../../../../test-support/render";
import { OrderItemDetailContainer } from "./order-item-detail-container";

describe("OrderItemDetailContainer", () => {
  test("should show the order item when it exists", async () => {
    // Arrange
    const seeded = OrderItemMother.random();
    const orderItemRepository = fakeOrderItemRepository([seeded]);

    // Act
    renderScreen(<OrderItemDetailContainer id={seeded.id} />, { orderItemRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the order item does not exist", async () => {
    // Arrange
    const orderItemRepository = fakeOrderItemRepository();

    // Act
    renderScreen(<OrderItemDetailContainer id={crypto.randomUUID()} />, { orderItemRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("order_item.not_found");
  });

  test("should delete the order item only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = OrderItemMother.random();
    const fake = fakeOrderItemRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<OrderItemDetailContainer id={seeded.id} />, {
      orderItemRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/order_items"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/order-item/containers/order-item-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { OrderItemDetailView } from "../views/order-item-detail-view";

export function OrderItemDetailContainer({ id }: { id: string }) {
  const { orderItemRepository } = useDependencies();
  const orderItem = useAsync(() => orderItemRepository.get(id), [orderItemRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await orderItemRepository.remove(id);
      navigate("/order_items");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Order item</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {orderItem.status === "loading" && <span className="loading loading-spinner" />}
      {orderItem.status === "error" && <ErrorAlert error={orderItem.error} />}
      {orderItem.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <OrderItemDetailView orderItem={orderItem.data} />
            <div className="card-actions justify-end">
              <Link href={`/order_items/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/order_items" className="link">
        Back to order items
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this order item?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

