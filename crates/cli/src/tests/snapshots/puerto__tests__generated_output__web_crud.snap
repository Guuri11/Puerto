import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { OrderItemError } from "../../../../domain/order-item/errors";
import type { OrderItemDraft } from "../../../../domain/order-item/model";
import { fakeOrderItemRepository, OrderItemMother } from "../../../../test-support/order-item";
import { renderScreen } from "../../../../test-support/render";
import { OrderItemFormContainer } from "./order-item-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: OrderItemDraft) {
  await screen.findByText("Save");
  type("Title", draft.title);
  type("Quantity", String(draft.quantity));
  type("Rate", String(draft.rate));
  if (draft.inStock) fireEvent.click(screen.getByLabelText("In stock"));
  type("Ref id", draft.refId);
  type("Sku", draft.sku);
}

describe("OrderItemFormContainer", () => {
  test("should create the order item from what was typed and show it", async () => {
    // Arrange
    const draft = OrderItemMother.draft();
    const orderItemRepository = fakeOrderItemRepository();
    const { history } = renderScreen(<OrderItemFormContainer />, { orderItemRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/order_items/"));
    const {
      items: [created],
    } = await orderItemRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/order_items/${created?.id}`);
  });

  test("should save the edited order item when an existing one is submitted", async () => {
    // Arrange
    const seeded = OrderItemMother.random();
    const orderItemRepository = fakeOrderItemRepository([seeded]);
    const { history } = renderScreen(<OrderItemFormContainer id={seeded.id} />, {
      orderItemRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/order_items/${seeded.id}`));
    expect(await orderItemRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "order_item.validation_error.invalid";
    const orderItemRepository = {
      ...fakeOrderItemRepository(),
      create: () => Promise.reject(new OrderItemError(code)),
    };
    renderScreen(<OrderItemFormContainer />, { orderItemRepository });
    await fillIn(OrderItemMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a order item with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const orderItemRepository = {
      ...fakeOrderItemRepository(),
      create: () => Promise.reject(new OrderItemError("order_item.duplicate")),
    };
    renderScreen(<OrderItemFormContainer />, { orderItemRepository });
    await fillIn(OrderItemMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An order item with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const orderItemRepository = {
      ...fakeOrderItemRepository(),
      create: () => Promise.reject(new OrderItemError("order_item.validation_error.title_empty")),
    };
    renderScreen(<OrderItemFormContainer />, { orderItemRepository });
    await fillIn(OrderItemMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Title is required")).toBeTruthy();
    const input = screen.getByLabelText("Title");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/order-item/containers/order-item-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/order-item/messages";
import type { OrderItem } from "../../../../domain/order-item/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import {
  OrderItemFormView,
  toOrderItemDraft,
  toOrderItemForm,
} from "../views/order-item-form-view";

/** Creates an order item, or edits the one with `id`. */
export function OrderItemFormContainer({ id }: { id?: string }) {
  const { orderItemRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : orderItemRepository.get(id)),
    [orderItemRepository, id],
  );
  const title = id === undefined ? "New order item" : "Edit order item";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <OrderItemForm existing={existing.data} />}
      <Link href={id === undefined ? "/order_items" : `/order_items/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function OrderItemForm({ existing }: { existing: OrderItem | null }) {
  const { orderItemRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toOrderItemForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toOrderItemDraft(values);
      const saved =
        existing === null
          ? await orderItemRepository.create(draft)
          : await orderItemRepository.update(existing.id, draft);
      navigate(`/order_items/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <OrderItemFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

