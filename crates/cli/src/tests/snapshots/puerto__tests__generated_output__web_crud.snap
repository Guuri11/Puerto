=== business/src/domain/order_item/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum OrderItemError {
    #[error("order_item.validation_error.{0}")]
    ValidationError(String),
    #[error("order_item.not_found")]
    NotFound,
    #[error("order_item.duplicate")]
    Duplicate,
    #[error("order_item.repository_error")]
    RepositoryError,
    #[error("order_item.unknown")]
    Unknown,
    #[error("order_item.invalid_sku")]
    InvalidSku,
}

impl From<RepositoryError> for OrderItemError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = OrderItemError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "order_item.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = OrderItemError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "order_item.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = OrderItemError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "order_item.repository_error");
    }
}

=== business/src/domain/order_item/model.rs ===
use super::value_objects::Sku;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::OrderItemError;

/// The id of every `OrderItem`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct OrderItemId(Uuid);

impl OrderItemId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for OrderItemId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct OrderItemProps {
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: Sku,
}

#[derive(Debug, Clone)]
pub struct OrderItem {
    pub id: OrderItemId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub quantity: i64,
    pub rate: f64,
    pub in_stock: bool,
    pub ref_id: Uuid,
    pub sku: Sku,
}

impl OrderItem {
    pub fn new(props: OrderItemProps) -> Result<Self, OrderItemError> {
        if props.title.trim().is_empty() {
            return Err(OrderItemError::ValidationError("title_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: OrderItemId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            quantity: props.quantity,
            rate: props.rate,
            in_stock: props.in_stock,
            ref_id: props.ref_id,
            sku: props.sku,
        })
    }

    pub fn from_repository(data: OrderItem) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_order_item_when_fields_are_valid() {
        let result = OrderItem::new(OrderItemProps {
            title: "example".to_string(),
            quantity: 42,
            rate: 1.5,
            in_stock: true,
            ref_id: Uuid::new_v4(),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
        });
        assert_eq!(result.unwrap().title, "example");
    }

    #[test]
    fn should_reject_order_item_when_title_is_empty() {
        let result = OrderItem::new(OrderItemProps {
            title: "".into(),
            quantity: 42,
            rate: 1.5,
            in_stock: true,
            ref_id: Uuid::new_v4(),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "order_item.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_order_item_when_title_is_only_whitespace() {
        let result = OrderItem::new(OrderItemProps {
            title: "   ".into(),
            quantity: 42,
            rate: 1.5,
            in_stock: true,
            ref_id: Uuid::new_v4(),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_order_item_when_sku_is_empty() {
        let result = Sku::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "order_item.invalid_sku");
    }
}

