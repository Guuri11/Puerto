use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::order_item::{
    errors::OrderItemError,
    repository::OrderItemRepositoryTrait,
    use_cases::delete_order_item::{DeleteOrderItemParams, DeleteOrderItemUseCaseTrait},
};

pub struct DeleteOrderItemUseCaseImpl {
    pub repository: Arc<dyn OrderItemRepositoryTrait>,
}

#[async_trait]
impl DeleteOrderItemUseCaseTrait for DeleteOrderItemUseCaseImpl {
    async fn execute(&self, params: DeleteOrderItemParams) -> Result<(), OrderItemError> {
        tracing::info!(id = %params.id, "delete_order_item: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_order_item: repository failed"))?
            .ok_or_else(|| {
                let err = OrderItemError::NotFound;
                tracing::warn!(error = %err, "delete_order_item: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_order_item: repository failed"))?;
        Ok(())
    }
}

