use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::order_item::{
    errors::OrderItemError,
    model::OrderItem,
    repository::OrderItemRepositoryTrait,
    use_cases::list_order_items::{ListOrderItemsParams, ListOrderItemsUseCaseTrait},
};

pub struct ListOrderItemsUseCaseImpl {
    pub repository: Arc<dyn OrderItemRepositoryTrait>,
}

#[async_trait]
impl ListOrderItemsUseCaseTrait for ListOrderItemsUseCaseImpl {
    async fn execute(
        &self,
        params: ListOrderItemsParams,
    ) -> Result<Page<OrderItem>, OrderItemError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_order_items: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_order_items: repository failed"))
            .map_err(OrderItemError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::order_item::value_objects::Sku;
    use crate::domain::order_item::{
        model::{OrderItem, OrderItemProps},
        repository::mocks::MockOrderItemRepository,
    };
    use puerto_core::PageRequest;
    use uuid::Uuid;

    #[tokio::test]
    async fn should_return_the_page_of_order_items() {
        let entities = vec![
            OrderItem::new(OrderItemProps {
                title: "first".to_string(),
                quantity: 42,
                rate: 1.5,
                in_stock: true,
                ref_id: Uuid::new_v4(),
                sku: Sku::new("first".to_string()).expect("valid Sku"),
            })
            .unwrap(),
            OrderItem::new(OrderItemProps {
                title: "second".to_string(),
                quantity: 42,
                rate: 1.5,
                in_stock: true,
                ref_id: Uuid::new_v4(),
                sku: Sku::new("second".to_string()).expect("valid Sku"),
            })
            .unwrap(),
        ];
        let mut mock_repo = MockOrderItemRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListOrderItemsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrderItemsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_order_items_exist() {
        let mut mock_repo = MockOrderItemRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListOrderItemsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrderItemsParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockOrderItemRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListOrderItemsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrderItemsParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

