import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { OrderItemError } from "../../../../domain/order-item/errors";
import { fakeOrderItemRepository, OrderItemMother } from "../../../../test-support/order-item";
import { renderScreen } from "../../../../test-support/render";
import { OrderItemListContainer } from "./order-item-list-container";

describe("OrderItemListContainer", () => {
  test("should show a row per order item when there are some", async () => {
    // Arrange
    const seed = [OrderItemMother.random(), OrderItemMother.random()];
    const orderItemRepository = fakeOrderItemRepository(seed);

    // Act
    renderScreen(<OrderItemListContainer />, { orderItemRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => OrderItemMother.random());
    const orderItemRepository = fakeOrderItemRepository(seed);
    renderScreen(<OrderItemListContainer />, { orderItemRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => OrderItemMother.random());
    const orderItemRepository = fakeOrderItemRepository(seed);
    const path = "/order_items?page=2";

    // Act
    renderScreen(<OrderItemListContainer />, { orderItemRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no order item", async () => {
    // Arrange
    const orderItemRepository = fakeOrderItemRepository();

    // Act
    renderScreen(<OrderItemListContainer />, { orderItemRepository });

    // Assert
    expect(await screen.findByText("No order items yet.")).toBeTruthy();
  });

  test("should show the error code when the order items cannot be listed", async () => {
    // Arrange
    const orderItemRepository = {
      ...fakeOrderItemRepository(),
      list: () => Promise.reject(new OrderItemError("order_item.repository_error")),
    };

    // Act
    renderScreen(<OrderItemListContainer />, { orderItemRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("order_item.repository_error");
  });
});

=== web/src/presentation/features/order-item/containers/order-item-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { OrderItemListView } from "../views/order-item-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function OrderItemListContainer() {
  const { orderItemRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const orderItems = useAsync(
    () => orderItemRepository.list({ limit: PAGE_SIZE, offset }),
    [orderItemRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Order items</h1>
        <Link href="/order_items/new" className="btn btn-primary">
          New order item
        </Link>
      </div>
      {orderItems.status === "loading" && <span className="loading loading-spinner" />}
      {orderItems.status === "error" && <ErrorAlert error={orderItems.error} />}
      {orderItems.status === "ok" &&
        (orderItems.data.total === 0 ? (
          <EmptyState message="No order items yet." />
        ) : (
          <>
            <OrderItemListView orderItems={orderItems.data.items} />
            <Pagination {...orderItems.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

