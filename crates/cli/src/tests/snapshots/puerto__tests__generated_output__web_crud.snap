        // Arrange
        let mut mock_repo = MockOrderItemRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateOrderItemUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateOrderItemParams {
                title: "example".to_string(),
                quantity: 42,
                rate: 1.5,
                in_stock: true,
                ref_id: Uuid::new_v4(),
                sku: "example".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
