import { useState } from "react";
import { Link } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { Pagination } from "../../../shared/ui/pagination";
import { OrderItemListView } from "../views/order-item-list-view";

export function OrderItemListContainer() {
  const { orderItemRepository } = useDependencies();
  const [offset, setOffset] = useState(0);
  const orderItems = useAsync(
    () => orderItemRepository.list({ limit: PAGE_SIZE, offset }),
    [orderItemRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Order items</h1>
        <Link href="/order_items/new" className="btn btn-primary">
          New order item
        </Link>
      </div>
      {orderItems.status === "loading" && <span className="loading loading-spinner" />}
      {orderItems.status === "error" && <ErrorAlert error={orderItems.error} />}
      {orderItems.status === "ok" &&
        (orderItems.data.total === 0 ? (
          <EmptyState message="No order items yet." />
        ) : (
          <>
            <OrderItemListView orderItems={orderItems.data.items} />
            <Pagination {...orderItems.data} onOffsetChange={setOffset} />
          </>
        ))}
    </section>
  );
}

