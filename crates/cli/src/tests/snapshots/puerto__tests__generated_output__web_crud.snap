}

/** What a create or an update sends: an order item without its id. */
export type OrderItemDraft = Omit<OrderItem, "id">;

=== web/src/domain/order-item/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { OrderItem, OrderItemDraft } from "./model";

/** The port the screens call. Every method rejects with the `OrderItemError` the API answered. */
export interface OrderItemRepository {
  list(page: PageRequest): Promise<Page<OrderItem>>;
  get(id: string): Promise<OrderItem>;
  create(draft: OrderItemDraft): Promise<OrderItem>;
  update(id: string, draft: OrderItemDraft): Promise<OrderItem>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/order-item/order-item-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { OrderItemError } from "../../domain/order-item/errors";
import { OrderItemMother } from "../../test-support/order-item";
import { createApiClient } from "../http/client";
import { orderItemRepositoryHttp } from "./order-item-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: orderItemRepositoryHttp(api), requests };
}

describe("orderItemRepositoryHttp", () => {
  test("should ask for the page and return its order items", async () => {
    // Arrange
    const orderItem = OrderItemMother.random();
    const page = { items: [orderItem], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/order_items?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating an order item", async () => {
    // Arrange
    const draft = OrderItemMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the order item does not exist", async () => {
    // Arrange
    const code = "order_item.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(OrderItemError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the order item", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/order_items/42");
  });
});

=== web/src/infrastructure/order-item/order-item-repository-http.ts ===
import { OrderItemError } from "../../domain/order-item/errors";
import type { OrderItem, OrderItemDraft } from "../../domain/order-item/model";
import type { OrderItemRepository } from "../../domain/order-item/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type OrderItemDto = components["schemas"]["OrderItemDto"];
type OrderItemRequest = components["schemas"]["CreateOrderItemRequest"];

function toOrderItem(dto: OrderItemDto): OrderItem {
  return {
    id: dto.id,
    title: dto.title,
    quantity: dto.quantity,
    rate: dto.rate,
    inStock: dto.inStock,
    refId: dto.refId,
    sku: dto.sku,
  };
}

function toRequest(draft: OrderItemDraft): OrderItemRequest {
  return {
    title: draft.title,
    quantity: draft.quantity,
    rate: draft.rate,
    inStock: draft.inStock,
    refId: draft.refId,
    sku: draft.sku,
  };
}

/** `OrderItemRepository` over the REST API (`/order_items`). */
export function orderItemRepositoryHttp(api: ApiClient): OrderItemRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/order_items", {
        params: { query: page },
      });
      if (data === undefined) throw new OrderItemError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toOrderItem) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/order_items/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new OrderItemError(apiErrorCode(error, response));
      return toOrderItem(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/order_items", { body: toRequest(draft) });
      if (data === undefined) throw new OrderItemError(apiErrorCode(error, response));
      return toOrderItem(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/order_items/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new OrderItemError(apiErrorCode(error, response));
      return toOrderItem(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/order_items/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new OrderItemError(apiErrorCode(error, response));
    },
  };
}

