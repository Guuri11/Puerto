=== contextos/order_item/rest/src/errores.rs ===
use dominio_order_item::errores::OrderItemError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// A order_item error as its HTTP status and body (ADR-0007 of Puerto): validation failures and
/// invalid value objects are 422 — the request was well-formed (poem answers 400 for one that is
/// not) but breaks a domain rule. Exhaustive on purpose: a new error variant does not compile
/// until it has a status.
pub fn a_respuesta_error(err: OrderItemError) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        OrderItemError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
        OrderItemError::NotFound => StatusCode::NOT_FOUND,
        OrderItemError::Duplicate => StatusCode::CONFLICT,
        OrderItemError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
        OrderItemError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
        OrderItemError::InvalidSku => StatusCode::UNPROCESSABLE_ENTITY,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            a_respuesta_error(OrderItemError::ValidationError("name_empty".into()));

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.codigo, "order_item.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderItemError::NotFound);

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.codigo, "order_item.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderItemError::Duplicate);

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.codigo, "order_item.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderItemError::RepositoryError);

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.codigo, "order_item.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderItemError::Unknown);

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.codigo, "order_item.unknown");
    }

    #[test]
    fn should_map_invalid_sku_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderItemError::InvalidSku);

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.codigo, "order_item.invalid_sku");
    }
}

