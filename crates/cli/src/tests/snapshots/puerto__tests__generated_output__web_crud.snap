use std::sync::Arc;

use crate::domain::order_item::value_objects::Sku;
use async_trait::async_trait;

use crate::domain::order_item::{
    errors::OrderItemError,
    model::{OrderItem, OrderItemProps},
    repository::OrderItemRepositoryTrait,
    use_cases::create_order_item::{CreateOrderItemParams, CreateOrderItemUseCaseTrait},
};

pub struct CreateOrderItemUseCaseImpl {
    pub repository: Arc<dyn OrderItemRepositoryTrait>,
}

#[async_trait]
impl CreateOrderItemUseCaseTrait for CreateOrderItemUseCaseImpl {
    async fn execute(&self, params: CreateOrderItemParams) -> Result<OrderItem, OrderItemError> {
        tracing::info!("create_order_item: start");
        let sku = Sku::new(params.sku)?;
        let entity = OrderItem::new(OrderItemProps {
            title: params.title,
            quantity: params.quantity,
            rate: params.rate,
            in_stock: params.in_stock,
            ref_id: params.ref_id,
            sku,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_order_item: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_order_item: repository failed"))?;
        tracing::info!(id = %entity.id, "create_order_item: done");
        Ok(entity)
    }
}

