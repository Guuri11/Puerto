//! destinatario. Su texto está en `contextos/correo/infraestructura/plantillas/welcome/`, y lo
//! renderiza `EnviadorCorreoWelcomePlantilla`.

use async_trait::async_trait;
use puerto_nucleo::correo::ErrorCorreo;

/// Lo que dice el correo `welcome`: a quién va y los valores que muestran sus plantillas.
#[derive(Debug, Clone, PartialEq)]
pub struct CorreoWelcome {
    pub para: String,
    pub name: String,
    pub plan: Option<String>,
    pub seats: i64,
}

/// Envía el correo `welcome`. `EnviadorCorreoWelcomePlantilla` (infraestructura) lo
/// renderiza y lo envía; los tests usan `dobles::MockEnviadorCorreoWelcome`.
#[async_trait]
pub trait EnviadorCorreoWelcome: Send + Sync {
    async fn enviar(&self, correo: &CorreoWelcome) -> Result<(), ErrorCorreo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use super::*;
    use mockall::mock;

    mock! {
        pub EnviadorCorreoWelcome {}

        #[async_trait]
        impl EnviadorCorreoWelcome for EnviadorCorreoWelcome {
            async fn enviar(&self, correo: &CorreoWelcome) -> Result<(), ErrorCorreo>;
        }
    }
}

