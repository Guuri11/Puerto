    use super::*;
    use mockall::mock;

    mock! {
        pub WelcomeMailer {}

        #[async_trait]
        impl WelcomeMailer for WelcomeMailer {
            async fn send(&self, mail: &WelcomeMail) -> Result<(), MailError>;
        }
    }
}

