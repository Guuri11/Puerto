=== infrastructure/src/mail/receipt.rs ===
//! Renders the `receipt` mail from its templates and hands it to the mailer. Written once by
//! `puerto generate mail`; it is yours now. The text is in `infrastructure/mail/receipt/`:
//! change it there — the tests below render it again, so a typo fails `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use business::domain::mail::receipt::{ReceiptMail, ReceiptMailer};
use chrono::{DateTime, Utc};
use puerto_mail::{MailError, Mailer, Templates};
use serde::Serialize;
use uuid::Uuid;

const TEMPLATES: Templates = Templates::new(
    include_str!("../../mail/receipt/subject.txt"),
    include_str!("../../mail/receipt/body.html"),
)
.with_text(include_str!("../../mail/receipt/body.txt"));

/// What the templates see: the mail's fields but the recipient, under their own names.
#[derive(Serialize)]
struct Context<'a> {
    order_id: &'a Uuid,
    paid_at: &'a DateTime<Utc>,
    total: &'a f64,
    gift: &'a bool,
    note: &'a Option<String>,
    points: &'a Option<i64>,
    express: &'a Option<bool>,
    discount: &'a Option<f64>,
    shipped_at: &'a Option<DateTime<Utc>>,
}

impl<'a> Context<'a> {
    fn of(mail: &'a ReceiptMail) -> Self {
        Self {
            order_id: &mail.order_id,
            paid_at: &mail.paid_at,
            total: &mail.total,
            gift: &mail.gift,
            note: &mail.note,
            points: &mail.points,
            express: &mail.express,
            discount: &mail.discount,
            shipped_at: &mail.shipped_at,
        }
    }
}

/// The `receipt` mail, rendered from `infrastructure/mail/receipt/` and sent through `mailer`
/// (`puerto_mail::SmtpMailer` where it runs).
pub struct TemplateReceiptMailer {
    mailer: Arc<dyn Mailer>,
}

impl TemplateReceiptMailer {
    pub fn new(mailer: Arc<dyn Mailer>) -> Self {
        Self { mailer }
    }
}

#[async_trait]
impl ReceiptMailer for TemplateReceiptMailer {
    async fn send(&self, mail: &ReceiptMail) -> Result<(), MailError> {
        let email = TEMPLATES.render(mail.to.clone(), Context::of(mail))?;
        self.mailer.send(&email).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_mail::testing::RecordingMailer;

    fn receipt() -> ReceiptMail {
        ReceiptMail {
            to: "ada@example.com".to_string(),
            order_id: Uuid::new_v4(),
            paid_at: Utc::now(),
            total: 1.5,
            gift: true,
            note: Some("example".to_string()),
            points: Some(42),
            express: Some(true),
            discount: Some(1.5),
            shipped_at: Some(Utc::now()),
        }
    }

    #[test]
    fn should_render_every_template_when_the_mail_has_its_fields() {
        // Act
        let email = TEMPLATES.render("ada@example.com", Context::of(&receipt()));

        // Assert
        let email = match email {
            Ok(email) => email,
            Err(err) => panic!("infrastructure/mail/receipt/ does not render: {err}"),
        };
        assert!(!email.subject.is_empty());
        assert!(!email.html.is_empty());
        assert!(email.text.is_some());
    }

    #[tokio::test]
    async fn should_send_the_rendered_mail_to_its_recipient() {
        // Arrange
        let recorder = Arc::new(RecordingMailer::new());
        let mailer = TemplateReceiptMailer::new(recorder.clone());

        // Act
        let result = mailer.send(&receipt()).await;

        // Assert
        assert_eq!(result, Ok(()));
        let sent = recorder.sent();
        assert_eq!(sent.len(), 1);
        assert_eq!(sent[0].to, "ada@example.com");
    }

    #[tokio::test]
    async fn should_return_the_mailer_error_when_sending_fails() {
        // Arrange
        let rejected = MailError::Permanent("550 no such user".to_string());
        let mailer =
            TemplateReceiptMailer::new(Arc::new(RecordingMailer::failing_with(rejected.clone())));

        // Act
        let result = mailer.send(&receipt()).await;

        // Assert
        assert_eq!(result, Err(rejected));
    }
}

=== infrastructure/src/mail/welcome.rs ===
//! Renders the `welcome` mail from its templates and hands it to the mailer. Written once by
//! `puerto generate mail`; it is yours now. The text is in `infrastructure/mail/welcome/`:
//! change it there — the tests below render it again, so a typo fails `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use business::domain::mail::welcome::{WelcomeMail, WelcomeMailer};
use puerto_mail::{MailError, Mailer, Templates};
use serde::Serialize;

const TEMPLATES: Templates = Templates::new(
    include_str!("../../mail/welcome/subject.txt"),
    include_str!("../../mail/welcome/body.html"),
)
.with_text(include_str!("../../mail/welcome/body.txt"));

/// What the templates see: the mail's fields but the recipient, under their own names.
#[derive(Serialize)]
struct Context<'a> {
    name: &'a String,
    plan: &'a Option<String>,
    seats: &'a i64,
}

impl<'a> Context<'a> {
    fn of(mail: &'a WelcomeMail) -> Self {
        Self {
            name: &mail.name,
            plan: &mail.plan,
            seats: &mail.seats,
        }
    }
}

/// The `welcome` mail, rendered from `infrastructure/mail/welcome/` and sent through `mailer`
/// (`puerto_mail::SmtpMailer` where it runs).
pub struct TemplateWelcomeMailer {
    mailer: Arc<dyn Mailer>,
}

impl TemplateWelcomeMailer {
    pub fn new(mailer: Arc<dyn Mailer>) -> Self {
        Self { mailer }
    }
}

#[async_trait]
impl WelcomeMailer for TemplateWelcomeMailer {
    async fn send(&self, mail: &WelcomeMail) -> Result<(), MailError> {
        let email = TEMPLATES.render(mail.to.clone(), Context::of(mail))?;
        self.mailer.send(&email).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_mail::testing::RecordingMailer;

    fn welcome() -> WelcomeMail {
        WelcomeMail {
            to: "ada@example.com".to_string(),
            name: "example".to_string(),
            plan: Some("example".to_string()),
            seats: 42,
        }
    }

    #[test]
    fn should_render_every_template_when_the_mail_has_its_fields() {
        // Act
        let email = TEMPLATES.render("ada@example.com", Context::of(&welcome()));

        // Assert
        let email = match email {
            Ok(email) => email,
            Err(err) => panic!("infrastructure/mail/welcome/ does not render: {err}"),
        };
        assert!(!email.subject.is_empty());
        assert!(!email.html.is_empty());
        assert!(email.text.is_some());
    }

    #[tokio::test]
    async fn should_send_the_rendered_mail_to_its_recipient() {
        // Arrange
        let recorder = Arc::new(RecordingMailer::new());
        let mailer = TemplateWelcomeMailer::new(recorder.clone());

        // Act
        let result = mailer.send(&welcome()).await;

        // Assert
        assert_eq!(result, Ok(()));
        let sent = recorder.sent();
        assert_eq!(sent.len(), 1);
        assert_eq!(sent[0].to, "ada@example.com");
    }

    #[tokio::test]
    async fn should_return_the_mailer_error_when_sending_fails() {
        // Arrange
        let rejected = MailError::Permanent("550 no such user".to_string());
        let mailer =
            TemplateWelcomeMailer::new(Arc::new(RecordingMailer::failing_with(rejected.clone())));

        // Act
        let result = mailer.send(&welcome()).await;

        // Assert
        assert_eq!(result, Err(rejected));
    }
}

=== presentation/src/generated/bootstrap.rs ===
// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;

use business::domain::greeting::repository::GreetingRepositoryTrait;
use infrastructure::greeting::repository::InMemoryGreetingRepository;

use poem::Endpoint;
use poem_openapi::OpenApiService;

use crate::api::greeting::routes::GreetingApi;

/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl {
        repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait>,
    });
    let greeting_api = GreetingApi { get_greeting };

    let ready = puerto_web::health::always_ready();

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::routes(
        openapi_service(greeting_api),
        &config,
        ready,
    )))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

