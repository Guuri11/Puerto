=== contextos/correo/dominio/src/receipt.rs ===
//! El correo `receipt`: lo que lleva y el puerto que lo envía. Lo escribe una vez
//! `puerto generar correo`; desde entonces es tuyo: añade un campo, renombra otro, calcula el
//! destinatario. Su texto está en `contextos/correo/infraestructura/plantillas/receipt/`, y lo
//! renderiza `EnviadorCorreoReceiptPlantilla`.

use async_trait::async_trait;
use chrono::{DateTime, Utc};
use puerto_nucleo::correo::ErrorCorreo;
use uuid::Uuid;

/// Lo que dice el correo `receipt`: a quién va y los valores que muestran sus plantillas.
#[derive(Debug, Clone, PartialEq)]
pub struct CorreoReceipt {
    pub para: String,
    pub pedido_id: Uuid,
    pub paid_at: DateTime<Utc>,
    pub total: f64,
    pub gift: bool,
    pub note: Option<String>,
    pub points: Option<i64>,
    pub express: Option<bool>,
    pub discount: Option<f64>,
    pub shipped_at: Option<DateTime<Utc>>,
}

/// Envía el correo `receipt`. `EnviadorCorreoReceiptPlantilla` (infraestructura) lo
/// renderiza y lo envía; los tests usan `dobles::MockEnviadorCorreoReceipt`.
#[async_trait]
pub trait EnviadorCorreoReceipt: Send + Sync {
    async fn enviar(&self, correo: &CorreoReceipt) -> Result<(), ErrorCorreo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use super::*;
    use mockall::mock;

    mock! {
        pub EnviadorCorreoReceipt {}

        #[async_trait]
        impl EnviadorCorreoReceipt for EnviadorCorreoReceipt {
            async fn enviar(&self, correo: &CorreoReceipt) -> Result<(), ErrorCorreo>;
        }
    }
}

