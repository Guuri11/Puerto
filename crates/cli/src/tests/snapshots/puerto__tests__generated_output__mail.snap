}

/// Sends the `welcome` mail. `TemplateWelcomeMailer` (infrastructure) renders and sends it;
/// tests use `mocks::MockWelcomeMailer`.
#[async_trait]
pub trait WelcomeMailer: Send + Sync {
    async fn send(&self, mail: &WelcomeMail) -> Result<(), MailError>;
}

