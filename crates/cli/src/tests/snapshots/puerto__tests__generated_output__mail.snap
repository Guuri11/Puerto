=== contextos/correo/infraestructura/src/receipt.rs ===
//! Renderiza el correo `receipt` con sus plantillas y se lo pasa al enviador. Lo escribe una
//! vez `puerto generar correo`; desde entonces es tuyo. El texto está en `plantillas/receipt/`:
//! cámbialo allí; los tests de abajo lo vuelven a renderizar, así que una errata hace fallar
//! `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_correo::receipt::{CorreoReceipt, EnviadorCorreoReceipt};
use puerto_correo::{EnviadorCorreo, ErrorCorreo, Plantillas};
use serde::Serialize;
use uuid::Uuid;

const PLANTILLAS: Plantillas = Plantillas::new(
    include_str!("../plantillas/receipt/asunto.txt"),
    include_str!("../plantillas/receipt/cuerpo.html"),
)
.con_texto(include_str!("../plantillas/receipt/cuerpo.txt"));

/// Lo que ven las plantillas: los campos del correo salvo el destinatario, con sus propios nombres.
#[derive(Serialize)]
struct Contexto<'a> {
    pedido_id: &'a Uuid,
    paid_at: &'a DateTime<Utc>,
    total: &'a f64,
    gift: &'a bool,
    note: &'a Option<String>,
    points: &'a Option<i64>,
    express: &'a Option<bool>,
    discount: &'a Option<f64>,
    shipped_at: &'a Option<DateTime<Utc>>,
}

impl<'a> Contexto<'a> {
    fn de(correo: &'a CorreoReceipt) -> Self {
        Self {
            pedido_id: &correo.pedido_id,
            paid_at: &correo.paid_at,
            total: &correo.total,
            gift: &correo.gift,
            note: &correo.note,
            points: &correo.points,
            express: &correo.express,
            discount: &correo.discount,
            shipped_at: &correo.shipped_at,
        }
    }
}

/// El correo `receipt`, renderizado desde `plantillas/receipt/` y enviado por `enviador`
/// (`puerto_correo::EnviadorCorreoSmtp` allí donde se ejecuta).
pub struct EnviadorCorreoReceiptPlantilla {
    enviador: Arc<dyn EnviadorCorreo>,
}

impl EnviadorCorreoReceiptPlantilla {
    pub fn new(enviador: Arc<dyn EnviadorCorreo>) -> Self {
        Self { enviador }
    }
}

#[async_trait]
impl EnviadorCorreoReceipt for EnviadorCorreoReceiptPlantilla {
    async fn enviar(&self, correo: &CorreoReceipt) -> Result<(), ErrorCorreo> {
        let renderizado = PLANTILLAS.renderizar(correo.para.clone(), Contexto::de(correo))?;
        self.enviador.enviar(&renderizado).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn receipt() -> CorreoReceipt {
        CorreoReceipt {
            para: "ada@example.com".to_string(),
            pedido_id: Uuid::new_v4(),
            paid_at: Utc::now(),
            total: 1.5,
            gift: true,
            note: Some("example".to_string()),
            points: Some(42),
            express: Some(true),
            discount: Some(1.5),
            shipped_at: Some(Utc::now()),
        }
    }

    #[test]
    fn deberia_renderizar_todas_las_plantillas_cuando_el_correo_tiene_sus_campos() {
        // Actuar
        let renderizado = PLANTILLAS.renderizar("ada@example.com", Contexto::de(&receipt()));

        // Comprobar
        let renderizado = match renderizado {
            Ok(renderizado) => renderizado,
            Err(err) => panic!("plantillas/receipt/ no se renderiza: {err}"),
        };
        assert!(!renderizado.asunto.is_empty());
        assert!(!renderizado.html.is_empty());
        assert!(renderizado.texto.is_some());
    }

    #[tokio::test]
    async fn deberia_enviar_el_correo_renderizado_a_su_destinatario() {
        // Preparar
        let grabador = Arc::new(EnviadorCorreoGrabador::new());
        let enviador = EnviadorCorreoReceiptPlantilla::new(grabador.clone());

        // Actuar
        let resultado = enviador.enviar(&receipt()).await;

        // Comprobar
        assert_eq!(resultado, Ok(()));
        let enviados = grabador.enviados();
        assert_eq!(enviados.len(), 1);
        assert_eq!(enviados[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn deberia_devolver_el_error_del_enviador_cuando_el_envio_falla() {
        // Preparar
        let rechazado = ErrorCorreo::Permanente("550 no such user".to_string());
        let enviador = EnviadorCorreoReceiptPlantilla::new(Arc::new(
            EnviadorCorreoGrabador::fallando_con(rechazado.clone()),
        ));

        // Actuar
        let resultado = enviador.enviar(&receipt()).await;

        // Comprobar
        assert_eq!(resultado, Err(rechazado));
    }
}

=== contextos/correo/infraestructura/src/welcome.rs ===
//! Renderiza el correo `welcome` con sus plantillas y se lo pasa al enviador. Lo escribe una
//! vez `puerto generar correo`; desde entonces es tuyo. El texto está en `plantillas/welcome/`:
//! cámbialo allí; los tests de abajo lo vuelven a renderizar, así que una errata hace fallar
//! `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::welcome::{CorreoWelcome, EnviadorCorreoWelcome};
use puerto_correo::{EnviadorCorreo, ErrorCorreo, Plantillas};
use serde::Serialize;

const PLANTILLAS: Plantillas = Plantillas::new(
    include_str!("../plantillas/welcome/asunto.txt"),
    include_str!("../plantillas/welcome/cuerpo.html"),
)
.con_texto(include_str!("../plantillas/welcome/cuerpo.txt"));

/// Lo que ven las plantillas: los campos del correo salvo el destinatario, con sus propios nombres.
#[derive(Serialize)]
struct Contexto<'a> {
    name: &'a String,
    plan: &'a Option<String>,
    seats: &'a i64,
}

impl<'a> Contexto<'a> {
    fn de(correo: &'a CorreoWelcome) -> Self {
        Self {
            name: &correo.name,
            plan: &correo.plan,
            seats: &correo.seats,
        }
    }
}

/// El correo `welcome`, renderizado desde `plantillas/welcome/` y enviado por `enviador`
/// (`puerto_correo::EnviadorCorreoSmtp` allí donde se ejecuta).
pub struct EnviadorCorreoWelcomePlantilla {
    enviador: Arc<dyn EnviadorCorreo>,
}

impl EnviadorCorreoWelcomePlantilla {
    pub fn new(enviador: Arc<dyn EnviadorCorreo>) -> Self {
        Self { enviador }
    }
}

#[async_trait]
impl EnviadorCorreoWelcome for EnviadorCorreoWelcomePlantilla {
    async fn enviar(&self, correo: &CorreoWelcome) -> Result<(), ErrorCorreo> {
        let renderizado = PLANTILLAS.renderizar(correo.para.clone(), Contexto::de(correo))?;
        self.enviador.enviar(&renderizado).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn welcome() -> CorreoWelcome {
        CorreoWelcome {
            para: "ada@example.com".to_string(),
            name: "example".to_string(),
            plan: Some("example".to_string()),
            seats: 42,
        }
    }

    #[test]
    fn deberia_renderizar_todas_las_plantillas_cuando_el_correo_tiene_sus_campos() {
        // Actuar
        let renderizado = PLANTILLAS.renderizar("ada@example.com", Contexto::de(&welcome()));

        // Comprobar
        let renderizado = match renderizado {
            Ok(renderizado) => renderizado,
            Err(err) => panic!("plantillas/welcome/ no se renderiza: {err}"),
        };
        assert!(!renderizado.asunto.is_empty());
        assert!(!renderizado.html.is_empty());
        assert!(renderizado.texto.is_some());
    }

    #[tokio::test]
    async fn deberia_enviar_el_correo_renderizado_a_su_destinatario() {
        // Preparar
        let grabador = Arc::new(EnviadorCorreoGrabador::new());
        let enviador = EnviadorCorreoWelcomePlantilla::new(grabador.clone());

        // Actuar
        let resultado = enviador.enviar(&welcome()).await;

        // Comprobar
        assert_eq!(resultado, Ok(()));
        let enviados = grabador.enviados();
        assert_eq!(enviados.len(), 1);
        assert_eq!(enviados[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn deberia_devolver_el_error_del_enviador_cuando_el_envio_falla() {
        // Preparar
        let rechazado = ErrorCorreo::Permanente("550 no such user".to_string());
        let enviador = EnviadorCorreoWelcomePlantilla::new(Arc::new(
            EnviadorCorreoGrabador::fallando_con(rechazado.clone()),
        ));

        // Actuar
        let resultado = enviador.enviar(&welcome()).await;

        // Comprobar
        assert_eq!(resultado, Err(rechazado));
    }
}

=== contextos/saludo/aplicacion/src/obtener_saludo.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo, repositorio::RepositorioSaludo};

#[derive(Debug, Clone)]
pub struct ParamsObtenerSaludo {
    pub nombre: String,
}

#[async_trait]
pub trait ObtenerSaludo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerSaludo {}

        #[async_trait]
        impl ObtenerSaludo for ObtenerSaludo {
            async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
        }
    }
}

pub struct ObtenerSaludoImpl {
    pub repositorio: Arc<dyn RepositorioSaludo>,
}

#[async_trait]
impl ObtenerSaludo for ObtenerSaludoImpl {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo> {
        tracing::info!(nombre = %params.nombre, "obtener_saludo: inicio");

        if params.nombre.trim().is_empty() {
            let err = ErrorSaludo::Validacion("nombre_vacio".into());
            tracing::warn!(error = %err, "obtener_saludo: rechazado");
            return Err(err);
        }

        let resultado = match self
            .repositorio
            .buscar_por_nombre(&params.nombre)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "obtener_saludo: fallo del repositorio"))?
        {
            Some(saludo) => saludo,
            None => Saludo::new(&params.nombre)?,
        };

        tracing::info!("obtener_saludo: fin");
        Ok(resultado)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_saludo::repositorio::dobles::MockRepositorioSaludo;

    #[tokio::test]
    async fn deberia_devolver_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(|_| Ok(None));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Mundo".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let saludo = resultado.unwrap();
        assert_eq!(saludo.nombre, "Mundo");
        assert!(saludo.mensaje.contains("Mundo"));
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_el_nombre_esta_vacio() {
        // Preparar
        let repositorio_doble = MockRepositorioSaludo::new();
        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo { nombre: "".into() })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "saludo.validacion.nombre_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_el_saludo_guardado_cuando_esta_en_el_repositorio() {
        // Preparar
        let en_cache = Saludo {
            nombre: "Puerto".into(),
            mensaje: "¡Hola desde la caché!".into(),
        };
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(move |_| Ok(Some(en_cache.clone())));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Puerto".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().mensaje, "¡Hola desde la caché!");
    }
}

=== contextos/saludo/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ParamsObtenerSaludo};
use poem_openapi::{OpenApi, Tags, param::Path};

use crate::{dto::DtoSaludo, errores::a_respuesta_error, respuestas::RespuestaObtenerSaludo};

#[derive(Tags)]
enum ApiTags {
    Saludo,
}

/// Guarda el puerto del caso de uso; `generado/bootstrap.rs` conecta la implementación.
pub struct ApiSaludo {
    pub obtener_saludo: Arc<dyn ObtenerSaludo>,
}

#[OpenApi]
impl ApiSaludo {
    /// Obtiene un saludo para el nombre dado
    #[oai(path = "/saludos/:nombre", method = "get", tag = "ApiTags::Saludo")]
    async fn obtener_saludo(&self, nombre: Path<String>) -> RespuestaObtenerSaludo {
        match self
            .obtener_saludo
            .ejecutar(ParamsObtenerSaludo { nombre: nombre.0 })
            .await
        {
            Ok(saludo) => RespuestaObtenerSaludo::Ok(poem_openapi::payload::Json(
                DtoSaludo::from_dominio(&saludo),
            )),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_saludo falló");
                RespuestaObtenerSaludo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;
    use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo};
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::OpenApiService;

    use super::*;

    fn cliente(caso_de_uso: MockObtenerSaludo) -> TestClient<Route> {
        let api = ApiSaludo {
            obtener_saludo: Arc::new(caso_de_uso),
        };
        TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
    }

    #[tokio::test]
    async fn deberia_responder_200_con_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|params| Saludo::new(&params.nombre));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("nombre")
            .assert_string("Ada");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_se_rechaza_el_saludo() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|_| Err(ErrorSaludo::Validacion("nombre_vacio".into())));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }
}

