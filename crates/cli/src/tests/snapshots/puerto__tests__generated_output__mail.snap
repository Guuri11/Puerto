=== contextos/correo/infraestructura/src/receipt.rs ===
//! Renders the `receipt` mail from its templates and hands it to the mailer. Written once by
//! `puerto generar correo`; it is yours now. The text is in `plantillas/receipt/`:
//! change it there — the tests below render it again, so a typo fails `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_correo::receipt::{ReceiptMail, ReceiptMailer};
use puerto_correo::{EnviadorCorreo, ErrorCorreo, Plantillas};
use serde::Serialize;
use uuid::Uuid;

const TEMPLATES: Plantillas = Plantillas::new(
    include_str!("../plantillas/receipt/subject.txt"),
    include_str!("../plantillas/receipt/body.html"),
)
.con_texto(include_str!("../plantillas/receipt/body.txt"));

/// What the templates see: the mail's fields but the recipient, under their own names.
#[derive(Serialize)]
struct Context<'a> {
    order_id: &'a Uuid,
    paid_at: &'a DateTime<Utc>,
    total: &'a f64,
    gift: &'a bool,
    note: &'a Option<String>,
    points: &'a Option<i64>,
    express: &'a Option<bool>,
    discount: &'a Option<f64>,
    shipped_at: &'a Option<DateTime<Utc>>,
}

impl<'a> Context<'a> {
    fn of(mail: &'a ReceiptMail) -> Self {
        Self {
            order_id: &mail.order_id,
            paid_at: &mail.paid_at,
            total: &mail.total,
            gift: &mail.gift,
            note: &mail.note,
            points: &mail.points,
            express: &mail.express,
            discount: &mail.discount,
            shipped_at: &mail.shipped_at,
        }
    }
}

/// The `receipt` mail, rendered from `plantillas/receipt/` and sent through `mailer`
/// (`puerto_correo::EnviadorCorreoSmtp` where it runs).
pub struct TemplateReceiptMailer {
    mailer: Arc<dyn EnviadorCorreo>,
}

impl TemplateReceiptMailer {
    pub fn new(mailer: Arc<dyn EnviadorCorreo>) -> Self {
        Self { mailer }
    }
}

#[async_trait]
impl ReceiptMailer for TemplateReceiptMailer {
    async fn send(&self, mail: &ReceiptMail) -> Result<(), ErrorCorreo> {
        let email = TEMPLATES.renderizar(mail.to.clone(), Context::of(mail))?;
        self.mailer.enviar(&email).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn receipt() -> ReceiptMail {
        ReceiptMail {
            to: "ada@example.com".to_string(),
            order_id: Uuid::new_v4(),
            paid_at: Utc::now(),
            total: 1.5,
            gift: true,
            note: Some("example".to_string()),
            points: Some(42),
            express: Some(true),
            discount: Some(1.5),
            shipped_at: Some(Utc::now()),
        }
    }

    #[test]
    fn should_render_every_template_when_the_mail_has_its_fields() {
        // Act
        let email = TEMPLATES.renderizar("ada@example.com", Context::of(&receipt()));

        // Assert
        let email = match email {
            Ok(email) => email,
            Err(err) => panic!("plantillas/receipt/ does not render: {err}"),
        };
        assert!(!email.asunto.is_empty());
        assert!(!email.html.is_empty());
        assert!(email.texto.is_some());
    }

    #[tokio::test]
    async fn should_send_the_rendered_mail_to_its_recipient() {
        // Arrange
        let recorder = Arc::new(EnviadorCorreoGrabador::new());
        let mailer = TemplateReceiptMailer::new(recorder.clone());

        // Act
        let result = mailer.send(&receipt()).await;

        // Assert
        assert_eq!(result, Ok(()));
        let sent = recorder.enviados();
        assert_eq!(sent.len(), 1);
        assert_eq!(sent[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn should_return_the_mailer_error_when_sending_fails() {
        // Arrange
        let rejected = ErrorCorreo::Permanente("550 no such user".to_string());
        let mailer = TemplateReceiptMailer::new(Arc::new(EnviadorCorreoGrabador::fallando_con(
            rejected.clone(),
        )));

        // Act
        let result = mailer.send(&receipt()).await;

        // Assert
        assert_eq!(result, Err(rejected));
    }
}

=== contextos/correo/infraestructura/src/welcome.rs ===
//! Renders the `welcome` mail from its templates and hands it to the mailer. Written once by
//! `puerto generar correo`; it is yours now. The text is in `plantillas/welcome/`:
//! change it there — the tests below render it again, so a typo fails `make test`.

use std::sync::Arc;

use async_trait::async_trait;
use dominio_correo::welcome::{WelcomeMail, WelcomeMailer};
use puerto_correo::{EnviadorCorreo, ErrorCorreo, Plantillas};
use serde::Serialize;

const TEMPLATES: Plantillas = Plantillas::new(
    include_str!("../plantillas/welcome/subject.txt"),
    include_str!("../plantillas/welcome/body.html"),
)
.con_texto(include_str!("../plantillas/welcome/body.txt"));

/// What the templates see: the mail's fields but the recipient, under their own names.
#[derive(Serialize)]
struct Context<'a> {
    name: &'a String,
    plan: &'a Option<String>,
    seats: &'a i64,
}

impl<'a> Context<'a> {
    fn of(mail: &'a WelcomeMail) -> Self {
        Self {
            name: &mail.name,
            plan: &mail.plan,
            seats: &mail.seats,
        }
    }
}

/// The `welcome` mail, rendered from `plantillas/welcome/` and sent through `mailer`
/// (`puerto_correo::EnviadorCorreoSmtp` where it runs).
pub struct TemplateWelcomeMailer {
    mailer: Arc<dyn EnviadorCorreo>,
}

impl TemplateWelcomeMailer {
    pub fn new(mailer: Arc<dyn EnviadorCorreo>) -> Self {
        Self { mailer }
    }
}

#[async_trait]
impl WelcomeMailer for TemplateWelcomeMailer {
    async fn send(&self, mail: &WelcomeMail) -> Result<(), ErrorCorreo> {
        let email = TEMPLATES.renderizar(mail.to.clone(), Context::of(mail))?;
        self.mailer.enviar(&email).await
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use puerto_correo::pruebas::EnviadorCorreoGrabador;

    fn welcome() -> WelcomeMail {
        WelcomeMail {
            to: "ada@example.com".to_string(),
            name: "example".to_string(),
            plan: Some("example".to_string()),
            seats: 42,
        }
    }

    #[test]
    fn should_render_every_template_when_the_mail_has_its_fields() {
        // Act
        let email = TEMPLATES.renderizar("ada@example.com", Context::of(&welcome()));

        // Assert
        let email = match email {
            Ok(email) => email,
            Err(err) => panic!("plantillas/welcome/ does not render: {err}"),
        };
        assert!(!email.asunto.is_empty());
        assert!(!email.html.is_empty());
        assert!(email.texto.is_some());
    }

    #[tokio::test]
    async fn should_send_the_rendered_mail_to_its_recipient() {
        // Arrange
        let recorder = Arc::new(EnviadorCorreoGrabador::new());
        let mailer = TemplateWelcomeMailer::new(recorder.clone());

        // Act
        let result = mailer.send(&welcome()).await;

        // Assert
        assert_eq!(result, Ok(()));
        let sent = recorder.enviados();
        assert_eq!(sent.len(), 1);
        assert_eq!(sent[0].para, "ada@example.com");
    }

    #[tokio::test]
    async fn should_return_the_mailer_error_when_sending_fails() {
        // Arrange
        let rejected = ErrorCorreo::Permanente("550 no such user".to_string());
        let mailer = TemplateWelcomeMailer::new(Arc::new(EnviadorCorreoGrabador::fallando_con(
            rejected.clone(),
        )));

        // Act
        let result = mailer.send(&welcome()).await;

        // Assert
        assert_eq!(result, Err(rejected));
    }
}

