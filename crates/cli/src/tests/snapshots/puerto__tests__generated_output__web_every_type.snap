=== contextos/case/aplicacion/src/crear_case.rs ===
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use dominio_case::errores::ErrorCase;
use dominio_case::modelo::{Case, PropsCase};
use dominio_case::repositorio::RepositorioCase;
use dominio_case::valores::{Label, MiddleName, Status};
use std::collections::HashMap;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearCase {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: String,
    pub middle_name: Option<String>,
    pub labels: Vec<String>,
}

#[async_trait]
pub trait CrearCase: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearCase) -> Result<Case, ErrorCase>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearCase {}

        #[async_trait]
        impl CrearCase for CrearCase {
            async fn ejecutar(&self, params: ParamsCrearCase) -> Result<Case, ErrorCase>;
        }
    }
}

pub struct CrearCaseImpl {
    pub repositorio: Arc<dyn RepositorioCase>,
}

#[async_trait]
impl CrearCase for CrearCaseImpl {
    async fn ejecutar(&self, params: ParamsCrearCase) -> Result<Case, ErrorCase> {
        tracing::info!("crear_case: inicio");
        let status = params.status.parse::<Status>()?;
        let middle_name = params.middle_name.map(MiddleName::new).transpose()?;
        let labels: Vec<Label> = params
            .labels
            .into_iter()
            .map(Label::new)
            .collect::<Result<Vec<_>, _>>()?;
        let entidad = Case::new(PropsCase {
            title: params.title,
            summary: params.summary,
            views: params.views,
            ratio: params.ratio,
            urgent: params.urgent,
            due_at: params.due_at,
            opened_at: params.opened_at,
            tags: params.tags,
            scores: params.scores,
            meta: params.meta,
            status,
            middle_name,
            labels,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "crear_case: rechazado"))?;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "crear_case: fallo del repositorio"))?;
        tracing::info!(id = %entidad.id, "crear_case: fin");
        Ok(entidad)
    }
}

