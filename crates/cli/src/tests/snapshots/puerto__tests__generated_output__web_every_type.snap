use business::domain::case::model::Case;
use chrono::{DateTime, Utc};
use poem_openapi::Object;
use puerto_core::Page;
use std::collections::HashMap;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CaseDto {
    pub id: Uuid,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: String,
    pub middle_name: Option<String>,
    pub labels: Vec<String>,
}

impl CaseDto {
    pub fn from_domain(entity: &Case) -> Self {
        Self {
            id: entity.id.value(),
            title: entity.title.clone(),
            summary: entity.summary.clone(),
            views: entity.views,
            ratio: entity.ratio,
            urgent: entity.urgent,
            due_at: entity.due_at,
            opened_at: entity.opened_at,
            tags: entity.tags.clone(),
            scores: entity.scores.clone(),
            meta: entity.meta.clone(),
            status: entity.status.as_str().to_string(),
            middle_name: entity.middle_name.as_ref().map(|v| v.value().to_string()),
            labels: entity
                .labels
                .iter()
                .map(|v| v.value().to_string())
                .collect::<Vec<_>>(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateCaseRequest {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: String,
    pub middle_name: Option<String>,
    pub labels: Vec<String>,
}

/// One page of Cases: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CasePageDto {
    pub items: Vec<CaseDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl CasePageDto {
    pub fn from_domain(page: &Page<Case>) -> Self {
        Self {
            items: page.items.iter().map(CaseDto::from_domain).collect(),
            total: page.total,
            limit: page.limit,
            offset: page.offset,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateCaseRequest {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: String,
    pub middle_name: Option<String>,
    pub labels: Vec<String>,
}

=== presentation/src/api/case/error_mapper.rs ===
use business::domain::case::errors::CaseError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::ErrorResponse;

use crate::api::error::IntoErrorResponse;

impl IntoErrorResponse for CaseError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            CaseError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            CaseError::NotFound => StatusCode::NOT_FOUND,
            CaseError::Duplicate => StatusCode::CONFLICT,
            CaseError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            CaseError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            CaseError::InvalidStatus => StatusCode::UNPROCESSABLE_ENTITY,
            CaseError::InvalidMiddleName => StatusCode::UNPROCESSABLE_ENTITY,
            CaseError::InvalidLabel => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            CaseError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "case.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = CaseError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "case.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = CaseError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "case.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = CaseError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "case.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = CaseError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "case.unknown");
    }

    #[test]
    fn should_map_invalid_status_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = CaseError::InvalidStatus.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "case.invalid_status");
    }

    #[test]
    fn should_map_invalid_middle_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = CaseError::InvalidMiddleName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "case.invalid_middle_name");
    }

    #[test]
    fn should_map_invalid_label_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = CaseError::InvalidLabel.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "case.invalid_label");
    }
}

