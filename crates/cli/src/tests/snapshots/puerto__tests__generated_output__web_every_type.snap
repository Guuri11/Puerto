import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { CaseError } from "../../../../domain/case/errors";
import { CaseMother, fakeCaseRepository } from "../../../../test-support/case";
import { renderScreen } from "../../../../test-support/render";
import { CaseListContainer } from "./case-list-container";

describe("CaseListContainer", () => {
  test("should show a row per case when there are some", async () => {
    // Arrange
    const seed = [CaseMother.random(), CaseMother.random()];
    const caseRepository = fakeCaseRepository(seed);

    // Act
    renderScreen(<CaseListContainer />, { caseRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => CaseMother.random());
    const caseRepository = fakeCaseRepository(seed);
    renderScreen(<CaseListContainer />, { caseRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => CaseMother.random());
    const caseRepository = fakeCaseRepository(seed);
    const path = "/cases?page=2";

    // Act
    renderScreen(<CaseListContainer />, { caseRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no case", async () => {
    // Arrange
    const caseRepository = fakeCaseRepository();

    // Act
    renderScreen(<CaseListContainer />, { caseRepository });

    // Assert
    expect(await screen.findByText("No cases yet.")).toBeTruthy();
  });

  test("should show the error code when the cases cannot be listed", async () => {
    // Arrange
    const caseRepository = {
      ...fakeCaseRepository(),
      list: () => Promise.reject(new CaseError("case.repository_error")),
    };

    // Act
    renderScreen(<CaseListContainer />, { caseRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("case.repository_error");
  });
});

=== web/src/presentation/features/case/containers/case-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { CaseListView } from "../views/case-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function CaseListContainer() {
  const { caseRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const cases = useAsync(
    () => caseRepository.list({ limit: PAGE_SIZE, offset }),
    [caseRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Cases</h1>
        <Link href="/cases/new" className="btn btn-primary">
          New case
        </Link>
      </div>
      {cases.status === "loading" && <span className="loading loading-spinner" />}
      {cases.status === "error" && <ErrorAlert error={cases.error} />}
      {cases.status === "ok" &&
        (cases.data.total === 0 ? (
          <EmptyState message="No cases yet." />
        ) : (
          <>
            <CaseListView cases={cases.data.items} />
            <Pagination {...cases.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

