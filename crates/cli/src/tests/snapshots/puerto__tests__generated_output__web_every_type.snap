use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::Page;

use crate::domain::case::{
    errors::CaseError,
    model::Case,
    repository::CaseRepositoryTrait,
    use_cases::list_cases::{ListCasesParams, ListCasesUseCaseTrait},
};

pub struct ListCasesUseCaseImpl {
    pub repository: Arc<dyn CaseRepositoryTrait>,
}

#[async_trait]
impl ListCasesUseCaseTrait for ListCasesUseCaseImpl {
    async fn execute(&self, params: ListCasesParams) -> Result<Page<Case>, CaseError> {
        tracing::info!(
            limit = params.page.limit(),
            offset = params.page.offset(),
            "list_cases: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_cases: repository failed"))
            .map_err(CaseError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::case::value_objects::Status;
    use crate::domain::case::{
        model::{Case, CaseProps},
        repository::mocks::MockCaseRepository,
    };
    use chrono::Utc;
    use puerto_core::PageRequest;
    use std::collections::HashMap;

    #[tokio::test]
    async fn should_return_the_page_of_cases() {
        let entities = vec![
            Case::new(CaseProps {
                title: "first".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: Status::Open,
                middle_name: None,
                labels: vec![],
            })
            .unwrap(),
            Case::new(CaseProps {
                title: "second".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: Status::Open,
                middle_name: None,
                labels: vec![],
            })
            .unwrap(),
        ];
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Page::new(entities.clone(), 2, page)));
        let use_case = ListCasesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCasesParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.items.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_cases_exist() {
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListCasesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCasesParams {
                page: PageRequest::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.items.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limit() == 5 && page.offset() == 10)
            .returning(|page| Ok(Page::new(vec![], 0, page)));
        let use_case = ListCasesUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListCasesParams {
                page: PageRequest::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().offset, 10);
    }
}

=== business/src/application/case/update_case.rs ===
use std::sync::Arc;

use crate::domain::case::value_objects::Label;
use crate::domain::case::value_objects::MiddleName;
use crate::domain::case::value_objects::Status;
use async_trait::async_trait;

use crate::domain::case::{
    errors::CaseError,
    model::Case,
    repository::CaseRepositoryTrait,
    use_cases::update_case::{UpdateCaseParams, UpdateCaseUseCaseTrait},
};

pub struct UpdateCaseUseCaseImpl {
    pub repository: Arc<dyn CaseRepositoryTrait>,
}

#[async_trait]
impl UpdateCaseUseCaseTrait for UpdateCaseUseCaseImpl {
    async fn execute(&self, params: UpdateCaseParams) -> Result<Case, CaseError> {
        tracing::info!(id = %params.id, "update_case: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_case: repository failed"))?
            .ok_or_else(|| {
                let err = CaseError::NotFound;
                tracing::warn!(error = %err, "update_case: rejected");
                err
            })?;
        if params.title.trim().is_empty() {
            let err = CaseError::ValidationError("title_empty".into());
            tracing::warn!(error = %err, "update_case: rejected");
            return Err(err);
        }
        let status = params.status.parse::<Status>()?;
        let middle_name = params.middle_name.map(MiddleName::new).transpose()?;
        let labels: Vec<Label> = params
            .labels
            .into_iter()
            .map(Label::new)
            .collect::<Result<Vec<_>, _>>()?;
        entity.title = params.title;
        entity.summary = params.summary;
        entity.views = params.views;
        entity.ratio = params.ratio;
        entity.urgent = params.urgent;
        entity.due_at = params.due_at;
        entity.opened_at = params.opened_at;
        entity.tags = params.tags;
        entity.scores = params.scores;
        entity.meta = params.meta;
        entity.status = status;
        entity.middle_name = middle_name;
        entity.labels = labels;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_case: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::case::value_objects::Status;
    use crate::domain::case::{
        model::{Case, CaseId, CaseProps},
        repository::mocks::MockCaseRepository,
    };
    use chrono::Utc;
    use std::collections::HashMap;

    #[tokio::test]
    async fn should_update_case_when_params_are_valid() {
        // Arrange
        let entity = Case::new(CaseProps {
            title: "original".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCaseParams {
                id: entity_id,
                title: "updated".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: "Open".to_string(),
                middle_name: None,
                labels: vec![],
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().title, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_case_does_not_exist() {
        // Arrange
        let mut mock_repo = MockCaseRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCaseParams {
                id: CaseId::generate(),
                title: "new".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: "Open".to_string(),
                middle_name: None,
                labels: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "case.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let entity = Case::new(CaseProps {
            title: "original".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCaseParams {
                id: entity_id,
                title: "".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: "Open".to_string(),
                middle_name: None,
                labels: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "case.validation_error.title_empty"
        );
    }
}

=== business/src/domain/case/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum CaseError {
    #[error("case.validation_error.{0}")]
    ValidationError(String),
    #[error("case.not_found")]
    NotFound,
    #[error("case.duplicate")]
    Duplicate,
    #[error("case.repository_error")]
    RepositoryError,
    #[error("case.unknown")]
    Unknown,
    #[error("case.invalid_status")]
    InvalidStatus,
    #[error("case.invalid_middle_name")]
    InvalidMiddleName,
    #[error("case.invalid_label")]
    InvalidLabel,
}

impl From<RepositoryError> for CaseError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = CaseError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "case.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = CaseError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "case.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = CaseError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "case.repository_error");
    }
}

