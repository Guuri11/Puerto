}

=== contextos/case/dominio/src/valores.rs ===
use crate::errores::ErrorCase;

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Open,
    Closed,
}

impl std::str::FromStr for Status {
    type Err = ErrorCase;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Open" => Ok(Self::Open),
            "Closed" => Ok(Self::Closed),
            _ => Err(ErrorCase::StatusInvalido),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Open => "Open",
            Self::Closed => "Closed",
        }
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    valor: String,
}

impl MiddleName {
    pub fn new(valor: String) -> Result<Self, ErrorCase> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCase::MiddleNameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Label {
    valor: String,
}

impl Label {
    pub fn new(valor: String) -> Result<Self, ErrorCase> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorCase::LabelInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

