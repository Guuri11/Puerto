use async_trait::async_trait;
use dominio_case::errores::ErrorCase;
use dominio_case::modelo::IdCase;
use dominio_case::repositorio::RepositorioCase;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarCase {
    pub id: IdCase,
}

#[async_trait]
pub trait BorrarCase: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarCase) -> Result<(), ErrorCase>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarCase {}

        #[async_trait]
        impl BorrarCase for BorrarCase {
            async fn ejecutar(&self, params: ParamsBorrarCase) -> Result<(), ErrorCase>;
        }
    }
}

pub struct BorrarCaseImpl {
    pub repositorio: Arc<dyn RepositorioCase>,
}

#[async_trait]
impl BorrarCase for BorrarCaseImpl {
    async fn ejecutar(&self, params: ParamsBorrarCase) -> Result<(), ErrorCase> {
        tracing::info!(id = %params.id, "borrar_case: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_case: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = ErrorCase::NoEncontrado;
                tracing::warn!(error = %err, "borrar_case: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio
            .guardar(&entidad)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_case: fallo del repositorio"))?;
        Ok(())
    }
}

