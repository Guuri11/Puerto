// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod case {
    use std::sync::Arc;

    use aplicacion_case::actualizar_case::{ActualizarCase, ActualizarCaseImpl};
    use aplicacion_case::borrar_case::{BorrarCase, BorrarCaseImpl};
    use aplicacion_case::crear_case::{CrearCase, CrearCaseImpl};
    use aplicacion_case::listar_cases::{ListarCases, ListarCasesImpl};
    use aplicacion_case::obtener_case::{ObtenerCase, ObtenerCaseImpl};
    use dominio_case::repositorio::RepositorioCase;
    use infra_case::repositorio::RepositorioCaseEnMemoria;

    /// Los casos de uso de `case`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_case: Arc<dyn CrearCase>,
        pub obtener_case: Arc<dyn ObtenerCase>,
        pub listar_cases: Arc<dyn ListarCases>,
        pub actualizar_case: Arc<dyn ActualizarCase>,
        pub borrar_case: Arc<dyn BorrarCase>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioCase> = Arc::new(RepositorioCaseEnMemoria::new());
        CasosDeUso {
            crear_case: Arc::new(CrearCaseImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_case: Arc::new(ObtenerCaseImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_cases: Arc::new(ListarCasesImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_case: Arc::new(ActualizarCaseImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_case: Arc::new(BorrarCaseImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

