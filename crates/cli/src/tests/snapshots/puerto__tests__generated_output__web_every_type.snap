use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{Case, IdCase};

#[async_trait]
pub trait RepositorioCase: Send + Sync {
    async fn buscar_todos(&self, pagina: PeticionPagina) -> Result<Pagina<Case>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdCase) -> Result<Option<Case>, ErrorRepositorio>;
    async fn guardar(&self, entidad: &Case) -> Result<(), ErrorRepositorio>;
}

