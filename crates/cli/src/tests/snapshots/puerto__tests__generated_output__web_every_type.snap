use crate::domain::case::model::Case;
use crate::domain::case::model::CaseProps;
use crate::domain::case::value_objects::Label;
use crate::domain::case::value_objects::MiddleName;
use crate::domain::case::value_objects::Status;
use chrono::{DateTime, Utc};
use std::collections::HashMap;

pub struct CaseMother {
    title: Option<String>,
    summary: Option<String>,
    views: Option<i64>,
    ratio: Option<f64>,
    urgent: Option<bool>,
    due_at: Option<DateTime<Utc>>,
    opened_at: Option<DateTime<Utc>>,
    tags: Option<Vec<String>>,
    scores: Option<Vec<i64>>,
    meta: Option<HashMap<String, String>>,
    status: Option<Status>,
    middle_name: Option<MiddleName>,
    labels: Option<Vec<Label>>,
}

impl CaseMother {
    pub fn new() -> Self {
        Self {
            title: None,
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: None,
            tags: None,
            scores: None,
            meta: None,
            status: None,
            middle_name: None,
            labels: None,
        }
    }

    pub fn with_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn with_summary(mut self, summary: &str) -> Self {
        self.summary = Some(summary.to_string());
        self
    }

    pub fn with_views(mut self, views: i64) -> Self {
        self.views = Some(views);
        self
    }

    pub fn with_ratio(mut self, ratio: f64) -> Self {
        self.ratio = Some(ratio);
        self
    }

    pub fn with_urgent(mut self, urgent: bool) -> Self {
        self.urgent = Some(urgent);
        self
    }

    pub fn with_due_at(mut self, due_at: DateTime<Utc>) -> Self {
        self.due_at = Some(due_at);
        self
    }

    pub fn with_opened_at(mut self, opened_at: DateTime<Utc>) -> Self {
        self.opened_at = Some(opened_at);
        self
    }

    pub fn with_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn with_scores(mut self, scores: Vec<i64>) -> Self {
        self.scores = Some(scores);
        self
    }

    pub fn with_meta(mut self, meta: HashMap<String, String>) -> Self {
        self.meta = Some(meta);
        self
    }

    pub fn with_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn with_middle_name(mut self, middle_name: MiddleName) -> Self {
        self.middle_name = Some(middle_name);
        self
    }

    pub fn with_labels(mut self, labels: Vec<Label>) -> Self {
        self.labels = Some(labels);
        self
    }

    pub fn with_empty_title(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn build(self) -> Case {
        Case::new(CaseProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            ratio: self.ratio,
            urgent: self.urgent,
            due_at: self.due_at,
            opened_at: self.opened_at.unwrap_or_else(Utc::now),
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Open),
            middle_name: self.middle_name,
            labels: self.labels.unwrap_or_default(),
        })
        .expect("CaseMother: failed to build valid Case")
    }

    pub fn build_props(self) -> CaseProps {
        CaseProps {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            ratio: self.ratio,
            urgent: self.urgent,
            due_at: self.due_at,
            opened_at: self.opened_at.unwrap_or_else(Utc::now),
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Open),
            middle_name: self.middle_name,
            labels: self.labels.unwrap_or_default(),
        }
    }

    pub fn random() -> Case {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Case> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for CaseMother {
    fn default() -> Self {
        Self::new()
    }
}

=== infrastructure/src/case/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::case::{
    model::{Case, CaseId},
    repository::CaseRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// Keeps the cases it is given in process memory: they are lost when the process stops.
/// Like the Postgres adapter, it hides deleted rows and lists newest first.
/// It stands in until there is a database (`puerto new --db` generates Postgres repositories).
#[derive(Default)]
pub struct InMemoryCaseRepository {
    rows: RwLock<HashMap<CaseId, Case>>,
}

impl InMemoryCaseRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<CaseId, Case>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<CaseId, Case>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl CaseRepositoryTrait for InMemoryCaseRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Case>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = self.read();
        let mut live: Vec<&Case> = rows.values().filter(|row| !row.deleted).collect();
        live.sort_by(|a, b| {
            b.created_at
                .cmp(&a.created_at)
                .then_with(|| a.id.value().cmp(&b.id.value()))
        });
        let total = live.len() as u64;
        let items = live
            .into_iter()
            .skip(page.offset() as usize)
            .take(page.limit() as usize)
            .cloned()
            .collect();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: CaseId) -> Result<Option<Case>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(self.read().get(&id).filter(|row| !row.deleted).cloned())
    }

    async fn save(&self, entity: &Case) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let mut rows = self.write();
        rows.insert(entity.id, entity.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::case::model::CaseProps;
    use business::domain::case::value_objects::Status;

    fn new_case() -> Case {
        Case::new(CaseProps {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: chrono::DateTime::from_timestamp(1_700_000_000, 0).unwrap(),
            tags: vec![],
            scores: vec![],
            meta: std::collections::HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        })
        .unwrap()
    }

    #[tokio::test]
    async fn should_find_a_saved_case_by_id() {
        // Arrange
        let repo = InMemoryCaseRepository::new();
        let entity = new_case();
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();

        // Assert
        assert_eq!(found.map(|row| row.id), Some(entity.id));
    }

    #[tokio::test]
    async fn should_update_the_row_when_saved_again() {
        // Arrange
        let repo = InMemoryCaseRepository::new();
        let mut entity = new_case();
        repo.save(&entity).await.unwrap();
        entity.updated_at = chrono::Utc::now();

        // Act
        repo.save(&entity).await.unwrap();

        // Assert
        let page = repo.find_all(PageRequest::default()).await.unwrap();
        assert_eq!(page.total, 1);
        assert_eq!(page.items[0].updated_at, entity.updated_at);
    }

    #[tokio::test]
    async fn should_not_find_a_deleted_case() {
        // Arrange
        let repo = InMemoryCaseRepository::new();
        let mut entity = new_case();
        entity.deleted = true;
        entity.deleted_at = Some(entity.updated_at);
        repo.save(&entity).await.unwrap();

        // Act
        let found = repo.find_by_id(entity.id).await.unwrap();
        let page = repo.find_all(PageRequest::default()).await.unwrap();

        // Assert
        assert!(found.is_none());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_return_the_requested_page_of_a_larger_list() {
        // Arrange
        let repo = InMemoryCaseRepository::new();
        for _ in 0..3 {
            repo.save(&new_case()).await.unwrap();
        }

        // Act
        let page = repo
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }
}

