use async_trait::async_trait;
use dominio_case::errores::ErrorCase;
use dominio_case::modelo::Case;
use dominio_case::repositorio::RepositorioCase;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarCases {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarCases: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarCases) -> Result<Pagina<Case>, ErrorCase>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarCases {}

        #[async_trait]
        impl ListarCases for ListarCases {
            async fn ejecutar(&self, params: ParamsListarCases) -> Result<Pagina<Case>, ErrorCase>;
        }
    }
}

pub struct ListarCasesImpl {
    pub repositorio: Arc<dyn RepositorioCase>,
}

#[async_trait]
impl ListarCases for ListarCasesImpl {
    async fn ejecutar(&self, params: ParamsListarCases) -> Result<Pagina<Case>, ErrorCase> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_cases: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_cases: fallo del repositorio"))
            .map_err(ErrorCase::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use chrono::Utc;
    use dominio_case::valores::Status;
    use dominio_case::{
        modelo::{Case, PropsCase},
        repositorio::dobles::MockRepositorioCase,
    };
    use puerto_nucleo::PeticionPagina;
    use std::collections::HashMap;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_cases() {
        let entidades = vec![
            Case::new(PropsCase {
                title: "first".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: Status::Open,
                middle_name: None,
                labels: vec![],
            })
            .unwrap(),
            Case::new(PropsCase {
                title: "second".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: Status::Open,
                middle_name: None,
                labels: vec![],
            })
            .unwrap(),
        ];
        let mut repositorio_doble = MockRepositorioCase::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarCasesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCases {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_cases() {
        let mut repositorio_doble = MockRepositorioCase::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarCasesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCases {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioCase::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarCasesImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarCases {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

