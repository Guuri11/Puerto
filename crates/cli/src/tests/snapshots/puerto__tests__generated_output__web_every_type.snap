use crate::modelo::Case;
use crate::modelo::PropsCase;
use crate::valores::Label;
use crate::valores::MiddleName;
use crate::valores::Status;
use chrono::{DateTime, Utc};
use std::collections::HashMap;

pub struct MadreCase {
    title: Option<String>,
    summary: Option<String>,
    views: Option<i64>,
    ratio: Option<f64>,
    urgent: Option<bool>,
    due_at: Option<DateTime<Utc>>,
    opened_at: Option<DateTime<Utc>>,
    tags: Option<Vec<String>>,
    scores: Option<Vec<i64>>,
    meta: Option<HashMap<String, String>>,
    status: Option<Status>,
    middle_name: Option<MiddleName>,
    labels: Option<Vec<Label>>,
}

impl MadreCase {
    pub fn new() -> Self {
        Self {
            title: None,
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: None,
            tags: None,
            scores: None,
            meta: None,
            status: None,
            middle_name: None,
            labels: None,
        }
    }

    pub fn con_title(mut self, title: &str) -> Self {
        self.title = Some(title.to_string());
        self
    }

    pub fn con_summary(mut self, summary: &str) -> Self {
        self.summary = Some(summary.to_string());
        self
    }

    pub fn con_views(mut self, views: i64) -> Self {
        self.views = Some(views);
        self
    }

    pub fn con_ratio(mut self, ratio: f64) -> Self {
        self.ratio = Some(ratio);
        self
    }

    pub fn con_urgent(mut self, urgent: bool) -> Self {
        self.urgent = Some(urgent);
        self
    }

    pub fn con_due_at(mut self, due_at: DateTime<Utc>) -> Self {
        self.due_at = Some(due_at);
        self
    }

    pub fn con_opened_at(mut self, opened_at: DateTime<Utc>) -> Self {
        self.opened_at = Some(opened_at);
        self
    }

    pub fn con_tags(mut self, tags: Vec<String>) -> Self {
        self.tags = Some(tags);
        self
    }

    pub fn con_scores(mut self, scores: Vec<i64>) -> Self {
        self.scores = Some(scores);
        self
    }

    pub fn con_meta(mut self, meta: HashMap<String, String>) -> Self {
        self.meta = Some(meta);
        self
    }

    pub fn con_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn con_middle_name(mut self, middle_name: MiddleName) -> Self {
        self.middle_name = Some(middle_name);
        self
    }

    pub fn con_labels(mut self, labels: Vec<Label>) -> Self {
        self.labels = Some(labels);
        self
    }

    pub fn con_title_vacio(mut self) -> Self {
        self.title = Some(String::new());
        self
    }

    pub fn construir(self) -> Case {
        Case::new(PropsCase {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            ratio: self.ratio,
            urgent: self.urgent,
            due_at: self.due_at,
            opened_at: self.opened_at.unwrap_or_else(Utc::now),
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Open),
            middle_name: self.middle_name,
            labels: self.labels.unwrap_or_default(),
        })
        .expect("MadreCase: Case::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsCase {
        PropsCase {
            title: self.title.unwrap_or_else(|| "example".to_string()),
            summary: self.summary,
            views: self.views,
            ratio: self.ratio,
            urgent: self.urgent,
            due_at: self.due_at,
            opened_at: self.opened_at.unwrap_or_else(Utc::now),
            tags: self.tags.unwrap_or_default(),
            scores: self.scores.unwrap_or_default(),
            meta: self.meta.unwrap_or_default(),
            status: self.status.unwrap_or(Status::Open),
            middle_name: self.middle_name,
            labels: self.labels.unwrap_or_default(),
        }
    }

    pub fn aleatorio() -> Case {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Case> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreCase {
    fn default() -> Self {
        Self::new()
    }
}

