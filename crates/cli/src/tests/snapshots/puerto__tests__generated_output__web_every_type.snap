use async_trait::async_trait;
use puerto_core::{Page, PageRequest, RepositoryError};

use super::model::{Case, CaseId};

#[async_trait]
pub trait CaseRepositoryTrait: Send + Sync {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Case>, RepositoryError>;
    async fn find_by_id(&self, id: CaseId) -> Result<Option<Case>, RepositoryError>;
    async fn save(&self, entity: &Case) -> Result<(), RepositoryError>;
}

#[cfg(any(test, feature = "test-utils"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub CaseRepository {}

        #[async_trait]
        impl CaseRepositoryTrait for CaseRepository {
            async fn find_all(&self, page: PageRequest) -> Result<Page<Case>, RepositoryError>;
            async fn find_by_id(&self, id: CaseId) -> Result<Option<Case>, RepositoryError>;
            async fn save(&self, entity: &Case) -> Result<(), RepositoryError>;
        }
    }
}

