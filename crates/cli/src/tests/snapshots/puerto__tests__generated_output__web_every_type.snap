}

=== contextos/case/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_case::{
    actualizar_case::{ActualizarCase, ParamsActualizarCase},
    borrar_case::{BorrarCase, ParamsBorrarCase},
    crear_case::{CrearCase, ParamsCrearCase},
    listar_cases::{ListarCases, ParamsListarCases},
    obtener_case::{ObtenerCase, ParamsObtenerCase},
};
use dominio_case::modelo::IdCase;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoCase, DtoPaginaCase, PeticionActualizarCase, PeticionCrearCase};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarCase, RespuestaBorrarCase, RespuestaCrearCase, RespuestaListarCases,
    RespuestaObtenerCase,
};

#[derive(Tags)]
enum ApiTags {
    Case,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiCase {
    pub crear_case: Arc<dyn CrearCase>,
    pub obtener_case: Arc<dyn ObtenerCase>,
    pub listar_cases: Arc<dyn ListarCases>,
    pub actualizar_case: Arc<dyn ActualizarCase>,
    pub borrar_case: Arc<dyn BorrarCase>,
}

#[OpenApi]
impl ApiCase {
    /// Crea: Case
    #[oai(path = "/cases", method = "post", tag = "ApiTags::Case")]
    async fn crear(&self, cuerpo: Json<PeticionCrearCase>) -> RespuestaCrearCase {
        match self
            .crear_case
            .ejecutar(ParamsCrearCase {
                title: cuerpo.title.clone(),
                summary: cuerpo.summary.clone(),
                views: cuerpo.views,
                ratio: cuerpo.ratio,
                urgent: cuerpo.urgent,
                due_at: cuerpo.due_at,
                opened_at: cuerpo.opened_at,
                tags: cuerpo.tags.clone(),
                scores: cuerpo.scores.clone(),
                meta: cuerpo.meta.clone(),
                status: cuerpo.status.clone(),
                middle_name: cuerpo.middle_name.clone(),
                labels: cuerpo.labels.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearCase::Creado(Json(DtoCase::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_case falló");
                RespuestaCrearCase::from_status(status, error)
            }
        }
    }

    /// Obtiene: Case por id
    #[oai(path = "/cases/:id", method = "get", tag = "ApiTags::Case")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerCase {
        match self
            .obtener_case
            .ejecutar(ParamsObtenerCase {
                id: IdCase::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerCase::Ok(Json(DtoCase::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_case falló");
                RespuestaObtenerCase::from_status(status, error)
            }
        }
    }

    /// Lista Cases, página a página (el dominio acota `limite`)
    #[oai(path = "/cases", method = "get", tag = "ApiTags::Case")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarCases {
        match self
            .listar_cases
            .ejecutar(ParamsListarCases {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => RespuestaListarCases::Ok(Json(DtoPaginaCase::from_dominio(&pagina))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_cases falló");
                RespuestaListarCases::from_status(status, error)
            }
        }
    }

    /// Actualiza: Case
    #[oai(path = "/cases/:id", method = "put", tag = "ApiTags::Case")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarCase>,
    ) -> RespuestaActualizarCase {
        match self
            .actualizar_case
            .ejecutar(ParamsActualizarCase {
                id: IdCase::from_uuid(id.0),
                title: cuerpo.title.clone(),
                summary: cuerpo.summary.clone(),
                views: cuerpo.views,
                ratio: cuerpo.ratio,
                urgent: cuerpo.urgent,
                due_at: cuerpo.due_at,
                opened_at: cuerpo.opened_at,
                tags: cuerpo.tags.clone(),
                scores: cuerpo.scores.clone(),
                meta: cuerpo.meta.clone(),
                status: cuerpo.status.clone(),
                middle_name: cuerpo.middle_name.clone(),
                labels: cuerpo.labels.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarCase::Ok(Json(DtoCase::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_case falló");
                RespuestaActualizarCase::from_status(status, error)
            }
        }
    }

    /// Borra: Case
    #[oai(path = "/cases/:id", method = "delete", tag = "ApiTags::Case")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarCase {
        match self
            .borrar_case
            .ejecutar(ParamsBorrarCase {
                id: IdCase::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarCase::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_case falló");
                RespuestaBorrarCase::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_case::{
        actualizar_case::dobles::MockActualizarCase, borrar_case::dobles::MockBorrarCase,
        crear_case::dobles::MockCrearCase, listar_cases::dobles::MockListarCases,
        obtener_case::dobles::MockObtenerCase,
    };
    use chrono::Utc;
    use dominio_case::errores::ErrorCase;
    use dominio_case::pruebas::madres::MadreCase;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;
    use std::collections::HashMap;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Mocks {
        crear: MockCrearCase,
        get: MockObtenerCase,
        listar: MockListarCases,
        actualizar: MockActualizarCase,
        borrar: MockBorrarCase,
    }

    impl Mocks {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiCase {
                crear_case: Arc::new(self.crear),
                obtener_case: Arc::new(self.get),
                listar_cases: Arc::new(self.listar),
                actualizar_case: Arc::new(self.actualizar),
                borrar_case: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearCase {
        PeticionCrearCase {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: "example".to_string(),
            middle_name: None,
            labels: vec![],
        }
    }

    fn peticion_actualizar() -> PeticionActualizarCase {
        PeticionActualizarCase {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: "example".to_string(),
            middle_name: None,
            labels: vec![],
        }
    }

    fn ruta_elemento() -> String {
        format!("/cases/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_case() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreCase::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/cases")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_case_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorCase::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/cases")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_case_existe() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .get
            .expect_ejecutar()
            .returning(|_| Ok(MadreCase::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_case_no_existe() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .get
            .expect_ejecutar()
            .returning(|_| Err(ErrorCase::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_cases_cuando_se_listan() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreCase::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/cases").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/cases?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCase::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/cases").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_case() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreCase::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_case_inexistente() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCase::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_case() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_case_inexistente() {
        // Preparar
        let mut dobles = Mocks::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorCase::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

=== contextos/saludo/aplicacion/src/obtener_saludo.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo, repositorio::RepositorioSaludo};

#[derive(Debug, Clone)]
pub struct ParamsObtenerSaludo {
    pub nombre: String,
}

#[async_trait]
pub trait ObtenerSaludo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerSaludo {}

        #[async_trait]
        impl ObtenerSaludo for ObtenerSaludo {
            async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
        }
    }
}

pub struct ObtenerSaludoImpl {
    pub repositorio: Arc<dyn RepositorioSaludo>,
}

#[async_trait]
impl ObtenerSaludo for ObtenerSaludoImpl {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo> {
        tracing::info!(nombre = %params.nombre, "obtener_saludo: inicio");

        if params.nombre.trim().is_empty() {
            let err = ErrorSaludo::Validacion("nombre_vacio".into());
            tracing::warn!(error = %err, "obtener_saludo: rechazado");
            return Err(err);
        }

        let resultado = match self
            .repositorio
            .buscar_por_nombre(&params.nombre)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "obtener_saludo: fallo del repositorio"))?
        {
            Some(saludo) => saludo,
            None => Saludo::new(&params.nombre)?,
        };

        tracing::info!("obtener_saludo: fin");
        Ok(resultado)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_saludo::repositorio::dobles::MockRepositorioSaludo;

    #[tokio::test]
    async fn deberia_devolver_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(|_| Ok(None));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Mundo".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let saludo = resultado.unwrap();
        assert_eq!(saludo.nombre, "Mundo");
        assert!(saludo.mensaje.contains("Mundo"));
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_el_nombre_esta_vacio() {
        // Preparar
        let repositorio_doble = MockRepositorioSaludo::new();
        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo { nombre: "".into() })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "saludo.validacion.nombre_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_el_saludo_guardado_cuando_esta_en_el_repositorio() {
        // Preparar
        let en_cache = Saludo {
            nombre: "Puerto".into(),
            mensaje: "¡Hola desde la caché!".into(),
        };
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(move |_| Ok(Some(en_cache.clone())));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Puerto".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().mensaje, "¡Hola desde la caché!");
    }
}

=== contextos/saludo/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ParamsObtenerSaludo};
use poem_openapi::{OpenApi, Tags, param::Path};

use crate::{dto::DtoSaludo, errores::a_respuesta_error, respuestas::RespuestaObtenerSaludo};

#[derive(Tags)]
enum ApiTags {
    Saludo,
}

/// Guarda el puerto del caso de uso; `generado/bootstrap.rs` conecta la implementación.
pub struct ApiSaludo {
    pub obtener_saludo: Arc<dyn ObtenerSaludo>,
}

#[OpenApi]
impl ApiSaludo {
    /// Obtiene un saludo para el nombre dado
    #[oai(path = "/saludos/:nombre", method = "get", tag = "ApiTags::Saludo")]
    async fn obtener_saludo(&self, nombre: Path<String>) -> RespuestaObtenerSaludo {
        match self
            .obtener_saludo
            .ejecutar(ParamsObtenerSaludo { nombre: nombre.0 })
            .await
        {
            Ok(saludo) => RespuestaObtenerSaludo::Ok(poem_openapi::payload::Json(
                DtoSaludo::from_dominio(&saludo),
            )),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_saludo falló");
                RespuestaObtenerSaludo::from_status(status, error)
            }
        }
    }
}

