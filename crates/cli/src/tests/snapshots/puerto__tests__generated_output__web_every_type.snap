import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CaseMother, fakeCaseRepository } from "../../../../test-support/case";
import { renderScreen } from "../../../../test-support/render";
import { CaseDetailContainer } from "./case-detail-container";

describe("CaseDetailContainer", () => {
  test("should show the case when it exists", async () => {
    // Arrange
    const seeded = CaseMother.random();
    const caseRepository = fakeCaseRepository([seeded]);

    // Act
    renderScreen(<CaseDetailContainer id={seeded.id} />, { caseRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the case does not exist", async () => {
    // Arrange
    const caseRepository = fakeCaseRepository();

    // Act
    renderScreen(<CaseDetailContainer id={crypto.randomUUID()} />, { caseRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("case.not_found");
  });

  test("should delete the case only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = CaseMother.random();
    const fake = fakeCaseRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<CaseDetailContainer id={seeded.id} />, {
      caseRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/cases"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/case/containers/case-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { CaseDetailView } from "../views/case-detail-view";

export function CaseDetailContainer({ id }: { id: string }) {
  const { caseRepository } = useDependencies();
  const caseItem = useAsync(() => caseRepository.get(id), [caseRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await caseRepository.remove(id);
      navigate("/cases");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Case</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {caseItem.status === "loading" && <span className="loading loading-spinner" />}
      {caseItem.status === "error" && <ErrorAlert error={caseItem.error} />}
      {caseItem.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <CaseDetailView caseItem={caseItem.data} />
            <div className="card-actions justify-end">
              <Link href={`/cases/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/cases" className="link">
        Back to cases
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this case?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/case/containers/case-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { CaseError } from "../../../../domain/case/errors";
import type { CaseDraft } from "../../../../domain/case/model";
import { CaseMother, fakeCaseRepository } from "../../../../test-support/case";
import { renderScreen } from "../../../../test-support/render";
import { formatEntries, textOf, toDateTimeLocal } from "../../../shared/forms";
import { CaseFormContainer } from "./case-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: CaseDraft) {
  await screen.findByText("Save");
  type("Title", draft.title);
  type("Summary", textOf(draft.summary));
  type("Views", textOf(draft.views));
  type("Ratio", textOf(draft.ratio));
  type("Urgent", textOf(draft.urgent));
  type("Due at", toDateTimeLocal(draft.dueAt));
  type("Opened at", toDateTimeLocal(draft.openedAt));
  type("Tags", draft.tags.join(", "));
  type("Scores", draft.scores.join(", "));
  type("Meta", formatEntries(draft.meta));
  type("Status", draft.status);
  type("Middle name", textOf(draft.middleName));
  type("Labels", draft.labels.join(", "));
}

describe("CaseFormContainer", () => {
  test("should create the case from what was typed and show it", async () => {
    // Arrange
    const draft = CaseMother.draft();
    const caseRepository = fakeCaseRepository();
    const { history } = renderScreen(<CaseFormContainer />, { caseRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/cases/"));
    const {
      items: [created],
    } = await caseRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/cases/${created?.id}`);
  });

  test("should save the edited case when an existing one is submitted", async () => {
    // Arrange
    const seeded = CaseMother.random();
    const caseRepository = fakeCaseRepository([seeded]);
    const { history } = renderScreen(<CaseFormContainer id={seeded.id} />, {
      caseRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/cases/${seeded.id}`));
    expect(await caseRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "case.validation_error.invalid";
    const caseRepository = {
      ...fakeCaseRepository(),
      create: () => Promise.reject(new CaseError(code)),
    };
    renderScreen(<CaseFormContainer />, { caseRepository });
    await fillIn(CaseMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a case with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const caseRepository = {
      ...fakeCaseRepository(),
      create: () => Promise.reject(new CaseError("case.duplicate")),
    };
    renderScreen(<CaseFormContainer />, { caseRepository });
    await fillIn(CaseMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A case with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const caseRepository = {
      ...fakeCaseRepository(),
      create: () => Promise.reject(new CaseError("case.validation_error.title_empty")),
    };
    renderScreen(<CaseFormContainer />, { caseRepository });
    await fillIn(CaseMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Title is required")).toBeTruthy();
    const input = screen.getByLabelText("Title");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/case/containers/case-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/case/messages";
import type { Case } from "../../../../domain/case/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { CaseFormView, toCaseDraft, toCaseForm } from "../views/case-form-view";

/** Creates a case, or edits the one with `id`. */
export function CaseFormContainer({ id }: { id?: string }) {
  const { caseRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : caseRepository.get(id)),
    [caseRepository, id],
  );
  const title = id === undefined ? "New case" : "Edit case";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <CaseForm existing={existing.data} />}
      <Link href={id === undefined ? "/cases" : `/cases/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function CaseForm({ existing }: { existing: Case | null }) {
  const { caseRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toCaseForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toCaseDraft(values);
      const saved =
        existing === null
          ? await caseRepository.create(draft)
          : await caseRepository.update(existing.id, draft);
      navigate(`/cases/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <CaseFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

