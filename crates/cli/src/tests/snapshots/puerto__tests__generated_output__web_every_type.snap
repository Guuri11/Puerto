=== business/src/domain/case/value_objects.rs ===
use super::errors::CaseError;

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Open,
    Closed,
}

impl std::str::FromStr for Status {
    type Err = CaseError;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Open" => Ok(Self::Open),
            "Closed" => Ok(Self::Closed),
            _ => Err(CaseError::InvalidStatus),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Open => "Open",
            Self::Closed => "Closed",
        }
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct MiddleName {
    value: String,
}

impl MiddleName {
    pub fn new(value: String) -> Result<Self, CaseError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(CaseError::InvalidMiddleName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Label {
    value: String,
}

impl Label {
    pub fn new(value: String) -> Result<Self, CaseError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(CaseError::InvalidLabel);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

