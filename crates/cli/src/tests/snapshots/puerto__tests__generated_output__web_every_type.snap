use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::case::{
    errors::CaseError,
    model::Case,
    repository::CaseRepositoryTrait,
    use_cases::get_case::{GetCaseParams, GetCaseUseCaseTrait},
};

pub struct GetCaseUseCaseImpl {
    pub repository: Arc<dyn CaseRepositoryTrait>,
}

#[async_trait]
impl GetCaseUseCaseTrait for GetCaseUseCaseImpl {
    async fn execute(&self, params: GetCaseParams) -> Result<Case, CaseError> {
        tracing::info!(id = %params.id, "get_case: start");
        let result = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "get_case: repository failed"))?;
        result.ok_or_else(|| {
            let err = CaseError::NotFound;
            tracing::warn!(error = %err, "get_case: rejected");
            err
        })
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::case::value_objects::Status;
    use crate::domain::case::{
        model::{Case, CaseId, CaseProps},
        repository::mocks::MockCaseRepository,
    };
    use chrono::Utc;
    use puerto_core::RepositoryError;
    use std::collections::HashMap;

    #[tokio::test]
    async fn should_return_case_when_id_exists() {
        let entity = Case::new(CaseProps {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = GetCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(GetCaseParams { id: entity_id }).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_not_found_when_id_does_not_exist() {
        let mut mock_repo = MockCaseRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = GetCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetCaseParams {
                id: CaseId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "case.not_found");
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_store_is_unavailable() {
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(|_| Err(RepositoryError::Unavailable));
        let use_case = GetCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetCaseParams {
                id: CaseId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "case.repository_error");
    }
}

