=== web/src/domain/case/errors.ts ===
/**
 * A request about a case that the API refused. `code` is the API's `ErrorResponse.name`:
 * `case.not_found`, `case.validation_error.<field>_empty`.
 */
export class CaseError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "CaseError";
    this.code = code;
  }
}

=== web/src/domain/case/messages.ts ===
import type { CaseDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface CaseProblem {
  field: keyof CaseDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "case.validation_error.title_empty": "Title is required",
  "case.invalid_status": "Status is not valid",
  "case.invalid_middle_name": "Middle name is not valid",
  "case.invalid_label": "Labels are not valid",
  "case.duplicate": "A case with these values already exists",
  "case.not_found": "This case no longer exists",
  "case.repository_error": "The case could not be saved, try again later",
  "case.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof CaseDraft> = {
  "case.validation_error.title_empty": "title",
  "case.invalid_status": "status",
  "case.invalid_middle_name": "middleName",
  "case.invalid_label": "labels",
};

export function toProblem(code: string): CaseProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/domain/case/model.ts ===
import { CaseError } from "./errors";

export interface Case {
  id: string;
  title: string;
  summary: string | null;
  views: number | null;
  ratio: number | null;
  urgent: boolean | null;
  dueAt: string | null;
  openedAt: string;
  tags: string[];
  scores: number[];
  meta: Record<string, string>;
  status: Status;
  middleName: string | null;
  labels: string[];
}

/** What a create or an update sends: a case without its id. */
export type CaseDraft = Omit<Case, "id">;

export const statusValues = ["Open", "Closed"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `case.invalid_status`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new CaseError("case.invalid_status");
  return found;
}

=== web/src/domain/case/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Case, CaseDraft } from "./model";

/** The port the screens call. Every method rejects with the `CaseError` the API answered. */
export interface CaseRepository {
  list(page: PageRequest): Promise<Page<Case>>;
  get(id: string): Promise<Case>;
  create(draft: CaseDraft): Promise<Case>;
  update(id: string, draft: CaseDraft): Promise<Case>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/case/case-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { CaseError } from "../../domain/case/errors";
import { CaseMother } from "../../test-support/case";
import { createApiClient } from "../http/client";
import { caseRepositoryHttp } from "./case-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: caseRepositoryHttp(api), requests };
}

describe("caseRepositoryHttp", () => {
  test("should ask for the page and return its cases", async () => {
    // Arrange
    const caseItem = CaseMother.random();
    const page = { items: [caseItem], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/cases?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating a case", async () => {
    // Arrange
    const draft = CaseMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the case does not exist", async () => {
    // Arrange
    const code = "case.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(CaseError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the case", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/cases/42");
  });
});

=== web/src/infrastructure/case/case-repository-http.ts ===
import { CaseError } from "../../domain/case/errors";
import { type Case, type CaseDraft, parseStatus } from "../../domain/case/model";
import type { CaseRepository } from "../../domain/case/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type CaseDto = components["schemas"]["CaseDto"];
type CaseRequest = components["schemas"]["CreateCaseRequest"];

function toCase(dto: CaseDto): Case {
  return {
    id: dto.id,
    title: dto.title,
    summary: dto.summary ?? null,
    views: dto.views ?? null,
    ratio: dto.ratio ?? null,
    urgent: dto.urgent ?? null,
    dueAt: dto.dueAt ?? null,
    openedAt: dto.openedAt,
    tags: dto.tags,
    scores: dto.scores,
    meta: dto.meta,
    status: parseStatus(dto.status),
    middleName: dto.middleName ?? null,
    labels: dto.labels,
  };
}

function toRequest(draft: CaseDraft): CaseRequest {
  return {
    title: draft.title,
    summary: draft.summary ?? undefined,
    views: draft.views ?? undefined,
    ratio: draft.ratio ?? undefined,
    urgent: draft.urgent ?? undefined,
    dueAt: draft.dueAt ?? undefined,
    openedAt: draft.openedAt,
    tags: draft.tags,
    scores: draft.scores,
    meta: draft.meta,
    status: draft.status,
    middleName: draft.middleName ?? undefined,
    labels: draft.labels,
  };
}

/** `CaseRepository` over the REST API (`/cases`). */
export function caseRepositoryHttp(api: ApiClient): CaseRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/cases", {
        params: { query: page },
      });
      if (data === undefined) throw new CaseError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toCase) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/cases/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new CaseError(apiErrorCode(error, response));
      return toCase(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/cases", { body: toRequest(draft) });
      if (data === undefined) throw new CaseError(apiErrorCode(error, response));
      return toCase(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/cases/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new CaseError(apiErrorCode(error, response));
      return toCase(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/cases/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new CaseError(apiErrorCode(error, response));
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

