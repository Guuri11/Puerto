pub mod repositorio;

=== contextos/case/infraestructura/src/repositorio.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use dominio_case::{
    modelo::{Case, IdCase},
    repositorio::RepositorioCase,
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

/// Guarda cases en la memoria del proceso: se pierden cuando el proceso se para.
/// Como el adaptador de Postgres, oculta las filas borradas y lista primero las más recientes.
/// Cubre el hueco hasta que haya base de datos (`puerto nuevo --db` genera repositorios Postgres).
#[derive(Default)]
pub struct RepositorioCaseEnMemoria {
    filas: RwLock<HashMap<IdCase, Case>>,
}

impl RepositorioCaseEnMemoria {
    pub fn new() -> Self {
        Self::default()
    }

    // Un cerrojo envenenado significa que un escritor hizo panic; cada escritura es un solo
    // insert, así que el mapa sigue entero y se usa tal cual.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<IdCase, Case>> {
        self.filas.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<IdCase, Case>> {
        self.filas.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl RepositorioCase for RepositorioCaseEnMemoria {
    async fn buscar_todos(&self, pagina: PeticionPagina) -> Result<Pagina<Case>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        let filas = self.read();
        let mut vivos: Vec<&Case> = filas.values().filter(|fila| !fila.borrado).collect();
        vivos.sort_by(|a, b| {
            b.creado_en
                .cmp(&a.creado_en)
                .then_with(|| a.id.valor().cmp(&b.id.valor()))
        });
        let total = vivos.len() as u64;
        let elementos = vivos
            .into_iter()
            .skip(pagina.desplazamiento() as usize)
            .take(pagina.limite() as usize)
            .cloned()
            .collect();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdCase) -> Result<Option<Case>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        Ok(self.read().get(&id).filter(|fila| !fila.borrado).cloned())
    }

    async fn guardar(&self, entidad: &Case) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let mut filas = self.write();
        filas.insert(entidad.id, entidad.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_case::modelo::PropsCase;
    use dominio_case::valores::Status;

    fn new_case() -> Case {
        Case::new(PropsCase {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: chrono::DateTime::from_timestamp(1_700_000_000, 0).unwrap(),
            tags: vec![],
            scores: vec![],
            meta: std::collections::HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        })
        .unwrap()
    }

    #[tokio::test]
    async fn deberia_encontrar_case_por_id_tras_guardar() {
        // Preparar
        let repositorio = RepositorioCaseEnMemoria::new();
        let entidad = new_case();
        repositorio.guardar(&entidad).await.unwrap();

        // Actuar
        let encontrado = repositorio.buscar_por_id(entidad.id).await.unwrap();

        // Comprobar
        assert_eq!(encontrado.map(|fila| fila.id), Some(entidad.id));
    }

    #[tokio::test]
    async fn deberia_actualizar_la_fila_cuando_se_guarda_de_nuevo() {
        // Preparar
        let repositorio = RepositorioCaseEnMemoria::new();
        let mut entidad = new_case();
        repositorio.guardar(&entidad).await.unwrap();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        repositorio.guardar(&entidad).await.unwrap();

        // Comprobar
        let pagina = repositorio
            .buscar_todos(PeticionPagina::default())
            .await
            .unwrap();
        assert_eq!(pagina.total, 1);
        assert_eq!(pagina.elementos[0].actualizado_en, entidad.actualizado_en);
    }

    #[tokio::test]
    async fn no_deberia_encontrar_case_tras_su_borrado() {
        // Preparar
        let repositorio = RepositorioCaseEnMemoria::new();
        let mut entidad = new_case();
        entidad.borrado = true;
        entidad.borrado_en = Some(entidad.actualizado_en);
        repositorio.guardar(&entidad).await.unwrap();

        // Actuar
        let encontrado = repositorio.buscar_por_id(entidad.id).await.unwrap();
        let pagina = repositorio
            .buscar_todos(PeticionPagina::default())
            .await
            .unwrap();

        // Comprobar
        assert!(encontrado.is_none());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor() {
        // Preparar
        let repositorio = RepositorioCaseEnMemoria::new();
        for _ in 0..3 {
            repositorio.guardar(&new_case()).await.unwrap();
        }

        // Actuar
        let pagina = repositorio
            .buscar_todos(PeticionPagina::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }
}

