use super::value_objects::Label;
use super::value_objects::MiddleName;
use super::value_objects::Status;
use chrono::{DateTime, Utc};
use std::collections::HashMap;
use uuid::Uuid;

use super::errors::CaseError;

/// The id of every `Case`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct CaseId(Uuid);

impl CaseId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for CaseId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct CaseProps {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: Status,
    pub middle_name: Option<MiddleName>,
    pub labels: Vec<Label>,
}

#[derive(Debug, Clone)]
pub struct Case {
    pub id: CaseId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: Status,
    pub middle_name: Option<MiddleName>,
    pub labels: Vec<Label>,
}

impl Case {
    pub fn new(props: CaseProps) -> Result<Self, CaseError> {
        if props.title.trim().is_empty() {
            return Err(CaseError::ValidationError("title_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: CaseId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            title: props.title,
            summary: props.summary,
            views: props.views,
            ratio: props.ratio,
            urgent: props.urgent,
            due_at: props.due_at,
            opened_at: props.opened_at,
            tags: props.tags,
            scores: props.scores,
            meta: props.meta,
            status: props.status,
            middle_name: props.middle_name,
            labels: props.labels,
        })
    }

    pub fn from_repository(data: Case) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_case_when_fields_are_valid() {
        let result = Case::new(CaseProps {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        });
        assert_eq!(result.unwrap().title, "example");
    }

    #[test]
    fn should_reject_case_when_title_is_empty() {
        let result = Case::new(CaseProps {
            title: "".into(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "case.validation_error.title_empty"
        );
    }

    #[test]
    fn should_reject_case_when_title_is_only_whitespace() {
        let result = Case::new(CaseProps {
            title: "   ".into(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_case_when_status_is_invalid() {
        let result = "InvalidVariant".parse::<Status>();
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "case.invalid_status");
    }
}

