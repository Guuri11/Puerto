use crate::valores::Label;
use crate::valores::MiddleName;
use crate::valores::Status;
use chrono::{DateTime, Utc};
use std::collections::HashMap;
use uuid::Uuid;

use crate::errores::ErrorCase;

/// El id de cada `Case`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdCase(Uuid);

impl IdCase {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdCase {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsCase {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: Status,
    pub middle_name: Option<MiddleName>,
    pub labels: Vec<Label>,
}

#[derive(Debug, Clone)]
pub struct Case {
    pub id: IdCase,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: Status,
    pub middle_name: Option<MiddleName>,
    pub labels: Vec<Label>,
}

impl Case {
    pub fn new(props: PropsCase) -> Result<Self, ErrorCase> {
        if props.title.trim().is_empty() {
            return Err(ErrorCase::Validacion("title_vacio".into()));
        }
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdCase::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            title: props.title,
            summary: props.summary,
            views: props.views,
            ratio: props.ratio,
            urgent: props.urgent,
            due_at: props.due_at,
            opened_at: props.opened_at,
            tags: props.tags,
            scores: props.scores,
            meta: props.meta,
            status: props.status,
            middle_name: props.middle_name,
            labels: props.labels,
        })
    }

    pub fn from_repositorio(datos: Case) -> Self {
        datos
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_crear_case_cuando_los_campos_son_validos() {
        let resultado = Case::new(PropsCase {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        });
        assert_eq!(resultado.unwrap().title, "example");
    }

    #[test]
    fn deberia_rechazar_case_cuando_title_es_una_cadena_vacia() {
        let resultado = Case::new(PropsCase {
            title: "".into(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        });
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "case.validacion.title_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_case_cuando_title_solo_tiene_espacios() {
        let resultado = Case::new(PropsCase {
            title: "   ".into(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        });
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_case_cuando_status_no_es_una_variante_conocida() {
        let resultado = "VarianteInvalida".parse::<Status>();
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "case.status_invalido");
    }
}

