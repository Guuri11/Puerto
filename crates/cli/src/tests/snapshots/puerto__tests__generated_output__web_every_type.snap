      <dd>{caseItem.labels.join(", ")}</dd>
    </dl>
  );
}

=== web/src/presentation/features/case/views/case-form-view.tsx ===
import type { CaseProblem } from "../../../../domain/case/messages";
import { type Case, type CaseDraft, parseStatus } from "../../../../domain/case/model";
import {
  booleanOrNull,
  dateTimeOrNull,
  formatEntries,
  fromDateTimeLocal,
  numberOrNull,
  parseEntries,
  splitList,
  splitNumbers,
  textOf,
  textOrNull,
  toDateTimeLocal,
} from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface CaseFormValues {
  title: string;
  summary: string;
  views: string;
  ratio: string;
  urgent: string;
  dueAt: string;
  openedAt: string;
  tags: string;
  scores: string;
  meta: string;
  status: string;
  middleName: string;
  labels: string;
}

/** The inputs for `caseItem`, empty when there is none yet. */
export function toCaseForm(caseItem: Case | null): CaseFormValues {
  if (caseItem === null) {
    return {
      title: "",
      summary: "",
      views: "",
      ratio: "",
      urgent: "",
      dueAt: "",
      openedAt: "",
      tags: "",
      scores: "",
      meta: "",
      status: "",
      middleName: "",
      labels: "",
    };
  }
  return {
    title: caseItem.title,
    summary: textOf(caseItem.summary),
    views: textOf(caseItem.views),
    ratio: textOf(caseItem.ratio),
    urgent: textOf(caseItem.urgent),
    dueAt: toDateTimeLocal(caseItem.dueAt),
    openedAt: toDateTimeLocal(caseItem.openedAt),
    tags: caseItem.tags.join(", "),
    scores: caseItem.scores.join(", "),
    meta: formatEntries(caseItem.meta),
    status: caseItem.status,
    middleName: textOf(caseItem.middleName),
    labels: caseItem.labels.join(", "),
  };
}

export function toCaseDraft(values: CaseFormValues): CaseDraft {
  return {
    title: values.title,
    summary: textOrNull(values.summary),
    views: numberOrNull(values.views),
    ratio: numberOrNull(values.ratio),
    urgent: booleanOrNull(values.urgent),
    dueAt: dateTimeOrNull(values.dueAt),
    openedAt: fromDateTimeLocal(values.openedAt),
    tags: splitList(values.tags),
    scores: splitNumbers(values.scores),
    meta: parseEntries(values.meta),
    status: parseStatus(values.status),
    middleName: textOrNull(values.middleName),
    labels: splitList(values.labels),
  };
}

export function CaseFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: CaseFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: CaseProblem | null;
  onChange: (values: CaseFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Title</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "title"}
          required
          value={values.title}
          onChange={(event) => onChange({ ...values, title: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="title" />
      <label className="fieldset">
        <span className="fieldset-legend">Summary</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "summary"}
          value={values.summary}
          onChange={(event) => onChange({ ...values, summary: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="summary" />
      <label className="fieldset">
        <span className="fieldset-legend">Views</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "views"}
          value={values.views}
          onChange={(event) => onChange({ ...values, views: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="views" />
      <label className="fieldset">
        <span className="fieldset-legend">Ratio</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "ratio"}
          step="any"
          value={values.ratio}
          onChange={(event) => onChange({ ...values, ratio: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="ratio" />
      <label className="fieldset">
        <span className="fieldset-legend">Urgent</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "urgent"}
          value={values.urgent}
          onChange={(event) => onChange({ ...values, urgent: event.target.value })}
        >
          <option value="">—</option>
          <option value="true">Yes</option>
          <option value="false">No</option>
        </select>
      </label>
      <FieldError problem={problem} field="urgent" />
      <label className="fieldset">
        <span className="fieldset-legend">Due at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problem?.field === "dueAt"}
          value={values.dueAt}
          onChange={(event) => onChange({ ...values, dueAt: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="dueAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Opened at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problem?.field === "openedAt"}
          required
          value={values.openedAt}
          onChange={(event) => onChange({ ...values, openedAt: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="openedAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "tags"}
          value={values.tags}
          onChange={(event) => onChange({ ...values, tags: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Scores</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "scores"}
          value={values.scores}
          onChange={(event) => onChange({ ...values, scores: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="scores" />
      <label className="fieldset">
        <span className="fieldset-legend">Meta</span>
        <textarea
          className="textarea w-full"
          aria-invalid={problem?.field === "meta"}
          placeholder="key=value, one per line"
          value={values.meta}
          onChange={(event) => onChange({ ...values, meta: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="meta" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "status"}
          required
          value={values.status}
          onChange={(event) => onChange({ ...values, status: event.target.value })}
        >
          <option value="">Choose…</option>
          <option value="Open">Open</option>
          <option value="Closed">Closed</option>
        </select>
      </label>
      <FieldError problem={problem} field="status" />
      <label className="fieldset">
        <span className="fieldset-legend">Middle name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "middleName"}
          value={values.middleName}
          onChange={(event) => onChange({ ...values, middleName: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="middleName" />
      <label className="fieldset">
        <span className="fieldset-legend">Labels</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "labels"}
          value={values.labels}
          onChange={(event) => onChange({ ...values, labels: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="labels" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

=== web/src/presentation/features/case/views/case-list-view.tsx ===
import { Link } from "wouter";
import type { Case } from "../../../../domain/case/model";
import { formatDateTime, formatEntries } from "../../../shared/forms";

export function CaseListView({ cases }: { cases: Case[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Summary</th>
            <th>Views</th>
            <th>Ratio</th>
            <th>Urgent</th>
            <th>Due at</th>
            <th>Opened at</th>
            <th>Tags</th>
            <th>Scores</th>
            <th>Meta</th>
            <th>Status</th>
            <th>Middle name</th>
            <th>Labels</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {cases.map((caseItem) => (
            <tr key={caseItem.id}>
              <td>{caseItem.title}</td>
              <td>{caseItem.summary ?? "—"}</td>
              <td>{caseItem.views ?? "—"}</td>
              <td>{caseItem.ratio ?? "—"}</td>
              <td>{caseItem.urgent === null ? "—" : caseItem.urgent ? "Yes" : "No"}</td>
              <td>{caseItem.dueAt === null ? "—" : formatDateTime(caseItem.dueAt)}</td>
              <td>{formatDateTime(caseItem.openedAt)}</td>
              <td>{caseItem.tags.join(", ")}</td>
              <td>{caseItem.scores.join(", ")}</td>
              <td>{formatEntries(caseItem.meta, ", ")}</td>
              <td>{caseItem.status}</td>
              <td>{caseItem.middleName ?? "—"}</td>
              <td>{caseItem.labels.join(", ")}</td>
              <td className="text-right">
                <Link href={`/cases/${caseItem.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/case.ts ===
import { CaseError } from "../domain/case/errors";
import type { Case, CaseDraft } from "../domain/case/model";
import type { CaseRepository } from "../domain/case/repository";

/** Valid cases for tests; pass `overrides` for the fields a test is about. */
export const CaseMother = {
  draft(overrides: Partial<CaseDraft> = {}): CaseDraft {
    return {
      title: "example",
      summary: "example",
      views: 42,
      ratio: 1.5,
      urgent: true,
      dueAt: "2026-01-01T10:00:00.000Z",
      openedAt: "2026-01-01T10:00:00.000Z",
      tags: ["example"],
      scores: [42],
      meta: { key: "value" },
      status: "Open",
      middleName: "example",
      labels: ["example"],
      ...overrides,
    };
  },

  random(overrides: Partial<Case> = {}): Case {
    return { id: crypto.randomUUID(), ...CaseMother.draft(), ...overrides };
  },
};

/** An in-memory `CaseRepository`. Override a method to make it fail. */
export function fakeCaseRepository(seed: Case[] = []): CaseRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new CaseError("case.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
