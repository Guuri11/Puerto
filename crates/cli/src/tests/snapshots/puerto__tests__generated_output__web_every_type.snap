=== contextos/case/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorCase {
    #[error("case.validacion.{0}")]
    Validacion(String),
    #[error("case.no_encontrado")]
    NoEncontrado,
    #[error("case.duplicado")]
    Duplicado,
    #[error("case.repositorio")]
    Repositorio,
    #[error("case.desconocido")]
    Desconocido,
    #[error("case.status_invalido")]
    StatusInvalido,
    #[error("case.middle_name_invalido")]
    MiddleNameInvalido,
    #[error("case.label_invalido")]
    LabelInvalido,
}

impl From<ErrorRepositorio> for ErrorCase {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorCase::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "case.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorCase::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "case.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorCase::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "case.repositorio");
    }
}

