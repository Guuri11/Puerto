use std::sync::Arc;

use crate::domain::case::value_objects::Label;
use crate::domain::case::value_objects::MiddleName;
use crate::domain::case::value_objects::Status;
use async_trait::async_trait;

use crate::domain::case::{
    errors::CaseError,
    model::{Case, CaseProps},
    repository::CaseRepositoryTrait,
    use_cases::create_case::{CreateCaseParams, CreateCaseUseCaseTrait},
};

pub struct CreateCaseUseCaseImpl {
    pub repository: Arc<dyn CaseRepositoryTrait>,
}

#[async_trait]
impl CreateCaseUseCaseTrait for CreateCaseUseCaseImpl {
    async fn execute(&self, params: CreateCaseParams) -> Result<Case, CaseError> {
        tracing::info!("create_case: start");
        let status = params.status.parse::<Status>()?;
        let middle_name = params.middle_name.map(MiddleName::new).transpose()?;
        let labels: Vec<Label> = params
            .labels
            .into_iter()
            .map(Label::new)
            .collect::<Result<Vec<_>, _>>()?;
        let entity = Case::new(CaseProps {
            title: params.title,
            summary: params.summary,
            views: params.views,
            ratio: params.ratio,
            urgent: params.urgent,
            due_at: params.due_at,
            opened_at: params.opened_at,
            tags: params.tags,
            scores: params.scores,
            meta: params.meta,
            status,
            middle_name,
            labels,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_case: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_case: repository failed"))?;
        tracing::info!(id = %entity.id, "create_case: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::case::repository::mocks::MockCaseRepository;
    use chrono::Utc;
    use puerto_core::RepositoryError;
    use std::collections::HashMap;

    #[tokio::test]
    async fn should_create_case_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockCaseRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateCaseParams {
                title: "example".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: "Open".to_string(),
                middle_name: None,
                labels: vec![],
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().title, "example");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(RepositoryError::Duplicate));
        let use_case = CreateCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateCaseParams {
                title: "example".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: "Open".to_string(),
                middle_name: None,
                labels: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "case.duplicate");
    }

    #[tokio::test]
    async fn should_return_error_when_title_is_empty() {
        // Arrange
        let mock_repo = MockCaseRepository::new();
        let use_case = CreateCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateCaseParams {
                title: "".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: "Open".to_string(),
                middle_name: None,
                labels: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "case.validation_error.title_empty"
        );
    }

    #[tokio::test]
    async fn should_return_error_when_status_is_empty() {
        // Arrange
        let mock_repo = MockCaseRepository::new();
        let use_case = CreateCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateCaseParams {
                title: "example".to_string(),
                summary: None,
                views: None,
                ratio: None,
                urgent: None,
                due_at: None,
                opened_at: Utc::now(),
                tags: vec![],
                scores: vec![],
                meta: HashMap::new(),
                status: "".to_string(),
                middle_name: None,
                labels: vec![],
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "case.invalid_status");
    }
}

=== business/src/application/case/delete_case.rs ===
use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::case::{
    errors::CaseError,
    repository::CaseRepositoryTrait,
    use_cases::delete_case::{DeleteCaseParams, DeleteCaseUseCaseTrait},
};

pub struct DeleteCaseUseCaseImpl {
    pub repository: Arc<dyn CaseRepositoryTrait>,
}

#[async_trait]
impl DeleteCaseUseCaseTrait for DeleteCaseUseCaseImpl {
    async fn execute(&self, params: DeleteCaseParams) -> Result<(), CaseError> {
        tracing::info!(id = %params.id, "delete_case: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_case: repository failed"))?
            .ok_or_else(|| {
                let err = CaseError::NotFound;
                tracing::warn!(error = %err, "delete_case: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_case: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::case::value_objects::Status;
    use crate::domain::case::{
        model::{Case, CaseId, CaseProps},
        repository::mocks::MockCaseRepository,
    };
    use chrono::Utc;
    use std::collections::HashMap;

    #[tokio::test]
    async fn should_soft_delete_case_when_id_exists() {
        let entity = Case::new(CaseProps {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: Status::Open,
            middle_name: None,
            labels: vec![],
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCaseRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(DeleteCaseParams { id: entity_id }).await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_case_does_not_exist() {
        let mut mock_repo = MockCaseRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteCaseUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteCaseParams {
                id: CaseId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "case.not_found");
    }
}

