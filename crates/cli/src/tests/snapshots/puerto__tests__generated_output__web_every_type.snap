// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::case::create_case::CreateCaseUseCaseImpl;
use business::application::case::delete_case::DeleteCaseUseCaseImpl;
use business::application::case::get_case::GetCaseUseCaseImpl;
use business::application::case::list_cases::ListCasesUseCaseImpl;
use business::application::case::update_case::UpdateCaseUseCaseImpl;
use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;

use business::domain::case::repository::CaseRepositoryTrait;
use business::domain::greeting::repository::GreetingRepositoryTrait;
use infrastructure::case::repository::InMemoryCaseRepository;
use infrastructure::greeting::repository::InMemoryGreetingRepository;

use poem::Endpoint;
use poem_openapi::OpenApiService;

use crate::api::case::routes::CaseApi;
use crate::api::greeting::routes::GreetingApi;

/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl {
        repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait>,
    });
    let greeting_api = GreetingApi { get_greeting };

    let case_repo: Arc<dyn CaseRepositoryTrait> = Arc::new(InMemoryCaseRepository::new());
    let create_case = Arc::new(CreateCaseUseCaseImpl {
        repository: Arc::clone(&case_repo),
    });
    let get_case = Arc::new(GetCaseUseCaseImpl {
        repository: Arc::clone(&case_repo),
    });
    let list_cases = Arc::new(ListCasesUseCaseImpl {
        repository: Arc::clone(&case_repo),
    });
    let update_case = Arc::new(UpdateCaseUseCaseImpl {
        repository: Arc::clone(&case_repo),
    });
    let delete_case = Arc::new(DeleteCaseUseCaseImpl {
        repository: case_repo,
    });
    let case_api = CaseApi {
        create_case,
        get_case,
        list_cases,
        update_case,
        delete_case,
    };

    let ready = puerto_web::health::always_ready();

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::routes(
        openapi_service((greeting_api, case_api)),
        &config,
        ready,
    )))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;

    use business::domain::case::use_cases::create_case::mocks::MockCreateCaseUseCase;
    use business::domain::case::use_cases::delete_case::mocks::MockDeleteCaseUseCase;
    use business::domain::case::use_cases::get_case::mocks::MockGetCaseUseCase;
    use business::domain::case::use_cases::list_cases::mocks::MockListCasesUseCase;
    use business::domain::case::use_cases::update_case::mocks::MockUpdateCaseUseCase;
    use business::domain::greeting::use_cases::get_greeting::mocks::MockGetGreetingUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let greeting_api = GreetingApi {
            get_greeting: Arc::new(MockGetGreetingUseCase::new()),
        };
        let case_api = CaseApi {
            create_case: Arc::new(MockCreateCaseUseCase::new()),
            get_case: Arc::new(MockGetCaseUseCase::new()),
            list_cases: Arc::new(MockListCasesUseCase::new()),
            update_case: Arc::new(MockUpdateCaseUseCase::new()),
            delete_case: Arc::new(MockDeleteCaseUseCase::new()),
        };
        let spec = openapi_service((greeting_api, case_api)).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

