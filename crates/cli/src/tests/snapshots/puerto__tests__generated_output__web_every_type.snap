=== presentation/src/api/case/routes.rs ===
use std::sync::Arc;

use business::domain::case::model::CaseId;
use business::domain::case::use_cases::{
    create_case::{CreateCaseParams, CreateCaseUseCaseTrait},
    delete_case::{DeleteCaseParams, DeleteCaseUseCaseTrait},
    get_case::{GetCaseParams, GetCaseUseCaseTrait},
    list_cases::{ListCasesParams, ListCasesUseCaseTrait},
    update_case::{UpdateCaseParams, UpdateCaseUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use puerto_core::PageRequest;
use uuid::Uuid;

use crate::api::case::dto::{CaseDto, CasePageDto, CreateCaseRequest, UpdateCaseRequest};
use crate::api::case::responses::{
    CreateCaseResponse, DeleteCaseResponse, GetCaseResponse, ListCasesResponse, UpdateCaseResponse,
};
use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct CaseApi {
    pub create_case: Arc<dyn CreateCaseUseCaseTrait>,
    pub get_case: Arc<dyn GetCaseUseCaseTrait>,
    pub list_cases: Arc<dyn ListCasesUseCaseTrait>,
    pub update_case: Arc<dyn UpdateCaseUseCaseTrait>,
    pub delete_case: Arc<dyn DeleteCaseUseCaseTrait>,
}

#[OpenApi]
impl CaseApi {
    /// Create a new Case
    #[oai(path = "/cases", method = "post", tag = "ApiTags::Case")]
    async fn create(&self, body: Json<CreateCaseRequest>) -> CreateCaseResponse {
        match self
            .create_case
            .execute(CreateCaseParams {
                title: body.title.clone(),
                summary: body.summary.clone(),
                views: body.views,
                ratio: body.ratio,
                urgent: body.urgent,
                due_at: body.due_at,
                opened_at: body.opened_at,
                tags: body.tags.clone(),
                scores: body.scores.clone(),
                meta: body.meta.clone(),
                status: body.status.clone(),
                middle_name: body.middle_name.clone(),
                labels: body.labels.clone(),
            })
            .await
        {
            Ok(entity) => CreateCaseResponse::Created(Json(CaseDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_case failed");
                CreateCaseResponse::from_status(status, error)
            }
        }
    }

    /// Get a Case by ID
    #[oai(path = "/cases/:id", method = "get", tag = "ApiTags::Case")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetCaseResponse {
        match self
            .get_case
            .execute(GetCaseParams {
                id: CaseId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetCaseResponse::Ok(Json(CaseDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_case failed");
                GetCaseResponse::from_status(status, error)
            }
        }
    }

    /// List Cases, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/cases", method = "get", tag = "ApiTags::Case")]
    async fn list(
        &self,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
    ) -> ListCasesResponse {
        match self
            .list_cases
            .execute(ListCasesParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListCasesResponse::Ok(Json(CasePageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_cases failed");
                ListCasesResponse::from_status(status, error)
            }
        }
    }

    /// Update a Case
    #[oai(path = "/cases/:id", method = "put", tag = "ApiTags::Case")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateCaseRequest>) -> UpdateCaseResponse {
        match self
            .update_case
            .execute(UpdateCaseParams {
                id: CaseId::from_uuid(id.0),
                title: body.title.clone(),
                summary: body.summary.clone(),
                views: body.views,
                ratio: body.ratio,
                urgent: body.urgent,
                due_at: body.due_at,
                opened_at: body.opened_at,
                tags: body.tags.clone(),
                scores: body.scores.clone(),
                meta: body.meta.clone(),
                status: body.status.clone(),
                middle_name: body.middle_name.clone(),
                labels: body.labels.clone(),
            })
            .await
        {
            Ok(entity) => UpdateCaseResponse::Ok(Json(CaseDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_case failed");
                UpdateCaseResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Case
    #[oai(path = "/cases/:id", method = "delete", tag = "ApiTags::Case")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteCaseResponse {
        match self
            .delete_case
            .execute(DeleteCaseParams {
                id: CaseId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteCaseResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_case failed");
                DeleteCaseResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::case::errors::CaseError;
    use business::domain::case::use_cases::{
        create_case::mocks::MockCreateCaseUseCase, delete_case::mocks::MockDeleteCaseUseCase,
        get_case::mocks::MockGetCaseUseCase, list_cases::mocks::MockListCasesUseCase,
        update_case::mocks::MockUpdateCaseUseCase,
    };
    use business::tests::mothers::case_mother::CaseMother;
    use chrono::Utc;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_core::Page;
    use std::collections::HashMap;

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateCaseUseCase,
        get: MockGetCaseUseCase,
        list: MockListCasesUseCase,
        update: MockUpdateCaseUseCase,
        delete: MockDeleteCaseUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = CaseApi {
                create_case: Arc::new(self.create),
                get_case: Arc::new(self.get),
                list_cases: Arc::new(self.list),
                update_case: Arc::new(self.update),
                delete_case: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateCaseRequest {
        CreateCaseRequest {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: "example".to_string(),
            middle_name: None,
            labels: vec![],
        }
    }

    fn update_request() -> UpdateCaseRequest {
        UpdateCaseRequest {
            title: "example".to_string(),
            summary: None,
            views: None,
            ratio: None,
            urgent: None,
            due_at: None,
            opened_at: Utc::now(),
            tags: vec![],
            scores: vec![],
            meta: HashMap::new(),
            status: "example".to_string(),
            middle_name: None,
            labels: vec![],
        }
    }

    fn item_path() -> String {
        format!("/cases/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_case_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(CaseMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/cases")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_case_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(CaseError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/cases")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_case_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(CaseMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_case_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(CaseError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_cases_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(CaseMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/cases").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks.client().get("/cases?limit=5&offset=10").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(CaseError::RepositoryError));

        // Act
        let response = mocks.client().get("/cases").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_case_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(CaseMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(CaseError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_case_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(CaseError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

