use chrono::{DateTime, Utc};
use dominio_case::modelo::Case;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use std::collections::HashMap;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoCase {
    pub id: Uuid,
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: String,
    pub middle_name: Option<String>,
    pub labels: Vec<String>,
}

impl DtoCase {
    pub fn from_dominio(entidad: &Case) -> Self {
        Self {
            id: entidad.id.valor(),
            title: entidad.title.clone(),
            summary: entidad.summary.clone(),
            views: entidad.views,
            ratio: entidad.ratio,
            urgent: entidad.urgent,
            due_at: entidad.due_at,
            opened_at: entidad.opened_at,
            tags: entidad.tags.clone(),
            scores: entidad.scores.clone(),
            meta: entidad.meta.clone(),
            status: entidad.status.as_str().to_string(),
            middle_name: entidad.middle_name.as_ref().map(|v| v.valor().to_string()),
            labels: entidad
                .labels
                .iter()
                .map(|v| v.valor().to_string())
                .collect::<Vec<_>>(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearCase {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: String,
    pub middle_name: Option<String>,
    pub labels: Vec<String>,
}

/// Una página de Cases: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaCase {
    pub elementos: Vec<DtoCase>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaCase {
    pub fn from_dominio(pagina: &Pagina<Case>) -> Self {
        Self {
            elementos: pagina.elementos.iter().map(DtoCase::from_dominio).collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarCase {
    pub title: String,
    pub summary: Option<String>,
    pub views: Option<i64>,
    pub ratio: Option<f64>,
    pub urgent: Option<bool>,
    pub due_at: Option<DateTime<Utc>>,
    pub opened_at: DateTime<Utc>,
    pub tags: Vec<String>,
    pub scores: Vec<i64>,
    pub meta: HashMap<String, String>,
    pub status: String,
    pub middle_name: Option<String>,
    pub labels: Vec<String>,
}

=== contextos/case/rest/src/errores.rs ===
use dominio_case::errores::ErrorCase;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// Un error de case como su estado HTTP y su cuerpo (ADR-0007 de Puerto): los fallos de
/// validación y los objetos valor inválidos son 422 — la petición estaba bien formada (poem
/// responde 400 a una que no lo está), pero incumple una regla del dominio. Exhaustivo a propósito:
/// una variante de error nueva no compila hasta que tiene un estado.
pub fn a_respuesta_error(err: ErrorCase) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ErrorCase::Validacion(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCase::NoEncontrado => StatusCode::NOT_FOUND,
        ErrorCase::Duplicado => StatusCode::CONFLICT,
        ErrorCase::Repositorio => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorCase::Desconocido => StatusCode::INTERNAL_SERVER_ERROR,
        ErrorCase::StatusInvalido => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCase::MiddleNameInvalido => StatusCode::UNPROCESSABLE_ENTITY,
        ErrorCase::LabelInvalido => StatusCode::UNPROCESSABLE_ENTITY,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_mapear_validacion_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::Validacion("name_vacio".into()));

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "case.validacion.name_vacio");
    }

    #[test]
    fn deberia_mapear_no_encontrado_a_404_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::NoEncontrado);

        // Comprobar
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(cuerpo.codigo, "case.no_encontrado");
    }

    #[test]
    fn deberia_mapear_duplicado_a_409_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::Duplicado);

        // Comprobar
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(cuerpo.codigo, "case.duplicado");
    }

    #[test]
    fn deberia_mapear_repositorio_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::Repositorio);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "case.repositorio");
    }

    #[test]
    fn deberia_mapear_desconocido_a_500_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::Desconocido);

        // Comprobar
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(cuerpo.codigo, "case.desconocido");
    }

    #[test]
    fn deberia_mapear_status_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::StatusInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "case.status_invalido");
    }

    #[test]
    fn deberia_mapear_middle_name_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::MiddleNameInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "case.middle_name_invalido");
    }

    #[test]
    fn deberia_mapear_label_invalido_a_422_con_su_codigo() {
        // Actuar
        let (status, Json(cuerpo)) = a_respuesta_error(ErrorCase::LabelInvalido);

        // Comprobar
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(cuerpo.codigo, "case.label_invalido");
    }
}

