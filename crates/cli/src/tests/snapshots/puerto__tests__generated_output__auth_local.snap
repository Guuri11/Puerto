import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { AuthError } from "../../domain/auth/session";
import { fakeAccounts } from "../../test-support/auth";
import { renderScreen } from "../../test-support/render";
import { RegisterPage } from "./register";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

async function fillIn() {
  await screen.findByText("I have an account");
  type("Email", "ada@example.com");
  type("Password", "correct horse battery");
}

describe("RegisterPage", () => {
  test("should sign the new account in and go back to the page that asked", async () => {
    // Arrange
    const accounts = fakeAccounts();
    const { history } = renderScreen(<RegisterPage />, { accounts }, "/register?next=%2Forders", {
      user: null,
    });
    await fillIn();

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Create account" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/orders"));
    expect(accounts.signIns).toHaveLength(1);
  });

  test("should show a taken email next to its field", async () => {
    // Arrange
    const accounts = {
      ...fakeAccounts(),
      register: () => Promise.reject(new AuthError("user.duplicate")),
    };
    renderScreen(<RegisterPage />, { accounts }, "/register", { user: null });
    await fillIn();

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Create account" }));

    // Assert
    expect(await screen.findByText("An account with this email already exists")).toBeTruthy();
    expect(screen.getByLabelText("Email").getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });

  test("should show a short password next to its field", async () => {
    // Arrange
    const accounts = {
      ...fakeAccounts(),
      register: () => Promise.reject(new AuthError("user.validation_error.password_too_short")),
    };
    renderScreen(<RegisterPage />, { accounts }, "/register", { user: null });
    await fillIn();

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Create account" }));

    // Assert
    expect(await screen.findByText("Use at least 12 characters")).toBeTruthy();
    expect(screen.getByLabelText("Password").getAttribute("aria-invalid")).toBe("true");
  });
});

=== web/src/presentation/pages/register.tsx ===
import { useState } from "react";
import { Link, useLocation, useSearch } from "wouter";
import { toAccountProblem } from "../../domain/auth/messages";
import { useAuth } from "../core/auth";
import { useDependencies } from "../core/dependencies";
import { textOrNull } from "../shared/forms";
import { ErrorAlert, errorCode } from "../shared/ui/error-alert";
import { FieldError } from "../shared/ui/field-error";
import { nextPath } from "./login";

/** Creates an account, signs in with it, and goes back where sign-in was asked for. */
export function RegisterPage() {
  const { accounts } = useDependencies();
  const { refresh } = useAuth();
  const [, navigate] = useLocation();
  const search = useSearch();
  const [values, setValues] = useState({ email: "", password: "", name: "" });
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toAccountProblem(errorCode(failure));

  const submit = async () => {
    setSaving(true);
    setFailure(null);
    try {
      await accounts.register({
        email: values.email,
        password: values.password,
        name: textOrNull(values.name),
      });
      await accounts.signIn(values.email, values.password);
      await refresh();
      navigate(nextPath(search), { replace: true });
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <section className="mx-auto max-w-sm space-y-4">
      <h1 className="text-2xl font-bold">Create an account</h1>
      {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
      <form
        className="space-y-2"
        onSubmit={(event) => {
          event.preventDefault();
          void submit();
        }}
      >
        <label className="fieldset">
          <span className="fieldset-legend">Email</span>
          <input
            className="input w-full"
            type="email"
            autoComplete="email"
            aria-invalid={problem?.field === "email"}
            required
            value={values.email}
            onChange={(event) => setValues({ ...values, email: event.target.value })}
          />
        </label>
        <FieldError problem={problem} field="email" />
        <label className="fieldset">
          <span className="fieldset-legend">Password</span>
          <input
            className="input w-full"
            type="password"
            autoComplete="new-password"
            aria-invalid={problem?.field === "password"}
            required
            minLength={12}
            value={values.password}
            onChange={(event) => setValues({ ...values, password: event.target.value })}
          />
        </label>
        <FieldError problem={problem} field="password" />
        <label className="fieldset">
          <span className="fieldset-legend">Name</span>
          <input
            className="input w-full"
            type="text"
            autoComplete="name"
            value={values.name}
            onChange={(event) => setValues({ ...values, name: event.target.value })}
          />
        </label>
        <FieldError problem={problem} field="name" />
        <button type="submit" className="btn btn-primary" disabled={saving}>
          Create account
        </button>
      </form>
      <Link href={`/login${search === "" ? "" : `?${search}`}`} className="link">
        I have an account
      </Link>
    </section>
  );
}

