import { useAuth } from "../../core/auth";

/** Who is signed in, and the button to sign in or out. */
export function UserMenu() {
  const { user, login, logout } = useAuth();
  if (user === null) {
    return (
      <button type="button" className="btn btn-ghost" onClick={() => void login()}>
        Sign in
      </button>
    );
  }
  return (
    <div className="flex items-center gap-2">
      <span className="text-sm">{user.name ?? user.email ?? "Signed in"}</span>
      <button type="button" className="btn btn-ghost btn-sm" onClick={() => void logout()}>
        Sign out
      </button>
    </div>
  );
}

=== web/src/test-support/auth.ts ===
import type { Accounts } from "../domain/auth/accounts";
import type { AuthGateway, CurrentUser } from "../domain/auth/session";
import { ROLES } from "../presentation/core/generated/roles";

/** Signed-in users for tests; pass `overrides` for what a test is about. */
export const CurrentUserMother = {
  random(overrides: Partial<CurrentUser> = {}): CurrentUser {
    const id = crypto.randomUUID();
    return { id, email: `ada-${id.slice(0, 8)}@example.com`, name: "Ada", roles: [], ...overrides };
  },

  /** Holds every role a generated screen checks: what `renderScreen` signs in by default. */
  caller(): CurrentUser {
    return CurrentUserMother.random({ roles: [...ROLES] });
  },
};

/** An `AuthGateway` with `user` signed in (`null`: nobody). `logins` records each `login` call. */
export function fakeAuthGateway({ user = null }: { user?: CurrentUser | null } = {}) {
  const logins: string[] = [];
  const gateway: AuthGateway = {
    currentUser: async () => user,
    accessToken: async () => (user === null ? null : `token-of-${user.id}`),
    login: async (returnTo) => {
      logins.push(returnTo);
    },
    completeLogin: async () => "/",
    logout: async () => {},
  };
  return { ...gateway, logins };
}

/** `Accounts` that take every registration and sign-in. `signIns` records each sign-in. */
export function fakeAccounts() {
  const signIns: { email: string; password: string }[] = [];
  const accounts: Accounts = {
    register: async ({ email, name }) => CurrentUserMother.random({ email, name }),
    signIn: async (email, password) => {
      signIns.push({ email, password });
    },
  };
  return { ...accounts, signIns };
}

