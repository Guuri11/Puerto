import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { AuthError } from "../../domain/auth/session";
import { fakeAccounts } from "../../test-support/auth";
import { renderScreen } from "../../test-support/render";
import { LoginPage, nextPath } from "./login";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

describe("LoginPage", () => {
  test("should sign in and go back to the page that asked for it", async () => {
    // Arrange
    const accounts = fakeAccounts();
    const { history } = renderScreen(
      <LoginPage />,
      { accounts },
      "/login?next=%2Forders%3Fpage%3D2",
      { user: null },
    );
    await screen.findByText("Create an account");
    type("Email", "ada@example.com");
    type("Password", "correct horse battery");

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Sign in" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/orders?page=2"));
    expect(accounts.signIns).toEqual([
      { email: "ada@example.com", password: "correct horse battery" },
    ]);
  });

  test("should say so when the email or the password is wrong", async () => {
    // Arrange
    const accounts = {
      ...fakeAccounts(),
      signIn: () => Promise.reject(new AuthError("auth.invalid_credentials")),
    };
    renderScreen(<LoginPage />, { accounts }, "/login", { user: null });
    await screen.findByText("Create an account");
    type("Email", "ada@example.com");
    type("Password", "wrong password!");

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Sign in" }));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("Wrong email or password");
  });
});

describe("nextPath", () => {
  test("should go back only to a page of this app", () => {
    expect(nextPath("next=%2Forders")).toBe("/orders");
    expect(nextPath("")).toBe("/");
    expect(nextPath("next=%2F%2Fevil.example")).toBe("/");
    expect(nextPath("next=https%3A%2F%2Fevil.example")).toBe("/");
  });
});

=== web/src/presentation/pages/login.tsx ===
import { useState } from "react";
import { Link, useLocation, useSearch } from "wouter";
import { toAccountProblem } from "../../domain/auth/messages";
import { useAuth } from "../core/auth";
import { useDependencies } from "../core/dependencies";
import { ErrorAlert, errorCode } from "../shared/ui/error-alert";
import { FieldError } from "../shared/ui/field-error";

/**
 * The page to go back to after signing in: `?next=`, when it is a path of this app — never another
 * site (`//evil.example`).
 */
export function nextPath(search: string): string {
  const next = new URLSearchParams(search).get("next");
  return next?.startsWith("/") && !next.startsWith("//") ? next : "/";
}

/** Where `RequireAuth` and a `401` send whoever is not signed in. */
export function LoginPage() {
  const { accounts } = useDependencies();
  const { refresh } = useAuth();
  const [, navigate] = useLocation();
  const search = useSearch();
  const [values, setValues] = useState({ email: "", password: "" });
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toAccountProblem(errorCode(failure));

  const submit = async () => {
    setSaving(true);
    setFailure(null);
    try {
      await accounts.signIn(values.email, values.password);
      await refresh();
      navigate(nextPath(search), { replace: true });
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <section className="mx-auto max-w-sm space-y-4">
      <h1 className="text-2xl font-bold">Sign in</h1>
      {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
      <form
        className="space-y-2"
        onSubmit={(event) => {
          event.preventDefault();
          void submit();
        }}
      >
        <label className="fieldset">
          <span className="fieldset-legend">Email</span>
          <input
            className="input w-full"
            type="email"
            autoComplete="email"
            aria-invalid={problem?.field === "email"}
            required
            value={values.email}
            onChange={(event) => setValues({ ...values, email: event.target.value })}
          />
        </label>
        <FieldError problem={problem} field="email" />
        <label className="fieldset">
          <span className="fieldset-legend">Password</span>
          <input
            className="input w-full"
            type="password"
            autoComplete="current-password"
            aria-invalid={problem?.field === "password"}
            required
            value={values.password}
            onChange={(event) => setValues({ ...values, password: event.target.value })}
          />
        </label>
        <FieldError problem={problem} field="password" />
        <button type="submit" className="btn btn-primary" disabled={saving}>
          Sign in
        </button>
      </form>
      <Link href={`/register${search === "" ? "" : `?${search}`}`} className="link">
        Create an account
      </Link>
    </section>
  );
}

