//! Yours: `puerto new --auth local` writes this file once.

use std::sync::Arc;

use async_trait::async_trait;
use puerto_core::auth::SessionStore;

use crate::domain::user::{
    errors::UserError,
    use_cases::logout::{LogoutParams, LogoutUseCaseTrait},
};

pub struct LogoutUseCaseImpl {
    pub sessions: Arc<dyn SessionStore>,
}

#[async_trait]
impl LogoutUseCaseTrait for LogoutUseCaseImpl {
    async fn execute(&self, params: LogoutParams) -> Result<(), UserError> {
        tracing::info!("logout: start");
        self.sessions.revoke(&params.token).await?;
        tracing::info!("logout: done");
        Ok(())
    }
}

#[cfg(test)]
mod tests {
