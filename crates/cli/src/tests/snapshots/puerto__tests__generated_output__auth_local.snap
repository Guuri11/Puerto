use business::domain::product::value_objects::Name;
use business::domain::product::value_objects::Status;
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use business::domain::product::{
    errors::ProductError,
    model::{Product, ProductId},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct ProductDb {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
}

impl TryFrom<ProductDb> for Product {
    type Error = ProductError;

    fn try_from(row: ProductDb) -> Result<Self, Self::Error> {
        Ok(Self::from_repository(Product {
            id: ProductId::from_uuid(row.id),
            created_at: row.created_at,
            updated_at: row.updated_at,
            deleted: row.deleted,
            deleted_at: row.deleted_at,
            name: Name::new(row.name)?,
            sku: row.sku,
            price: row.price,
            status: row.status.parse::<Status>()?,
        }))
    }
}

impl From<&Product> for ProductDb {
    fn from(entity: &Product) -> Self {
        Self {
            id: entity.id.value(),
            created_at: entity.created_at,
            updated_at: entity.updated_at,
            deleted: entity.deleted,
            deleted_at: entity.deleted_at,
            name: entity.name.value().to_string(),
            sku: entity.sku.clone(),
            price: entity.price,
            status: entity.status.as_str().to_string(),
        }
    }
}

=== infrastructure/src/product/repository.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use business::domain::product::{
    model::{Product, ProductId},
    repository::ProductRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

use super::entity::ProductDb;
use crate::db::map_sqlx_error;

pub struct PgProductRepository {
    pub pool: PgPool,
}

impl PgProductRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// A row as the domain's entity. A row the domain rejects is stored data gone bad, not the
/// caller's fault: it is logged with the domain's reason and reported as `InvalidData`.
fn to_domain(row: ProductDb) -> Result<Product, RepositoryError> {
    Product::try_from(row).map_err(|e| {
        tracing::error!(error = %e, "stored row is not a valid product");
        RepositoryError::InvalidData
    })
}

#[async_trait]
impl ProductRepositoryTrait for PgProductRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Product>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = sqlx::query_as!(
            ProductDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, name, sku, price, status
             FROM products WHERE deleted = false
             ORDER BY created_at DESC, id LIMIT $1 OFFSET $2",
            i64::from(page.limit()),
            i64::from(page.offset())
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all failed");
            map_sqlx_error(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM products WHERE deleted = false"#
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_all count failed");
            map_sqlx_error(&e)
        })?;

        let items = rows
            .into_iter()
            .map(to_domain)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) is never negative.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: ProductId) -> Result<Option<Product>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row = sqlx::query_as!(
            ProductDb,
            "SELECT id, created_at, updated_at, deleted, deleted_at, name, sku, price, status
             FROM products WHERE id = $1 AND deleted = false",
            id.value()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_id failed");
            map_sqlx_error(&e)
        })?;

        row.map(to_domain).transpose()
    }

    async fn save(&self, entity: &Product) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let db = ProductDb::from(entity);
        sqlx::query!(
            "INSERT INTO products (id, created_at, updated_at, deleted, deleted_at, name, sku, price, status)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
             ON CONFLICT (id) DO UPDATE
             SET updated_at = $3, deleted = $4, deleted_at = $5, name = $6, sku = $7, price = $8, status = $9",
            db.id,
            db.created_at,
            db.updated_at,
            db.deleted,
            db.deleted_at,
            db.name,
            db.sku,
            db.price,
            db.status,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error(&e)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod integration_tests {
    use super::*;
    use business::domain::product::model::ProductProps;

    use business::domain::product::value_objects::Name;
    use business::domain::product::value_objects::Status;
    use uuid::Uuid;

    fn test_repo(pool: PgPool) -> PgProductRepository {
        PgProductRepository::new(pool)
    }

    async fn seed(pool: &PgPool) -> Product {
        let entity = Product::new(ProductProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Uuid::new_v4().to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        test_repo(pool.clone()).save(&entity).await.unwrap();
        entity
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_persist_and_retrieve_by_id(pool: PgPool) {
        // Arrange
        let entity = seed(&pool).await;

        // Act
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();

        // Assert
        assert_eq!(found.id, entity.id);
        assert_eq!(found.name, entity.name);
        assert_eq!(found.sku, entity.sku);
        assert_eq!(found.price, entity.price);
        assert_eq!(found.status, entity.status);
        assert!(!found.deleted);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_none_for_nonexistent_id(pool: PgPool) {
        // Act
        let result = test_repo(pool)
            .find_by_id(ProductId::generate())
            .await
            .unwrap();

        // Assert
        assert!(result.is_none());
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_update_entity_on_save_conflict(pool: PgPool) {
        // Arrange
        let mut entity = seed(&pool).await;
        entity.sku = "updated".to_string();
        entity.updated_at = chrono::Utc::now();

        // Act
        test_repo(pool.clone()).save(&entity).await.unwrap();

        // Assert
        let found = test_repo(pool)
            .find_by_id(entity.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(found.sku, "updated");
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_list_all_products_excluding_deleted(pool: PgPool) {
        // Arrange
        seed(&pool).await;
        let mut deleted = seed(&pool).await;
        deleted.deleted = true;
        deleted.deleted_at = Some(deleted.updated_at);
        test_repo(pool.clone()).save(&deleted).await.unwrap();

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::default())
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 1);
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_return_the_requested_page_of_a_larger_list(pool: PgPool) {
        // Arrange
        for _ in 0..3 {
            seed(&pool).await;
        }

        // Act
        let page = test_repo(pool)
            .find_all(PageRequest::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Assert
        assert_eq!(page.items.len(), 1);
        assert_eq!(page.total, 3);
        assert_eq!((page.limit, page.offset), (2, 2));
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_duplicate_sku(pool: PgPool) {
        // Arrange
        let first = seed(&pool).await;
        let mut second = Product::new(ProductProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Uuid::new_v4().to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        second.sku = first.sku.clone();

        // Act
        let result = test_repo(pool).save(&second).await;

        // Assert
        assert_eq!(result.unwrap_err(), RepositoryError::Duplicate);
    }
}

=== infrastructure/src/user/repository.rs ===
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use sqlx::PgPool;
use uuid::Uuid;

use business::domain::user::{
    model::{User, UserId},
    repository::UserRepositoryTrait,
};
use puerto_core::RepositoryError;

use crate::db::map_sqlx_error;

/// Runtime-checked queries (`query_as`, not `query_as!`): `puerto new` writes this file before
/// there is a database to build the query cache from, and the project builds offline.
pub struct PgUserRepository {
    pub pool: PgPool,
}

impl PgUserRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[derive(sqlx::FromRow)]
struct UserRow {
    id: Uuid,
    issuer: String,
    subject: String,
    email: Option<String>,
    name: Option<String>,
    roles: Vec<String>,
    created_at: DateTime<Utc>,
    updated_at: DateTime<Utc>,
}

impl From<UserRow> for User {
    fn from(row: UserRow) -> Self {
        User::from_repository(User {
            id: UserId::from_uuid(row.id),
            issuer: row.issuer,
            subject: row.subject,
            email: row.email,
            name: row.name,
            roles: row.roles,
            created_at: row.created_at,
            updated_at: row.updated_at,
        })
    }
}

const COLUMNS: &str = "id, issuer, subject, email, name, roles, created_at, updated_at";

#[async_trait]
impl UserRepositoryTrait for PgUserRepository {
    async fn find_by_subject(
        &self,
        issuer: &str,
        subject: &str,
    ) -> Result<Option<User>, RepositoryError> {
        let row = sqlx::query_as::<_, UserRow>(&format!(
            "SELECT {COLUMNS} FROM users WHERE issuer = $1 AND subject = $2"
        ))
        .bind(issuer)
        .bind(subject)
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_subject failed");
            map_sqlx_error(&e)
        })?;
        Ok(row.map(User::from))
    }

    async fn find_by_id(&self, id: UserId) -> Result<Option<User>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        let row =
            sqlx::query_as::<_, UserRow>(&format!("SELECT {COLUMNS} FROM users WHERE id = $1"))
                .bind(id.value())
                .fetch_optional(&self.pool)
                .await
                .map_err(|e| {
                    tracing::error!(error = %e, "find_by_id failed");
                    map_sqlx_error(&e)
                })?;
        Ok(row.map(User::from))
    }

    async fn save(&self, user: &User) -> Result<(), RepositoryError> {
        tracing::debug!(id = %user.id, "save");
        sqlx::query(
            "INSERT INTO users (id, issuer, subject, email, name, roles, created_at, updated_at)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE SET
                 email = EXCLUDED.email,
                 name = EXCLUDED.name,
                 roles = EXCLUDED.roles,
                 updated_at = EXCLUDED.updated_at",
        )
        .bind(user.id.value())
        .bind(&user.issuer)
        .bind(&user.subject)
        .bind(&user.email)
        .bind(&user.name)
        .bind(&user.roles)
        .bind(user.created_at)
        .bind(user.updated_at)
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            map_sqlx_error(&e)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn ada() -> User {
        User::provision("issuer", "ada", Some("ada@example.com".into()), None)
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_find_a_saved_user_when_looked_up_by_subject_or_id(pool: PgPool) {
        // Arrange
        let repository = PgUserRepository::new(pool);
        let user = ada();
        repository.save(&user).await.expect("saved");

        // Act
        let by_subject = repository
            .find_by_subject("issuer", "ada")
            .await
            .expect("read");
        let by_id = repository.find_by_id(user.id).await.expect("read");

        // Assert
        assert_eq!(by_subject.map(|u| u.id), Some(user.id));
        assert_eq!(by_id.map(|u| u.subject), Some("ada".to_string()));
    }

    #[sqlx::test(migrations = "./migrations")]
    async fn should_reject_a_second_user_when_the_subject_is_taken(pool: PgPool) {
        // Arrange
        let repository = PgUserRepository::new(pool);
        repository.save(&ada()).await.expect("saved");

        // Act
        let result = repository.save(&ada()).await;

        // Assert
        assert_eq!(result, Err(RepositoryError::Duplicate));
    }
}

=== presentation/Cargo.toml ===
[package]
name = "presentation"
version = "0.1.0"
edition = "2024"

[[bin]]
name = "snapshot"
path = "src/main.rs"

[dependencies]
business = { path = "../business" }
infrastructure = { path = "../infrastructure" }
puerto-core = { workspace = true }
# The password hasher `bootstrap.rs` builds (ADR-0021).
puerto-auth = { workspace = true, features = ["local"] }
# The server, health probes, configuration and error body (`main.rs`, `generated/bootstrap.rs`).
puerto-web = { workspace = true }
poem = "3"
# `chrono` feature: without it poem-openapi has no `Type` impl for DateTime<Utc>, so any entity
# with a date field fails to derive `Object`.
poem-openapi = { version = "5", features = ["swagger-ui", "uuid", "chrono"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
tracing = "0.1"
uuid = { version = "1", features = ["v4"] }
# DTOs mirror the domain's field types, so any entity with a DateTime<Utc> field needs chrono here.
chrono = { version = "0.4", features = ["serde"] }

[dev-dependencies]
# Route tests: use case mocks and Object Mothers come from business behind `test-utils`, and
# `poem::test::TestClient` drives the real OpenApiService.
business = { path = "../business", features = ["test-utils"] }
# `MockAuthenticator`, for the routes that take `BearerAuth`.
puerto-core = { workspace = true, features = ["test-utils"] }
poem = { version = "3", features = ["test"] }

