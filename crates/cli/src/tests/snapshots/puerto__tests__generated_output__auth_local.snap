[project]
name = "snapshot"
db = true
auth = "local"

[[entity]]
name = "Product"
use_cases = [
    "create_product",
    "get_product",
    "list_products",
    "update_product",
    "delete_product",
    "publish_product",
]
db = true
public = [
    "list_products",
    "get_product",
]

[entity.roles]
create_product = ["admin"]
delete_product = [
    "admin",
    "owner",
]

[[entity.fields]]
name = "name"
type = "String"
value_object = "Name"

[[entity.fields]]
name = "sku"
type = "String"
unique = true

[[entity.fields]]
name = "price"
type = "i64"

[[entity.fields]]
name = "status"
type = "String"
value_object = "Status"
value_object_kind = "enum"
enum_variants = [
    "Draft",
    "Live",
]

[[entity]]
name = "Order"
use_cases = [
    "create_order",
    "get_order",
    "list_orders",
    "update_order",
    "delete_order",
]
db = true

[[entity.fields]]
name = "total"
type = "i64"

