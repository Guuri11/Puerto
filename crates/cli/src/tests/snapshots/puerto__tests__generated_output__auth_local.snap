import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Schemas } from "../../../api/client";
import { fakeApi } from "../../../test-support/fake-api";
import { PedidoMother, pedidoCollection } from "../../../test-support/pedido";
import { renderScreen } from "../../../test-support/render";
import { PedidoFormContainer } from "./pedido-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `request`, the way a user would. */
async function fillIn(request: Schemas["PeticionCrearPedido"]) {
  await screen.findByText("Save");
  type("Total", String(request.total));
}

describe("PedidoFormContainer", () => {
  test("should create the pedido from what was typed and show it", async () => {
    // Arrange
    const request = PedidoMother.request();
    const stored = pedidoCollection();
    const api = fakeApi([stored]);
    const { history } = renderScreen(<PedidoFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/pedidos/"));
    const [created] = stored.items.values();
    expect(created).toMatchObject(request);
    expect(history.at(-1)).toBe(`/pedidos/${created?.id}`);
  });

  test("should save the edited pedido when an existing one is submitted", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const stored = pedidoCollection([seeded]);
    const api = fakeApi([stored]);
    const { history } = renderScreen(<PedidoFormContainer id={seeded.id} />, { api });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/pedidos/${seeded.id}`));
    expect(stored.items.get(seeded.id)).toEqual(seeded);
  });
  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const request = PedidoMother.request();
    const code = "pedido.validacion.invalid";
    const failures = { "POST /pedidos": code };
    const api = fakeApi([pedidoCollection()], failures);
    renderScreen(<PedidoFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a pedido with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const request = PedidoMother.request();
    const failures = { "POST /pedidos": "pedido.duplicado" };
    const api = fakeApi([pedidoCollection()], failures);
    renderScreen(<PedidoFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A pedido with these values already exists",
    );
  });
});

=== web/src/features/pedido/containers/pedido-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Schemas } from "../../../api/client";
import { unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { toProblem } from "../messages";
import { PedidoFormView, toPedidoForm, toPedidoRequest } from "../views/pedido-form-view";

type Pedido = Schemas["DtoPedido"];

/** Creates a pedido, or edits the one with `id`. */
export function PedidoFormContainer({ id }: { id?: string }) {
  const { api } = useDependencies();
  const existing = useAsync(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : unwrap(api.GET("/pedidos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const title = id === undefined ? "New pedido" : "Edit pedido";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <PedidoForm existing={existing.data} />}
      <Link href={id === undefined ? "/pedidos" : `/pedidos/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function PedidoForm({ existing }: { existing: Pedido | null }) {
  const { api } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toPedidoForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const body = toPedidoRequest(values);
      const saved = await unwrap(
        existing === null
          ? api.POST("/pedidos", { body })
          : api.PUT("/pedidos/{id}", { params: { path: { id: existing.id } }, body }),
      );
      navigate(`/pedidos/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <PedidoFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

