            .execute(CreateProductParams {
                actor: PrincipalMother::random(),
                name: "".to_string(),
                sku: "example".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_name");
    }

    #[tokio::test]
    async fn should_return_error_when_status_is_empty() {
        // Arrange
        let mock_repo = MockProductRepository::new();
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
