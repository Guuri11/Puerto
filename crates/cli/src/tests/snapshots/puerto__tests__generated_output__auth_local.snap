import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakeApi } from "../../../test-support/fake-api";
import { PedidoMother, pedidoCollection } from "../../../test-support/pedido";
import { renderScreen } from "../../../test-support/render";
import { PedidoDetailContainer } from "./pedido-detail-container";

describe("PedidoDetailContainer", () => {
  test("should show the pedido when it exists", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const api = fakeApi([pedidoCollection([seeded])]);

    // Act
    renderScreen(<PedidoDetailContainer id={seeded.id} />, { api });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the pedido does not exist", async () => {
    // Arrange
    const api = fakeApi([pedidoCollection()]);

    // Act
    renderScreen(<PedidoDetailContainer id={crypto.randomUUID()} />, { api });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("pedido.no_encontrado");
  });

  test("should delete the pedido only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const stored = pedidoCollection([seeded]);
    const api = fakeApi([stored]);
    const { history } = renderScreen(<PedidoDetailContainer id={seeded.id} />, { api });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(stored.items.has(seeded.id)).toBe(true);

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/pedidos"));
    expect(stored.items.has(seeded.id)).toBe(false);
  });

  test("should show auth.prohibido when the API refuses the deletion", async () => {
    // Arrange
    const seeded = PedidoMother.random();
    const failures = { "DELETE /pedidos": "auth.prohibido" };
    const api = fakeApi([pedidoCollection([seeded])], failures);
    renderScreen(<PedidoDetailContainer id={seeded.id} />, { api });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
});

=== web/src/features/pedido/containers/pedido-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { PedidoDetailView } from "../views/pedido-detail-view";

export function PedidoDetailContainer({ id }: { id: string }) {
  const { api } = useDependencies();
  const pedido = useAsync(
    () => unwrap(api.GET("/pedidos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await unwrap(api.DELETE("/pedidos/{id}", { params: { path: { id } } }));
      navigate("/pedidos");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Pedido</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {pedido.status === "loading" && <span className="loading loading-spinner" />}
      {pedido.status === "error" && <ErrorAlert error={pedido.error} />}
      {pedido.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <PedidoDetailView pedido={pedido.data} />
            <div className="card-actions justify-end">
              <Link href={`/pedidos/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/pedidos" className="link">
        Back to pedidos
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this pedido?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

