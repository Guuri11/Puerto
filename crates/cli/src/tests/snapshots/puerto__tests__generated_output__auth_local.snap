// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
//
// The composition root: the only module that imports `infrastructure/`. Screens reach the
// adapters through `useDependencies()`, so a test hands them a fake instead.

import type { Accounts } from "../../../domain/auth/accounts";
import type { AuthGateway } from "../../../domain/auth/session";
import type { OrderRepository } from "../../../domain/order/repository";
import type { ProductRepository } from "../../../domain/product/repository";
import { bearerMiddleware } from "../../../infrastructure/auth/bearer-middleware";
import { localAuthGateway } from "../../../infrastructure/auth/local-auth-gateway";
import { createApiClient } from "../../../infrastructure/http/client";
import { orderRepositoryHttp } from "../../../infrastructure/order/order-repository-http";
import { productRepositoryHttp } from "../../../infrastructure/product/product-repository-http";

export interface Dependencies {
  accounts: Accounts;
  auth: AuthGateway;
  orderRepository: OrderRepository;
  productRepository: ProductRepository;
}

export function createDependencies(): Dependencies {
  const auth = localAuthGateway();
  const api = createApiClient();
  api.use(bearerMiddleware(auth));
  return {
    accounts: auth,
    auth,
    orderRepository: orderRepositoryHttp(api),
    productRepository: productRepositoryHttp(api),
  };
}

