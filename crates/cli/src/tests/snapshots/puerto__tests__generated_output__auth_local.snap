=== web/src/domain/auth/accounts.ts ===
import type { CurrentUser } from "./session";

/** What the sign-up form sends. */
export interface Registration {
  email: string;
  password: string;
  name: string | null;
}

/**
 * The accounts this API keeps itself: signing up and signing in with a password. A refusal rejects
 * with an `AuthError` carrying the API's code (`user.duplicate`, `auth.invalid_credentials`).
 */
export interface Accounts {
  register(registration: Registration): Promise<CurrentUser>;
  /** Opens a session: from then on `AuthGateway.currentUser()` answers this account. */
  signIn(email: string, password: string): Promise<void>;
}

=== web/src/domain/auth/messages.ts ===
/** What a sign-in or sign-up form shows for an API error: under the input it is about, or in the alert. */
export interface AccountProblem {
  field: "email" | "password" | "name" | null;
  text: string;
}

/**
 * The messages for the codes of `/auth/*` (the backend's `UserError`). English: this file is the
 * place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "user.validation_error.email_invalid": "This is not an email address",
  "user.validation_error.password_too_short": "Use at least 12 characters",
  "user.duplicate": "An account with this email already exists",
  "auth.invalid_credentials": "Wrong email or password",
  "user.repository_error": "The account could not be saved, try again later",
  "user.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, AccountProblem["field"]> = {
  "user.validation_error.email_invalid": "email",
  "user.validation_error.password_too_short": "password",
  "user.duplicate": "email",
};

export function toAccountProblem(code: string): AccountProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/domain/auth/session.ts ===
/** The signed-in user as the API resolved them (`GET /me`): never the provider's own claims. */
export interface CurrentUser {
  id: string;
  email: string | null;
  name: string | null;
  /** What the API checks with `#[require_role]`. */
  roles: string[];
}

/**
 * Who is signed in, and how to sign in and out. The adapter talks to the provider (OIDC) or to
 * the API (local); screens reach it through `useAuth()`.
 */
export interface AuthGateway {
  /** The signed-in user, or `null` when nobody is. */
  currentUser(): Promise<CurrentUser | null>;
  /** The bearer token for the API, or `null` when nobody is signed in. */
  accessToken(): Promise<string | null>;
  /** Signs in, then comes back to `returnTo` (a path of this app). */
  login(returnTo: string): Promise<void>;
  /** Finishes a sign-in on `/auth/callback`; answers the path `login` was given. */
  completeLogin(): Promise<string>;
  logout(): Promise<void>;
}

/** A sign-in the provider or the API refused, or a `GET /me` that failed. */
export class AuthError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "AuthError";
    this.code = code;
  }
}

