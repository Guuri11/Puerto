=== web/src/api/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { components, paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** The API's DTOs by name: `Schemas["DtoProducto"]`, `Schemas["PeticionCrearProducto"]`. */
export type Schemas = components["schemas"];

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

=== web/src/auth/accounts.ts ===
import type { CurrentUser } from "./session";

/** What the sign-up form sends. */
export interface Registration {
  email: string;
  password: string;
  name?: string;
}

/**
 * The accounts this API keeps itself: signing up and signing in with a password. A refusal rejects
 * with an `AuthError` carrying the API's code (`usuario.duplicado`, `auth.credenciales_invalidas`).
 */
export interface Accounts {
  register(registration: Registration): Promise<CurrentUser>;
  /** Opens a session: from then on `AuthGateway.currentUser()` answers this account. */
  signIn(email: string, password: string): Promise<void>;
}

=== web/src/auth/auth.test.tsx ===
import { describe, expect, test } from "bun:test";
import { screen, waitFor } from "@testing-library/react";
import { CurrentUserMother, fakeAuthGateway } from "../test-support/auth";
import { renderScreen } from "../test-support/render";
import { RequireAuth, useAuth } from "./auth";

function Secret() {
  const { can } = useAuth();
  return <p>{can("admin") ? "admin area" : "member area"}</p>;
}

describe("RequireAuth", () => {
  test("should start a sign-in that comes back here when nobody is signed in", async () => {
    // Arrange
    const auth = fakeAuthGateway({ user: null });

    // Act
    renderScreen(
      <RequireAuth>
        <Secret />
      </RequireAuth>,
      { auth },
      "/orders?page=2",
    );

    // Assert
    await waitFor(() => expect(auth.logins).toEqual(["/orders?page=2"]));
    expect(screen.queryByText("member area")).toBeNull();
  });

  test("should show the page to a signed-in user without signing in again", async () => {
    // Arrange
    const auth = fakeAuthGateway({ user: CurrentUserMother.random() });

    // Act
    renderScreen(
      <RequireAuth>
        <Secret />
      </RequireAuth>,
      { auth },
    );

    // Assert
    expect(await screen.findByText("member area")).toBeTruthy();
    expect(auth.logins).toEqual([]);
  });
});

describe("useAuth", () => {
  test("should allow a role only when the user holds it", async () => {
    // Arrange
    const user = CurrentUserMother.random({ roles: ["admin"] });

    // Act
    renderScreen(<Secret />, {}, "/", { user });

    // Assert
    expect(await screen.findByText("admin area")).toBeTruthy();
  });
});

describe("AuthProvider", () => {
  test("should show the error code when the API does not accept the session", async () => {
    // Arrange
    const auth = {
      ...fakeAuthGateway(),
      currentUser: () => Promise.reject(new Error("auth.no_autenticado")),
    };

    // Act
    renderScreen(<Secret />, { auth });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("auth.no_autenticado");
  });
});

=== web/src/auth/auth.tsx ===
import {
  createContext,
  type ReactNode,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import { useLocation, useSearch } from "wouter";
import { useDependencies } from "../dependencies";
import { ErrorAlert } from "../shared/ui/error-alert";
import type { CurrentUser } from "./session";

export interface Auth {
  /** The signed-in user, `null` when nobody is. */
  user: CurrentUser | null;
  /** Whether the user holds `role`. Screens hide what the API would refuse; the API still decides. */
  can(role: string): boolean;
  /** Signs in, then comes back to the current page. */
  login(): Promise<void>;
  logout(): Promise<void>;
  /** Asks the gateway again who is signed in: after a sign-in that did not leave the app. */
  refresh(): Promise<void>;
  /** Finishes a sign-in (`/auth/callback`): answers the page to go back to. */
  completeLogin(): Promise<string>;
}

type State =
  | { status: "loading" }
  | { status: "ready"; user: CurrentUser | null }
  | { status: "error"; error: unknown };

const AuthContext = createContext<Auth | null>(null);

/** Asks the gateway who is signed in once, before rendering the app: no screen flickers. */
export function AuthProvider({ children }: { children: ReactNode }) {
  const { auth } = useDependencies();
  const [location] = useLocation();
  const search = useSearch();
  const [state, setState] = useState<State>({ status: "loading" });

  useEffect(() => {
    auth.currentUser().then(
      (user) => setState({ status: "ready", user }),
      (error: unknown) => setState({ status: "error", error }),
    );
  }, [auth]);

  const here = search === "" ? location : `${location}?${search}`;
  const login = useCallback(() => auth.login(here), [auth, here]);
  const refresh = useCallback(async () => {
    setState({ status: "ready", user: await auth.currentUser() });
  }, [auth]);
  const completeLogin = useCallback(async () => {
    const back = await auth.completeLogin();
    await refresh();
    return back;
  }, [auth, refresh]);
  const logout = useCallback(async () => {
    await auth.logout();
    setState({ status: "ready", user: null });
  }, [auth]);
  const user = state.status === "ready" ? state.user : null;
  const value = useMemo<Auth>(
    () => ({
      user,
      can: (role) => user?.roles.includes(role) ?? false,
      login,
      logout,
      refresh,
      completeLogin,
    }),
    [user, login, logout, refresh, completeLogin],
  );

  if (state.status === "loading") return <span className="loading loading-spinner" />;
  if (state.status === "error") return <ErrorAlert error={state.error} />;
  return <AuthContext value={value}>{children}</AuthContext>;
}

export function useAuth(): Auth {
  const auth = useContext(AuthContext);
  if (auth === null) {
    throw new Error("useAuth() called outside <AuthProvider>");
  }
  return auth;
}

/** Renders `children` for a signed-in user; anyone else is sent to sign in, and back here. */
export function RequireAuth({ children }: { children: ReactNode }) {
  const { user, login } = useAuth();
  const started = useRef(false);

  useEffect(() => {
    // Once: StrictMode runs effects twice.
    if (user !== null || started.current) return;
    started.current = true;
    void login();
  }, [user, login]);

  return user === null ? <span className="loading loading-spinner" /> : children;
}

=== web/src/auth/bearer-middleware.test.ts ===
import { describe, expect, test } from "bun:test";
import createClient from "openapi-fetch";
import { CurrentUserMother, fakeAuthGateway } from "../test-support/auth";
import { bearerMiddleware } from "./bearer-middleware";

/** One endpoint is enough: the middleware does not look at the path. */
interface paths {
  "/me": { get: { responses: { 200: { content: { "application/json": unknown } } } } };
}

/** A client whose every request is answered with `status`, signed by `auth`. */
function answering(status: number, auth: ReturnType<typeof fakeAuthGateway>) {
  const requests: Request[] = [];
  const api = createClient<paths>({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return Response.json({}, { status });
    },
  });
  api.use(bearerMiddleware(auth));
  return { api, requests };
}

describe("bearerMiddleware", () => {
  test("should send the user's token when someone is signed in", async () => {
    // Arrange
    const user = CurrentUserMother.random();
    const { api, requests } = answering(200, fakeAuthGateway({ user }));

    // Act
    await api.GET("/me");

    // Assert
    expect(requests[0]?.headers.get("Authorization")).toBe(`Bearer token-of-${user.id}`);
  });

  test("should send no token when nobody is signed in", async () => {
    // Arrange
    const { api, requests } = answering(200, fakeAuthGateway());

    // Act
    await api.GET("/me");

    // Assert
    expect(requests[0]?.headers.has("Authorization")).toBe(false);
  });

  test("should sign in again when the API answers 401", async () => {
    // Arrange
    const auth = fakeAuthGateway({ user: CurrentUserMother.random() });
    const { api } = answering(401, auth);

    // Act
    await api.GET("/me");

    // Assert
    expect(auth.logins).toHaveLength(1);
  });
});

=== web/src/auth/bearer-middleware.ts ===
import type { Middleware } from "openapi-fetch";
import type { AuthGateway } from "./session";

/**
 * Signs every API call with the user's token; a `401` means the session is gone, so it signs in
 * again and comes back to the page it was on.
 */
export function bearerMiddleware(auth: AuthGateway): Middleware {
  return {
    async onRequest({ request }) {
      const token = await auth.accessToken();
      if (token !== null) request.headers.set("Authorization", `Bearer ${token}`);
      return request;
    },
    async onResponse({ response }) {
      if (response.status === 401) {
        void auth.login(window.location.pathname + window.location.search);
      }
      return response;
    },
  };
}

=== web/src/auth/local-auth-gateway.test.ts ===
import { describe, expect, test } from "bun:test";
import { localAuthGateway, TOKEN_KEY } from "./local-auth-gateway";
import { AuthError } from "./session";

/** A `Storage` of its own per test. */
function memoryStorage(seed: Record<string, string> = {}): Storage {
  const items = new Map(Object.entries(seed));
  return {
    get length() {
      return items.size;
    },
    clear: () => items.clear(),
    getItem: (key) => items.get(key) ?? null,
    key: (index) => [...items.keys()][index] ?? null,
    removeItem: (key) => {
      items.delete(key);
    },
    setItem: (key, value) => {
      items.set(key, value);
    },
  };
}

/** An API answering each path with its `[status, body]`; `requests` records what it was asked. */
function api(answers: Record<string, [number, unknown]>) {
  const requests: { url: string; init: RequestInit }[] = [];
  const fetch = async (url: string, init: RequestInit) => {
    requests.push({ url, init });
    const [status, body] = answers[url] ?? [404, null];
    return body === null ? new Response(null, { status }) : Response.json(body, { status });
  };
  return { fetch, requests };
}

const ADA = { id: crypto.randomUUID(), email: "ada@example.com", name: "Ada", roles: ["admin"] };
/** `ADA` as `GET /me` answers it. */
const ADA_ME = { id: ADA.id, email: ADA.email, nombre: ADA.name, roles: ADA.roles };

describe("localAuthGateway", () => {
  test("should store the token and load the user when signing in", async () => {
    // Arrange
    const storage = memoryStorage();
    const { fetch, requests } = api({
      "/api/auth/login": [200, { token: "opaque", expiraEn: "2030-01-01T00:00:00Z" }],
      "/api/me": [200, ADA_ME],
    });
    const gateway = localAuthGateway({ storage, fetch });

    // Act
    await gateway.signIn("ada@example.com", "correct horse battery");
    const user = await gateway.currentUser();

    // Assert
    expect(storage.getItem(TOKEN_KEY)).toBe("opaque");
    expect(await gateway.accessToken()).toBe("opaque");
    expect(user).toEqual(ADA);
    expect(requests[1]?.init.headers).toEqual({ Authorization: "Bearer opaque" });
  });

  test("should reject with the API's code when the password is wrong", async () => {
    // Arrange
    const code = "auth.credenciales_invalidas";
    const storage = memoryStorage();
    const { fetch } = api({ "/api/auth/login": [401, { codigo: code, mensaje: code }] });

    // Act
    const result = localAuthGateway({ storage, fetch }).signIn("ada@example.com", "wrong!");

    // Assert
    await expect(result).rejects.toBeInstanceOf(AuthError);
    await expect(result).rejects.toMatchObject({ code });
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should forget a session the API no longer accepts", async () => {
    // Arrange
    const storage = memoryStorage({ [TOKEN_KEY]: "expired" });
    const { fetch } = api({ "/api/me": [401, { codigo: "auth.no_autenticado" }] });

    // Act
    const user = await localAuthGateway({ storage, fetch }).currentUser();

    // Assert
    expect(user).toBeNull();
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should drop the session and go to the sign-in page, then back, when a call is refused", async () => {
    // Arrange: what the bearer middleware does on a 401.
    const storage = memoryStorage({ [TOKEN_KEY]: "revoked" });
    const visited: string[] = [];
    const gateway = localAuthGateway({
      storage,
      fetch: api({}).fetch,
      goTo: (url) => visited.push(url),
    });

    // Act
    await gateway.login("/orders?page=2");

    // Assert
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
    expect(visited).toEqual(["/login?next=%2Forders%3Fpage%3D2"]);
  });

  test("should revoke the session, then forget it, when signing out", async () => {
    // Arrange
    const storage = memoryStorage({ [TOKEN_KEY]: "opaque" });
    const { fetch, requests } = api({ "/api/auth/logout": [204, null] });

    // Act
    await localAuthGateway({ storage, fetch }).logout();

    // Assert
    expect(requests[0]?.url).toBe("/api/auth/logout");
    expect(requests[0]?.init.headers).toEqual({ Authorization: "Bearer opaque" });
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should sign out here even when the API cannot be reached", async () => {
    // Arrange
    const storage = memoryStorage({ [TOKEN_KEY]: "opaque" });
    const fetch = () => Promise.reject(new TypeError("Failed to fetch"));

    // Act
    await localAuthGateway({ storage, fetch }).logout();

    // Assert
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should send the registration and answer the new account", async () => {
    // Arrange
    const { fetch, requests } = api({ "/api/auth/registro": [201, { ...ADA_ME, roles: [] }] });
    const registration = {
      email: "ada@example.com",
      password: "correct horse battery",
      name: "Ada",
    };

    // Act
    const user = await localAuthGateway({ storage: memoryStorage(), fetch }).register(registration);

    // Assert
    expect(JSON.parse(String(requests[0]?.init.body))).toEqual({
      email: "ada@example.com",
      contrasena: "correct horse battery",
      nombre: "Ada",
    });
    expect(user.email).toBe("ada@example.com");
  });
});

=== web/src/auth/local-auth-gateway.ts ===
import type { Accounts, Registration } from "./accounts";
import { AuthError, type AuthGateway, type CurrentUser } from "./session";

/**
 * Where the session token is kept: in `localStorage`, so a reload stays signed in — there is no
 * provider session to fall back on. A token that leaks is revoked server-side (`POST /auth/logout`).
 */
export const TOKEN_KEY = "auth.token";

export interface LocalAuthOptions {
  storage?: Storage;
  fetch?: (url: string, init: RequestInit) => Promise<Response>;
  /** Leaves for another page of the app: the sign-in page, on `login`. */
  goTo?: (url: string) => void;
}

/** `GET /me` as the API answers it (`DtoMe`). */
interface MeBody {
  id: string;
  email?: string | null;
  nombre?: string | null;
  roles: string[];
}

function toCurrentUser(me: MeBody): CurrentUser {
  return { id: me.id, email: me.email ?? null, name: me.nombre ?? null, roles: me.roles };
}

/** `RespuestaError.codigo` of a failed call, or `http.<status>` for a body that is not one. */
async function errorCode(response: Response): Promise<string> {
  const body: unknown = await response.json().catch(() => null);
  if (typeof body === "object" && body !== null && "codigo" in body) {
    const { codigo } = body;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${response.status}`;
}

const JSON_BODY = { "Content-Type": "application/json" };

/** `AuthGateway` and `Accounts` over the API's own `/auth/*` (`--auth local`). */
export function localAuthGateway({
  storage = window.localStorage,
  fetch: send = (url, init) => fetch(url, init),
  goTo = (url) => window.location.assign(url),
}: LocalAuthOptions = {}): AuthGateway & Accounts {
  const token = () => storage.getItem(TOKEN_KEY);
  const bearer = (value: string) => ({ Authorization: `Bearer ${value}` });

  return {
    accessToken: async () => token(),

    async currentUser() {
      const current = token();
      if (current === null) return null;
      const response = await send("/api/me", { headers: bearer(current) });
      // An expired or revoked session: signed out, not an error.
      if (response.status === 401) {
        storage.removeItem(TOKEN_KEY);
        return null;
      }
      if (!response.ok) throw new AuthError(await errorCode(response));
      return toCurrentUser((await response.json()) as MeBody);
    },

    /** The session is gone or never was: drop what is left of it and ask for a password. */
    async login(returnTo) {
      storage.removeItem(TOKEN_KEY);
      goTo(`/login?next=${encodeURIComponent(returnTo)}`);
    },

    completeLogin: async () => "/",

    async logout() {
      const current = token();
      if (current !== null) {
        // Signed out here whatever the API says: a session it could not revoke expires.
        await send("/api/auth/logout", { method: "POST", headers: bearer(current) }).catch(
          () => undefined,
        );
      }
      storage.removeItem(TOKEN_KEY);
    },

    async register(registration: Registration) {
      const response = await send("/api/auth/registro", {
        method: "POST",
        headers: JSON_BODY,
        // `PeticionRegistro`: the API's names for the fields.
        body: JSON.stringify({
          email: registration.email,
          contrasena: registration.password,
          nombre: registration.name,
        }),
      });
      if (!response.ok) throw new AuthError(await errorCode(response));
      return toCurrentUser((await response.json()) as MeBody);
    },

    async signIn(email, password) {
      const response = await send("/api/auth/login", {
        method: "POST",
        headers: JSON_BODY,
        body: JSON.stringify({ email, contrasena: password }),
      });
      if (!response.ok) throw new AuthError(await errorCode(response));
      const session = (await response.json()) as { token: string };
      storage.setItem(TOKEN_KEY, session.token);
    },
  };
}

=== web/src/auth/messages.ts ===
/** What a sign-in or sign-up form shows for an API error: under the input it is about, or in the alert. */
export interface AccountProblem {
  field: "email" | "password" | "name" | null;
  text: string;
}

/**
 * The messages for the codes of `/auth/*` (the backend's `UserError`). English: this file is the
 * place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "usuario.validacion.email_invalido": "This is not an email address",
  "usuario.validacion.contrasena_demasiado_corta": "Use at least 12 characters",
  "usuario.duplicado": "An account with this email already exists",
  "auth.credenciales_invalidas": "Wrong email or password",
  "usuario.repositorio": "The account could not be saved, try again later",
  "usuario.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, AccountProblem["field"]> = {
  "usuario.validacion.email_invalido": "email",
  "usuario.validacion.contrasena_demasiado_corta": "password",
  "usuario.duplicado": "email",
};

export function toAccountProblem(code: string): AccountProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/auth/session.ts ===
/** The signed-in user as the API resolved them (`GET /me`): never the provider's own claims. */
export interface CurrentUser {
  id: string;
  email: string | null;
  name: string | null;
  /** What the API checks with `#[requiere_rol]`. */
  roles: string[];
}

/**
 * Who is signed in, and how to sign in and out. The adapter talks to the provider (OIDC) or to
 * the API (local); screens reach it through `useAuth()`.
 */
export interface AuthGateway {
  /** The signed-in user, or `null` when nobody is. */
  currentUser(): Promise<CurrentUser | null>;
  /** The bearer token for the API, or `null` when nobody is signed in. */
  accessToken(): Promise<string | null>;
  /** Signs in, then comes back to `returnTo` (a path of this app). */
  login(returnTo: string): Promise<void>;
  /** Finishes a sign-in on `/auth/callback`; answers the path `login` was given. */
  completeLogin(): Promise<string>;
  logout(): Promise<void>;
}

/** A sign-in the provider or the API refused, or a `GET /me` that failed. */
export class AuthError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "AuthError";
    this.code = code;
  }
}

