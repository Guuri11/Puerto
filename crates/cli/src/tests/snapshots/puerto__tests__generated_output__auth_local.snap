=== web/src/features/pedido/views/pedido-form-view.tsx ===
import type { Schemas } from "../../../api/client";
import { FieldError } from "../../../shared/ui/field-error";
import type { PedidoProblem } from "../messages";

type Pedido = Schemas["DtoPedido"];
type PedidoRequest = Schemas["PeticionCrearPedido"];

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface PedidoFormValues {
  total: string;
}

/** The inputs for `pedido`, empty when there is none yet. */
export function toPedidoForm(pedido: Pedido | null): PedidoFormValues {
  if (pedido === null) {
    return {
      total: "",
    };
  }
  return {
    total: String(pedido.total),
  };
}

/** What a create or an update sends: the same fields for both. */
export function toPedidoRequest(values: PedidoFormValues): PedidoRequest {
  return {
    total: Number(values.total),
  };
}

export function PedidoFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: PedidoFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: PedidoProblem | null;
  onChange: (values: PedidoFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Total</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "total"}
          required
          value={values.total}
          onChange={(event) => onChange({ ...values, total: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="total" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

