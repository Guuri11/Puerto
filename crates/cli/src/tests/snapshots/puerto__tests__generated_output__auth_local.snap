        sessions
            .expect_revoke()
            .withf(|token| token == "opaque")
            .times(1)
            .returning(|_| Ok(()));
        let use_case = LogoutUseCaseImpl {
            sessions: Arc::new(sessions),
        };

        // Act
        let result = use_case
            .execute(LogoutParams {
                token: "opaque".into(),
            })
            .await;

        // Assert
