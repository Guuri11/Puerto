=== web/src/infrastructure/auth/bearer-middleware.test.ts ===
import { describe, expect, test } from "bun:test";
import createClient from "openapi-fetch";
import { CurrentUserMother, fakeAuthGateway } from "../../test-support/auth";
import { bearerMiddleware } from "./bearer-middleware";

/** One endpoint is enough: the middleware does not look at the path. */
interface paths {
  "/me": { get: { responses: { 200: { content: { "application/json": unknown } } } } };
}

/** A client whose every request is answered with `status`, signed by `auth`. */
function answering(status: number, auth: ReturnType<typeof fakeAuthGateway>) {
  const requests: Request[] = [];
  const api = createClient<paths>({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return Response.json({}, { status });
    },
  });
  api.use(bearerMiddleware(auth));
  return { api, requests };
}

describe("bearerMiddleware", () => {
  test("should send the user's token when someone is signed in", async () => {
    // Arrange
    const user = CurrentUserMother.random();
    const { api, requests } = answering(200, fakeAuthGateway({ user }));

    // Act
    await api.GET("/me");

    // Assert
    expect(requests[0]?.headers.get("Authorization")).toBe(`Bearer token-of-${user.id}`);
  });

  test("should send no token when nobody is signed in", async () => {
    // Arrange
    const { api, requests } = answering(200, fakeAuthGateway());

    // Act
    await api.GET("/me");

    // Assert
    expect(requests[0]?.headers.has("Authorization")).toBe(false);
  });

  test("should sign in again when the API answers 401", async () => {
    // Arrange
    const auth = fakeAuthGateway({ user: CurrentUserMother.random() });
    const { api } = answering(401, auth);

    // Act
    await api.GET("/me");

    // Assert
    expect(auth.logins).toHaveLength(1);
  });
});

=== web/src/infrastructure/auth/bearer-middleware.ts ===
import type { Middleware } from "openapi-fetch";
import type { AuthGateway } from "../../domain/auth/session";

/**
 * Signs every API call with the user's token; a `401` means the session is gone, so it signs in
 * again and comes back to the page it was on.
 */
export function bearerMiddleware(auth: AuthGateway): Middleware {
  return {
    async onRequest({ request }) {
      const token = await auth.accessToken();
      if (token !== null) request.headers.set("Authorization", `Bearer ${token}`);
      return request;
    },
    async onResponse({ response }) {
      if (response.status === 401) {
        void auth.login(window.location.pathname + window.location.search);
      }
      return response;
    },
  };
}

=== web/src/infrastructure/auth/local-auth-gateway.test.ts ===
import { describe, expect, test } from "bun:test";
import { AuthError } from "../../domain/auth/session";
import { localAuthGateway, TOKEN_KEY } from "./local-auth-gateway";

/** A `Storage` of its own per test. */
function memoryStorage(seed: Record<string, string> = {}): Storage {
  const items = new Map(Object.entries(seed));
  return {
    get length() {
      return items.size;
    },
    clear: () => items.clear(),
    getItem: (key) => items.get(key) ?? null,
    key: (index) => [...items.keys()][index] ?? null,
    removeItem: (key) => {
      items.delete(key);
    },
    setItem: (key, value) => {
      items.set(key, value);
    },
  };
}

/** An API answering each path with its `[status, body]`; `requests` records what it was asked. */
function api(answers: Record<string, [number, unknown]>) {
  const requests: { url: string; init: RequestInit }[] = [];
  const fetch = async (url: string, init: RequestInit) => {
    requests.push({ url, init });
    const [status, body] = answers[url] ?? [404, null];
    return body === null ? new Response(null, { status }) : Response.json(body, { status });
  };
  return { fetch, requests };
}

const ADA = { id: crypto.randomUUID(), email: "ada@example.com", name: "Ada", roles: ["admin"] };

describe("localAuthGateway", () => {
  test("should store the token and load the user when signing in", async () => {
    // Arrange
    const storage = memoryStorage();
    const { fetch, requests } = api({
      "/api/auth/login": [200, { token: "opaque", expiresAt: "2030-01-01T00:00:00Z" }],
      "/api/me": [200, ADA],
    });
    const gateway = localAuthGateway({ storage, fetch });

    // Act
    await gateway.signIn("ada@example.com", "correct horse battery");
    const user = await gateway.currentUser();

    // Assert
    expect(storage.getItem(TOKEN_KEY)).toBe("opaque");
    expect(await gateway.accessToken()).toBe("opaque");
    expect(user).toEqual(ADA);
    expect(requests[1]?.init.headers).toEqual({ Authorization: "Bearer opaque" });
  });

  test("should reject with the API's code when the password is wrong", async () => {
    // Arrange
    const code = "auth.invalid_credentials";
    const storage = memoryStorage();
    const { fetch } = api({ "/api/auth/login": [401, { name: code, message: code }] });

    // Act
    const result = localAuthGateway({ storage, fetch }).signIn("ada@example.com", "wrong!");

    // Assert
    await expect(result).rejects.toBeInstanceOf(AuthError);
    await expect(result).rejects.toMatchObject({ code });
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should forget a session the API no longer accepts", async () => {
    // Arrange
    const storage = memoryStorage({ [TOKEN_KEY]: "expired" });
    const { fetch } = api({ "/api/me": [401, { name: "auth.unauthenticated" }] });

    // Act
    const user = await localAuthGateway({ storage, fetch }).currentUser();

    // Assert
    expect(user).toBeNull();
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should drop the session and go to the sign-in page, then back, when a call is refused", async () => {
    // Arrange: what the bearer middleware does on a 401.
    const storage = memoryStorage({ [TOKEN_KEY]: "revoked" });
    const visited: string[] = [];
    const gateway = localAuthGateway({
      storage,
      fetch: api({}).fetch,
      goTo: (url) => visited.push(url),
    });

    // Act
    await gateway.login("/orders?page=2");

    // Assert
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
    expect(visited).toEqual(["/login?next=%2Forders%3Fpage%3D2"]);
  });

  test("should revoke the session, then forget it, when signing out", async () => {
    // Arrange
    const storage = memoryStorage({ [TOKEN_KEY]: "opaque" });
    const { fetch, requests } = api({ "/api/auth/logout": [204, null] });

    // Act
    await localAuthGateway({ storage, fetch }).logout();

    // Assert
    expect(requests[0]?.url).toBe("/api/auth/logout");
    expect(requests[0]?.init.headers).toEqual({ Authorization: "Bearer opaque" });
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should sign out here even when the API cannot be reached", async () => {
    // Arrange
    const storage = memoryStorage({ [TOKEN_KEY]: "opaque" });
    const fetch = () => Promise.reject(new TypeError("Failed to fetch"));

    // Act
    await localAuthGateway({ storage, fetch }).logout();

    // Assert
    expect(storage.getItem(TOKEN_KEY)).toBeNull();
  });

  test("should send the registration and answer the new account", async () => {
    // Arrange
    const { fetch, requests } = api({ "/api/auth/register": [201, { ...ADA, roles: [] }] });
    const registration = {
      email: "ada@example.com",
      password: "correct horse battery",
      name: "Ada",
    };

    // Act
    const user = await localAuthGateway({ storage: memoryStorage(), fetch }).register(registration);

    // Assert
    expect(JSON.parse(String(requests[0]?.init.body))).toEqual(registration);
    expect(user.email).toBe("ada@example.com");
  });
});

=== web/src/infrastructure/auth/local-auth-gateway.ts ===
import type { Accounts, Registration } from "../../domain/auth/accounts";
import { AuthError, type AuthGateway, type CurrentUser } from "../../domain/auth/session";

/**
 * Where the session token is kept: in `localStorage`, so a reload stays signed in — there is no
 * provider session to fall back on. A token that leaks is revoked server-side (`POST /auth/logout`).
 */
export const TOKEN_KEY = "auth.token";

export interface LocalAuthOptions {
  storage?: Storage;
  fetch?: (url: string, init: RequestInit) => Promise<Response>;
  /** Leaves for another page of the app: the sign-in page, on `login`. */
  goTo?: (url: string) => void;
}

interface MeBody {
  id: string;
  email?: string | null;
  name?: string | null;
  roles: string[];
}

function toCurrentUser(me: MeBody): CurrentUser {
  return { id: me.id, email: me.email ?? null, name: me.name ?? null, roles: me.roles };
}

/** `ErrorResponse.name` of a failed call, or `http.<status>` for a body that is not one. */
async function errorCode(response: Response): Promise<string> {
  const body: unknown = await response.json().catch(() => null);
  if (typeof body === "object" && body !== null && "name" in body) {
    const { name } = body;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

const JSON_BODY = { "Content-Type": "application/json" };

/** `AuthGateway` and `Accounts` over the API's own `/auth/*` (`--auth local`). */
export function localAuthGateway({
  storage = window.localStorage,
  fetch: send = (url, init) => fetch(url, init),
  goTo = (url) => window.location.assign(url),
}: LocalAuthOptions = {}): AuthGateway & Accounts {
  const token = () => storage.getItem(TOKEN_KEY);
  const bearer = (value: string) => ({ Authorization: `Bearer ${value}` });

  return {
    accessToken: async () => token(),

    async currentUser() {
      const current = token();
      if (current === null) return null;
      const response = await send("/api/me", { headers: bearer(current) });
      // An expired or revoked session: signed out, not an error.
      if (response.status === 401) {
        storage.removeItem(TOKEN_KEY);
        return null;
      }
      if (!response.ok) throw new AuthError(await errorCode(response));
      return toCurrentUser((await response.json()) as MeBody);
    },

    /** The session is gone or never was: drop what is left of it and ask for a password. */
    async login(returnTo) {
      storage.removeItem(TOKEN_KEY);
      goTo(`/login?next=${encodeURIComponent(returnTo)}`);
    },

    completeLogin: async () => "/",

    async logout() {
      const current = token();
      if (current !== null) {
        // Signed out here whatever the API says: a session it could not revoke expires.
        await send("/api/auth/logout", { method: "POST", headers: bearer(current) }).catch(
          () => undefined,
        );
      }
      storage.removeItem(TOKEN_KEY);
    },

    async register(registration: Registration) {
      const response = await send("/api/auth/register", {
        method: "POST",
        headers: JSON_BODY,
        body: JSON.stringify(registration),
      });
      if (!response.ok) throw new AuthError(await errorCode(response));
      return toCurrentUser((await response.json()) as MeBody);
    },

    async signIn(email, password) {
      const response = await send("/api/auth/login", {
        method: "POST",
        headers: JSON_BODY,
        body: JSON.stringify({ email, password }),
      });
      if (!response.ok) throw new AuthError(await errorCode(response));
      const session = (await response.json()) as { token: string };
      storage.setItem(TOKEN_KEY, session.token);
    },
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/order/order-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { OrderError } from "../../domain/order/errors";
import { OrderMother } from "../../test-support/order";
import { createApiClient } from "../http/client";
import { orderRepositoryHttp } from "./order-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: orderRepositoryHttp(api), requests };
}

describe("orderRepositoryHttp", () => {
  test("should ask for the page and return its orders", async () => {
    // Arrange
    const order = OrderMother.random();
    const page = { items: [order], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/orders?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating an order", async () => {
    // Arrange
    const draft = OrderMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the order does not exist", async () => {
    // Arrange
    const code = "order.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(OrderError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the order", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/orders/42");
  });
});

=== web/src/infrastructure/order/order-repository-http.ts ===
import { OrderError } from "../../domain/order/errors";
import type { Order, OrderDraft } from "../../domain/order/model";
import type { OrderRepository } from "../../domain/order/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type OrderDto = components["schemas"]["OrderDto"];
type OrderRequest = components["schemas"]["CreateOrderRequest"];

function toOrder(dto: OrderDto): Order {
  return {
    id: dto.id,
    total: dto.total,
  };
}

function toRequest(draft: OrderDraft): OrderRequest {
  return {
    total: draft.total,
  };
}

/** `OrderRepository` over the REST API (`/orders`). */
export function orderRepositoryHttp(api: ApiClient): OrderRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/orders", {
        params: { query: page },
      });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toOrder) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/orders/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return toOrder(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/orders", { body: toRequest(draft) });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return toOrder(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/orders/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new OrderError(apiErrorCode(error, response));
      return toOrder(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/orders/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new OrderError(apiErrorCode(error, response));
    },
  };
}

