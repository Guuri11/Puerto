// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::order::create_order::CreateOrderUseCaseImpl;
use business::application::order::delete_order::DeleteOrderUseCaseImpl;
use business::application::order::get_order::GetOrderUseCaseImpl;
use business::application::order::list_orders::ListOrdersUseCaseImpl;
use business::application::order::update_order::UpdateOrderUseCaseImpl;
use business::application::product::create_product::CreateProductUseCaseImpl;
use business::application::product::delete_product::DeleteProductUseCaseImpl;
use business::application::product::get_product::GetProductUseCaseImpl;
use business::application::product::list_products::ListProductsUseCaseImpl;
use business::application::product::publish_product::PublishProductUseCaseImpl;
use business::application::product::update_product::UpdateProductUseCaseImpl;

use business::domain::order::repository::OrderRepositoryTrait;
use business::domain::product::repository::ProductRepositoryTrait;
use infrastructure::order::repository::PgOrderRepository;
use infrastructure::product::repository::PgProductRepository;

use business::application::user::login::LoginUseCaseImpl;
use business::application::user::logout::LogoutUseCaseImpl;
use business::application::user::register_user::RegisterUserUseCaseImpl;
use business::domain::user::repository::UserRepositoryTrait;
use infrastructure::db::auth::{PgCredentials, PgSessions};
use infrastructure::user::repository::PgUserRepository;
use poem::Endpoint;
use poem::EndpointExt;
use poem_openapi::OpenApiService;
use puerto_core::auth::{Authenticator, CredentialStore, PasswordHasher};

use crate::api::auth::routes::AuthApi;
use crate::api::me::routes::MeApi;
use crate::api::order::routes::OrderApi;
use crate::api::product::routes::ProductApi;

/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL is not set — set it in .env (.env.example has one)".to_string()
    })?;
    let pool = infrastructure::db::create_postgres_pool(&database_url)
        .await
        .map_err(|e| format!("{e} — is the database up? `make docker-compose/up`"))?;
    infrastructure::db::run_migrations(&pool, &infrastructure::db::MIGRATOR)
        .await
        .map_err(|e| e.to_string())?;

    // Accounts in this database (ADR-0021 § 2): their sessions are what every `BearerAuth` asks.
    let users: Arc<dyn UserRepositoryTrait> = Arc::new(PgUserRepository::new(pool.clone()));
    let credentials: Arc<dyn CredentialStore> = Arc::new(PgCredentials::new(pool.clone()));
    let hasher: Arc<dyn PasswordHasher> = Arc::new(puerto_auth::local::Argon2Hasher::new());
    let sessions = Arc::new(PgSessions::new(
        pool.clone(),
        infrastructure::db::auth::session_ttl_from_env()?,
    ));
    let authenticator: Arc<dyn Authenticator> = sessions.clone();
    let auth_api = AuthApi {
        register_user: Arc::new(RegisterUserUseCaseImpl {
            users: Arc::clone(&users),
            credentials: Arc::clone(&credentials),
            hasher: Arc::clone(&hasher),
        }),
        login: Arc::new(LoginUseCaseImpl {
            users,
            credentials,
            hasher,
            sessions: sessions.clone(),
        }),
        logout: Arc::new(LogoutUseCaseImpl { sessions }),
    };
    let me_api = MeApi;

    let product_repo: Arc<dyn ProductRepositoryTrait> =
        Arc::new(PgProductRepository::new(pool.clone()));
    let create_product = Arc::new(CreateProductUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let get_product = Arc::new(GetProductUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let list_products = Arc::new(ListProductsUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let update_product = Arc::new(UpdateProductUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let delete_product = Arc::new(DeleteProductUseCaseImpl {
        repository: Arc::clone(&product_repo),
    });
    let publish_product = Arc::new(PublishProductUseCaseImpl {
        repository: product_repo,
    });
    let product_api = ProductApi {
        create_product,
        get_product,
        list_products,
        update_product,
        delete_product,
        publish_product,
    };

    let order_repo: Arc<dyn OrderRepositoryTrait> = Arc::new(PgOrderRepository::new(pool.clone()));
    let create_order = Arc::new(CreateOrderUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let get_order = Arc::new(GetOrderUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let list_orders = Arc::new(ListOrdersUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let update_order = Arc::new(UpdateOrderUseCaseImpl {
        repository: Arc::clone(&order_repo),
    });
    let delete_order = Arc::new(DeleteOrderUseCaseImpl {
        repository: order_repo,
    });
    let order_api = OrderApi {
        create_order,
        get_order,
        list_orders,
        update_order,
        delete_order,
    };

    let ready = puerto_web::health::probe(move || {
        let pool = pool.clone();
        async move { infrastructure::db::ping(&pool).await }
    });

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::routes(
        openapi_service((product_api, order_api, me_api, auth_api)),
        &config,
        ready,
    ))
    // What every `BearerAuth` asks.
    .data(authenticator))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

