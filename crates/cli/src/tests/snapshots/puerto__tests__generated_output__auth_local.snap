=== web/src/features/producto/containers/producto-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE, unwrap } from "../../../api/http";
import { useAuth } from "../../../auth/auth";
import { useDependencies } from "../../../dependencies";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { useAsync } from "../../../shared/use-async";
import { ProductoListView } from "../views/producto-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function ProductoListContainer() {
  const { api } = useDependencies();
  const { can } = useAuth();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const query = { limite: PAGE_SIZE, desplazamiento: offset };
  const productos = useAsync(
    () => unwrap(api.GET("/productos", { params: { query } })),
    [api, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Productos</h1>
        {can("admin") && (
          <Link href="/productos/new" className="btn btn-primary">
            New producto
          </Link>
        )}
      </div>
      {productos.status === "loading" && <span className="loading loading-spinner" />}
      {productos.status === "error" && <ErrorAlert error={productos.error} />}
      {productos.status === "ok" &&
        (productos.data.total === 0 ? (
          <EmptyState message="No productos yet." />
        ) : (
          <>
            <ProductoListView productos={productos.data.elementos} />
            <Pagination
              total={productos.data.total}
              limit={productos.data.limite}
              offset={productos.data.desplazamiento}
              onOffsetChange={goTo}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/features/producto/messages.ts ===
/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface ProductoProblem {
  field: string | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "producto.name_invalido": "Name is not valid",
  "producto.validacion.sku_vacio": "Sku is required",
  "producto.status_invalido": "Status is not valid",
  "producto.duplicado": "A producto with these values already exists",
  "producto.no_encontrado": "This producto no longer exists",
  "producto.repositorio": "The producto could not be saved, try again later",
  "producto.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, string> = {
  "producto.name_invalido": "name",
  "producto.validacion.sku_vacio": "sku",
  "producto.status_invalido": "status",
};

export function toProblem(code: string): ProductoProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

