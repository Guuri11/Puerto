// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generar bootstrap`.
//! The repositories, units of work and use cases of every context, built for the binaries
//! (ADR-0023 § 7 of Puerto). No HTTP here: `api` mounts its routes on these use cases.

pub mod product {
    use std::sync::Arc;

    use aplicacion_product::create_product::{CreateProductUseCaseImpl, CreateProductUseCaseTrait};
    use aplicacion_product::delete_product::{DeleteProductUseCaseImpl, DeleteProductUseCaseTrait};
    use aplicacion_product::get_product::{GetProductUseCaseImpl, GetProductUseCaseTrait};
    use aplicacion_product::list_products::{ListProductsUseCaseImpl, ListProductsUseCaseTrait};
    use aplicacion_product::publish_product::{
        PublishProductUseCaseImpl, PublishProductUseCaseTrait,
    };
    use aplicacion_product::update_product::{UpdateProductUseCaseImpl, UpdateProductUseCaseTrait};
    use dominio_product::repositorio::ProductRepositoryTrait;
    use infra_product::repositorio::PgProductRepository;

    /// The use cases of `product`, on their adapters.
    pub struct CasosDeUso {
        pub create_product: Arc<dyn CreateProductUseCaseTrait>,
        pub get_product: Arc<dyn GetProductUseCaseTrait>,
        pub list_products: Arc<dyn ListProductsUseCaseTrait>,
        pub update_product: Arc<dyn UpdateProductUseCaseTrait>,
        pub delete_product: Arc<dyn DeleteProductUseCaseTrait>,
        pub publish_product: Arc<dyn PublishProductUseCaseTrait>,
    }

    pub fn construir(pool: &sqlx::PgPool) -> CasosDeUso {
        let repository: Arc<dyn ProductRepositoryTrait> =
            Arc::new(PgProductRepository::new(pool.clone()));
        CasosDeUso {
            create_product: Arc::new(CreateProductUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            get_product: Arc::new(GetProductUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            list_products: Arc::new(ListProductsUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            update_product: Arc::new(UpdateProductUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            delete_product: Arc::new(DeleteProductUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            publish_product: Arc::new(PublishProductUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
        }
    }
}

pub mod order {
    use std::sync::Arc;

    use aplicacion_order::create_order::{CreateOrderUseCaseImpl, CreateOrderUseCaseTrait};
    use aplicacion_order::delete_order::{DeleteOrderUseCaseImpl, DeleteOrderUseCaseTrait};
    use aplicacion_order::get_order::{GetOrderUseCaseImpl, GetOrderUseCaseTrait};
    use aplicacion_order::list_orders::{ListOrdersUseCaseImpl, ListOrdersUseCaseTrait};
    use aplicacion_order::update_order::{UpdateOrderUseCaseImpl, UpdateOrderUseCaseTrait};
    use dominio_order::repositorio::OrderRepositoryTrait;
    use infra_order::repositorio::PgOrderRepository;

    /// The use cases of `order`, on their adapters.
    pub struct CasosDeUso {
        pub create_order: Arc<dyn CreateOrderUseCaseTrait>,
        pub get_order: Arc<dyn GetOrderUseCaseTrait>,
        pub list_orders: Arc<dyn ListOrdersUseCaseTrait>,
        pub update_order: Arc<dyn UpdateOrderUseCaseTrait>,
        pub delete_order: Arc<dyn DeleteOrderUseCaseTrait>,
    }

    pub fn construir(pool: &sqlx::PgPool) -> CasosDeUso {
        let repository: Arc<dyn OrderRepositoryTrait> =
            Arc::new(PgOrderRepository::new(pool.clone()));
        CasosDeUso {
            create_order: Arc::new(CreateOrderUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            get_order: Arc::new(GetOrderUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            list_orders: Arc::new(ListOrdersUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            update_order: Arc::new(UpdateOrderUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
            delete_order: Arc::new(DeleteOrderUseCaseImpl {
                repository: Arc::clone(&repository),
            }),
        }
    }
}

