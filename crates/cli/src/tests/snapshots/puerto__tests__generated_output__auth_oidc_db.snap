=== contextos/usuario/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use sqlx::PgPool;
use uuid::Uuid;

use dominio_usuario::{
    modelo::{User, UserId},
    repositorio::UserRepositoryTrait,
};
use puerto_nucleo::ErrorRepositorio;

use puerto_sqlx::mapear_error_sqlx;

/// Runtime-checked queries (`query_as`, not `query_as!`): `puerto nuevo` writes this file before
/// there is a database to build the query cache from, and the project builds offline.
pub struct PgUserRepository {
    pub pool: PgPool,
}

impl PgUserRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[derive(sqlx::FromRow)]
struct UserRow {
    id: Uuid,
    emisor: String,
    sujeto: String,
    email: Option<String>,
    nombre: Option<String>,
    roles: Vec<String>,
    creado_en: DateTime<Utc>,
    actualizado_en: DateTime<Utc>,
}

impl From<UserRow> for User {
    fn from(row: UserRow) -> Self {
        User::from_repository(User {
            id: UserId::from_uuid(row.id),
            issuer: row.emisor,
            subject: row.sujeto,
            email: row.email,
            name: row.nombre,
            roles: row.roles,
            created_at: row.creado_en,
            updated_at: row.actualizado_en,
        })
    }
}

const COLUMNS: &str = "id, emisor, sujeto, email, nombre, roles, creado_en, actualizado_en";

#[async_trait]
impl UserRepositoryTrait for PgUserRepository {
    async fn find_by_subject(
        &self,
        issuer: &str,
        subject: &str,
    ) -> Result<Option<User>, ErrorRepositorio> {
        let row = sqlx::query_as::<_, UserRow>(&format!(
            "SELECT {COLUMNS} FROM usuarios WHERE emisor = $1 AND sujeto = $2"
        ))
        .bind(issuer)
        .bind(subject)
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "find_by_subject failed");
            mapear_error_sqlx(&e)
        })?;
        Ok(row.map(User::from))
    }

    async fn find_by_id(&self, id: UserId) -> Result<Option<User>, ErrorRepositorio> {
        tracing::debug!(%id, "find_by_id");
        let row =
            sqlx::query_as::<_, UserRow>(&format!("SELECT {COLUMNS} FROM usuarios WHERE id = $1"))
                .bind(id.value())
                .fetch_optional(&self.pool)
                .await
                .map_err(|e| {
                    tracing::error!(error = %e, "find_by_id failed");
                    mapear_error_sqlx(&e)
                })?;
        Ok(row.map(User::from))
    }

    async fn save(&self, user: &User) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %user.id, "save");
        sqlx::query(
            "INSERT INTO usuarios (id, emisor, sujeto, email, nombre, roles, creado_en, actualizado_en)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE SET
                 email = EXCLUDED.email,
                 nombre = EXCLUDED.nombre,
                 roles = EXCLUDED.roles,
                 actualizado_en = EXCLUDED.actualizado_en",
        )
        .bind(user.id.value())
        .bind(&user.issuer)
        .bind(&user.subject)
        .bind(&user.email)
        .bind(&user.name)
        .bind(&user.roles)
        .bind(user.created_at)
        .bind(user.updated_at)
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "save failed");
            mapear_error_sqlx(&e)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn ada() -> User {
        User::provision("emisor", "ada", Some("ada@example.com".into()), None)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_find_a_saved_user_when_looked_up_by_subject_or_id(pool: PgPool) {
        // Arrange
        let repository = PgUserRepository::new(pool);
        let user = ada();
        repository.save(&user).await.expect("saved");

        // Act
        let by_subject = repository
            .find_by_subject("emisor", "ada")
            .await
            .expect("read");
        let by_id = repository.find_by_id(user.id).await.expect("read");

        // Assert
        assert_eq!(by_subject.map(|u| u.id), Some(user.id));
        assert_eq!(by_id.map(|u| u.subject), Some("ada".to_string()));
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn should_reject_a_second_user_when_the_subject_is_taken(pool: PgPool) {
        // Arrange
        let repository = PgUserRepository::new(pool);
        repository.save(&ada()).await.expect("saved");

        // Act
        let result = repository.save(&ada()).await;

        // Assert
        assert_eq!(result, Err(ErrorRepositorio::Duplicado));
    }
}

