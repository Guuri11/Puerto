=== contextos/product/aplicacion/src/update_product.rs ===
use async_trait::async_trait;
use dominio_product::errores::ProductError;
use dominio_product::modelo::{Product, ProductId};
use dominio_product::repositorio::ProductRepositoryTrait;
use dominio_product::valores::{Name, Status};
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct UpdateProductParams {
    /// Who asks (ADR-0021). A rule that depends on the data ("only the owner edits") decides on
    /// it here and answers `Forbidden`.
    pub actor: Principal,
    pub id: ProductId,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
}

#[async_trait]
pub trait UpdateProductUseCaseTrait: Send + Sync {
    async fn execute(&self, params: UpdateProductParams) -> Result<Product, ProductError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub UpdateProductUseCase {}

        #[async_trait]
        impl UpdateProductUseCaseTrait for UpdateProductUseCase {
            async fn execute(&self, params: UpdateProductParams) -> Result<Product, ProductError>;
        }
    }
}

pub struct UpdateProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl UpdateProductUseCaseTrait for UpdateProductUseCaseImpl {
    async fn execute(&self, params: UpdateProductParams) -> Result<Product, ProductError> {
        tracing::info!(id = %params.id, "update_product: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_product: repository failed"))?
            .ok_or_else(|| {
                let err = ProductError::NotFound;
                tracing::warn!(error = %err, "update_product: rejected");
                err
            })?;
        if params.sku.trim().is_empty() {
            let err = ProductError::ValidationError("sku_empty".into());
            tracing::warn!(error = %err, "update_product: rejected");
            return Err(err);
        }
        let name = Name::new(params.name)?;
        let status = params.status.parse::<Status>()?;
        entity.name = name;
        entity.sku = params.sku;
        entity.price = params.price;
        entity.status = status;
        entity.updated_at = chrono::Utc::now();
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_product: repository failed"))?;
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_product::valores::Name;
    use dominio_product::valores::Status;
    use dominio_product::{
        modelo::{Product, ProductId, ProductProps},
        repositorio::mocks::MockProductRepository,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn should_update_product_when_params_are_valid() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: "original".to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: MadrePrincipal::aleatorio(),
                id: entity_id,
                name: "updated".to_string(),
                sku: "updated".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().sku, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_product_does_not_exist() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: MadrePrincipal::aleatorio(),
                id: ProductId::generate(),
                name: "new".to_string(),
                sku: "new".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_sku_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: "original".to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: MadrePrincipal::aleatorio(),
                id: entity_id,
                name: "updated".to_string(),
                sku: "".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.sku_empty"
        );
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let entity = Product::new(ProductProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: "original".to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateProductParams {
                actor: MadrePrincipal::aleatorio(),
                id: entity_id,
                name: "".to_string(),
                sku: "updated".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_name");
    }
}

