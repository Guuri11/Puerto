=== contextos/usuario/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum UserError {
    #[error("user.not_found")]
    NotFound,
    #[error("user.duplicate")]
    Duplicate,
    #[error("user.repository_error")]
    RepositoryError,
}

impl From<ErrorRepositorio> for UserError {
    /// `ErrorRepositorio` is `#[non_exhaustive]`: one a later version adds is the store's problem
    /// (500) until it gets a meaning here.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicate,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => {
                Self::RepositoryError
            }
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_user_duplicate() {
        let err = UserError::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "user.duplicate");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = UserError::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "user.repository_error");
    }
}

