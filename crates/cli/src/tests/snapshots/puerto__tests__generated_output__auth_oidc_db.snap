use async_trait::async_trait;
use dominio_order::errores::OrderError;
use dominio_order::modelo::{Order, OrderProps};
use dominio_order::repositorio::OrderRepositoryTrait;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct CreateOrderParams {
    /// Who asks (ADR-0021). A rule that depends on the data ("only the owner edits") decides on
    /// it here and answers `Forbidden`.
    pub actor: Principal,
    pub total: i64,
}

#[async_trait]
pub trait CreateOrderUseCaseTrait: Send + Sync {
    async fn execute(&self, params: CreateOrderParams) -> Result<Order, OrderError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub CreateOrderUseCase {}

        #[async_trait]
        impl CreateOrderUseCaseTrait for CreateOrderUseCase {
            async fn execute(&self, params: CreateOrderParams) -> Result<Order, OrderError>;
        }
    }
}

pub struct CreateOrderUseCaseImpl {
    pub repository: Arc<dyn OrderRepositoryTrait>,
}

#[async_trait]
impl CreateOrderUseCaseTrait for CreateOrderUseCaseImpl {
    async fn execute(&self, params: CreateOrderParams) -> Result<Order, OrderError> {
        tracing::info!("create_order: start");
        let entity = Order::new(OrderProps {
            total: params.total,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_order: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_order: repository failed"))?;
        tracing::info!(id = %entity.id, "create_order: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_order::repositorio::mocks::MockOrderRepository;
    use puerto_nucleo::ErrorRepositorio;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn should_create_order_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockOrderRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateOrderUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateOrderParams {
                actor: MadrePrincipal::aleatorio(),
                total: 42,
            })
            .await;

        // Assert
        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(ErrorRepositorio::Duplicado));
        let use_case = CreateOrderUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateOrderParams {
                actor: MadrePrincipal::aleatorio(),
                total: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "order.duplicate");
    }
}

