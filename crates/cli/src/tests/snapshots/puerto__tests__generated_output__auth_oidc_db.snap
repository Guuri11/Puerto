=== contextos/usuario/rest/src/me/dto.rs ===
use poem_openapi::Object;
use puerto_nucleo::auth::Principal;
use uuid::Uuid;

/// The caller as the API resolved them: the id of their `User` row and the roles the API checks.
/// The frontend reads this, never the provider's claims.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct MeDto {
    pub id: Uuid,
    pub email: Option<String>,
    pub name: Option<String>,
    pub roles: Vec<String>,
}

impl MeDto {
    pub fn from_principal(principal: &Principal) -> Self {
        Self {
            id: principal.id_usuario,
            email: principal.email.clone(),
            name: principal.nombre.clone(),
            roles: principal.roles.clone(),
        }
    }
}

=== contextos/usuario/rest/src/me/rutas.rs ===
//! Yours: `puerto nuevo --auth` writes this file once.

use poem_openapi::{OpenApi, Tags, payload::Json};
use puerto_web::auth::BearerAuth;

use crate::me::dto::MeDto;

#[derive(Tags)]
enum ApiTags {
    Me,
}

/// `GET /me`: what the frontend asks after sign-in. No or a bad token is answered by `BearerAuth`
/// before the handler runs (401 `auth.no_autenticado`, 503 `auth.no_disponible`).
pub struct MeApi;

#[OpenApi]
impl MeApi {
    /// The signed-in caller: their user id, profile and roles
    #[oai(path = "/me", method = "get", tag = "ApiTags::Me")]
    async fn me(&self, auth: BearerAuth) -> Json<MeDto> {
        Json(MeDto::from_principal(&auth.0))
    }
}

#[cfg(test)]
mod tests {
    use std::sync::Arc;

    use poem::{EndpointExt, Route, http::StatusCode, test::TestClient};
    use poem_openapi::OpenApiService;
    use puerto_nucleo::auth::dobles::MockAutenticador;
    use puerto_nucleo::auth::{Autenticador, ErrorAuth, Principal};
    use uuid::Uuid;

    use super::*;

    const USER_ID: Uuid = Uuid::from_u128(0x6b1f_0c2e_8d4a_4e51_9a3b_2f0d_7c6e_1a42);

    /// Accepts the token `ada`, rejects anything else.
    fn client() -> TestClient<impl poem::Endpoint> {
        let mut authenticator = MockAutenticador::new();
        authenticator
            .expect_autenticar()
            .returning(|token| match token {
                "ada" => Ok(Principal::new(USER_ID, "ada-subject")
                    .con_email("ada@example.com")
                    .con_nombre("Ada Lovelace")
                    .con_roles(["admin"])),
                _ => Err(ErrorAuth::Invalido),
            });
        let authenticator: Arc<dyn Autenticador> = Arc::new(authenticator);
        TestClient::new(
            Route::new()
                .nest("/", OpenApiService::new(MeApi, "test", "1.0"))
                .data(authenticator),
        )
    }

    #[tokio::test]
    async fn should_answer_the_caller_when_the_token_is_accepted() {
        // Act
        let response = client()
            .get("/me")
            .header("Authorization", "Bearer ada")
            .send()
            .await;

        // Assert
        response.assert_status_is_ok();
        let body = response.json().await;
        let me = body.value().object();
        me.get("id").assert_string(&USER_ID.to_string());
        me.get("email").assert_string("ada@example.com");
        me.get("name").assert_string("Ada Lovelace");
        me.get("roles").assert_string_array(&["admin"]);
    }

    #[tokio::test]
    async fn should_answer_401_when_there_is_no_token() {
        // Act
        let response = client().get("/me").send().await;

        // Assert
        response.assert_status(StatusCode::UNAUTHORIZED);
        response
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("auth.no_autenticado");
    }

    #[tokio::test]
    async fn should_answer_401_when_the_token_is_rejected() {
        // Act
        let response = client()
            .get("/me")
            .header("Authorization", "Bearer forged")
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNAUTHORIZED);
    }
}

=== docker-compose.yml ===
services:
  postgres:
    image: postgres:16
    container_name: snapshot-postgres
    ports:
      - "${DB_HOST_PORT:-5432}:5432"
    environment:
      POSTGRES_USER: devuser
      POSTGRES_PASSWORD: password
      POSTGRES_DB: snapshot
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U devuser -d snapshot"]
      interval: 5s
      timeout: 5s
      retries: 5

  keycloak:
    image: quay.io/keycloak/keycloak:26.8.0
    container_name: snapshot-keycloak
    # Imports keycloak/realm.json on the first start: the `web` client, the
    # `admin` role and a user holding it (`make auth/ui`).
    command: start-dev --import-realm
    ports:
      - "8180:8080"
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: admin
      KC_HEALTH_ENABLED: "true"
    volumes:
      - ./keycloak:/opt/keycloak/data/import:ro
    restart: unless-stopped
    healthcheck:
      # The image has no curl: bash's /dev/tcp asks the management port.
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/localhost/9000 && printf 'GET /health/ready HTTP/1.0\r\n\r\n' >&3 && grep -q UP <&3"]
      interval: 5s
      timeout: 5s
      retries: 30

volumes:
  postgres-data:

