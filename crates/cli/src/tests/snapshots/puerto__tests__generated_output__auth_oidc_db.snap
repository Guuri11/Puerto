use async_trait::async_trait;
use dominio_product::errores::ProductError;
use dominio_product::modelo::{Product, ProductId};
use dominio_product::repositorio::ProductRepositoryTrait;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct GetProductParams {
    pub id: ProductId,
}

#[async_trait]
pub trait GetProductUseCaseTrait: Send + Sync {
    async fn execute(&self, params: GetProductParams) -> Result<Product, ProductError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub GetProductUseCase {}

        #[async_trait]
        impl GetProductUseCaseTrait for GetProductUseCase {
            async fn execute(&self, params: GetProductParams) -> Result<Product, ProductError>;
        }
    }
}

pub struct GetProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl GetProductUseCaseTrait for GetProductUseCaseImpl {
    async fn execute(&self, params: GetProductParams) -> Result<Product, ProductError> {
        tracing::info!(id = %params.id, "get_product: start");
        let result = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "get_product: repository failed"))?;
        result.ok_or_else(|| {
