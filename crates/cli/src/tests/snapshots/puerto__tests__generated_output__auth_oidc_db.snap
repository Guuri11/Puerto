use async_trait::async_trait;
use puerto_nucleo::ErrorRepositorio;

use crate::modelo::{User, UserId};

#[async_trait]
pub trait UserRepositoryTrait: Send + Sync {
    /// The user the provider `issuer` calls `subject`.
    async fn find_by_subject(
        &self,
        issuer: &str,
        subject: &str,
    ) -> Result<Option<User>, ErrorRepositorio>;
    async fn find_by_id(&self, id: UserId) -> Result<Option<User>, ErrorRepositorio>;
    /// Inserts or updates by id; another user with the same `(issuer, subject)` is `Duplicate`.
    async fn save(&self, user: &User) -> Result<(), ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
