=== presentacion/api/src/generado/bootstrap.rs ===
// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generar bootstrap`.
use std::sync::Arc;

use infra_usuario::aprovisionamiento::ProvisioningAuthenticator;
use infra_usuario::repositorio::PgUserRepository;
use poem::Endpoint;
use poem::EndpointExt;
use poem_openapi::OpenApiService;
use puerto_nucleo::auth::Autenticador;
use rest_order::rutas::OrderApi;
use rest_product::rutas::ProductApi;
use rest_usuario::me::rutas::MeApi;

/// The routes, wired. An error is what stopped the startup: `main` prints it and exits 1.
pub async fn build_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL is not set — set it in .env (.env.example has one)".to_string()
    })?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — is the database up? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;

    // The provider's tokens, and a `User` row for every caller (ADR-0021 § 3).
    let auth_config = puerto_auth::ConfigOidc::from_env().map_err(|e| e.to_string())?;
    let issuer = auth_config.emisor.clone();
    let provider = puerto_auth::AutenticadorOidc::descubrir(auth_config)
        .await
        .map_err(|e| format!("{e} — is the auth provider up? `make docker-compose/up`"))?;
    let authenticator: Arc<dyn Autenticador> = Arc::new(ProvisioningAuthenticator::new(
        Arc::new(provider),
        Arc::new(PgUserRepository::new(pool.clone())),
        issuer,
    ));
    let me_api = MeApi;

    let casos_product = cableado::product::construir(&pool);
    let product_api = ProductApi {
        create_product: casos_product.create_product,
        get_product: casos_product.get_product,
        list_products: casos_product.list_products,
        update_product: casos_product.update_product,
        delete_product: casos_product.delete_product,
        publish_product: casos_product.publish_product,
    };

    let casos_order = cableado::order::construir(&pool);
    let order_api = OrderApi {
        create_order: casos_order.create_order,
        get_order: casos_order.get_order,
        list_orders: casos_order.list_orders,
        update_order: casos_order.update_order,
        delete_order: casos_order.delete_order,
    };

    let ready = puerto_web::health::sondear(move || {
        let pool = pool.clone();
        async move { puerto_sqlx::ping(&pool).await }
    });

    // `app.rs` is the project's own: middleware and routes added there wrap everything here.
    Ok(crate::app::configure(puerto_web::rutas(
        openapi_service((product_api, order_api, me_api)),
        &config,
        ready,
    ))
    // What every `BearerAuth` asks.
    .data(authenticator))
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

