#[cfg(test)]
mod tests {
    use super::*;
    use dominio_order::{
        modelo::{Order, OrderId, OrderProps},
        repositorio::mocks::MockOrderRepository,
    };
    use puerto_nucleo::ErrorRepositorio;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn should_return_order_when_id_exists() {
        let entity = Order::new(OrderProps { total: 42 }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = GetOrderUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetOrderParams {
                actor: MadrePrincipal::aleatorio(),
                id: entity_id,
            })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_id_does_not_exist() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = GetOrderUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetOrderParams {
                actor: MadrePrincipal::aleatorio(),
                id: OrderId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "order.not_found");
    }

    #[tokio::test]
    async fn should_return_repository_error_when_the_store_is_unavailable() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(|_| Err(ErrorRepositorio::NoDisponible));
        let use_case = GetOrderUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(GetOrderParams {
                actor: MadrePrincipal::aleatorio(),
                id: OrderId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "order.repository_error");
    }
}

