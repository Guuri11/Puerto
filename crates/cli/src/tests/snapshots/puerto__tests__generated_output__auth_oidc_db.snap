=== contextos/order/aplicacion/src/list_orders.rs ===
use async_trait::async_trait;
use dominio_order::errores::OrderError;
use dominio_order::modelo::Order;
use dominio_order::repositorio::OrderRepositoryTrait;
use puerto_nucleo::auth::Principal;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ListOrdersParams {
    /// Who asks (ADR-0021). A rule that depends on the data ("only the owner edits") decides on
    /// it here and answers `Forbidden`.
    pub actor: Principal,
    pub page: PeticionPagina,
}

#[async_trait]
pub trait ListOrdersUseCaseTrait: Send + Sync {
    async fn execute(&self, params: ListOrdersParams) -> Result<Pagina<Order>, OrderError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListOrdersUseCase {}

        #[async_trait]
        impl ListOrdersUseCaseTrait for ListOrdersUseCase {
            async fn execute(&self, params: ListOrdersParams) -> Result<Pagina<Order>, OrderError>;
        }
    }
}

pub struct ListOrdersUseCaseImpl {
    pub repository: Arc<dyn OrderRepositoryTrait>,
}

#[async_trait]
impl ListOrdersUseCaseTrait for ListOrdersUseCaseImpl {
    async fn execute(&self, params: ListOrdersParams) -> Result<Pagina<Order>, OrderError> {
        tracing::info!(
            limit = params.page.limite(),
            offset = params.page.desplazamiento(),
            "list_orders: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_orders: repository failed"))
            .map_err(OrderError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_order::{
        modelo::{Order, OrderProps},
        repositorio::mocks::MockOrderRepository,
    };
    use puerto_nucleo::PeticionPagina;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn should_return_the_page_of_orders() {
        let entities = vec![
            Order::new(OrderProps { total: 42 }).unwrap(),
            Order::new(OrderProps { total: 42 }).unwrap(),
        ];
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Pagina::new(entities.clone(), 2, page)));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrdersParams {
                actor: MadrePrincipal::aleatorio(),
                page: PeticionPagina::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.elementos.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_orders_exist() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Pagina::new(vec![], 0, page)));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrdersParams {
                actor: MadrePrincipal::aleatorio(),
                page: PeticionPagina::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.elementos.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limite() == 5 && page.desplazamiento() == 10)
            .returning(|page| Ok(Pagina::new(vec![], 0, page)));
        let use_case = ListOrdersUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListOrdersParams {
                actor: MadrePrincipal::aleatorio(),
                page: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().desplazamiento, 10);
    }
}

