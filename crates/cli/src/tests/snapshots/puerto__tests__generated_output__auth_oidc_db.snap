=== contextos/product/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ProductError {
    #[error("product.validation_error.{0}")]
    ValidationError(String),
    #[error("product.not_found")]
    NotFound,
    #[error("product.duplicate")]
    Duplicate,
    #[error("product.repository_error")]
    RepositoryError,
    #[error("product.unknown")]
    Unknown,
    /// The caller may not do this with this data: a rule of the use case, on its `actor`.
    #[error("product.forbidden")]
    Forbidden,
    #[error("product.invalid_name")]
    InvalidName,
    #[error("product.invalid_status")]
    InvalidStatus,
}

impl From<ErrorRepositorio> for ProductError {
    /// Every failure `puerto-nucleo` names has its arm. `ErrorRepositorio` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicate,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => {
                Self::RepositoryError
            }
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = ProductError::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "product.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = ProductError::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "product.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = ProductError::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "product.repository_error");
    }
}

