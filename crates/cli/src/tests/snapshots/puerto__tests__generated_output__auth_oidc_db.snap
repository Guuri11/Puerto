);

CREATE UNIQUE INDEX products_sku_key ON products (sku) WHERE deleted = false;

=== migraciones/<version>_create_users_table.sql ===
-- Puerto migration: create_users_table
-- Run `make sqlx/prepare` after editing this file.

-- Cada llamante autenticado (ADR-0021 § 3 de Puerto). `(emisor, sujeto)` es el nombre que el
-- proveedor da a la persona; en un proyecto OIDC no se leen los `roles`: deciden los del token.
CREATE TABLE usuarios (
    id UUID PRIMARY KEY,
    emisor TEXT NOT NULL,
    sujeto TEXT NOT NULL,
    email TEXT,
    nombre TEXT,
    roles TEXT[] NOT NULL DEFAULT '{}',
    creado_en TIMESTAMPTZ NOT NULL,
    actualizado_en TIMESTAMPTZ NOT NULL,
    UNIQUE (emisor, sujeto)
);

