=== contextos/product/rest/src/errores.rs ===
use dominio_product::errores::ProductError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// A product error as its HTTP status and body (ADR-0007 of Puerto): validation failures and
/// invalid value objects are 422 — the request was well-formed (poem answers 400 for one that is
/// not) but breaks a domain rule. Exhaustive on purpose: a new error variant does not compile
/// until it has a status.
pub fn a_respuesta_error(err: ProductError) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        ProductError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
        ProductError::NotFound => StatusCode::NOT_FOUND,
        ProductError::Duplicate => StatusCode::CONFLICT,
        ProductError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
        ProductError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
        ProductError::Forbidden => StatusCode::FORBIDDEN,
        ProductError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
        ProductError::InvalidStatus => StatusCode::UNPROCESSABLE_ENTITY,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            a_respuesta_error(ProductError::ValidationError("name_empty".into()));

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.codigo, "product.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(ProductError::NotFound);

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.codigo, "product.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(ProductError::Duplicate);

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.codigo, "product.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(ProductError::RepositoryError);

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.codigo, "product.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(ProductError::Unknown);

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.codigo, "product.unknown");
    }

    #[test]
    fn should_map_forbidden_to_403_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(ProductError::Forbidden);

        // Assert
        assert_eq!(status, StatusCode::FORBIDDEN);
        assert_eq!(body.codigo, "product.forbidden");
    }

    #[test]
    fn should_map_invalid_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(ProductError::InvalidName);

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.codigo, "product.invalid_name");
    }

    #[test]
    fn should_map_invalid_status_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(ProductError::InvalidStatus);

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.codigo, "product.invalid_status");
    }
}

