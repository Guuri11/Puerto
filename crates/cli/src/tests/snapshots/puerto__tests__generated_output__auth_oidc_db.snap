use async_trait::async_trait;
use dominio_order::errores::OrderError;
use dominio_order::modelo::OrderId;
use dominio_order::repositorio::OrderRepositoryTrait;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct DeleteOrderParams {
    /// Who asks (ADR-0021). A rule that depends on the data ("only the owner edits") decides on
    /// it here and answers `Forbidden`.
    pub actor: Principal,
    pub id: OrderId,
}

#[async_trait]
pub trait DeleteOrderUseCaseTrait: Send + Sync {
    async fn execute(&self, params: DeleteOrderParams) -> Result<(), OrderError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub DeleteOrderUseCase {}

        #[async_trait]
        impl DeleteOrderUseCaseTrait for DeleteOrderUseCase {
            async fn execute(&self, params: DeleteOrderParams) -> Result<(), OrderError>;
        }
    }
}

pub struct DeleteOrderUseCaseImpl {
    pub repository: Arc<dyn OrderRepositoryTrait>,
}

#[async_trait]
impl DeleteOrderUseCaseTrait for DeleteOrderUseCaseImpl {
    async fn execute(&self, params: DeleteOrderParams) -> Result<(), OrderError> {
        tracing::info!(id = %params.id, "delete_order: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_order: repository failed"))?
            .ok_or_else(|| {
                let err = OrderError::NotFound;
                tracing::warn!(error = %err, "delete_order: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_order: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_order::{
        modelo::{Order, OrderId, OrderProps},
        repositorio::mocks::MockOrderRepository,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn should_soft_delete_order_when_id_exists() {
        let entity = Order::new(OrderProps { total: 42 }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockOrderRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteOrderUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteOrderParams {
                actor: MadrePrincipal::aleatorio(),
                id: entity_id,
            })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_order_does_not_exist() {
        let mut mock_repo = MockOrderRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteOrderUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteOrderParams {
                actor: MadrePrincipal::aleatorio(),
                id: OrderId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "order.not_found");
    }
}

