use async_trait::async_trait;
use dominio_product::errores::ProductError;
use dominio_product::modelo::Product;
use dominio_product::repositorio::ProductRepositoryTrait;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ListProductsParams {
    pub page: PeticionPagina,
}

#[async_trait]
pub trait ListProductsUseCaseTrait: Send + Sync {
    async fn execute(&self, params: ListProductsParams) -> Result<Pagina<Product>, ProductError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListProductsUseCase {}

        #[async_trait]
        impl ListProductsUseCaseTrait for ListProductsUseCase {
            async fn execute(&self, params: ListProductsParams) -> Result<Pagina<Product>, ProductError>;
        }
    }
}

pub struct ListProductsUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl ListProductsUseCaseTrait for ListProductsUseCaseImpl {
    async fn execute(&self, params: ListProductsParams) -> Result<Pagina<Product>, ProductError> {
        tracing::info!(
            limit = params.page.limite(),
            offset = params.page.desplazamiento(),
            "list_products: start"
        );
        self.repository
            .find_all(params.page)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "list_products: repository failed"))
            .map_err(ProductError::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_product::valores::Name;
    use dominio_product::valores::Status;
    use dominio_product::{
        modelo::{Product, ProductProps},
        repositorio::mocks::MockProductRepository,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn should_return_the_page_of_products() {
        let entities = vec![
            Product::new(ProductProps {
                name: Name::new("first".to_string()).expect("valid Name"),
                sku: "first".to_string(),
                price: 42,
                status: Status::Draft,
            })
            .unwrap(),
            Product::new(ProductProps {
                name: Name::new("second".to_string()).expect("valid Name"),
                sku: "second".to_string(),
                price: 42,
                status: Status::Draft,
            })
            .unwrap(),
        ];
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move |page| Ok(Pagina::new(entities.clone(), 2, page)));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListProductsParams {
                page: PeticionPagina::default(),
            })
            .await;

        let page = result.unwrap();
        assert_eq!(page.elementos.len(), 2);
        assert_eq!(page.total, 2);
    }

    #[tokio::test]
    async fn should_return_an_empty_page_when_no_products_exist() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .returning(|page| Ok(Pagina::new(vec![], 0, page)));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListProductsParams {
                page: PeticionPagina::default(),
            })
            .await;

        let page = result.unwrap();
        assert!(page.elementos.is_empty());
        assert_eq!(page.total, 0);
    }

    #[tokio::test]
    async fn should_pass_the_requested_page_to_the_repository() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_all()
            .withf(|page| page.limite() == 5 && page.desplazamiento() == 10)
            .returning(|page| Ok(Pagina::new(vec![], 0, page)));
        let use_case = ListProductsUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(ListProductsParams {
                page: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(result.unwrap().desplazamiento, 10);
    }
}

