=== contextos/order/rest/src/respuestas.rs ===
// A success variant carries the whole DTO, so it outgrows the error variants as the entity gains
// fields. A response is built once per request and returned: boxing the DTO would only add an
// allocation.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{OrderDto, OrderPageDto};

#[derive(ApiResponse)]
pub enum CreateOrderResponse {
    #[oai(status = 201)]
    Created(Json<OrderDto>),
    #[oai(status = 422)]
    UnprocessableEntity(Json<RespuestaError>),
    #[oai(status = 401)]
    Unauthorized(Json<RespuestaError>),
    #[oai(status = 403)]
    Forbidden(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflict(Json<RespuestaError>),
    /// The token could not be checked: the provider or the database is down (`BearerAuth`).
    #[oai(status = 503)]
    Unavailable(Json<RespuestaError>),
    #[oai(status = 500)]
    InternalError(Json<RespuestaError>),
}

impl CreateOrderResponse {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::UnprocessableEntity(error),
            StatusCode::UNAUTHORIZED => Self::Unauthorized(error),
            StatusCode::FORBIDDEN => Self::Forbidden(error),
            StatusCode::CONFLICT => Self::Conflict(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::Unavailable(error),
            _ => Self::InternalError(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum GetOrderResponse {
    #[oai(status = 200)]
    Ok(Json<OrderDto>),
    #[oai(status = 401)]
    Unauthorized(Json<RespuestaError>),
    #[oai(status = 403)]
    Forbidden(Json<RespuestaError>),
    #[oai(status = 404)]
    NotFound(Json<RespuestaError>),
    /// The token could not be checked: the provider or the database is down (`BearerAuth`).
    #[oai(status = 503)]
    Unavailable(Json<RespuestaError>),
    #[oai(status = 500)]
    InternalError(Json<RespuestaError>),
}

impl GetOrderResponse {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::Unauthorized(error),
            StatusCode::FORBIDDEN => Self::Forbidden(error),
            StatusCode::NOT_FOUND => Self::NotFound(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::Unavailable(error),
            _ => Self::InternalError(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum ListOrdersResponse {
    #[oai(status = 200)]
    Ok(Json<OrderPageDto>),
    #[oai(status = 401)]
    Unauthorized(Json<RespuestaError>),
    #[oai(status = 403)]
    Forbidden(Json<RespuestaError>),
    /// The token could not be checked: the provider or the database is down (`BearerAuth`).
    #[oai(status = 503)]
    Unavailable(Json<RespuestaError>),
    #[oai(status = 500)]
    InternalError(Json<RespuestaError>),
}

impl ListOrdersResponse {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::Unauthorized(error),
            StatusCode::FORBIDDEN => Self::Forbidden(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::Unavailable(error),
            _ => Self::InternalError(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum UpdateOrderResponse {
    #[oai(status = 200)]
    Ok(Json<OrderDto>),
    #[oai(status = 422)]
    UnprocessableEntity(Json<RespuestaError>),
    #[oai(status = 401)]
    Unauthorized(Json<RespuestaError>),
    #[oai(status = 403)]
    Forbidden(Json<RespuestaError>),
    #[oai(status = 404)]
    NotFound(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflict(Json<RespuestaError>),
    /// The token could not be checked: the provider or the database is down (`BearerAuth`).
    #[oai(status = 503)]
    Unavailable(Json<RespuestaError>),
    #[oai(status = 500)]
    InternalError(Json<RespuestaError>),
}

impl UpdateOrderResponse {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::UnprocessableEntity(error),
            StatusCode::UNAUTHORIZED => Self::Unauthorized(error),
            StatusCode::FORBIDDEN => Self::Forbidden(error),
            StatusCode::NOT_FOUND => Self::NotFound(error),
            StatusCode::CONFLICT => Self::Conflict(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::Unavailable(error),
            _ => Self::InternalError(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum DeleteOrderResponse {
    #[oai(status = 204)]
    NoContent,
    #[oai(status = 401)]
    Unauthorized(Json<RespuestaError>),
    #[oai(status = 403)]
    Forbidden(Json<RespuestaError>),
    #[oai(status = 404)]
    NotFound(Json<RespuestaError>),
    /// The token could not be checked: the provider or the database is down (`BearerAuth`).
    #[oai(status = 503)]
    Unavailable(Json<RespuestaError>),
    #[oai(status = 500)]
    InternalError(Json<RespuestaError>),
}

impl DeleteOrderResponse {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::Unauthorized(error),
            StatusCode::FORBIDDEN => Self::Forbidden(error),
            StatusCode::NOT_FOUND => Self::NotFound(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::Unavailable(error),
            _ => Self::InternalError(error),
        }
    }
}

=== contextos/order/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_order::{
    create_order::{CreateOrderParams, CreateOrderUseCaseTrait},
    delete_order::{DeleteOrderParams, DeleteOrderUseCaseTrait},
    get_order::{GetOrderParams, GetOrderUseCaseTrait},
    list_orders::{ListOrdersParams, ListOrdersUseCaseTrait},
    update_order::{UpdateOrderParams, UpdateOrderUseCaseTrait},
};
use dominio_order::modelo::OrderId;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use puerto_web::auth::BearerAuth;
use uuid::Uuid;

use crate::dto::{CreateOrderRequest, OrderDto, OrderPageDto, UpdateOrderRequest};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    CreateOrderResponse, DeleteOrderResponse, GetOrderResponse, ListOrdersResponse,
    UpdateOrderResponse,
};

#[derive(Tags)]
enum ApiTags {
    Order,
}

/// Holds the use case ports; `generado/bootstrap.rs` plugs in the implementations.
pub struct OrderApi {
    pub create_order: Arc<dyn CreateOrderUseCaseTrait>,
    pub get_order: Arc<dyn GetOrderUseCaseTrait>,
    pub list_orders: Arc<dyn ListOrdersUseCaseTrait>,
    pub update_order: Arc<dyn UpdateOrderUseCaseTrait>,
    pub delete_order: Arc<dyn DeleteOrderUseCaseTrait>,
}

#[OpenApi]
impl OrderApi {
    /// Create a new Order
    #[oai(path = "/orders", method = "post", tag = "ApiTags::Order")]
    async fn create(
        &self,
        auth: BearerAuth,
        body: Json<CreateOrderRequest>,
    ) -> CreateOrderResponse {
        match self
            .create_order
            .execute(CreateOrderParams {
                actor: auth.0,
                total: body.total,
            })
            .await
        {
            Ok(entity) => CreateOrderResponse::Created(Json(OrderDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(code = %error.0.codigo, "create_order failed");
                CreateOrderResponse::from_status(status, error)
            }
        }
    }

    /// Get a Order by ID
    #[oai(path = "/orders/:id", method = "get", tag = "ApiTags::Order")]
    async fn get_by_id(&self, auth: BearerAuth, id: Path<Uuid>) -> GetOrderResponse {
        match self
            .get_order
            .execute(GetOrderParams {
                actor: auth.0,
                id: OrderId::from_uuid(id.0),
            })
            .await
        {
            Ok(entity) => GetOrderResponse::Ok(Json(OrderDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(code = %error.0.codigo, "get_order failed");
                GetOrderResponse::from_status(status, error)
            }
        }
    }

    /// List Orders, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/orders", method = "get", tag = "ApiTags::Order")]
    async fn list(
        &self,
        auth: BearerAuth,
        limit: Query<Option<u32>>,
        offset: Query<Option<u32>>,
    ) -> ListOrdersResponse {
        match self
            .list_orders
            .execute(ListOrdersParams {
                actor: auth.0,
                page: PeticionPagina::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListOrdersResponse::Ok(Json(OrderPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(code = %error.0.codigo, "list_orders failed");
                ListOrdersResponse::from_status(status, error)
            }
        }
    }

    /// Update a Order
    #[oai(path = "/orders/:id", method = "put", tag = "ApiTags::Order")]
    async fn update(
        &self,
        auth: BearerAuth,
        id: Path<Uuid>,
        body: Json<UpdateOrderRequest>,
    ) -> UpdateOrderResponse {
        match self
            .update_order
            .execute(UpdateOrderParams {
                actor: auth.0,
                id: OrderId::from_uuid(id.0),
                total: body.total,
            })
            .await
        {
            Ok(entity) => UpdateOrderResponse::Ok(Json(OrderDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(code = %error.0.codigo, "update_order failed");
                UpdateOrderResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Order
    #[oai(path = "/orders/:id", method = "delete", tag = "ApiTags::Order")]
    async fn delete(&self, auth: BearerAuth, id: Path<Uuid>) -> DeleteOrderResponse {
        match self
            .delete_order
            .execute(DeleteOrderParams {
                actor: auth.0,
                id: OrderId::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => DeleteOrderResponse::NoContent,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(code = %error.0.codigo, "delete_order failed");
                DeleteOrderResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_order::{
        create_order::mocks::MockCreateOrderUseCase, delete_order::mocks::MockDeleteOrderUseCase,
        get_order::mocks::MockGetOrderUseCase, list_orders::mocks::MockListOrdersUseCase,
        update_order::mocks::MockUpdateOrderUseCase,
    };
    use dominio_order::errores::OrderError;
    use dominio_order::pruebas::madres::OrderMother;
    use poem::{EndpointExt, Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;
    use puerto_nucleo::auth::dobles::MadrePrincipal;
    use puerto_nucleo::auth::dobles::MockAutenticador;
    use puerto_nucleo::auth::{Autenticador, ErrorAuth};

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateOrderUseCase,
        get: MockGetOrderUseCase,
        list: MockListOrdersUseCase,
        update: MockUpdateOrderUseCase,
        delete: MockDeleteOrderUseCase,
    }

    /// Accepts `caller` (every role a route of this API requires) and `nobody` (no role).
    fn authenticator() -> Arc<dyn Autenticador> {
        let mut authenticator = MockAutenticador::new();
        authenticator
            .expect_autenticar()
            .returning(|token| match token {
                "caller" => Ok(MadrePrincipal::aleatorio()),
                "nobody" => Ok(MadrePrincipal::aleatorio()),
                _ => Err(ErrorAuth::Invalido),
            });
        Arc::new(authenticator)
    }

    impl Mocks {
        /// Every request signed in as `caller`.
        fn client(self) -> TestClient<impl poem::Endpoint> {
            self.client_with(Some("Bearer caller"))
        }

        /// `authorization`: the header every request sends; `None` sends none.
        fn client_with(self, authorization: Option<&str>) -> TestClient<impl poem::Endpoint> {
            let api = OrderApi {
                create_order: Arc::new(self.create),
                get_order: Arc::new(self.get),
                list_orders: Arc::new(self.list),
                update_order: Arc::new(self.update),
                delete_order: Arc::new(self.delete),
            };
            let client = TestClient::new(
                Route::new()
                    .nest("/", OpenApiService::new(api, "test", "1.0"))
                    .data(authenticator()),
            );
            match authorization {
                Some(value) => client.default_header("Authorization", value),
                None => client,
            }
        }
    }

    fn create_request() -> CreateOrderRequest {
        CreateOrderRequest { total: 42 }
    }

    fn update_request() -> UpdateOrderRequest {
        UpdateOrderRequest { total: 42 }
    }

    fn item_path() -> String {
        format!("/orders/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_order_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Ok(OrderMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/orders")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_order_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(OrderError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/orders")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_order_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Ok(OrderMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_order_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .get
            .expect_execute()
            .returning(|_| Err(OrderError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_orders_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Pagina::new(OrderMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/orders").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.page)));

        // Act
        let response = mocks.client().get("/orders?limit=5&offset=10").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|_| Err(OrderError::RepositoryError));

        // Act
        let response = mocks.client().get("/orders").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_order_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Ok(OrderMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_order() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .update
            .expect_execute()
            .returning(|_| Err(OrderError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_order_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_order() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .delete
            .expect_execute()
            .returning(|_| Err(OrderError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_401_when_creating_without_a_token() {
        // Arrange — no expectation: the use case is never reached
        let mocks = Mocks::default();

        // Act
        let response = mocks
            .client_with(None)
            .post("/orders")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn should_respond_401_when_getting_without_a_token() {
        // Arrange — no expectation: the use case is never reached
        let mocks = Mocks::default();

        // Act
        let response = mocks.client_with(None).get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn should_respond_401_when_listing_without_a_token() {
        // Arrange — no expectation: the use case is never reached
        let mocks = Mocks::default();

        // Act
        let response = mocks.client_with(None).get("/orders").send().await;

        // Assert
        response.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn should_respond_401_when_updating_without_a_token() {
        // Arrange — no expectation: the use case is never reached
        let mocks = Mocks::default();

        // Act
        let response = mocks
            .client_with(None)
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn should_respond_401_when_deleting_without_a_token() {
        // Arrange — no expectation: the use case is never reached
        let mocks = Mocks::default();

        // Act
        let response = mocks.client_with(None).delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::UNAUTHORIZED);
    }
}

=== contextos/product/aplicacion/Cargo.toml ===
[package]
name = "aplicacion_product"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_product = { workspace = true }
puerto-nucleo = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# The use cases' doubles (`mock!`), for the tests of other crates (ADR-0023 § 5 of Puerto).
pruebas = ["dep:mockall", "dominio_product/pruebas"]

[dev-dependencies]
# The tests' callers: `MadrePrincipal`, and the routes' `MockAutenticador`.
puerto-nucleo = { workspace = true, features = ["pruebas"] }
dominio_product = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/product/aplicacion/src/create_product.rs ===
use async_trait::async_trait;
use dominio_product::errores::ProductError;
use dominio_product::modelo::{Product, ProductProps};
use dominio_product::repositorio::ProductRepositoryTrait;
use dominio_product::valores::{Name, Status};
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct CreateProductParams {
    /// Who asks (ADR-0021). A rule that depends on the data ("only the owner edits") decides on
    /// it here and answers `Forbidden`.
    pub actor: Principal,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
}

#[async_trait]
pub trait CreateProductUseCaseTrait: Send + Sync {
    async fn execute(&self, params: CreateProductParams) -> Result<Product, ProductError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub CreateProductUseCase {}

        #[async_trait]
        impl CreateProductUseCaseTrait for CreateProductUseCase {
            async fn execute(&self, params: CreateProductParams) -> Result<Product, ProductError>;
        }
    }
}

pub struct CreateProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl CreateProductUseCaseTrait for CreateProductUseCaseImpl {
    async fn execute(&self, params: CreateProductParams) -> Result<Product, ProductError> {
        tracing::info!("create_product: start");
        let name = Name::new(params.name)?;
        let status = params.status.parse::<Status>()?;
        let entity = Product::new(ProductProps {
            name,
            sku: params.sku,
            price: params.price,
            status,
        })
        .inspect_err(|e| tracing::warn!(error = %e, "create_product: rejected"))?;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "create_product: repository failed"))?;
        tracing::info!(id = %entity.id, "create_product: done");
        Ok(entity)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_product::repositorio::mocks::MockProductRepository;
    use puerto_nucleo::ErrorRepositorio;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn should_create_product_when_fields_are_valid() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                actor: MadrePrincipal::aleatorio(),
                name: "example".to_string(),
                sku: "example".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_ok());
        assert_eq!(result.unwrap().sku, "example");
    }

    #[tokio::test]
    async fn should_return_duplicate_when_the_store_rejects_a_duplicate() {
        // Arrange
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_save()
            .returning(|_| Err(ErrorRepositorio::Duplicado));
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                actor: MadrePrincipal::aleatorio(),
                name: "example".to_string(),
                sku: "example".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.duplicate");
    }

    #[tokio::test]
    async fn should_return_error_when_sku_is_empty() {
        // Arrange
        let mock_repo = MockProductRepository::new();
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                actor: MadrePrincipal::aleatorio(),
                name: "example".to_string(),
                sku: "".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "product.validation_error.sku_empty"
        );
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let mock_repo = MockProductRepository::new();
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                actor: MadrePrincipal::aleatorio(),
                name: "".to_string(),
                sku: "example".to_string(),
                price: 42,
                status: "Draft".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_name");
    }

    #[tokio::test]
    async fn should_return_error_when_status_is_empty() {
        // Arrange
        let mock_repo = MockProductRepository::new();
        let use_case = CreateProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(CreateProductParams {
                actor: MadrePrincipal::aleatorio(),
                name: "example".to_string(),
                sku: "example".to_string(),
                price: 42,
                status: "".to_string(),
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.invalid_status");
    }
}

=== contextos/product/aplicacion/src/delete_product.rs ===
use async_trait::async_trait;
use dominio_product::errores::ProductError;
use dominio_product::modelo::ProductId;
use dominio_product::repositorio::ProductRepositoryTrait;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct DeleteProductParams {
    /// Who asks (ADR-0021). A rule that depends on the data ("only the owner edits") decides on
    /// it here and answers `Forbidden`.
    pub actor: Principal,
    pub id: ProductId,
}

#[async_trait]
pub trait DeleteProductUseCaseTrait: Send + Sync {
    async fn execute(&self, params: DeleteProductParams) -> Result<(), ProductError>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod mocks {
    use mockall::mock;

    use super::*;

    mock! {
        pub DeleteProductUseCase {}

        #[async_trait]
        impl DeleteProductUseCaseTrait for DeleteProductUseCase {
            async fn execute(&self, params: DeleteProductParams) -> Result<(), ProductError>;
        }
    }
}

pub struct DeleteProductUseCaseImpl {
    pub repository: Arc<dyn ProductRepositoryTrait>,
}

#[async_trait]
impl DeleteProductUseCaseTrait for DeleteProductUseCaseImpl {
    async fn execute(&self, params: DeleteProductParams) -> Result<(), ProductError> {
        tracing::info!(id = %params.id, "delete_product: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_product: repository failed"))?
            .ok_or_else(|| {
                let err = ProductError::NotFound;
                tracing::warn!(error = %err, "delete_product: rejected");
                err
            })?;
        let now = chrono::Utc::now();
        entity.deleted = true;
        entity.deleted_at = Some(now);
        entity.updated_at = now;
        self.repository
            .save(&entity)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "delete_product: repository failed"))?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_product::valores::Name;
    use dominio_product::valores::Status;
    use dominio_product::{
        modelo::{Product, ProductId, ProductProps},
        repositorio::mocks::MockProductRepository,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn should_soft_delete_product_when_id_exists() {
        let entity = Product::new(ProductProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: "example".to_string(),
            price: 42,
            status: Status::Draft,
        })
        .unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockProductRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = DeleteProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteProductParams {
                actor: MadrePrincipal::aleatorio(),
                id: entity_id,
            })
            .await;

        assert!(result.is_ok());
    }

    #[tokio::test]
    async fn should_return_not_found_when_product_does_not_exist() {
        let mut mock_repo = MockProductRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = DeleteProductUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case
            .execute(DeleteProductParams {
                actor: MadrePrincipal::aleatorio(),
                id: ProductId::generate(),
            })
            .await;

        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "product.not_found");
    }
}

