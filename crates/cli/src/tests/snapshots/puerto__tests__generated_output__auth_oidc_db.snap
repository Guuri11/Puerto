use dominio_order::modelo::Order;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct OrderDto {
    pub id: Uuid,
    pub total: i64,
}

impl OrderDto {
    pub fn from_domain(entity: &Order) -> Self {
        Self {
            id: entity.id.value(),
            total: entity.total,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct CreateOrderRequest {
    pub total: i64,
}

/// One page of Orders: `total` counts them all, `limit` is the one the API applied.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct OrderPageDto {
    pub items: Vec<OrderDto>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

impl OrderPageDto {
    pub fn from_domain(page: &Pagina<Order>) -> Self {
        Self {
            items: page.elementos.iter().map(OrderDto::from_domain).collect(),
            total: page.total,
            limit: page.limite,
            offset: page.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct UpdateOrderRequest {
    pub total: i64,
}

=== contextos/order/rest/src/errores.rs ===
use dominio_order::errores::OrderError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;
use puerto_web::RespuestaError;

/// A order error as its HTTP status and body (ADR-0007 of Puerto): validation failures and
/// invalid value objects are 422 — the request was well-formed (poem answers 400 for one that is
/// not) but breaks a domain rule. Exhaustive on purpose: a new error variant does not compile
/// until it has a status.
pub fn a_respuesta_error(err: OrderError) -> (StatusCode, Json<RespuestaError>) {
    let status = match &err {
        OrderError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
        OrderError::NotFound => StatusCode::NOT_FOUND,
        OrderError::Duplicate => StatusCode::CONFLICT,
        OrderError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
        OrderError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
        OrderError::Forbidden => StatusCode::FORBIDDEN,
    };
    (status, Json(RespuestaError::from_codigo(err.to_string())))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) =
            a_respuesta_error(OrderError::ValidationError("name_empty".into()));

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.codigo, "order.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderError::NotFound);

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.codigo, "order.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderError::Duplicate);

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.codigo, "order.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderError::RepositoryError);

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.codigo, "order.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderError::Unknown);

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.codigo, "order.unknown");
    }

    #[test]
    fn should_map_forbidden_to_403_with_its_code() {
        // Act
        let (status, Json(body)) = a_respuesta_error(OrderError::Forbidden);

        // Assert
        assert_eq!(status, StatusCode::FORBIDDEN);
        assert_eq!(body.codigo, "order.forbidden");
    }
}

