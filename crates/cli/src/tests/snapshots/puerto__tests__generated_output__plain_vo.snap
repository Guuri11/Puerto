            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

=== contextos/articulo/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_articulo::{
    actualizar_articulo::{ActualizarArticulo, ParamsActualizarArticulo},
    borrar_articulo::{BorrarArticulo, ParamsBorrarArticulo},
    crear_articulo::{CrearArticulo, ParamsCrearArticulo},
    listar_articulos::{ListarArticulos, ParamsListarArticulos},
    obtener_articulo::{ObtenerArticulo, ParamsObtenerArticulo},
};
use dominio_articulo::modelo::IdArticulo;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{
    DtoArticulo, DtoPaginaArticulo, PeticionActualizarArticulo, PeticionCrearArticulo,
};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarArticulo, RespuestaBorrarArticulo, RespuestaCrearArticulo,
    RespuestaListarArticulos, RespuestaObtenerArticulo,
};

#[derive(Tags)]
enum ApiTags {
    Articulo,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiArticulo {
    pub crear_articulo: Arc<dyn CrearArticulo>,
    pub obtener_articulo: Arc<dyn ObtenerArticulo>,
    pub listar_articulos: Arc<dyn ListarArticulos>,
    pub actualizar_articulo: Arc<dyn ActualizarArticulo>,
    pub borrar_articulo: Arc<dyn BorrarArticulo>,
}

#[OpenApi]
impl ApiArticulo {
    /// Crea: Articulo
    #[oai(path = "/articulos", method = "post", tag = "ApiTags::Articulo")]
    async fn crear(&self, cuerpo: Json<PeticionCrearArticulo>) -> RespuestaCrearArticulo {
        match self
            .crear_articulo
            .ejecutar(ParamsCrearArticulo {
                name: cuerpo.name.clone(),
                sku: cuerpo.sku.clone(),
                weight: cuerpo.weight,
            })
            .await
        {
            Ok(entidad) => {
                RespuestaCrearArticulo::Creado(Json(DtoArticulo::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_articulo falló");
                RespuestaCrearArticulo::from_status(status, error)
            }
        }
    }

    /// Obtiene: Articulo por id
    #[oai(path = "/articulos/:id", method = "get", tag = "ApiTags::Articulo")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerArticulo {
        match self
            .obtener_articulo
            .ejecutar(ParamsObtenerArticulo {
                id: IdArticulo::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerArticulo::Ok(Json(DtoArticulo::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_articulo falló");
                RespuestaObtenerArticulo::from_status(status, error)
            }
        }
    }

    /// Lista Articulos, página a página (el dominio acota `limite`)
    #[oai(path = "/articulos", method = "get", tag = "ApiTags::Articulo")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarArticulos {
        match self
            .listar_articulos
            .ejecutar(ParamsListarArticulos {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarArticulos::Ok(Json(DtoPaginaArticulo::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_articulos falló");
                RespuestaListarArticulos::from_status(status, error)
            }
        }
    }

    /// Actualiza: Articulo
    #[oai(path = "/articulos/:id", method = "put", tag = "ApiTags::Articulo")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarArticulo>,
    ) -> RespuestaActualizarArticulo {
        match self
            .actualizar_articulo
            .ejecutar(ParamsActualizarArticulo {
                id: IdArticulo::from_uuid(id.0),
                name: cuerpo.name.clone(),
                sku: cuerpo.sku.clone(),
                weight: cuerpo.weight,
            })
            .await
        {
            Ok(entidad) => {
                RespuestaActualizarArticulo::Ok(Json(DtoArticulo::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_articulo falló");
                RespuestaActualizarArticulo::from_status(status, error)
            }
        }
    }

    /// Borra: Articulo
    #[oai(path = "/articulos/:id", method = "delete", tag = "ApiTags::Articulo")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarArticulo {
        match self
            .borrar_articulo
            .ejecutar(ParamsBorrarArticulo {
                id: IdArticulo::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarArticulo::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_articulo falló");
                RespuestaBorrarArticulo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_articulo::{
        actualizar_articulo::dobles::MockActualizarArticulo,
        borrar_articulo::dobles::MockBorrarArticulo, crear_articulo::dobles::MockCrearArticulo,
        listar_articulos::dobles::MockListarArticulos,
        obtener_articulo::dobles::MockObtenerArticulo,
    };
    use dominio_articulo::errores::ErrorArticulo;
    use dominio_articulo::pruebas::madres::MadreArticulo;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearArticulo,
        obtener: MockObtenerArticulo,
        listar: MockListarArticulos,
        actualizar: MockActualizarArticulo,
        borrar: MockBorrarArticulo,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiArticulo {
                crear_articulo: Arc::new(self.crear),
                obtener_articulo: Arc::new(self.obtener),
                listar_articulos: Arc::new(self.listar),
                actualizar_articulo: Arc::new(self.actualizar),
                borrar_articulo: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearArticulo {
        PeticionCrearArticulo {
            name: "example".to_string(),
            sku: "example".to_string(),
            weight: 42,
        }
    }

    fn peticion_actualizar() -> PeticionActualizarArticulo {
        PeticionActualizarArticulo {
            name: "example".to_string(),
            sku: "example".to_string(),
            weight: 42,
        }
    }

    fn ruta_elemento() -> String {
        format!("/articulos/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_articulo() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreArticulo::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/articulos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_articulo_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticulo::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/articulos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_articulo_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreArticulo::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_articulo_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticulo::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_articulos_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreArticulo::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/articulos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/articulos?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticulo::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/articulos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_articulo() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreArticulo::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_articulo_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticulo::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_articulo() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_articulo_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorArticulo::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

=== contextos/saludo/aplicacion/src/obtener_saludo.rs ===
use std::sync::Arc;

use async_trait::async_trait;
use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo, repositorio::RepositorioSaludo};

#[derive(Debug, Clone)]
pub struct ParamsObtenerSaludo {
    pub nombre: String,
}

#[async_trait]
pub trait ObtenerSaludo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerSaludo {}

        #[async_trait]
        impl ObtenerSaludo for ObtenerSaludo {
            async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo>;
        }
    }
}

pub struct ObtenerSaludoImpl {
    pub repositorio: Arc<dyn RepositorioSaludo>,
}

#[async_trait]
impl ObtenerSaludo for ObtenerSaludoImpl {
    async fn ejecutar(&self, params: ParamsObtenerSaludo) -> Result<Saludo, ErrorSaludo> {
        tracing::info!(nombre = %params.nombre, "obtener_saludo: inicio");

        if params.nombre.trim().is_empty() {
            let err = ErrorSaludo::Validacion("nombre_vacio".into());
            tracing::warn!(error = %err, "obtener_saludo: rechazado");
            return Err(err);
        }

        let resultado = match self
            .repositorio
            .buscar_por_nombre(&params.nombre)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "obtener_saludo: fallo del repositorio"))?
        {
            Some(saludo) => saludo,
            None => Saludo::new(&params.nombre)?,
        };

        tracing::info!("obtener_saludo: fin");
        Ok(resultado)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_saludo::repositorio::dobles::MockRepositorioSaludo;

    #[tokio::test]
    async fn deberia_devolver_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(|_| Ok(None));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Mundo".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        let saludo = resultado.unwrap();
        assert_eq!(saludo.nombre, "Mundo");
        assert!(saludo.mensaje.contains("Mundo"));
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_el_nombre_esta_vacio() {
        // Preparar
        let repositorio_doble = MockRepositorioSaludo::new();
        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo { nombre: "".into() })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "saludo.validacion.nombre_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_el_saludo_guardado_cuando_esta_en_el_repositorio() {
        // Preparar
        let en_cache = Saludo {
            nombre: "Puerto".into(),
            mensaje: "¡Hola desde la caché!".into(),
        };
        let mut repositorio_doble = MockRepositorioSaludo::new();
        repositorio_doble
            .expect_buscar_por_nombre()
            .returning(move |_| Ok(Some(en_cache.clone())));

        let caso_de_uso = ObtenerSaludoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsObtenerSaludo {
                nombre: "Puerto".into(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(resultado.unwrap().mensaje, "¡Hola desde la caché!");
    }
}

=== contextos/saludo/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ParamsObtenerSaludo};
use poem_openapi::{OpenApi, Tags, param::Path};

use crate::{dto::DtoSaludo, errores::a_respuesta_error, respuestas::RespuestaObtenerSaludo};

#[derive(Tags)]
enum ApiTags {
    Saludo,
}

/// Guarda el puerto del caso de uso; `generado/bootstrap.rs` conecta la implementación.
pub struct ApiSaludo {
    pub obtener_saludo: Arc<dyn ObtenerSaludo>,
}

#[OpenApi]
impl ApiSaludo {
    /// Obtiene un saludo para el nombre dado
    #[oai(path = "/saludos/:nombre", method = "get", tag = "ApiTags::Saludo")]
    async fn obtener_saludo(&self, nombre: Path<String>) -> RespuestaObtenerSaludo {
        match self
            .obtener_saludo
            .ejecutar(ParamsObtenerSaludo { nombre: nombre.0 })
            .await
        {
            Ok(saludo) => RespuestaObtenerSaludo::Ok(poem_openapi::payload::Json(
                DtoSaludo::from_dominio(&saludo),
            )),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_saludo falló");
                RespuestaObtenerSaludo::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_saludo::obtener_saludo::dobles::MockObtenerSaludo;
    use dominio_saludo::{errores::ErrorSaludo, modelo::Saludo};
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::OpenApiService;

    use super::*;

    fn cliente(caso_de_uso: MockObtenerSaludo) -> TestClient<Route> {
        let api = ApiSaludo {
            obtener_saludo: Arc::new(caso_de_uso),
        };
        TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
    }

    #[tokio::test]
    async fn deberia_responder_200_con_el_saludo_cuando_el_nombre_es_valido() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|params| Saludo::new(&params.nombre));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("nombre")
            .assert_string("Ada");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_se_rechaza_el_saludo() {
        // Preparar
        let mut caso_de_uso = MockObtenerSaludo::new();
        caso_de_uso
            .expect_ejecutar()
            .returning(|_| Err(ErrorSaludo::Validacion("nombre_vacio".into())));

        // Actuar
        let respuesta = cliente(caso_de_uso).get("/saludos/Ada").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }
}

