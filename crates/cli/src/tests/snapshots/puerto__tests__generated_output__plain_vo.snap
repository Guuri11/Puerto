import { Link } from "wouter";
import type { Item } from "../../../../domain/item/model";

export function ItemListView({ items }: { items: Item[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Sku</th>
            <th>Weight</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {items.map((item) => (
            <tr key={item.id}>
              <td>{item.name}</td>
              <td>{item.sku}</td>
              <td>{item.weight}</td>
              <td className="text-right">
                <Link href={`/items/${item.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/test-support/item.ts ===
import { ItemError } from "../domain/item/errors";
import type { Item, ItemDraft } from "../domain/item/model";
import type { ItemRepository } from "../domain/item/repository";

/** Valid items for tests; pass `overrides` for the fields a test is about. */
export const ItemMother = {
  draft(overrides: Partial<ItemDraft> = {}): ItemDraft {
    return {
      name: "example",
      sku: "example",
      weight: 42,
      ...overrides,
    };
  },

  random(overrides: Partial<Item> = {}): Item {
    return { id: crypto.randomUUID(), ...ItemMother.draft(), ...overrides };
  },
};

/** An in-memory `ItemRepository`. Override a method to make it fail. */
export function fakeItemRepository(seed: Item[] = []): ItemRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new ItemError("item.not_found");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}
