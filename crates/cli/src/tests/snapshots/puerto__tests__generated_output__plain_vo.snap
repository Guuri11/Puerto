            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "item.invalid_sku"
        );
    }
}

=== business/src/domain/item/errors.rs ===
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ItemError {
    #[error("item.validation_error.{0}")]
    ValidationError(String),
    #[error("item.not_found")]
    NotFound,
    #[error("item.duplicate")]
    Duplicate,
    #[error("item.repository_error")]
    RepositoryError,
    #[error("item.unknown")]
    Unknown,
    #[error("item.invalid_name")]
    InvalidName,
    #[error("item.invalid_sku")]
    InvalidSku,
    #[error("item.invalid_weight")]
    InvalidWeight,
}

=== business/src/domain/item/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;
use super::value_objects::Name;
use super::value_objects::Sku;
use super::value_objects::Weight;

use super::errors::ItemError;

#[derive(Debug, Clone)]
pub struct ItemProps {
    pub name: Name,
    pub sku: Sku,
    pub weight: Weight,
}

#[derive(Debug, Clone)]
pub struct Item {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: Name,
    pub sku: Sku,
    pub weight: Weight,
}

impl Item {
    pub fn new(props: ItemProps) -> Result<Self, ItemError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
            sku: props.sku,
            weight: props.weight,
        })
    }

    pub fn from_repository(data: Item) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_item_when_fields_are_valid() {
        let result = Item::new(ItemProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            weight: Weight::new(42).expect("valid Weight"),
        });
        assert!(result.is_ok());
    }


    #[test]
    fn should_reject_item_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "item.invalid_name"
        );
    }

    #[test]
    fn should_reject_item_when_sku_is_empty() {
        let result = Sku::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "item.invalid_sku"
        );
    }
}

