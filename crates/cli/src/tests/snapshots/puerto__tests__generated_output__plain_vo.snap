=== business/src/domain/item/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ItemError {
    #[error("item.validation_error.{0}")]
    ValidationError(String),
    #[error("item.not_found")]
    NotFound,
    #[error("item.duplicate")]
    Duplicate,
    #[error("item.repository_error")]
    RepositoryError,
    #[error("item.unknown")]
    Unknown,
    #[error("item.invalid_name")]
    InvalidName,
    #[error("item.invalid_sku")]
    InvalidSku,
    #[error("item.invalid_weight")]
    InvalidWeight,
}

impl From<RepositoryError> for ItemError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = ItemError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "item.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = ItemError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "item.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = ItemError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "item.repository_error");
    }
}

