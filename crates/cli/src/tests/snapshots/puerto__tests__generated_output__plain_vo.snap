    pub sku: String,
    pub weight: i64,
}

/// Una página de Articulos: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaArticulo {
