import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ItemError } from "../../../../domain/item/errors";
import type { ItemDraft } from "../../../../domain/item/model";
import { fakeItemRepository, ItemMother } from "../../../../test-support/item";
import { renderScreen } from "../../../../test-support/render";
import { ItemFormContainer } from "./item-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ItemDraft) {
  await screen.findByText("Save");
  type("Name", draft.name);
  type("Sku", draft.sku);
  type("Weight", String(draft.weight));
}

describe("ItemFormContainer", () => {
  test("should create the item from what was typed and show it", async () => {
    // Arrange
    const draft = ItemMother.draft();
    const itemRepository = fakeItemRepository();
    const { history } = renderScreen(<ItemFormContainer />, { itemRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/items/"));
    const {
      items: [created],
    } = await itemRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/items/${created?.id}`);
  });

  test("should save the edited item when an existing one is submitted", async () => {
    // Arrange
    const seeded = ItemMother.random();
    const itemRepository = fakeItemRepository([seeded]);
    const { history } = renderScreen(<ItemFormContainer id={seeded.id} />, {
      itemRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/items/${seeded.id}`));
    expect(await itemRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "item.validation_error.invalid";
    const itemRepository = {
      ...fakeItemRepository(),
      create: () => Promise.reject(new ItemError(code)),
    };
    renderScreen(<ItemFormContainer />, { itemRepository });
    await fillIn(ItemMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a item with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const itemRepository = {
      ...fakeItemRepository(),
      create: () => Promise.reject(new ItemError("item.duplicate")),
    };
    renderScreen(<ItemFormContainer />, { itemRepository });
    await fillIn(ItemMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An item with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const itemRepository = {
      ...fakeItemRepository(),
      create: () => Promise.reject(new ItemError("item.invalid_name")),
    };
    renderScreen(<ItemFormContainer />, { itemRepository });
    await fillIn(ItemMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Name is not valid")).toBeTruthy();
    const input = screen.getByLabelText("Name");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/item/containers/item-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/item/messages";
import type { Item } from "../../../../domain/item/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { ItemFormView, toItemDraft, toItemForm } from "../views/item-form-view";

/** Creates an item, or edits the one with `id`. */
export function ItemFormContainer({ id }: { id?: string }) {
  const { itemRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : itemRepository.get(id)),
    [itemRepository, id],
  );
  const title = id === undefined ? "New item" : "Edit item";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ItemForm existing={existing.data} />}
      <Link href={id === undefined ? "/items" : `/items/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ItemForm({ existing }: { existing: Item | null }) {
  const { itemRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toItemForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toItemDraft(values);
      const saved =
        existing === null
          ? await itemRepository.create(draft)
          : await itemRepository.update(existing.id, draft);
      navigate(`/items/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <ItemFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

