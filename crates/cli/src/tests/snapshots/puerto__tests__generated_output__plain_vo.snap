// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod saludo {
    use std::sync::Arc;

    use aplicacion_saludo::obtener_saludo::{ObtenerSaludo, ObtenerSaludoImpl};
    use dominio_saludo::repositorio::RepositorioSaludo;
    use infra_saludo::repositorio::RepositorioSaludoEnMemoria;

    /// Los casos de uso de `saludo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub obtener_saludo: Arc<dyn ObtenerSaludo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioSaludo> = Arc::new(RepositorioSaludoEnMemoria::new());
        CasosDeUso {
            obtener_saludo: Arc::new(ObtenerSaludoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod articulo {
    use std::sync::Arc;

    use aplicacion_articulo::actualizar_articulo::{ActualizarArticulo, ActualizarArticuloImpl};
    use aplicacion_articulo::borrar_articulo::{BorrarArticulo, BorrarArticuloImpl};
    use aplicacion_articulo::crear_articulo::{CrearArticulo, CrearArticuloImpl};
    use aplicacion_articulo::listar_articulos::{ListarArticulos, ListarArticulosImpl};
    use aplicacion_articulo::obtener_articulo::{ObtenerArticulo, ObtenerArticuloImpl};
    use dominio_articulo::repositorio::RepositorioArticulo;
    use infra_articulo::repositorio::RepositorioArticuloEnMemoria;

    /// Los casos de uso de `articulo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_articulo: Arc<dyn CrearArticulo>,
        pub obtener_articulo: Arc<dyn ObtenerArticulo>,
        pub listar_articulos: Arc<dyn ListarArticulos>,
        pub actualizar_articulo: Arc<dyn ActualizarArticulo>,
        pub borrar_articulo: Arc<dyn BorrarArticulo>,
    }

    pub fn construir() -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioArticulo> =
            Arc::new(RepositorioArticuloEnMemoria::new());
        CasosDeUso {
            crear_articulo: Arc::new(CrearArticuloImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_articulo: Arc::new(ObtenerArticuloImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_articulos: Arc::new(ListarArticulosImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_articulo: Arc::new(ActualizarArticuloImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_articulo: Arc::new(BorrarArticuloImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

