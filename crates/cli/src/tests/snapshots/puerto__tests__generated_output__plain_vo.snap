use std::sync::Arc;

use async_trait::async_trait;
use crate::domain::item::value_objects::Name;
use crate::domain::item::value_objects::Sku;
use crate::domain::item::value_objects::Weight;

use crate::domain::item::{
    errors::ItemError,
    model::Item,
    repository::ItemRepositoryTrait,
    use_cases::update_item::{UpdateItemParams, UpdateItemUseCaseTrait},
};

pub struct UpdateItemUseCaseImpl {
    pub repository: Arc<dyn ItemRepositoryTrait>,
}

#[async_trait]
impl UpdateItemUseCaseTrait for UpdateItemUseCaseImpl {
    async fn execute(&self, params: UpdateItemParams) -> Result<Item, ItemError> {
        tracing::info!(id = %params.id, "update_item: start");
        let mut entity = self
            .repository
            .find_by_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "update_item: repository failed"))?
            .ok_or_else(|| {
                let err = ItemError::NotFound;
                tracing::warn!(error = %err, "update_item: rejected");
                err
            })?;
let name = Name::new(params.name)?;
let sku = Sku::new(params.sku)?;
let weight = Weight::new(params.weight)?;
        entity.name = name;
        entity.sku = sku;
        entity.weight = weight;
        entity.updated_at = chrono::Utc::now();
        self.repository.save(&entity).await.inspect_err(|e| tracing::error!(error = %e, "update_item: repository failed"))?;
        Ok(entity)
    }
}

