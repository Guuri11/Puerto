import type { Page, PageRequest } from "../shared/page";
import type { Item, ItemDraft } from "./model";

/** The port the screens call. Every method rejects with the `ItemError` the API answered. */
export interface ItemRepository {
  list(page: PageRequest): Promise<Page<Item>>;
  get(id: string): Promise<Item>;
  create(draft: ItemDraft): Promise<Item>;
  update(id: string, draft: ItemDraft): Promise<Item>;
  remove(id: string): Promise<void>;
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

=== web/src/infrastructure/item/item-repository-http.test.ts ===
import { describe, expect, test } from "bun:test";
import { ItemError } from "../../domain/item/errors";
import { ItemMother } from "../../test-support/item";
import { createApiClient } from "../http/client";
import { itemRepositoryHttp } from "./item-repository-http";

/** A repository whose every request is answered with `status` and `body`. */
function answering(status: number, body?: unknown) {
  const requests: Request[] = [];
  const api = createApiClient({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return body === undefined ? new Response(null, { status }) : Response.json(body, { status });
    },
  });
  return { repository: itemRepositoryHttp(api), requests };
}

describe("itemRepositoryHttp", () => {
  test("should ask for the page and return its items", async () => {
    // Arrange
    const item = ItemMother.random();
    const page = { items: [item], total: 21, limit: 20, offset: 20 };
    const { repository, requests } = answering(200, page);

    // Act
    const listed = await repository.list({ limit: 20, offset: 20 });

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/items?limit=20&offset=20");
    expect(listed).toEqual(page);
  });

  test("should send the draft when creating an item", async () => {
    // Arrange
    const draft = ItemMother.draft();
    const { repository, requests } = answering(201, { id: crypto.randomUUID(), ...draft });

    // Act
    const created = await repository.create(draft);

    // Assert
    expect(requests[0]?.method).toBe("POST");
    expect(await requests[0]?.json()).toEqual(draft);
    expect(created).toMatchObject(draft);
  });

  test("should reject with the API's error code when the item does not exist", async () => {
    // Arrange
    const code = "item.not_found";
    const { repository } = answering(404, { name: code, message: code });

    // Act
    const result = repository.get(crypto.randomUUID());

    // Assert
    await expect(result).rejects.toBeInstanceOf(ItemError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should resolve when the API deletes the item", async () => {
    // Arrange
    const { repository, requests } = answering(204);

    // Act
    await repository.remove("42");

    // Assert
    expect(requests[0]?.url).toBe("http://localhost/api/items/42");
  });
});

=== web/src/infrastructure/item/item-repository-http.ts ===
import { ItemError } from "../../domain/item/errors";
import type { Item, ItemDraft } from "../../domain/item/model";
import type { ItemRepository } from "../../domain/item/repository";
import { type ApiClient, apiErrorCode } from "../http/client";
import type { components } from "../http/schema";

type ItemDto = components["schemas"]["ItemDto"];
type ItemRequest = components["schemas"]["CreateItemRequest"];

function toItem(dto: ItemDto): Item {
  return {
    id: dto.id,
    name: dto.name,
    sku: dto.sku,
    weight: dto.weight,
  };
}

function toRequest(draft: ItemDraft): ItemRequest {
  return {
    name: draft.name,
    sku: draft.sku,
    weight: draft.weight,
  };
}

/** `ItemRepository` over the REST API (`/items`). */
export function itemRepositoryHttp(api: ApiClient): ItemRepository {
  return {
    async list(page) {
      const { data, error, response } = await api.GET("/items", {
        params: { query: page },
      });
      if (data === undefined) throw new ItemError(apiErrorCode(error, response));
      return { ...data, items: data.items.map(toItem) };
    },
    async get(id) {
      const { data, error, response } = await api.GET("/items/{id}", {
        params: { path: { id } },
      });
      if (data === undefined) throw new ItemError(apiErrorCode(error, response));
      return toItem(data);
    },
    async create(draft) {
      const { data, error, response } = await api.POST("/items", { body: toRequest(draft) });
      if (data === undefined) throw new ItemError(apiErrorCode(error, response));
      return toItem(data);
    },
    async update(id, draft) {
      const { data, error, response } = await api.PUT("/items/{id}", {
        params: { path: { id } },
        body: toRequest(draft),
      });
      if (data === undefined) throw new ItemError(apiErrorCode(error, response));
      return toItem(data);
    },
    async remove(id) {
      const { error, response } = await api.DELETE("/items/{id}", {
        params: { path: { id } },
      });
      if (!response.ok) throw new ItemError(apiErrorCode(error, response));
    },
  };
}

