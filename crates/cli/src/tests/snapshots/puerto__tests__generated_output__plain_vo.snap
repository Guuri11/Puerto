import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { fakeItemRepository, ItemMother } from "../../../../test-support/item";
import { renderScreen } from "../../../../test-support/render";
import { ItemDetailContainer } from "./item-detail-container";

describe("ItemDetailContainer", () => {
  test("should show the item when it exists", async () => {
    // Arrange
    const seeded = ItemMother.random();
    const itemRepository = fakeItemRepository([seeded]);

    // Act
    renderScreen(<ItemDetailContainer id={seeded.id} />, { itemRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the item does not exist", async () => {
    // Arrange
    const itemRepository = fakeItemRepository();

    // Act
    renderScreen(<ItemDetailContainer id={crypto.randomUUID()} />, { itemRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("item.not_found");
  });

  test("should delete the item only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ItemMother.random();
    const fake = fakeItemRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<ItemDetailContainer id={seeded.id} />, {
      itemRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/items"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });
});

=== web/src/presentation/features/item/containers/item-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ItemDetailView } from "../views/item-detail-view";

export function ItemDetailContainer({ id }: { id: string }) {
  const { itemRepository } = useDependencies();
  const item = useAsync(() => itemRepository.get(id), [itemRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await itemRepository.remove(id);
      navigate("/items");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Item</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {item.status === "loading" && <span className="loading loading-spinner" />}
      {item.status === "error" && <ErrorAlert error={item.error} />}
      {item.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ItemDetailView item={item.data} />
            <div className="card-actions justify-end">
              <Link href={`/items/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/items" className="link">
        Back to items
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this item?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

