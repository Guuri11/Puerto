use async_trait::async_trait;
use dominio_articulo::errores::ErrorArticulo;
use dominio_articulo::modelo::IdArticulo;
use dominio_articulo::repositorio::RepositorioArticulo;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarArticulo {
    pub id: IdArticulo,
}

#[async_trait]
pub trait BorrarArticulo: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarArticulo) -> Result<(), ErrorArticulo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarArticulo {}

        #[async_trait]
        impl BorrarArticulo for BorrarArticulo {
            async fn ejecutar(&self, params: ParamsBorrarArticulo) -> Result<(), ErrorArticulo>;
        }
    }
}

pub struct BorrarArticuloImpl {
    pub repositorio: Arc<dyn RepositorioArticulo>,
}

#[async_trait]
impl BorrarArticulo for BorrarArticuloImpl {
    async fn ejecutar(&self, params: ParamsBorrarArticulo) -> Result<(), ErrorArticulo> {
        tracing::info!(id = %params.id, "borrar_articulo: inicio");
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "borrar_articulo: fallo del repositorio"))?
            .ok_or_else(|| {
                let err = ErrorArticulo::NoEncontrado;
                tracing::warn!(error = %err, "borrar_articulo: rechazado");
                err
            })?;
        let ahora = chrono::Utc::now();
        entidad.borrado = true;
        entidad.borrado_en = Some(ahora);
        entidad.actualizado_en = ahora;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "borrar_articulo: fallo del repositorio"),
        )?;
        Ok(())
    }
}

