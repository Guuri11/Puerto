    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_el_id_no_existe() {
        let mut repositorio_doble = MockRepositorioArticulo::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
