    pub name: String,
    pub sku: String,
    pub weight: i64,
}

impl DtoArticulo {
    pub fn from_dominio(entidad: &Articulo) -> Self {
        Self {
            id: entidad.id.valor(),
            name: entidad.name.valor().to_string(),
            sku: entidad.sku.valor().to_string(),
            weight: entidad.weight.valor(),
        }
