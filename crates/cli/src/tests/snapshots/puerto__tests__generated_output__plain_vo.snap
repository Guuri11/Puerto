use crate::modelo::Articulo;
use crate::modelo::PropsArticulo;
use crate::valores::Name;
use crate::valores::Sku;
use crate::valores::Weight;

pub struct MadreArticulo {
    name: Option<Name>,
    sku: Option<Sku>,
    weight: Option<Weight>,
}

impl MadreArticulo {
    pub fn new() -> Self {
        Self {
            name: None,
            sku: None,
            weight: None,
        }
    }

    pub fn con_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn con_sku(mut self, sku: Sku) -> Self {
        self.sku = Some(sku);
        self
    }

    pub fn con_weight(mut self, weight: Weight) -> Self {
        self.weight = Some(weight);
        self
    }

    pub fn construir(self) -> Articulo {
        Articulo::new(PropsArticulo {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            sku: self.sku.unwrap_or_else(|| {
                Sku::new("example".to_string()).expect("Sku::new rechazó el valor de ejemplo")
            }),
            weight: self.weight.unwrap_or_else(|| {
                Weight::new(42).expect("Weight::new rechazó el valor de ejemplo")
            }),
        })
        .expect("MadreArticulo: Articulo::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsArticulo {
        PropsArticulo {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            sku: self.sku.unwrap_or_else(|| {
                Sku::new("example".to_string()).expect("Sku::new rechazó el valor de ejemplo")
            }),
            weight: self.weight.unwrap_or_else(|| {
                Weight::new(42).expect("Weight::new rechazó el valor de ejemplo")
            }),
        }
    }

    pub fn aleatorio() -> Articulo {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Articulo> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreArticulo {
    fn default() -> Self {
        Self::new()
    }
}

