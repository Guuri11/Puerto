use crate::valores::Name;
use crate::valores::Sku;
use crate::valores::Weight;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorArticulo;

/// El id de cada `Articulo`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdArticulo(Uuid);

impl IdArticulo {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdArticulo {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsArticulo {
    pub name: Name,
    pub sku: Sku,
    pub weight: Weight,
}

#[derive(Debug, Clone)]
pub struct Articulo {
    pub id: IdArticulo,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: Name,
    pub sku: Sku,
    pub weight: Weight,
}

impl Articulo {
    pub fn new(props: PropsArticulo) -> Result<Self, ErrorArticulo> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdArticulo::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            name: props.name,
            sku: props.sku,
            weight: props.weight,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsArticulo) -> Result<(), ErrorArticulo> {
        Self::validar(&props)?;
        self.name = props.name;
        self.sku = props.sku;
        self.weight = props.weight;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Articulo) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(_props: &PropsArticulo) -> Result<(), ErrorArticulo> {
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreArticulo;

    #[test]
    fn deberia_crear_articulo_cuando_los_campos_son_validos() {
        let resultado = Articulo::new(MadreArticulo::new().construir_props());
        assert!(resultado.is_ok());
    }

    #[test]
    fn deberia_rechazar_articulo_cuando_name_es_una_cadena_vacia() {
        let resultado = Name::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "articulo.name_invalido");
    }

    #[test]
    fn deberia_rechazar_articulo_cuando_sku_es_una_cadena_vacia() {
        let resultado = Sku::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "articulo.sku_invalido");
    }
}

