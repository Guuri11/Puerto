=== web/src/features/articulo/views/articulo-form-view.tsx ===
import type { Schemas } from "../../../api/client";
import { FieldError } from "../../../shared/ui/field-error";
import type { ArticuloProblem } from "../messages";

type Articulo = Schemas["DtoArticulo"];
type ArticuloRequest = Schemas["PeticionCrearArticulo"];

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ArticuloFormValues {
  name: string;
  sku: string;
  weight: string;
}

/** The inputs for `articulo`, empty when there is none yet. */
export function toArticuloForm(articulo: Articulo | null): ArticuloFormValues {
  if (articulo === null) {
    return {
      name: "",
      sku: "",
      weight: "",
    };
  }
  return {
    name: articulo.name,
    sku: articulo.sku,
    weight: String(articulo.weight),
  };
}

/** What a create or an update sends: the same fields for both. */
export function toArticuloRequest(values: ArticuloFormValues): ArticuloRequest {
  return {
    name: values.name,
    sku: values.sku,
    weight: Number(values.weight),
  };
}

export function ArticuloFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: ArticuloFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: ArticuloProblem | null;
  onChange: (values: ArticuloFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "name"}
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "sku"}
          required
          value={values.sku}
          onChange={(event) => onChange({ ...values, sku: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="sku" />
      <label className="fieldset">
        <span className="fieldset-legend">Weight</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "weight"}
          required
          value={values.weight}
          onChange={(event) => onChange({ ...values, weight: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="weight" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

