import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { ArticuloMother, articuloCollection } from "../../../test-support/articulo";
import { fakeApi } from "../../../test-support/fake-api";
import { renderScreen } from "../../../test-support/render";
import { ArticuloListContainer } from "./articulo-list-container";

describe("ArticuloListContainer", () => {
  test("should show a row per articulo when there are some", async () => {
    // Arrange
    const seed = [ArticuloMother.random(), ArticuloMother.random()];
    const api = fakeApi([articuloCollection(seed)]);

    // Act
    renderScreen(<ArticuloListContainer />, { api });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ArticuloMother.random());
    const api = fakeApi([articuloCollection(seed)]);
    renderScreen(<ArticuloListContainer />, { api });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ArticuloMother.random());
    const api = fakeApi([articuloCollection(seed)]);
    const path = "/articulos?page=2";

    // Act
    renderScreen(<ArticuloListContainer />, { api }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no articulo", async () => {
    // Arrange
    const api = fakeApi([articuloCollection()]);

    // Act
    renderScreen(<ArticuloListContainer />, { api });

    // Assert
    expect(await screen.findByText("No articulos yet.")).toBeTruthy();
  });

  test("should show the error code when the articulos cannot be listed", async () => {
    // Arrange
    const failures = { "GET /articulos": "articulo.repositorio" };
    const api = fakeApi([articuloCollection()], failures);

    // Act
    renderScreen(<ArticuloListContainer />, { api });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("articulo.repositorio");
  });
});

=== web/src/features/articulo/containers/articulo-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE, unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { useAsync } from "../../../shared/use-async";
import { ArticuloListView } from "../views/articulo-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function ArticuloListContainer() {
  const { api } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const query = { limite: PAGE_SIZE, desplazamiento: offset };
  const articulos = useAsync(
    () => unwrap(api.GET("/articulos", { params: { query } })),
    [api, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Articulos</h1>
        <Link href="/articulos/new" className="btn btn-primary">
          New articulo
        </Link>
      </div>
      {articulos.status === "loading" && <span className="loading loading-spinner" />}
      {articulos.status === "error" && <ErrorAlert error={articulos.error} />}
      {articulos.status === "ok" &&
        (articulos.data.total === 0 ? (
          <EmptyState message="No articulos yet." />
        ) : (
          <>
            <ArticuloListView articulos={articulos.data.elementos} />
            <Pagination
              total={articulos.data.total}
              limit={articulos.data.limite}
              offset={articulos.data.desplazamiento}
              onOffsetChange={goTo}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/features/articulo/messages.ts ===
/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface ArticuloProblem {
  field: string | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errores.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "articulo.name_invalido": "Name is not valid",
  "articulo.sku_invalido": "Sku is not valid",
  "articulo.weight_invalido": "Weight is not valid",
  "articulo.duplicado": "An articulo with these values already exists",
  "articulo.no_encontrado": "This articulo no longer exists",
  "articulo.repositorio": "The articulo could not be saved, try again later",
  "articulo.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, string> = {
  "articulo.name_invalido": "name",
  "articulo.sku_invalido": "sku",
  "articulo.weight_invalido": "weight",
};

export function toProblem(code: string): ArticuloProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

