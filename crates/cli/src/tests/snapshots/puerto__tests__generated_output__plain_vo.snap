=== web/src/presentation/features/item/views/item-form-view.tsx ===
import type { Item, ItemDraft } from "../../../../domain/item/model";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ItemFormValues {
  name: string;
  sku: string;
  weight: string;
}

/** The inputs for `item`, empty when there is none yet. */
export function toItemForm(item: Item | null): ItemFormValues {
  if (item === null) {
    return {
      name: "",
      sku: "",
      weight: "",
    };
  }
  return {
    name: item.name,
    sku: item.sku,
    weight: String(item.weight),
  };
}

export function toItemDraft(values: ItemFormValues): ItemDraft {
  return {
    name: values.name,
    sku: values.sku,
    weight: Number(values.weight),
  };
}

export function ItemFormView({
  values,
  saving,
  onChange,
  onSubmit,
}: {
  values: ItemFormValues;
  saving: boolean;
  onChange: (values: ItemFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          required
          value={values.sku}
          onChange={(event) => onChange({ ...values, sku: event.target.value })}
        />
      </label>
      <label className="fieldset">
        <span className="fieldset-legend">Weight</span>
        <input
          className="input w-full"
          type="number"
          required
          value={values.weight}
          onChange={(event) => onChange({ ...values, weight: event.target.value })}
        />
      </label>
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

