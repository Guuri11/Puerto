=== business/src/domain/item/value_objects.rs ===
use super::errors::ItemError;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    value: String,
}

impl Name {
    pub fn new(value: String) -> Result<Self, ItemError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(ItemError::InvalidName);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    value: String,
}

impl Sku {
    pub fn new(value: String) -> Result<Self, ItemError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(ItemError::InvalidSku);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Weight(i64);

impl Weight {
    pub fn new(value: i64) -> Result<Self, ItemError> {
        Ok(Self(value))
    }

    pub fn value(&self) -> i64 {
        self.0
    }
}

