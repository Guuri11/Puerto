=== presentation/src/api/item/routes.rs ===
use std::sync::Arc;

use business::domain::shared::pagination::PageRequest;
use business::domain::item::model::ItemId;
use business::domain::item::use_cases::{
    create_item::{CreateItemParams, CreateItemUseCaseTrait},
    delete_item::{DeleteItemParams, DeleteItemUseCaseTrait},
    get_item::{GetItemParams, GetItemUseCaseTrait},
    list_items::{ListItemsParams, ListItemsUseCaseTrait},
    update_item::{UpdateItemParams, UpdateItemUseCaseTrait},
};
use poem_openapi::{
    OpenApi,
    param::{Path, Query},
    payload::Json,
};
use uuid::Uuid;

use crate::api::error::IntoErrorResponse;
use crate::api::tags::ApiTags;
use crate::api::item::dto::{
    CreateItemRequest, UpdateItemRequest, ItemDto, ItemPageDto,
};
use crate::api::item::responses::{
    CreateItemResponse, DeleteItemResponse, GetItemResponse, ListItemsResponse,
    UpdateItemResponse,
};

/// Holds the use case ports; `generated/bootstrap.rs` plugs in the implementations.
pub struct ItemApi {
    pub create_item: Arc<dyn CreateItemUseCaseTrait>,
    pub get_item: Arc<dyn GetItemUseCaseTrait>,
    pub list_items: Arc<dyn ListItemsUseCaseTrait>,
    pub update_item: Arc<dyn UpdateItemUseCaseTrait>,
    pub delete_item: Arc<dyn DeleteItemUseCaseTrait>,
}

#[OpenApi]
impl ItemApi {
    /// Create a new Item
    #[oai(path = "/items", method = "post", tag = "ApiTags::Item")]
    async fn create(&self, body: Json<CreateItemRequest>) -> CreateItemResponse {
        match self
            .create_item
            .execute(CreateItemParams {
                name: body.name.clone(),
                sku: body.sku.clone(),
                weight: body.weight,
            })
            .await
        {
            Ok(entity) => CreateItemResponse::Created(Json(ItemDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "create_item failed");
                CreateItemResponse::from_status(status, error)
            }
        }
    }

    /// Get a Item by ID
    #[oai(path = "/items/:id", method = "get", tag = "ApiTags::Item")]
    async fn get_by_id(&self, id: Path<Uuid>) -> GetItemResponse {
        match self
            .get_item
            .execute(GetItemParams { id: ItemId::from_uuid(id.0) })
            .await
        {
            Ok(entity) => GetItemResponse::Ok(Json(ItemDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "get_item failed");
                GetItemResponse::from_status(status, error)
            }
        }
    }

    /// List Items, one page at a time (`limit` is capped by the domain)
    #[oai(path = "/items", method = "get", tag = "ApiTags::Item")]
    async fn list(&self, limit: Query<Option<u32>>, offset: Query<Option<u32>>) -> ListItemsResponse {
        match self
            .list_items
            .execute(ListItemsParams {
                page: PageRequest::new(limit.0, offset.0),
            })
            .await
        {
            Ok(page) => ListItemsResponse::Ok(Json(ItemPageDto::from_domain(&page))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::error!(code = %error.0.name, "list_items failed");
                ListItemsResponse::from_status(status, error)
            }
        }
    }

    /// Update a Item
    #[oai(path = "/items/:id", method = "put", tag = "ApiTags::Item")]
    async fn update(&self, id: Path<Uuid>, body: Json<UpdateItemRequest>) -> UpdateItemResponse {
        match self
            .update_item
            .execute(UpdateItemParams {
                id: ItemId::from_uuid(id.0),
                name: body.name.clone(),
                sku: body.sku.clone(),
                weight: body.weight,
            })
            .await
        {
            Ok(entity) => UpdateItemResponse::Ok(Json(ItemDto::from_domain(&entity))),
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "update_item failed");
                UpdateItemResponse::from_status(status, error)
            }
        }
    }

    /// Delete a Item
    #[oai(path = "/items/:id", method = "delete", tag = "ApiTags::Item")]
    async fn delete(&self, id: Path<Uuid>) -> DeleteItemResponse {
        match self
            .delete_item
            .execute(DeleteItemParams { id: ItemId::from_uuid(id.0) })
            .await
        {
            Ok(()) => DeleteItemResponse::NoContent,
            Err(err) => {
                let (status, error) = err.into_error_response();
                tracing::warn!(code = %error.0.name, "delete_item failed");
                DeleteItemResponse::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use business::domain::shared::pagination::Page;
    use business::domain::item::errors::ItemError;
    use business::domain::item::use_cases::{
        create_item::mocks::MockCreateItemUseCase, delete_item::mocks::MockDeleteItemUseCase,
        get_item::mocks::MockGetItemUseCase, list_items::mocks::MockListItemsUseCase,
        update_item::mocks::MockUpdateItemUseCase,
    };
    use business::tests::mothers::item_mother::ItemMother;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};

    use super::*;

    /// One mock per use case. A test sets expectations only on the one its route should call: a
    /// route that reaches for another use case panics instead of passing.
    #[derive(Default)]
    struct Mocks {
        create: MockCreateItemUseCase,
        get: MockGetItemUseCase,
        list: MockListItemsUseCase,
        update: MockUpdateItemUseCase,
        delete: MockDeleteItemUseCase,
    }

    impl Mocks {
        fn client(self) -> TestClient<Route> {
            let api = ItemApi {
                create_item: Arc::new(self.create),
                get_item: Arc::new(self.get),
                list_items: Arc::new(self.list),
                update_item: Arc::new(self.update),
                delete_item: Arc::new(self.delete),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn create_request() -> CreateItemRequest {
        CreateItemRequest {
            name: "example".to_string(),
            sku: "example".to_string(),
            weight: 42,
        }
    }

    fn update_request() -> UpdateItemRequest {
        UpdateItemRequest {
            name: "example".to_string(),
            sku: "example".to_string(),
            weight: 42,
        }
    }

    fn item_path() -> String {
        format!("/items/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn should_respond_201_when_item_is_created() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.create.expect_execute().returning(|_| Ok(ItemMother::random()));

        // Act
        let response = mocks
            .client()
            .post("/items")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn should_respond_422_when_item_is_invalid() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .create
            .expect_execute()
            .returning(|_| Err(ItemError::ValidationError("invalid".to_string())));

        // Act
        let response = mocks
            .client()
            .post("/items")
            .body_json(&create_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn should_respond_200_when_item_is_found() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Ok(ItemMother::random()));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_item_does_not_exist() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.get.expect_execute().returning(|_| Err(ItemError::NotFound));

        // Act
        let response = mocks.client().get(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_200_with_a_page_of_items_when_listing() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .returning(|params| Ok(Page::new(ItemMother::random_vec(2), 7, params.page)));

        // Act
        let response = mocks.client().get("/items").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
        let json = response.json().await;
        let body = json.value().object();
        body.get("items").array().assert_len(2);
        body.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn should_pass_limit_and_offset_to_the_use_case() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks
            .list
            .expect_execute()
            .withf(|params| params.page == PageRequest::new(Some(5), Some(10)))
            .returning(|params| Ok(Page::new(vec![], 0, params.page)));

        // Act
        let response = mocks.client().get("/items?limit=5&offset=10").send().await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_500_when_listing_fails_in_the_repository() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.list.expect_execute().returning(|_| Err(ItemError::RepositoryError));

        // Act
        let response = mocks.client().get("/items").send().await;

        // Assert
        response.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn should_respond_200_when_item_is_updated() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Ok(ItemMother::random()));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn should_respond_404_when_updating_a_missing_item() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.update.expect_execute().returning(|_| Err(ItemError::NotFound));

        // Act
        let response = mocks
            .client()
            .put(item_path())
            .body_json(&update_request().to_json())
            .send()
            .await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn should_respond_204_when_item_is_deleted() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Ok(()));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn should_respond_404_when_deleting_a_missing_item() {
        // Arrange
        let mut mocks = Mocks::default();
        mocks.delete.expect_execute().returning(|_| Err(ItemError::NotFound));

        // Act
        let response = mocks.client().delete(item_path()).send().await;

        // Assert
        response.assert_status(StatusCode::NOT_FOUND);
    }
}

