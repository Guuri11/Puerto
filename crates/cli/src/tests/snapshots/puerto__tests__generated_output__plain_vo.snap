use async_trait::async_trait;
use dominio_articulo::errores::ErrorArticulo;
use dominio_articulo::modelo::{Articulo, IdArticulo};
use dominio_articulo::repositorio::RepositorioArticulo;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsObtenerArticulo {
    pub id: IdArticulo,
}

#[async_trait]
pub trait ObtenerArticulo: Send + Sync {
    async fn ejecutar(&self, params: ParamsObtenerArticulo) -> Result<Articulo, ErrorArticulo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ObtenerArticulo {}

        #[async_trait]
        impl ObtenerArticulo for ObtenerArticulo {
            async fn ejecutar(&self, params: ParamsObtenerArticulo) -> Result<Articulo, ErrorArticulo>;
        }
    }
}

pub struct ObtenerArticuloImpl {
    pub repositorio: Arc<dyn RepositorioArticulo>,
}

#[async_trait]
impl ObtenerArticulo for ObtenerArticuloImpl {
    async fn ejecutar(&self, params: ParamsObtenerArticulo) -> Result<Articulo, ErrorArticulo> {
        tracing::info!(id = %params.id, "obtener_articulo: inicio");
        let resultado = self
            .repositorio
            .buscar_por_id(params.id)
            .await
            .inspect_err(
                |e| tracing::error!(error = %e, "obtener_articulo: fallo del repositorio"),
            )?;
        resultado.ok_or_else(|| {
            let err = ErrorArticulo::NoEncontrado;
            tracing::warn!(error = %err, "obtener_articulo: rechazado");
            err
        })
    }
}

#[cfg(test)]
mod tests {
