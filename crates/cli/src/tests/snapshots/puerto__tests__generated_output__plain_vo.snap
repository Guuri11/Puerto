mod tests {
    use super::*;
    use crate::domain::item::{
        model::{Item, ItemProps},
        repository::mocks::MockItemRepository,
    };
    use uuid::Uuid;
    use crate::domain::item::value_objects::Name;
    use crate::domain::item::value_objects::Sku;
    use crate::domain::item::value_objects::Weight;


    #[tokio::test]
    async fn should_update_item_when_params_are_valid() {
        // Arrange
        let entity = Item::new(ItemProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: Sku::new("original".to_string()).expect("valid Sku"),
            weight: Weight::new(42).expect("valid Weight"),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockItemRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateItemUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateItemParams {
            id: entity_id,
            name: "updated".to_string(),
            sku: "updated".to_string(),
            weight: 42,
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().name.value(), "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_item_does_not_exist() {
        // Arrange
        let mut mock_repo = MockItemRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateItemUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateItemParams {
            id: Uuid::new_v4(),
            name: "new".to_string(),
            sku: "new".to_string(),
            weight: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "item.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let entity = Item::new(ItemProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: Sku::new("original".to_string()).expect("valid Sku"),
            weight: Weight::new(42).expect("valid Weight"),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockItemRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateItemUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateItemParams {
            id: entity_id,
            name: "".to_string(),
            sku: "updated".to_string(),
            weight: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "item.invalid_name"
        );
    }

    #[tokio::test]
    async fn should_return_error_when_sku_is_empty() {
        // Arrange
        let entity = Item::new(ItemProps {
            name: Name::new("original".to_string()).expect("valid Name"),
            sku: Sku::new("original".to_string()).expect("valid Sku"),
            weight: Weight::new(42).expect("valid Weight"),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockItemRepository::new();
        mock_repo
            .expect_find_by_id()
