use crate::errores::ErrorArticulo;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorArticulo> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorArticulo::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    valor: String,
}

impl Sku {
    pub fn new(valor: String) -> Result<Self, ErrorArticulo> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorArticulo::SkuInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Weight(i64);

impl Weight {
    pub fn new(valor: i64) -> Result<Self, ErrorArticulo> {
        Ok(Self(valor))
    }

    pub fn valor(&self) -> i64 {
        self.0
    }
}

