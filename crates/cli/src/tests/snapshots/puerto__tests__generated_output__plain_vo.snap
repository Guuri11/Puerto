use crate::domain::item::model::Item;
use crate::domain::item::model::ItemProps;
use crate::domain::item::value_objects::Name;
use crate::domain::item::value_objects::Sku;
use crate::domain::item::value_objects::Weight;

pub struct ItemMother {
    name: Option<Name>,
    sku: Option<Sku>,
    weight: Option<Weight>,
}

impl ItemMother {
    pub fn new() -> Self {
        Self {
            name: None,
            sku: None,
            weight: None,
        }
    }

    pub fn with_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn with_sku(mut self, sku: Sku) -> Self {
        self.sku = Some(sku);
        self
    }

    pub fn with_weight(mut self, weight: Weight) -> Self {
        self.weight = Some(weight);
        self
    }

    pub fn build(self) -> Item {
        Item::new(ItemProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
            weight: self
                .weight
                .unwrap_or_else(|| Weight::new(42).expect("valid Weight")),
        })
        .expect("ItemMother: failed to build valid Item")
    }

    pub fn build_props(self) -> ItemProps {
        ItemProps {
            name: self
                .name
                .unwrap_or_else(|| Name::new("example".to_string()).expect("valid Name")),
            sku: self
                .sku
                .unwrap_or_else(|| Sku::new("example".to_string()).expect("valid Sku")),
            weight: self
                .weight
                .unwrap_or_else(|| Weight::new(42).expect("valid Weight")),
        }
    }

    pub fn random() -> Item {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Item> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for ItemMother {
    fn default() -> Self {
        Self::new()
    }
}

=== infrastructure/src/item/repository.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use business::domain::item::{
    model::{Item, ItemId},
    repository::ItemRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// Keeps the items it is given in process memory: they are lost when the process stops.
/// Like the Postgres adapter, it hides deleted rows and lists newest first;
/// a unique value another live row holds is `Duplicate`.
/// It stands in until there is a database (`puerto new --db` generates Postgres repositories).
#[derive(Default)]
pub struct InMemoryItemRepository {
    rows: RwLock<HashMap<ItemId, Item>>,
}

impl InMemoryItemRepository {
    pub fn new() -> Self {
        Self::default()
    }

    // A poisoned lock means a writer panicked; every write is a single insert, so the map is
    // still whole and is used as it is.
    fn read(&self) -> RwLockReadGuard<'_, HashMap<ItemId, Item>> {
        self.rows.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn write(&self) -> RwLockWriteGuard<'_, HashMap<ItemId, Item>> {
        self.rows.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl ItemRepositoryTrait for InMemoryItemRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Item>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        let rows = self.read();
        let mut live: Vec<&Item> = rows.values().filter(|row| !row.deleted).collect();
        live.sort_by(|a, b| {
            b.created_at
                .cmp(&a.created_at)
                .then_with(|| a.id.value().cmp(&b.id.value()))
        });
        let total = live.len() as u64;
        let items = live
            .into_iter()
            .skip(page.offset() as usize)
            .take(page.limit() as usize)
            .cloned()
            .collect();
        Ok(Page::new(items, total, page))
    }

    async fn find_by_id(&self, id: ItemId) -> Result<Option<Item>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(self.read().get(&id).filter(|row| !row.deleted).cloned())
    }

    async fn save(&self, entity: &Item) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        let mut rows = self.write();
        // Like the partial unique indexes: only live rows hold their values.
        let taken = !entity.deleted
            && rows
                .values()
                .any(|row| row.id != entity.id && !row.deleted && row.sku == entity.sku);
        if taken {
            tracing::warn!(id = %entity.id, "save rejected: a unique value is taken");
            return Err(RepositoryError::Duplicate);
        }
        rows.insert(entity.id, entity.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use business::domain::item::model::ItemProps;
    use business::domain::item::value_objects::Name;
