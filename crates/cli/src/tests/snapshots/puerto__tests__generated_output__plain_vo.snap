// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;
use business::application::item::create_item::CreateItemUseCaseImpl;
use business::application::item::get_item::GetItemUseCaseImpl;
use business::application::item::list_items::ListItemsUseCaseImpl;
use business::application::item::update_item::UpdateItemUseCaseImpl;
use business::application::item::delete_item::DeleteItemUseCaseImpl;

use business::domain::greeting::repository::GreetingRepositoryTrait;
use infrastructure::greeting::repository::InMemoryGreetingRepository;
use business::domain::item::repository::ItemRepositoryTrait;
use infrastructure::item::repository::InMemoryItemRepository;

use poem::{EndpointExt, Route, get, middleware::{Cors, Tracing}};
use poem_openapi::OpenApiService;

use crate::api::greeting::routes::GreetingApi;
use crate::api::item::routes::ItemApi;

pub async fn build_app() -> impl poem::Endpoint {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl { repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait> });
    let greeting_api = GreetingApi { get_greeting };

    let item_repo: Arc<dyn ItemRepositoryTrait> = Arc::new(InMemoryItemRepository::new());
    let create_item = Arc::new(CreateItemUseCaseImpl { repository: Arc::clone(&item_repo) });
    let get_item = Arc::new(GetItemUseCaseImpl { repository: Arc::clone(&item_repo) });
    let list_items = Arc::new(ListItemsUseCaseImpl { repository: Arc::clone(&item_repo) });
    let update_item = Arc::new(UpdateItemUseCaseImpl { repository: Arc::clone(&item_repo) });
    let delete_item = Arc::new(DeleteItemUseCaseImpl { repository: item_repo });
    let item_api = ItemApi { create_item, get_item, list_items, update_item, delete_item };

    let port = std::env::var("SERVICE_PORT").unwrap_or_else(|_| "8080".to_string());
    let api_service =
        openapi_service((greeting_api, item_api)).server(format!("http://localhost:{port}/api"));
    let ui = api_service.swagger_ui();

    let cors_origins = std::env::var("CORS_ALLOWED_ORIGINS").unwrap_or_default();
    let mut cors = Cors::new();
    for origin in cors_origins.split(',').map(str::trim).filter(|s| !s.is_empty()) {
        cors = cors.allow_origin(origin);
    }

    Route::new()
        .at("/health", get(crate::health::liveness))
        .at(
            "/health/ready",
            get(poem::endpoint::make_sync(|_| crate::health::readiness(true))),
        )
        .nest("/api", api_service)
        .nest("/", ui)
        .with(Tracing)
        .with(cors)
}

/// The API service, built in one place: whatever else reads its spec (the export test of a project
/// with `web/`) sees the API the server answers.
fn openapi_service<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

#[cfg(test)]
mod tests {
    use super::*;

    use business::domain::greeting::use_cases::get_greeting::mocks::MockGetGreetingUseCase;
    use business::domain::item::use_cases::create_item::mocks::MockCreateItemUseCase;
    use business::domain::item::use_cases::get_item::mocks::MockGetItemUseCase;
    use business::domain::item::use_cases::list_items::mocks::MockListItemsUseCase;
    use business::domain::item::use_cases::update_item::mocks::MockUpdateItemUseCase;
    use business::domain::item::use_cases::delete_item::mocks::MockDeleteItemUseCase;

    /// The API contract the frontend's types are generated from (`make web/sync`).
    const OPENAPI_JSON: &str = concat!(env!("CARGO_MANIFEST_DIR"), "/../docs/api/openapi.json");

    /// Built from mocked use cases: no server, no database. A missing file is written; a different
    /// one fails — run `make web/sync` (it sets `UPDATE_OPENAPI=1`) and commit the diff.
    #[test]
    fn openapi_spec_matches_docs_api_openapi_json() {
        let greeting_api = GreetingApi { get_greeting: Arc::new(MockGetGreetingUseCase::new()) };
        let item_api = ItemApi { create_item: Arc::new(MockCreateItemUseCase::new()), get_item: Arc::new(MockGetItemUseCase::new()), list_items: Arc::new(MockListItemsUseCase::new()), update_item: Arc::new(MockUpdateItemUseCase::new()), delete_item: Arc::new(MockDeleteItemUseCase::new()) };
        let spec = openapi_service((greeting_api, item_api)).spec();

        let path = std::path::Path::new(OPENAPI_JSON);
        if std::env::var_os("UPDATE_OPENAPI").is_some() || !path.exists() {
            let dir = path.parent().expect("docs/api/openapi.json has a parent");
            std::fs::create_dir_all(dir).expect("create docs/api");
            std::fs::write(path, &spec).expect("write docs/api/openapi.json");
            return;
        }
        let committed = std::fs::read_to_string(path).expect("read docs/api/openapi.json");
        assert!(
            committed == spec,
            "docs/api/openapi.json is not the API this code serves: run `make web/sync`"
        );
    }
}

