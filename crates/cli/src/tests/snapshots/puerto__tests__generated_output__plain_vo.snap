// AUTO-GENERATED by puerto. Edit puerto.toml, then run `puerto generate bootstrap`.
use std::sync::Arc;

use business::application::greeting::get_greeting::GetGreetingUseCaseImpl;
use business::application::item::create_item::CreateItemUseCaseImpl;
use business::application::item::get_item::GetItemUseCaseImpl;
use business::application::item::list_item::ListItemUseCaseImpl;
use business::application::item::update_item::UpdateItemUseCaseImpl;
use business::application::item::delete_item::DeleteItemUseCaseImpl;

use business::domain::greeting::repository::GreetingRepositoryTrait;
use infrastructure::greeting::repository::InMemoryGreetingRepository;
use business::domain::item::repository::ItemRepositoryTrait;
use infrastructure::item::repository::InMemoryItemRepository;

use poem::{EndpointExt, Route, get, middleware::{Cors, Tracing}};
use poem_openapi::OpenApiService;

use crate::api::greeting::routes::GreetingApi;
use crate::api::item::routes::ItemApi;

pub async fn build_app() -> impl poem::Endpoint {
    let get_greeting = Arc::new(GetGreetingUseCaseImpl { repository: Arc::new(InMemoryGreetingRepository::new()) as Arc<dyn GreetingRepositoryTrait> });
    let greeting_api = GreetingApi { get_greeting };

    let item_repo: Arc<dyn ItemRepositoryTrait> = Arc::new(InMemoryItemRepository::new());
    let create_item = Arc::new(CreateItemUseCaseImpl { repository: Arc::clone(&item_repo) });
    let get_item = Arc::new(GetItemUseCaseImpl { repository: Arc::clone(&item_repo) });
    let list_item = Arc::new(ListItemUseCaseImpl { repository: Arc::clone(&item_repo) });
    let update_item = Arc::new(UpdateItemUseCaseImpl { repository: Arc::clone(&item_repo) });
    let delete_item = Arc::new(DeleteItemUseCaseImpl { repository: item_repo });
    let item_api = ItemApi { create_item, get_item, list_item, update_item, delete_item };

    let port = std::env::var("SERVICE_PORT").unwrap_or_else(|_| "8080".to_string());
    let api_service = OpenApiService::new(
        (greeting_api, item_api),
        env!("CARGO_PKG_NAME"),
        env!("CARGO_PKG_VERSION"),
    )
    .server(format!("http://localhost:{port}/api"));
    let ui = api_service.swagger_ui();

    let cors_origins = std::env::var("CORS_ALLOWED_ORIGINS").unwrap_or_default();
    let mut cors = Cors::new();
    for origin in cors_origins.split(',').map(str::trim).filter(|s| !s.is_empty()) {
        cors = cors.allow_origin(origin);
    }

    Route::new()
        .at("/health", get(crate::health::liveness))
        .at(
            "/health/ready",
            get(poem::endpoint::make_sync(|_| crate::health::readiness(true))),
        )
        .nest("/api", api_service)
        .nest("/", ui)
        .with(Tracing)
        .with(cors)
}

