use async_trait::async_trait;
use dominio_articulo::errores::ErrorArticulo;
use dominio_articulo::modelo::{Articulo, PropsArticulo};
use dominio_articulo::repositorio::RepositorioArticulo;
use dominio_articulo::valores::{Name, Sku, Weight};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearArticulo {
    pub name: String,
    pub sku: String,
    pub weight: i64,
}

#[async_trait]
pub trait CrearArticulo: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearArticulo) -> Result<Articulo, ErrorArticulo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearArticulo {}

        #[async_trait]
        impl CrearArticulo for CrearArticulo {
            async fn ejecutar(&self, params: ParamsCrearArticulo) -> Result<Articulo, ErrorArticulo>;
        }
    }
}

pub struct CrearArticuloImpl {
    pub repositorio: Arc<dyn RepositorioArticulo>,
}

#[async_trait]
impl CrearArticulo for CrearArticuloImpl {
    async fn ejecutar(&self, params: ParamsCrearArticulo) -> Result<Articulo, ErrorArticulo> {
        tracing::info!("crear_articulo: inicio");
        let name = Name::new(params.name)?;
        let sku = Sku::new(params.sku)?;
        let weight = Weight::new(params.weight)?;
        let entidad = Articulo::new(PropsArticulo { name, sku, weight })
            .inspect_err(|e| tracing::warn!(error = %e, "crear_articulo: rechazado"))?;
        self.repositorio.guardar(&entidad).await.inspect_err(
            |e| tracing::error!(error = %e, "crear_articulo: fallo del repositorio"),
        )?;
        tracing::info!(id = %entidad.id, "crear_articulo: fin");
        Ok(entidad)
    }
}

