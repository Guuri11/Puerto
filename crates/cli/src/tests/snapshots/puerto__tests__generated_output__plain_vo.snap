use async_trait::async_trait;
use dominio_articulo::errores::ErrorArticulo;
use dominio_articulo::modelo::Articulo;
use dominio_articulo::repositorio::RepositorioArticulo;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarArticulos {
    pub pagina: PeticionPagina,
}

#[async_trait]
pub trait ListarArticulos: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsListarArticulos,
    ) -> Result<Pagina<Articulo>, ErrorArticulo>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarArticulos {}

        #[async_trait]
        impl ListarArticulos for ListarArticulos {
            async fn ejecutar(&self, params: ParamsListarArticulos) -> Result<Pagina<Articulo>, ErrorArticulo>;
        }
    }
}

pub struct ListarArticulosImpl {
    pub repositorio: Arc<dyn RepositorioArticulo>,
}

#[async_trait]
impl ListarArticulos for ListarArticulosImpl {
    async fn ejecutar(
        &self,
        params: ParamsListarArticulos,
    ) -> Result<Pagina<Articulo>, ErrorArticulo> {
        tracing::info!(
            limite = params.pagina.limite(),
            desplazamiento = params.pagina.desplazamiento(),
            "listar_articulos: inicio"
        );
        self.repositorio
            .buscar_todos(params.pagina)
            .await
            .inspect_err(|e| tracing::error!(error = %e, "listar_articulos: fallo del repositorio"))
            .map_err(ErrorArticulo::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_articulo::{
        pruebas::madres::MadreArticulo, repositorio::dobles::MockRepositorioArticulo,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_articulos() {
        let entidades = MadreArticulo::aleatorios(2);
        let mut repositorio_doble = MockRepositorioArticulo::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarArticulosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarArticulos {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_articulos() {
        let mut repositorio_doble = MockRepositorioArticulo::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarArticulosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarArticulos {
                pagina: PeticionPagina::default(),
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioArticulo::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarArticulosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarArticulos {
                pagina: PeticionPagina::new(Some(5), Some(10)),
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }
}

