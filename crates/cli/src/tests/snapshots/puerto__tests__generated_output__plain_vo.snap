use super::value_objects::Name;
use super::value_objects::Sku;
use super::value_objects::Weight;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::ItemError;

/// The id of every `Item`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct ItemId(Uuid);

impl ItemId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for ItemId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct ItemProps {
    pub name: Name,
    pub sku: Sku,
    pub weight: Weight,
}

#[derive(Debug, Clone)]
pub struct Item {
    pub id: ItemId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: Name,
    pub sku: Sku,
    pub weight: Weight,
}

impl Item {
    pub fn new(props: ItemProps) -> Result<Self, ItemError> {
        let now = chrono::Utc::now();
        Ok(Self {
            id: ItemId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
            sku: props.sku,
            weight: props.weight,
        })
    }

    pub fn from_repository(data: Item) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_item_when_fields_are_valid() {
        let result = Item::new(ItemProps {
            name: Name::new("example".to_string()).expect("valid Name"),
            sku: Sku::new("example".to_string()).expect("valid Sku"),
            weight: Weight::new(42).expect("valid Weight"),
        });
        assert!(result.is_ok());
    }

    #[test]
    fn should_reject_item_when_name_is_empty() {
        let result = Name::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "item.invalid_name");
    }

    #[test]
    fn should_reject_item_when_sku_is_empty() {
        let result = Sku::new("".to_string());
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "item.invalid_sku");
    }
}

