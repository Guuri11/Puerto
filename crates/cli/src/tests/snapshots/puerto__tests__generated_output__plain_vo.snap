=== presentation/src/api/item/error_mapper.rs ===
use business::domain::item::errors::ItemError;
use poem::http::StatusCode;
use poem_openapi::payload::Json;

use crate::api::error::{ErrorResponse, IntoErrorResponse};

impl IntoErrorResponse for ItemError {
    /// Exhaustive on purpose: a new error variant does not compile until it has a status.
    fn into_error_response(self) -> (StatusCode, Json<ErrorResponse>) {
        let status = match &self {
            ItemError::ValidationError(_) => StatusCode::UNPROCESSABLE_ENTITY,
            ItemError::NotFound => StatusCode::NOT_FOUND,
            ItemError::Duplicate => StatusCode::CONFLICT,
            ItemError::RepositoryError => StatusCode::INTERNAL_SERVER_ERROR,
            ItemError::Unknown => StatusCode::INTERNAL_SERVER_ERROR,
            ItemError::InvalidName => StatusCode::UNPROCESSABLE_ENTITY,
            ItemError::InvalidSku => StatusCode::UNPROCESSABLE_ENTITY,
            ItemError::InvalidWeight => StatusCode::UNPROCESSABLE_ENTITY,
        };
        (status, Json(ErrorResponse::from_code(self.to_string())))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_map_validation_error_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::ValidationError("name_empty".into()).into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "item.validation_error.name_empty");
    }

    #[test]
    fn should_map_not_found_to_404_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::NotFound.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::NOT_FOUND);
        assert_eq!(body.name, "item.not_found");
    }

    #[test]
    fn should_map_duplicate_to_409_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::Duplicate.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::CONFLICT);
        assert_eq!(body.name, "item.duplicate");
    }

    #[test]
    fn should_map_repository_error_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::RepositoryError.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "item.repository_error");
    }

    #[test]
    fn should_map_unknown_to_500_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::Unknown.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::INTERNAL_SERVER_ERROR);
        assert_eq!(body.name, "item.unknown");
    }

    #[test]
    fn should_map_invalid_name_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::InvalidName.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "item.invalid_name");
    }

    #[test]
    fn should_map_invalid_sku_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::InvalidSku.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "item.invalid_sku");
    }

    #[test]
    fn should_map_invalid_weight_to_422_with_its_code() {
        // Act
        let (status, Json(body)) = ItemError::InvalidWeight.into_error_response();

        // Assert
        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
        assert_eq!(body.name, "item.invalid_weight");
    }
}

