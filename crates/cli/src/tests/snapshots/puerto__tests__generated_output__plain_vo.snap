[package]
name = "dominio_articulo"
version = "0.1.0"
edition = "2024"

[dependencies]
puerto-nucleo = { workspace = true }
async-trait = { workspace = true }
thiserror = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles (`mock!`) y la madre de objetos, para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall"]

[dev-dependencies]
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/articulo/dominio/src/errores.rs ===
use puerto_nucleo::ErrorRepositorio;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum ErrorArticulo {
    #[error("articulo.validacion.{0}")]
    Validacion(String),
    #[error("articulo.no_encontrado")]
    NoEncontrado,
    #[error("articulo.duplicado")]
    Duplicado,
    #[error("articulo.repositorio")]
    Repositorio,
    #[error("articulo.desconocido")]
    Desconocido,
    #[error("articulo.name_invalido")]
    NameInvalido,
    #[error("articulo.sku_invalido")]
    SkuInvalido,
    #[error("articulo.weight_invalido")]
    WeightInvalido,
}

impl From<ErrorRepositorio> for ErrorArticulo {
    /// Cada fallo que nombra `puerto-nucleo` tiene su brazo. `ErrorRepositorio` es
    /// `#[non_exhaustive]`: uno que añada una versión posterior es un problema del almacén (500)
    /// hasta que tenga aquí un significado.
    fn from(err: ErrorRepositorio) -> Self {
        match err {
            ErrorRepositorio::Duplicado => Self::Duplicado,
            ErrorRepositorio::DatosInvalidos | ErrorRepositorio::NoDisponible => Self::Repositorio,
            _ => Self::Repositorio,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn deberia_convertir_un_duplicado_en_el_duplicado_de_la_entidad() {
        let err = ErrorArticulo::from(ErrorRepositorio::Duplicado);
        assert_eq!(err.to_string(), "articulo.duplicado");
    }

    #[test]
    fn deberia_convertir_datos_invalidos_en_un_error_de_repositorio() {
        let err = ErrorArticulo::from(ErrorRepositorio::DatosInvalidos);
        assert_eq!(err.to_string(), "articulo.repositorio");
    }

    #[test]
    fn deberia_convertir_un_almacen_no_disponible_en_un_error_de_repositorio() {
        let err = ErrorArticulo::from(ErrorRepositorio::NoDisponible);
        assert_eq!(err.to_string(), "articulo.repositorio");
    }
}

