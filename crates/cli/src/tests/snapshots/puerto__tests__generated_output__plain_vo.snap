import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { ItemError } from "../../../../domain/item/errors";
import { fakeItemRepository, ItemMother } from "../../../../test-support/item";
import { renderScreen } from "../../../../test-support/render";
import { ItemListContainer } from "./item-list-container";

describe("ItemListContainer", () => {
  test("should show a row per item when there are some", async () => {
    // Arrange
    const seed = [ItemMother.random(), ItemMother.random()];
    const itemRepository = fakeItemRepository(seed);

    // Act
    renderScreen(<ItemListContainer />, { itemRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ItemMother.random());
    const itemRepository = fakeItemRepository(seed);
    renderScreen(<ItemListContainer />, { itemRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ItemMother.random());
    const itemRepository = fakeItemRepository(seed);
    const path = "/items?page=2";

    // Act
    renderScreen(<ItemListContainer />, { itemRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no item", async () => {
    // Arrange
    const itemRepository = fakeItemRepository();

    // Act
    renderScreen(<ItemListContainer />, { itemRepository });

    // Assert
    expect(await screen.findByText("No items yet.")).toBeTruthy();
  });

  test("should show the error code when the items cannot be listed", async () => {
    // Arrange
    const itemRepository = {
      ...fakeItemRepository(),
      list: () => Promise.reject(new ItemError("item.repository_error")),
    };

    // Act
    renderScreen(<ItemListContainer />, { itemRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("item.repository_error");
  });
});

=== web/src/presentation/features/item/containers/item-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { ItemListView } from "../views/item-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function ItemListContainer() {
  const { itemRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const items = useAsync(
    () => itemRepository.list({ limit: PAGE_SIZE, offset }),
    [itemRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Items</h1>
        <Link href="/items/new" className="btn btn-primary">
          New item
        </Link>
      </div>
      {items.status === "loading" && <span className="loading loading-spinner" />}
      {items.status === "error" && <ErrorAlert error={items.error} />}
      {items.status === "ok" &&
        (items.data.total === 0 ? (
          <EmptyState message="No items yet." />
        ) : (
          <>
            <ItemListView items={items.data.items} />
            <Pagination {...items.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

