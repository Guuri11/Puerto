import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ArticuloMother, articuloCollection } from "../../../test-support/articulo";
import { fakeApi } from "../../../test-support/fake-api";
import { renderScreen } from "../../../test-support/render";
import { ArticuloDetailContainer } from "./articulo-detail-container";

describe("ArticuloDetailContainer", () => {
  test("should show the articulo when it exists", async () => {
    // Arrange
    const seeded = ArticuloMother.random();
    const api = fakeApi([articuloCollection([seeded])]);

    // Act
    renderScreen(<ArticuloDetailContainer id={seeded.id} />, { api });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the articulo does not exist", async () => {
    // Arrange
    const api = fakeApi([articuloCollection()]);

    // Act
    renderScreen(<ArticuloDetailContainer id={crypto.randomUUID()} />, { api });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("articulo.no_encontrado");
  });

  test("should delete the articulo only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ArticuloMother.random();
    const stored = articuloCollection([seeded]);
    const api = fakeApi([stored]);
    const { history } = renderScreen(<ArticuloDetailContainer id={seeded.id} />, { api });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(stored.items.has(seeded.id)).toBe(true);

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/articulos"));
    expect(stored.items.has(seeded.id)).toBe(false);
  });
});

=== web/src/features/articulo/containers/articulo-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { ArticuloDetailView } from "../views/articulo-detail-view";

export function ArticuloDetailContainer({ id }: { id: string }) {
  const { api } = useDependencies();
  const articulo = useAsync(
    () => unwrap(api.GET("/articulos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await unwrap(api.DELETE("/articulos/{id}", { params: { path: { id } } }));
      navigate("/articulos");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Articulo</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {articulo.status === "loading" && <span className="loading loading-spinner" />}
      {articulo.status === "error" && <ErrorAlert error={articulo.error} />}
      {articulo.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ArticuloDetailView articulo={articulo.data} />
            <div className="card-actions justify-end">
              <Link href={`/articulos/${id}/edit`} className="btn">
                Edit
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/articulos" className="link">
        Back to articulos
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this articulo?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/features/articulo/containers/articulo-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Schemas } from "../../../api/client";
import { ArticuloMother, articuloCollection } from "../../../test-support/articulo";
import { fakeApi } from "../../../test-support/fake-api";
import { renderScreen } from "../../../test-support/render";
import { ArticuloFormContainer } from "./articulo-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `request`, the way a user would. */
async function fillIn(request: Schemas["PeticionCrearArticulo"]) {
  await screen.findByText("Save");
  type("Name", request.name);
  type("Sku", request.sku);
  type("Weight", String(request.weight));
}

describe("ArticuloFormContainer", () => {
  test("should create the articulo from what was typed and show it", async () => {
    // Arrange
    const request = ArticuloMother.request();
    const stored = articuloCollection();
    const api = fakeApi([stored]);
    const { history } = renderScreen(<ArticuloFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/articulos/"));
    const [created] = stored.items.values();
    expect(created).toMatchObject(request);
    expect(history.at(-1)).toBe(`/articulos/${created?.id}`);
  });

  test("should save the edited articulo when an existing one is submitted", async () => {
    // Arrange
    const seeded = ArticuloMother.random();
    const stored = articuloCollection([seeded]);
    const api = fakeApi([stored]);
    const { history } = renderScreen(<ArticuloFormContainer id={seeded.id} />, { api });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/articulos/${seeded.id}`));
    expect(stored.items.get(seeded.id)).toEqual(seeded);
  });
  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const request = ArticuloMother.request();
    const code = "articulo.validacion.invalid";
    const failures = { "POST /articulos": code };
    const api = fakeApi([articuloCollection()], failures);
    renderScreen(<ArticuloFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a articulo with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const request = ArticuloMother.request();
    const failures = { "POST /articulos": "articulo.duplicado" };
    const api = fakeApi([articuloCollection()], failures);
    renderScreen(<ArticuloFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "An articulo with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const request = ArticuloMother.request();
    const failures = { "POST /articulos": "articulo.name_invalido" };
    const api = fakeApi([articuloCollection()], failures);
    renderScreen(<ArticuloFormContainer />, { api });
    await fillIn(request);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Name is not valid")).toBeTruthy();
    const input = screen.getByLabelText("Name");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/features/articulo/containers/articulo-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Schemas } from "../../../api/client";
import { unwrap } from "../../../api/http";
import { useDependencies } from "../../../dependencies";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { useAsync } from "../../../shared/use-async";
import { toProblem } from "../messages";
import { ArticuloFormView, toArticuloForm, toArticuloRequest } from "../views/articulo-form-view";

type Articulo = Schemas["DtoArticulo"];

/** Creates an articulo, or edits the one with `id`. */
export function ArticuloFormContainer({ id }: { id?: string }) {
  const { api } = useDependencies();
  const existing = useAsync(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : unwrap(api.GET("/articulos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const title = id === undefined ? "New articulo" : "Edit articulo";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ArticuloForm existing={existing.data} />}
      <Link href={id === undefined ? "/articulos" : `/articulos/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ArticuloForm({ existing }: { existing: Articulo | null }) {
  const { api } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toArticuloForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const body = toArticuloRequest(values);
      const saved = await unwrap(
        existing === null
          ? api.POST("/articulos", { body })
          : api.PUT("/articulos/{id}", { params: { path: { id: existing.id } }, body }),
      );
      navigate(`/articulos/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <ArticuloFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

