use async_trait::async_trait;
use uuid::Uuid;

use super::{errors::ItemError, model::Item};

#[async_trait]
pub trait ItemRepositoryTrait: Send + Sync {
    async fn find_all(&self) -> Result<Vec<Item>, ItemError>;
    async fn find_by_id(&self, id: Uuid) -> Result<Option<Item>, ItemError>;
    async fn save(&self, entity: &Item) -> Result<(), ItemError>;
}

#[cfg(any(test, feature = "test-utils"))]
pub mod mocks {
    use mockall::mock;
    use uuid::Uuid;

    use super::*;

    mock! {
        pub ItemRepository {}

        #[async_trait]
        impl ItemRepositoryTrait for ItemRepository {
            async fn find_all(&self) -> Result<Vec<Item>, ItemError>;
            async fn find_by_id(&self, id: Uuid) -> Result<Option<Item>, ItemError>;
            async fn save(&self, entity: &Item) -> Result<(), ItemError>;
        }
    }
}

