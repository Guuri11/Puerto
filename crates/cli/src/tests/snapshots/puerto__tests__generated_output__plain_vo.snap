use std::sync::Arc;

use async_trait::async_trait;

use crate::domain::item::{
    errors::ItemError,
    model::Item,
    repository::ItemRepositoryTrait,
    use_cases::list_item::{ListItemParams, ListItemUseCaseTrait},
};

pub struct ListItemUseCaseImpl {
    pub repository: Arc<dyn ItemRepositoryTrait>,
}

#[async_trait]
impl ListItemUseCaseTrait for ListItemUseCaseImpl {
    async fn execute(&self, _params: ListItemParams) -> Result<Vec<Item>, ItemError> {
        tracing::info!("list_item: start");
        self.repository.find_all().await.inspect_err(|e| tracing::error!(error = %e, "list_item: repository failed"))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::domain::item::{
        model::{Item, ItemProps},
        repository::mocks::MockItemRepository,
    };
    use crate::domain::item::value_objects::Name;
    use crate::domain::item::value_objects::Sku;
    use crate::domain::item::value_objects::Weight;


    #[tokio::test]
    async fn should_return_all_items() {
        let entities = vec![
            Item::new(ItemProps {
            name: Name::new("first".to_string()).expect("valid Name"),
            sku: Sku::new("first".to_string()).expect("valid Sku"),
            weight: Weight::new(42).expect("valid Weight"),
        }).unwrap(),
            Item::new(ItemProps {
            name: Name::new("second".to_string()).expect("valid Name"),
            sku: Sku::new("second".to_string()).expect("valid Sku"),
            weight: Weight::new(42).expect("valid Weight"),
        }).unwrap(),
        ];
        let mut mock_repo = MockItemRepository::new();
        mock_repo
            .expect_find_all()
            .returning(move || Ok(entities.clone()));
        let use_case = ListItemUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListItemParams).await;

        assert!(result.is_ok());
        assert_eq!(result.unwrap().len(), 2);
    }

    #[tokio::test]
    async fn should_return_empty_list_when_no_items_exist() {
        let mut mock_repo = MockItemRepository::new();
        mock_repo.expect_find_all().returning(|| Ok(vec![]));
        let use_case = ListItemUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        let result = use_case.execute(ListItemParams).await;

        assert!(result.is_ok());
        assert!(result.unwrap().is_empty());
    }
}

