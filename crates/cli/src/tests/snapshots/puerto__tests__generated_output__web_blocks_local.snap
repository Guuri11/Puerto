=== contextos/pedido/rest/src/pagar_pedido.rs ===
// La variante de éxito lleva el DTO entero (ver `respuestas.rs`).
#![allow(clippy::large_enum_variant)]

use std::sync::Arc;

use aplicacion_pedido::pagar_pedido::{PagarPedido, ParamsPagarPedido};
use dominio_pedido::modelo::IdPedido;
use poem::http::StatusCode;
use poem_openapi::{ApiResponse, OpenApi, Tags, param::Path, payload::Json};
use puerto_web::RespuestaError;
use puerto_web::auth::BearerAuth;
use uuid::Uuid;

use crate::dto::DtoPedido;
use crate::errores::a_respuesta_error;

/// La misma etiqueta que `rutas.rs`: poem-openapi junta las dos por su nombre.
#[derive(Tags)]
enum ApiTags {
    Pedido,
}

/// La ruta de la transición `pagar` (`puerto generar transicion`). Va en su propio `Api` para
/// que `rutas.rs` no cambie; `generado/bootstrap.rs` la monta junto a `ApiPedido`.
pub struct ApiPagarPedido {
    pub pagar_pedido: Arc<dyn PagarPedido>,
}

#[OpenApi]
impl ApiPagarPedido {
    /// Pagar: Pedido
    #[oai(path = "/pedidos/:id/pagar", method = "post", tag = "ApiTags::Pedido")]
    async fn pagar(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaPagarPedido {
        match self
            .pagar_pedido
            .ejecutar(ParamsPagarPedido {
                actor: auth.0,
                id: IdPedido::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaPagarPedido::Ok(Json(DtoPedido::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "pagar_pedido falló");
                RespuestaPagarPedido::from_status(status, error)
            }
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaPagarPedido {
    #[oai(status = 200)]
    Ok(Json<DtoPedido>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaPagarPedido {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_pedido::pagar_pedido::dobles::MockPagarPedido;
    use dominio_pedido::errores::ErrorPedido;
    use dominio_pedido::pruebas::madres::MadrePedido;
    use poem::{EndpointExt, Route, test::TestClient};
    use poem_openapi::OpenApiService;
    use puerto_nucleo::auth::dobles::{MadrePrincipal, MockAutenticador};
    use puerto_nucleo::auth::{Autenticador, ErrorAuth};

    use super::*;

    /// Acepta `llamante` y `nadie` (sin roles).
    fn autenticador() -> Arc<dyn Autenticador> {
        let mut doble = MockAutenticador::new();
        doble.expect_autenticar().returning(|token| match token {
            "llamante" => Ok(MadrePrincipal::aleatorio()),
            "nadie" => Ok(MadrePrincipal::aleatorio()),
            _ => Err(ErrorAuth::Invalido),
        });
        Arc::new(doble)
    }

    /// La ruta sobre `caso_de_uso`; `autorizacion`, la cabecera de cada petición (`None`: ninguna).
    fn cliente(
        caso_de_uso: MockPagarPedido,
        autorizacion: Option<&str>,
    ) -> TestClient<impl poem::Endpoint> {
        let api = ApiPagarPedido {
            pagar_pedido: Arc::new(caso_de_uso),
        };
        let cliente = TestClient::new(
            Route::new()
                .nest("/", OpenApiService::new(api, "test", "1.0"))
                .data(autenticador()),
        );
        match autorizacion {
            Some(valor) => cliente.default_header("Authorization", valor),
            None => cliente,
        }
    }

    fn ruta() -> String {
        format!("/pedidos/{}/pagar", Uuid::new_v4())
    }

    /// El caso de uso, respondiendo `resultado`.
    fn caso_de_uso(resultado: Result<(), ErrorPedido>) -> MockPagarPedido {
        let mut doble = MockPagarPedido::new();
        doble
            .expect_ejecutar()
            .return_once(move |_| resultado.map(|()| MadrePedido::aleatorio()));
        doble
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_puede_pagar_pedido() {
        // Preparar
        let cliente = cliente(caso_de_uso(Ok(())), Some("Bearer llamante"));

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status_is_ok();
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_pedido_no_existe() {
        // Preparar
        let cliente = cliente(
            caso_de_uso(Err(ErrorPedido::NoEncontrado)),
            Some("Bearer llamante"),
        );

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_pedido_no_se_puede_pagar() {
        // Preparar
        let rechazo = ErrorPedido::Validacion("no_se_puede_pagar".into());
        let cliente = cliente(caso_de_uso(Err(rechazo)), Some("Bearer llamante"));

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("pedido.validacion.no_se_puede_pagar");
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_pide_pagar_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let cliente = cliente(MockPagarPedido::new(), None);

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }
}

