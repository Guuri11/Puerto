import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";

type Producto = Esquemas["DtoProducto"];

/** Lo que se lee de cada variante de `status`. */
const TEXTOS_STATUS: Record<string, string> = {
  Draft: "Draft",
  Live: "Live",
};

export function VistaListaProducto({ productos }: { productos: Producto[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Sku</th>
            <th>Price</th>
            <th>Status</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {productos.map((producto) => (
            <tr key={producto.id}>
              <td>{producto.name}</td>
              <td>{producto.sku}</td>
              <td>{producto.price}</td>
              <td>{TEXTOS_STATUS[producto.status] ?? producto.status}</td>
              <td className="text-right">
                <Link href={`/productos/${producto.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/generado/dependencias.ts ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//
// La raíz de composición: el único módulo que construye el cliente de la API. Las pantallas llegan
// a él con `useDependencias()`, así un test les da un falso.

import { type ClienteApi, crearClienteApi } from "../api/cliente";
import type { Cuentas } from "../auth/cuentas";
import { middlewareBearer } from "../auth/middleware-bearer";
import { pasarelaLocal } from "../auth/pasarela-local";
import type { PasarelaAuth } from "../auth/sesion";

export interface Dependencias {
  api: ClienteApi;
  auth: PasarelaAuth;
  cuentas: Cuentas;
}

export function crearDependencias(): Dependencias {
  const auth = pasarelaLocal();
  const api = crearClienteApi();
  api.use(middlewareBearer(auth));
  return { api, auth, cuentas: auth };
}

