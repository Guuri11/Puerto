            .object()
            .get("codigo")
            .assert_string("auth.prohibido");
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_actualiza_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_borra_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .delete(ruta_elemento())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_403_cuando_se_borra_sin_el_rol() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(Some("Bearer nadie"))
            .delete(ruta_elemento())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::FORBIDDEN);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("auth.prohibido");
    }
}

