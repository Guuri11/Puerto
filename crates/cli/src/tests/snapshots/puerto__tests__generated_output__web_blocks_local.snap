          {PLANES.map((plan) => (
            <li
              key={plan.nombre}
              className={`card bg-base-100 ${plan.destacado ? "border-2 border-primary shadow-xl" : "border border-base-300"}`}
            >
              <div className="card-body gap-4">
                <div className="flex items-center justify-between">
                  <h3 className="card-title">{plan.nombre}</h3>
                  {plan.destacado && <span className="badge badge-primary">Más elegido</span>}
