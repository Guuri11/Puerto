import { describe, expect, test } from "bun:test";
import createClient from "openapi-fetch";
import { MadreUsuarioActual, pasarelaAuthFalsa } from "../pruebas/auth";
import { middlewareBearer } from "./middleware-bearer";

/** Basta con una ruta: el middleware no mira la ruta. */
interface paths {
  "/me": { get: { responses: { 200: { content: { "application/json": unknown } } } } };
}

/** Un cliente que responde `estado` a todas sus peticiones, firmado por `auth`. */
function respondiendo(estado: number, auth: ReturnType<typeof pasarelaAuthFalsa>) {
  const peticiones: Request[] = [];
  const api = createClient<paths>({
    baseUrl: "http://localhost/api",
    fetch: async (peticion) => {
      peticiones.push(peticion);
      return Response.json({}, { status: estado });
    },
  });
  api.use(middlewareBearer(auth));
  return { api, peticiones };
}

describe("middlewareBearer", () => {
  test("debería mandar el token de quien tiene la sesión iniciada", async () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio();
    const { api, peticiones } = respondiendo(200, pasarelaAuthFalsa({ usuario }));

    // Actuar
    await api.GET("/me");

    // Comprobar
    expect(peticiones[0]?.headers.get("Authorization")).toBe(`Bearer token-de-${usuario.id}`);
  });

  test("no debería mandar ningún token cuando no hay sesión", async () => {
    // Preparar
    const { api, peticiones } = respondiendo(200, pasarelaAuthFalsa());

    // Actuar
    await api.GET("/me");

    // Comprobar
    expect(peticiones[0]?.headers.has("Authorization")).toBe(false);
  });

  test("debería volver a iniciar sesión cuando la API responde 401", async () => {
    // Preparar
    const auth = pasarelaAuthFalsa({ usuario: MadreUsuarioActual.aleatorio() });
    const { api } = respondiendo(401, auth);

    // Actuar
    await api.GET("/me");

    // Comprobar
    expect(auth.logins).toHaveLength(1);
  });
});

=== web/src/auth/middleware-bearer.ts ===
import type { Middleware } from "openapi-fetch";
import type { PasarelaAuth } from "./sesion";

/**
 * Firma cada llamada a la API con el token de quien tiene la sesión; un `401` quiere decir que la
 * sesión ya no vale, así que vuelve a iniciarla y regresa a la página en la que estaba.
 */
export function middlewareBearer(auth: PasarelaAuth): Middleware {
  return {
    async onRequest({ request }) {
      const token = await auth.tokenAcceso();
      if (token !== null) request.headers.set("Authorization", `Bearer ${token}`);
      return request;
    },
    async onResponse({ response }) {
      if (response.status === 401) {
        void auth.login(window.location.pathname + window.location.search);
      }
      return response;
    },
  };
}

=== web/src/auth/pasarela-local.test.ts ===
import { describe, expect, test } from "bun:test";
import { CLAVE_TOKEN, pasarelaLocal } from "./pasarela-local";
import { ErrorAuth } from "./sesion";

/** Un `Storage` propio para cada test. */
function almacenEnMemoria(semilla: Record<string, string> = {}): Storage {
  const elementos = new Map(Object.entries(semilla));
  return {
    get length() {
      return elementos.size;
    },
    clear: () => elementos.clear(),
    getItem: (clave) => elementos.get(clave) ?? null,
    key: (indice) => [...elementos.keys()][indice] ?? null,
    removeItem: (clave) => {
      elementos.delete(clave);
    },
    setItem: (clave, valor) => {
      elementos.set(clave, valor);
    },
  };
}

/** Una API que responde cada ruta con su `[estado, cuerpo]`; `peticiones` guarda lo que se le pidió. */
function api(respuestas: Record<string, [number, unknown]>) {
  const peticiones: { url: string; init: RequestInit }[] = [];
  const fetch = async (url: string, init: RequestInit) => {
    peticiones.push({ url, init });
    const [estado, cuerpo] = respuestas[url] ?? [404, null];
    return cuerpo === null
      ? new Response(null, { status: estado })
      : Response.json(cuerpo, { status: estado });
  };
  return { fetch, peticiones };
}

const ANA = { id: crypto.randomUUID(), email: "ana@example.com", nombre: "Ana", roles: ["admin"] };

describe("pasarelaLocal", () => {
  test("debería guardar el token y cargar el usuario al iniciar sesión", async () => {
    // Preparar
    const almacen = almacenEnMemoria();
    const { fetch, peticiones } = api({
      "/api/auth/login": [200, { token: "opaco", expiraEn: "2030-01-01T00:00:00Z" }],
      "/api/me": [200, ANA],
    });
    const pasarela = pasarelaLocal({ almacen, fetch });

    // Actuar
    await pasarela.iniciarSesion("ana@example.com", "caballo correcto bateria");
    const usuario = await pasarela.usuarioActual();

    // Comprobar
    expect(almacen.getItem(CLAVE_TOKEN)).toBe("opaco");
    expect(await pasarela.tokenAcceso()).toBe("opaco");
    expect(usuario).toEqual(ANA);
    expect(peticiones[1]?.init.headers).toEqual({ Authorization: "Bearer opaco" });
  });

  test("debería rechazar con el código de la API cuando la contraseña está mal", async () => {
    // Preparar
    const codigo = "auth.credenciales_invalidas";
    const almacen = almacenEnMemoria();
    const { fetch } = api({ "/api/auth/login": [401, { codigo, mensaje: codigo }] });

    // Actuar
    const resultado = pasarelaLocal({ almacen, fetch }).iniciarSesion("ana@example.com", "¡mal!");

    // Comprobar
    await expect(resultado).rejects.toBeInstanceOf(ErrorAuth);
    await expect(resultado).rejects.toMatchObject({ codigo });
    expect(almacen.getItem(CLAVE_TOKEN)).toBeNull();
  });

  test("debería olvidar una sesión que la API ya no acepta", async () => {
    // Preparar
    const almacen = almacenEnMemoria({ [CLAVE_TOKEN]: "caducado" });
    const { fetch } = api({ "/api/me": [401, { codigo: "auth.no_autenticado" }] });

    // Actuar
    const usuario = await pasarelaLocal({ almacen, fetch }).usuarioActual();

    // Comprobar
    expect(usuario).toBeNull();
    expect(almacen.getItem(CLAVE_TOKEN)).toBeNull();
  });

  test("debería tirar la sesión e ir al login, y después volver, cuando se rechaza una llamada", async () => {
    // Preparar: lo que hace el middleware bearer con un 401.
    const almacen = almacenEnMemoria({ [CLAVE_TOKEN]: "revocado" });
    const visitadas: string[] = [];
    const pasarela = pasarelaLocal({
      almacen,
      fetch: api({}).fetch,
      irA: (url) => visitadas.push(url),
    });

    // Actuar
    await pasarela.login("/pedidos?pagina=2");

    // Comprobar
    expect(almacen.getItem(CLAVE_TOKEN)).toBeNull();
    expect(visitadas).toEqual(["/login?siguiente=%2Fpedidos%3Fpagina%3D2"]);
  });

  test("debería revocar la sesión y después olvidarla al cerrarla", async () => {
    // Preparar
    const almacen = almacenEnMemoria({ [CLAVE_TOKEN]: "opaco" });
    const { fetch, peticiones } = api({ "/api/auth/logout": [204, null] });

    // Actuar
    await pasarelaLocal({ almacen, fetch }).logout();

    // Comprobar
    expect(peticiones[0]?.url).toBe("/api/auth/logout");
    expect(peticiones[0]?.init.headers).toEqual({ Authorization: "Bearer opaco" });
    expect(almacen.getItem(CLAVE_TOKEN)).toBeNull();
  });

  test("debería cerrar la sesión aquí aunque no se llegue a la API", async () => {
    // Preparar
    const almacen = almacenEnMemoria({ [CLAVE_TOKEN]: "opaco" });
    const fetch = () => Promise.reject(new TypeError("Failed to fetch"));

    // Actuar
    await pasarelaLocal({ almacen, fetch }).logout();

    // Comprobar
    expect(almacen.getItem(CLAVE_TOKEN)).toBeNull();
  });

  test("debería mandar el registro y responder la cuenta nueva", async () => {
    // Preparar
    const { fetch, peticiones } = api({ "/api/auth/registro": [201, { ...ANA, roles: [] }] });
    const registro = {
      email: "ana@example.com",
      contrasena: "caballo correcto bateria",
      nombre: "Ana",
    };

    // Actuar
    const usuario = await pasarelaLocal({ almacen: almacenEnMemoria(), fetch }).registrar(registro);

    // Comprobar
    expect(JSON.parse(String(peticiones[0]?.init.body))).toEqual({
      email: "ana@example.com",
      contrasena: "caballo correcto bateria",
      nombre: "Ana",
    });
    expect(usuario.email).toBe("ana@example.com");
  });
});

=== web/src/auth/pasarela-local.ts ===
import type { Cuentas, Registro } from "./cuentas";
import { ErrorAuth, type PasarelaAuth, type UsuarioActual } from "./sesion";

/**
 * Dónde se guarda el token de sesión: en `localStorage`, para que recargar mantenga la sesión — no
 * hay sesión del proveedor en la que apoyarse. Un token que se filtra se revoca en el servidor
 * (`POST /auth/logout`).
 */
export const CLAVE_TOKEN = "auth.token";

export interface OpcionesAuthLocal {
  almacen?: Storage;
  fetch?: (url: string, init: RequestInit) => Promise<Response>;
  /** Sale a otra página de la app: la de login, en `login`. */
  irA?: (url: string) => void;
}

/** `GET /me` como lo responde la API (`DtoMe`). */
interface CuerpoMe {
  id: string;
  email?: string | null;
  nombre?: string | null;
  roles: string[];
}

function aUsuarioActual(me: CuerpoMe): UsuarioActual {
  return { id: me.id, email: me.email ?? null, nombre: me.nombre ?? null, roles: me.roles };
}

/** El `RespuestaError.codigo` de una llamada que falló, o `http.<estado>` si la respuesta no es uno. */
async function codigoDeError(respuesta: Response): Promise<string> {
  const cuerpo: unknown = await respuesta.json().catch(() => null);
  if (typeof cuerpo === "object" && cuerpo !== null && "codigo" in cuerpo) {
    const { codigo } = cuerpo;
    if (typeof codigo === "string") return codigo;
  }
  return `http.${respuesta.status}`;
}

const CUERPO_JSON = { "Content-Type": "application/json" };

/** `PasarelaAuth` y `Cuentas` sobre el `/auth/*` de la propia API (`--auth local`). */
export function pasarelaLocal({
  almacen = window.localStorage,
  fetch: enviar = (url, init) => fetch(url, init),
  irA = (url) => window.location.assign(url),
}: OpcionesAuthLocal = {}): PasarelaAuth & Cuentas {
  const token = () => almacen.getItem(CLAVE_TOKEN);
  const bearer = (valor: string) => ({ Authorization: `Bearer ${valor}` });

  return {
    tokenAcceso: async () => token(),

    async usuarioActual() {
      const actual = token();
      if (actual === null) return null;
      const respuesta = await enviar("/api/me", { headers: bearer(actual) });
      // Una sesión caducada o revocada: sin sesión, no un error.
      if (respuesta.status === 401) {
        almacen.removeItem(CLAVE_TOKEN);
        return null;
      }
      if (!respuesta.ok) throw new ErrorAuth(await codigoDeError(respuesta));
      return aUsuarioActual((await respuesta.json()) as CuerpoMe);
    },

    /** La sesión ya no está, o nunca estuvo: se tira lo que quede de ella y se pide la contraseña. */
    async login(volverA) {
      almacen.removeItem(CLAVE_TOKEN);
      irA(`/login?siguiente=${encodeURIComponent(volverA)}`);
    },

    completarLogin: async () => "/",

    async logout() {
      const actual = token();
      if (actual !== null) {
        // Aquí se cierra la sesión diga lo que diga la API: una que no pudo revocar caduca.
        await enviar("/api/auth/logout", { method: "POST", headers: bearer(actual) }).catch(
          () => undefined,
        );
      }
      almacen.removeItem(CLAVE_TOKEN);
    },

    async registrar(registro: Registro) {
      const respuesta = await enviar("/api/auth/registro", {
        method: "POST",
        headers: CUERPO_JSON,
        // `PeticionRegistro`: los nombres de los campos en la API.
        body: JSON.stringify({
          email: registro.email,
          contrasena: registro.contrasena,
          nombre: registro.nombre,
        }),
      });
      if (!respuesta.ok) throw new ErrorAuth(await codigoDeError(respuesta));
      return aUsuarioActual((await respuesta.json()) as CuerpoMe);
    },

    async iniciarSesion(email, contrasena) {
      const respuesta = await enviar("/api/auth/login", {
        method: "POST",
        headers: CUERPO_JSON,
        body: JSON.stringify({ email, contrasena }),
      });
      if (!respuesta.ok) throw new ErrorAuth(await codigoDeError(respuesta));
      const sesion = (await respuesta.json()) as { token: string };
      almacen.setItem(CLAVE_TOKEN, sesion.token);
    },
  };
}

=== web/src/auth/sesion.ts ===
/** Quien tiene la sesión iniciada, tal como lo resolvió la API (`GET /me`): nunca los claims del proveedor. */
export interface UsuarioActual {
  id: string;
  email: string | null;
  nombre: string | null;
  /** Lo que la API comprueba con `#[requiere_rol]`. */
  roles: string[];
}

/**
 * Quién tiene la sesión iniciada, y cómo iniciarla y cerrarla. La pasarela habla con el proveedor
 * (OIDC) o con la API (local); las pantallas llegan a ella con `useAuth()`.
 */
export interface PasarelaAuth {
  /** Quien tiene la sesión iniciada, o `null` si no la tiene nadie. */
  usuarioActual(): Promise<UsuarioActual | null>;
  /** El token bearer para la API, o `null` si no hay sesión. */
  tokenAcceso(): Promise<string | null>;
  /** Inicia sesión y después vuelve a `volverA` (una ruta de esta app). */
  login(volverA: string): Promise<void>;
  /** Termina un inicio de sesión en `/auth/callback`; responde la ruta que se le dio a `login`. */
  completarLogin(): Promise<string>;
  logout(): Promise<void>;
}

/** Un inicio de sesión que rechazó el proveedor o la API, o un `GET /me` que falló. */
export class ErrorAuth extends Error {
  readonly codigo: string;

  constructor(codigo: string) {
    super(codigo);
    this.name = "ErrorAuth";
    this.codigo = codigo;
  }
}

