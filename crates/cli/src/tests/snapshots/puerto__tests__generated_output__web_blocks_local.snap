use crate::valores::Name;
use crate::valores::Status;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorProducto;

/// El id de cada `Producto`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdProducto(Uuid);

impl IdProducto {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdProducto {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsProducto {
    pub name: Name,
    pub sku: String,
    pub price: i64,
    pub status: Status,
}

#[derive(Debug, Clone)]
pub struct Producto {
    pub id: IdProducto,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: Name,
    pub sku: String,
    pub price: i64,
    pub status: Status,
}

impl Producto {
    pub fn new(props: PropsProducto) -> Result<Self, ErrorProducto> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdProducto::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            name: props.name,
            sku: props.sku,
            price: props.price,
            status: props.status,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsProducto) -> Result<(), ErrorProducto> {
        Self::validar(&props)?;
        self.name = props.name;
        self.sku = props.sku;
        self.price = props.price;
        self.status = props.status;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Producto) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsProducto) -> Result<(), ErrorProducto> {
        if props.sku.trim().is_empty() {
            return Err(ErrorProducto::Validacion("sku_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreProducto;

    #[test]
    fn deberia_crear_producto_cuando_los_campos_son_validos() {
        let resultado = Producto::new(MadreProducto::new().construir_props());
        assert_eq!(
            resultado.unwrap().sku,
            MadreProducto::new().construir_props().sku
        );
    }

    #[test]
    fn deberia_rechazar_producto_cuando_sku_es_una_cadena_vacia() {
        let resultado = Producto::new(MadreProducto::new().con_sku_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.sku_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_producto_cuando_sku_solo_tiene_espacios() {
        let resultado = Producto::new(MadreProducto::new().con_sku("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_producto_cuando_sku_es_una_cadena_vacia() {
        let mut entidad = MadreProducto::aleatorio();
        let resultado = entidad.actualizar(MadreProducto::new().con_sku_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.sku_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_producto_cuando_name_es_una_cadena_vacia() {
        let resultado = Name::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.name_invalido");
    }

    #[test]
    fn deberia_rechazar_producto_cuando_status_no_es_una_variante_conocida() {
        let resultado = "VarianteInvalida".parse::<Status>();
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.status_invalido"
        );
    }

    #[test]
    fn deberia_marcar_producto_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreProducto::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

=== contextos/producto/dominio/src/pruebas/madres.rs ===
use crate::modelo::Producto;
use crate::modelo::PropsProducto;
use crate::valores::Name;
use crate::valores::Status;

pub struct MadreProducto {
    name: Option<Name>,
    sku: Option<String>,
    price: Option<i64>,
    status: Option<Status>,
}

impl MadreProducto {
    pub fn new() -> Self {
        Self {
            name: None,
            sku: None,
            price: None,
            status: None,
        }
    }

    pub fn con_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn con_sku(mut self, sku: &str) -> Self {
        self.sku = Some(sku.to_string());
        self
    }

    pub fn con_price(mut self, price: i64) -> Self {
        self.price = Some(price);
        self
    }

    pub fn con_status(mut self, status: Status) -> Self {
        self.status = Some(status);
        self
    }

    pub fn con_sku_vacio(mut self) -> Self {
        self.sku = Some(String::new());
        self
    }

    pub fn construir(self) -> Producto {
        Producto::new(PropsProducto {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            sku: self.sku.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            status: self.status.unwrap_or(Status::Draft),
        })
        .expect("MadreProducto: Producto::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsProducto {
        PropsProducto {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            sku: self.sku.unwrap_or_else(|| "example".to_string()),
            price: self.price.unwrap_or(42),
            status: self.status.unwrap_or(Status::Draft),
        }
    }

    pub fn aleatorio() -> Producto {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Producto> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }

    /// Un `sku` distinto en cada llamada, para las filas que guardan los tests de los
    /// repositorios (es único). Si una regla del dominio lo rechaza, cámbialo aquí.
    pub fn sku_unico() -> String {
        uuid::Uuid::new_v4().simple().to_string()[..12].to_string()
    }
}

impl Default for MadreProducto {
    fn default() -> Self {
        Self::new()
    }
}

