                repositorio: Arc::clone(&repositorio),
            }),
            close_pedido: Arc::new(ClosePedidoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            pagar_pedido: Arc::new(PagarPedidoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

