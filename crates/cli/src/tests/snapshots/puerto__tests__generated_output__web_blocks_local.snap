use std::sync::Arc;

use async_trait::async_trait;
use puerto_nucleo::auth::Principal;
use puerto_nucleo::{Pagina, PeticionPagina};

use dominio_pedido::{
    errores::ErrorPedido,
    modelo::Pedido,
    repositorio::{FiltroPedido, RepositorioPedido},
};

#[derive(Debug, Clone)]
pub struct ParamsListarMisPedidos {
    /// Quien lo pide: la lista son sus filas (`propietario` en puerto.toml).
    pub actor: Principal,
    pub pagina: PeticionPagina,
}

/// Las filas de quien llama, paginadas: `GET /mis_pedidos`.
#[async_trait]
pub trait ListarMisPedidos: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarMisPedidos)
    -> Result<Pagina<Pedido>, ErrorPedido>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarMisPedidos {}

        #[async_trait]
        impl ListarMisPedidos for ListarMisPedidos {
            async fn ejecutar(&self, params: ParamsListarMisPedidos) -> Result<Pagina<Pedido>, ErrorPedido>;
        }
    }
}

pub struct ListarMisPedidosImpl {
    pub repositorio: Arc<dyn RepositorioPedido>,
}

#[async_trait]
impl ListarMisPedidos for ListarMisPedidosImpl {
    #[tracing::instrument(name = "listar_mis_pedidos", skip_all, err(level = "warn"))]
    async fn ejecutar(
        &self,
        params: ParamsListarMisPedidos,
    ) -> Result<Pagina<Pedido>, ErrorPedido> {
        let filtro = FiltroPedido {
            comprador_id: Some(params.actor.id_usuario),
        };
        self.repositorio
            .buscar_todos(params.pagina, filtro)
            .await
            .map_err(ErrorPedido::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_pedido::repositorio::dobles::MockRepositorioPedido;
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_pedir_al_repositorio_solo_las_filas_de_quien_llama() {
        // Preparar
        let actor = MadrePrincipal::aleatorio();
        let suyo = Some(actor.id_usuario);
        let mut repositorio_doble = MockRepositorioPedido::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(move |_, filtro| filtro.comprador_id == suyo)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarMisPedidosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsListarMisPedidos {
                actor,
                pagina: PeticionPagina::default(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok(), "{:?}", resultado.map(|_| ()));
    }
}

