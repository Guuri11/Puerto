import type { Esquemas } from "../api/cliente";
import { coleccion } from "./api-falsa";

type Producto = Esquemas["DtoProducto"];
type PeticionProducto = Esquemas["PeticionCrearProducto"];

/** Datos válidos de productos; en `cambios`, los campos de los que trata el test. */
export const MadreProducto = {
  peticion(cambios: Partial<PeticionProducto> = {}): PeticionProducto {
    return {
      name: "example",
      sku: "example",
      price: 42,
      status: "Draft",
      ...cambios,
    };
  },

  aleatorio(cambios: Partial<Producto> = {}): Producto {
    return { id: crypto.randomUUID(), ...MadreProducto.peticion(), ...cambios };
  },
};

/** El `/productos` de la API falsa, con `semilla`. */
export function coleccionProducto(semilla: Producto[] = []) {
  return coleccion("/productos", "producto", semilla);
}

=== web/src/pruebas/renderizar.tsx ===
import { render } from "@testing-library/react";
import type { ReactNode } from "react";
import { Router } from "wouter";
import { memoryLocation } from "wouter/memory-location";
import { ProveedorAuth } from "../auth/auth";
import type { UsuarioActual } from "../auth/sesion";
import { ProveedorDependencias } from "../dependencias";
import type { Dependencias } from "../generado/dependencias";
import { MadreUsuarioActual, pasarelaAuthFalsa } from "./auth";

/**
 * Pinta una pantalla en `ruta` con las dependencias que usa (`dependencias` solo necesita esas) y
 * la sesión de `usuario`: por defecto, alguien con todos los roles; `null`, nadie. `historial`
 * guarda cada ruta a la que navega la pantalla.
 */
export function renderizarPantalla(
  ui: ReactNode,
  dependencias: Partial<Dependencias>,
  ruta = "/",
  { usuario = MadreUsuarioActual.llamante() }: { usuario?: UsuarioActual | null } = {},
) {
  const ubicacion = memoryLocation({ path: ruta, record: true });
  const resultado = render(
    // Una pantalla que pide una dependencia que no se le dio falla a la vista: es `undefined`.
    <ProveedorDependencias
      valor={{ auth: pasarelaAuthFalsa({ usuario }), ...dependencias } as Dependencias}
    >
      <Router hook={ubicacion.hook}>
        <ProveedorAuth>{ui}</ProveedorAuth>
      </Router>
    </ProveedorDependencias>,
  );
  return { ...resultado, historial: ubicacion.history };
}
