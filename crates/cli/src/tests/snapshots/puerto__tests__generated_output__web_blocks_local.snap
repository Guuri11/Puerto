use std::sync::Arc;

use async_trait::async_trait;
use puerto_nucleo::auth::Principal;

use dominio_producto::{
    errores::ErrorProducto,
    modelo::{IdProducto, Producto},
    repositorio::RepositorioProducto,
};

#[derive(Debug, Clone)]
pub struct ParamsRetirarProducto {
    /// Quien lo pide (ADR-0021). Una regla que depende de él ("solo lo cancela quien lo creó") se
    /// decide aquí y responde `Prohibido`.
    pub actor: Principal,
    pub id: IdProducto,
}

/// La transición `retirar` de Producto (`puerto generar transicion`): la regla está en
/// `dominio_producto::retirar`.
#[async_trait]
pub trait RetirarProducto: Send + Sync {
    async fn ejecutar(&self, params: ParamsRetirarProducto) -> Result<Producto, ErrorProducto>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub RetirarProducto {}

        #[async_trait]
        impl RetirarProducto for RetirarProducto {
            async fn ejecutar(&self, params: ParamsRetirarProducto) -> Result<Producto, ErrorProducto>;
        }
    }
}

pub struct RetirarProductoImpl {
    pub repositorio: Arc<dyn RepositorioProducto>,
}

#[async_trait]
impl RetirarProducto for RetirarProductoImpl {
    #[tracing::instrument(name = "retirar_producto", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsRetirarProducto) -> Result<Producto, ErrorProducto> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorProducto::NoEncontrado)?;
        entidad.retirar()?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::{
        pruebas::madres::MadreProducto, repositorio::dobles::MockRepositorioProducto,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    /// El repositorio que encuentra `encontrado` y guarda `guardados` veces.
    fn repositorio(encontrado: Option<Producto>, guardados: usize) -> MockRepositorioProducto {
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(encontrado.clone()));
        repositorio_doble
            .expect_guardar()
            .times(guardados)
            .returning(|_| Ok(()));
        repositorio_doble
    }

    fn params(id: IdProducto) -> ParamsRetirarProducto {
        ParamsRetirarProducto {
            actor: MadrePrincipal::aleatorio(),
            id,
        }
    }

    #[tokio::test]
    async fn deberia_retirar_producto_cuando_existe() {
        // Preparar
        let entidad = MadreProducto::aleatorio();
        let id = entidad.id;
        let caso_de_uso = RetirarProductoImpl {
            repositorio: Arc::new(repositorio(Some(entidad), 1)),
        };

        // Actuar
        let resultado = caso_de_uso.ejecutar(params(id)).await;

        // Comprobar
        assert_eq!(resultado.map(|e| e.id).ok(), Some(id));
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_producto_no_existe() {
        // Preparar
        let caso_de_uso = RetirarProductoImpl {
            repositorio: Arc::new(repositorio(None, 0)),
        };

        // Actuar
        let resultado = caso_de_uso.ejecutar(params(IdProducto::generar())).await;

        // Comprobar
        assert_eq!(
            resultado.map(|_| ()).unwrap_err().to_string(),
            "producto.no_encontrado"
        );
    }

    #[tokio::test]
    #[ignore = "escribe la regla"]
    async fn deberia_rechazar_sin_guardar_nada_cuando_producto_no_se_puede_retirar() {
        // Preparar: producto que la regla rechaza (`MadreProducto::new().con_…(…).construir()`)
        let entidad = MadreProducto::aleatorio();
        let id = entidad.id;
        let caso_de_uso = RetirarProductoImpl {
            repositorio: Arc::new(repositorio(Some(entidad), 0)),
        };

        // Actuar
        let resultado = caso_de_uso.ejecutar(params(id)).await;

        // Comprobar
        assert_eq!(
            resultado.map(|_| ()).unwrap_err().to_string(),
            "producto.validacion.no_se_puede_retirar"
        );
    }
}

