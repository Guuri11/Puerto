=== contextos/producto/rest/src/respuestas.rs ===
// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoPaginaProducto, DtoProducto};

#[derive(ApiResponse)]
pub enum RespuestaCrearProducto {
    #[oai(status = 201)]
    Creado(Json<DtoProducto>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearProducto {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerProducto {
    #[oai(status = 200)]
    Ok(Json<DtoProducto>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerProducto {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarProductos {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaProducto>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarProductos {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarProducto {
    #[oai(status = 200)]
    Ok(Json<DtoProducto>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarProducto {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarProducto {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaBorrarProducto {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

=== contextos/producto/rest/src/retirar_producto.rs ===
// La variante de éxito lleva el DTO entero (ver `respuestas.rs`).
#![allow(clippy::large_enum_variant)]

use std::sync::Arc;

use aplicacion_producto::retirar_producto::{ParamsRetirarProducto, RetirarProducto};
use dominio_producto::modelo::IdProducto;
use poem::http::StatusCode;
use poem_openapi::{ApiResponse, OpenApi, Tags, param::Path, payload::Json};
use puerto_web::RespuestaError;
use puerto_web::auth::BearerAuth;
use puerto_web::requiere_rol;
use uuid::Uuid;

use crate::dto::DtoProducto;
use crate::errores::a_respuesta_error;

/// La misma etiqueta que `rutas.rs`: poem-openapi junta las dos por su nombre.
#[derive(Tags)]
enum ApiTags {
    Producto,
}

/// La ruta de la transición `retirar` (`puerto generar transicion`). Va en su propio `Api` para
/// que `rutas.rs` no cambie; `generado/bootstrap.rs` la monta junto a `ApiProducto`.
pub struct ApiRetirarProducto {
    pub retirar_producto: Arc<dyn RetirarProducto>,
}

#[OpenApi]
impl ApiRetirarProducto {
    /// Retirar: Producto
    #[oai(
        path = "/productos/:id/retirar",
        method = "post",
        tag = "ApiTags::Producto"
    )]
    #[requiere_rol("admin")]
    #[requiere_rol("owner")]
    async fn retirar(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaRetirarProducto {
        match self
            .retirar_producto
            .ejecutar(ParamsRetirarProducto {
                actor: auth.0,
                id: IdProducto::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaRetirarProducto::Ok(Json(DtoProducto::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "retirar_producto falló");
                RespuestaRetirarProducto::from_status(status, error)
            }
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaRetirarProducto {
    #[oai(status = 200)]
    Ok(Json<DtoProducto>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    /// No se pudo comprobar el token: el proveedor o la base de datos no responden (`BearerAuth`).
    #[oai(status = 503)]
    NoDisponible(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaRetirarProducto {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            StatusCode::SERVICE_UNAVAILABLE => Self::NoDisponible(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_producto::retirar_producto::dobles::MockRetirarProducto;
    use dominio_producto::errores::ErrorProducto;
    use dominio_producto::pruebas::madres::MadreProducto;
    use poem::{EndpointExt, Route, test::TestClient};
    use poem_openapi::OpenApiService;
    use puerto_nucleo::auth::dobles::{MadrePrincipal, MockAutenticador};
    use puerto_nucleo::auth::{Autenticador, ErrorAuth};

    use super::*;

    /// Acepta `llamante` (con los roles de la ruta) y `nadie` (sin roles).
    fn autenticador() -> Arc<dyn Autenticador> {
        let mut doble = MockAutenticador::new();
        doble.expect_autenticar().returning(|token| match token {
            "llamante" => Ok(MadrePrincipal::new()
                .con_roles(["admin", "owner"])
                .construir()),
            "nadie" => Ok(MadrePrincipal::aleatorio()),
            _ => Err(ErrorAuth::Invalido),
        });
        Arc::new(doble)
    }

    /// La ruta sobre `caso_de_uso`; `autorizacion`, la cabecera de cada petición (`None`: ninguna).
    fn cliente(
        caso_de_uso: MockRetirarProducto,
        autorizacion: Option<&str>,
    ) -> TestClient<impl poem::Endpoint> {
        let api = ApiRetirarProducto {
            retirar_producto: Arc::new(caso_de_uso),
        };
        let cliente = TestClient::new(
            Route::new()
                .nest("/", OpenApiService::new(api, "test", "1.0"))
                .data(autenticador()),
        );
        match autorizacion {
            Some(valor) => cliente.default_header("Authorization", valor),
            None => cliente,
        }
    }

    fn ruta() -> String {
        format!("/productos/{}/retirar", Uuid::new_v4())
    }

    /// El caso de uso, respondiendo `resultado`.
    fn caso_de_uso(resultado: Result<(), ErrorProducto>) -> MockRetirarProducto {
        let mut doble = MockRetirarProducto::new();
        doble
            .expect_ejecutar()
            .return_once(move |_| resultado.map(|()| MadreProducto::aleatorio()));
        doble
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_puede_retirar_producto() {
        // Preparar
        let cliente = cliente(caso_de_uso(Ok(())), Some("Bearer llamante"));

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status_is_ok();
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_producto_no_existe() {
        // Preparar
        let cliente = cliente(
            caso_de_uso(Err(ErrorProducto::NoEncontrado)),
            Some("Bearer llamante"),
        );

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_producto_no_se_puede_retirar() {
        // Preparar
        let rechazo = ErrorProducto::Validacion("no_se_puede_retirar".into());
        let cliente = cliente(caso_de_uso(Err(rechazo)), Some("Bearer llamante"));

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("producto.validacion.no_se_puede_retirar");
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_pide_retirar_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let cliente = cliente(MockRetirarProducto::new(), None);

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_403_cuando_se_pide_retirar_sin_el_rol() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let cliente = cliente(MockRetirarProducto::new(), Some("Bearer nadie"));

        // Actuar
        let respuesta = cliente.post(ruta()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::FORBIDDEN);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("auth.prohibido");
    }
}

=== contextos/producto/rest/src/rutas.rs ===
use aplicacion_producto::publish_producto::PublishProducto;
use std::sync::Arc;

use aplicacion_producto::{
    actualizar_producto::{ActualizarProducto, ParamsActualizarProducto},
    borrar_producto::{BorrarProducto, ParamsBorrarProducto},
    crear_producto::{CrearProducto, ParamsCrearProducto},
    listar_productos::{ListarProductos, ParamsListarProductos},
    obtener_producto::{ObtenerProducto, ParamsObtenerProducto},
};
use dominio_producto::modelo::IdProducto;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use puerto_web::auth::BearerAuth;
use puerto_web::requiere_rol;
use uuid::Uuid;

use crate::dto::{
    DtoPaginaProducto, DtoProducto, PeticionActualizarProducto, PeticionCrearProducto,
};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarProducto, RespuestaBorrarProducto, RespuestaCrearProducto,
    RespuestaListarProductos, RespuestaObtenerProducto,
};

#[derive(Tags)]
enum ApiTags {
    Producto,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiProducto {
    pub crear_producto: Arc<dyn CrearProducto>,
    pub obtener_producto: Arc<dyn ObtenerProducto>,
    pub listar_productos: Arc<dyn ListarProductos>,
    pub actualizar_producto: Arc<dyn ActualizarProducto>,
    pub borrar_producto: Arc<dyn BorrarProducto>,
    /// Lo cablea bootstrap.rs. Llámalo desde un endpoint en el impl `#[OpenApi]` de abajo.
    #[allow(dead_code)]
    pub publish_producto: Arc<dyn PublishProducto>,
}

#[OpenApi]
impl ApiProducto {
    /// Crea: Producto
    #[oai(path = "/productos", method = "post", tag = "ApiTags::Producto")]
    #[requiere_rol("admin")]
    async fn crear(
        &self,
        auth: BearerAuth,
        cuerpo: Json<PeticionCrearProducto>,
    ) -> RespuestaCrearProducto {
        match self
            .crear_producto
            .ejecutar(ParamsCrearProducto {
                actor: auth.0,
                name: cuerpo.name.clone(),
                sku: cuerpo.sku.clone(),
                price: cuerpo.price,
                status: cuerpo.status.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaCrearProducto::Creado(Json(DtoProducto::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_producto falló");
                RespuestaCrearProducto::from_status(status, error)
            }
        }
    }

    /// Obtiene: Producto por id
    #[oai(path = "/productos/:id", method = "get", tag = "ApiTags::Producto")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerProducto {
        match self
            .obtener_producto
            .ejecutar(ParamsObtenerProducto {
                id: IdProducto::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerProducto::Ok(Json(DtoProducto::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_producto falló");
                RespuestaObtenerProducto::from_status(status, error)
            }
        }
    }

    /// Lista Productos, página a página (el dominio acota `limite`)
    #[oai(path = "/productos", method = "get", tag = "ApiTags::Producto")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarProductos {
        match self
            .listar_productos
            .ejecutar(ParamsListarProductos {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => {
                RespuestaListarProductos::Ok(Json(DtoPaginaProducto::from_dominio(&pagina)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_productos falló");
                RespuestaListarProductos::from_status(status, error)
            }
        }
    }

    /// Actualiza: Producto
    #[oai(path = "/productos/:id", method = "put", tag = "ApiTags::Producto")]
    async fn actualizar(
        &self,
        auth: BearerAuth,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarProducto>,
    ) -> RespuestaActualizarProducto {
        match self
            .actualizar_producto
            .ejecutar(ParamsActualizarProducto {
                actor: auth.0,
                id: IdProducto::from_uuid(id.0),
                name: cuerpo.name.clone(),
                sku: cuerpo.sku.clone(),
                price: cuerpo.price,
                status: cuerpo.status.clone(),
            })
            .await
        {
            Ok(entidad) => {
                RespuestaActualizarProducto::Ok(Json(DtoProducto::from_dominio(&entidad)))
            }
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_producto falló");
                RespuestaActualizarProducto::from_status(status, error)
            }
        }
    }

    /// Borra: Producto
    #[oai(path = "/productos/:id", method = "delete", tag = "ApiTags::Producto")]
    #[requiere_rol("admin")]
    #[requiere_rol("owner")]
    async fn borrar(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaBorrarProducto {
        match self
            .borrar_producto
            .ejecutar(ParamsBorrarProducto {
                actor: auth.0,
                id: IdProducto::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarProducto::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_producto falló");
                RespuestaBorrarProducto::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_producto::{
        actualizar_producto::dobles::MockActualizarProducto,
        borrar_producto::dobles::MockBorrarProducto, crear_producto::dobles::MockCrearProducto,
        listar_productos::dobles::MockListarProductos,
        obtener_producto::dobles::MockObtenerProducto,
    };
    use dominio_producto::errores::ErrorProducto;
    use dominio_producto::pruebas::madres::MadreProducto;
    use poem::{EndpointExt, Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;
    use puerto_nucleo::auth::dobles::MadrePrincipal;
    use puerto_nucleo::auth::dobles::MockAutenticador;
    use puerto_nucleo::auth::{Autenticador, ErrorAuth};

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearProducto,
        obtener: MockObtenerProducto,
        listar: MockListarProductos,
        actualizar: MockActualizarProducto,
        borrar: MockBorrarProducto,
        publish_producto: aplicacion_producto::publish_producto::dobles::MockPublishProducto,
    }

    /// Acepta `llamante` (con todos los roles que pide alguna ruta de esta API) y `nadie`
    /// (sin roles).
    fn autenticador() -> Arc<dyn Autenticador> {
        let mut doble = MockAutenticador::new();
        doble.expect_autenticar().returning(|token| match token {
            "llamante" => Ok(MadrePrincipal::new()
                .con_roles(["admin", "owner"])
                .construir()),
            "nadie" => Ok(MadrePrincipal::aleatorio()),
            _ => Err(ErrorAuth::Invalido),
        });
        Arc::new(doble)
    }

    impl Dobles {
        /// Todas las peticiones, con sesión iniciada como `llamante`.
        fn cliente(self) -> TestClient<impl poem::Endpoint> {
            self.cliente_con(Some("Bearer llamante"))
        }

        /// `autorizacion`: la cabecera que envía cada petición; con `None` no se envía ninguna.
        fn cliente_con(self, autorizacion: Option<&str>) -> TestClient<impl poem::Endpoint> {
            let api = ApiProducto {
                crear_producto: Arc::new(self.crear),
                obtener_producto: Arc::new(self.obtener),
                listar_productos: Arc::new(self.listar),
                actualizar_producto: Arc::new(self.actualizar),
                borrar_producto: Arc::new(self.borrar),
                publish_producto: Arc::new(self.publish_producto),
            };
            let cliente = TestClient::new(
                Route::new()
                    .nest("/", OpenApiService::new(api, "test", "1.0"))
                    .data(autenticador()),
            );
            match autorizacion {
                Some(valor) => cliente.default_header("Authorization", valor),
                None => cliente,
            }
        }
    }

    fn peticion_crear() -> PeticionCrearProducto {
        PeticionCrearProducto {
            name: "example".to_string(),
            sku: "example".to_string(),
            price: 42,
            status: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarProducto {
        PeticionActualizarProducto {
            name: "example".to_string(),
            sku: "example".to_string(),
            price: 42,
            status: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/productos/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_producto() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreProducto::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/productos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_producto_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorProducto::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/productos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_producto_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreProducto::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_producto_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorProducto::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_productos_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreProducto::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/productos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/productos?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorProducto::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/productos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_producto() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreProducto::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_producto_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorProducto::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_producto() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_producto_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorProducto::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_crea_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .post("/productos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_403_cuando_se_crea_sin_el_rol() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(Some("Bearer nadie"))
            .post("/productos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::FORBIDDEN);
        respuesta
            .json()
            .await
