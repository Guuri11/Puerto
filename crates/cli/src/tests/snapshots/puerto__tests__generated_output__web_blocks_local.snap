import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa, coleccion } from "../../../pruebas/api-falsa";
import { MadreUsuarioActual } from "../../../pruebas/auth";
import { MadreProducto } from "../../../pruebas/producto";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { BotonRetirarProducto } from "./retirar-producto";

/** El botón que abre el diálogo, y el que confirma dentro de él. */
const ABRIR = { selector: ".card-actions > button" };
const CONFIRMAR = { selector: ".modal-action button" };

describe("BotonRetirarProducto", () => {
  test("debería retirar producto tras confirmarlo", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const api = apiFalsa([coleccion("/productos", "producto", [sembrado], { retirar: {} })]);
    const alTerminar = mock(() => {});
    const pantalla = (
      <div className="card-actions">
        <BotonRetirarProducto id={sembrado.id} alTerminar={alTerminar} />
      </div>
    );
    renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Retirar producto", ABRIR));

    // Actuar
    fireEvent.click(screen.getByText("Retirar producto", CONFIRMAR));

    // Comprobar
    await waitFor(() => expect(alTerminar).toHaveBeenCalledTimes(1));
  });

  test("debería explicar el rechazo cuando no se puede retirar", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const codigo = "producto.validacion.no_se_puede_retirar";
    const fallos = { "POST /productos/{id}/retirar": codigo };
    const api = apiFalsa([coleccion("/productos", "producto", [sembrado])], fallos);
    const alTerminar = mock(() => {});
    const pantalla = (
      <div className="card-actions">
        <BotonRetirarProducto id={sembrado.id} alTerminar={alTerminar} />
      </div>
    );
    renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Retirar producto", ABRIR));

    // Actuar
    fireEvent.click(screen.getByText("Retirar producto", CONFIRMAR));

    // Comprobar
    const alerta = await screen.findByRole("alert");
    expect(alerta.textContent).toBe(aProblema(codigo).texto);
    expect(alTerminar).not.toHaveBeenCalled();
  });

  test("no debería ofrecer retirar producto a quien no tiene su rol", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const api = apiFalsa([coleccion("/productos", "producto", [sembrado])]);
    const usuario = MadreUsuarioActual.aleatorio();
    const pantalla = (
      <div className="card-actions">
        <p>Al lado</p>
        <BotonRetirarProducto id={sembrado.id} alTerminar={() => {}} />
      </div>
    );

    // Actuar
    renderizarPantalla(pantalla, { api }, "/", { usuario });

    // Comprobar: con la sesión ya cargada, cuando se ve lo de al lado
    expect(await screen.findByText("Al lado")).toBeTruthy();
    expect(screen.queryByText("Retirar producto")).toBeNull();
  });
});

=== web/src/contextos/producto/contenedores/retirar-producto.tsx ===
import { useState } from "react";
import { desenvolver } from "../../../api/http";
import { useAuth } from "../../../auth/auth";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";

/**
 * «Retirar producto», tras confirmarlo; si la API lo rechaza, el diálogo se queda abierto y dice
 * por qué. `alTerminar`, cuando se hizo.
 */
export function BotonRetirarProducto({ id, alTerminar }: { id: string; alTerminar: () => void }) {
  const { api } = useDependencias();
  const { puede } = useAuth();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const confirmar = async () => {
    setFallo(null);
    try {
      await desenvolver(api.POST("/productos/{id}/retirar", { params: { path: { id } } }));
      setConfirmando(false);
      alTerminar();
    } catch (error) {
      setFallo(error);
    }
  };
  const volver = () => {
    setConfirmando(false);
    setFallo(null);
  };
  if (!(puede("admin") && puede("owner"))) return null;

  return (
    <>
      <button type="button" className="btn btn-warning" onClick={() => setConfirmando(true)}>
        Retirar producto
      </button>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Retirar producto?"
        textoConfirmar="Retirar producto"
        textoCancelar="Volver"
        alConfirmar={confirmar}
        alCancelar={volver}
      >
        {fallo !== null && (
          <AlertaError error={fallo} mensaje={aProblema(codigoError(fallo)).texto} />
        )}
      </DialogoConfirmar>
    </>
  );
}

=== web/src/contextos/producto/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaProducto {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "producto.name_invalido": "Name: no válido",
  "producto.validacion.sku_vacio": "Sku: campo obligatorio",
  "producto.status_invalido": "Status: no válido",
  "producto.duplicado": "Sku: ya está en uso",
  "producto.no_encontrado": "Ya no existe",
  "producto.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "producto.desconocido": "Algo ha ido mal",
  "producto.validacion.no_se_puede_retirar": "No se puede retirar",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "producto.name_invalido": "name",
  "producto.validacion.sku_vacio": "sku",
  "producto.status_invalido": "status",
  "producto.duplicado": "sku",
};

export function aProblema(codigo: string): ProblemaProducto {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

