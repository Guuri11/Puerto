            async fn buscar_por_id(&self, id: IdProducto) -> Result<Option<Producto>, ErrorRepositorio>;
            async fn guardar(&self, entidad: &Producto) -> Result<(), ErrorRepositorio>;
        }
    }
}

=== contextos/producto/dominio/src/retirar.rs ===
use crate::errores::ErrorProducto;
use crate::modelo::Producto;

/// La transición `retirar` (`puerto generar transicion`): un `impl` aparte, así que `modelo.rs`
/// no cambia. La regla y el cambio son tuyos.
impl Producto {
    pub fn retirar(&mut self) -> Result<(), ErrorProducto> {
        // La regla: cuándo no se puede retirar. La API responde 422 con este código:
        // if <no se puede> {
        //     return Err(ErrorProducto::Validacion("no_se_puede_retirar".into()));
        // }
        // El cambio: los campos que pasan a otro valor (p. ej. un estado).
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use crate::pruebas::madres::MadreProducto;

    #[test]
    fn deberia_retirar_producto_cuando_se_puede() {
        // Preparar
        let mut entidad = MadreProducto::aleatorio();

        // Actuar
        let resultado = entidad.retirar();

        // Comprobar
        assert!(resultado.is_ok(), "retirar falló: {resultado:?}");
    }

    #[test]
    #[ignore = "escribe la regla"]
    fn deberia_rechazar_retirar_producto_cuando_no_se_puede() {
        // Preparar: producto que la regla rechaza (`MadreProducto::new().con_…(…).construir()`)
        let mut entidad = MadreProducto::aleatorio();

        // Actuar
        let resultado = entidad.retirar();

        // Comprobar
        match resultado {
            Err(e) => assert_eq!(e.to_string(), "producto.validacion.no_se_puede_retirar"),
            Ok(_) => panic!("retirar debería rechazarlo"),
        }
    }
}

=== contextos/producto/dominio/src/valores.rs ===
use crate::errores::ErrorProducto;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorProducto> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorProducto::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Draft,
    Live,
}

impl std::str::FromStr for Status {
    type Err = ErrorProducto;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Draft" => Ok(Self::Draft),
            "Live" => Ok(Self::Live),
            _ => Err(ErrorProducto::StatusInvalido),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Draft => "Draft",
            Self::Live => "Live",
        }
    }
}

