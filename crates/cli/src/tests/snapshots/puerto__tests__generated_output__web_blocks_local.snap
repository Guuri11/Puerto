import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ErrorAuth } from "../auth/sesion";
import { cuentasFalsas } from "../pruebas/auth";
import { renderizarPantalla } from "../pruebas/renderizar";
import { PaginaRegistro } from "./registro";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

async function rellenar() {
  await screen.findByText("Ya tengo una cuenta");
  escribir("Email", "ana@example.com");
  escribir("Contraseña", "caballo correcto bateria");
}

describe("PaginaRegistro", () => {
  test("debería iniciar sesión con la cuenta nueva y volver a la página que lo pidió", async () => {
    // Preparar
    const cuentas = cuentasFalsas();
    const ruta = "/registro?siguiente=%2Fpedidos";
    const { historial } = renderizarPantalla(<PaginaRegistro />, { cuentas }, ruta, {
      usuario: null,
    });
    await rellenar();

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Crear cuenta" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/pedidos"));
    expect(cuentas.inicios).toHaveLength(1);
  });

  test("debería mostrar un email ya usado junto a su campo", async () => {
    // Preparar
    const cuentas = {
      ...cuentasFalsas(),
      registrar: () => Promise.reject(new ErrorAuth("usuario.duplicado")),
    };
    renderizarPantalla(<PaginaRegistro />, { cuentas }, "/registro", { usuario: null });
    await rellenar();

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Crear cuenta" }));

    // Comprobar
    expect(await screen.findByText("Ya hay una cuenta con este email")).toBeTruthy();
    expect(screen.getByLabelText("Email").getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });

  test("debería mostrar una contraseña corta junto a su campo", async () => {
    // Preparar
    const cuentas = {
      ...cuentasFalsas(),
      registrar: () =>
        Promise.reject(new ErrorAuth("usuario.validacion.contrasena_demasiado_corta")),
    };
    renderizarPantalla(<PaginaRegistro />, { cuentas }, "/registro", { usuario: null });
    await rellenar();

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Crear cuenta" }));

    // Comprobar
    expect(await screen.findByText("Usa al menos 12 caracteres")).toBeTruthy();
    expect(screen.getByLabelText("Contraseña").getAttribute("aria-invalid")).toBe("true");
  });
});

=== web/src/paginas/registro.tsx ===
import { useState } from "react";
import { Link, useLocation, useSearch } from "wouter";
import { useAuth } from "../auth/auth";
import { aProblemaCuenta } from "../auth/mensajes";
import { textoOpcional } from "../compartido/formularios";
import { AlertaError, codigoError } from "../compartido/ui/alerta-error";
import { ErrorCampo } from "../compartido/ui/error-campo";
import { useDependencias } from "../dependencias";
import { rutaSiguiente } from "./login";

/** Crea una cuenta, inicia sesión con ella y vuelve adonde se pidió el inicio de sesión. */
export function PaginaRegistro() {
  const { cuentas } = useDependencias();
  const { refrescar } = useAuth();
  const [, navegar] = useLocation();
  const busqueda = useSearch();
  const [valores, setValores] = useState({ email: "", contrasena: "", nombre: "" });
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblemaCuenta(codigoError(fallo));

  const enviar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      await cuentas.registrar({
        email: valores.email,
        contrasena: valores.contrasena,
        nombre: textoOpcional(valores.nombre),
      });
      await cuentas.iniciarSesion(valores.email, valores.contrasena);
      await refrescar();
      navegar(rutaSiguiente(busqueda), { replace: true });
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Crea una cuenta</h1>
      {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
      <form
        className="space-y-2"
        onSubmit={(event) => {
          event.preventDefault();
          void enviar();
        }}
      >
        <label className="fieldset">
          <span className="fieldset-legend">Email</span>
          <input
            className="input w-full"
            type="email"
            autoComplete="email"
            aria-invalid={problema?.campo === "email"}
            required
            value={valores.email}
            onChange={(event) => setValores({ ...valores, email: event.target.value })}
          />
        </label>
        <ErrorCampo problema={problema} campo="email" />
        <label className="fieldset">
          <span className="fieldset-legend">Contraseña</span>
          <input
            className="input w-full"
            type="password"
            autoComplete="new-password"
            aria-invalid={problema?.campo === "contrasena"}
            required
            minLength={12}
            value={valores.contrasena}
            onChange={(event) => setValores({ ...valores, contrasena: event.target.value })}
          />
        </label>
        <ErrorCampo problema={problema} campo="contrasena" />
        <label className="fieldset">
          <span className="fieldset-legend">Nombre</span>
          <input
            className="input w-full"
            type="text"
            autoComplete="name"
            value={valores.nombre}
            onChange={(event) => setValores({ ...valores, nombre: event.target.value })}
          />
        </label>
        <ErrorCampo problema={problema} campo="nombre" />
        <button type="submit" className="btn btn-primary w-full" disabled={guardando}>
          Crear cuenta
        </button>
      </form>
      <Link href={`/login${busqueda === "" ? "" : `?${busqueda}`}`} className="link">
        Ya tengo una cuenta
      </Link>
    </section>
  );
}

