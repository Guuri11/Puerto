        let repositorio_doble = MockRepositorioProducto::new();
        let caso_de_uso = CrearProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearProducto {
                actor: MadrePrincipal::aleatorio(),
                name: props.name.valor().to_string(),
                sku: "".to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.sku_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_name_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let repositorio_doble = MockRepositorioProducto::new();
        let caso_de_uso = CrearProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
