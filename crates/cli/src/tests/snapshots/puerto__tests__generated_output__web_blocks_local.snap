use std::sync::Arc;

use async_trait::async_trait;
use puerto_nucleo::auth::Principal;

use dominio_pedido::{
    errores::ErrorPedido,
    modelo::{IdPedido, Pedido},
    repositorio::RepositorioPedido,
};

#[derive(Debug, Clone)]
pub struct ParamsPagarPedido {
    /// Quien lo pide (ADR-0021). Una regla que depende de él ("solo lo cancela quien lo creó") se
    /// decide aquí y responde `Prohibido`.
    pub actor: Principal,
    pub id: IdPedido,
}

/// La transición `pagar` de Pedido (`puerto generar transicion`): la regla está en
/// `dominio_pedido::pagar`.
#[async_trait]
pub trait PagarPedido: Send + Sync {
    async fn ejecutar(&self, params: ParamsPagarPedido) -> Result<Pedido, ErrorPedido>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub PagarPedido {}

        #[async_trait]
        impl PagarPedido for PagarPedido {
            async fn ejecutar(&self, params: ParamsPagarPedido) -> Result<Pedido, ErrorPedido>;
        }
    }
}

pub struct PagarPedidoImpl {
    pub repositorio: Arc<dyn RepositorioPedido>,
}

#[async_trait]
impl PagarPedido for PagarPedidoImpl {
    #[tracing::instrument(name = "pagar_pedido", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsPagarPedido) -> Result<Pedido, ErrorPedido> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorPedido::NoEncontrado)?;
        entidad.pagar()?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_pedido::{
        pruebas::madres::MadrePedido, repositorio::dobles::MockRepositorioPedido,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    /// El repositorio que encuentra `encontrado` y guarda `guardados` veces.
    fn repositorio(encontrado: Option<Pedido>, guardados: usize) -> MockRepositorioPedido {
        let mut repositorio_doble = MockRepositorioPedido::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(encontrado.clone()));
        repositorio_doble
            .expect_guardar()
            .times(guardados)
            .returning(|_| Ok(()));
        repositorio_doble
    }

    fn params(id: IdPedido) -> ParamsPagarPedido {
        ParamsPagarPedido {
            actor: MadrePrincipal::aleatorio(),
            id,
        }
    }

    #[tokio::test]
    async fn deberia_pagar_pedido_cuando_existe() {
        // Preparar
        let entidad = MadrePedido::aleatorio();
        let id = entidad.id;
        let caso_de_uso = PagarPedidoImpl {
            repositorio: Arc::new(repositorio(Some(entidad), 1)),
        };

        // Actuar
        let resultado = caso_de_uso.ejecutar(params(id)).await;

        // Comprobar
        assert_eq!(resultado.map(|e| e.id).ok(), Some(id));
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_pedido_no_existe() {
        // Preparar
        let caso_de_uso = PagarPedidoImpl {
            repositorio: Arc::new(repositorio(None, 0)),
        };

        // Actuar
        let resultado = caso_de_uso.ejecutar(params(IdPedido::generar())).await;

        // Comprobar
        assert_eq!(
            resultado.map(|_| ()).unwrap_err().to_string(),
            "pedido.no_encontrado"
        );
    }

    #[tokio::test]
    #[ignore = "escribe la regla"]
    async fn deberia_rechazar_sin_guardar_nada_cuando_pedido_no_se_puede_pagar() {
        // Preparar: pedido que la regla rechaza (`MadrePedido::new().con_…(…).construir()`)
        let entidad = MadrePedido::aleatorio();
        let id = entidad.id;
        let caso_de_uso = PagarPedidoImpl {
            repositorio: Arc::new(repositorio(Some(entidad), 0)),
        };

        // Actuar
        let resultado = caso_de_uso.ejecutar(params(id)).await;

        // Comprobar
        assert_eq!(
            resultado.map(|_| ()).unwrap_err().to_string(),
            "pedido.validacion.no_se_puede_pagar"
        );
    }
}

