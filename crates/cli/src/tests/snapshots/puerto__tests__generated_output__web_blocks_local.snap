=== contextos/producto/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad producto válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_producto::modelo::Producto;
use dominio_producto::modelo::PropsProducto;
use dominio_producto::pruebas::madres::MadreProducto;
use dominio_producto::repositorio::RepositorioProducto;
use sqlx::PgPool;

use crate::repositorio::RepositorioProductoPostgres;

/// Una entidad producto válida, sin guardar, con los valores de la madre salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada).
pub fn construir() -> Producto {
    Producto::new(PropsProducto {
        sku: MadreProducto::sku_unico(),
        ..MadreProducto::new().construir_props()
    })
    .unwrap()
}

/// Una entidad producto guardada.
pub async fn sembrar(pool: &PgPool) -> Producto {
    let entidad = construir();
    RepositorioProductoPostgres::new(pool.clone())
        .guardar(&entidad)
        .await
        .unwrap();
    entidad
}

=== contextos/producto/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_producto::{
    modelo::{IdProducto, Producto},
    repositorio::RepositorioProducto,
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::mapear_error_sqlx;

use crate::fila::FilaProducto;

pub struct RepositorioProductoPostgres {
    pub pool: PgPool,
}

impl RepositorioProductoPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaProducto) -> Result<Producto, ErrorRepositorio> {
    Producto::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad producto válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioProducto for RepositorioProductoPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Producto>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        let filas = sqlx::query_as!(
            FilaProducto,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, name, sku, price, status
             FROM productos WHERE borrado = false
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento())
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM productos WHERE borrado = false"#
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdProducto) -> Result<Option<Producto>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaProducto,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, name, sku, price, status
             FROM productos WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }

    async fn guardar(&self, entidad: &Producto) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaProducto::from(entidad);
        sqlx::query!(
            "INSERT INTO productos (id, creado_en, actualizado_en, borrado, borrado_en, name, sku, price, status)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, name = $6, sku = $7, price = $8, status = $9",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.name,
            db.sku,
            db.price,
            db.status,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            let error = mapear_error_sqlx(&e);
            match error {
                // Lo rechaza quien llama (409 / 422): no es un fallo del servidor.
                ErrorRepositorio::Duplicado | ErrorRepositorio::ReferenciaInexistente(_) => {
                    tracing::warn!(error = %e, "guardar rechazado")
                }
                _ => tracing::error!(error = %e, "guardar falló"),
            }
            error
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::{construir, sembrar};

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioProductoPostgres {
        RepositorioProductoPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.name, entidad.name);
        assert_eq!(encontrado.sku, entidad.sku);
        assert_eq!(encontrado.price, entidad.price);
        assert_eq!(encontrado.status, entidad.status);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdProducto::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_la_entidad_al_guardar_un_id_existente(pool: PgPool) {
        // Preparar
        let mut entidad = sembrar(&pool).await;
        entidad.sku = "updated".to_string();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        repositorio_de_prueba(pool.clone())
            .guardar(&entidad)
            .await
            .unwrap();

        // Comprobar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(encontrado.sku, "updated");
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_productos_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        repositorio_de_prueba(pool.clone())
            .guardar(&borrado)
            .await
            .unwrap();

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_un_duplicado_de_sku(pool: PgPool) {
        // Preparar
        let primero = sembrar(&pool).await;
        let mut segundo = construir();
        segundo.sku = primero.sku.clone();

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&segundo).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::Duplicado);
    }
}

