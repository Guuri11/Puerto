import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ErrorAuth } from "../auth/sesion";
import { rutaApp } from "../generado/rutas";
import { cuentasFalsas } from "../pruebas/auth";
import { renderizarPantalla } from "../pruebas/renderizar";
import { PaginaLogin, rutaSiguiente } from "./login";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

describe("PaginaLogin", () => {
  test("debería iniciar sesión y volver a la página que lo pidió", async () => {
    // Preparar
    const cuentas = cuentasFalsas();
    const { historial } = renderizarPantalla(
      <PaginaLogin />,
      { cuentas },
      "/login?siguiente=%2Fpedidos%3Fpagina%3D2",
      { usuario: null },
    );
    await screen.findByText("Crea una cuenta");
    escribir("Email", "ana@example.com");
    escribir("Contraseña", "caballo correcto bateria");

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Iniciar sesión" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/pedidos?pagina=2"));
    expect(cuentas.inicios).toEqual([
      { email: "ana@example.com", contrasena: "caballo correcto bateria" },
    ]);
  });

  test("debería decirlo cuando el email o la contraseña están mal", async () => {
    // Preparar
    const cuentas = {
      ...cuentasFalsas(),
      iniciarSesion: () => Promise.reject(new ErrorAuth("auth.credenciales_invalidas")),
    };
    renderizarPantalla(<PaginaLogin />, { cuentas }, "/login", { usuario: null });
    await screen.findByText("Crea una cuenta");
    escribir("Email", "ana@example.com");
    escribir("Contraseña", "¡contraseña mal!");

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Iniciar sesión" }));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("Email o contraseña incorrectos");
  });
});

describe("rutaSiguiente", () => {
  test("debería volver solo a una página de esta app y, si no, a la app", () => {
    expect(rutaSiguiente("siguiente=%2Fpedidos")).toBe("/pedidos");
    expect(rutaSiguiente("")).toBe(rutaApp);
    expect(rutaSiguiente("siguiente=%2F%2Fmalo.example")).toBe(rutaApp);
    expect(rutaSiguiente("siguiente=https%3A%2F%2Fmalo.example")).toBe(rutaApp);
  });
});

=== web/src/paginas/login.tsx ===
import { useState } from "react";
import { Link, useLocation, useSearch } from "wouter";
import { useAuth } from "../auth/auth";
import { aProblemaCuenta } from "../auth/mensajes";
import { AlertaError, codigoError } from "../compartido/ui/alerta-error";
import { ErrorCampo } from "../compartido/ui/error-campo";
import { useDependencias } from "../dependencias";
import { rutaApp } from "../generado/rutas";

/**
 * La página a la que volver tras iniciar sesión: `?siguiente=`, si es una ruta de esta app — nunca
 * otro sitio (`//malo.example`); si no, la app.
 */
export function rutaSiguiente(busqueda: string): string {
  const siguiente = new URLSearchParams(busqueda).get("siguiente");
  return siguiente?.startsWith("/") && !siguiente.startsWith("//") ? siguiente : rutaApp;
}

/** Adonde mandan `RequiereAuth` y un `401` a quien no tiene la sesión iniciada. */
export function PaginaLogin() {
  const { cuentas } = useDependencias();
  const { refrescar } = useAuth();
  const [, navegar] = useLocation();
  const busqueda = useSearch();
  const [valores, setValores] = useState({ email: "", contrasena: "" });
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblemaCuenta(codigoError(fallo));

  const enviar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      await cuentas.iniciarSesion(valores.email, valores.contrasena);
      await refrescar();
      navegar(rutaSiguiente(busqueda), { replace: true });
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Iniciar sesión</h1>
      {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
      <form
        className="space-y-2"
        onSubmit={(event) => {
          event.preventDefault();
          void enviar();
        }}
      >
        <label className="fieldset">
          <span className="fieldset-legend">Email</span>
          <input
            className="input w-full"
            type="email"
            autoComplete="email"
            aria-invalid={problema?.campo === "email"}
            required
            value={valores.email}
            onChange={(event) => setValores({ ...valores, email: event.target.value })}
          />
        </label>
        <ErrorCampo problema={problema} campo="email" />
        <label className="fieldset">
          <span className="fieldset-legend">Contraseña</span>
          <input
            className="input w-full"
            type="password"
            autoComplete="current-password"
            aria-invalid={problema?.campo === "contrasena"}
            required
            value={valores.contrasena}
            onChange={(event) => setValores({ ...valores, contrasena: event.target.value })}
          />
        </label>
        <ErrorCampo problema={problema} campo="contrasena" />
        <button type="submit" className="btn btn-primary w-full" disabled={guardando}>
          Iniciar sesión
        </button>
      </form>
      <Link href={`/registro${busqueda === "" ? "" : `?${busqueda}`}`} className="link">
        Crea una cuenta
      </Link>
    </section>
  );
}

