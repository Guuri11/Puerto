import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa, coleccion } from "../../../pruebas/api-falsa";
import { coleccionPedido, MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaPedido } from "./lista-pedido";

describe("ContenedorListaPedido", () => {
  test("debería mostrar solo las propias cuando se le pide", async () => {
    // Preparar: `GET /mis_pedidos` responde las de quien llama; la lista entera, otras
    const otras = coleccionPedido([MadrePedido.aleatorio(), MadrePedido.aleatorio()]);
    const propias = coleccion("/mis_pedidos", "pedido", [MadrePedido.aleatorio()]);
    const api = apiFalsa([otras, propias]);

    // Actuar
    renderizarPantalla(<ContenedorListaPedido propias />, { api });

    // Comprobar
    expect(await screen.findByText("Mis pedidos")).toBeTruthy();
    expect(await screen.findAllByText("Ver")).toHaveLength(1);
  });
  test("debería mostrar una fila por cada pedido", async () => {
    // Preparar
    const semilla = [MadrePedido.aleatorio(), MadrePedido.aleatorio()];
    const api = apiFalsa([coleccionPedido(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadrePedido.aleatorio());
    const api = apiFalsa([coleccionPedido(semilla)]);
    renderizarPantalla(<ContenedorListaPedido />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadrePedido.aleatorio());
    const api = apiFalsa([coleccionPedido(semilla)]);
    const ruta = "/pedidos?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay pedidos", async () => {
    // Preparar
    const api = apiFalsa([coleccionPedido()]);

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay pedidos.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /pedidos": "pedido.repositorio" };
    const api = apiFalsa([coleccionPedido()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaPedido />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("pedido.repositorio");
  });
});

=== web/src/contextos/pedido/contenedores/lista-pedido.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, TAMANO_PAGINA } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaPedido } from "../vistas/lista-pedido";

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
/** Con `propias`, solo las de quien usa la app (`GET /mis_pedidos`, 27.18). */
export function ContenedorListaPedido({ propias = false }: { propias?: boolean }) {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const pedidos = useCarga(
    () =>
      desenvolver(
        propias
          ? api.GET("/mis_pedidos", { params: { query: consulta } })
          : api.GET("/pedidos", { params: { query: consulta } }),
      ),
    [api, desplazamiento, propias],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">{propias ? "Mis pedidos" : "Pedidos"}</h1>
        <Link href="/pedidos/nuevo" className="btn btn-primary">
          Crear pedido
        </Link>
      </div>
      {pedidos.estado === "cargando" && <span className="loading loading-spinner" />}
      {pedidos.estado === "error" && <AlertaError error={pedidos.error} />}
      {pedidos.estado === "listo" &&
        (pedidos.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay pedidos." />
        ) : (
          <>
            <VistaListaPedido pedidos={pedidos.datos.elementos} />
            <Paginacion
              total={pedidos.datos.total}
              limite={pedidos.datos.limite}
              desplazamiento={pedidos.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/pedido/contenedores/pagar-pedido.test.tsx ===
import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa, coleccion } from "../../../pruebas/api-falsa";
import { MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { BotonPagarPedido } from "./pagar-pedido";

/** El botón que abre el diálogo, y el que confirma dentro de él. */
const ABRIR = { selector: ".card-actions > button" };
const CONFIRMAR = { selector: ".modal-action button" };

describe("BotonPagarPedido", () => {
  test("debería pagar pedido tras confirmarlo", async () => {
    // Preparar
    const sembrado = MadrePedido.aleatorio();
    const api = apiFalsa([coleccion("/pedidos", "pedido", [sembrado], { pagar: {} })]);
    const alTerminar = mock(() => {});
    const pantalla = (
      <div className="card-actions">
        <BotonPagarPedido id={sembrado.id} alTerminar={alTerminar} />
      </div>
    );
    renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Pagar pedido", ABRIR));

    // Actuar
    fireEvent.click(screen.getByText("Pagar pedido", CONFIRMAR));

    // Comprobar
    await waitFor(() => expect(alTerminar).toHaveBeenCalledTimes(1));
  });

  test("debería explicar el rechazo cuando no se puede pagar", async () => {
    // Preparar
    const sembrado = MadrePedido.aleatorio();
    const codigo = "pedido.validacion.no_se_puede_pagar";
    const fallos = { "POST /pedidos/{id}/pagar": codigo };
    const api = apiFalsa([coleccion("/pedidos", "pedido", [sembrado])], fallos);
    const alTerminar = mock(() => {});
    const pantalla = (
      <div className="card-actions">
        <BotonPagarPedido id={sembrado.id} alTerminar={alTerminar} />
      </div>
    );
    renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Pagar pedido", ABRIR));

    // Actuar
    fireEvent.click(screen.getByText("Pagar pedido", CONFIRMAR));

    // Comprobar
    const alerta = await screen.findByRole("alert");
    expect(alerta.textContent).toBe(aProblema(codigo).texto);
    expect(alTerminar).not.toHaveBeenCalled();
  });

  test("no debería ofrecer pagar pedido sin sesión", async () => {
    // Preparar
    const sembrado = MadrePedido.aleatorio();
    const api = apiFalsa([coleccion("/pedidos", "pedido", [sembrado])]);
    const pantalla = (
      <div className="card-actions">
        <p>Al lado</p>
        <BotonPagarPedido id={sembrado.id} alTerminar={() => {}} />
      </div>
    );

    // Actuar
    renderizarPantalla(pantalla, { api }, "/", { usuario: null });

    // Comprobar: con la sesión ya cargada, cuando se ve lo de al lado
    expect(await screen.findByText("Al lado")).toBeTruthy();
    expect(screen.queryByText("Pagar pedido")).toBeNull();
  });
});

=== web/src/contextos/pedido/contenedores/pagar-pedido.tsx ===
import { useState } from "react";
import { desenvolver } from "../../../api/http";
import { useAuth } from "../../../auth/auth";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";

/**
 * «Pagar pedido», tras confirmarlo; si la API lo rechaza, el diálogo se queda abierto y dice
 * por qué. `alTerminar`, cuando se hizo.
 */
export function BotonPagarPedido({ id, alTerminar }: { id: string; alTerminar: () => void }) {
  const { api } = useDependencias();
  const { usuario } = useAuth();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const confirmar = async () => {
    setFallo(null);
    try {
      await desenvolver(api.POST("/pedidos/{id}/pagar", { params: { path: { id } } }));
      setConfirmando(false);
      alTerminar();
    } catch (error) {
      setFallo(error);
    }
  };
  const volver = () => {
    setConfirmando(false);
    setFallo(null);
  };

  if (usuario === null) return null;

  return (
    <>
      <button type="button" className="btn btn-warning" onClick={() => setConfirmando(true)}>
        Pagar pedido
      </button>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Pagar pedido?"
        textoConfirmar="Pagar pedido"
        textoCancelar="Volver"
        alConfirmar={confirmar}
        alCancelar={volver}
      >
        {fallo !== null && (
          <AlertaError error={fallo} mensaje={aProblema(codigoError(fallo)).texto} />
        )}
      </DialogoConfirmar>
    </>
  );
}

=== web/src/contextos/pedido/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaPedido {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "pedido.duplicado": "Estos valores ya están en uso",
  "pedido.no_encontrado": "Ya no existe",
  "pedido.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "pedido.desconocido": "Algo ha ido mal",
  "pedido.validacion.no_se_puede_pagar": "No se puede pagar",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {};

export function aProblema(codigo: string): ProblemaPedido {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

