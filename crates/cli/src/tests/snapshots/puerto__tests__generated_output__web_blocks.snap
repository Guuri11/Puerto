import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { MadreUsuarioActual } from "../../../pruebas/auth";
import { coleccionProducto, MadreProducto } from "../../../pruebas/producto";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleProducto } from "./detalle-producto";

describe("ContenedorDetalleProducto", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const api = apiFalsa([coleccionProducto([sembrado])]);

    const pantalla = <ContenedorDetalleProducto id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionProducto()]);
    const pantalla = <ContenedorDetalleProducto id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("producto.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const guardados = coleccionProducto([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleProducto id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/productos"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });

  test("no debería ofrecer Borrar a quien no tiene su rol", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const api = apiFalsa([coleccionProducto([sembrado])]);
    const usuario = MadreUsuarioActual.aleatorio();
    const pantalla = <ContenedorDetalleProducto id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api }, "/", { usuario });

    // Comprobar
    expect(await screen.findByText("Name", { selector: "dt" })).toBeTruthy();
    expect(screen.queryByText("Borrar", { selector: ".card-actions *" })).toBeNull();
  });

  test("debería mostrar auth.prohibido cuando la API rechaza el borrado", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const fallos = { "DELETE /productos": "auth.prohibido" };
    const api = apiFalsa([coleccionProducto([sembrado])], fallos);
    const pantalla = <ContenedorDetalleProducto id={sembrado.id} />;
    renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
});

=== web/src/contextos/producto/contenedores/detalle-producto.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { useAuth } from "../../../auth/auth";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleProducto } from "../vistas/detalle-producto";

export function ContenedorDetalleProducto({ id }: { id: string }) {
  const { api } = useDependencias();
  const { puede } = useAuth();
  const producto = useCarga(
    () => desenvolver(api.GET("/productos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/productos/{id}", { params: { path: { id } } }));
      navegar("/productos");
    } catch (error) {
      setFallo(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Producto</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {producto.estado === "cargando" && <span className="loading loading-spinner" />}
      {producto.estado === "error" && <AlertaError error={producto.error} />}
      {producto.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleProducto producto={producto.datos} />
            <div className="card-actions justify-end">
              <Link href={`/productos/${id}/editar`} className="btn">
                Editar
              </Link>
              {puede("admin") && puede("owner") && (
                <button
                  type="button"
                  className="btn btn-error"
                  onClick={() => setConfirmando(true)}
                >
                  Borrar
                </button>
              )}
            </div>
          </div>
        </div>
      )}
      <Link href="/productos" className="link">
        Volver a productos
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar producto?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/producto/contenedores/formulario-producto.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionProducto, MadreProducto } from "../../../pruebas/producto";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioProducto } from "./formulario-producto";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearProducto"]) {
  await screen.findByText("Guardar");
  escribir("Name", peticion.name);
  escribir("Sku", peticion.sku);
  escribir("Price", String(peticion.price));
  escribir("Status", peticion.status);
}

describe("ContenedorFormularioProducto", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const guardados = coleccionProducto();
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioProducto />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/productos/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/productos/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreProducto.aleatorio();
    const guardados = coleccionProducto([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorFormularioProducto id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/productos/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const codigo = "producto.validacion.invalido";
    const fallos = { "POST /productos": codigo };
    const api = apiFalsa([coleccionProducto()], fallos);
    renderizarPantalla(<ContenedorFormularioProducto />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir que los valores ya están en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const codigo = "producto.duplicado";
    const fallos = { "POST /productos": codigo };
    const api = apiFalsa([coleccionProducto()], fallos);
    renderizarPantalla(<ContenedorFormularioProducto />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(aProblema(codigo).texto);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreProducto.peticion();
    const codigo = "producto.name_invalido";
    const fallos = { "POST /productos": codigo };
    const api = apiFalsa([coleccionProducto()], fallos);
    renderizarPantalla(<ContenedorFormularioProducto />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Name");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/contextos/producto/contenedores/formulario-producto.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver } from "../../../api/http";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import {
  aFormularioProducto,
  aPeticionProducto,
  VistaFormularioProducto,
} from "../vistas/formulario-producto";

type Producto = Esquemas["DtoProducto"];

/** Crear, o editar con `id`: el formulario de productos. */
export function ContenedorFormularioProducto({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/productos/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear producto" : "Editar producto";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioProducto existente={existente.datos} />}
      <Link href={id === undefined ? "/productos" : `/productos/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioProducto({ existente }: { existente: Producto | null }) {
  const { api } = useDependencias();
  const [, navegar] = useLocation();
  const [valores, setValores] = useState(aFormularioProducto(existente));
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionProducto(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/productos", { body: cuerpo })
          : api.PUT("/productos/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/productos/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        <VistaFormularioProducto
          valores={valores}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

