import { describe, expect, test } from "bun:test";
import { screen, waitFor } from "@testing-library/react";
import { MadreUsuarioActual, pasarelaAuthFalsa } from "../pruebas/auth";
import { renderizarPantalla } from "../pruebas/renderizar";
import { PaginaAuthCallback } from "./auth-callback";

describe("PaginaAuthCallback", () => {
  test("debería volver a la página en la que empezó el inicio de sesión", async () => {
    // Preparar
    const auth = { ...pasarelaAuthFalsa(), completarLogin: async () => "/pedidos?pagina=2" };

    // Actuar
    const { historial } = renderizarPantalla(<PaginaAuthCallback />, { auth }, "/auth/callback");

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/pedidos?pagina=2"));
  });

  test("debería decir por qué cuando se rechaza la respuesta del proveedor", async () => {
    // Preparar
    const auth = {
      ...pasarelaAuthFalsa({ usuario: MadreUsuarioActual.aleatorio() }),
      completarLogin: () => Promise.reject(new Error("No matching state found in storage")),
    };

    // Actuar
    renderizarPantalla(<PaginaAuthCallback />, { auth }, "/auth/callback");

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(
      "No matching state found in storage",
    );
  });
});

=== web/src/paginas/auth-callback.tsx ===
import { useEffect, useRef, useState } from "react";
import { useLocation } from "wouter";
import { useAuth } from "../auth/auth";
import { AlertaError } from "../compartido/ui/alerta-error";

/** Adonde devuelve el proveedor a quien acaba de iniciar sesión (`redirect_uri`). */
export function PaginaAuthCallback() {
  const { completarLogin } = useAuth();
  const [, navegar] = useLocation();
  const [fallo, setFallo] = useState<unknown>(null);
  const empezado = useRef(false);

  useEffect(() => {
    // Una vez: StrictMode ejecuta los efectos dos veces, y la respuesta del proveedor solo se canjea una.
    if (empezado.current) return;
    empezado.current = true;
    completarLogin().then((vuelta) => navegar(vuelta, { replace: true }), setFallo);
  }, [completarLogin, navegar]);

  return fallo === null ? (
    <span className="loading loading-spinner" />
  ) : (
    <AlertaError error={fallo} />
  );
}

=== web/src/paginas/panel.tsx ===
import { Link } from "wouter";
import type { EntradaMenu } from "../compartido/ui/marco";
import { SinElementos } from "../compartido/ui/sin-elementos";
import { useCarga } from "../compartido/use-carga";
import { useDependencias } from "../dependencias";
import { marca } from "../marca/marca";

/** La API sirve su Swagger UI en su raíz (`make run`). */
const URL_DOCS_API = "http://localhost:8080/";

/** La página de inicio: una banda con la marca y, debajo, una fila con el total de cada sección. */
export function PaginaPanel({ entradas }: { entradas: EntradaMenu[] }) {
  return (
    <section className="space-y-6">
      <header className="rounded-box bg-primary p-8 text-primary-content">
        <h1 className="text-3xl font-bold">Panel</h1>
        <p className="opacity-80">{marca.eslogan}</p>
      </header>
      {entradas.length === 0 ? (
        <SinElementos mensaje="Todavía no hay entidades. Añade una con `puerto generar scaffold <Nombre>`." />
      ) : (
        <div className="stats stats-vertical w-full bg-base-100 shadow-sm lg:stats-horizontal">
          {entradas.map((entrada) => (
            <TarjetaTotal key={entrada.href} entrada={entrada} />
          ))}
        </div>
      )}
      <a className="link link-hover text-sm" href={URL_DOCS_API}>
        Documentación de la API (Swagger UI)
      </a>
    </section>
  );
}

function TarjetaTotal({ entrada }: { entrada: EntradaMenu }) {
  const dependencias = useDependencias();
  const total = useCarga(() => entrada.total(dependencias), [entrada, dependencias]);
  return (
    <Link href={entrada.href} className="stat transition hover:bg-base-200">
      <div className="stat-title">{entrada.etiqueta}</div>
      <div className="stat-value">
        {total.estado === "listo" ? (
          total.datos
        ) : total.estado === "cargando" ? (
          <span className="loading loading-dots" />
        ) : (
          "—"
        )}
      </div>
      <div className="stat-desc">Ver la lista</div>
    </Link>
  );
}

