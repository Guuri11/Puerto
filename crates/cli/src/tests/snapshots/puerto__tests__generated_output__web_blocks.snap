=== contextos/pedido/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_pedido::{
    actualizar_pedido::{ActualizarPedido, ParamsActualizarPedido},
    borrar_pedido::{BorrarPedido, ParamsBorrarPedido},
    crear_pedido::{CrearPedido, ParamsCrearPedido},
    listar_pedidos::{ListarPedidos, ParamsListarPedidos},
    obtener_pedido::{ObtenerPedido, ParamsObtenerPedido},
};
use dominio_pedido::modelo::IdPedido;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use puerto_web::auth::BearerAuth;
use puerto_web::requiere_rol;
use uuid::Uuid;

use crate::dto::{DtoPaginaPedido, DtoPedido, PeticionActualizarPedido, PeticionCrearPedido};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarPedido, RespuestaBorrarPedido, RespuestaCrearPedido, RespuestaListarPedidos,
    RespuestaObtenerPedido,
};

#[derive(Tags)]
enum ApiTags {
    Pedido,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiPedido {
    pub crear_pedido: Arc<dyn CrearPedido>,
    pub obtener_pedido: Arc<dyn ObtenerPedido>,
    pub listar_pedidos: Arc<dyn ListarPedidos>,
    pub actualizar_pedido: Arc<dyn ActualizarPedido>,
    pub borrar_pedido: Arc<dyn BorrarPedido>,
}

#[OpenApi]
impl ApiPedido {
    /// Crea: Pedido
    #[oai(path = "/pedidos", method = "post", tag = "ApiTags::Pedido")]
    async fn crear(
        &self,
        auth: BearerAuth,
        cuerpo: Json<PeticionCrearPedido>,
    ) -> RespuestaCrearPedido {
        match self
            .crear_pedido
            .ejecutar(ParamsCrearPedido {
                actor: auth.0,
                total: cuerpo.total,
            })
            .await
        {
            Ok(entidad) => RespuestaCrearPedido::Creado(Json(DtoPedido::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_pedido falló");
                RespuestaCrearPedido::from_status(status, error)
            }
        }
    }

    /// Obtiene: Pedido por id
    #[oai(path = "/pedidos/:id", method = "get", tag = "ApiTags::Pedido")]
    #[requiere_rol("admin")]
    async fn obtener(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaObtenerPedido {
        match self
            .obtener_pedido
            .ejecutar(ParamsObtenerPedido {
                actor: auth.0,
                id: IdPedido::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerPedido::Ok(Json(DtoPedido::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_pedido falló");
                RespuestaObtenerPedido::from_status(status, error)
            }
        }
    }

    /// Lista Pedidos, página a página (el dominio acota `limite`)
    #[oai(path = "/pedidos", method = "get", tag = "ApiTags::Pedido")]
    #[requiere_rol("admin")]
    async fn listar(
        &self,
        auth: BearerAuth,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
    ) -> RespuestaListarPedidos {
        match self
            .listar_pedidos
            .ejecutar(ParamsListarPedidos {
                actor: auth.0,
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
            })
            .await
        {
            Ok(pagina) => RespuestaListarPedidos::Ok(Json(DtoPaginaPedido::from_dominio(&pagina))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_pedidos falló");
                RespuestaListarPedidos::from_status(status, error)
            }
        }
    }

    /// Actualiza: Pedido
    #[oai(path = "/pedidos/:id", method = "put", tag = "ApiTags::Pedido")]
    async fn actualizar(
        &self,
        auth: BearerAuth,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarPedido>,
    ) -> RespuestaActualizarPedido {
        match self
            .actualizar_pedido
            .ejecutar(ParamsActualizarPedido {
                actor: auth.0,
                id: IdPedido::from_uuid(id.0),
                total: cuerpo.total,
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarPedido::Ok(Json(DtoPedido::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_pedido falló");
                RespuestaActualizarPedido::from_status(status, error)
            }
        }
    }

    /// Borra: Pedido
    #[oai(path = "/pedidos/:id", method = "delete", tag = "ApiTags::Pedido")]
    async fn borrar(&self, auth: BearerAuth, id: Path<Uuid>) -> RespuestaBorrarPedido {
        match self
            .borrar_pedido
            .ejecutar(ParamsBorrarPedido {
                actor: auth.0,
                id: IdPedido::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarPedido::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_pedido falló");
                RespuestaBorrarPedido::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_pedido::{
        actualizar_pedido::dobles::MockActualizarPedido, borrar_pedido::dobles::MockBorrarPedido,
        crear_pedido::dobles::MockCrearPedido, listar_pedidos::dobles::MockListarPedidos,
        obtener_pedido::dobles::MockObtenerPedido,
    };
    use dominio_pedido::errores::ErrorPedido;
    use dominio_pedido::pruebas::madres::MadrePedido;
    use poem::{EndpointExt, Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;
    use puerto_nucleo::auth::dobles::MadrePrincipal;
    use puerto_nucleo::auth::dobles::MockAutenticador;
    use puerto_nucleo::auth::{Autenticador, ErrorAuth};

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearPedido,
        obtener: MockObtenerPedido,
        listar: MockListarPedidos,
        actualizar: MockActualizarPedido,
        borrar: MockBorrarPedido,
    }

    /// Acepta `llamante` (con todos los roles que pide alguna ruta de esta API) y `nadie`
    /// (sin roles).
    fn autenticador() -> Arc<dyn Autenticador> {
        let mut doble = MockAutenticador::new();
        doble.expect_autenticar().returning(|token| match token {
            "llamante" => Ok(MadrePrincipal::new().con_roles(["admin"]).construir()),
            "nadie" => Ok(MadrePrincipal::aleatorio()),
            _ => Err(ErrorAuth::Invalido),
        });
        Arc::new(doble)
    }

    impl Dobles {
        /// Todas las peticiones, con sesión iniciada como `llamante`.
        fn cliente(self) -> TestClient<impl poem::Endpoint> {
            self.cliente_con(Some("Bearer llamante"))
        }

        /// `autorizacion`: la cabecera que envía cada petición; con `None` no se envía ninguna.
        fn cliente_con(self, autorizacion: Option<&str>) -> TestClient<impl poem::Endpoint> {
            let api = ApiPedido {
                crear_pedido: Arc::new(self.crear),
                obtener_pedido: Arc::new(self.obtener),
                listar_pedidos: Arc::new(self.listar),
                actualizar_pedido: Arc::new(self.actualizar),
                borrar_pedido: Arc::new(self.borrar),
            };
            let cliente = TestClient::new(
                Route::new()
                    .nest("/", OpenApiService::new(api, "test", "1.0"))
                    .data(autenticador()),
            );
            match autorizacion {
                Some(valor) => cliente.default_header("Authorization", valor),
                None => cliente,
            }
        }
    }

    fn peticion_crear() -> PeticionCrearPedido {
        PeticionCrearPedido { total: 42 }
    }

    fn peticion_actualizar() -> PeticionActualizarPedido {
        PeticionActualizarPedido { total: 42 }
    }

    fn ruta_elemento() -> String {
        format!("/pedidos/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_pedido() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadrePedido::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/pedidos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_pedido_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorPedido::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/pedidos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_pedido_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadrePedido::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_pedido_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorPedido::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_pedidos_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadrePedido::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/pedidos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/pedidos?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorPedido::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/pedidos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_pedido() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadrePedido::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_pedido_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorPedido::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_pedido() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_pedido_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorPedido::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_crea_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .post("/pedidos")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_obtiene_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles.cliente_con(None).get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_403_cuando_se_obtiene_sin_el_rol() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(Some("Bearer nadie"))
            .get(ruta_elemento())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::FORBIDDEN);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("auth.prohibido");
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_lista_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles.cliente_con(None).get("/pedidos").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_403_cuando_se_lista_sin_el_rol() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(Some("Bearer nadie"))
            .get("/pedidos")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::FORBIDDEN);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("auth.prohibido");
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_actualiza_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }

    #[tokio::test]
    async fn deberia_responder_401_cuando_se_borra_sin_token() {
        // Preparar — sin expectativas: nunca se llega al caso de uso
        let dobles = Dobles::default();

        // Actuar
        let respuesta = dobles
            .cliente_con(None)
            .delete(ruta_elemento())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNAUTHORIZED);
    }
}

=== contextos/producto/aplicacion/Cargo.toml ===
[package]
name = "aplicacion_producto"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_producto = { workspace = true }
puerto-nucleo = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_producto/pruebas"]

[dev-dependencies]
# Quien llama en los tests: `MadrePrincipal`, y el `MockAutenticador` de las rutas.
puerto-nucleo = { workspace = true, features = ["pruebas"] }
dominio_producto = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/producto/aplicacion/src/actualizar_producto.rs ===
use async_trait::async_trait;
use dominio_producto::errores::ErrorProducto;
use dominio_producto::modelo::{IdProducto, Producto, PropsProducto};
use dominio_producto::repositorio::RepositorioProducto;
use dominio_producto::valores::{Name, Status};
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsActualizarProducto {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub id: IdProducto,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
}

#[async_trait]
pub trait ActualizarProducto: Send + Sync {
    async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarProducto {}

        #[async_trait]
        impl ActualizarProducto for ActualizarProducto {
            async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto>;
        }
    }
}

pub struct ActualizarProductoImpl {
    pub repositorio: Arc<dyn RepositorioProducto>,
}

#[async_trait]
impl ActualizarProducto for ActualizarProductoImpl {
    #[tracing::instrument(name = "actualizar_producto", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsActualizarProducto) -> Result<Producto, ErrorProducto> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorProducto::NoEncontrado)?;
        let name = Name::new(params.name)?;
        let status = params.status.parse::<Status>()?;
        entidad.actualizar(PropsProducto {
            name,
            sku: params.sku,
            price: params.price,
            status,
        })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::{
        modelo::IdProducto, pruebas::madres::MadreProducto,
        repositorio::dobles::MockRepositorioProducto,
    };
    use puerto_nucleo::auth::dobles::MadrePrincipal;

    #[tokio::test]
    async fn deberia_actualizar_producto_cuando_los_parametros_son_validos() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let mut entidad = MadreProducto::aleatorio();
        // Lo que estaba guardado, distinto de lo que trae la actualización.
        entidad.sku = "original".to_string();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                actor: MadrePrincipal::aleatorio(),
                id: id_entidad,
                name: props.name.valor().to_string(),
                sku: props.sku,
                price: props.price,
                status: props.status.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert_eq!(
            resultado.unwrap().sku,
            MadreProducto::new().construir_props().sku
        );
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_producto_no_existe() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                actor: MadrePrincipal::aleatorio(),
                id: IdProducto::generar(),
                name: props.name.valor().to_string(),
                sku: props.sku,
                price: props.price,
                status: props.status.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_sku_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                actor: MadrePrincipal::aleatorio(),
                id: id_entidad,
                name: props.name.valor().to_string(),
                sku: "".to_string(),
                price: props.price,
                status: props.status.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "producto.validacion.sku_vacio"
        );
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_name_es_una_cadena_vacia() {
        // Preparar
        let props = MadreProducto::new().construir_props();
        let entidad = MadreProducto::aleatorio();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioProducto::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        let caso_de_uso = ActualizarProductoImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarProducto {
                actor: MadrePrincipal::aleatorio(),
                id: id_entidad,
                name: "".to_string(),
                sku: props.sku,
                price: props.price,
                status: props.status.as_str().to_string(),
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "producto.name_invalido");
    }
}

