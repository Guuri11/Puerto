import { describe, expect, test } from "bun:test";
import { MadreUsuarioActual } from "../../pruebas/auth";
import { iniciales } from "./avatar";

describe("iniciales", () => {
  test("debería tomar la primera letra de las dos primeras palabras del nombre", () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio({ nombre: "ana lozano pérez" });

    // Actuar
    const resultado = iniciales(usuario);

    // Comprobar
    expect(resultado).toBe("AL");
  });

  test("debería tomar la primera letra del email cuando no hay nombre", () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio({ nombre: null, email: "bea@example.com" });

    // Actuar
    const resultado = iniciales(usuario);

    // Comprobar
    expect(resultado).toBe("B");
  });

  test("debería mostrar una interrogación cuando no hay nombre ni email", () => {
    // Preparar
    const usuario = MadreUsuarioActual.aleatorio({ nombre: "  ", email: null });

    // Actuar
    const resultado = iniciales(usuario);

    // Comprobar
    expect(resultado).toBe("?");
  });
});

=== web/src/compartido/ui/avatar.tsx ===
import type { UsuarioActual } from "../../auth/sesion";

/** Las iniciales de quien tiene la sesión: de las dos primeras palabras de su nombre o, si no, de su email. */
export function iniciales(usuario: UsuarioActual): string {
  const palabras = (usuario.nombre ?? "").trim().split(/\s+/).filter(Boolean);
  const letras =
    palabras.length > 0
      ? palabras.slice(0, 2).map((palabra) => palabra[0])
      : [usuario.email?.[0] ?? "?"];
  return letras.join("").toUpperCase();
}

/** Un círculo con las iniciales de `usuario`; `className` le da el tamaño (`w-8 text-xs` por defecto). */
export function Avatar({
  usuario,
  className = "w-8 text-xs",
}: {
  usuario: UsuarioActual;
  className?: string;
}) {
  return (
    <span
      className={`inline-flex aspect-square items-center justify-center rounded-full bg-primary font-semibold text-primary-content ${className}`}
      aria-hidden="true"
    >
      {iniciales(usuario)}
    </span>
  );
}

