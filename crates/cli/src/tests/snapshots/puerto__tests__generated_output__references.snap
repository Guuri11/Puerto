use async_trait::async_trait;
use dominio_envio::errores::ErrorEnvio;
use dominio_envio::modelo::IdEnvio;
use dominio_envio::repositorio::RepositorioEnvio;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsBorrarEnvio {
    pub id: IdEnvio,
}

#[async_trait]
pub trait BorrarEnvio: Send + Sync {
    async fn ejecutar(&self, params: ParamsBorrarEnvio) -> Result<(), ErrorEnvio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub BorrarEnvio {}

        #[async_trait]
        impl BorrarEnvio for BorrarEnvio {
            async fn ejecutar(&self, params: ParamsBorrarEnvio) -> Result<(), ErrorEnvio>;
        }
    }
}

pub struct BorrarEnvioImpl {
    pub repositorio: Arc<dyn RepositorioEnvio>,
}

#[async_trait]
impl BorrarEnvio for BorrarEnvioImpl {
    #[tracing::instrument(name = "borrar_envio", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsBorrarEnvio) -> Result<(), ErrorEnvio> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorEnvio::NoEncontrado)?;
        entidad.borrar();
        self.repositorio.guardar(&entidad).await?;
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_envio::{
        modelo::IdEnvio, pruebas::madres::MadreEnvio, repositorio::dobles::MockRepositorioEnvio,
    };

