import { Link, useLocation, useSearch } from "wouter";
import { desenvolver, LIMITE_PAGINA_MAXIMO, TAMANO_PAGINA } from "../../../api/http";
import { etiquetasReferencia } from "../../../compartido/formularios";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { busquedaPagina, desplazamientoDeUrl, Paginacion } from "../../../compartido/ui/paginacion";
import { SinElementos } from "../../../compartido/ui/sin-elementos";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaListaEnvio } from "../vistas/lista-envio";

/** La primera página de cada entidad referenciada: las etiquetas de sus enlaces. */
const PRIMERA_PAGINA = { params: { query: { limite: LIMITE_PAGINA_MAXIMO } } };

/** La lista, página a página; la página va en la URL (`?pagina=2`): recargar y volver la mantienen. */
export function ContenedorListaEnvio() {
  const { api } = useDependencias();
  const [ubicacion, navegar] = useLocation();
  const desplazamiento = desplazamientoDeUrl(useSearch(), TAMANO_PAGINA);
  const irA = (siguiente: number) => navegar(ubicacion + busquedaPagina(siguiente, TAMANO_PAGINA));
  const consulta = { limite: TAMANO_PAGINA, desplazamiento };
  const envios = useCarga(
    () => desenvolver(api.GET("/envios", { params: { query: consulta } })),
    [api, desplazamiento],
  );
  const pedidos = useCarga(() => desenvolver(api.GET("/pedidos", PRIMERA_PAGINA)), [api]);
  const etiquetasPedido = etiquetasReferencia(pedidos, "id");
  const clientes = useCarga(() => desenvolver(api.GET("/clientes", PRIMERA_PAGINA)), [api]);
  const etiquetasCliente = etiquetasReferencia(clientes, "name");

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Envios</h1>
        <Link href="/envios/nuevo" className="btn btn-primary">
          Crear envio
        </Link>
      </div>
      {envios.estado === "cargando" && <span className="loading loading-spinner" />}
      {envios.estado === "error" && <AlertaError error={envios.error} />}
      {envios.estado === "listo" &&
        (envios.datos.total === 0 ? (
          <SinElementos mensaje="Todavía no hay envios." />
        ) : (
          <>
            <VistaListaEnvio
              envios={envios.datos.elementos}
              etiquetasPedido={etiquetasPedido}
              etiquetasCliente={etiquetasCliente}
            />
            <Paginacion
              total={envios.datos.total}
              limite={envios.datos.limite}
              desplazamiento={envios.datos.desplazamiento}
              alCambiarDesplazamiento={irA}
            />
          </>
        ))}
    </section>
  );
}

=== web/src/contextos/envio/mensajes.ts ===
/** Lo que una pantalla muestra de un error de la API: bajo el input del que trata, o en la alerta. */
export interface ProblemaEnvio {
  campo: string | null;
  texto: string;
}

/**
 * Los mensajes de los códigos de `errores.rs` del backend, generados de la misma lista. Un código que
 * no está aquí se muestra tal cual.
 */
const TEXTOS: Record<string, string> = {
  "envio.validacion.pedido_id_no_encontrado": "Pedido: no existe",
  "envio.validacion.destinatario_id_no_encontrado": "Destinatario: no existe",
  "envio.validacion.carrier_vacio": "Carrier: campo obligatorio",
  "envio.duplicado": "Pedido: ya está en uso",
  "envio.no_encontrado": "Ya no existe",
  "envio.repositorio": "No se ha podido guardar; inténtalo más tarde",
  "envio.desconocido": "Algo ha ido mal",
};

/** El input del que trata el código de cada campo. */
const CAMPOS: Record<string, string> = {
  "envio.validacion.pedido_id_no_encontrado": "pedidoId",
  "envio.validacion.destinatario_id_no_encontrado": "destinatarioId",
  "envio.validacion.carrier_vacio": "carrier",
  "envio.duplicado": "pedidoId",
};

export function aProblema(codigo: string): ProblemaEnvio {
  return { campo: CAMPOS[codigo] ?? null, texto: TEXTOS[codigo] ?? codigo };
}

