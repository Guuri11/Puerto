use async_trait::async_trait;
use dominio_cliente::modelo::IdCliente;
use dominio_envio::errores::ErrorEnvio;
use dominio_envio::modelo::Envio;
use dominio_envio::repositorio::{FiltroEnvio, RepositorioEnvio};
use dominio_pedido::modelo::IdPedido;
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarEnvios {
    pub pagina: PeticionPagina,
    /// Si se indica, solo envios con este `pedido_id`.
    pub pedido_id: Option<IdPedido>,
    /// Si se indica, solo envios con este `destinatario_id`.
    pub destinatario_id: Option<IdCliente>,
}

#[async_trait]
pub trait ListarEnvios: Send + Sync {
    async fn ejecutar(&self, params: ParamsListarEnvios) -> Result<Pagina<Envio>, ErrorEnvio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarEnvios {}

        #[async_trait]
        impl ListarEnvios for ListarEnvios {
            async fn ejecutar(&self, params: ParamsListarEnvios) -> Result<Pagina<Envio>, ErrorEnvio>;
        }
    }
}

pub struct ListarEnviosImpl {
    pub repositorio: Arc<dyn RepositorioEnvio>,
}

#[async_trait]
impl ListarEnvios for ListarEnviosImpl {
    #[tracing::instrument(name = "listar_envios", skip_all, err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsListarEnvios) -> Result<Pagina<Envio>, ErrorEnvio> {
        self.repositorio
            .buscar_todos(
                params.pagina,
                FiltroEnvio {
                    pedido_id: params.pedido_id,
                    destinatario_id: params.destinatario_id,
                },
            )
            .await
            .map_err(ErrorEnvio::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_cliente::modelo::IdCliente;
    use dominio_envio::{pruebas::madres::MadreEnvio, repositorio::dobles::MockRepositorioEnvio};
    use dominio_pedido::modelo::IdPedido;
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_envios() {
        let entidades = MadreEnvio::aleatorios(2);
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina, _| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarEnviosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEnvios {
                pagina: PeticionPagina::default(),
                pedido_id: None,
                destinatario_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_envios() {
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEnviosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEnvios {
                pagina: PeticionPagina::default(),
                pedido_id: None,
                destinatario_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina, _| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEnviosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEnvios {
                pagina: PeticionPagina::new(Some(5), Some(10)),
                pedido_id: None,
                destinatario_id: None,
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_al_repositorio() {
        let filtro = FiltroEnvio {
            pedido_id: Some(IdPedido::generar()),
            destinatario_id: Some(IdCliente::generar()),
        };
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(move |_, f| *f == filtro)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarEnviosImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarEnvios {
                pagina: PeticionPagina::default(),
                pedido_id: filtro.pedido_id,
                destinatario_id: filtro.destinatario_id,
            })
            .await;

        assert!(resultado.is_ok());
    }
}

