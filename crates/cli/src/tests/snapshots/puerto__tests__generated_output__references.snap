import type { Esquemas } from "../../../api/cliente";
import { EnlaceReferencia } from "../../../compartido/ui/enlace-referencia";

type Envio = Esquemas["DtoEnvio"];

/** `envio`, y cómo se cargan las etiquetas de lo que referencia, para sus enlaces. */
export function VistaDetalleEnvio({
  envio,
  etiquetaPedido,
  etiquetaCliente,
}: {
  envio: Envio;
  etiquetaPedido: (id: string) => Promise<string>;
  etiquetaCliente: (id: string) => Promise<string>;
}) {
  return (
    <dl className="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
      <dt className="font-semibold">Pedido</dt>
      <dd>
        <EnlaceReferencia ruta="/pedidos" id={envio.pedidoId} cargar={etiquetaPedido} />
      </dd>
      <dt className="font-semibold">Destinatario</dt>
      <dd>
        <EnlaceReferencia ruta="/clientes" id={envio.destinatarioId} cargar={etiquetaCliente} />
      </dd>
      <dt className="font-semibold">Carrier</dt>
      <dd>{envio.carrier}</dd>
    </dl>
  );
}

=== web/src/contextos/envio/vistas/formulario-envio.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { type OpcionReferencia, textoDe, textoOpcional } from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaEnvio } from "../mensajes";

type Envio = Esquemas["DtoEnvio"];
type PeticionEnvio = Esquemas["PeticionCrearEnvio"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioEnvio {
  pedidoId: string;
  destinatarioId: string;
  carrier: string;
}

/** Los inputs de `envio`, vacíos cuando todavía no hay ninguno. */
export function aFormularioEnvio(envio: Envio | null): ValoresFormularioEnvio {
  if (envio === null) {
    return {
      pedidoId: "",
      destinatarioId: "",
      carrier: "",
    };
  }
  return {
    pedidoId: envio.pedidoId,
    destinatarioId: textoDe(envio.destinatarioId),
    carrier: envio.carrier,
  };
}

/** Lo que ofrece el select de cada referencia. */
export interface OpcionesFormularioEnvio {
  pedidoId: OpcionReferencia[];
  destinatarioId: OpcionReferencia[];
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionEnvio(valores: ValoresFormularioEnvio): PeticionEnvio {
  return {
    pedidoId: valores.pedidoId,
    destinatarioId: textoOpcional(valores.destinatarioId),
    carrier: valores.carrier,
  };
}

export function VistaFormularioEnvio({
  valores,
  opciones,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioEnvio;
  opciones: OpcionesFormularioEnvio;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaEnvio | null;
  alCambiar: (valores: ValoresFormularioEnvio) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Pedido</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "pedidoId"}
          required
          value={valores.pedidoId}
          onChange={(event) => alCambiar({ ...valores, pedidoId: event.target.value })}
        >
          <option value="">Elige una opción</option>
          {opciones.pedidoId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="pedidoId" />
      <label className="fieldset">
        <span className="fieldset-legend">Destinatario</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "destinatarioId"}
          value={valores.destinatarioId}
          onChange={(event) => alCambiar({ ...valores, destinatarioId: event.target.value })}
        >
          <option value="">—</option>
          {opciones.destinatarioId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="destinatarioId" />
      <label className="fieldset">
        <span className="fieldset-legend">Carrier</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "carrier"}
          required
          value={valores.carrier}
          onChange={(event) => alCambiar({ ...valores, carrier: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="carrier" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/envio/vistas/lista-envio.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { EnlaceReferencia } from "../../../compartido/ui/enlace-referencia";

type Envio = Esquemas["DtoEnvio"];

/** Los `envios`, y la etiqueta de cada elemento que referencian, para sus enlaces. */
export function VistaListaEnvio({
  envios,
  etiquetasPedido,
  etiquetasCliente,
}: {
  envios: Envio[];
  etiquetasPedido: Map<string, string>;
  etiquetasCliente: Map<string, string>;
}) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Pedido</th>
            <th>Destinatario</th>
            <th>Carrier</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {envios.map((envio) => (
            <tr key={envio.id}>
              <td>
                <EnlaceReferencia ruta="/pedidos" id={envio.pedidoId} etiquetas={etiquetasPedido} />
              </td>
              <td>
                <EnlaceReferencia
                  ruta="/clientes"
                  id={envio.destinatarioId}
                  etiquetas={etiquetasCliente}
                />
              </td>
              <td>{envio.carrier}</td>
              <td className="text-right">
                <Link href={`/envios/${envio.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

