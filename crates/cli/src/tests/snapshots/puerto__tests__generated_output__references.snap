pub mod repositorio;

=== contextos/envio/infraestructura/src/repositorio.rs ===
use std::collections::HashMap;
use std::sync::{PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard};

use async_trait::async_trait;
use dominio_envio::{
    modelo::{Envio, IdEnvio},
    repositorio::{FiltroEnvio, RepositorioEnvio},
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

/// Guarda envios en la memoria del proceso: se pierden cuando el proceso se para.
/// Como el adaptador de Postgres, oculta las filas borradas y lista primero las más recientes;
/// un valor único que ya tiene otra fila viva es `Duplicado`.
/// Cubre el hueco hasta que haya base de datos (`puerto nuevo --db` genera repositorios Postgres).
#[derive(Default)]
pub struct RepositorioEnvioEnMemoria {
    filas: RwLock<HashMap<IdEnvio, Envio>>,
}

impl RepositorioEnvioEnMemoria {
    pub fn new() -> Self {
        Self::default()
    }

    // Un cerrojo envenenado significa que un escritor hizo panic; cada escritura es un solo
    // insert, así que el mapa sigue entero y se usa tal cual.
    fn leer(&self) -> RwLockReadGuard<'_, HashMap<IdEnvio, Envio>> {
        self.filas.read().unwrap_or_else(PoisonError::into_inner)
    }

    fn escribir(&self) -> RwLockWriteGuard<'_, HashMap<IdEnvio, Envio>> {
        self.filas.write().unwrap_or_else(PoisonError::into_inner)
    }
}

#[async_trait]
impl RepositorioEnvio for RepositorioEnvioEnMemoria {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroEnvio,
    ) -> Result<Pagina<Envio>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        let filas = self.leer();
        let mut vivos: Vec<&Envio> = filas
            .values()
            .filter(|fila| !fila.borrado)
            .filter(|fila| filtro.pedido_id.is_none_or(|id| fila.pedido_id == id))
            .filter(|fila| {
                filtro
                    .destinatario_id
                    .is_none_or(|id| fila.destinatario_id == Some(id))
            })
            .collect();
        vivos.sort_by(|a, b| {
            b.creado_en
                .cmp(&a.creado_en)
                .then_with(|| a.id.valor().cmp(&b.id.valor()))
        });
        let total = vivos.len() as u64;
        let elementos = vivos
            .into_iter()
            .skip(pagina.desplazamiento() as usize)
            .take(pagina.limite() as usize)
            .cloned()
            .collect();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdEnvio) -> Result<Option<Envio>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        Ok(self.leer().get(&id).filter(|fila| !fila.borrado).cloned())
    }

    async fn guardar(&self, entidad: &Envio) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let mut filas = self.escribir();
        // Como los índices únicos parciales: solo las filas vivas ocupan sus valores.
        let ocupado = !entidad.borrado
            && filas.values().any(|fila| {
                fila.id != entidad.id && !fila.borrado && fila.pedido_id == entidad.pedido_id
            });
        if ocupado {
            tracing::warn!(id = %entidad.id, "guardar rechazado: un valor único ya está ocupado");
            return Err(ErrorRepositorio::Duplicado);
        }
        filas.insert(entidad.id, entidad.clone());
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_cliente::modelo::IdCliente;
    use dominio_envio::modelo::PropsEnvio;
    use dominio_envio::pruebas::madres::MadreEnvio;
    use dominio_pedido::modelo::IdPedido;

    /// Una entidad válida, con los valores de la madre salvo en los campos únicos (uno
    /// nuevo cada vez) y las fechas (un segundo exacto).
    fn nuevo_envio() -> Envio {
        Envio::new(PropsEnvio {
            pedido_id: IdPedido::generar(),
            ..MadreEnvio::new().construir_props()
        })
        .unwrap()
    }

    #[tokio::test]
    async fn deberia_encontrar_envio_por_id_tras_guardar() {
        // Preparar
        let repositorio = RepositorioEnvioEnMemoria::new();
        let entidad = nuevo_envio();
        repositorio.guardar(&entidad).await.unwrap();

        // Actuar
        let encontrado = repositorio.buscar_por_id(entidad.id).await.unwrap();

        // Comprobar
        assert_eq!(encontrado.map(|fila| fila.id), Some(entidad.id));
    }

    #[tokio::test]
    async fn deberia_actualizar_la_fila_cuando_se_guarda_de_nuevo() {
        // Preparar
        let repositorio = RepositorioEnvioEnMemoria::new();
        let mut entidad = nuevo_envio();
        repositorio.guardar(&entidad).await.unwrap();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        repositorio.guardar(&entidad).await.unwrap();

        // Comprobar
        let pagina = repositorio
            .buscar_todos(PeticionPagina::default(), FiltroEnvio::default())
            .await
            .unwrap();
        assert_eq!(pagina.total, 1);
        assert_eq!(pagina.elementos[0].actualizado_en, entidad.actualizado_en);
    }

    #[tokio::test]
    async fn no_deberia_encontrar_envio_tras_su_borrado() {
        // Preparar
        let repositorio = RepositorioEnvioEnMemoria::new();
        let mut entidad = nuevo_envio();
        entidad.borrado = true;
        entidad.borrado_en = Some(entidad.actualizado_en);
        repositorio.guardar(&entidad).await.unwrap();

        // Actuar
        let encontrado = repositorio.buscar_por_id(entidad.id).await.unwrap();
        let pagina = repositorio
            .buscar_todos(PeticionPagina::default(), FiltroEnvio::default())
            .await
            .unwrap();

        // Comprobar
        assert!(encontrado.is_none());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor() {
        // Preparar
        let repositorio = RepositorioEnvioEnMemoria::new();
        for _ in 0..3 {
            repositorio.guardar(&nuevo_envio()).await.unwrap();
        }

        // Actuar
        let pagina = repositorio
            .buscar_todos(
                PeticionPagina::new(Some(2), Some(2)),
                FiltroEnvio::default(),
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[tokio::test]
    async fn deberia_rechazar_un_duplicado_de_pedido_id() {
        // Preparar
        let repositorio = RepositorioEnvioEnMemoria::new();
        let primero = nuevo_envio();
        repositorio.guardar(&primero).await.unwrap();
        let mut segundo = nuevo_envio();
        segundo.pedido_id = primero.pedido_id;

        // Actuar
        let resultado = repositorio.guardar(&segundo).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::Duplicado);
    }

    #[tokio::test]
    async fn deberia_listar_solo_envios_con_ese_valor_de_pedido_id() {
        // Preparar: una entidad envio con este valor de pedido_id y otra sin él.
        let repositorio = RepositorioEnvioEnMemoria::new();
        let pedido_id = IdPedido::generar();
        let mut esperado = nuevo_envio();
        esperado.pedido_id = pedido_id;
        repositorio.guardar(&esperado).await.unwrap();
        repositorio.guardar(&nuevo_envio()).await.unwrap();

        // Actuar
        let pagina = repositorio
            .buscar_todos(
                PeticionPagina::default(),
                FiltroEnvio {
                    pedido_id: Some(pedido_id),
                    destinatario_id: None,
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }

    #[tokio::test]
    async fn deberia_listar_solo_envios_con_ese_valor_de_destinatario_id() {
        // Preparar: una entidad envio con este valor de destinatario_id y otra sin él.
        let repositorio = RepositorioEnvioEnMemoria::new();
        let destinatario_id = IdCliente::generar();
        let mut esperado = nuevo_envio();
        esperado.destinatario_id = Some(destinatario_id);
        repositorio.guardar(&esperado).await.unwrap();
        repositorio.guardar(&nuevo_envio()).await.unwrap();

        // Actuar
        let pagina = repositorio
            .buscar_todos(
                PeticionPagina::default(),
                FiltroEnvio {
                    pedido_id: None,
                    destinatario_id: Some(destinatario_id),
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }
}

