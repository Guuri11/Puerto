import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCliente, MadreCliente } from "../../../pruebas/cliente";
import { coleccionEnvio, MadreEnvio } from "../../../pruebas/envio";
import { coleccionPedido, MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorDetalleEnvio } from "./detalle-envio";

describe("ContenedorDetalleEnvio", () => {
  test("debería mostrar el detalle cuando existe", async () => {
    // Preparar
    const sembrado = MadreEnvio.aleatorio();
    const api = apiFalsa([coleccionEnvio([sembrado])]);

    const pantalla = <ContenedorDetalleEnvio id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect(await screen.findByText("Editar")).toBeTruthy();
  });

  test("debería enlazar Pedido con su página y su etiqueta", async () => {
    // Preparar
    const sembrado = MadreEnvio.aleatorio();
    const objetivo = MadrePedido.aleatorio({ id: sembrado.pedidoId });
    const api = apiFalsa([coleccionEnvio([sembrado]), coleccionPedido([objetivo])]);
    const pantalla = <ContenedorDetalleEnvio id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/pedidos/${sembrado.pedidoId}"]`;
    expect(await screen.findByText(objetivo.id, { selector })).toBeTruthy();
  });

  test("debería enlazar Destinatario con su página y su etiqueta", async () => {
    // Preparar
    const sembrado = MadreEnvio.aleatorio();
    const objetivo = MadreCliente.aleatorio({ id: sembrado.destinatarioId ?? crypto.randomUUID() });
    const api = apiFalsa([coleccionEnvio([sembrado]), coleccionCliente([objetivo])]);
    const pantalla = <ContenedorDetalleEnvio id={sembrado.id} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/clientes/${sembrado.destinatarioId}"]`;
    expect(await screen.findByText(objetivo.name, { selector })).toBeTruthy();
  });

  test("debería mostrar el código de no encontrado cuando no existe", async () => {
    // Preparar
    const api = apiFalsa([coleccionEnvio()]);
    const pantalla = <ContenedorDetalleEnvio id={crypto.randomUUID()} />;

    // Actuar
    renderizarPantalla(pantalla, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("envio.no_encontrado");
  });

  test("debería borrar solo tras confirmar el borrado", async () => {
    // Preparar
    const sembrado = MadreEnvio.aleatorio();
    const guardados = coleccionEnvio([sembrado]);
    const api = apiFalsa([guardados]);
    const pantalla = <ContenedorDetalleEnvio id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });
    fireEvent.click(await screen.findByText("Borrar", { selector: ".card-actions button" }));
    expect(guardados.elementos.has(sembrado.id)).toBe(true);

    // Actuar
    fireEvent.click(screen.getByText("Borrar", { selector: ".modal-action button" }));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe("/envios"));
    expect(guardados.elementos.has(sembrado.id)).toBe(false);
  });
});

=== web/src/contextos/envio/contenedores/detalle-envio.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { desenvolver } from "../../../api/http";
import { AlertaError } from "../../../compartido/ui/alerta-error";
import { DialogoConfirmar } from "../../../compartido/ui/dialogo-confirmar";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { VistaDetalleEnvio } from "../vistas/detalle-envio";

export function ContenedorDetalleEnvio({ id }: { id: string }) {
  const { api } = useDependencias();
  const envio = useCarga(
    () => desenvolver(api.GET("/envios/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const [, navegar] = useLocation();
  const [confirmando, setConfirmando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);

  const borrar = async () => {
    setConfirmando(false);
    try {
      await desenvolver(api.DELETE("/envios/{id}", { params: { path: { id } } }));
      navegar("/envios");
    } catch (error) {
      setFallo(error);
    }
  };
  const etiquetaPedido = async (objetivo: string) => {
    const params = { path: { id: objetivo } };
    const encontrado = await desenvolver(api.GET("/pedidos/{id}", { params }));
    return encontrado.id;
  };
  const etiquetaCliente = async (objetivo: string) => {
    const params = { path: { id: objetivo } };
    const encontrado = await desenvolver(api.GET("/clientes/{id}", { params }));
    return encontrado.name;
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Envio</h1>
      {fallo !== null && <AlertaError error={fallo} />}
      {envio.estado === "cargando" && <span className="loading loading-spinner" />}
      {envio.estado === "error" && <AlertaError error={envio.error} />}
      {envio.estado === "listo" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <VistaDetalleEnvio
              envio={envio.datos}
              etiquetaPedido={etiquetaPedido}
              etiquetaCliente={etiquetaCliente}
            />
            <div className="card-actions justify-end">
              <Link href={`/envios/${id}/editar`} className="btn">
                Editar
              </Link>
              <button type="button" className="btn btn-error" onClick={() => setConfirmando(true)}>
                Borrar
              </button>
            </div>
          </div>
        </div>
      )}
      <Link href="/envios" className="link">
        Volver a envios
      </Link>
      <DialogoConfirmar
        abierto={confirmando}
        mensaje="¿Borrar envio?"
        alConfirmar={borrar}
        alCancelar={() => setConfirmando(false)}
      />
    </section>
  );
}

=== web/src/contextos/envio/contenedores/formulario-envio.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import type { Esquemas } from "../../../api/cliente";
import { textoDe } from "../../../compartido/formularios";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCliente, MadreCliente } from "../../../pruebas/cliente";
import { coleccionEnvio, MadreEnvio } from "../../../pruebas/envio";
import { coleccionPedido, MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { aProblema } from "../mensajes";
import { ContenedorFormularioEnvio } from "./formulario-envio";

function escribir(etiqueta: string, valor: string) {
  fireEvent.change(screen.getByLabelText(etiqueta), { target: { value: valor } });
}

/** Elige `id` en el select de una referencia, en cuanto se cargan sus objetivos. */
async function elegir(etiqueta: string, id: string) {
  const select = screen.getByLabelText(etiqueta);
  await waitFor(() => expect(select.querySelector(`option[value="${id}"]`)).not.toBeNull());
  fireEvent.change(select, { target: { value: id } });
}

/** Las colecciones que leen los selects, con lo que referencia `dueno`. */
function referenciadosPor(dueno: Partial<Esquemas["DtoEnvio"]>) {
  return [
    coleccionPedido([MadrePedido.aleatorio({ id: dueno.pedidoId ?? crypto.randomUUID() })]),
    coleccionCliente([MadreCliente.aleatorio({ id: dueno.destinatarioId ?? crypto.randomUUID() })]),
  ];
}

/** Rellena el formulario vacío con `peticion`, como lo haría quien lo usa. */
async function rellenar(peticion: Esquemas["PeticionCrearEnvio"]) {
  await screen.findByText("Guardar");
  await elegir("Pedido", peticion.pedidoId);
  await elegir("Destinatario", textoDe(peticion.destinatarioId));
  escribir("Carrier", peticion.carrier);
}

describe("ContenedorFormularioEnvio", () => {
  test("debería crear con lo escrito e ir a su detalle", async () => {
    // Preparar
    const peticion = MadreEnvio.peticion();
    const guardados = coleccionEnvio();
    const api = apiFalsa([guardados, ...referenciadosPor(peticion)]);
    const pantalla = <ContenedorFormularioEnvio />;
    const { historial } = renderizarPantalla(pantalla, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toStartWith("/envios/"));
    const [creado] = guardados.elementos.values();
    expect(creado).toMatchObject(peticion);
    expect(historial.at(-1)).toBe(`/envios/${creado?.id}`);
  });

  test("debería guardar la edición cuando se envía el formulario", async () => {
    // Preparar
    const sembrado = MadreEnvio.aleatorio();
    const guardados = coleccionEnvio([sembrado]);
    const api = apiFalsa([guardados, ...referenciadosPor(sembrado)]);
    const pantalla = <ContenedorFormularioEnvio id={sembrado.id} />;
    const { historial } = renderizarPantalla(pantalla, { api });

    // Actuar
    fireEvent.click(await screen.findByText("Guardar"));

    // Comprobar
    await waitFor(() => expect(historial.at(-1)).toBe(`/envios/${sembrado.id}`));
    expect(guardados.elementos.get(sembrado.id)).toEqual(sembrado);
  });

  test("debería mostrar el propio código cuando la API responde uno que el formulario no conoce", async () => {
    // Preparar
    const peticion = MadreEnvio.peticion();
    const codigo = "envio.validacion.invalido";
    const fallos = { "POST /envios": codigo };
    const api = apiFalsa([coleccionEnvio(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioEnvio />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe(codigo);
  });

  test("debería decir bajo su input que Pedido ya está en uso cuando la API responde un duplicado", async () => {
    // Preparar
    const peticion = MadreEnvio.peticion();
    const codigo = "envio.duplicado";
    const fallos = { "POST /envios": codigo };
    const api = apiFalsa([coleccionEnvio(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioEnvio />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Pedido");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });

  test("debería ofrecer cada pedido en sus selects", async () => {
    // Preparar
    const pedido = MadrePedido.aleatorio();
    const api = apiFalsa([coleccionPedido([pedido])]);

    // Actuar
    renderizarPantalla(<ContenedorFormularioEnvio />, { api });

    // Comprobar
    const opciones = await screen.findAllByRole("option", { name: pedido.id });
    expect(opciones).toHaveLength(1);
  });

  test("debería ofrecer cada cliente en sus selects", async () => {
    // Preparar
    const cliente = MadreCliente.aleatorio();
    const api = apiFalsa([coleccionCliente([cliente])]);

    // Actuar
    renderizarPantalla(<ContenedorFormularioEnvio />, { api });

    // Comprobar
    const opciones = await screen.findAllByRole("option", { name: cliente.name });
    expect(opciones).toHaveLength(1);
  });

  test("debería mostrar el mensaje bajo su input cuando la API rechaza un campo", async () => {
    // Preparar
    const peticion = MadreEnvio.peticion();
    const codigo = "envio.validacion.pedido_id_no_encontrado";
    const fallos = { "POST /envios": codigo };
    const api = apiFalsa([coleccionEnvio(), ...referenciadosPor(peticion)], fallos);
    renderizarPantalla(<ContenedorFormularioEnvio />, { api });
    await rellenar(peticion);

    // Actuar
    fireEvent.click(screen.getByText("Guardar"));

    // Comprobar
    expect(await screen.findByText(aProblema(codigo).texto)).toBeTruthy();
    const campo = screen.getByLabelText("Pedido");
    expect(campo.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });

  test("debería dejar elegido Pedido cuando la URL lo trae", async () => {
    // Preparar: «Comprar» desde Pedido lleva a `/envios/nuevo?pedidoId=…`
    const peticion = MadreEnvio.peticion();
    const api = apiFalsa([coleccionEnvio(), ...referenciadosPor(peticion)]);
    const ruta = `/envios/nuevo?pedidoId=${peticion.pedidoId}`;

    // Actuar
    renderizarPantalla(<ContenedorFormularioEnvio />, { api }, ruta);

    // Comprobar
    const select = (await screen.findByLabelText("Pedido")) as HTMLSelectElement;
    await waitFor(() => expect(select.value).toBe(peticion.pedidoId));
  });
});

=== web/src/contextos/envio/contenedores/formulario-envio.tsx ===
import { useState } from "react";
import { Link, useLocation, useSearch } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { desenvolver, LIMITE_PAGINA_MAXIMO } from "../../../api/http";
import { opcionesReferencia } from "../../../compartido/formularios";
import { AlertaError, codigoError } from "../../../compartido/ui/alerta-error";
import { useCarga } from "../../../compartido/use-carga";
import { useDependencias } from "../../../dependencias";
import { aProblema } from "../mensajes";
import { aFormularioEnvio, aPeticionEnvio, VistaFormularioEnvio } from "../vistas/formulario-envio";

type Envio = Esquemas["DtoEnvio"];

/** La primera página de cada entidad referenciada: lo que ofrecen sus selects. */
const PRIMERA_PAGINA = { params: { query: { limite: LIMITE_PAGINA_MAXIMO } } };

/** Crear, o editar con `id`: el formulario de envios. */
export function ContenedorFormularioEnvio({ id }: { id?: string }) {
  const { api } = useDependencias();
  const existente = useCarga(
    () =>
      id === undefined
        ? Promise.resolve(null)
        : desenvolver(api.GET("/envios/{id}", { params: { path: { id } } })),
    [api, id],
  );
  const titulo = id === undefined ? "Crear envio" : "Editar envio";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{titulo}</h1>
      {existente.estado === "cargando" && <span className="loading loading-spinner" />}
      {existente.estado === "error" && <AlertaError error={existente.error} />}
      {existente.estado === "listo" && <FormularioEnvio existente={existente.datos} />}
      <Link href={id === undefined ? "/envios" : `/envios/${id}`} className="link">
        Cancelar
      </Link>
    </section>
  );
}

function FormularioEnvio({ existente }: { existente: Envio | null }) {
  const { api } = useDependencias();
  const pedidos = useCarga(() => desenvolver(api.GET("/pedidos", PRIMERA_PAGINA)), [api]);
  const clientes = useCarga(() => desenvolver(api.GET("/clientes", PRIMERA_PAGINA)), [api]);
  const [, navegar] = useLocation();
  // 27.19: al crear, la referencia que trae la URL (`?pedidoId=…`) llega elegida.
  const desdeUrl = new URLSearchParams(useSearch());
  const [valores, setValores] = useState(() => {
    const iniciales = aFormularioEnvio(existente);
    if (existente !== null) return iniciales;
    return {
      ...iniciales,
      pedidoId: desdeUrl.get("pedidoId") ?? iniciales.pedidoId,
      destinatarioId: desdeUrl.get("destinatarioId") ?? iniciales.destinatarioId,
    };
  });
  const [guardando, setGuardando] = useState(false);
  const [fallo, setFallo] = useState<unknown>(null);
  const problema = fallo === null ? null : aProblema(codigoError(fallo));

  const guardar = async () => {
    setGuardando(true);
    setFallo(null);
    try {
      const cuerpo = aPeticionEnvio(valores);
      const guardado = await desenvolver(
        existente === null
          ? api.POST("/envios", { body: cuerpo })
          : api.PUT("/envios/{id}", { params: { path: { id: existente.id } }, body: cuerpo }),
      );
      navegar(`/envios/${guardado.id}`);
    } catch (error) {
      setFallo(error);
      setGuardando(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problema?.campo === null && <AlertaError error={fallo} mensaje={problema.texto} />}
        {pedidos.estado === "error" && <AlertaError error={pedidos.error} />}
        {clientes.estado === "error" && <AlertaError error={clientes.error} />}
        <VistaFormularioEnvio
          valores={valores}
          opciones={{
            pedidoId: opcionesReferencia(pedidos, (pedido) => pedido.id),
            destinatarioId: opcionesReferencia(clientes, (cliente) => cliente.name),
          }}
          guardando={guardando}
          problema={problema}
          alCambiar={setValores}
          alEnviar={guardar}
        />
      </div>
    </div>
  );
}

=== web/src/contextos/envio/contenedores/lista-envio.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { apiFalsa } from "../../../pruebas/api-falsa";
import { coleccionCliente, MadreCliente } from "../../../pruebas/cliente";
import { coleccionEnvio, MadreEnvio } from "../../../pruebas/envio";
import { coleccionPedido, MadrePedido } from "../../../pruebas/pedido";
import { renderizarPantalla } from "../../../pruebas/renderizar";
import { ContenedorListaEnvio } from "./lista-envio";

describe("ContenedorListaEnvio", () => {
  test("debería mostrar una fila por cada envio", async () => {
    // Preparar
    const semilla = [MadreEnvio.aleatorio(), MadreEnvio.aleatorio()];
    const api = apiFalsa([coleccionEnvio(semilla)]);

    // Actuar
    renderizarPantalla(<ContenedorListaEnvio />, { api });

    // Comprobar
    expect(await screen.findAllByText("Ver")).toHaveLength(2);
  });

  test("debería mostrar la página siguiente cuando se pulsa Siguiente", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreEnvio.aleatorio());
    const api = apiFalsa([coleccionEnvio(semilla)]);
    renderizarPantalla(<ContenedorListaEnvio />, { api });
    expect(await screen.findAllByText("Ver")).toHaveLength(20);

    // Actuar
    fireEvent.click(screen.getByRole("button", { name: "Siguiente" }));

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
    expect(screen.getAllByText("Ver")).toHaveLength(5);
  });

  test("debería abrir la página que nombra la URL", async () => {
    // Preparar
    const semilla = Array.from({ length: 25 }, () => MadreEnvio.aleatorio());
    const api = apiFalsa([coleccionEnvio(semilla)]);
    const ruta = "/envios?pagina=2";

    // Actuar
    renderizarPantalla(<ContenedorListaEnvio />, { api }, ruta);

    // Comprobar
    expect(await screen.findByText("21–25 de 25")).toBeTruthy();
  });

  test("debería decirlo cuando no hay envios", async () => {
    // Preparar
    const api = apiFalsa([coleccionEnvio()]);

    // Actuar
    renderizarPantalla(<ContenedorListaEnvio />, { api });

    // Comprobar
    expect(await screen.findByText("Todavía no hay envios.")).toBeTruthy();
  });

  test("debería mostrar el código del error cuando la API no da la lista", async () => {
    // Preparar
    const fallos = { "GET /envios": "envio.repositorio" };
    const api = apiFalsa([coleccionEnvio()], fallos);

    // Actuar
    renderizarPantalla(<ContenedorListaEnvio />, { api });

    // Comprobar
    expect((await screen.findByRole("alert")).textContent).toBe("envio.repositorio");
  });

  test("debería nombrar Pedido por su etiqueta", async () => {
    // Preparar
    const sembrado = MadreEnvio.aleatorio();
    const objetivo = MadrePedido.aleatorio({ id: sembrado.pedidoId });
    const api = apiFalsa([coleccionEnvio([sembrado]), coleccionPedido([objetivo])]);

    // Actuar
    renderizarPantalla(<ContenedorListaEnvio />, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/pedidos/${sembrado.pedidoId}"]`;
    expect(await screen.findByText(objetivo.id, { selector })).toBeTruthy();
  });

  test("debería nombrar Destinatario por su etiqueta", async () => {
    // Preparar
    const sembrado = MadreEnvio.aleatorio();
    const objetivo = MadreCliente.aleatorio({ id: sembrado.destinatarioId ?? crypto.randomUUID() });
    const api = apiFalsa([coleccionEnvio([sembrado]), coleccionCliente([objetivo])]);

    // Actuar
    renderizarPantalla(<ContenedorListaEnvio />, { api });

    // Comprobar: por su href; dos referencias al mismo objetivo pueden tener la misma etiqueta.
    const selector = `a[href="/clientes/${sembrado.destinatarioId}"]`;
    expect(await screen.findByText(objetivo.name, { selector })).toBeTruthy();
  });

  test("debería nombrar Pedido por su id cuando no se puede cargar", async () => {
    // Preparar: sin Pedido en la API falsa, su lista responde un 404.
    const sembrado = MadreEnvio.aleatorio();
    const api = apiFalsa([coleccionEnvio([sembrado])]);

    // Actuar
    renderizarPantalla(<ContenedorListaEnvio />, { api });

    // Comprobar
    const selector = `a[href="/pedidos/${sembrado.pedidoId}"]`;
    expect(await screen.findByText(`${sembrado.pedidoId}`, { selector })).toBeTruthy();
  });
});

