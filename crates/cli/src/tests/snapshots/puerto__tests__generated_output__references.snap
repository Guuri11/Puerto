use async_trait::async_trait;
use dominio_cliente::modelo::IdCliente;
use dominio_envio::errores::ErrorEnvio;
use dominio_envio::modelo::{Envio, PropsEnvio};
use dominio_envio::repositorio::RepositorioEnvio;
use dominio_pedido::modelo::IdPedido;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsCrearEnvio {
    pub pedido_id: IdPedido,
    pub destinatario_id: Option<IdCliente>,
    pub carrier: String,
}

#[async_trait]
pub trait CrearEnvio: Send + Sync {
    async fn ejecutar(&self, params: ParamsCrearEnvio) -> Result<Envio, ErrorEnvio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub CrearEnvio {}

        #[async_trait]
        impl CrearEnvio for CrearEnvio {
            async fn ejecutar(&self, params: ParamsCrearEnvio) -> Result<Envio, ErrorEnvio>;
        }
    }
}

pub struct CrearEnvioImpl {
    pub repositorio: Arc<dyn RepositorioEnvio>,
}

#[async_trait]
impl CrearEnvio for CrearEnvioImpl {
    #[tracing::instrument(name = "crear_envio", skip_all, err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsCrearEnvio) -> Result<Envio, ErrorEnvio> {
        let entidad = Envio::new(PropsEnvio {
            pedido_id: params.pedido_id,
            destinatario_id: params.destinatario_id,
            carrier: params.carrier,
        })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_envio::pruebas::madres::MadreEnvio;
    use dominio_envio::repositorio::dobles::MockRepositorioEnvio;
    use puerto_nucleo::ErrorRepositorio;

    #[tokio::test]
    async fn deberia_crear_envio_cuando_los_campos_son_validos() {
        // Preparar
        let props = MadreEnvio::new().construir_props();
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = CrearEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsCrearEnvio {
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: props.carrier,
            })
            .await;

        // Comprobar
        assert!(resultado.is_ok());
        assert_eq!(
            resultado.unwrap().carrier,
            MadreEnvio::new().construir_props().carrier
        );
    }

    #[tokio::test]
    async fn deberia_devolver_duplicado_cuando_el_almacen_rechaza_un_duplicado() {
        // Preparar
