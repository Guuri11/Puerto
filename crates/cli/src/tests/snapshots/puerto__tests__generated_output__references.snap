=== web/src/contextos/pedido/vistas/formulario-pedido.tsx ===
import type { Esquemas } from "../../../api/cliente";
import { type OpcionReferencia, textoDe, textoOpcional } from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaPedido } from "../mensajes";

type Pedido = Esquemas["DtoPedido"];
type PeticionPedido = Esquemas["PeticionCrearPedido"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioPedido {
  clienteId: string;
  reviewerId: string;
  total: string;
}

/** Los inputs de `pedido`, vacíos cuando todavía no hay ninguno. */
export function aFormularioPedido(pedido: Pedido | null): ValoresFormularioPedido {
  if (pedido === null) {
    return {
      clienteId: "",
      reviewerId: "",
      total: "",
    };
  }
  return {
    clienteId: pedido.clienteId,
    reviewerId: textoDe(pedido.reviewerId),
    total: String(pedido.total),
  };
}

/** Lo que ofrece el select de cada referencia. */
export interface OpcionesFormularioPedido {
  clienteId: OpcionReferencia[];
  reviewerId: OpcionReferencia[];
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionPedido(valores: ValoresFormularioPedido): PeticionPedido {
  return {
    clienteId: valores.clienteId,
    reviewerId: textoOpcional(valores.reviewerId),
    total: Number(valores.total),
  };
}

export function VistaFormularioPedido({
  valores,
  opciones,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioPedido;
  opciones: OpcionesFormularioPedido;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaPedido | null;
  alCambiar: (valores: ValoresFormularioPedido) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Cliente</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "clienteId"}
          required
          value={valores.clienteId}
          onChange={(event) => alCambiar({ ...valores, clienteId: event.target.value })}
        >
          <option value="">Elige una opción</option>
          {opciones.clienteId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="clienteId" />
      <label className="fieldset">
        <span className="fieldset-legend">Reviewer</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "reviewerId"}
          value={valores.reviewerId}
          onChange={(event) => alCambiar({ ...valores, reviewerId: event.target.value })}
        >
          <option value="">—</option>
          {opciones.reviewerId.map((opcion) => (
            <option key={opcion.id} value={opcion.id}>
              {opcion.etiqueta}
            </option>
          ))}
        </select>
      </label>
      <ErrorCampo problema={problema} campo="reviewerId" />
      <label className="fieldset">
        <span className="fieldset-legend">Total</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "total"}
          required
          value={valores.total}
          onChange={(event) => alCambiar({ ...valores, total: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="total" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/pedido/vistas/lista-pedido.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { EnlaceReferencia } from "../../../compartido/ui/enlace-referencia";

type Pedido = Esquemas["DtoPedido"];

/** Los `pedidos`, y la etiqueta de cada elemento que referencian, para sus enlaces. */
export function VistaListaPedido({
  pedidos,
  etiquetasCliente,
}: {
  pedidos: Pedido[];
  etiquetasCliente: Map<string, string>;
}) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Reviewer</th>
            <th>Total</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {pedidos.map((pedido) => (
            <tr key={pedido.id}>
              <td>
                <EnlaceReferencia
                  ruta="/clientes"
                  id={pedido.clienteId}
                  etiquetas={etiquetasCliente}
                />
              </td>
              <td>
                <EnlaceReferencia
                  ruta="/clientes"
                  id={pedido.reviewerId}
                  etiquetas={etiquetasCliente}
                />
              </td>
              <td>{pedido.total}</td>
              <td className="text-right">
                <Link href={`/pedidos/${pedido.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/generado/dependencias.ts ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//
// La raíz de composición: el único módulo que construye el cliente de la API. Las pantallas llegan
// a él con `useDependencias()`, así un test les da un falso.

import { type ClienteApi, crearClienteApi } from "../api/cliente";

export interface Dependencias {
  api: ClienteApi;
}

export function crearDependencias(): Dependencias {
  const api = crearClienteApi();
  return { api };
}

=== web/src/generado/rutas.tsx ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.

import { Route, Switch } from "wouter";
import { contarTotal, PAGINA_DE_UNO } from "../api/http";
import type { EntradaMenu } from "../compartido/ui/marco";
import { ContenedorDetalleCliente } from "../contextos/cliente/contenedores/detalle-cliente";
import { ContenedorFormularioCliente } from "../contextos/cliente/contenedores/formulario-cliente";
import { ContenedorListaCliente } from "../contextos/cliente/contenedores/lista-cliente";
import { ContenedorDetalleEnvio } from "../contextos/envio/contenedores/detalle-envio";
import { ContenedorFormularioEnvio } from "../contextos/envio/contenedores/formulario-envio";
import { ContenedorListaEnvio } from "../contextos/envio/contenedores/lista-envio";
import { ContenedorDetallePedido } from "../contextos/pedido/contenedores/detalle-pedido";
import { ContenedorFormularioPedido } from "../contextos/pedido/contenedores/formulario-pedido";
import { ContenedorListaPedido } from "../contextos/pedido/contenedores/lista-pedido";
import { PaginaNoEncontrada } from "../paginas/no-encontrada";
import { PaginaPanel } from "../paginas/panel";
import { rutasPropias } from "../rutas";

/** Dónde va la app: en la raíz o, con portada, en `[proyecto] ruta_app` (`puerto nuevo --portada`). */
export const rutaApp = "/";

export const entradasMenu: EntradaMenu[] = [
  {
    etiqueta: "Clientes",
    href: "/clientes",
    total: ({ api }) => contarTotal(api.GET("/clientes", PAGINA_DE_UNO)),
  },
  {
    etiqueta: "Envios",
    href: "/envios",
    total: ({ api }) => contarTotal(api.GET("/envios", PAGINA_DE_UNO)),
  },
  {
    etiqueta: "Pedidos",
    href: "/pedidos",
    total: ({ api }) => contarTotal(api.GET("/pedidos", PAGINA_DE_UNO)),
  },
];

export function RutasApp() {
  return (
    <Switch>
      <Route path="/">
        <PaginaPanel entradas={entradasMenu} />
      </Route>
      {rutasPropias}
      <Route path="/clientes">
        <ContenedorListaCliente />
      </Route>
      <Route path="/clientes/nuevo">
        <ContenedorFormularioCliente />
      </Route>
      <Route path="/clientes/:id/editar">
        {(params) => <ContenedorFormularioCliente id={params.id} />}
      </Route>
      <Route path="/clientes/:id">{(params) => <ContenedorDetalleCliente id={params.id} />}</Route>
      <Route path="/envios">
        <ContenedorListaEnvio />
      </Route>
      <Route path="/envios/nuevo">
        <ContenedorFormularioEnvio />
      </Route>
      <Route path="/envios/:id/editar">
        {(params) => <ContenedorFormularioEnvio id={params.id} />}
      </Route>
      <Route path="/envios/:id">{(params) => <ContenedorDetalleEnvio id={params.id} />}</Route>
      <Route path="/pedidos">
        <ContenedorListaPedido />
      </Route>
      <Route path="/pedidos/nuevo">
        <ContenedorFormularioPedido />
      </Route>
      <Route path="/pedidos/:id/editar">
        {(params) => <ContenedorFormularioPedido id={params.id} />}
      </Route>
      <Route path="/pedidos/:id">{(params) => <ContenedorDetallePedido id={params.id} />}</Route>
      <Route>
        <PaginaNoEncontrada />
      </Route>
    </Switch>
  );
}

=== web/src/pruebas/api-falsa.test.ts ===
import { describe, expect, test } from "bun:test";
import { coleccion, fetchFalso } from "./api-falsa";

function pedir(metodo: string, ruta: string) {
  return new Request(`http://localhost/api${ruta}`, { method: metodo });
}

function sembrarCosas() {
  return coleccion("/cosas", "cosa", [{ id: "1", estado: "Activa" }], {
    cancelar: { estado: "Cancelada" },
  });
}

describe("fetchFalso", () => {
  test("debería conservar al actualizar solo lo que la colección conserva", async () => {
    // Preparar
    const semilla: { id: string; codigo: string; nota?: string }[] = [
      { id: "1", codigo: "AB12", nota: "vieja" },
    ];
    const cosas = coleccion("/cosas", "cosa", semilla, {}, ["codigo"]);
    const pedido = new Request("http://localhost/api/cosas/1", { method: "PUT", body: "{}" });

    // Actuar
    const respuesta = await fetchFalso([cosas])(pedido);

    // Comprobar: `nota` no se mandó, así que queda vacía; `codigo` la pone la API.
    expect(respuesta.status).toBe(200);
    expect(cosas.elementos.get("1")).toEqual({ id: "1", codigo: "AB12" });
  });

  test("debería poner en el elemento los campos de la acción cuando se le pide", async () => {
    // Preparar
    const cosas = sembrarCosas();

    // Actuar
    const respuesta = await fetchFalso([cosas])(pedir("POST", "/cosas/1/cancelar"));

    // Comprobar
    expect(respuesta.status).toBe(200);
    expect(await respuesta.json()).toEqual({ id: "1", estado: "Cancelada" });
    expect(cosas.elementos.get("1")).toEqual({ id: "1", estado: "Cancelada" });
  });

  test("debería responder 404 cuando la acción no existe", async () => {
    // Preparar
    const cosas = sembrarCosas();

    // Actuar
    const respuesta = await fetchFalso([cosas])(pedir("POST", "/cosas/1/archivar"));

    // Comprobar
    expect(respuesta.status).toBe(404);
    expect(cosas.elementos.get("1")).toEqual({ id: "1", estado: "Activa" });
  });

  test("debería responder el fallo de la acción sin cambiar el elemento", async () => {
    // Preparar
    const cosas = sembrarCosas();
    const fallos = { "POST /cosas/{id}/cancelar": "cosa.validacion.ya_cancelada" };

    // Actuar
    const respuesta = await fetchFalso([cosas], fallos)(pedir("POST", "/cosas/1/cancelar"));

    // Comprobar
    expect((await respuesta.json()).codigo).toBe("cosa.validacion.ya_cancelada");
    expect(cosas.elementos.get("1")).toEqual({ id: "1", estado: "Activa" });
  });
});

=== web/src/pruebas/api-falsa.ts ===
import { type ClienteApi, crearClienteApi } from "../api/cliente";

/** Lo que guarda la API falsa bajo `ruta`: los DTO de la API, por id. */
export interface Coleccion<T extends { id: string }> {
  ruta: string;
  /** El código que responde un elemento que no está: `producto.no_encontrado`. */
  noEncontrado: string;
  elementos: Map<string, T>;
  /** Los campos que `POST <ruta>/{id}/<accion>` pone en el elemento, por acción. */
  acciones: Record<string, Partial<T>>;
  /** Lo que `PUT <ruta>/{id}` conserva aunque no se mande: los campos generados (27.17). */
  conservados: string[];
}

/**
 * Los elementos bajo `ruta` (`/productos`) de `entidad` (`producto`), empezando por `semilla`, las
 * `acciones` que entiende (`{ cancelar: { estado: "Cancelado" } }`) y los campos que actualizar
 * `conservados` (`["codigo"]`).
 */
export function coleccion<T extends { id: string }>(
  ruta: string,
  entidad: string,
  semilla: T[] = [],
  acciones: Record<string, Partial<T>> = {},
  conservados: string[] = [],
): Coleccion<T> {
  const elementos = new Map(semilla.map((elemento) => [elemento.id, elemento]));
  return { ruta, noEncontrado: `${entidad}.no_encontrado`, elementos, acciones, conservados };
}

/** Un `ClienteApi` sobre {@link fetchFalso}. */
export function apiFalsa(
  colecciones: Coleccion<{ id: string }>[],
  fallos: Record<string, string> = {},
): ClienteApi {
  return crearClienteApi({
    baseUrl: "http://localhost/api",
    fetch: fetchFalso(colecciones, fallos),
  });
}

/**
 * Un `fetch` que responde como la API generada, sobre colecciones en memoria: una página por
 * `limite` / `desplazamiento`, un `404` con `<entidad>.no_encontrado`, `201`, `200` y `204`, y
 * `200` con el elemento cambiado a una acción. Cada uno de `fallos` responde su código en su lugar:
 * `{ "POST /productos": "producto.duplicado" }` (también a las acciones), o solo el de una acción,
 * `{ "POST /productos/{id}/publicar": "producto.validacion.ya_publicado" }`.
 */
export function fetchFalso(
  colecciones: Coleccion<{ id: string }>[],
  fallos: Record<string, string> = {},
) {
  return async (peticion: Request): Promise<Response> => {
    const url = new URL(peticion.url);
    const ruta = url.pathname.replace(/^\/api/, "");
    const objetivo = colecciones.find((c) => ruta === c.ruta || ruta.startsWith(`${c.ruta}/`));
    if (objetivo === undefined) return responderError(404, "http.404");
    const [id = "", accion] = ruta.slice(objetivo.ruta.length + 1).split("/");
    const fallo =
      fallos[`${peticion.method} ${objetivo.ruta}/{id}/${accion}`] ??
      fallos[`${peticion.method} ${objetivo.ruta}`];
    if (fallo !== undefined) return responderError(400, fallo);
    if (accion !== undefined) return servirAccion(objetivo, peticion, id, accion);
    return id === ""
      ? servirLista(objetivo, peticion, url)
      : servirElemento(objetivo, peticion, id);
  };
}

async function servirLista(objetivo: Coleccion<{ id: string }>, peticion: Request, url: URL) {
  if (peticion.method === "POST") {
    const creado = { ...(await peticion.json()), id: crypto.randomUUID() };
    objetivo.elementos.set(creado.id, creado);
    return Response.json(creado, { status: 201 });
  }
  const limite = Number(url.searchParams.get("limite") ?? 20);
  const desplazamiento = Number(url.searchParams.get("desplazamiento") ?? 0);
  const todos = [...objetivo.elementos.values()];
  const elementos = todos.slice(desplazamiento, desplazamiento + limite);
  return Response.json({ elementos, total: todos.length, limite, desplazamiento });
}

async function servirElemento(objetivo: Coleccion<{ id: string }>, peticion: Request, id: string) {
  const encontrado = objetivo.elementos.get(id);
  if (encontrado === undefined) return responderError(404, objetivo.noEncontrado);
  if (peticion.method === "DELETE") {
    objetivo.elementos.delete(id);
    return new Response(null, { status: 204 });
  }
  if (peticion.method === "PUT") {
    // Como la API, actualizar reemplaza todos los campos: el que no se manda queda vacío, salvo
    // los que la API pone ella (los generados), que se conservan.
    const previo: Record<string, unknown> = encontrado;
    const conservado = Object.fromEntries(
      objetivo.conservados.map((campo) => [campo, previo[campo]]),
    );
    const actualizado = { ...conservado, ...(await peticion.json()), id };
    objetivo.elementos.set(id, actualizado);
    return Response.json(actualizado);
  }
  return Response.json(encontrado);
}

function servirAccion(
  objetivo: Coleccion<{ id: string }>,
  peticion: Request,
  id: string,
  accion: string,
) {
  const cambios = objetivo.acciones[accion];
  if (peticion.method !== "POST" || cambios === undefined) return responderError(404, "http.404");
  const encontrado = objetivo.elementos.get(id);
  if (encontrado === undefined) return responderError(404, objetivo.noEncontrado);
  const cambiado = { ...encontrado, ...cambios };
  objetivo.elementos.set(id, cambiado);
  return Response.json(cambiado);
}

/** Un `RespuestaError` como lo responde la API. */
function responderError(estado: number, codigo: string) {
  return Response.json({ codigo, mensaje: codigo }, { status: estado });
}

=== web/src/pruebas/cliente.ts ===
import type { Esquemas } from "../api/cliente";
import { coleccion } from "./api-falsa";

type Cliente = Esquemas["DtoCliente"];
type PeticionCliente = Esquemas["PeticionCrearCliente"];

/** Datos válidos de clientes; en `cambios`, los campos de los que trata el test. */
export const MadreCliente = {
  peticion(cambios: Partial<PeticionCliente> = {}): PeticionCliente {
    return {
      name: "example",
      email: "example",
      ...cambios,
    };
  },

  aleatorio(cambios: Partial<Cliente> = {}): Cliente {
    return { id: crypto.randomUUID(), ...MadreCliente.peticion(), ...cambios };
  },
};

/** El `/clientes` de la API falsa, con `semilla`. */
export function coleccionCliente(semilla: Cliente[] = []) {
  return coleccion("/clientes", "cliente", semilla);
}

