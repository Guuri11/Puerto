use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{IdPedido, Pedido};
use dominio_cliente::modelo::IdCliente;

/// A qué reduce `buscar_todos` la página: un id por referencia; `None` no filtra.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub struct FiltroPedido {
    pub cliente_id: Option<IdCliente>,
    pub reviewer_id: Option<IdCliente>,
}

#[async_trait]
pub trait RepositorioPedido: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroPedido,
    ) -> Result<Pagina<Pedido>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdPedido) -> Result<Option<Pedido>, ErrorRepositorio>;
    async fn guardar(&self, entidad: &Pedido) -> Result<(), ErrorRepositorio>;
}

#[cfg(any(test, feature = "pruebas"))]
