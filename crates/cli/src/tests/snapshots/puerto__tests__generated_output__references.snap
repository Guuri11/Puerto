use crate::valores::Name;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use crate::errores::ErrorCliente;

/// El id de cada `Cliente`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdCliente(Uuid);

impl IdCliente {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdCliente {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsCliente {
    pub name: Name,
    pub email: String,
}

#[derive(Debug, Clone)]
pub struct Cliente {
    pub id: IdCliente,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: Name,
    pub email: String,
}

impl Cliente {
    pub fn new(props: PropsCliente) -> Result<Self, ErrorCliente> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdCliente::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            name: props.name,
            email: props.email,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsCliente) -> Result<(), ErrorCliente> {
        Self::validar(&props)?;
        self.name = props.name;
        self.email = props.email;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Cliente) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsCliente) -> Result<(), ErrorCliente> {
        if props.email.trim().is_empty() {
            return Err(ErrorCliente::Validacion("email_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreCliente;

    #[test]
    fn deberia_crear_cliente_cuando_los_campos_son_validos() {
        let resultado = Cliente::new(MadreCliente::new().construir_props());
        assert_eq!(
            resultado.unwrap().email,
            MadreCliente::new().construir_props().email
        );
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_email_es_una_cadena_vacia() {
        let resultado = Cliente::new(MadreCliente::new().con_email_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cliente.validacion.email_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_email_solo_tiene_espacios() {
        let resultado = Cliente::new(MadreCliente::new().con_email("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_cliente_cuando_email_es_una_cadena_vacia() {
        let mut entidad = MadreCliente::aleatorio();
        let resultado = entidad.actualizar(MadreCliente::new().con_email_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cliente.validacion.email_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_name_es_una_cadena_vacia() {
        let resultado = Name::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "cliente.name_invalido");
    }

    #[test]
    fn deberia_marcar_cliente_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreCliente::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

=== contextos/cliente/dominio/src/pruebas/madres.rs ===
use crate::modelo::Cliente;
use crate::modelo::PropsCliente;
use crate::valores::Name;

pub struct MadreCliente {
    name: Option<Name>,
    email: Option<String>,
}

impl MadreCliente {
    pub fn new() -> Self {
        Self {
            name: None,
            email: None,
        }
    }

    pub fn con_name(mut self, name: Name) -> Self {
        self.name = Some(name);
        self
    }

    pub fn con_email(mut self, email: &str) -> Self {
        self.email = Some(email.to_string());
        self
    }

    pub fn con_email_vacio(mut self) -> Self {
        self.email = Some(String::new());
        self
    }

    pub fn construir(self) -> Cliente {
        Cliente::new(PropsCliente {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadreCliente: Cliente::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsCliente {
        PropsCliente {
            name: self.name.unwrap_or_else(|| {
                Name::new("example".to_string()).expect("Name::new rechazó el valor de ejemplo")
            }),
            email: self.email.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Cliente {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Cliente> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }

    /// Un `email` distinto en cada llamada, para las filas que guardan los tests de los
    /// repositorios (es único). Si una regla del dominio lo rechaza, cámbialo aquí.
    pub fn email_unico() -> String {
        uuid::Uuid::new_v4().simple().to_string()[..12].to_string()
    }
}

impl Default for MadreCliente {
    fn default() -> Self {
        Self::new()
    }
}

