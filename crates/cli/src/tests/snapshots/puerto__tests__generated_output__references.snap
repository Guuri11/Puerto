// La variante de éxito lleva el DTO entero, así que crece más que las de error a medida que la
// entidad gana campos. Una respuesta se construye una vez por petición y se devuelve: meter el DTO
// en un `Box` solo añadiría una reserva de memoria.
#![allow(clippy::large_enum_variant)]

use poem::http::StatusCode;
use poem_openapi::{ApiResponse, payload::Json};
use puerto_web::RespuestaError;

use crate::dto::{DtoEnvio, DtoPaginaEnvio};

#[derive(ApiResponse)]
pub enum RespuestaCrearEnvio {
    #[oai(status = 201)]
    Creado(Json<DtoEnvio>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaCrearEnvio {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaObtenerEnvio {
    #[oai(status = 200)]
    Ok(Json<DtoEnvio>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaObtenerEnvio {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaListarEnvios {
    #[oai(status = 200)]
    Ok(Json<DtoPaginaEnvio>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaListarEnvios {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaActualizarEnvio {
    #[oai(status = 200)]
    Ok(Json<DtoEnvio>),
    #[oai(status = 422)]
    NoProcesable(Json<RespuestaError>),
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 409)]
    Conflicto(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaActualizarEnvio {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNPROCESSABLE_ENTITY => Self::NoProcesable(error),
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            StatusCode::CONFLICT => Self::Conflicto(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

#[derive(ApiResponse)]
pub enum RespuestaBorrarEnvio {
    #[oai(status = 204)]
    SinContenido,
    #[oai(status = 401)]
    NoAutorizado(Json<RespuestaError>),
    #[oai(status = 403)]
    Prohibido(Json<RespuestaError>),
    #[oai(status = 404)]
    NoEncontrado(Json<RespuestaError>),
    #[oai(status = 500)]
    ErrorInterno(Json<RespuestaError>),
}

impl RespuestaBorrarEnvio {
    pub fn from_status(status: StatusCode, error: Json<RespuestaError>) -> Self {
        match status {
            StatusCode::UNAUTHORIZED => Self::NoAutorizado(error),
            StatusCode::FORBIDDEN => Self::Prohibido(error),
            StatusCode::NOT_FOUND => Self::NoEncontrado(error),
            _ => Self::ErrorInterno(error),
        }
    }
}

=== contextos/envio/rest/src/rutas.rs ===
use std::sync::Arc;

use aplicacion_envio::{
    actualizar_envio::{ActualizarEnvio, ParamsActualizarEnvio},
    borrar_envio::{BorrarEnvio, ParamsBorrarEnvio},
    crear_envio::{CrearEnvio, ParamsCrearEnvio},
    listar_envios::{ListarEnvios, ParamsListarEnvios},
    obtener_envio::{ObtenerEnvio, ParamsObtenerEnvio},
};
use dominio_cliente::modelo::IdCliente;
use dominio_envio::modelo::IdEnvio;
use dominio_pedido::modelo::IdPedido;
use poem_openapi::{
    OpenApi, Tags,
    param::{Path, Query},
    payload::Json,
};
use puerto_nucleo::PeticionPagina;
use uuid::Uuid;

use crate::dto::{DtoEnvio, DtoPaginaEnvio, PeticionActualizarEnvio, PeticionCrearEnvio};
use crate::errores::a_respuesta_error;
use crate::respuestas::{
    RespuestaActualizarEnvio, RespuestaBorrarEnvio, RespuestaCrearEnvio, RespuestaListarEnvios,
    RespuestaObtenerEnvio,
};

#[derive(Tags)]
enum ApiTags {
    Envio,
}

/// Guarda los puertos de los casos de uso; `generado/bootstrap.rs` conecta las implementaciones.
pub struct ApiEnvio {
    pub crear_envio: Arc<dyn CrearEnvio>,
    pub obtener_envio: Arc<dyn ObtenerEnvio>,
    pub listar_envios: Arc<dyn ListarEnvios>,
    pub actualizar_envio: Arc<dyn ActualizarEnvio>,
    pub borrar_envio: Arc<dyn BorrarEnvio>,
}

#[OpenApi]
impl ApiEnvio {
    /// Crea: Envio
    #[oai(path = "/envios", method = "post", tag = "ApiTags::Envio")]
    async fn crear(&self, cuerpo: Json<PeticionCrearEnvio>) -> RespuestaCrearEnvio {
        match self
            .crear_envio
            .ejecutar(ParamsCrearEnvio {
                pedido_id: IdPedido::from_uuid(cuerpo.pedido_id),
                destinatario_id: cuerpo.destinatario_id.map(IdCliente::from_uuid),
                carrier: cuerpo.carrier.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaCrearEnvio::Creado(Json(DtoEnvio::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "crear_envio falló");
                RespuestaCrearEnvio::from_status(status, error)
            }
        }
    }

    /// Obtiene: Envio por id
    #[oai(path = "/envios/:id", method = "get", tag = "ApiTags::Envio")]
    async fn obtener(&self, id: Path<Uuid>) -> RespuestaObtenerEnvio {
        match self
            .obtener_envio
            .ejecutar(ParamsObtenerEnvio {
                id: IdEnvio::from_uuid(id.0),
            })
            .await
        {
            Ok(entidad) => RespuestaObtenerEnvio::Ok(Json(DtoEnvio::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "obtener_envio falló");
                RespuestaObtenerEnvio::from_status(status, error)
            }
        }
    }

    /// Lista Envios, página a página (el dominio acota `limite`)
    #[oai(path = "/envios", method = "get", tag = "ApiTags::Envio")]
    async fn listar(
        &self,
        limite: Query<Option<u32>>,
        desplazamiento: Query<Option<u32>>,
        #[oai(name = "pedidoId")] pedido_id: Query<Option<Uuid>>,
        #[oai(name = "destinatarioId")] destinatario_id: Query<Option<Uuid>>,
    ) -> RespuestaListarEnvios {
        match self
            .listar_envios
            .ejecutar(ParamsListarEnvios {
                pagina: PeticionPagina::new(limite.0, desplazamiento.0),
                pedido_id: pedido_id.0.map(IdPedido::from_uuid),
                destinatario_id: destinatario_id.0.map(IdCliente::from_uuid),
            })
            .await
        {
            Ok(pagina) => RespuestaListarEnvios::Ok(Json(DtoPaginaEnvio::from_dominio(&pagina))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::error!(codigo = %error.0.codigo, "listar_envios falló");
                RespuestaListarEnvios::from_status(status, error)
            }
        }
    }

    /// Actualiza: Envio
    #[oai(path = "/envios/:id", method = "put", tag = "ApiTags::Envio")]
    async fn actualizar(
        &self,
        id: Path<Uuid>,
        cuerpo: Json<PeticionActualizarEnvio>,
    ) -> RespuestaActualizarEnvio {
        match self
            .actualizar_envio
            .ejecutar(ParamsActualizarEnvio {
                id: IdEnvio::from_uuid(id.0),
                pedido_id: IdPedido::from_uuid(cuerpo.pedido_id),
                destinatario_id: cuerpo.destinatario_id.map(IdCliente::from_uuid),
                carrier: cuerpo.carrier.clone(),
            })
            .await
        {
            Ok(entidad) => RespuestaActualizarEnvio::Ok(Json(DtoEnvio::from_dominio(&entidad))),
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "actualizar_envio falló");
                RespuestaActualizarEnvio::from_status(status, error)
            }
        }
    }

    /// Borra: Envio
    #[oai(path = "/envios/:id", method = "delete", tag = "ApiTags::Envio")]
    async fn borrar(&self, id: Path<Uuid>) -> RespuestaBorrarEnvio {
        match self
            .borrar_envio
            .ejecutar(ParamsBorrarEnvio {
                id: IdEnvio::from_uuid(id.0),
            })
            .await
        {
            Ok(()) => RespuestaBorrarEnvio::SinContenido,
            Err(err) => {
                let (status, error) = a_respuesta_error(err);
                tracing::warn!(codigo = %error.0.codigo, "borrar_envio falló");
                RespuestaBorrarEnvio::from_status(status, error)
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use aplicacion_envio::{
        actualizar_envio::dobles::MockActualizarEnvio, borrar_envio::dobles::MockBorrarEnvio,
        crear_envio::dobles::MockCrearEnvio, listar_envios::dobles::MockListarEnvios,
        obtener_envio::dobles::MockObtenerEnvio,
    };
    use dominio_envio::errores::ErrorEnvio;
    use dominio_envio::pruebas::madres::MadreEnvio;
    use poem::{Route, http::StatusCode, test::TestClient};
    use poem_openapi::{OpenApiService, types::ToJSON};
    use puerto_nucleo::Pagina;

    use super::*;

    /// Un doble por caso de uso. Cada test pone expectativas solo en el que su ruta debe llamar:
    /// una ruta que recurra a otro caso de uso entra en pánico en vez de pasar.
    #[derive(Default)]
    struct Dobles {
        crear: MockCrearEnvio,
        obtener: MockObtenerEnvio,
        listar: MockListarEnvios,
        actualizar: MockActualizarEnvio,
        borrar: MockBorrarEnvio,
    }

    impl Dobles {
        fn cliente(self) -> TestClient<Route> {
            let api = ApiEnvio {
                crear_envio: Arc::new(self.crear),
                obtener_envio: Arc::new(self.obtener),
                listar_envios: Arc::new(self.listar),
                actualizar_envio: Arc::new(self.actualizar),
                borrar_envio: Arc::new(self.borrar),
            };
            TestClient::new(Route::new().nest("/", OpenApiService::new(api, "test", "1.0")))
        }
    }

    fn peticion_crear() -> PeticionCrearEnvio {
        PeticionCrearEnvio {
            pedido_id: Uuid::new_v4(),
            destinatario_id: None,
            carrier: "example".to_string(),
        }
    }

    fn peticion_actualizar() -> PeticionActualizarEnvio {
        PeticionActualizarEnvio {
            pedido_id: Uuid::new_v4(),
            destinatario_id: None,
            carrier: "example".to_string(),
        }
    }

    fn ruta_elemento() -> String {
        format!("/envios/{}", Uuid::new_v4())
    }

    #[tokio::test]
    async fn deberia_responder_201_cuando_se_crea_envio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Ok(MadreEnvio::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/envios")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::CREATED);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_envio_no_supera_la_validacion() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .crear
            .expect_ejecutar()
            .returning(|_| Err(ErrorEnvio::Validacion("invalid".to_string())));

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/envios")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_no_existe_la_referencia_de_pedido_id() {
        // Preparar: en la base de datos no hay Pedido con ese id (ADR-0022 de Puerto).
        let mut dobles = Dobles::default();
        dobles.crear.expect_ejecutar().returning(|_| {
            Err(ErrorEnvio::Validacion(
                "pedido_id_no_encontrado".to_string(),
            ))
        });

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/envios")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("envio.validacion.pedido_id_no_encontrado");
    }

    #[tokio::test]
    async fn deberia_responder_422_cuando_no_existe_la_referencia_de_destinatario_id() {
        // Preparar: en la base de datos no hay Cliente con ese id (ADR-0022 de Puerto).
        let mut dobles = Dobles::default();
        dobles.crear.expect_ejecutar().returning(|_| {
            Err(ErrorEnvio::Validacion(
                "destinatario_id_no_encontrado".to_string(),
            ))
        });

        // Actuar
        let respuesta = dobles
            .cliente()
            .post("/envios")
            .body_json(&peticion_crear().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::UNPROCESSABLE_ENTITY);
        respuesta
            .json()
            .await
            .value()
            .object()
            .get("codigo")
            .assert_string("envio.validacion.destinatario_id_no_encontrado");
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_envio_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Ok(MadreEnvio::aleatorio()));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_envio_no_existe() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .obtener
            .expect_ejecutar()
            .returning(|_| Err(ErrorEnvio::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().get(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_200_con_una_pagina_de_envios_cuando_se_listan() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|params| Ok(Pagina::new(MadreEnvio::aleatorios(2), 7, params.pagina)));

        // Actuar
        let respuesta = dobles.cliente().get("/envios").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
        let json = respuesta.json().await;
        let cuerpo = json.value().object();
        cuerpo.get("elementos").array().assert_len(2);
        cuerpo.get("total").assert_i64(7);
    }

    #[tokio::test]
    async fn deberia_pasar_limite_y_desplazamiento_al_caso_de_uso() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(|params| params.pagina == PeticionPagina::new(Some(5), Some(10)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get("/envios?limite=5&desplazamiento=10")
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_por_pedido_id_al_caso_de_uso() {
        // Preparar
        let pedido_id = Uuid::new_v4();
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(move |params| params.pedido_id == Some(IdPedido::from_uuid(pedido_id)))
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get(format!("/envios?pedidoId={pedido_id}"))
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_por_destinatario_id_al_caso_de_uso() {
        // Preparar
        let destinatario_id = Uuid::new_v4();
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .withf(move |params| {
                params.destinatario_id == Some(IdCliente::from_uuid(destinatario_id))
            })
            .returning(|params| Ok(Pagina::new(vec![], 0, params.pagina)));

        // Actuar
        let respuesta = dobles
            .cliente()
            .get(format!("/envios?destinatarioId={destinatario_id}"))
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_500_cuando_el_listado_falla_en_el_repositorio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .listar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEnvio::Repositorio));

        // Actuar
        let respuesta = dobles.cliente().get("/envios").send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::INTERNAL_SERVER_ERROR);
    }

    #[tokio::test]
    async fn deberia_responder_200_cuando_se_actualiza_envio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Ok(MadreEnvio::aleatorio()));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::OK);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_actualiza_envio_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .actualizar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEnvio::NoEncontrado));

        // Actuar
        let respuesta = dobles
            .cliente()
            .put(ruta_elemento())
            .body_json(&peticion_actualizar().to_json())
            .send()
            .await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }

    #[tokio::test]
    async fn deberia_responder_204_cuando_se_borra_envio() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles.borrar.expect_ejecutar().returning(|_| Ok(()));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NO_CONTENT);
    }

    #[tokio::test]
    async fn deberia_responder_404_cuando_se_borra_envio_inexistente() {
        // Preparar
        let mut dobles = Dobles::default();
        dobles
            .borrar
            .expect_ejecutar()
            .returning(|_| Err(ErrorEnvio::NoEncontrado));

        // Actuar
        let respuesta = dobles.cliente().delete(ruta_elemento()).send().await;

        // Comprobar
        respuesta.assert_status(StatusCode::NOT_FOUND);
    }
}

