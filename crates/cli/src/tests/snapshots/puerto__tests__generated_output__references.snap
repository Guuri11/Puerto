use chrono::{DateTime, Utc};
use dominio_cliente::modelo::IdCliente;
use dominio_pedido::modelo::IdPedido;
use uuid::Uuid;

use crate::errores::ErrorEnvio;

/// El id de cada `Envio`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdEnvio(Uuid);

impl IdEnvio {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdEnvio {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsEnvio {
    pub pedido_id: IdPedido,
    pub destinatario_id: Option<IdCliente>,
    pub carrier: String,
}

#[derive(Debug, Clone)]
pub struct Envio {
    pub id: IdEnvio,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub pedido_id: IdPedido,
    pub destinatario_id: Option<IdCliente>,
    pub carrier: String,
}

impl Envio {
    pub fn new(props: PropsEnvio) -> Result<Self, ErrorEnvio> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdEnvio::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            pedido_id: props.pedido_id,
            destinatario_id: props.destinatario_id,
            carrier: props.carrier,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsEnvio) -> Result<(), ErrorEnvio> {
        Self::validar(&props)?;
        self.pedido_id = props.pedido_id;
        self.destinatario_id = props.destinatario_id;
        self.carrier = props.carrier;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    /// El borrado lógico: la fila se queda, marcada como borrada.
    pub fn borrar(&mut self) {
        let ahora = chrono::Utc::now();
        self.borrado = true;
        self.borrado_en = Some(ahora);
        self.actualizado_en = ahora;
    }

    pub fn from_repositorio(datos: Envio) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsEnvio) -> Result<(), ErrorEnvio> {
        if props.carrier.trim().is_empty() {
            return Err(ErrorEnvio::Validacion("carrier_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreEnvio;

    #[test]
    fn deberia_crear_envio_cuando_los_campos_son_validos() {
        let resultado = Envio::new(MadreEnvio::new().construir_props());
        assert_eq!(
            resultado.unwrap().carrier,
            MadreEnvio::new().construir_props().carrier
        );
    }

    #[test]
    fn deberia_rechazar_envio_cuando_carrier_es_una_cadena_vacia() {
        let resultado = Envio::new(MadreEnvio::new().con_carrier_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "envio.validacion.carrier_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_envio_cuando_carrier_solo_tiene_espacios() {
        let resultado = Envio::new(MadreEnvio::new().con_carrier("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_envio_cuando_carrier_es_una_cadena_vacia() {
        let mut entidad = MadreEnvio::aleatorio();
        let resultado = entidad.actualizar(MadreEnvio::new().con_carrier_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "envio.validacion.carrier_vacio"
        );
    }

    #[test]
    fn deberia_marcar_envio_como_borrado_cuando_se_borra() {
        // Preparar
        let mut entidad = MadreEnvio::aleatorio();

        // Actuar
        entidad.borrar();

        // Comprobar
        assert!(entidad.borrado);
        assert!(entidad.borrado_en.is_some());
    }
}

=== contextos/envio/dominio/src/pruebas/madres.rs ===
use crate::modelo::Envio;
use crate::modelo::PropsEnvio;
use dominio_cliente::modelo::IdCliente;
use dominio_pedido::modelo::IdPedido;

pub struct MadreEnvio {
    pedido_id: Option<IdPedido>,
    destinatario_id: Option<IdCliente>,
    carrier: Option<String>,
}

impl MadreEnvio {
    pub fn new() -> Self {
        Self {
            pedido_id: None,
            destinatario_id: None,
            carrier: None,
        }
    }

    pub fn con_pedido_id(mut self, pedido_id: IdPedido) -> Self {
        self.pedido_id = Some(pedido_id);
        self
    }

    pub fn con_destinatario_id(mut self, destinatario_id: IdCliente) -> Self {
        self.destinatario_id = Some(destinatario_id);
        self
    }

    pub fn con_carrier(mut self, carrier: &str) -> Self {
        self.carrier = Some(carrier.to_string());
        self
    }

    pub fn con_carrier_vacio(mut self) -> Self {
        self.carrier = Some(String::new());
        self
    }

    pub fn construir(self) -> Envio {
        Envio::new(PropsEnvio {
            pedido_id: self.pedido_id.unwrap_or_else(IdPedido::generar),
            destinatario_id: self.destinatario_id,
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        })
        .expect("MadreEnvio: Envio::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsEnvio {
        PropsEnvio {
            pedido_id: self.pedido_id.unwrap_or_else(IdPedido::generar),
            destinatario_id: self.destinatario_id,
            carrier: self.carrier.unwrap_or_else(|| "example".to_string()),
        }
    }

    pub fn aleatorio() -> Envio {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Envio> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreEnvio {
    fn default() -> Self {
        Self::new()
    }
}

