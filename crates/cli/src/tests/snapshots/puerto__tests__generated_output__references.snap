[package]
name = "aplicacion_envio"
version = "0.1.0"
edition = "2024"

[dependencies]
dominio_envio = { workspace = true }
puerto-nucleo = { workspace = true }
dominio_cliente = { workspace = true }
dominio_pedido = { workspace = true }
async-trait = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }
chrono = { workspace = true }
mockall = { workspace = true, optional = true }

[features]
# Los dobles de los casos de uso (`mock!`), para los tests de otros crates (ADR-0023 § 5 de
# Puerto).
pruebas = ["dep:mockall", "dominio_envio/pruebas"]

[dev-dependencies]
dominio_envio = { workspace = true, features = ["pruebas"] }
mockall = { workspace = true }
tokio = { workspace = true }

=== contextos/envio/aplicacion/src/actualizar_envio.rs ===
use async_trait::async_trait;
use dominio_cliente::modelo::IdCliente;
use dominio_envio::errores::ErrorEnvio;
use dominio_envio::modelo::{Envio, IdEnvio, PropsEnvio};
use dominio_envio::repositorio::RepositorioEnvio;
use dominio_pedido::modelo::IdPedido;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsActualizarEnvio {
    pub id: IdEnvio,
    pub pedido_id: IdPedido,
    pub destinatario_id: Option<IdCliente>,
    pub carrier: String,
}

#[async_trait]
pub trait ActualizarEnvio: Send + Sync {
    async fn ejecutar(&self, params: ParamsActualizarEnvio) -> Result<Envio, ErrorEnvio>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ActualizarEnvio {}

        #[async_trait]
        impl ActualizarEnvio for ActualizarEnvio {
            async fn ejecutar(&self, params: ParamsActualizarEnvio) -> Result<Envio, ErrorEnvio>;
        }
    }
}

pub struct ActualizarEnvioImpl {
    pub repositorio: Arc<dyn RepositorioEnvio>,
}

#[async_trait]
impl ActualizarEnvio for ActualizarEnvioImpl {
    #[tracing::instrument(name = "actualizar_envio", skip_all, fields(id = %params.id), err(level = "warn"))]
    async fn ejecutar(&self, params: ParamsActualizarEnvio) -> Result<Envio, ErrorEnvio> {
        let mut entidad = self
            .repositorio
            .buscar_por_id(params.id)
            .await?
            .ok_or(ErrorEnvio::NoEncontrado)?;
        entidad.actualizar(PropsEnvio {
            pedido_id: params.pedido_id,
            destinatario_id: params.destinatario_id,
            carrier: params.carrier,
        })?;
        self.repositorio.guardar(&entidad).await?;
        Ok(entidad)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_envio::{
        modelo::IdEnvio, pruebas::madres::MadreEnvio, repositorio::dobles::MockRepositorioEnvio,
    };

    #[tokio::test]
    async fn deberia_actualizar_envio_cuando_los_parametros_son_validos() {
        // Preparar
        let props = MadreEnvio::new().construir_props();
        let mut entidad = MadreEnvio::aleatorio();
        // Lo que estaba guardado, distinto de lo que trae la actualización.
        entidad.carrier = "original".to_string();
        let id_entidad = entidad.id;
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(move |_| Ok(Some(entidad.clone())));
        repositorio_doble.expect_guardar().returning(|_| Ok(()));
        let caso_de_uso = ActualizarEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarEnvio {
                id: id_entidad,
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: props.carrier,
            })
            .await;

        // Comprobar
        assert_eq!(
            resultado.unwrap().carrier,
            MadreEnvio::new().construir_props().carrier
        );
    }

    #[tokio::test]
    async fn deberia_devolver_no_encontrado_cuando_envio_no_existe() {
        // Preparar
        let props = MadreEnvio::new().construir_props();
        let mut repositorio_doble = MockRepositorioEnvio::new();
        repositorio_doble
            .expect_buscar_por_id()
            .returning(|_| Ok(None));
        let caso_de_uso = ActualizarEnvioImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        // Actuar
        let resultado = caso_de_uso
            .ejecutar(ParamsActualizarEnvio {
                id: IdEnvio::generar(),
                pedido_id: props.pedido_id,
                destinatario_id: props.destinatario_id,
                carrier: props.carrier,
            })
            .await;

        // Comprobar
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "envio.no_encontrado");
    }

    #[tokio::test]
    async fn deberia_devolver_error_cuando_carrier_es_una_cadena_vacia() {
        // Preparar
        let props = MadreEnvio::new().construir_props();
        let entidad = MadreEnvio::aleatorio();
