=== web/src/domain/auth/session.ts ===
/** The signed-in user as the API resolved them (`GET /me`): never the provider's own claims. */
export interface CurrentUser {
  id: string;
  email: string | null;
  name: string | null;
  /** What the API checks with `#[require_role]`. */
  roles: string[];
}

/**
 * Who is signed in, and how to sign in and out. The adapter talks to the provider (OIDC) or to
 * the API (local); screens reach it through `useAuth()`.
 */
export interface AuthGateway {
  /** The signed-in user, or `null` when nobody is. */
  currentUser(): Promise<CurrentUser | null>;
  /** The bearer token for the API, or `null` when nobody is signed in. */
  accessToken(): Promise<string | null>;
  /** Signs in, then comes back to `returnTo` (a path of this app). */
  login(returnTo: string): Promise<void>;
  /** Finishes a sign-in on `/auth/callback`; answers the path `login` was given. */
  completeLogin(): Promise<string>;
  logout(): Promise<void>;
}

/** A sign-in the provider or the API refused, or a `GET /me` that failed. */
export class AuthError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "AuthError";
    this.code = code;
  }
}

=== web/src/domain/product/errors.ts ===
/**
 * A request about a product that the API refused. `code` is the API's `ErrorResponse.name`:
 * `product.not_found`, `product.validation_error.<field>_empty`.
 */
export class ProductError extends Error {
  readonly code: string;

  constructor(code: string) {
    super(code);
    this.name = "ProductError";
    this.code = code;
  }
}

=== web/src/domain/product/messages.ts ===
import type { ProductDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface ProductProblem {
  field: keyof ProductDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "product.invalid_name": "Name is not valid",
  "product.invalid_sku": "Sku is not valid",
  "product.invalid_status": "Status is not valid",
  "product.duplicate": "A product with these values already exists",
  "product.not_found": "This product no longer exists",
  "product.repository_error": "The product could not be saved, try again later",
  "product.unknown": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof ProductDraft> = {
  "product.invalid_name": "name",
  "product.invalid_sku": "sku",
  "product.invalid_status": "status",
};

export function toProblem(code: string): ProductProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/domain/product/model.ts ===
import { ProductError } from "./errors";

export interface Product {
  id: string;
  name: string;
  sku: string;
  price: number;
  status: Status;
  tags: string[];
  releasedAt: string | null;
  meta: Record<string, string>;
}

/** What a create or an update sends: a product without its id. */
export type ProductDraft = Omit<Product, "id">;

export const statusValues = ["Draft", "Published"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `product.invalid_status`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new ProductError("product.invalid_status");
  return found;
}

=== web/src/domain/product/repository.ts ===
import type { Page, PageRequest } from "../shared/page";
import type { Product, ProductDraft } from "./model";

/** The port the screens call. Every method rejects with the `ProductError` the API answered. */
export interface ProductRepository {
  list(page: PageRequest): Promise<Page<Product>>;
  get(id: string): Promise<Product>;
  create(draft: ProductDraft): Promise<Product>;
  update(id: string, draft: ProductDraft): Promise<Product>;
  remove(id: string): Promise<void>;
}

