=== presentacion/worker/src/consumidores.rs ===
//! Un módulo por cada `[[consumidor]]` de puerto.toml: los añade `puerto generar consumidor`.
pub mod notify_new_producto;

=== presentacion/worker/src/consumidores/notify_new_producto.rs ===
//! `notify_new_producto`: reacciona a `producto_creado`, `producto_published`. Lo escribe una vez
//! `puerto generar consumidor`; desde entonces es tuyo.
//!
//! La entrega es al menos una vez: el mismo evento (el mismo `evento.id`) puede llegar dos veces,
//! tras una caída, un timeout o un redespliegue. Lo que haga esto debe ser **idempotente**:
//! comprueba si ya ocurrió (por `evento.id`) antes de volver a hacerlo.
//!
//! `Ack` cuando termina; `Reintentar` para un fallo que puede pasar (el worker vuelve a entregarlo
//! con una espera creciente y después lo descarta); `ResultadoManejo::descartar(…)` para uno que no
//! pasará nunca.

use async_trait::async_trait;
use dominio_producto::eventos::{PRODUCTO_CREADO, PRODUCTO_PUBLISHED, SnapshotProducto};
use puerto_nucleo::eventos::{
    MOTIVO_PAYLOAD_INVALIDO, ManejadorEvento, ResultadoManejo, SobreEvento,
};

pub struct NotifyNewProducto;

#[async_trait]
impl ManejadorEvento for NotifyNewProducto {
    async fn manejar(&self, evento: &SobreEvento) -> ResultadoManejo {
        match evento.tipo_evento.as_str() {
            PRODUCTO_CREADO => match evento.decodificar::<SnapshotProducto>() {
                Ok(producto) => {
                    tracing::info!(
                        id_evento = %evento.id,
                        id_producto = %producto.id,
                        "notify_new_producto: producto_creado"
                    );
                    ResultadoManejo::Ack
                }
                Err(err) => ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle),
            },
            PRODUCTO_PUBLISHED => match evento.decodificar::<SnapshotProducto>() {
                Ok(producto) => {
                    tracing::info!(
                        id_evento = %evento.id,
                        id_producto = %producto.id,
                        "notify_new_producto: producto_published"
                    );
                    ResultadoManejo::Ack
                }
                Err(err) => ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle),
            },
            // Sin suscripción (puerto.toml `[[consumidor]] eventos`): nada que hacer.
            _ => ResultadoManejo::Ack,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::eventos::EventoProducto;
    use dominio_producto::pruebas::madres::MadreProducto;

    fn producto_creado() -> SobreEvento {
        let snapshot = SnapshotProducto::from_entidad(&MadreProducto::aleatorio());
        SobreEvento::new(&EventoProducto::Creado(snapshot))
    }

    #[tokio::test]
    async fn deberia_hacer_ack_cuando_el_evento_producto_creado_es_valido() {
        // Preparar
        let evento = producto_creado();

        // Actuar
        let resultado = NotifyNewProducto.manejar(&evento).await;

        // Comprobar
        assert_eq!(resultado, ResultadoManejo::Ack);
    }

    #[tokio::test]
    async fn deberia_hacer_ack_otra_vez_cuando_el_mismo_evento_llega_dos_veces() {
        // Preparar
        let evento = producto_creado();

        // Actuar
        let primero = NotifyNewProducto.manejar(&evento).await;
        let segundo = NotifyNewProducto.manejar(&evento).await;

        // Comprobar
        assert_eq!(
            (primero, segundo),
            (ResultadoManejo::Ack, ResultadoManejo::Ack)
        );
    }

    #[tokio::test]
    async fn deberia_descartar_cuando_el_payload_esta_mal_formado() {
        // Preparar
        let mut evento = producto_creado();
        evento.payload = serde_json::json!({ "unexpected": true });

        // Actuar
        let resultado = NotifyNewProducto.manejar(&evento).await;

        // Comprobar
        assert!(
            matches!(
                resultado,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_PAYLOAD_INVALIDO,
                    ..
                }
            ),
            "{resultado:?}"
        );
    }
}

