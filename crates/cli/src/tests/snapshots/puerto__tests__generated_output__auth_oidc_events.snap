use async_trait::async_trait;
use dominio_producto::errores::ErrorProducto;
use dominio_producto::modelo::Producto;
use dominio_producto::repositorio::RepositorioProducto;
use dominio_producto::unit_of_work::UnitOfWorkFactoryProducto;
use puerto_nucleo::auth::Principal;
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsPublishProducto {
    /// Quien lo pide (ADR-0021). Una regla que depende de los datos ("solo edita el propietario")
    /// se decide aquí, sobre él, y responde `Prohibido`.
    pub actor: Principal,
    pub nombre: String,
}

#[async_trait]
pub trait PublishProducto: Send + Sync {
    async fn ejecutar(&self, params: ParamsPublishProducto) -> Result<Producto, ErrorProducto>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub PublishProducto {}

        #[async_trait]
        impl PublishProducto for PublishProducto {
            async fn ejecutar(&self, params: ParamsPublishProducto) -> Result<Producto, ErrorProducto>;
        }
    }
}

pub struct PublishProductoImpl {
    pub repositorio: Arc<dyn RepositorioProducto>,
    /// Las escrituras pasan por la unidad de trabajo: un método de la entidad emite el evento y
    /// `uow_factory.guardar(&entidad, evento)` guarda los dos juntos. El repositorio solo lee.
    pub uow_factory: Arc<dyn UnitOfWorkFactoryProducto>,
}

#[async_trait]
impl PublishProducto for PublishProductoImpl {
    // El span da nombre a los logs de lo que llama y registra el error que devuelve; `skip_all`:
    // los parámetros son datos del usuario y no van al log.
    #[tracing::instrument(name = "publish_producto", skip_all, err(level = "warn"))]
    async fn ejecutar(&self, _params: ParamsPublishProducto) -> Result<Producto, ErrorProducto> {
        todo!()
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::repositorio::dobles::MockRepositorioProducto;
    use dominio_producto::unit_of_work::dobles::UnitOfWorkFactoryGrabadora;

    #[tokio::test]
    #[ignore = "escribe este test"]
    async fn deberia_publish_producto_cuando_los_parametros_son_validos() {
        // Preparar
        let repositorio_doble = MockRepositorioProducto::new();
        let caso_de_uso = PublishProductoImpl {
            repositorio: Arc::new(repositorio_doble),
            uow_factory: Arc::new(UnitOfWorkFactoryGrabadora::new()),
        };

        // Actuar
        let _ = &caso_de_uso;

        // Comprobar
        todo!("llama a caso_de_uso.ejecutar(…) y comprueba el resultado")
    }
}

