import { describe, expect, test } from "bun:test";
import createClient from "openapi-fetch";
import { CurrentUserMother, fakeAuthGateway } from "../../test-support/auth";
import { bearerMiddleware } from "./bearer-middleware";

/** One endpoint is enough: the middleware does not look at the path. */
interface paths {
  "/me": { get: { responses: { 200: { content: { "application/json": unknown } } } } };
}

/** A client whose every request is answered with `status`, signed by `auth`. */
function answering(status: number, auth: ReturnType<typeof fakeAuthGateway>) {
  const requests: Request[] = [];
  const api = createClient<paths>({
    baseUrl: "http://localhost/api",
    fetch: async (request) => {
      requests.push(request);
      return Response.json({}, { status });
    },
  });
  api.use(bearerMiddleware(auth));
  return { api, requests };
}

describe("bearerMiddleware", () => {
  test("should send the user's token when someone is signed in", async () => {
    // Arrange
    const user = CurrentUserMother.random();
    const { api, requests } = answering(200, fakeAuthGateway({ user }));

    // Act
    await api.GET("/me");

    // Assert
    expect(requests[0]?.headers.get("Authorization")).toBe(`Bearer token-of-${user.id}`);
  });

  test("should send no token when nobody is signed in", async () => {
    // Arrange
    const { api, requests } = answering(200, fakeAuthGateway());

    // Act
    await api.GET("/me");

    // Assert
    expect(requests[0]?.headers.has("Authorization")).toBe(false);
  });

  test("should sign in again when the API answers 401", async () => {
    // Arrange
    const auth = fakeAuthGateway({ user: CurrentUserMother.random() });
    const { api } = answering(401, auth);

    // Act
    await api.GET("/me");

    // Assert
    expect(auth.logins).toHaveLength(1);
  });
});

=== web/src/infrastructure/auth/bearer-middleware.ts ===
import type { Middleware } from "openapi-fetch";
import type { AuthGateway } from "../../domain/auth/session";

/**
 * Signs every API call with the user's token; a `401` means the session is gone, so it signs in
 * again and comes back to the page it was on.
 */
export function bearerMiddleware(auth: AuthGateway): Middleware {
  return {
    async onRequest({ request }) {
      const token = await auth.accessToken();
      if (token !== null) request.headers.set("Authorization", `Bearer ${token}`);
      return request;
    },
    async onResponse({ response }) {
      if (response.status === 401) {
        void auth.login(window.location.pathname + window.location.search);
      }
      return response;
    },
  };
}

=== web/src/infrastructure/auth/oidc-auth-gateway.test.ts ===
import { describe, expect, test } from "bun:test";
import type { User } from "oidc-client-ts";
import { AuthError } from "../../domain/auth/session";
import { type OidcClient, oidcAuthGatewayOver, oidcSettingsFromEnv } from "./oidc-auth-gateway";

/** A client signed in with `user` (`null`: nobody); `redirects` records each redirect. */
function client(user: Partial<User> | null) {
  const redirects: unknown[] = [];
  const fake: OidcClient = {
    getUser: async () => user as User | null,
    signinRedirect: async (args) => {
      redirects.push(args);
    },
    signinRedirectCallback: async () => ({ state: "/orders" }) as User,
    signoutRedirect: async () => {},
  };
  return { fake, redirects };
}

/** A `/me` answering `status` and `body`; `requests` records what it was asked. */
function me(status: number, body: unknown) {
  const requests: { url: string; init: RequestInit }[] = [];
  const fetchMe = async (url: string, init: RequestInit) => {
    requests.push({ url, init });
    return Response.json(body, { status });
  };
  return { fetchMe, requests };
}

describe("oidcAuthGateway", () => {
  test("should ask the API who the token belongs to when someone is signed in", async () => {
    // Arrange
    const { fake } = client({ access_token: "abc", expired: false });
    const id = crypto.randomUUID();
    const { fetchMe, requests } = me(200, { id, email: "ada@example.com", roles: ["admin"] });

    // Act
    const user = await oidcAuthGatewayOver(fake, fetchMe).currentUser();

    // Assert
    expect(requests[0]?.url).toBe("/api/me");
    expect(requests[0]?.init.headers).toEqual({ Authorization: "Bearer abc" });
    expect(user).toEqual({ id, email: "ada@example.com", name: null, roles: ["admin"] });
  });

  test("should have no user and no token when the session expired", async () => {
    // Arrange
    const { fake } = client({ access_token: "abc", expired: true });
    const { fetchMe, requests } = me(200, {});
    const gateway = oidcAuthGatewayOver(fake, fetchMe);

    // Act
    const user = await gateway.currentUser();

    // Assert
    expect(user).toBeNull();
    expect(await gateway.accessToken()).toBeNull();
    expect(requests).toHaveLength(0);
  });

  test("should fail with the API's code when it refuses the token", async () => {
    // Arrange
    const { fake } = client({ access_token: "abc", expired: false });
    const code = "auth.unauthenticated";
    const { fetchMe } = me(401, { name: code, message: code });

    // Act
    const result = oidcAuthGatewayOver(fake, fetchMe).currentUser();

    // Assert
    await expect(result).rejects.toBeInstanceOf(AuthError);
    await expect(result).rejects.toMatchObject({ code });
  });

  test("should come back to the page the sign-in started on", async () => {
    // Arrange
    const { fake, redirects } = client(null);
    const gateway = oidcAuthGatewayOver(fake, me(200, {}).fetchMe);

    // Act
    await gateway.login("/orders");
    const back = await gateway.completeLogin();

    // Assert
    expect(redirects).toEqual([{ state: "/orders" }]);
    expect(back).toBe("/orders");
  });
});

describe("oidcSettingsFromEnv", () => {
  test("should name the missing variable when web/.env has no issuer", () => {
    // Act
    const read = () => oidcSettingsFromEnv({ VITE_AUTH_CLIENT_ID: "web" });

    // Assert
    expect(read).toThrow("VITE_AUTH_ISSUER is not set");
  });

  test("should leave the audience empty when it is not set", () => {
    // Act
    const settings = oidcSettingsFromEnv({
      VITE_AUTH_ISSUER: "http://localhost:8180/realms/shop",
      VITE_AUTH_CLIENT_ID: "web",
    });

    // Assert
    expect(settings.audience).toBe("");
  });
});

=== web/src/infrastructure/auth/oidc-auth-gateway.ts ===
import { InMemoryWebStorage, UserManager, WebStorageStateStore } from "oidc-client-ts";
import { AuthError, type AuthGateway, type CurrentUser } from "../../domain/auth/session";

/** Where the provider is and who this app is to it — `web/.env`. */
export interface OidcSettings {
  /** `VITE_AUTH_ISSUER`: Keycloak's realm URL, `https://<tenant>.auth0.com/`. */
  issuer: string;
  /** `VITE_AUTH_CLIENT_ID`: a public client, Authorization Code + PKCE. */
  clientId: string;
  /** `VITE_AUTH_AUDIENCE`: Auth0's API identifier. Empty for Keycloak, whose mapper adds it. */
  audience: string;
}

/** The settings from `web/.env`; a missing one is a startup error, not a redirect to nowhere. */
export function oidcSettingsFromEnv(env: Record<string, unknown> = import.meta.env): OidcSettings {
  const read = (name: string, required: boolean) => {
    const value = env[name];
    if (typeof value === "string" && value !== "") return value;
    if (required) throw new Error(`${name} is not set: copy web/.env.example to web/.env`);
    return "";
  };
  return {
    issuer: read("VITE_AUTH_ISSUER", true),
    clientId: read("VITE_AUTH_CLIENT_ID", true),
    audience: read("VITE_AUTH_AUDIENCE", false),
  };
}

/** What the gateway needs of `oidc-client-ts`'s `UserManager`. */
export type OidcClient = Pick<
  UserManager,
  "getUser" | "signinRedirect" | "signinRedirectCallback" | "signoutRedirect"
>;

/** `AuthGateway` over an OpenID Connect provider (Keycloak, Auth0): Authorization Code + PKCE. */
export function oidcAuthGateway(settings: OidcSettings): AuthGateway {
  const origin = window.location.origin;
  const client = new UserManager({
    authority: settings.issuer,
    client_id: settings.clientId,
    redirect_uri: `${origin}/auth/callback`,
    post_logout_redirect_uri: origin,
    scope: "openid profile email",
    // In memory, never in storage a script could read: a reload signs in again, through the
    // provider's own session (ADR-0021 § 5).
    userStore: new WebStorageStateStore({ store: new InMemoryWebStorage() }),
    extraQueryParams: settings.audience === "" ? {} : { audience: settings.audience },
  });
  return oidcAuthGatewayOver(client, (url, init) => fetch(url, init));
}

interface MeBody {
  id: string;
  email?: string | null;
  name?: string | null;
  roles: string[];
}

/** How the gateway asks the API for `/me`. */
export type FetchMe = (url: string, init: RequestInit) => Promise<Response>;

/** `ErrorResponse.name` of a failed `/me`, or `http.<status>` for a body that is not one. */
async function errorCode(response: Response): Promise<string> {
  const body: unknown = await response.json().catch(() => null);
  if (typeof body === "object" && body !== null && "name" in body) {
    const { name } = body;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

/** The gateway over any client and `fetch`: what the tests drive. */
export function oidcAuthGatewayOver(client: OidcClient, fetchMe: FetchMe): AuthGateway {
  const accessToken = async () => {
    const user = await client.getUser();
    return user === null || user.expired === true ? null : user.access_token;
  };
  return {
    accessToken,
    async currentUser(): Promise<CurrentUser | null> {
      const token = await accessToken();
      if (token === null) return null;
      // The API's view of the caller: its user id and the roles it checks.
      const response = await fetchMe("/api/me", { headers: { Authorization: `Bearer ${token}` } });
      if (!response.ok) throw new AuthError(await errorCode(response));
      const me = (await response.json()) as MeBody;
      return { id: me.id, email: me.email ?? null, name: me.name ?? null, roles: me.roles };
    },
    login: (returnTo) => client.signinRedirect({ state: returnTo }),
    async completeLogin() {
      const user = await client.signinRedirectCallback();
      return typeof user.state === "string" ? user.state : "/";
    },
    logout: () => client.signoutRedirect(),
  };
}

=== web/src/infrastructure/http/client.ts ===
import createClient, { type Client, type ClientOptions } from "openapi-fetch";
import type { paths } from "./schema";

/** The typed API client. `paths` is generated from the backend's spec (`make web/sync`). */
export type ApiClient = Client<paths>;

/** `/api` is the backend: proxied to `:8080` by Vite in development. */
export function createApiClient(options: ClientOptions = {}): ApiClient {
  return createClient<paths>({ baseUrl: "/api", ...options });
}

/**
 * The machine-readable code of a failed call: the `ErrorResponse.name` the API answered, or
 * `http.<status>` for a body that is not one (a proxy error, poem's own `400`).
 */
export function apiErrorCode(error: unknown, response: Response): string {
  if (typeof error === "object" && error !== null && "name" in error) {
    const { name } = error;
    if (typeof name === "string") return name;
  }
  return `http.${response.status}`;
}

