          {products.map((product) => (
            <tr key={product.id}>
              <td>{product.name}</td>
              <td>{product.sku}</td>
              <td>{product.price}</td>
              <td>{product.status}</td>
              <td>{product.tags.join(", ")}</td>
              <td>{product.releasedAt === null ? "—" : formatDateTime(product.releasedAt)}</td>
              <td>{formatEntries(product.meta, ", ")}</td>
              <td className="text-right">
                <Link href={`/products/${product.id}`} className="link">
                  View
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

