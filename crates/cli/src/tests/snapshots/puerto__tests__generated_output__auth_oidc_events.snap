=== web/src/presentation/core/auth.tsx ===
import {
  createContext,
  type ReactNode,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import { useLocation, useSearch } from "wouter";
import type { CurrentUser } from "../../domain/auth/session";
import { ErrorAlert } from "../shared/ui/error-alert";
import { useDependencies } from "./dependencies";

export interface Auth {
  /** The signed-in user, `null` when nobody is. */
  user: CurrentUser | null;
  /** Whether the user holds `role`. Screens hide what the API would refuse; the API still decides. */
  can(role: string): boolean;
  /** Signs in, then comes back to the current page. */
  login(): Promise<void>;
  logout(): Promise<void>;
  /** Finishes a sign-in (`/auth/callback`): answers the page to go back to. */
  completeLogin(): Promise<string>;
}

type State =
  | { status: "loading" }
  | { status: "ready"; user: CurrentUser | null }
  | { status: "error"; error: unknown };

const AuthContext = createContext<Auth | null>(null);

/** Asks the gateway who is signed in once, before rendering the app: no screen flickers. */
export function AuthProvider({ children }: { children: ReactNode }) {
  const { auth } = useDependencies();
  const [location] = useLocation();
  const search = useSearch();
  const [state, setState] = useState<State>({ status: "loading" });

  useEffect(() => {
    auth.currentUser().then(
      (user) => setState({ status: "ready", user }),
      (error: unknown) => setState({ status: "error", error }),
    );
  }, [auth]);

  const here = search === "" ? location : `${location}?${search}`;
  const login = useCallback(() => auth.login(here), [auth, here]);
  const completeLogin = useCallback(async () => {
    const back = await auth.completeLogin();
    setState({ status: "ready", user: await auth.currentUser() });
    return back;
  }, [auth]);
  const user = state.status === "ready" ? state.user : null;
  const value = useMemo<Auth>(
    () => ({
      user,
      can: (role) => user?.roles.includes(role) ?? false,
      login,
      logout: () => auth.logout(),
      completeLogin,
    }),
    [user, login, auth, completeLogin],
  );

  if (state.status === "loading") return <span className="loading loading-spinner" />;
  if (state.status === "error") return <ErrorAlert error={state.error} />;
  return <AuthContext value={value}>{children}</AuthContext>;
}

export function useAuth(): Auth {
  const auth = useContext(AuthContext);
  if (auth === null) {
    throw new Error("useAuth() called outside <AuthProvider>");
  }
  return auth;
}

/** Renders `children` for a signed-in user; anyone else is sent to sign in, and back here. */
export function RequireAuth({ children }: { children: ReactNode }) {
  const { user, login } = useAuth();
  const started = useRef(false);

  useEffect(() => {
    // Once: StrictMode runs effects twice.
    if (user !== null || started.current) return;
    started.current = true;
    void login();
  }, [user, login]);

  return user === null ? <span className="loading loading-spinner" /> : children;
}

