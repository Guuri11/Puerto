import { describe, expect, mock, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ProductoError } from "../../../../domain/producto/errors";
import { CurrentUserMother } from "../../../../test-support/auth";
import { fakeProductoRepository, ProductoMother } from "../../../../test-support/producto";
import { renderScreen } from "../../../../test-support/render";
import { ProductoDetailContainer } from "./producto-detail-container";

describe("ProductoDetailContainer", () => {
  test("should show the producto when it exists", async () => {
    // Arrange
    const seeded = ProductoMother.random();
    const productoRepository = fakeProductoRepository([seeded]);

    // Act
    renderScreen(<ProductoDetailContainer id={seeded.id} />, { productoRepository });

    // Assert
    expect(await screen.findByText("Edit")).toBeTruthy();
  });

  test("should show the not-found code when the producto does not exist", async () => {
    // Arrange
    const productoRepository = fakeProductoRepository();

    // Act
    renderScreen(<ProductoDetailContainer id={crypto.randomUUID()} />, {
      productoRepository,
    });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("producto.no_encontrado");
  });

  test("should delete the producto only once the deletion is confirmed", async () => {
    // Arrange
    const seeded = ProductoMother.random();
    const fake = fakeProductoRepository([seeded]);
    const remove = mock(fake.remove);
    const { history } = renderScreen(<ProductoDetailContainer id={seeded.id} />, {
      productoRepository: { ...fake, remove },
    });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));
    expect(remove).not.toHaveBeenCalled();

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe("/productos"));
    expect(remove).toHaveBeenCalledWith(seeded.id);
  });

  test("should not offer Delete to a user without its role", async () => {
    // Arrange
    const seeded = ProductoMother.random();
    const productoRepository = fakeProductoRepository([seeded]);
    const user = CurrentUserMother.random();

    // Act
    renderScreen(<ProductoDetailContainer id={seeded.id} />, { productoRepository }, "/", { user });

    // Assert
    expect(await screen.findByText("Name", { selector: "dt" })).toBeTruthy();
    expect(screen.queryByText("Delete", { selector: ".card-actions *" })).toBeNull();
  });

  test("should show auth.prohibido when the API refuses the deletion", async () => {
    // Arrange
    const seeded = ProductoMother.random();
    const productoRepository = {
      ...fakeProductoRepository([seeded]),
      remove: () => Promise.reject(new ProductoError("auth.prohibido")),
    };
    renderScreen(<ProductoDetailContainer id={seeded.id} />, { productoRepository });
    fireEvent.click(await screen.findByText("Delete", { selector: ".card-actions button" }));

    // Act
    fireEvent.click(screen.getByText("Delete", { selector: ".modal-action button" }));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("auth.prohibido");
  });
});

=== web/src/presentation/features/producto/containers/producto-detail-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { useAuth } from "../../../core/auth";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ConfirmDialog } from "../../../shared/ui/confirm-dialog";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { ProductoDetailView } from "../views/producto-detail-view";

export function ProductoDetailContainer({ id }: { id: string }) {
  const { productoRepository } = useDependencies();
  const { can } = useAuth();
  const producto = useAsync(() => productoRepository.get(id), [productoRepository, id]);
  const [, navigate] = useLocation();
  const [confirming, setConfirming] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);

  const remove = async () => {
    setConfirming(false);
    try {
      await productoRepository.remove(id);
      navigate("/productos");
    } catch (error) {
      setFailure(error);
    }
  };

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">Producto</h1>
      {failure !== null && <ErrorAlert error={failure} />}
      {producto.status === "loading" && <span className="loading loading-spinner" />}
      {producto.status === "error" && <ErrorAlert error={producto.error} />}
      {producto.status === "ok" && (
        <div className="card bg-base-100">
          <div className="card-body">
            <ProductoDetailView producto={producto.data} />
            <div className="card-actions justify-end">
              <Link href={`/productos/${id}/edit`} className="btn">
                Edit
              </Link>
              {can("admin") && (
                <button type="button" className="btn btn-error" onClick={() => setConfirming(true)}>
                  Delete
                </button>
              )}
            </div>
          </div>
        </div>
      )}
      <Link href="/productos" className="link">
        Back to productos
      </Link>
      <ConfirmDialog
        open={confirming}
        message="Delete this producto?"
        onConfirm={remove}
        onCancel={() => setConfirming(false)}
      />
    </section>
  );
}

=== web/src/presentation/features/producto/containers/producto-form-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ProductoError } from "../../../../domain/producto/errors";
import type { ProductoDraft } from "../../../../domain/producto/model";
import { fakeProductoRepository, ProductoMother } from "../../../../test-support/producto";
import { renderScreen } from "../../../../test-support/render";
import { formatEntries, toDateTimeLocal } from "../../../shared/forms";
import { ProductoFormContainer } from "./producto-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ProductoDraft) {
  await screen.findByText("Save");
  type("Name", draft.name);
  type("Sku", draft.sku);
  type("Price", String(draft.price));
  type("Status", draft.status);
  type("Tags", draft.tags.join(", "));
  type("Released at", toDateTimeLocal(draft.releasedAt));
  type("Meta", formatEntries(draft.meta));
}

describe("ProductoFormContainer", () => {
  test("should create the producto from what was typed and show it", async () => {
    // Arrange
    const draft = ProductoMother.draft();
    const productoRepository = fakeProductoRepository();
    const { history } = renderScreen(<ProductoFormContainer />, { productoRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/productos/"));
    const {
      items: [created],
    } = await productoRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/productos/${created?.id}`);
  });

  test("should save the edited producto when an existing one is submitted", async () => {
    // Arrange
    const seeded = ProductoMother.random();
    const productoRepository = fakeProductoRepository([seeded]);
    const { history } = renderScreen(<ProductoFormContainer id={seeded.id} />, {
      productoRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/productos/${seeded.id}`));
    expect(await productoRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "producto.validacion.invalid";
    const productoRepository = {
      ...fakeProductoRepository(),
      create: () => Promise.reject(new ProductoError(code)),
    };
    renderScreen(<ProductoFormContainer />, { productoRepository });
    await fillIn(ProductoMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a producto with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const productoRepository = {
      ...fakeProductoRepository(),
      create: () => Promise.reject(new ProductoError("producto.duplicado")),
    };
    renderScreen(<ProductoFormContainer />, { productoRepository });
    await fillIn(ProductoMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A producto with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const productoRepository = {
      ...fakeProductoRepository(),
      create: () => Promise.reject(new ProductoError("producto.name_invalido")),
    };
    renderScreen(<ProductoFormContainer />, { productoRepository });
    await fillIn(ProductoMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Name is not valid")).toBeTruthy();
    const input = screen.getByLabelText("Name");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/producto/containers/producto-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/producto/messages";
import type { Producto } from "../../../../domain/producto/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { ProductoFormView, toProductoDraft, toProductoForm } from "../views/producto-form-view";

/** Creates a producto, or edits the one with `id`. */
export function ProductoFormContainer({ id }: { id?: string }) {
  const { productoRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : productoRepository.get(id)),
    [productoRepository, id],
  );
  const title = id === undefined ? "New producto" : "Edit producto";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ProductoForm existing={existing.data} />}
      <Link href={id === undefined ? "/productos" : `/productos/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ProductoForm({ existing }: { existing: Producto | null }) {
  const { productoRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toProductoForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toProductoDraft(values);
      const saved =
        existing === null
          ? await productoRepository.create(draft)
          : await productoRepository.update(existing.id, draft);
      navigate(`/productos/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <ProductoFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

