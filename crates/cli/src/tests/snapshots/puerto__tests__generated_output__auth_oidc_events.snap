import type { ProductoDraft } from "./model";

/** What a screen shows for an API error: under the input it is about, or in the alert. */
export interface ProductoProblem {
  field: keyof ProductoDraft | null;
  text: string;
}

/**
 * The messages for the codes of the backend's `errors.rs`, generated from the same list. English:
 * this file is the place to translate them. A code missing here shows as it is.
 */
const TEXTS: Record<string, string> = {
  "producto.name_invalido": "Name is not valid",
  "producto.sku_invalido": "Sku is not valid",
  "producto.status_invalido": "Status is not valid",
  "producto.duplicado": "A producto with these values already exists",
  "producto.no_encontrado": "This producto no longer exists",
  "producto.repositorio": "The producto could not be saved, try again later",
  "producto.desconocido": "Something went wrong",
};

/** The input each field's code is about. */
const FIELDS: Record<string, keyof ProductoDraft> = {
  "producto.name_invalido": "name",
  "producto.sku_invalido": "sku",
  "producto.status_invalido": "status",
};

export function toProblem(code: string): ProductoProblem {
  return { field: FIELDS[code] ?? null, text: TEXTS[code] ?? code };
}

=== web/src/domain/producto/model.ts ===
import { ProductoError } from "./errors";

export interface Producto {
  id: string;
  name: string;
  sku: string;
  price: number;
  status: Status;
  tags: string[];
  releasedAt: string | null;
  meta: Record<string, string>;
}

/** What a create or an update sends: a producto without its id. */
export type ProductoDraft = Omit<Producto, "id">;

export const statusValues = ["Draft", "Published"] as const;

export type Status = (typeof statusValues)[number];

/** Narrows the API's `string` to a `Status`, rejecting with `producto.status_invalido`. */
export function parseStatus(value: string): Status {
  const found = statusValues.find((candidate) => candidate === value);
  if (found === undefined) throw new ProductoError("producto.status_invalido");
  return found;
}

