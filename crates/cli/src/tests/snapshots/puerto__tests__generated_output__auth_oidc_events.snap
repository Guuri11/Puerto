=== web/src/contextos/producto/vistas/formulario-producto.tsx ===
import type { Esquemas } from "../../../api/cliente";
import {
  aFechaHoraLocal,
  fechaHoraOpcional,
  formatearEntradas,
  leerEntradas,
  separarLista,
} from "../../../compartido/formularios";
import { ErrorCampo } from "../../../compartido/ui/error-campo";
import type { ProblemaProducto } from "../mensajes";

type Producto = Esquemas["DtoProducto"];
type PeticionProducto = Esquemas["PeticionCrearProducto"];

/** Lo que guardan los inputs: el texto de cada input, `checked` en una casilla. */
export interface ValoresFormularioProducto {
  name: string;
  sku: string;
  price: string;
  status: string;
  tags: string;
  releasedAt: string;
  meta: string;
}

/** Los inputs de `producto`, vacíos cuando todavía no hay ninguno. */
export function aFormularioProducto(producto: Producto | null): ValoresFormularioProducto {
  if (producto === null) {
    return {
      name: "",
      sku: "",
      price: "",
      status: "",
      tags: "",
      releasedAt: "",
      meta: "",
    };
  }
  return {
    name: producto.name,
    sku: producto.sku,
    price: String(producto.price),
    status: producto.status,
    tags: producto.tags.join(", "),
    releasedAt: aFechaHoraLocal(producto.releasedAt),
    meta: formatearEntradas(producto.meta),
  };
}

/** Lo que mandan crear y actualizar: los mismos campos en los dos. */
export function aPeticionProducto(valores: ValoresFormularioProducto): PeticionProducto {
  return {
    name: valores.name,
    sku: valores.sku,
    price: Number(valores.price),
    status: valores.status,
    tags: separarLista(valores.tags),
    releasedAt: fechaHoraOpcional(valores.releasedAt),
    meta: leerEntradas(valores.meta),
  };
}

export function VistaFormularioProducto({
  valores,
  guardando,
  problema,
  alCambiar,
  alEnviar,
}: {
  valores: ValoresFormularioProducto;
  guardando: boolean;
  /** Lo que dijo la API del último envío: se muestra bajo su input. */
  problema: ProblemaProducto | null;
  alCambiar: (valores: ValoresFormularioProducto) => void;
  alEnviar: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        alEnviar();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "name"}
          required
          value={valores.name}
          onChange={(event) => alCambiar({ ...valores, name: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "sku"}
          required
          value={valores.sku}
          onChange={(event) => alCambiar({ ...valores, sku: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="sku" />
      <label className="fieldset">
        <span className="fieldset-legend">Price</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problema?.campo === "price"}
          required
          value={valores.price}
          onChange={(event) => alCambiar({ ...valores, price: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="price" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problema?.campo === "status"}
          required
          value={valores.status}
          onChange={(event) => alCambiar({ ...valores, status: event.target.value })}
        >
          <option value="">Elige una opción</option>
          <option value="Draft">Draft</option>
          <option value="Published">Published</option>
        </select>
      </label>
      <ErrorCampo problema={problema} campo="status" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problema?.campo === "tags"}
          value={valores.tags}
          onChange={(event) => alCambiar({ ...valores, tags: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Released at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problema?.campo === "releasedAt"}
          value={valores.releasedAt}
          onChange={(event) => alCambiar({ ...valores, releasedAt: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="releasedAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Meta</span>
        <textarea
          className="textarea w-full"
          aria-invalid={problema?.campo === "meta"}
          placeholder="clave=valor, una por línea"
          value={valores.meta}
          onChange={(event) => alCambiar({ ...valores, meta: event.target.value })}
        />
      </label>
      <ErrorCampo problema={problema} campo="meta" />
      <button type="submit" className="btn btn-primary" disabled={guardando}>
        Guardar
      </button>
    </form>
  );
}

=== web/src/contextos/producto/vistas/lista-producto.tsx ===
import { Link } from "wouter";
import type { Esquemas } from "../../../api/cliente";
import { formatearEntradas, formatearFechaHora } from "../../../compartido/formularios";

type Producto = Esquemas["DtoProducto"];

export function VistaListaProducto({ productos }: { productos: Producto[] }) {
  return (
    <div className="overflow-x-auto rounded-box bg-base-100">
      <table className="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Sku</th>
            <th>Price</th>
            <th>Status</th>
            <th>Tags</th>
            <th>Released at</th>
            <th>Meta</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {productos.map((producto) => (
            <tr key={producto.id}>
              <td>{producto.name}</td>
              <td>{producto.sku}</td>
              <td>{producto.price}</td>
              <td>{producto.status}</td>
              <td>{producto.tags.join(", ")}</td>
              <td>{producto.releasedAt == null ? "—" : formatearFechaHora(producto.releasedAt)}</td>
              <td>{formatearEntradas(producto.meta, ", ")}</td>
              <td className="text-right">
                <Link href={`/productos/${producto.id}`} className="link">
                  Ver
                </Link>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

=== web/src/generado/dependencias.ts ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//
// La raíz de composición: el único módulo que construye el cliente de la API. Las pantallas llegan
// a él con `useDependencias()`, así un test les da un falso.

import { type ClienteApi, crearClienteApi } from "../api/cliente";
import { middlewareBearer } from "../auth/middleware-bearer";
import { ajustesOidcDeEntorno, pasarelaOidc } from "../auth/pasarela-oidc";
import type { PasarelaAuth } from "../auth/sesion";

export interface Dependencias {
  api: ClienteApi;
  auth: PasarelaAuth;
}

export function crearDependencias(): Dependencias {
  const auth = pasarelaOidc(ajustesOidcDeEntorno());
  const api = crearClienteApi();
  api.use(middlewareBearer(auth));
  return { api, auth };
}

