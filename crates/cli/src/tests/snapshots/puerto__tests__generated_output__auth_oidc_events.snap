=== web/src/presentation/features/product/views/product-form-view.tsx ===
import type { ProductProblem } from "../../../../domain/product/messages";
import { type Product, type ProductDraft, parseStatus } from "../../../../domain/product/model";
import {
  dateTimeOrNull,
  formatEntries,
  parseEntries,
  splitList,
  toDateTimeLocal,
} from "../../../shared/forms";
import { FieldError } from "../../../shared/ui/field-error";

/** What the inputs hold: the text of every input, `checked` for a checkbox. */
export interface ProductFormValues {
  name: string;
  sku: string;
  price: string;
  status: string;
  tags: string;
  releasedAt: string;
  meta: string;
}

/** The inputs for `product`, empty when there is none yet. */
export function toProductForm(product: Product | null): ProductFormValues {
  if (product === null) {
    return {
      name: "",
      sku: "",
      price: "",
      status: "",
      tags: "",
      releasedAt: "",
      meta: "",
    };
  }
  return {
    name: product.name,
    sku: product.sku,
    price: String(product.price),
    status: product.status,
    tags: product.tags.join(", "),
    releasedAt: toDateTimeLocal(product.releasedAt),
    meta: formatEntries(product.meta),
  };
}

export function toProductDraft(values: ProductFormValues): ProductDraft {
  return {
    name: values.name,
    sku: values.sku,
    price: Number(values.price),
    status: parseStatus(values.status),
    tags: splitList(values.tags),
    releasedAt: dateTimeOrNull(values.releasedAt),
    meta: parseEntries(values.meta),
  };
}

export function ProductFormView({
  values,
  saving,
  problem,
  onChange,
  onSubmit,
}: {
  values: ProductFormValues;
  saving: boolean;
  /** What the API said about the last submit: shown under its input. */
  problem: ProductProblem | null;
  onChange: (values: ProductFormValues) => void;
  onSubmit: () => void;
}) {
  return (
    <form
      className="space-y-2"
      onSubmit={(event) => {
        event.preventDefault();
        onSubmit();
      }}
    >
      <label className="fieldset">
        <span className="fieldset-legend">Name</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "name"}
          required
          value={values.name}
          onChange={(event) => onChange({ ...values, name: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="name" />
      <label className="fieldset">
        <span className="fieldset-legend">Sku</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "sku"}
          required
          value={values.sku}
          onChange={(event) => onChange({ ...values, sku: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="sku" />
      <label className="fieldset">
        <span className="fieldset-legend">Price</span>
        <input
          className="input w-full"
          type="number"
          aria-invalid={problem?.field === "price"}
          required
          value={values.price}
          onChange={(event) => onChange({ ...values, price: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="price" />
      <label className="fieldset">
        <span className="fieldset-legend">Status</span>
        <select
          className="select w-full"
          aria-invalid={problem?.field === "status"}
          required
          value={values.status}
          onChange={(event) => onChange({ ...values, status: event.target.value })}
        >
          <option value="">Choose…</option>
          <option value="Draft">Draft</option>
          <option value="Published">Published</option>
        </select>
      </label>
      <FieldError problem={problem} field="status" />
      <label className="fieldset">
        <span className="fieldset-legend">Tags</span>
        <input
          className="input w-full"
          type="text"
          aria-invalid={problem?.field === "tags"}
          value={values.tags}
          onChange={(event) => onChange({ ...values, tags: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="tags" />
      <label className="fieldset">
        <span className="fieldset-legend">Released at</span>
        <input
          className="input w-full"
          type="datetime-local"
          aria-invalid={problem?.field === "releasedAt"}
          value={values.releasedAt}
          onChange={(event) => onChange({ ...values, releasedAt: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="releasedAt" />
      <label className="fieldset">
        <span className="fieldset-legend">Meta</span>
        <textarea
          className="textarea w-full"
          aria-invalid={problem?.field === "meta"}
          placeholder="key=value, one per line"
          value={values.meta}
          onChange={(event) => onChange({ ...values, meta: event.target.value })}
        />
      </label>
      <FieldError problem={problem} field="meta" />
      <button type="submit" className="btn btn-primary" disabled={saving}>
        Save
      </button>
    </form>
  );
}

