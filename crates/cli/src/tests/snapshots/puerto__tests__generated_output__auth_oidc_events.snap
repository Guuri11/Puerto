use async_trait::async_trait;
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};

use crate::modelo::{IdProducto, Producto};

#[async_trait]
pub trait RepositorioProducto: Send + Sync {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Producto>, ErrorRepositorio>;
    async fn buscar_por_id(&self, id: IdProducto) -> Result<Option<Producto>, ErrorRepositorio>;
    // Sin `guardar`: las escrituras pasan por `UnitOfWorkFactoryProducto`, que registra sus
    // eventos.
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub RepositorioProducto {}

        #[async_trait]
        impl RepositorioProducto for RepositorioProducto {
            async fn buscar_todos(&self, pagina: PeticionPagina) -> Result<Pagina<Producto>, ErrorRepositorio>;
            async fn buscar_por_id(&self, id: IdProducto) -> Result<Option<Producto>, ErrorRepositorio>;
        }
    }
}

=== contextos/producto/dominio/src/unit_of_work.rs ===
use async_trait::async_trait;
use puerto_nucleo::ErrorRepositorio;

use crate::{eventos::EventoProducto, modelo::Producto};

/// Una transacción de producto (ADR-0018 § 2): lo que guarda y los eventos que registra se
/// escriben juntos en el `commit`, o no se escriben. Soltarla sin `commit` la deshace, así que un
/// `?` temprano es el rollback.
#[async_trait]
pub trait UnitOfWorkProducto: Send {
    async fn guardar(&mut self, entidad: &Producto) -> Result<(), ErrorRepositorio>;
    async fn registrar(&mut self, evento: EventoProducto) -> Result<(), ErrorRepositorio>;
    async fn commit(self: Box<Self>) -> Result<(), ErrorRepositorio>;
}

/// Abre una [`UnitOfWorkProducto`]: por donde pasa toda escritura de producto. El
/// repositorio solo lee, así que una escritura que se salte el outbox no compila.
#[async_trait]
pub trait UnitOfWorkFactoryProducto: Send + Sync {
    async fn begin(&self) -> Result<Box<dyn UnitOfWorkProducto>, ErrorRepositorio>;

    /// La escritura de siempre en una llamada (ADR-0026 de Puerto): guarda la entidad y registra el
    /// evento que emitió, las dos cosas o ninguna. Para escribir más de una vez, `begin` y `commit`.
    async fn guardar(
        &self,
        entidad: &Producto,
        evento: EventoProducto,
    ) -> Result<(), ErrorRepositorio> {
        let mut uow = self.begin().await?;
        uow.guardar(entidad).await?;
        uow.registrar(evento).await?;
        uow.commit().await
    }
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use std::sync::{Arc, Mutex, MutexGuard};

    use super::*;

    /// Dónde falla una [`UnitOfWorkFactoryGrabadora`], si se le ha indicado.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum FallarEn {
        Begin,
        Guardar,
        Commit,
    }

    /// Lo que se pidió a las unidades de trabajo de una [`UnitOfWorkFactoryGrabadora`].
    #[derive(Debug, Clone, Default)]
    pub struct Grabado {
        pub guardados: Vec<Producto>,
        pub eventos: Vec<EventoProducto>,
        pub confirmado: bool,
    }

    /// Un `UnitOfWorkFactoryProducto` falso para los tests de casos de uso: sus unidades de
    /// trabajo apuntan lo que guardan y registran y si hicieron `commit`, y fallan donde se les
    /// haya indicado.
    #[derive(Clone, Default)]
    pub struct UnitOfWorkFactoryGrabadora {
        grabado: Arc<Mutex<Grabado>>,
        fallo: Option<(FallarEn, ErrorRepositorio)>,
    }

    impl UnitOfWorkFactoryGrabadora {
        pub fn new() -> Self {
            Self::default()
        }

        pub fn fallando_en(punto: FallarEn, error: ErrorRepositorio) -> Self {
            Self {
                fallo: Some((punto, error)),
                ..Self::default()
            }
        }

        pub fn grabado(&self) -> Grabado {
            lock(&self.grabado).clone()
        }

        fn fallar_en(&self, punto: FallarEn) -> Result<(), ErrorRepositorio> {
            match self.fallo {
                Some((fallido, error)) if fallido == punto => Err(error),
                _ => Ok(()),
            }
        }
    }

    fn lock(grabado: &Mutex<Grabado>) -> MutexGuard<'_, Grabado> {
        grabado
            .lock()
            .unwrap_or_else(|envenenado| envenenado.into_inner())
    }

    struct UnitOfWorkGrabadora {
        factory: UnitOfWorkFactoryGrabadora,
    }

    #[async_trait]
    impl UnitOfWorkProducto for UnitOfWorkGrabadora {
        async fn guardar(&mut self, entidad: &Producto) -> Result<(), ErrorRepositorio> {
            self.factory.fallar_en(FallarEn::Guardar)?;
            lock(&self.factory.grabado).guardados.push(entidad.clone());
            Ok(())
        }

        async fn registrar(&mut self, evento: EventoProducto) -> Result<(), ErrorRepositorio> {
            lock(&self.factory.grabado).eventos.push(evento);
            Ok(())
        }

        async fn commit(self: Box<Self>) -> Result<(), ErrorRepositorio> {
            self.factory.fallar_en(FallarEn::Commit)?;
            lock(&self.factory.grabado).confirmado = true;
            Ok(())
        }
    }

    #[async_trait]
    impl UnitOfWorkFactoryProducto for UnitOfWorkFactoryGrabadora {
        async fn begin(&self) -> Result<Box<dyn UnitOfWorkProducto>, ErrorRepositorio> {
            self.fallar_en(FallarEn::Begin)?;
            Ok(Box::new(UnitOfWorkGrabadora {
                factory: self.clone(),
            }))
        }
    }
}

=== contextos/producto/dominio/src/valores.rs ===
use crate::errores::ErrorProducto;

#[derive(Debug, Clone, PartialEq)]
pub struct Name {
    valor: String,
}

impl Name {
    pub fn new(valor: String) -> Result<Self, ErrorProducto> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorProducto::NameInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub struct Sku {
    valor: String,
}

impl Sku {
    pub fn new(valor: String) -> Result<Self, ErrorProducto> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorProducto::SkuInvalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

#[derive(Debug, Clone, PartialEq)]
pub enum Status {
    Draft,
    Published,
}

impl std::str::FromStr for Status {
    type Err = ErrorProducto;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s {
            "Draft" => Ok(Self::Draft),
            "Published" => Ok(Self::Published),
            _ => Err(ErrorProducto::StatusInvalido),
        }
    }
}

impl Status {
    pub fn as_str(&self) -> &'static str {
        match self {
            Self::Draft => "Draft",
            Self::Published => "Published",
        }
    }
}

