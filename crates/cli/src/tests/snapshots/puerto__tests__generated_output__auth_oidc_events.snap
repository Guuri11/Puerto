import { useAuth } from "../../core/auth";

/** Who is signed in, and the button to sign in or out. */
export function UserMenu() {
  const { user, login, logout } = useAuth();
  if (user === null) {
    return (
      <button type="button" className="btn btn-ghost" onClick={() => void login()}>
        Sign in
      </button>
    );
  }
  return (
    <div className="flex items-center gap-2">
      <span className="text-sm">{user.name ?? user.email ?? "Signed in"}</span>
      <button type="button" className="btn btn-ghost btn-sm" onClick={() => void logout()}>
        Sign out
      </button>
    </div>
  );
}

=== web/src/test-support/auth.ts ===
import type { AuthGateway, CurrentUser } from "../domain/auth/session";
import { ROLES } from "../presentation/core/generated/roles";

/** Signed-in users for tests; pass `overrides` for what a test is about. */
export const CurrentUserMother = {
  random(overrides: Partial<CurrentUser> = {}): CurrentUser {
    const id = crypto.randomUUID();
    return { id, email: `ada-${id.slice(0, 8)}@example.com`, name: "Ada", roles: [], ...overrides };
  },

  /** Holds every role a generated screen checks: what `renderScreen` signs in by default. */
  caller(): CurrentUser {
    return CurrentUserMother.random({ roles: [...ROLES] });
  },
};

/** An `AuthGateway` with `user` signed in (`null`: nobody). `logins` records each `login` call. */
export function fakeAuthGateway({ user = null }: { user?: CurrentUser | null } = {}) {
  const logins: string[] = [];
  const gateway: AuthGateway = {
    currentUser: async () => user,
    accessToken: async () => (user === null ? null : `token-of-${user.id}`),
    login: async (returnTo) => {
      logins.push(returnTo);
    },
    completeLogin: async () => "/",
    logout: async () => {},
  };
  return { ...gateway, logins };
}

=== web/src/test-support/producto.ts ===
import { ProductoError } from "../domain/producto/errors";
import type { Producto, ProductoDraft } from "../domain/producto/model";
import type { ProductoRepository } from "../domain/producto/repository";

/** Valid productos for tests; pass `overrides` for the fields a test is about. */
export const ProductoMother = {
  draft(overrides: Partial<ProductoDraft> = {}): ProductoDraft {
    return {
      name: "example",
      sku: "example",
      price: 42,
      status: "Draft",
      tags: ["example"],
      releasedAt: "2026-01-01T10:00:00.000Z",
      meta: { key: "value" },
      ...overrides,
    };
  },

  random(overrides: Partial<Producto> = {}): Producto {
    return { id: crypto.randomUUID(), ...ProductoMother.draft(), ...overrides };
  },
};

/** An in-memory `ProductoRepository`. Override a method to make it fail. */
export function fakeProductoRepository(seed: Producto[] = []): ProductoRepository {
  const store = new Map(seed.map((item) => [item.id, item]));
  const find = (id: string) => {
    const found = store.get(id);
    if (found === undefined) throw new ProductoError("producto.no_encontrado");
    return found;
  };
  return {
    list: async ({ limit, offset }) => {
      const all = [...store.values()];
      return { items: all.slice(offset, offset + limit), total: all.length, limit, offset };
    },
    get: async (id) => find(id),
    create: async (draft) => {
      const created = { id: crypto.randomUUID(), ...draft };
      store.set(created.id, created);
      return created;
    },
    update: async (id, draft) => {
      const updated = { ...find(id), ...draft };
      store.set(id, updated);
      return updated;
    },
    remove: async (id) => {
      find(id);
      store.delete(id);
    },
  };
}

=== web/src/test-support/render.tsx ===
import { render } from "@testing-library/react";
import type { ReactNode } from "react";
import { Router } from "wouter";
import { memoryLocation } from "wouter/memory-location";
import type { CurrentUser } from "../domain/auth/session";
import { AuthProvider } from "../presentation/core/auth";
import { DependenciesProvider } from "../presentation/core/dependencies";
import type { Dependencies } from "../presentation/core/generated/dependencies";
import { CurrentUserMother, fakeAuthGateway } from "./auth";

/**
 * Renders a screen with the adapters it uses (`dependencies` needs only those) at `path`, signed in
 * as `user`: by default a caller holding every role, `null` for nobody. `history` records every
 * location the screen navigates to.
 */
export function renderScreen(
  ui: ReactNode,
  dependencies: Partial<Dependencies>,
  path = "/",
  { user = CurrentUserMother.caller() }: { user?: CurrentUser | null } = {},
) {
  const location = memoryLocation({ path, record: true });
  const result = render(
    // A screen that reaches for an adapter it was not given fails loudly: it is `undefined`.
    <DependenciesProvider
      value={{ auth: fakeAuthGateway({ user }), ...dependencies } as Dependencies}
    >
      <Router hook={location.hook}>
        <AuthProvider>{ui}</AuthProvider>
      </Router>
    </DependenciesProvider>,
  );
  return { ...result, history: location.history };
}
