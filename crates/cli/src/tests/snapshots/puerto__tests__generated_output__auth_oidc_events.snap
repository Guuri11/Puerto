=== presentacion/worker/src/consumidores.rs ===
//! Un módulo por cada `[[consumidor]]` de puerto.toml: los añade `puerto generar consumidor`.
pub mod notify_new_producto;

=== presentacion/worker/src/consumidores/notify_new_producto.rs ===
//! `notify_new_producto`: reacciona a `producto_creado`, `producto_published`. Lo escribe una vez
//! `puerto generar consumidor`; desde entonces es tuyo.
//!
//! La entrega es al menos una vez: el mismo evento (el mismo `evento.id`) puede llegar dos veces,
//! tras una caída, un timeout o un redespliegue. Lo que haga esto debe ser **idempotente**:
//! comprueba si ya ocurrió (por `evento.id`) antes de volver a hacerlo.
//!
//! `Ack` cuando termina; `Reintentar` para un fallo que puede pasar (el worker vuelve a entregarlo
//! con una espera creciente y después lo descarta); `ResultadoManejo::descartar(…)` para uno que no
//! pasará nunca.

use async_trait::async_trait;
use dominio_producto::eventos::{PRODUCTO_CREADO, PRODUCTO_PUBLISHED, SnapshotProducto};
use puerto_nucleo::eventos::{
    MOTIVO_PAYLOAD_INVALIDO, ManejadorEvento, ResultadoManejo, SobreEvento,
};
use sqlx::PgPool;

pub struct NotifyNewProducto;

impl NotifyNewProducto {
    /// Lo llama `generado/registro.rs` al arrancar el worker, con su pool. Lo que necesite el
    /// consumidor se construye aquí y se guarda en sus campos: `cableado::<contexto>::construir(pool)`
    /// da los casos de uso de un contexto (con `cableado` en el `Cargo.toml` del worker).
    pub fn construir(_pool: &PgPool) -> Self {
        Self
    }
}

#[async_trait]
impl ManejadorEvento for NotifyNewProducto {
    async fn manejar(&self, evento: &SobreEvento) -> ResultadoManejo {
        match evento.tipo_evento.as_str() {
            PRODUCTO_CREADO => match evento.decodificar::<SnapshotProducto>() {
                Ok(producto) => {
                    tracing::info!(
                        id_evento = %evento.id,
                        id_producto = %producto.id,
                        "notify_new_producto: producto_creado"
                    );
                    ResultadoManejo::Ack
                }
                Err(err) => ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle),
            },
            PRODUCTO_PUBLISHED => match evento.decodificar::<SnapshotProducto>() {
                Ok(producto) => {
                    tracing::info!(
                        id_evento = %evento.id,
                        id_producto = %producto.id,
                        "notify_new_producto: producto_published"
                    );
                    ResultadoManejo::Ack
                }
                Err(err) => ResultadoManejo::descartar(MOTIVO_PAYLOAD_INVALIDO, err.detalle),
            },
            // Sin suscripción (puerto.toml `[[consumidor]] eventos`): nada que hacer.
            _ => ResultadoManejo::Ack,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_producto::eventos::EventoProducto;
    use dominio_producto::pruebas::madres::MadreProducto;

    fn producto_creado() -> SobreEvento {
        let snapshot = SnapshotProducto::from_entidad(&MadreProducto::aleatorio());
        SobreEvento::new(&EventoProducto::Creado(snapshot))
    }

    #[tokio::test]
    async fn deberia_hacer_ack_cuando_el_evento_producto_creado_es_valido() {
        // Preparar
        let evento = producto_creado();

        // Actuar
        let resultado = NotifyNewProducto.manejar(&evento).await;

        // Comprobar
        assert_eq!(resultado, ResultadoManejo::Ack);
    }

    #[tokio::test]
    async fn deberia_hacer_ack_otra_vez_cuando_el_mismo_evento_llega_dos_veces() {
        // Preparar
        let evento = producto_creado();

        // Actuar
        let primero = NotifyNewProducto.manejar(&evento).await;
        let segundo = NotifyNewProducto.manejar(&evento).await;

        // Comprobar
        assert_eq!(
            (primero, segundo),
            (ResultadoManejo::Ack, ResultadoManejo::Ack)
        );
    }

    #[tokio::test]
    async fn deberia_descartar_cuando_el_payload_esta_mal_formado() {
        // Preparar
        let mut evento = producto_creado();
        evento.payload = serde_json::json!({ "unexpected": true });

        // Actuar
        let resultado = NotifyNewProducto.manejar(&evento).await;

        // Comprobar
        assert!(
            matches!(
                resultado,
                ResultadoManejo::Descartar {
                    motivo: MOTIVO_PAYLOAD_INVALIDO,
                    ..
                }
            ),
            "{resultado:?}"
        );
    }
}

=== presentacion/worker/src/generado.rs ===
pub mod registro;

=== presentacion/worker/src/generado/registro.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`; añade un
// consumidor con `puerto generar consumidor <nombre> --tras <tipo_evento>`.
use std::sync::Arc;

use dominio_producto::eventos::{PRODUCTO_CREADO, PRODUCTO_PUBLISHED};
use puerto_eventos::{Bucles, ConfigWorker};
use puerto_sqlx::eventos::{
    DescartadosPostgres, EntregasPostgres, OutboxPostgres, SuscripcionPostgres,
};

use crate::consumidores::notify_new_producto::NotifyNewProducto;

/// El relay y un consumidor por cada `[[consumidor]]`, sobre el transporte `db`: el relay pasa cada
/// evento a `entregas_eventos`, una fila por cada consumidor suscrito a su tipo.
pub async fn construir_worker(config: ConfigWorker) -> Result<Bucles, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL no está definida — defínela en .env (.env.example trae una)".to_string()
    })?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — ¿está arrancada la base de datos? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;

    let entregas = EntregasPostgres::new(pool.clone()).enrutar(
        "notify_new_producto",
        &[PRODUCTO_CREADO, PRODUCTO_PUBLISHED],
    );
    let descartados = Arc::new(DescartadosPostgres::new(pool.clone()));

    Ok(Bucles::new(&config)
        .relay(OutboxPostgres::new(pool.clone()), entregas)
        .consumidor(
            SuscripcionPostgres::new(pool.clone(), "notify_new_producto"),
            NotifyNewProducto::construir(&pool),
            descartados,
        ))
}

=== presentacion/worker/src/main.rs ===
mod consumidores;
mod generado;

/// El segundo proceso de este proyecto (ADR-0018 de Puerto): hace de relay del outbox que escribe
/// la API y ejecuta los consumidores. Los bucles, las sondas de salud y el apagado ordenado vienen
/// del runtime de Puerto, `puerto-eventos`; el cableado está en `generado/registro.rs`, y los
/// consumidores, en `consumidores/`.
#[tokio::main]
async fn main() -> Result<(), puerto_eventos::Error> {
    let config = puerto_eventos::ConfigWorker::from_env()?;
    puerto_eventos::Worker::new(config)
        .intentar_ejecutar(generado::registro::construir_worker)
        .await
}

