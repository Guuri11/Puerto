=== presentacion/worker/src/generado/registro.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`; añade un
// consumidor con `puerto generar consumidor <nombre> --tras <tipo_evento>`.
use std::sync::Arc;

use dominio_producto::eventos::{PRODUCTO_CREADO, PRODUCTO_PUBLISHED};
use puerto_eventos::{Bucles, ConfigWorker};
use puerto_sqlx::eventos::{
    DescartadosPostgres, EntregasPostgres, OutboxPostgres, SuscripcionPostgres,
};

use crate::consumidores::notify_new_producto::NotifyNewProducto;

/// El relay y un consumidor por cada `[[consumidor]]`, sobre el transporte `db`: el relay pasa cada
/// evento a `entregas_eventos`, una fila por cada consumidor suscrito a su tipo.
pub async fn construir_worker(config: ConfigWorker) -> Result<Bucles, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL no está definida — defínela en .env (.env.example trae una)".to_string()
    })?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — ¿está arrancada la base de datos? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;

    let entregas = EntregasPostgres::new(pool.clone()).enrutar(
        "notify_new_producto",
        &[PRODUCTO_CREADO, PRODUCTO_PUBLISHED],
    );
    let descartados = Arc::new(DescartadosPostgres::new(pool.clone()));

    Ok(Bucles::new(&config)
        .relay(OutboxPostgres::new(pool.clone()), entregas)
        .consumidor(
            SuscripcionPostgres::new(pool.clone(), "notify_new_producto"),
            NotifyNewProducto,
            descartados,
        ))
}

=== presentacion/worker/src/main.rs ===
mod consumidores;
mod generado;

/// El segundo proceso de este proyecto (ADR-0018 de Puerto): hace de relay del outbox que escribe
/// la API y ejecuta los consumidores. Los bucles, las sondas de salud y el apagado ordenado vienen
/// del runtime de Puerto, `puerto-eventos`; el cableado está en `generado/registro.rs`, y los
/// consumidores, en `consumidores/`.
#[tokio::main]
async fn main() -> Result<(), puerto_eventos::Error> {
    let config = puerto_eventos::ConfigWorker::from_env()?;
    puerto_eventos::Worker::new(config)
        .intentar_ejecutar(generado::registro::construir_worker)
        .await
}

