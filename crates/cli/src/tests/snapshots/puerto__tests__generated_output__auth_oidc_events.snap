use chrono::{DateTime, Utc};
use dominio_producto::modelo::Producto;
use poem_openapi::Object;
use puerto_nucleo::Pagina;
use std::collections::HashMap;
use uuid::Uuid;

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoProducto {
    pub id: Uuid,
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

impl DtoProducto {
    pub fn from_dominio(entidad: &Producto) -> Self {
        Self {
            id: entidad.id.valor(),
            name: entidad.name.valor().to_string(),
            sku: entidad.sku.valor().to_string(),
            price: entidad.price,
            status: entidad.status.as_str().to_string(),
            tags: entidad.tags.clone(),
            released_at: entidad.released_at,
            meta: entidad.meta.clone(),
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionCrearProducto {
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

/// Una página de Productos: `total` es el recuento completo y `limite`, el que aplicó
/// la API.
#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct DtoPaginaProducto {
    pub elementos: Vec<DtoProducto>,
    pub total: u64,
    pub limite: u32,
    pub desplazamiento: u32,
}

impl DtoPaginaProducto {
    pub fn from_dominio(pagina: &Pagina<Producto>) -> Self {
        Self {
            elementos: pagina
                .elementos
                .iter()
                .map(DtoProducto::from_dominio)
                .collect(),
            total: pagina.total,
            limite: pagina.limite,
            desplazamiento: pagina.desplazamiento,
        }
    }
}

#[derive(Debug, Object)]
#[oai(rename_all = "camelCase")]
pub struct PeticionActualizarProducto {
    pub name: String,
    pub sku: String,
    pub price: i64,
    pub status: String,
    pub tags: Vec<String>,
    pub released_at: Option<DateTime<Utc>>,
    pub meta: HashMap<String, String>,
}

