=== presentacion/api/src/generado/bootstrap.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
use std::sync::Arc;

use infra_usuario::aprovisionamiento::AutenticadorAprovisionador;
use infra_usuario::repositorio::RepositorioUsuarioPostgres;
use poem::Endpoint;
use poem::EndpointExt;
use poem_openapi::OpenApiService;
use puerto_nucleo::auth::Autenticador;
use rest_equipo::rutas::ApiEquipo;
use rest_jugador::rutas::ApiJugador;
use rest_usuario::me::rutas::ApiMe;

/// Las rutas, cableadas. Un error es lo que paró el arranque: `main` lo muestra y sale con 1.
pub async fn construir_app(config: puerto_web::Config) -> Result<impl Endpoint, String> {
    let database_url = std::env::var("DATABASE_URL").map_err(|_| {
        "DATABASE_URL no está definida — defínela en .env (.env.example trae una)".to_string()
    })?;
    let pool = puerto_sqlx::crear_pool_postgres(&database_url)
        .await
        .map_err(|e| format!("{e} — ¿está arrancada la base de datos? `make docker-compose/up`"))?;
    puerto_sqlx::ejecutar_migraciones(&pool, &migrador::MIGRADOR)
        .await
        .map_err(|e| e.to_string())?;

    // Los tokens del proveedor, y una fila `Usuario` para cada quien llama (ADR-0021 § 3).
    let config_auth = puerto_auth::ConfigOidc::from_env().map_err(|e| e.to_string())?;
    let emisor = config_auth.emisor.clone();
    let proveedor = puerto_auth::AutenticadorOidc::descubrir(config_auth)
        .await
        .map_err(|e| {
            format!("{e} — ¿está arrancado el proveedor de auth? `make docker-compose/up`")
        })?;
    let autenticador: Arc<dyn Autenticador> = Arc::new(AutenticadorAprovisionador::new(
        Arc::new(proveedor),
        Arc::new(RepositorioUsuarioPostgres::new(pool.clone())),
        emisor,
    ));
    let api_me = ApiMe;

    let casos_equipo = cableado::equipo::construir(&pool);
    let api_equipo = ApiEquipo {
        crear_equipo: casos_equipo.crear_equipo,
        obtener_equipo: casos_equipo.obtener_equipo,
        listar_equipos: casos_equipo.listar_equipos,
        actualizar_equipo: casos_equipo.actualizar_equipo,
        borrar_equipo: casos_equipo.borrar_equipo,
    };

    let casos_jugador = cableado::jugador::construir(&pool);
    let api_jugador = ApiJugador {
        crear_jugador: casos_jugador.crear_jugador,
        obtener_jugador: casos_jugador.obtener_jugador,
        listar_jugadores: casos_jugador.listar_jugadores,
        actualizar_jugador: casos_jugador.actualizar_jugador,
        borrar_jugador: casos_jugador.borrar_jugador,
    };

    let disponible = puerto_web::health::sondear(move || {
        let pool = pool.clone();
        async move { puerto_sqlx::ping(&pool).await }
    });

    // `app.rs` es del proyecto: el middleware y las rutas que se añadan allí envuelven todo esto.
    Ok(crate::app::configurar(puerto_web::rutas(
        servicio_openapi((api_equipo, api_jugador, api_me)),
        &config,
        disponible,
    ))
    // Lo que consulta cada `BearerAuth`.
    .data(autenticador))
}

/// El servicio de la API, construido en un solo sitio: cualquier otro que lea su spec (el test de
/// exportación de un proyecto con `web/`) ve la API que responde el servidor.
fn servicio_openapi<T: poem_openapi::OpenApi>(api: T) -> OpenApiService<T, ()> {
    OpenApiService::new(api, env!("CARGO_PKG_NAME"), env!("CARGO_PKG_VERSION"))
}

=== presentacion/cableado/Cargo.toml ===
# GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
[package]
name = "cableado"
version = "0.1.0"
edition = "2024"

[dependencies]
aplicacion_equipo = { workspace = true }
dominio_equipo = { workspace = true }
infra_equipo = { workspace = true }
aplicacion_jugador = { workspace = true }
dominio_jugador = { workspace = true }
infra_jugador = { workspace = true }
sqlx = { workspace = true }


=== presentacion/cableado/src/lib.rs ===
// GENERADO por puerto. Edita puerto.toml y después ejecuta `puerto generar bootstrap`.
//! Los repositorios, unidades de trabajo y casos de uso de cada contexto, construidos para los
//! binarios (ADR-0023 § 7 de Puerto). Aquí no hay HTTP: `api` monta sus rutas sobre estos casos de
//! uso.

pub mod equipo {
    use std::sync::Arc;

    use aplicacion_equipo::actualizar_equipo::{ActualizarEquipo, ActualizarEquipoImpl};
    use aplicacion_equipo::borrar_equipo::{BorrarEquipo, BorrarEquipoImpl};
    use aplicacion_equipo::crear_equipo::{CrearEquipo, CrearEquipoImpl};
    use aplicacion_equipo::listar_equipos::{ListarEquipos, ListarEquiposImpl};
    use aplicacion_equipo::obtener_equipo::{ObtenerEquipo, ObtenerEquipoImpl};
    use dominio_equipo::repositorio::RepositorioEquipo;
    use infra_equipo::repositorio::RepositorioEquipoPostgres;

    /// Los casos de uso de `equipo`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_equipo: Arc<dyn CrearEquipo>,
        pub obtener_equipo: Arc<dyn ObtenerEquipo>,
        pub listar_equipos: Arc<dyn ListarEquipos>,
        pub actualizar_equipo: Arc<dyn ActualizarEquipo>,
        pub borrar_equipo: Arc<dyn BorrarEquipo>,
    }

    pub fn construir(pool: &sqlx::PgPool) -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioEquipo> =
            Arc::new(RepositorioEquipoPostgres::new(pool.clone()));
        CasosDeUso {
            crear_equipo: Arc::new(CrearEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_equipo: Arc::new(ObtenerEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_equipos: Arc::new(ListarEquiposImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_equipo: Arc::new(ActualizarEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_equipo: Arc::new(BorrarEquipoImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

pub mod jugador {
    use std::sync::Arc;

    use aplicacion_jugador::actualizar_jugador::{ActualizarJugador, ActualizarJugadorImpl};
    use aplicacion_jugador::borrar_jugador::{BorrarJugador, BorrarJugadorImpl};
    use aplicacion_jugador::crear_jugador::{CrearJugador, CrearJugadorImpl};
    use aplicacion_jugador::listar_jugadores::{ListarJugadores, ListarJugadoresImpl};
    use aplicacion_jugador::obtener_jugador::{ObtenerJugador, ObtenerJugadorImpl};
    use dominio_jugador::repositorio::RepositorioJugador;
    use infra_jugador::repositorio::RepositorioJugadorPostgres;

    /// Los casos de uso de `jugador`, sobre sus adaptadores.
    pub struct CasosDeUso {
        pub crear_jugador: Arc<dyn CrearJugador>,
        pub obtener_jugador: Arc<dyn ObtenerJugador>,
        pub listar_jugadores: Arc<dyn ListarJugadores>,
        pub actualizar_jugador: Arc<dyn ActualizarJugador>,
        pub borrar_jugador: Arc<dyn BorrarJugador>,
    }

    pub fn construir(pool: &sqlx::PgPool) -> CasosDeUso {
        let repositorio: Arc<dyn RepositorioJugador> =
            Arc::new(RepositorioJugadorPostgres::new(pool.clone()));
        CasosDeUso {
            crear_jugador: Arc::new(CrearJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            obtener_jugador: Arc::new(ObtenerJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            listar_jugadores: Arc::new(ListarJugadoresImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            actualizar_jugador: Arc::new(ActualizarJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
            borrar_jugador: Arc::new(BorrarJugadorImpl {
                repositorio: Arc::clone(&repositorio),
            }),
        }
    }
}

=== puerto.toml ===
[proyecto]
nombre = "snapshot"
db = true
auth = "oidc"

[[entidad]]
nombre = "Equipo"
casos_de_uso = [
    "crear_equipo",
    "obtener_equipo",
    "listar_equipos",
    "actualizar_equipo",
    "borrar_equipo",
]
db = true

[[entidad.campos]]
nombre = "nombre"
tipo = "String"

[[entidad]]
nombre = "Jugador"
casos_de_uso = [
    "crear_jugador",
    "obtener_jugador",
    "listar_jugadores",
    "actualizar_jugador",
    "borrar_jugador",
]
db = true
unicos = [[
    "equipo_id",
    "dorsal",
]]
orden = ["-dorsal"]
publicos = [
    "listar_jugadores",
    "obtener_jugador",
]

[entidad.roles]
actualizar_jugador = ["admin"]
borrar_jugador = ["admin"]

[[entidad.campos]]
nombre = "equipo_id"
tipo = "Uuid"
referencia = "Equipo"

[[entidad.campos]]
nombre = "dorsal"
tipo = "i64"

[[entidad.campos]]
nombre = "email"
tipo = "String"
privado = true

