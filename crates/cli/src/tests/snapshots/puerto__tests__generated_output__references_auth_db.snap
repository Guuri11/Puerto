=== contextos/jugador/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad jugador válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_jugador::modelo::Jugador;
use dominio_jugador::modelo::PropsJugador;
use dominio_jugador::pruebas::madres::MadreJugador;
use dominio_jugador::repositorio::RepositorioJugador;
use sqlx::PgPool;
use uuid::Uuid;

use crate::repositorio::RepositorioJugadorPostgres;

/// Una entidad jugador válida, sin guardar, con los valores de la madre salvo en los
/// campos únicos (uno nuevo cada vez), las fechas (un segundo exacto, lo que Postgres guarda) y las
/// referencias (una fila sembrada).
pub async fn construir(pool: &PgPool) -> Jugador {
    Jugador::new(PropsJugador {
        equipo_id: infra_equipo::pruebas::siembra::sembrar(pool).await.id,
        dorsal: (Uuid::new_v4().as_u128() >> 65) as i64,
        ..MadreJugador::new().construir_props()
    })
    .unwrap()
}

/// Una entidad jugador guardada.
pub async fn sembrar(pool: &PgPool) -> Jugador {
    let entidad = construir(pool).await;
    RepositorioJugadorPostgres::new(pool.clone())
        .guardar(&entidad)
        .await
        .unwrap();
    entidad
}

=== contextos/jugador/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_jugador::{
    modelo::{IdJugador, Jugador},
    repositorio::{FiltroJugador, RepositorioJugador},
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::{ClaveForanea, mapear_error_sqlx, mapear_error_sqlx_con};

use crate::fila::FilaJugador;

pub struct RepositorioJugadorPostgres {
    pub pool: PgPool,
}

impl RepositorioJugadorPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Las claves foráneas por las que pasa una escritura (ADR-0022 de Puerto): la base de datos
/// rechaza una referencia a una fila que no existe, y quien llama recibe como error el campo que la
/// nombra.
const REFERENCES: &[ClaveForanea] = &[ClaveForanea {
    restriccion: "jugadores_equipo_id_fkey",
    campo: "equipo_id",
}];

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaJugador) -> Result<Jugador, ErrorRepositorio> {
    Jugador::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad jugador válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioJugador for RepositorioJugadorPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
        filtro: FiltroJugador,
    ) -> Result<Pagina<Jugador>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        // Una sola consulta estática sea cual sea el filtro: un id sin valor es NULL y casa con
        // todas las filas.
        let equipo_id = filtro.equipo_id.map(|id| id.valor());
        let filas = sqlx::query_as!(
            FilaJugador,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, equipo_id, dorsal, email
             FROM jugadores WHERE borrado = false AND ($3::uuid IS NULL OR equipo_id = $3)
             ORDER BY dorsal DESC, creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento()),
            equipo_id
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM jugadores WHERE borrado = false AND ($1::uuid IS NULL OR equipo_id = $1)"#,
            equipo_id
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdJugador) -> Result<Option<Jugador>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaJugador,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, equipo_id, dorsal, email
             FROM jugadores WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }

    async fn guardar(&self, entidad: &Jugador) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaJugador::from(entidad);
        sqlx::query!(
            "INSERT INTO jugadores (id, creado_en, actualizado_en, borrado, borrado_en, equipo_id, dorsal, email)
             VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, equipo_id = $6, dorsal = $7, email = $8",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.equipo_id,
            db.dorsal,
            db.email,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx_con(&e, REFERENCES)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::{construir, sembrar};
    use dominio_equipo::modelo::IdEquipo;

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioJugadorPostgres {
        RepositorioJugadorPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.equipo_id, entidad.equipo_id);
        assert_eq!(encontrado.dorsal, entidad.dorsal);
        assert_eq!(encontrado.email, entidad.email);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdJugador::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_la_entidad_al_guardar_un_id_existente(pool: PgPool) {
        // Preparar
        let mut entidad = sembrar(&pool).await;
        entidad.email = "updated".to_string();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        repositorio_de_prueba(pool.clone())
            .guardar(&entidad)
            .await
            .unwrap();

        // Comprobar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(encontrado.email, "updated");
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_jugadores_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        repositorio_de_prueba(pool.clone())
            .guardar(&borrado)
            .await
            .unwrap();

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default(), FiltroJugador::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::new(Some(2), Some(2)),
                FiltroJugador::default(),
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_un_duplicado_de_equipo_id_y_dorsal(pool: PgPool) {
        // Preparar
        let primero = sembrar(&pool).await;
        let mut segundo = construir(&pool).await;
        segundo.equipo_id = primero.equipo_id;
        segundo.dorsal = primero.dorsal;

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&segundo).await;

        // Comprobar
        assert_eq!(resultado.unwrap_err(), ErrorRepositorio::Duplicado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_rechazar_equipo_id_inexistente(pool: PgPool) {
        // Preparar: un valor de equipo_id que no tiene ninguna fila.
        let mut entidad = construir(&pool).await;
        entidad.equipo_id = IdEquipo::generar();

        // Actuar
        let resultado = repositorio_de_prueba(pool).guardar(&entidad).await;

        // Comprobar
        assert_eq!(
            resultado.unwrap_err(),
            ErrorRepositorio::ReferenciaInexistente("equipo_id")
        );
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_solo_jugadores_con_ese_valor_de_equipo_id(pool: PgPool) {
        // Preparar: una entidad jugador con este valor de equipo_id y otra sin él.
        let destino = infra_equipo::pruebas::siembra::sembrar(&pool).await;
        let mut esperado = construir(&pool).await;
        esperado.equipo_id = destino.id;
        repositorio_de_prueba(pool.clone())
            .guardar(&esperado)
            .await
            .unwrap();
        sembrar(&pool).await;

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(
                PeticionPagina::default(),
                FiltroJugador {
                    equipo_id: Some(destino.id),
                },
            )
            .await
            .unwrap();

        // Comprobar
        assert_eq!(
            pagina
                .elementos
                .iter()
                .map(|fila| fila.id)
                .collect::<Vec<_>>(),
            vec![esperado.id]
        );
        assert_eq!(pagina.total, 1);
    }
}

