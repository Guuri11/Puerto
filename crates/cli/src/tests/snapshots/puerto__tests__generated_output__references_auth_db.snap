use async_trait::async_trait;
use dominio_equipo::modelo::IdEquipo;
use dominio_jugador::errores::ErrorJugador;
use dominio_jugador::modelo::Jugador;
use dominio_jugador::repositorio::{FiltroJugador, RepositorioJugador};
use puerto_nucleo::{Pagina, PeticionPagina};
use std::sync::Arc;

#[derive(Debug, Clone)]
pub struct ParamsListarJugadores {
    pub pagina: PeticionPagina,
    /// Si se indica, solo jugadores con este `equipo_id`.
    pub equipo_id: Option<IdEquipo>,
}

#[async_trait]
pub trait ListarJugadores: Send + Sync {
    async fn ejecutar(
        &self,
        params: ParamsListarJugadores,
    ) -> Result<Pagina<Jugador>, ErrorJugador>;
}

#[cfg(any(test, feature = "pruebas"))]
pub mod dobles {
    use mockall::mock;

    use super::*;

    mock! {
        pub ListarJugadores {}

        #[async_trait]
        impl ListarJugadores for ListarJugadores {
            async fn ejecutar(&self, params: ParamsListarJugadores) -> Result<Pagina<Jugador>, ErrorJugador>;
        }
    }
}

pub struct ListarJugadoresImpl {
    pub repositorio: Arc<dyn RepositorioJugador>,
}

#[async_trait]
impl ListarJugadores for ListarJugadoresImpl {
    #[tracing::instrument(name = "listar_jugadores", skip_all, err(level = "warn"))]
    async fn ejecutar(
        &self,
        params: ParamsListarJugadores,
    ) -> Result<Pagina<Jugador>, ErrorJugador> {
        self.repositorio
            .buscar_todos(
                params.pagina,
                FiltroJugador {
                    equipo_id: params.equipo_id,
                },
            )
            .await
            .map_err(ErrorJugador::from)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use dominio_equipo::modelo::IdEquipo;
    use dominio_jugador::{
        pruebas::madres::MadreJugador, repositorio::dobles::MockRepositorioJugador,
    };
    use puerto_nucleo::PeticionPagina;

    #[tokio::test]
    async fn deberia_devolver_la_pagina_de_jugadores() {
        let entidades = MadreJugador::aleatorios(2);
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(move |pagina, _| Ok(Pagina::new(entidades.clone(), 2, pagina)));
        let caso_de_uso = ListarJugadoresImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarJugadores {
                pagina: PeticionPagina::default(),
                equipo_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert_eq!(pagina.elementos.len(), 2);
        assert_eq!(pagina.total, 2);
    }

    #[tokio::test]
    async fn deberia_devolver_una_pagina_vacia_cuando_no_hay_jugadores() {
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_todos()
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarJugadoresImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarJugadores {
                pagina: PeticionPagina::default(),
                equipo_id: None,
            })
            .await;

        let pagina = resultado.unwrap();
        assert!(pagina.elementos.is_empty());
        assert_eq!(pagina.total, 0);
    }

    #[tokio::test]
    async fn deberia_pasar_al_repositorio_la_pagina_pedida() {
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(|pagina, _| pagina.limite() == 5 && pagina.desplazamiento() == 10)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarJugadoresImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarJugadores {
                pagina: PeticionPagina::new(Some(5), Some(10)),
                equipo_id: None,
            })
            .await;

        assert_eq!(resultado.unwrap().desplazamiento, 10);
    }

    #[tokio::test]
    async fn deberia_pasar_el_filtro_al_repositorio() {
        let filtro = FiltroJugador {
            equipo_id: Some(IdEquipo::generar()),
        };
        let mut repositorio_doble = MockRepositorioJugador::new();
        repositorio_doble
            .expect_buscar_todos()
            .withf(move |_, f| *f == filtro)
            .returning(|pagina, _| Ok(Pagina::new(vec![], 0, pagina)));
        let caso_de_uso = ListarJugadoresImpl {
            repositorio: Arc::new(repositorio_doble),
        };

        let resultado = caso_de_uso
            .ejecutar(ParamsListarJugadores {
                pagina: PeticionPagina::default(),
                equipo_id: filtro.equipo_id,
            })
            .await;

        assert!(resultado.is_ok());
    }
}

