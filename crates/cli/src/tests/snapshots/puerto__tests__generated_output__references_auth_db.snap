=== contextos/equipo/infraestructura/src/pruebas/siembra.rs ===
//! Las filas que necesitan los tests de Postgres —una entidad equipo válida y otra guardada—,
//! para los tests de este crate y para los de los contextos que la referencian (ADR-0023 § 5 de
//! Puerto).
use dominio_equipo::modelo::Equipo;
use dominio_equipo::pruebas::madres::MadreEquipo;
use dominio_equipo::repositorio::RepositorioEquipo;
use sqlx::PgPool;

use crate::repositorio::RepositorioEquipoPostgres;

/// Una entidad equipo válida, sin guardar, con los valores de la madre.
pub fn construir() -> Equipo {
    MadreEquipo::aleatorio()
}

/// Una entidad equipo guardada.
pub async fn sembrar(pool: &PgPool) -> Equipo {
    let entidad = construir();
    RepositorioEquipoPostgres::new(pool.clone())
        .guardar(&entidad)
        .await
        .unwrap();
    entidad
}

=== contextos/equipo/infraestructura/src/repositorio.rs ===
use async_trait::async_trait;
use sqlx::PgPool;

use dominio_equipo::{
    modelo::{Equipo, IdEquipo},
    repositorio::RepositorioEquipo,
};
use puerto_nucleo::{ErrorRepositorio, Pagina, PeticionPagina};
use puerto_sqlx::mapear_error_sqlx;

use crate::fila::FilaEquipo;

pub struct RepositorioEquipoPostgres {
    pub pool: PgPool,
}

impl RepositorioEquipoPostgres {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// Una fila como entidad del dominio. Una fila que el dominio rechaza es un dato guardado que se ha
/// estropeado, no culpa de quien llama: va al log con el motivo del dominio y se devuelve como
/// `DatosInvalidos`.
fn to_dominio(fila: FilaEquipo) -> Result<Equipo, ErrorRepositorio> {
    Equipo::try_from(fila).map_err(|e| {
        tracing::error!(error = %e, "la fila guardada no es una entidad equipo válida");
        ErrorRepositorio::DatosInvalidos
    })
}

#[async_trait]
impl RepositorioEquipo for RepositorioEquipoPostgres {
    async fn buscar_todos(
        &self,
        pagina: PeticionPagina,
    ) -> Result<Pagina<Equipo>, ErrorRepositorio> {
        tracing::debug!(
            limite = pagina.limite(),
            desplazamiento = pagina.desplazamiento(),
            "buscar_todos"
        );
        let filas = sqlx::query_as!(
            FilaEquipo,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, nombre
             FROM equipos WHERE borrado = false
             ORDER BY creado_en DESC, id LIMIT $1 OFFSET $2",
            i64::from(pagina.limite()),
            i64::from(pagina.desplazamiento())
        )
        .fetch_all(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_todos falló");
            mapear_error_sqlx(&e)
        })?;
        let total = sqlx::query_scalar!(
            r#"SELECT COUNT(*) AS "total!" FROM equipos WHERE borrado = false"#
        )
        .fetch_one(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "falló el COUNT de buscar_todos");
            mapear_error_sqlx(&e)
        })?;

        let elementos = filas
            .into_iter()
            .map(to_dominio)
            .collect::<Result<Vec<_>, _>>()?;
        // COUNT(*) nunca es negativo.
        let total = u64::try_from(total).unwrap_or_default();
        Ok(Pagina::new(elementos, total, pagina))
    }

    async fn buscar_por_id(&self, id: IdEquipo) -> Result<Option<Equipo>, ErrorRepositorio> {
        tracing::debug!(%id, "buscar_por_id");
        let fila = sqlx::query_as!(
            FilaEquipo,
            "SELECT id, creado_en, actualizado_en, borrado, borrado_en, nombre
             FROM equipos WHERE id = $1 AND borrado = false",
            id.valor()
        )
        .fetch_optional(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "buscar_por_id falló");
            mapear_error_sqlx(&e)
        })?;

        fila.map(to_dominio).transpose()
    }

    async fn guardar(&self, entidad: &Equipo) -> Result<(), ErrorRepositorio> {
        tracing::debug!(id = %entidad.id, "guardar");
        let db = FilaEquipo::from(entidad);
        sqlx::query!(
            "INSERT INTO equipos (id, creado_en, actualizado_en, borrado, borrado_en, nombre)
             VALUES ($1, $2, $3, $4, $5, $6)
             ON CONFLICT (id) DO UPDATE
             SET actualizado_en = $3, borrado = $4, borrado_en = $5, nombre = $6",
            db.id,
            db.creado_en,
            db.actualizado_en,
            db.borrado,
            db.borrado_en,
            db.nombre,
        )
        .execute(&self.pool)
        .await
        .map_err(|e| {
            tracing::error!(error = %e, "guardar falló");
            mapear_error_sqlx(&e)
        })?;
        Ok(())
    }
}

#[cfg(test)]
mod pruebas_integracion {
    use super::*;
    use crate::pruebas::siembra::sembrar;

    fn repositorio_de_prueba(pool: PgPool) -> RepositorioEquipoPostgres {
        RepositorioEquipoPostgres::new(pool)
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_guardar_y_recuperar_por_id(pool: PgPool) {
        // Preparar
        let entidad = sembrar(&pool).await;

        // Actuar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();

        // Comprobar
        assert_eq!(encontrado.id, entidad.id);
        assert_eq!(encontrado.nombre, entidad.nombre);
        assert!(!encontrado.borrado);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_none_cuando_el_id_no_existe(pool: PgPool) {
        // Actuar
        let resultado = repositorio_de_prueba(pool)
            .buscar_por_id(IdEquipo::generar())
            .await
            .unwrap();

        // Comprobar
        assert!(resultado.is_none());
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_actualizar_la_entidad_al_guardar_un_id_existente(pool: PgPool) {
        // Preparar
        let mut entidad = sembrar(&pool).await;
        entidad.nombre = "updated".to_string();
        entidad.actualizado_en = chrono::Utc::now();

        // Actuar
        repositorio_de_prueba(pool.clone())
            .guardar(&entidad)
            .await
            .unwrap();

        // Comprobar
        let encontrado = repositorio_de_prueba(pool)
            .buscar_por_id(entidad.id)
            .await
            .unwrap()
            .unwrap();
        assert_eq!(encontrado.nombre, "updated");
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_listar_equipos_sin_las_filas_borradas(pool: PgPool) {
        // Preparar
        sembrar(&pool).await;
        let mut borrado = sembrar(&pool).await;
        borrado.borrado = true;
        borrado.borrado_en = Some(borrado.actualizado_en);
        repositorio_de_prueba(pool.clone())
            .guardar(&borrado)
            .await
            .unwrap();

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::default())
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 1);
    }

    #[sqlx::test(migrator = "migrador::MIGRADOR")]
    async fn deberia_devolver_la_pagina_pedida_de_una_lista_mayor(pool: PgPool) {
        // Preparar
        for _ in 0..3 {
            sembrar(&pool).await;
        }

        // Actuar
        let pagina = repositorio_de_prueba(pool)
            .buscar_todos(PeticionPagina::new(Some(2), Some(2)))
            .await
            .unwrap();

        // Comprobar
        assert_eq!(pagina.elementos.len(), 1);
        assert_eq!(pagina.total, 3);
        assert_eq!((pagina.limite, pagina.desplazamiento), (2, 2));
    }
}

