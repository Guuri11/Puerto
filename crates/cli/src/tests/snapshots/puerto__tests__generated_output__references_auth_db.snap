use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_equipo::{
    errores::ErrorEquipo,
    modelo::{Equipo, IdEquipo},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaEquipo {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub nombre: String,
}

impl TryFrom<FilaEquipo> for Equipo {
    type Error = ErrorEquipo;

    fn try_from(fila: FilaEquipo) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Equipo {
            id: IdEquipo::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            nombre: fila.nombre,
        }))
    }
}

impl From<&Equipo> for FilaEquipo {
    fn from(entidad: &Equipo) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            nombre: entidad.nombre.clone(),
        }
    }
}

