use chrono::{DateTime, Utc};
use dominio_equipo::modelo::IdEquipo;
use serde::{Deserialize, Serialize};
use sqlx::FromRow;
use uuid::Uuid;

use dominio_jugador::{
    errores::ErrorJugador,
    modelo::{IdJugador, Jugador},
};

#[derive(Debug, Clone, Serialize, Deserialize, FromRow)]
pub struct FilaJugador {
    pub id: Uuid,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub equipo_id: Uuid,
    pub dorsal: i64,
    pub email: String,
}

impl TryFrom<FilaJugador> for Jugador {
    type Error = ErrorJugador;

    fn try_from(fila: FilaJugador) -> Result<Self, Self::Error> {
        Ok(Self::from_repositorio(Jugador {
            id: IdJugador::from_uuid(fila.id),
            creado_en: fila.creado_en,
            actualizado_en: fila.actualizado_en,
            borrado: fila.borrado,
            borrado_en: fila.borrado_en,
            equipo_id: IdEquipo::from_uuid(fila.equipo_id),
            dorsal: fila.dorsal,
            email: fila.email,
        }))
    }
}

impl From<&Jugador> for FilaJugador {
    fn from(entidad: &Jugador) -> Self {
        Self {
            id: entidad.id.valor(),
            creado_en: entidad.creado_en,
            actualizado_en: entidad.actualizado_en,
            borrado: entidad.borrado,
            borrado_en: entidad.borrado_en,
            equipo_id: entidad.equipo_id.valor(),
            dorsal: entidad.dorsal,
            email: entidad.email.clone(),
        }
    }
}

