        let entity_id = entity.id;
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        mock_repo.expect_save().returning(|_| Ok(()));
        let use_case = UpdateCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCustomerParams {
            id: entity_id,
            name: "updated".to_string(),
            email: "updated".to_string(),
            credit: 42,
            })
            .await;

        // Assert
        assert_eq!(result.unwrap().name, "updated");
    }

    #[tokio::test]
    async fn should_return_not_found_when_customer_does_not_exist() {
        // Arrange
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo.expect_find_by_id().returning(|_| Ok(None));
        let use_case = UpdateCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCustomerParams {
            id: Uuid::new_v4(),
            name: "new".to_string(),
            email: "new".to_string(),
            credit: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(result.unwrap_err().to_string(), "customer.not_found");
    }

    #[tokio::test]
    async fn should_return_error_when_name_is_empty() {
        // Arrange
        let entity = Customer::new(CustomerProps {
            name: "original".to_string(),
            email: Email::new("original".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCustomerParams {
            id: entity_id,
            name: "".to_string(),
            email: "updated".to_string(),
            credit: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.validation_error.name_empty"
        );
    }

    #[tokio::test]
    async fn should_return_error_when_email_is_empty() {
        // Arrange
        let entity = Customer::new(CustomerProps {
            name: "original".to_string(),
            email: Email::new("original".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        }).unwrap();
        let entity_id = entity.id;
        let mut mock_repo = MockCustomerRepository::new();
        mock_repo
            .expect_find_by_id()
            .returning(move |_| Ok(Some(entity.clone())));
        let use_case = UpdateCustomerUseCaseImpl {
            repository: Arc::new(mock_repo),
        };

        // Act
        let result = use_case
            .execute(UpdateCustomerParams {
            id: entity_id,
            name: "updated".to_string(),
            email: "".to_string(),
            credit: 42,
            })
            .await;

        // Assert
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.invalid_email"
        );
    }
}

=== business/src/domain/customer/errors.rs ===
use thiserror::Error;

#[derive(Debug, Error)]
pub enum CustomerError {
    #[error("customer.validation_error.{0}")]
    ValidationError(String),
    #[error("customer.not_found")]
    NotFound,
    #[error("customer.duplicate")]
    Duplicate,
    #[error("customer.repository_error")]
    RepositoryError,
    #[error("customer.unknown")]
    Unknown,
    #[error("customer.invalid_email")]
    InvalidEmail,
    #[error("customer.invalid_money")]
    InvalidMoney,
}

=== business/src/domain/customer/model.rs ===
use chrono::{DateTime, Utc};
use uuid::Uuid;
use crate::domain::shared::value_objects::Email;
use crate::domain::shared::value_objects::Money;

use super::errors::CustomerError;

#[derive(Debug, Clone)]
pub struct CustomerProps {
    pub name: String,
    pub email: Email,
    pub credit: Money,
}

#[derive(Debug, Clone)]
pub struct Customer {
    pub id: Uuid,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: String,
    pub email: Email,
    pub credit: Money,
}

impl Customer {
    pub fn new(props: CustomerProps) -> Result<Self, CustomerError> {
        if props.name.trim().is_empty() {
            return Err(CustomerError::ValidationError("name_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: Uuid::new_v4(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
            email: props.email,
            credit: props.credit,
        })
    }

    pub fn from_repository(data: Customer) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_customer_when_fields_are_valid() {
        let result = Customer::new(CustomerProps {
            name: "example".to_string(),
            email: Email::new("example".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        });
        assert_eq!(result.unwrap().name, "example");
    }


    #[test]
    fn should_reject_customer_when_name_is_empty() {
        let result = Customer::new(CustomerProps {
            name: "".into(),
            email: Email::new("example".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.validation_error.name_empty"
        );
    }

    #[test]
    fn should_reject_customer_when_name_is_only_whitespace() {
        let result = Customer::new(CustomerProps {
            name: "   ".into(),
            email: Email::new("example".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_customer_when_email_is_empty() {
        let result = Email::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shared.value_object.email.invalid"
        );
    }
}

