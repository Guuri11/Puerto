=== nucleo/src/valores.rs ===
use crate::errores::ErrorEmail;

#[derive(Debug, Clone, PartialEq)]
pub struct Email {
    valor: String,
}

impl Email {
    pub fn new(valor: String) -> Result<Self, ErrorEmail> {
        let recortado = valor.trim().to_string();
        if recortado.is_empty() {
            return Err(ErrorEmail::Invalido);
        }
        Ok(Self { valor: recortado })
    }

    pub fn valor(&self) -> &str {
        &self.valor
    }
}

use crate::errores::ErrorMoney;

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Money(i64);

impl Money {
    pub fn new(valor: i64) -> Result<Self, ErrorMoney> {
        Ok(Self(valor))
    }

    pub fn valor(&self) -> i64 {
        self.0
    }
}

