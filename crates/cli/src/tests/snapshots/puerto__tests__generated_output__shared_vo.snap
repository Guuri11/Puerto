=== business/src/domain/shared/value_objects.rs ===
use super::errors::EmailError;

#[derive(Debug, Clone, PartialEq)]
pub struct Email {
    value: String,
}

impl Email {
    pub fn new(value: String) -> Result<Self, EmailError> {
        let trimmed = value.trim().to_string();
        if trimmed.is_empty() {
            return Err(EmailError::Invalid);
        }
        Ok(Self { value: trimmed })
    }

    pub fn value(&self) -> &str {
        &self.value
    }
}

use super::errors::MoneyError;

#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Money(i64);

impl Money {
    pub fn new(value: i64) -> Result<Self, MoneyError> {
        Ok(Self(value))
    }

    pub fn value(&self) -> i64 {
        self.0
    }
}

