=== business/src/tests/mothers/customer_mother.rs ===
use crate::domain::customer::model::Customer;
use crate::domain::customer::model::CustomerProps;
use crate::domain::shared::value_objects::Email;
use crate::domain::shared::value_objects::Money;

pub struct CustomerMother {
    name: Option<String>,
    email: Option<Email>,
    credit: Option<Money>,
}

impl CustomerMother {
    pub fn new() -> Self {
        Self {
            name: None,
            email: None,
            credit: None,
        }
    }

    pub fn with_name(mut self, name: &str) -> Self {
        self.name = Some(name.to_string());
        self
    }

    pub fn with_email(mut self, email: Email) -> Self {
        self.email = Some(email);
        self
    }

    pub fn with_credit(mut self, credit: Money) -> Self {
        self.credit = Some(credit);
        self
    }

    pub fn with_empty_name(mut self) -> Self {
        self.name = Some(String::new());
        self
    }

    pub fn build(self) -> Customer {
        Customer::new(CustomerProps {
            name: self.name.unwrap_or_else(|| "example".to_string()),
            email: self
                .email
                .unwrap_or_else(|| Email::new("example".to_string()).expect("valid Email")),
            credit: self
                .credit
                .unwrap_or_else(|| Money::new(42).expect("valid Money")),
        })
        .expect("CustomerMother: failed to build valid Customer")
    }

    pub fn build_props(self) -> CustomerProps {
        CustomerProps {
            name: self.name.unwrap_or_else(|| "example".to_string()),
            email: self
                .email
                .unwrap_or_else(|| Email::new("example".to_string()).expect("valid Email")),
            credit: self
                .credit
                .unwrap_or_else(|| Money::new(42).expect("valid Money")),
        }
    }

    pub fn random() -> Customer {
        Self::new().build()
    }

    pub fn random_vec(n: usize) -> Vec<Customer> {
        (0..n).map(|_| Self::random()).collect()
    }
}

impl Default for CustomerMother {
    fn default() -> Self {
        Self::new()
    }
}

=== infrastructure/src/customer/repository.rs ===
use async_trait::async_trait;
use business::domain::customer::{
    model::{Customer, CustomerId},
    repository::CustomerRepositoryTrait,
};
use puerto_core::{Page, PageRequest, RepositoryError};

/// A stand-in that stores nothing — replace it with a real adapter (`puerto new --db` generates
/// Postgres repositories).
#[derive(Default)]
pub struct InMemoryCustomerRepository;

impl InMemoryCustomerRepository {
    pub fn new() -> Self {
        Self
    }
}

#[async_trait]
impl CustomerRepositoryTrait for InMemoryCustomerRepository {
    async fn find_all(&self, page: PageRequest) -> Result<Page<Customer>, RepositoryError> {
        tracing::debug!(limit = page.limit(), offset = page.offset(), "find_all");
        Ok(Page::new(vec![], 0, page))
    }

    async fn find_by_id(&self, id: CustomerId) -> Result<Option<Customer>, RepositoryError> {
        tracing::debug!(%id, "find_by_id");
        Ok(None)
    }

    async fn save(&self, entity: &Customer) -> Result<(), RepositoryError> {
        tracing::debug!(id = %entity.id, "save");
        Ok(())
    }
}

