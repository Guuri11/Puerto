use chrono::{DateTime, Utc};
use nucleo::valores::Email;
use nucleo::valores::Money;
use uuid::Uuid;

use crate::errores::ErrorCliente;

/// El id de cada `Cliente`: un `Uuid` que no se puede pasar donde se espera el id de otra
/// entidad.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct IdCliente(Uuid);

impl IdCliente {
    /// Un id nuevo y aleatorio — para una entidad que se está creando.
    pub fn generar() -> Self {
        Self(Uuid::new_v4())
    }

    /// Un id leído de fuera (un parámetro de ruta, una fila) — sin validar: cualquier `Uuid` es un
    /// id.
    pub fn from_uuid(valor: Uuid) -> Self {
        Self(valor)
    }

    pub fn valor(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for IdCliente {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct PropsCliente {
    pub name: String,
    pub email: Email,
    pub credit: Money,
}

#[derive(Debug, Clone)]
pub struct Cliente {
    pub id: IdCliente,
    pub creado_en: DateTime<Utc>,
    pub actualizado_en: DateTime<Utc>,
    pub borrado: bool,
    pub borrado_en: Option<DateTime<Utc>>,
    pub name: String,
    pub email: Email,
    pub credit: Money,
}

impl Cliente {
    pub fn new(props: PropsCliente) -> Result<Self, ErrorCliente> {
        Self::validar(&props)?;
        let ahora = chrono::Utc::now();
        Ok(Self {
            id: IdCliente::generar(),
            creado_en: ahora,
            actualizado_en: ahora,
            borrado: false,
            borrado_en: None,
            name: props.name,
            email: props.email,
            credit: props.credit,
        })
    }

    /// Cambia los campos propios, con las mismas reglas que `new`.
    pub fn actualizar(&mut self, props: PropsCliente) -> Result<(), ErrorCliente> {
        Self::validar(&props)?;
        self.name = props.name;
        self.email = props.email;
        self.credit = props.credit;
        self.actualizado_en = chrono::Utc::now();
        Ok(())
    }

    pub fn from_repositorio(datos: Cliente) -> Self {
        datos
    }

    /// Las reglas de los campos propios: las comprueban `new` y `actualizar`, así que una regla nueva
    /// se escribe solo aquí.
    fn validar(props: &PropsCliente) -> Result<(), ErrorCliente> {
        if props.name.trim().is_empty() {
            return Err(ErrorCliente::Validacion("name_vacio".into()));
        }
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::pruebas::madres::MadreCliente;

    #[test]
    fn deberia_crear_cliente_cuando_los_campos_son_validos() {
        let resultado = Cliente::new(MadreCliente::new().construir_props());
        assert_eq!(
            resultado.unwrap().name,
            MadreCliente::new().construir_props().name
        );
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_name_es_una_cadena_vacia() {
        let resultado = Cliente::new(MadreCliente::new().con_name_vacio().construir_props());
        assert!(resultado.is_err());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cliente.validacion.name_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_name_solo_tiene_espacios() {
        let resultado = Cliente::new(MadreCliente::new().con_name("   ").construir_props());
        assert!(resultado.is_err());
    }

    #[test]
    fn deberia_rechazar_actualizar_cliente_cuando_name_es_una_cadena_vacia() {
        let mut entidad = MadreCliente::aleatorio();
        let resultado = entidad.actualizar(MadreCliente::new().con_name_vacio().construir_props());
        assert_eq!(
            resultado.unwrap_err().to_string(),
            "cliente.validacion.name_vacio"
        );
    }

    #[test]
    fn deberia_rechazar_cliente_cuando_email_es_una_cadena_vacia() {
        let resultado = Email::new("".to_string());
        assert!(resultado.is_err());
        assert_eq!(resultado.unwrap_err().to_string(), "nucleo.email_invalido");
    }
}

=== contextos/cliente/dominio/src/pruebas/madres.rs ===
use crate::modelo::Cliente;
use crate::modelo::PropsCliente;
use nucleo::valores::Email;
use nucleo::valores::Money;

pub struct MadreCliente {
    name: Option<String>,
    email: Option<Email>,
    credit: Option<Money>,
}

impl MadreCliente {
    pub fn new() -> Self {
        Self {
            name: None,
            email: None,
            credit: None,
        }
    }

    pub fn con_name(mut self, name: &str) -> Self {
        self.name = Some(name.to_string());
        self
    }

    pub fn con_email(mut self, email: Email) -> Self {
        self.email = Some(email);
        self
    }

    pub fn con_credit(mut self, credit: Money) -> Self {
        self.credit = Some(credit);
        self
    }

    pub fn con_name_vacio(mut self) -> Self {
        self.name = Some(String::new());
        self
    }

    pub fn construir(self) -> Cliente {
        Cliente::new(PropsCliente {
            name: self.name.unwrap_or_else(|| "example".to_string()),
            email: self.email.unwrap_or_else(|| {
                Email::new("example".to_string()).expect("Email::new rechazó el valor de ejemplo")
            }),
            credit: self
                .credit
                .unwrap_or_else(|| Money::new(42).expect("Money::new rechazó el valor de ejemplo")),
        })
        .expect("MadreCliente: Cliente::new rechazó los props")
    }

    pub fn construir_props(self) -> PropsCliente {
        PropsCliente {
            name: self.name.unwrap_or_else(|| "example".to_string()),
            email: self.email.unwrap_or_else(|| {
                Email::new("example".to_string()).expect("Email::new rechazó el valor de ejemplo")
            }),
            credit: self
                .credit
                .unwrap_or_else(|| Money::new(42).expect("Money::new rechazó el valor de ejemplo")),
        }
    }

    pub fn aleatorio() -> Cliente {
        Self::new().construir()
    }

    pub fn aleatorios(n: usize) -> Vec<Cliente> {
        (0..n).map(|_| Self::aleatorio()).collect()
    }
}

impl Default for MadreCliente {
    fn default() -> Self {
        Self::new()
    }
}

