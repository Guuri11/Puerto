import { describe, expect, test } from "bun:test";
import { fireEvent, screen, waitFor } from "@testing-library/react";
import { ClienteError } from "../../../../domain/cliente/errors";
import type { ClienteDraft } from "../../../../domain/cliente/model";
import { ClienteMother, fakeClienteRepository } from "../../../../test-support/cliente";
import { renderScreen } from "../../../../test-support/render";
import { ClienteFormContainer } from "./cliente-form-container";

function type(label: string, value: string) {
  fireEvent.change(screen.getByLabelText(label), { target: { value } });
}

/** Fills the empty form with `draft`, the way a user would. */
async function fillIn(draft: ClienteDraft) {
  await screen.findByText("Save");
  type("Name", draft.name);
  type("Email", draft.email);
  type("Credit", String(draft.credit));
}

describe("ClienteFormContainer", () => {
  test("should create the cliente from what was typed and show it", async () => {
    // Arrange
    const draft = ClienteMother.draft();
    const clienteRepository = fakeClienteRepository();
    const { history } = renderScreen(<ClienteFormContainer />, { clienteRepository });
    await fillIn(draft);

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toStartWith("/clientes/"));
    const {
      items: [created],
    } = await clienteRepository.list({ limit: 1, offset: 0 });
    expect(created).toMatchObject(draft);
    expect(history.at(-1)).toBe(`/clientes/${created?.id}`);
  });

  test("should save the edited cliente when an existing one is submitted", async () => {
    // Arrange
    const seeded = ClienteMother.random();
    const clienteRepository = fakeClienteRepository([seeded]);
    const { history } = renderScreen(<ClienteFormContainer id={seeded.id} />, {
      clienteRepository,
    });

    // Act
    fireEvent.click(await screen.findByText("Save"));

    // Assert
    await waitFor(() => expect(history.at(-1)).toBe(`/clientes/${seeded.id}`));
    expect(await clienteRepository.get(seeded.id)).toEqual(seeded);
  });

  test("should show the code itself when the API answers one the form does not know", async () => {
    // Arrange
    const code = "cliente.validacion.invalid";
    const clienteRepository = {
      ...fakeClienteRepository(),
      create: () => Promise.reject(new ClienteError(code)),
    };
    renderScreen(<ClienteFormContainer />, { clienteRepository });
    await fillIn(ClienteMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(code);
  });

  test("should say a cliente with these values exists when the API answers a duplicate", async () => {
    // Arrange
    const clienteRepository = {
      ...fakeClienteRepository(),
      create: () => Promise.reject(new ClienteError("cliente.duplicado")),
    };
    renderScreen(<ClienteFormContainer />, { clienteRepository });
    await fillIn(ClienteMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe(
      "A cliente with these values already exists",
    );
  });

  test("should show the message under its input when the API rejects one field", async () => {
    // Arrange
    const clienteRepository = {
      ...fakeClienteRepository(),
      create: () => Promise.reject(new ClienteError("cliente.validacion.name_vacio")),
    };
    renderScreen(<ClienteFormContainer />, { clienteRepository });
    await fillIn(ClienteMother.draft());

    // Act
    fireEvent.click(screen.getByText("Save"));

    // Assert
    expect(await screen.findByText("Name is required")).toBeTruthy();
    const input = screen.getByLabelText("Name");
    expect(input.getAttribute("aria-invalid")).toBe("true");
    expect(screen.queryByRole("alert")).toBeNull();
  });
});

=== web/src/presentation/features/cliente/containers/cliente-form-container.tsx ===
import { useState } from "react";
import { Link, useLocation } from "wouter";
import { toProblem } from "../../../../domain/cliente/messages";
import type { Cliente } from "../../../../domain/cliente/model";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { ErrorAlert, errorCode } from "../../../shared/ui/error-alert";
import { ClienteFormView, toClienteDraft, toClienteForm } from "../views/cliente-form-view";

/** Creates a cliente, or edits the one with `id`. */
export function ClienteFormContainer({ id }: { id?: string }) {
  const { clienteRepository } = useDependencies();
  const existing = useAsync(
    () => (id === undefined ? Promise.resolve(null) : clienteRepository.get(id)),
    [clienteRepository, id],
  );
  const title = id === undefined ? "New cliente" : "Edit cliente";

  return (
    <section className="space-y-4">
      <h1 className="text-2xl font-bold">{title}</h1>
      {existing.status === "loading" && <span className="loading loading-spinner" />}
      {existing.status === "error" && <ErrorAlert error={existing.error} />}
      {existing.status === "ok" && <ClienteForm existing={existing.data} />}
      <Link href={id === undefined ? "/clientes" : `/clientes/${id}`} className="link">
        Cancel
      </Link>
    </section>
  );
}

function ClienteForm({ existing }: { existing: Cliente | null }) {
  const { clienteRepository } = useDependencies();
  const [, navigate] = useLocation();
  const [values, setValues] = useState(toClienteForm(existing));
  const [saving, setSaving] = useState(false);
  const [failure, setFailure] = useState<unknown>(null);
  const problem = failure === null ? null : toProblem(errorCode(failure));

  const save = async () => {
    setSaving(true);
    setFailure(null);
    try {
      const draft = toClienteDraft(values);
      const saved =
        existing === null
          ? await clienteRepository.create(draft)
          : await clienteRepository.update(existing.id, draft);
      navigate(`/clientes/${saved.id}`);
    } catch (error) {
      setFailure(error);
      setSaving(false);
    }
  };

  return (
    <div className="card bg-base-100">
      <div className="card-body">
        {problem?.field === null && <ErrorAlert error={failure} message={problem.text} />}
        <ClienteFormView
          values={values}
          saving={saving}
          problem={problem}
          onChange={setValues}
          onSubmit={save}
        />
      </div>
    </div>
  );
}

=== web/src/presentation/features/cliente/containers/cliente-list-container.test.tsx ===
import { describe, expect, test } from "bun:test";
import { fireEvent, screen } from "@testing-library/react";
import { ClienteError } from "../../../../domain/cliente/errors";
import { ClienteMother, fakeClienteRepository } from "../../../../test-support/cliente";
import { renderScreen } from "../../../../test-support/render";
import { ClienteListContainer } from "./cliente-list-container";

describe("ClienteListContainer", () => {
  test("should show a row per cliente when there are some", async () => {
    // Arrange
    const seed = [ClienteMother.random(), ClienteMother.random()];
    const clienteRepository = fakeClienteRepository(seed);

    // Act
    renderScreen(<ClienteListContainer />, { clienteRepository });

    // Assert
    expect(await screen.findAllByText("View")).toHaveLength(2);
  });

  test("should show the next page when Next is pressed", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ClienteMother.random());
    const clienteRepository = fakeClienteRepository(seed);
    renderScreen(<ClienteListContainer />, { clienteRepository });
    expect(await screen.findAllByText("View")).toHaveLength(20);

    // Act
    fireEvent.click(screen.getByRole("button", { name: "Next" }));

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
    expect(screen.getAllByText("View")).toHaveLength(5);
  });

  test("should open the page the URL names", async () => {
    // Arrange
    const seed = Array.from({ length: 25 }, () => ClienteMother.random());
    const clienteRepository = fakeClienteRepository(seed);
    const path = "/clientes?page=2";

    // Act
    renderScreen(<ClienteListContainer />, { clienteRepository }, path);

    // Assert
    expect(await screen.findByText("21–25 of 25")).toBeTruthy();
  });

  test("should say so when there is no cliente", async () => {
    // Arrange
    const clienteRepository = fakeClienteRepository();

    // Act
    renderScreen(<ClienteListContainer />, { clienteRepository });

    // Assert
    expect(await screen.findByText("No clientes yet.")).toBeTruthy();
  });

  test("should show the error code when the clientes cannot be listed", async () => {
    // Arrange
    const clienteRepository = {
      ...fakeClienteRepository(),
      list: () => Promise.reject(new ClienteError("cliente.repositorio")),
    };

    // Act
    renderScreen(<ClienteListContainer />, { clienteRepository });

    // Assert
    expect((await screen.findByRole("alert")).textContent).toBe("cliente.repositorio");
  });
});

=== web/src/presentation/features/cliente/containers/cliente-list-container.tsx ===
import { Link, useLocation, useSearch } from "wouter";
import { PAGE_SIZE } from "../../../../domain/shared/page";
import { useDependencies } from "../../../core/dependencies";
import { useAsync } from "../../../core/hooks/use-async";
import { EmptyState } from "../../../shared/ui/empty-state";
import { ErrorAlert } from "../../../shared/ui/error-alert";
import { offsetFromSearch, Pagination, pageSearch } from "../../../shared/ui/pagination";
import { ClienteListView } from "../views/cliente-list-view";

/** The list, one page at a time; the page is in the URL (`?page=2`), so reload and back keep it. */
export function ClienteListContainer() {
  const { clienteRepository } = useDependencies();
  const [location, navigate] = useLocation();
  const offset = offsetFromSearch(useSearch(), PAGE_SIZE);
  const goTo = (next: number) => navigate(location + pageSearch(next, PAGE_SIZE));
  const clientes = useAsync(
    () => clienteRepository.list({ limit: PAGE_SIZE, offset }),
    [clienteRepository, offset],
  );

  return (
    <section className="space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Clientes</h1>
        <Link href="/clientes/new" className="btn btn-primary">
          New cliente
        </Link>
      </div>
      {clientes.status === "loading" && <span className="loading loading-spinner" />}
      {clientes.status === "error" && <ErrorAlert error={clientes.error} />}
      {clientes.status === "ok" &&
        (clientes.data.total === 0 ? (
          <EmptyState message="No clientes yet." />
        ) : (
          <>
            <ClienteListView clientes={clientes.data.items} />
            <Pagination {...clientes.data} onOffsetChange={goTo} />
          </>
        ))}
    </section>
  );
}

