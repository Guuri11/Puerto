    }
}

=== business/src/domain/customer/errors.rs ===
use puerto_core::RepositoryError;
use thiserror::Error;

#[derive(Debug, Error)]
pub enum CustomerError {
    #[error("customer.validation_error.{0}")]
    ValidationError(String),
    #[error("customer.not_found")]
    NotFound,
    #[error("customer.duplicate")]
    Duplicate,
    #[error("customer.repository_error")]
    RepositoryError,
    #[error("customer.unknown")]
    Unknown,
    #[error("customer.invalid_email")]
    InvalidEmail,
    #[error("customer.invalid_money")]
    InvalidMoney,
}

impl From<RepositoryError> for CustomerError {
    /// Every failure `puerto-core` names has its arm. `RepositoryError` is `#[non_exhaustive]`: one
    /// a later version adds is the store's problem (500) until it gets a meaning here.
    fn from(err: RepositoryError) -> Self {
        match err {
            RepositoryError::Duplicate => Self::Duplicate,
            RepositoryError::InvalidData | RepositoryError::Unavailable => Self::RepositoryError,
            _ => Self::RepositoryError,
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_convert_a_duplicate_into_the_entity_duplicate() {
        let err = CustomerError::from(RepositoryError::Duplicate);
        assert_eq!(err.to_string(), "customer.duplicate");
    }

    #[test]
    fn should_convert_invalid_data_into_a_repository_error() {
        let err = CustomerError::from(RepositoryError::InvalidData);
        assert_eq!(err.to_string(), "customer.repository_error");
    }

    #[test]
    fn should_convert_an_unavailable_store_into_a_repository_error() {
        let err = CustomerError::from(RepositoryError::Unavailable);
        assert_eq!(err.to_string(), "customer.repository_error");
    }
}

=== business/src/domain/customer/model.rs ===
use crate::domain::shared::value_objects::Email;
use crate::domain::shared::value_objects::Money;
use chrono::{DateTime, Utc};
use uuid::Uuid;

use super::errors::CustomerError;

/// The id of every `Customer`: a `Uuid` that cannot be passed where another entity's id is expected.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct CustomerId(Uuid);

impl CustomerId {
    /// A new, random id — for an entity being created.
    pub fn generate() -> Self {
        Self(Uuid::new_v4())
    }

    /// An id read from the outside (a path parameter, a row) — no validation: any `Uuid` is an id.
    pub fn from_uuid(value: Uuid) -> Self {
        Self(value)
    }

    pub fn value(&self) -> Uuid {
        self.0
    }
}

impl std::fmt::Display for CustomerId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        self.0.fmt(f)
    }
}

#[derive(Debug, Clone)]
pub struct CustomerProps {
    pub name: String,
    pub email: Email,
    pub credit: Money,
}

#[derive(Debug, Clone)]
pub struct Customer {
    pub id: CustomerId,
    pub created_at: DateTime<Utc>,
    pub updated_at: DateTime<Utc>,
    pub deleted: bool,
    pub deleted_at: Option<DateTime<Utc>>,
    pub name: String,
    pub email: Email,
    pub credit: Money,
}

impl Customer {
    pub fn new(props: CustomerProps) -> Result<Self, CustomerError> {
        if props.name.trim().is_empty() {
            return Err(CustomerError::ValidationError("name_empty".into()));
        }
        let now = chrono::Utc::now();
        Ok(Self {
            id: CustomerId::generate(),
            created_at: now,
            updated_at: now,
            deleted: false,
            deleted_at: None,
            name: props.name,
            email: props.email,
            credit: props.credit,
        })
    }

    pub fn from_repository(data: Customer) -> Self {
        data
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn should_create_customer_when_fields_are_valid() {
        let result = Customer::new(CustomerProps {
            name: "example".to_string(),
            email: Email::new("example".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        });
        assert_eq!(result.unwrap().name, "example");
    }

    #[test]
    fn should_reject_customer_when_name_is_empty() {
        let result = Customer::new(CustomerProps {
            name: "".into(),
            email: Email::new("example".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        });
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "customer.validation_error.name_empty"
        );
    }

    #[test]
    fn should_reject_customer_when_name_is_only_whitespace() {
        let result = Customer::new(CustomerProps {
            name: "   ".into(),
            email: Email::new("example".to_string()).expect("valid Email"),
            credit: Money::new(42).expect("valid Money"),
        });
        assert!(result.is_err());
    }

    #[test]
    fn should_reject_customer_when_email_is_empty() {
        let result = Email::new("".to_string());
        assert!(result.is_err());
        assert_eq!(
            result.unwrap_err().to_string(),
            "shared.value_object.email.invalid"
        );
    }
}

