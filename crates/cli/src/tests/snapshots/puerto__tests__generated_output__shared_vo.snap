    #[oai(status = 200)]
    Ok(Json<Vec<CustomerDto>>),
    #[oai(status = 401)]
    Unauthorized(Json<ErrorResponse>),
    #[oai(status = 403)]
    Forbidden(Json<ErrorResponse>),
