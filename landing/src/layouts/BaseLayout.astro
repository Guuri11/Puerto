---
/**
 * El layout de las páginas propias (home, 404). Las docs usan el de Starlight.
 *
 * - Canonical autorreferencial, normalizado con barra final.
 * - Título que no concatena la marca si ya la lleva (límite de 60).
 * - El grafo de schema.org, una vez.
 * - La clase `js` antes de pintar: sin JavaScript el contenido se ve.
 */
import '@/styles/global.css';
import { site } from '@/config/site';
import { buildGraph } from '@/lib/schema';
import { version } from '@/lib/repo';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Sin esto el canonical hereda la forma de la petición y Google ve dos páginas. */
  path: string;
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;

const canonical = new URL(path, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;
const graph = buildGraph({ url: canonical, name: fullTitle, version });
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9e5dc" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background-color: var(--color-accent);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
  }
</style>
