---
/**
 * Los cuatro crates de un contexto como contenedores apilados: el diagrama de la regla de
 * dependencias (ADR-0023). Lo usan la home y las docs (por eso su CSS no depende de Tailwind).
 *
 * Es una lista ordenada de verdad: de fuera hacia dentro. El color es el anillo (entrada,
 * adaptador, núcleo) y nunca va solo: cada caja lleva su nombre. → DESIGN.md § 2 y § 12
 */
interface Props {
  /** En la home, los contenedores entran apilándose (los anima la página, no este componente). */
  animate?: boolean;
}

const { animate = false } = Astro.props;

const layers = [
  {
    id: 'rest',
    ring: 'presentation',
    code: 'RST',
    crate: 'rest_<c>',
    holds: 'Routes, DTOs, response enums, error mapping, route tests',
    knows: 'aplicacion_<c>, dominio_<c>',
    shift: 2,
  },
  {
    id: 'infraestructura',
    ring: 'infrastructure',
    code: 'INF',
    crate: 'infra_<c>',
    holds: 'Adapters: in-memory or Postgres repositories, units of work, mail senders',
    knows: 'dominio_<c>',
    shift: 3,
  },
  {
    id: 'aplicacion',
    ring: 'business',
    code: 'APL',
    crate: 'aplicacion_<c>',
    holds: 'Use cases, one file each: params, trait, double, implementation, tests',
    knows: 'dominio_<c>',
    shift: 1,
  },
  {
    id: 'dominio',
    ring: 'business',
    code: 'DOM',
    crate: 'dominio_<c>',
    holds: 'Models, typed ids, value objects, errors, repository ports, events',
    knows: 'nucleo and puerto-nucleo only',
    shift: 0,
  },
] as const;
---

<figure class="stack not-content" data-stack={animate ? '' : undefined}>
  <ol class="stack__list" aria-label="The four crates of a context, from the outside in">
    {
      layers.map((l, i) => (
        <li class={`stack__box stack__box--${l.ring}`} style={`--i: ${i}; --shift: ${l.shift}`} data-stack-box>
          <div class="stack__head">
            <span class="stack__name">{l.id}</span>
            <span class="stack__code" aria-hidden="true">
              {l.code}
            </span>
          </div>
          <p class="stack__holds">{l.holds}</p>
          <p class="stack__knows">
            <span class="stack__crate">{l.crate}</span> depends on {l.knows}
          </p>
        </li>
      ))
    }
  </ol>
  <figcaption class="stack__caption">
    One context, from the outside in. Dependencies point inward only, and each layer of each
    context is its own crate, so Cargo checks the rule. Only <code>presentacion/</code>, the wiring
    and the binaries, sees them all.
  </figcaption>
</figure>

<style>
  .stack {
    margin: 2rem 0;
    max-width: 44rem;
  }

  .stack__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  /* Cajas iguales; el desplazamiento es el de la grúa, como en el logo. */
  .stack__box {
    position: relative;
    width: min(calc(100% - 3.3rem), 38rem);
    padding: 1rem 1.25rem 1.1rem;
    color: #f4f1ea;
    background-color: var(--layer);
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 22px,
      rgb(255 255 255 / 0.07) 22px 24px
    );
    margin: 0;
  }

  .stack__box {
    margin-inline-start: calc(var(--shift) * 1.1rem);
  }
  .stack__box--presentation {
    --layer: var(--color-layer-presentation);
  }
  .stack__box--infrastructure {
    --layer: var(--color-layer-infrastructure);
  }
  .stack__box--business {
    --layer: var(--color-layer-business);
  }

  @media (width < 640px) {
    .stack__box {
      width: calc(100% - 1.75rem);
      margin-inline-start: calc(var(--shift) * 0.55rem);
    }
  }

  .stack__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .stack__name {
    font-family: var(--font-stencil);
    font-weight: 800;
    /* «infraestructura» tiene que caber en una caja de móvil. */
    font-size: clamp(1.125rem, 5vw, 1.625rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .stack__code {
    font-family: var(--font-mono);
    font-variation-settings: 'wdth' 87.5;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .stack__holds {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .stack__knows {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    opacity: 0.85;
  }

  .stack__crate {
    font-family: var(--font-mono);
    font-variation-settings: 'wdth' 87.5;
  }

  .stack__caption {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: inherit;
    opacity: 0.8;
  }

  /* En la home se apilan al entrar en pantalla; sin JS o con movimiento reducido, quietos. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root.js) [data-stack] .stack__box {
      opacity: 0;
    }
  }
</style>
