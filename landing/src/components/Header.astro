---
import Logo from '@/components/Logo.astro';
import { site } from '@/config/site';

const current = Astro.url.pathname;
---

<header class="header" data-header>
  <div class="frame header__inner">
    <a href="/" class="header__brand" aria-label="Puerto, home">
      <Logo />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul>
        {
          site.nav.map((l) => (
            <li>
              <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>
                {l.text}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.repo} class="header__gh" rel="noopener">GitHub</a>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="visually-hidden" data-menu-label>Open menu</span>
      <span class="toggle__bar" aria-hidden="true"></span>
      <span class="toggle__bar" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <nav class="frame" aria-label="Main, mobile">
      <ul>
        {
          site.nav.map((l) => (
            <li>
              <a href={l.href}>{l.text}</a>
            </li>
          ))
        }
        <li><a href={site.repo} rel="noopener">GitHub</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-canvas);
    border-bottom: 2px solid var(--color-ink);
    transition: transform 280ms ease;
  }

  .header[data-hidden] {
    transform: translateY(-100%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 64px;
  }

  .header__brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.875rem;
    color: var(--color-ink);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .header__nav a:hover {
    background-color: var(--color-surface);
  }

  .header__nav a[aria-current='page'] {
    background-color: var(--color-accent);
  }

  .header__gh {
    border: 2px solid var(--color-ink);
    margin-inline-start: 0.5rem;
  }

  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .toggle__bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-ink);
    transition: transform 200ms ease;
  }

  .header__toggle[aria-expanded='true'] .toggle__bar:first-of-type {
    transform: translateY(4px) rotate(45deg);
  }

  .header__toggle[aria-expanded='true'] .toggle__bar:last-of-type {
    transform: translateY(-4px) rotate(-45deg);
  }

  .mobile-menu {
    border-top: 2px solid var(--color-ink);
    background-color: var(--color-canvas);
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1.5rem;
  }

  .mobile-menu a {
    display: flex;
    align-items: center;
    min-height: 52px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
  }

  @media (width >= 768px) {
    .header__nav {
      display: block;
    }

    .header__toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (button && menu) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
      if (label) label.textContent = open ? 'Open menu' : 'Close menu';
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        button.click();
        button.focus();
      }
    });
  }

  // Se oculta al bajar y aparece al subir: CSS + rAF, una lectura por fotograma.
  if (header) {
    let last = 0;
    let pending = false;
    const update = () => {
      const y = window.scrollY;
      const menuOpen = button?.getAttribute('aria-expanded') === 'true';
      header.toggleAttribute('data-hidden', !menuOpen && y > 240 && y > last);
      last = y;
      pending = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!pending) {
          pending = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
