---
/**
 * La home. Multipágina (brief.md): presenta y enlaza. Cada capacidad tiene una línea aquí y
 * su página en /docs/; si un bloque de aquí empieza a explicar lo que explica una guía, sobra.
 *
 * Los números (versión, ADRs) y todo el código que se enseña salen del repo o del CLI real.
 */
import { Code } from 'astro:components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Terminal from '@/components/home/Terminal.astro';
import CopyCommand from '@/components/home/CopyCommand.astro';
import LayerStack from '@/components/LayerStack.astro';
import { site } from '@/config/site';
import { version, adrs, rustVersion } from '@/lib/repo';
import compiler from '@/data/harvest/compiler.json';
import nightTheme from '@/themes/puerto-night.json';

const manifest = [
  {
    what: 'Entidades',
    command: 'puerto generar scaffold Producto -- nombre:String sku:String!',
    gets: 'Un modelo con su propio tipo de id, cinco casos de uso, cinco rutas, el cableado y las pantallas. Cada pieza con sus tests.',
    href: '/docs/guides/entities/',
  },
  {
    what: 'Objetos valor',
    command: 'email:Email:String  estado:Estado:enum:Borrador/Pagado',
    gets: 'Un tipo por concepto, validado una vez en el dominio y deshecho en los bordes.',
    href: '/docs/guides/value-objects/',
  },
  {
    what: 'Postgres',
    command: 'puerto nuevo --db',
    gets: 'Consultas SQLx comprobadas al compilar, migraciones escritas por ti y únicos que respetan el borrado lógico.',
    href: '/docs/guides/database/',
  },
  {
    what: 'Eventos de dominio',
    command: 'puerto nuevo --db --eventos db|kafka',
    gets: 'Un outbox transaccional y un worker. Entrega al menos una vez, reintentos con espera, nada se retira sin dejar constancia.',
    href: '/docs/guides/events/',
  },
  {
    what: 'Correo',
    command: 'puerto generar correo bienvenida --tras cliente_creado --para email',
    gets: 'Un puerto, tres plantillas y un consumidor que lo envía una vez por evento.',
    href: '/docs/guides/mail/',
  },
  {
    what: 'Auth',
    command: 'puerto nuevo --auth oidc|local',
    gets: 'Auth0, Keycloak o tus propias cuentas. Rutas protegidas por defecto, roles en un atributo.',
    href: '/docs/guides/auth/',
  },
  {
    what: 'Frontend',
    command: 'web/',
    gets: 'React tipado desde la especificación OpenAPI, con la misma regla de dependencias que el backend.',
    href: '/docs/guides/web/',
  },
  {
    what: 'En castellano',
    command: 'RepositorioProducto · crear_producto · /productos',
    gets: 'Todo lo generado va en castellano, de los tipos a las rutas y los códigos de error. Un glosario le pone nombre a todo.',
    href: '/docs/start/anatomy/',
  },
  {
    what: 'Reglas para agentes',
    command: 'AGENTS.md',
    gets: 'Arquitectura, comandos y niveles de revisión para cualquier agente, comprobados contra el generador.',
    href: '/docs/guides/agents/',
  },
];

const steps = [
  { command: site.install, says: 'Instala la CLI.' },
  { command: 'puerto nuevo --nombre tienda --db', says: 'Un workspace con un crate por capa, un frontend y Postgres.' },
  {
    command: 'puerto generar scaffold Producto -- nombre:String precio:i64 sku:String!',
    says: 'Todas las capas de una entidad. Después, make run.',
  },
];
---

<BaseLayout
  title="Puerto: el framework en Rust para backends DDD"
  description={site.description}
  path="/"
>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero frame" aria-labelledby="hero-title">
    <h1 class="display hero__title" id="hero-title">
      <span class="hero__line" data-hero-line>Genera.</span>{' '}
      <span class="hero__line" data-hero-line>Ordena.</span>{' '}
      <span class="hero__line" data-hero-line>Zarpa.</span>
    </h1>

    <div class="hero__side">
      <p class="lede hero__lede" data-hero-line>
        Un framework en Rust que genera un backend Domain-Driven Design, con su base de datos,
        sus eventos, su auth y su frontend, desde un solo manifiesto.
      </p>
      <div class="hero__install" data-hero-line>
        <CopyCommand command={site.install} label="Copiar el comando de instalación" />
        <p class="hero__meta mono">puerto {version} · {site.license} · Rust {rustVersion}+</p>
      </div>
      <div class="hero__ctas" data-hero-line>
        <a href="/docs/start/quick-start/" class="btn btn-primary">Lee el inicio rápido</a>
        <a href={site.repo} class="btn btn-secondary" rel="noopener">El código en GitHub</a>
      </div>
    </div>
  </section>

  <hr class="quay-line" />

  <!-- ── La terminal ───────────────────────────────────────────────────── -->
  <Terminal />

  <hr class="quay-line" />

  <!-- ── La regla de dependencias ──────────────────────────────────────── -->
  <section class="section frame rule" aria-labelledby="rule-title">
    <div class="rule__text">
      <h2 class="h2" id="rule-title" data-reveal>La misma forma,<br />en cada proyecto.</h2>
      <p class="measure" data-reveal>
        El transporte marítimo se volvió rápido cuando todos los contenedores tuvieron el mismo
        tamaño. Puerto le hace eso a tu código: cuatro crates por contexto, una regla de
        dependencias, los mismos ficheros en los mismos sitios. Quien abre un proyecto Puerto, sea
        alguien recién llegado o un agente, sabe dónde está todo desde el primer día.
      </p>
      <p class="measure" data-reveal>
        La regla no es una convención que tengas que recordar. Cada capa es un crate, así que un
        modelo de dominio que intenta tocar la base de datos no compila.
      </p>
      <a class="link rule__link" href="/docs/start/architecture/" data-reveal>Cómo encajan las capas</a>
    </div>
    <div class="rule__stack">
      <LayerStack animate />
    </div>
  </section>

  <hr class="quay-line" />

  <!-- ── El manifiesto ─────────────────────────────────────────────────── -->
  <section class="section frame" aria-labelledby="manifest-title">
    <div class="manifest__head">
      <h2 class="h2" id="manifest-title" data-reveal>Lo que va<br />a bordo.</h2>
      <p class="lede manifest__lede" data-reveal>
        Cada línea es un flag o un comando, y una guía. Lo que un proyecto no pide, no lo
        compila.
      </p>
    </div>
    <table class="manifest">
      <thead>
        <tr>
          <th scope="col">Carga</th>
          <th scope="col">Comando</th>
          <th scope="col">Lo que recibes</th>
        </tr>
      </thead>
      <tbody>
        {
          manifest.map((m) => (
            <tr>
              <td class="manifest__what">
                <a href={m.href}>{m.what}</a>
              </td>
              <td>
                <code>{m.command}</code>
              </td>
              <td>{m.gets}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <hr class="quay-line" />

  <!-- ── Agentes ───────────────────────────────────────────────────────── -->
  <section class="section frame agents" aria-labelledby="agents-title">
    <div class="agents__text">
      <h2 class="h2" id="agents-title" data-reveal>Lo escriben agentes.<br />Lo revisa rustc.</h2>
      <p class="measure" data-reveal>
        Un agente que ha usado repositorios en otros proyectos busca <code>guardar</code>. En un
        proyecto Puerto con eventos de dominio, el repositorio no lo tiene: las escrituras pasan por
        una unidad de trabajo que registra el evento. Así que el error no es un bug que aparece en
        producción. Es esto, capturado de un <code>cargo check</code> real sobre un proyecto
        generado.
      </p>
      <p class="measure" data-reveal>
        Cada proyecto trae además un <code>AGENTS.md</code> con su arquitectura, sus comandos y qué
        cambios tiene que leer una persona, y los propios tests de Puerto lo mantienen al día.
      </p>
      <a class="link" href="/docs/guides/agents/" data-reveal>Trabajar con agentes</a>
    </div>
    <div class="agents__code" data-reveal>
      <Code code={compiler.code} lang="rust" theme={nightTheme as never} />
      <div class="agents__error">
        <Code code={compiler.error} lang="txt" theme={nightTheme as never} />
      </div>
    </div>
  </section>

  <hr class="quay-line" />

  <!-- ── Decisiones ────────────────────────────────────────────────────── -->
  <section class="section frame decisions" aria-labelledby="decisions-title">
    <div class="decisions__head">
      <h2 class="h2" id="decisions-title" data-reveal>{adrs.length} decisiones,<br />por escrito.</h2>
      <p class="measure" data-reveal>
        Cada compromiso que el código no puede mostrar tiene su registro: el contexto, las
        alternativas, lo que cuesta. Así, la siguiente persona, o el siguiente agente, hereda el
        motivo en lugar de deshacerlo.
      </p>
      <a class="link" href="/docs/decisions/" data-reveal>Lee las decisiones</a>
    </div>
    <ol class="decisions__list">
      {
        adrs.map((a) => (
          <li>
            <a href={`/docs/decisions/adr/${a.slug}/`}>
              <span class="decisions__num mono">{a.number}</span>
              <span>{a.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ── Empezar ───────────────────────────────────────────────────────── -->
  <section class="start" aria-labelledby="start-title">
    <div class="start__hazard" aria-hidden="true"></div>
    <div class="section frame start__inner">
      <h2 class="h2" id="start-title" data-reveal>Tres comandos<br />hasta una API en marcha.</h2>
      <ol class="start__steps">
        {
          steps.map((s, i) => (
            <li data-reveal>
              <span class="start__n mono">{i + 1}</span>
              <p>{s.says}</p>
              <CopyCommand command={s.command} />
            </li>
          ))
        }
      </ol>
      <a href="/docs/start/quick-start/" class="btn btn-primary start__cta">Sigue el inicio rápido</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero__title {
    margin: 0;
  }

  /* Sin esto, el comando de instalación (no se parte) ensancha la columna del grid en móvil. */
  .hero > * {
    min-width: 0;
  }

  .hero__line {
    display: block;
  }

  .hero__side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-content: end;
  }

  .hero__lede {
    max-width: 30rem;
    margin: 0;
  }

  .hero__meta {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (width >= 1024px) {
    .hero {
      grid-template-columns: 1.35fr 1fr;
      align-items: end;
    }
  }

  /* ── Regla ────────────────────────────────────────────────────────────── */
  .rule {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .rule__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .rule__text p {
    margin: 0;
  }

  .rule__link {
    justify-self: start;
  }

  @media (width >= 1024px) {
    .rule {
      grid-template-columns: 1fr 1.1fr;
      align-items: center;
    }
  }

  /* ── Manifiesto ───────────────────────────────────────────────────────── */
  .manifest__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .manifest__lede {
    margin: 0;
    max-width: 32rem;
  }

  @media (width >= 1024px) {
    .manifest__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .manifest {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .manifest thead th {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 2px solid var(--color-ink);
    text-align: left;
    font-family: var(--font-stencil);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .manifest td {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
    vertical-align: top;
  }

  .manifest__what a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .manifest__what a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 3px;
  }

  .manifest code {
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  @media (width < 768px) {
    .manifest thead {
      display: none;
    }

    .manifest tr {
      display: grid;
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-rule);
      gap: 0.375rem;
    }

    .manifest td {
      padding: 0;
      border: 0;
    }

    .manifest__what a {
      margin-top: 0;
    }
  }

  /* ── Agentes ──────────────────────────────────────────────────────────── */
  .agents {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .agents__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .agents__text p {
    margin: 0;
  }

  .agents__text code {
    font-size: 0.875em;
  }

  .agents__text .link {
    justify-self: start;
  }

  .agents__code {
    min-width: 0;
    border: 2px solid var(--color-ink);
    box-shadow: var(--shadow-hard-lg);
    background: var(--color-night);
  }

  .agents__code :global(pre) {
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.75rem;
    line-height: 1.65;
  }

  .agents__error {
    border-top: 1px solid var(--color-night-rule);
  }

  .agents__error :global(pre) {
    color: var(--color-night-ink);
  }

  @media (width >= 1024px) {
    .agents {
      grid-template-columns: 0.9fr 1.2fr;
      align-items: start;
    }
  }

  /* ── Decisiones ───────────────────────────────────────────────────────── */
  .decisions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .decisions__head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .decisions__head p {
    margin: 0;
  }

  .decisions__head .link {
    justify-self: start;
  }

  .decisions__list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: 2rem;
    border-top: 2px solid var(--color-ink);
  }

  .decisions__list li {
    break-inside: avoid;
    border-bottom: 1px solid var(--color-rule);
  }

  .decisions__list a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    min-height: 44px;
    padding: 0.625rem 0;
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .decisions__list a:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .decisions__num {
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  @media (width >= 768px) {
    .decisions__list {
      columns: 2;
    }
  }

  @media (width >= 1024px) {
    .decisions {
      grid-template-columns: 1fr 2fr;
    }
  }

  /* ── Empezar: el único sitio con franjas de señalización ──────────────── */
  .start__hazard {
    height: 18px;
    background: var(--hazard);
    border-block: 2px solid var(--color-ink);
  }

  .start__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  .start__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .start__steps li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.5rem;
    align-items: start;
  }

  .start__steps li > :not(.start__n) {
    grid-column: 2;
    min-width: 0;
  }

  .start__steps p {
    margin: 0;
  }

  .start__n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--color-ink);
    color: var(--color-accent);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .start__cta {
    justify-self: start;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Presupuesto «moderno / tech»: 0,6 s, power2.out, stagger 0,08, 28 px. → DESIGN.md § 10
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);

    const heroLines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
    gsap.set(heroLines, { opacity: 0, y: 28 });
    gsap.to(heroLines, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.08 });

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 28 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        },
      );
    });

    // Los contenedores bajan de la grúa uno a uno: dominio primero, que es la base.
    const stack = document.querySelector('[data-stack]');
    if (stack) {
      const boxes = gsap.utils.toArray<HTMLElement>('[data-stack-box]', stack).reverse();
      gsap.fromTo(
        boxes,
        { opacity: 0, y: -48 },
        {
          opacity: 1,
          y: 0,
          duration: 0.55,
          ease: 'power2.out',
          stagger: 0.16,
          scrollTrigger: { trigger: stack, start: 'top 80%', once: true },
        },
      );
    }
  }
</script>
