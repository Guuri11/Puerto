---
/**
 * La home. Multipágina (brief.md): presenta y enlaza. Cada capacidad tiene una línea aquí y
 * su página en /docs/; si un bloque de aquí empieza a explicar lo que explica una guía, sobra.
 *
 * Los números (versión, ADRs) y todo el código que se enseña salen del repo o del CLI real.
 */
import { Code } from 'astro:components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Terminal from '@/components/home/Terminal.astro';
import CopyCommand from '@/components/home/CopyCommand.astro';
import LayerStack from '@/components/LayerStack.astro';
import { site } from '@/config/site';
import { version, adrs, rustVersion } from '@/lib/repo';
import compiler from '@/data/harvest/compiler.json';
import nightTheme from '@/themes/puerto-night.json';

const manifest = [
  {
    what: 'Entities',
    command: 'puerto generate scaffold Product -- name:String sku:String!',
    gets: 'A model with its own id type, five use cases, five routes, the wiring and the screens. Every piece with its tests.',
    href: '/docs/guides/entities/',
  },
  {
    what: 'Value objects',
    command: 'email:Email:String  status:Status:enum:Draft/Paid',
    gets: 'A type per concept, validated once in the domain, unwrapped at the edges.',
    href: '/docs/guides/value-objects/',
  },
  {
    what: 'Postgres',
    command: 'puerto new --db',
    gets: 'SQLx queries checked at compile time, migrations written for you, unique indexes that respect soft deletes.',
    href: '/docs/guides/database/',
  },
  {
    what: 'Domain events',
    command: 'puerto new --db --events db|kafka',
    gets: 'A transactional outbox and a worker. At-least-once delivery, retries with backoff, nothing dropped without a dead letter.',
    href: '/docs/guides/events/',
  },
  {
    what: 'Mail',
    command: 'puerto generate mail welcome --on customer_created --to email',
    gets: 'A port, three templates, and a consumer that sends it once per event.',
    href: '/docs/guides/mail/',
  },
  {
    what: 'Auth',
    command: 'puerto new --auth oidc|local',
    gets: 'Auth0, Keycloak or your own accounts. Routes protected by default, roles in one attribute.',
    href: '/docs/guides/auth/',
  },
  {
    what: 'Frontend',
    command: 'web/',
    gets: 'React typed from the OpenAPI spec, with the same dependency rule as the backend.',
    href: '/docs/guides/web/',
  },
  {
    what: 'Agent rules',
    command: 'AGENTS.md',
    gets: 'Architecture, commands and review tiers for every coding agent, tested against the generator.',
    href: '/docs/guides/agents/',
  },
];

const steps = [
  { command: site.install, says: 'Install the CLI.' },
  { command: 'puerto new --name shop --db', says: 'A workspace with three crates, a frontend and Postgres.' },
  {
    command: 'puerto generate scaffold Product -- name:String price:i64 sku:String!',
    says: 'Every layer of an entity. Then make run.',
  },
];
---

<BaseLayout
  title="Puerto: the Rust framework for DDD backends"
  description={site.description}
  path="/"
>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero frame" aria-labelledby="hero-title">
    <h1 class="display hero__title" id="hero-title">
      <span class="hero__line" data-hero-line>Scaffold.</span>{' '}
      <span class="hero__line" data-hero-line>Structure.</span>{' '}
      <span class="hero__line" data-hero-line>Ship.</span>
    </h1>

    <div class="hero__side">
      <p class="lede hero__lede" data-hero-line>
        A Rust framework that generates a Domain-Driven Design backend, with its database,
        events, auth and frontend, from one manifest.
      </p>
      <div class="hero__install" data-hero-line>
        <CopyCommand command={site.install} label="Copy the install command" />
        <p class="hero__meta mono">puerto {version} · {site.license} · Rust {rustVersion}+</p>
      </div>
      <div class="hero__ctas" data-hero-line>
        <a href="/docs/start/quick-start/" class="btn btn-primary">Read the quick start</a>
        <a href={site.repo} class="btn btn-secondary" rel="noopener">Source on GitHub</a>
      </div>
    </div>
  </section>

  <hr class="quay-line" />

  <!-- ── La terminal ───────────────────────────────────────────────────── -->
  <Terminal />

  <hr class="quay-line" />

  <!-- ── La regla de dependencias ──────────────────────────────────────── -->
  <section class="section frame rule" aria-labelledby="rule-title">
    <div class="rule__text">
      <h2 class="h2" id="rule-title" data-reveal>Same shape,<br />every project.</h2>
      <p class="measure" data-reveal>
        Shipping got fast when every container became the same size. Puerto does that to your
        code: three crates, one dependency rule, the same files in the same places. Whoever
        opens a Puerto project, a new hire or an agent, knows where everything is on day one.
      </p>
      <p class="measure" data-reveal>
        The rule is not a convention you keep. Each layer is a crate, so a domain model that
        reaches for the database does not compile.
      </p>
      <a class="link rule__link" href="/docs/start/architecture/" data-reveal>How the layers fit together</a>
    </div>
    <div class="rule__stack">
      <LayerStack animate />
    </div>
  </section>

  <hr class="quay-line" />

  <!-- ── El manifiesto ─────────────────────────────────────────────────── -->
  <section class="section frame" aria-labelledby="manifest-title">
    <div class="manifest__head">
      <h2 class="h2" id="manifest-title" data-reveal>What comes<br />on board.</h2>
      <p class="lede manifest__lede" data-reveal>
        Each line is a flag or a command, and a guide. What a project does not ask for, it
        does not compile.
      </p>
    </div>
    <table class="manifest">
      <thead>
        <tr>
          <th scope="col">Cargo</th>
          <th scope="col">Command</th>
          <th scope="col">What you get</th>
        </tr>
      </thead>
      <tbody>
        {
          manifest.map((m) => (
            <tr>
              <td class="manifest__what">
                <a href={m.href}>{m.what}</a>
              </td>
              <td>
                <code>{m.command}</code>
              </td>
              <td>{m.gets}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <hr class="quay-line" />

  <!-- ── Agentes ───────────────────────────────────────────────────────── -->
  <section class="section frame agents" aria-labelledby="agents-title">
    <div class="agents__text">
      <h2 class="h2" id="agents-title" data-reveal>Written by agents.<br />Reviewed by rustc.</h2>
      <p class="measure" data-reveal>
        An agent that has used repositories elsewhere reaches for <code>save</code>. In a Puerto
        project with domain events, the repository has none: writes go through a unit of work
        that records the event. So the mistake is not a bug found in production. It is this,
        captured from a real <code>cargo check</code> on a generated project.
      </p>
      <p class="measure" data-reveal>
        Every project also ships an <code>AGENTS.md</code> with its architecture, its commands and
        which changes a person must read, and Puerto’s own tests keep it true.
      </p>
      <a class="link" href="/docs/guides/agents/" data-reveal>Working with agents</a>
    </div>
    <div class="agents__code" data-reveal>
      <Code code={compiler.code} lang="rust" theme={nightTheme as never} />
      <div class="agents__error">
        <Code code={compiler.error} lang="txt" theme={nightTheme as never} />
      </div>
    </div>
  </section>

  <hr class="quay-line" />

  <!-- ── Decisiones ────────────────────────────────────────────────────── -->
  <section class="section frame decisions" aria-labelledby="decisions-title">
    <div class="decisions__head">
      <h2 class="h2" id="decisions-title" data-reveal>{adrs.length} decisions,<br />written down.</h2>
      <p class="measure" data-reveal>
        Every trade-off that the code cannot show has a record: the context, the alternatives,
        what it costs. So the next person, or the next agent, inherits the reason instead of
        undoing it.
      </p>
      <a class="link" href="/docs/decisions/" data-reveal>Read the decisions</a>
    </div>
    <ol class="decisions__list">
      {
        adrs.map((a) => (
          <li>
            <a href={`/docs/decisions/adr/${a.slug}/`}>
              <span class="decisions__num mono">{a.number}</span>
              <span>{a.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ── Empezar ───────────────────────────────────────────────────────── -->
  <section class="start" aria-labelledby="start-title">
    <div class="start__hazard" aria-hidden="true"></div>
    <div class="section frame start__inner">
      <h2 class="h2" id="start-title" data-reveal>Three commands<br />to a running API.</h2>
      <ol class="start__steps">
        {
          steps.map((s, i) => (
            <li data-reveal>
              <span class="start__n mono">{i + 1}</span>
              <p>{s.says}</p>
              <CopyCommand command={s.command} />
            </li>
          ))
        }
      </ol>
      <a href="/docs/start/quick-start/" class="btn btn-primary start__cta">Follow the quick start</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero__title {
    margin: 0;
  }

  /* Sin esto, el comando de instalación (no se parte) ensancha la columna del grid en móvil. */
  .hero > * {
    min-width: 0;
  }

  .hero__line {
    display: block;
  }

  .hero__side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-content: end;
  }

  .hero__lede {
    max-width: 30rem;
    margin: 0;
  }

  .hero__meta {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (width >= 1024px) {
    .hero {
      grid-template-columns: 1.35fr 1fr;
      align-items: end;
    }
  }

  /* ── Regla ────────────────────────────────────────────────────────────── */
  .rule {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .rule__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .rule__text p {
    margin: 0;
  }

  .rule__link {
    justify-self: start;
  }

  @media (width >= 1024px) {
    .rule {
      grid-template-columns: 1fr 1.1fr;
      align-items: center;
    }
  }

  /* ── Manifiesto ───────────────────────────────────────────────────────── */
  .manifest__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .manifest__lede {
    margin: 0;
    max-width: 32rem;
  }

  @media (width >= 1024px) {
    .manifest__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .manifest {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .manifest thead th {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 2px solid var(--color-ink);
    text-align: left;
    font-family: var(--font-stencil);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .manifest td {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
    vertical-align: top;
  }

  .manifest__what a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: -0.6rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }

  .manifest__what a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 3px;
  }

  .manifest code {
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  @media (width < 768px) {
    .manifest thead {
      display: none;
    }

    .manifest tr {
      display: grid;
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-rule);
      gap: 0.375rem;
    }

    .manifest td {
      padding: 0;
      border: 0;
    }

    .manifest__what a {
      margin-top: 0;
    }
  }

  /* ── Agentes ──────────────────────────────────────────────────────────── */
  .agents {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .agents__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .agents__text p {
    margin: 0;
  }

  .agents__text code {
    font-size: 0.875em;
  }

  .agents__text .link {
    justify-self: start;
  }

  .agents__code {
    min-width: 0;
    border: 2px solid var(--color-ink);
    box-shadow: var(--shadow-hard-lg);
    background: var(--color-night);
  }

  .agents__code :global(pre) {
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.75rem;
    line-height: 1.65;
  }

  .agents__error {
    border-top: 1px solid var(--color-night-rule);
  }

  .agents__error :global(pre) {
    color: var(--color-night-ink);
  }

  @media (width >= 1024px) {
    .agents {
      grid-template-columns: 0.9fr 1.2fr;
      align-items: start;
    }
  }

  /* ── Decisiones ───────────────────────────────────────────────────────── */
  .decisions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  .decisions__head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .decisions__head p {
    margin: 0;
  }

  .decisions__head .link {
    justify-self: start;
  }

  .decisions__list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: 2rem;
    border-top: 2px solid var(--color-ink);
  }

  .decisions__list li {
    break-inside: avoid;
    border-bottom: 1px solid var(--color-rule);
  }

  .decisions__list a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    min-height: 44px;
    padding: 0.625rem 0;
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .decisions__list a:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .decisions__num {
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  @media (width >= 768px) {
    .decisions__list {
      columns: 2;
    }
  }

  @media (width >= 1024px) {
    .decisions {
      grid-template-columns: 1fr 2fr;
    }
  }

  /* ── Empezar: el único sitio con franjas de señalización ──────────────── */
  .start__hazard {
    height: 18px;
    background: var(--hazard);
    border-block: 2px solid var(--color-ink);
  }

  .start__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  .start__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .start__steps li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.5rem;
    align-items: start;
  }

  .start__steps li > :not(.start__n) {
    grid-column: 2;
    min-width: 0;
  }

  .start__steps p {
    margin: 0;
  }

  .start__n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--color-ink);
    color: var(--color-accent);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .start__cta {
    justify-self: start;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Presupuesto «moderno / tech»: 0,6 s, power2.out, stagger 0,08, 28 px. → DESIGN.md § 10
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);

    const heroLines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
    gsap.set(heroLines, { opacity: 0, y: 28 });
    gsap.to(heroLines, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.08 });

    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 28 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        },
      );
    });

    // Los contenedores bajan de la grúa uno a uno: business primero, que es la base.
    const stack = document.querySelector('[data-stack]');
    if (stack) {
      const boxes = gsap.utils.toArray<HTMLElement>('[data-stack-box]', stack).reverse();
      gsap.fromTo(
        boxes,
        { opacity: 0, y: -48 },
        {
          opacity: 1,
          y: 0,
          duration: 0.55,
          ease: 'power2.out',
          stagger: 0.16,
          scrollTrigger: { trigger: stack, start: 'top 80%', once: true },
        },
      );
    }
  }
</script>
