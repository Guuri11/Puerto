---
/** El 404: salidas, no una disculpa. Las docs viejas de /docs (una sola página) llegan aquí. */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="No encontrada"
  description="Esta dirección no existe en la web de Puerto. La documentación, el inicio rápido y las decisiones están a un clic de aquí."
  path="/404/"
  noindex
>
  <section class="frame section nf">
    <p class="label nf__code">404 · Muelle vacío</p>
    <h1 class="display nf__title">Aquí no hay<br />nada atracado.</h1>
    <p class="lede">La página se movió, o nunca existió. Prueba una de estas.</p>
    <ul class="nf__links">
      <li><a class="link" href="/docs/">Qué es Puerto</a></li>
      <li><a class="link" href="/docs/start/quick-start/">Inicio rápido</a></li>
      <li><a class="link" href="/docs/reference/cli/">Referencia de la CLI</a></li>
      <li><a class="link" href="/docs/decisions/">Decisiones</a></li>
    </ul>
    <a class="btn btn-primary" href="/">Volver a la portada</a>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .nf__code {
    color: var(--color-ink-muted);
  }

  .nf__title {
    margin: 0;
  }

  .nf__links {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }
</style>
