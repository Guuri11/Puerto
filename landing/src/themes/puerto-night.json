{
  "name": "puerto-night",
  "type": "dark",
  "colors": {
    "editor.background": "#101215",
    "editor.foreground": "#E6E1D6",
    "editorLineNumber.foreground": "#5C5A54",
    "editor.selectionBackground": "#2A2E33",
    "terminal.ansiGreen": "#6DBE93",
    "terminal.ansiYellow": "#F5B700",
    "terminal.ansiBlue": "#6FA3E0",
    "terminal.ansiRed": "#E58A6A",
    "terminal.ansiBrightBlack": "#9A968C",
    "titleBar.activeBackground": "#171A1E",
    "titleBar.activeForeground": "#9A968C",
    "titleBar.border": "#2A2E33",
    "tab.activeBackground": "#101215",
    "tab.activeForeground": "#E6E1D6",
    "tab.inactiveBackground": "#171A1E",
    "editorGroupHeader.tabsBackground": "#171A1E",
    "tab.border": "#2A2E33",
    "tab.activeBorderTop": "#F5B700",
    "focusBorder": "#F5B700"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9A968C", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.control"], "settings": { "foreground": "#E58A6A" } },
    { "scope": ["string", "string.quoted", "markup.inline.raw", "constant.character"], "settings": { "foreground": "#6DBE93" } },
    { "scope": ["entity.name.type", "entity.name.struct", "entity.name.enum", "entity.name.trait", "support.type", "support.class", "entity.name.class", "entity.other.inherited-class", "entity.name.type.module"], "settings": { "foreground": "#6FA3E0" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.function.macro", "support.function.macro"], "settings": { "foreground": "#E6E1D6" } },
    { "scope": ["entity.name.function.macro", "support.function.macro", "meta.attribute", "punctuation.definition.attribute"], "settings": { "foreground": "#F5B700" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "variable.language"], "settings": { "foreground": "#E58A6A" } },
    { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#E6E1D6" } },
    { "scope": ["punctuation", "keyword.operator", "meta.brace"], "settings": { "foreground": "#B7B2A6" } },
    { "scope": ["entity.name.tag", "support.type.property-name", "entity.other.attribute-name", "meta.object-literal.key"], "settings": { "foreground": "#6FA3E0" } },
    { "scope": ["entity.name.section", "markup.heading"], "settings": { "foreground": "#F5B700", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6DBE93" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#E58A6A" } },
    { "scope": ["support.variable", "variable.other.constant", "entity.name.constant"], "settings": { "foreground": "#E6E1D6" } },
    { "scope": ["entity.name.lifetime", "storage.modifier.lifetime"], "settings": { "foreground": "#9A968C", "fontStyle": "italic" } }
  ]
}
